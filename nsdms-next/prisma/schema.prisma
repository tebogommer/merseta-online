  userId             Int                           @map("user_id")
  trainingProviderId Int?                          @map("training_provider_id")
  applicationType    String                        @map("application_type")
  status             String                        @default("DRAFT")
  createdAt          DateTime                      @default(now()) @map("created_at")
  createdBy          Int?                          @map("created_by")
  modifiedAt         DateTime                      @updatedAt @map("modified_at")
  modifiedBy         Int?                          @map("modified_by")
  extensionsOfScope  AssessorModExtensionOfScope[]
  trainingProvider   TrainingProvider?             @relation(fields: [trainingProviderId], references: [id])
  user               User                          @relation(fields: [userId], references: [id])

  @@map("assessor_moderator_application")
}

model AssessorModExtensionOfScope {
  id                Int                          @id @default(autoincrement())
  applicationId     Int                          @map("application_id")
  status            String                       @default("PENDING")
  qualificationCode String                       @map("qualification_code")
  createdAt         DateTime                     @default(now()) @map("created_at")
  createdBy         Int?                         @map("created_by")
  modifiedAt        DateTime                     @updatedAt @map("modified_at")
  modifiedBy        Int?                         @map("modified_by")
  application       AssessorModeratorApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@map("assessor_mod_ext_scope")
}

model Document {
  id                 Int               @id @default(autoincrement())
  filename           String
  mimeType           String            @map("mime_type")
  sizeBytes          Int               @map("size_bytes")
  blob               Bytes?
  isGenerated        Boolean           @default(false) @map("is_generated")
  organisationId     Int?              @map("organisation_id")
  grantApplicationId Int?              @map("grant_application_id")
  trainingProviderId Int?              @map("training_provider_id")
  reportingExtractId Int?              @map("reporting_extract_id")
  createdAt          DateTime          @default(now()) @map("created_at")
  createdBy          Int?              @map("created_by")
  modifiedAt         DateTime          @updatedAt @map("modified_at")
  modifiedBy         Int?              @map("modified_by")
  reportingExtract   ReportingExtract? @relation(fields: [reportingExtractId], references: [id])
  trainingProvider   TrainingProvider? @relation(fields: [trainingProviderId], references: [id])
  grantApplication   GrantApplication? @relation(fields: [grantApplicationId], references: [id])
  organisation       Organisation?     @relation(fields: [organisationId], references: [id])

  @@map("document")
}

model SarsLevyDetail {
  id             Int          @id @default(autoincrement())
  organisationId Int          @map("organisation_id")
  arrivalDate    DateTime     @map("arrival_date")
  levyYear       Int          @map("levy_year")
  amount         Float
  createdAt      DateTime     @default(now()) @map("created_at")
  createdBy      Int?         @map("created_by")
  modifiedAt     DateTime     @updatedAt @map("modified_at")
  modifiedBy     Int?         @map("modified_by")
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  @@index([organisationId])
  @@index([levyYear])
  @@map("sars_levy_detail")
}

model ReportingExtract {
  id               Int        @id @default(autoincrement())
  extractType      String     @map("extract_type")
  status           String     @default("COMPLETED")
  recordsProcessed Int        @map("records_processed")
  createdAt        DateTime   @default(now()) @map("created_at")
  createdBy        Int?       @map("created_by")
  modifiedAt       DateTime   @updatedAt @map("modified_at")
  modifiedBy       Int?       @map("modified_by")
  documents        Document[]

  @@map("reporting_extract")
}
