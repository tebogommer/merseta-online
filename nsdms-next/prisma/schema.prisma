generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Organisation {
  id                        Int                   @id @default(autoincrement())
  sdlNumber                 String?               @unique @map("sdl_number")
  organisationName          String                @map("organisation_name")
  tradingName               String?               @map("trading_name")
  companyRegistrationNumber String?               @unique @map("company_registration_number")
  email                     String?
  telNumber                 String?               @map("tel_number")
  address                   String?
  bankAccountNumber         String?               @map("bank_account_number")
  bankBranchCode            String?               @map("bank_branch_code")
  sicCode                   String?               @map("sic_code")
  status                    String                @default("Awaiting merSETA Approval") @map("status")
  createdAt                 DateTime              @default(now()) @map("created_at")
  createdBy                 Int?                  @map("created_by")
  modifiedAt                DateTime              @updatedAt @map("modified_at")
  modifiedBy                Int?                  @map("modified_by")
  documents                 Document[]
  grantApplications         GrantApplication[]
  employerEnrollments       LearnerEnrollment[]   @relation("EmployerEnrollments")
  providerEnrollments       LearnerEnrollment[]   @relation("ProviderEnrollments")
  sarsLevyDetails           SarsLevyDetail[]
  trainingProvider          TrainingProvider?
  workplaceSkillsPlans      WorkplaceSkillsPlan[]

  @@map("organisation")
}

model AuditLog {
  id         Int      @id @default(autoincrement())
  recordId   Int      @map("record_id")
  entityName String   @map("entity_name")
  actionName String   @map("action_name")
  actor      String
  snapshot   String
  createdAt  DateTime @default(now()) @map("created_at")
  createdBy  Int?     @map("created_by")
  modifiedAt DateTime @updatedAt @map("modified_at")
  modifiedBy Int?     @map("modified_by")

  @@map("audit_log")
}

model CategoryType {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  code        String   @unique
  description String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")
  createdBy   Int?     @map("created_by")
  modifiedAt  DateTime @updatedAt @map("modified_at")
  modifiedBy  Int?     @map("modified_by")

  @@index([name])
  @@index([code])
  @@map("category_type")
}

model User {
  id                   Int                            @id @default(autoincrement())
  name                 String?
  email                String?                        @unique
  emailVerified        DateTime?                      @map("email_verified")
  image                String?
  role                 String                         @default("STANDARD")
  permissions          String                         @default("[]") // Hybrid Claim Override JSON
  active               Boolean                        @default(true)
  person               Person?                        // 1:1 Relationship
  createdAt            DateTime                       @default(now()) @map("created_at")
  createdBy            Int?                           @map("created_by")
  modifiedAt           DateTime                       @updatedAt @map("modified_at")
  modifiedBy           Int?                           @map("modified_by")
  accounts             Account[]
  assessorApplications AssessorModeratorApplication[]
  learners             Learner[]
  learnerEnrollments   LearnerEnrollment[]
  sessions             Session[]

  @@map("user")
}

model Person {
  id                Int       @id @default(autoincrement())
  userId            Int?      @unique @map("user_id")
  firstName         String    @map("first_name")
  lastName          String    @map("last_name")
  rsaIdNumber       String?   @unique @map("rsa_id_number")
  passportNumber    String?   @unique @map("passport_number")
  dateOfBirth       DateTime? @map("date_of_birth")

  // Lookup Relations
  genderId          Int?      @map("gender_id")
  gender            GenderType? @relation(fields: [genderId], references: [id])
  equityId          Int?      @map("equity_id")
  equity            EquityType? @relation(fields: [equityId], references: [id])
  nationalityId     Int?      @map("nationality_id")
  nationality       NationalityType? @relation(fields: [nationalityId], references: [id])

  user              User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  
  @@map("person")
}

model Account {
  id                Int      @id @default(autoincrement())
  userId            Int      @map("user_id")
  type              String
  provider          String
  providerAccountId String   @map("provider_account_id")
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  createdAt         DateTime @default(now()) @map("created_at")
  createdBy         Int?     @map("created_by")
  modifiedAt        DateTime @updatedAt @map("modified_at")
  modifiedBy        Int?     @map("modified_by")
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("account")
}

model Session {
  id           Int      @id @default(autoincrement())
  sessionToken String   @unique @map("session_token")
  userId       Int      @map("user_id")
  expires      DateTime
  createdAt    DateTime @default(now()) @map("created_at")
  createdBy    Int?     @map("created_by")
  modifiedAt   DateTime @updatedAt @map("modified_at")
  modifiedBy   Int?     @map("modified_by")
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
