  wspGuid                  String             @default(uuid()) @map("wsp_guid")
  status                   String             @default("Draft")
  holdingRoomStatus        String?            @map("holding_room_status")
  totalPayroll             Float?             @map("total_payroll")
  totalTrainingCosts       Float?             @map("total_training_costs")
  percentagePayrollSpent   Float?             @map("percentage_payroll_spent")
  estimatedOverallCost     Float?             @map("estimated_overall_project_cost")
  approvedAmount           Float?             @map("approved_amount")
  numberOfEmployees        Int?               @map("number_of_employees")
  numberOfBeneficiaries    Int?               @map("number_of_beneficiaries")
  requireSignOffUpload     Boolean            @default(false) @map("require_sign_off_upload")
  requireProjectAdminCosts Boolean            @default(false) @map("require_project_administration_costs")
  requireDisputeDocs       Boolean            @default(false) @map("require_dispute_docs")
  withSdf                  Boolean            @default(false) @map("with_sdf")
  sdfAppealedGrant         Boolean            @default(false) @map("sdf_appealed_grant")
  grantRejected            Boolean            @default(false) @map("grant_rejected")
  mancoApprovalRequired    Boolean            @default(false) @map("manco_approval_required")
  mancoDecisionReached     Boolean            @default(false) @map("manco_decision_reached")
  systemApprovalRejection  Boolean?           @map("system_approval_rejection")
  applicationReopened      Boolean?           @map("application_reopened")
  adminReopened            Boolean?           @map("admin_reopened")
  rejectionNotified        Boolean            @default(false) @map("rejection_notified")
  grantDeviated            Boolean?           @map("grant_deviated")
  manuallyAdded            Boolean            @default(false) @map("manually_added")
  projectDescription       String?            @map("project_description")
  purpose                  String?
  outcomes                 String?
  location                 String?
  interventions            String?
  benefits                 String?
  potentialRisks           String?            @map("potential_risks")
  createdAt                DateTime           @default(now()) @map("created_at")
  createdBy                Int                @default(0) @map("created_by")
  modifiedAt               DateTime           @updatedAt @map("modified_at")
  modifiedBy               Int                @default(0) @map("modified_by")
  grantApplications        GrantApplication[]
  organisation             Organisation       @relation(fields: [organisationId], references: [id])

  @@index([organisationId])
  @@index([finYear])
  @@map("workplace_skills_plan")
}

