<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\Nsdms.Infrastructure\Nsdms.Infrastructure.csproj" />
    <ProjectReference Include="..\Nsdms.Application\Nsdms.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.11">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="MudBlazor" Version="9.9.0" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
  </PropertyGroup>

  <Target Name="EnforceWizardStandard" BeforeTargets="BeforeBuild">
    <Exec Command="python &quot;$(MSBuildProjectDirectory)/scripts/guard_wizard_components.py&quot; &quot;$(MSBuildProjectDirectory)&quot;" ConsoleToMSBuild="true" />
  </Target>

</Project>
