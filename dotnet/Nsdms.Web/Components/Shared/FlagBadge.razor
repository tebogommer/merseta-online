@namespace Nsdms.Web.Components.Shared
@using MudBlazor

@if (Flags != null && Flags.Any())
{
    <div class="d-inline-flex align-center gap-1 nsdms-flag-container" role="group" aria-label="Entity Flags">
        @foreach (var flag in Flags.Take(3))
        {
            <span class="border px-2 py-0.5 rounded text-secondary" style="font-size: 0.75rem; background-color: var(--background); border-color: var(--border); pointer-events: none; white-space: nowrap;">
                @flag
            </span>
        }
        @if (Flags.Count() > 3)
        {
            <MudTooltip Text="@string.Join(", ", Flags.Skip(3))">
                <span class="border px-2 py-0.5 rounded text-secondary cursor-help" style="font-size: 0.75rem; background-color: var(--background); border-color: var(--border); white-space: nowrap;">
                    +@(Flags.Count() - 3)
                </span>
            </MudTooltip>
        }
    </div>
}

@code {
    [Parameter] public IEnumerable<string>? Flags { get; set; }
}
