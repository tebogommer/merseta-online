@namespace Nsdms.Web.Components.Shared.Wizard
@using MudBlazor
@implements IAsyncDisposable
@inject IJSRuntime JSRuntime

@if (IsActive)
{
    <section class="wizard-step-panel" aria-labelledby="@HeadingId">
        <header class="wizard-step-header mb-4">
            <h2 id="@HeadingId" @ref="_headingRef" tabindex="-1" class="text-h6 font-weight-bold mb-1 focus-outline-none">
                @Heading
            </h2>
            @if (!string.IsNullOrWhiteSpace(Description))
            {
                <p class="text-body2 text-muted mb-0">
                    @Description
                </p>
            }
        </header>

        <div class="wizard-step-content">
            @ChildContent
        </div>
    </section>
}

@code {
    [CascadingParameter]
    public WizardShell? ParentWizard { get; set; }

    [Parameter]
    public string Label { get; set; } = string.Empty;

    [Parameter]
    public string Heading { get; set; } = string.Empty;

    [Parameter]
    public string? Description { get; set; }

    [Parameter]
    public Func<Task<bool>>? ValidateAsync { get; set; }

    [Parameter]
    public Func<bool>? Validate { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    public int StepIndex { get; internal set; } = -1;

    public bool IsActive => ParentWizard != null && ParentWizard.ActiveStepIndex == StepIndex;

    private ElementReference _headingRef;
    private string HeadingId => $"wizard-step-heading-{StepIndex}";
    private bool _hasFocused = false;

    protected override void OnInitialized()
    {
        if (ParentWizard != null)
        {
            ParentWizard.RegisterStep(this);
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (IsActive && !_hasFocused)
        {
            _hasFocused = true;
            try
            {
                await _headingRef.FocusAsync();
            }
            catch
            {
                // Non-blocking focus
            }
        }
        else if (!IsActive)
        {
            _hasFocused = false;
        }
    }

    public async Task<bool> ExecuteValidationAsync()
    {
        if (ValidateAsync != null)
        {
            return await ValidateAsync();
        }
        if (Validate != null)
        {
            return Validate();
        }
        return true;
    }

    public ValueTask DisposeAsync()
    {
        ParentWizard?.UnregisterStep(this);
        return ValueTask.CompletedTask;
    }
}
