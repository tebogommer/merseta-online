@using Nsdms.Application.Common
@using Nsdms.Application.Services
@inject ITenantProvider TenantProvider
@inject ISnackbar Snackbar

<MudDialog MaxWidth="MaxWidth.Small" FullWidth="true">
    <TitleContent>
        <div class="d-flex align-center gap-2">
            <MudIcon Icon="@Icons.Material.Filled.Business" Color="Color.Primary" />
            <div>
                <MudText Typo="Typo.h6" Style="font-size: 1.1rem; font-weight: 700;">
                    Select working organisation
                </MudText>
                <MudText Typo="Typo.caption" Color="Color.Secondary">
                    Choose which employer organisation you wish to act on behalf of
                </MudText>
            </div>
        </div>
    </TitleContent>
    <DialogContent>
        <MudText Typo="Typo.body2" Class="mb-3" Style="color: var(--mud-palette-text-secondary);">
            @if (!string.IsNullOrEmpty(PersonDisplayName))
            {
                <span>Welcome, <strong>@PersonDisplayName</strong>. </span>
            }
            You are formally affiliated with multiple organisations. Select your active working context:
        </MudText>

        <div class="d-flex flex-column gap-2" style="max-height: 400px; overflow-y: auto;">
            @foreach (var org in Organisations)
            {
                var isCurrent = TenantProvider.CurrentOrganisationId == org.OrganisationId;
                <div class="pa-3 rounded-lg d-flex justify-space-between align-center"
                     style="border: 1px solid @(isCurrent ? "var(--mud-palette-primary)" : "var(--mud-palette-lines-default)"); background: @(isCurrent ? "var(--mud-palette-action-default-hover)" : "transparent"); cursor: pointer; transition: all 0.2s;"
                     @onclick="@(() => SelectOrganisation(org))">
                    <div class="d-flex flex-column">
                        <div class="d-flex align-center gap-2">
                            <MudText Typo="Typo.subtitle2" Style="font-weight: 700; color: var(--mud-palette-text-primary);">
                                @org.OrganisationName
                            </MudText>
                            @if (isCurrent)
                            {
                                <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Filled" Style="height: 20px; font-size: 0.65rem;">
                                    Active
                                </MudChip>
                            }
                        </div>
                        <div class="d-flex align-center gap-2 mt-1">
                            <span class="font-mono text-muted" style="font-size: 0.75rem;">SDL: @org.SdlNumber</span>
                            @if (!string.IsNullOrEmpty(org.ChamberName))
                            {
                                <span class="text-muted" style="font-size: 0.75rem;">• @org.ChamberName</span>
                            }
                        </div>
                        <div class="d-flex flex-wrap gap-1 mt-1">
                            @foreach (var r in org.Roles)
                            {
                                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Default" Style="height: 18px; font-size: 0.65rem; padding: 0 6px;">
                                    @r
                                </MudChip>
                            }
                        </div>
                    </div>
                    <MudButton Variant="@(isCurrent ? Variant.Filled : Variant.Outlined)"
                               Color="Color.Primary"
                               Size="Size.Small"
                               StartIcon="@Icons.Material.Filled.Check"
                               OnClick="@(() => SelectOrganisation(org))">
                        @(isCurrent ? "Active" : "Select")
                    </MudButton>
                </div>
            }
        </div>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Text" Color="Color.Default" OnClick="Cancel">
            Close
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    public IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter]
    public List<AffiliatedOrganisationDto> Organisations { get; set; } = new();

    [Parameter]
    public string? PersonDisplayName { get; set; }

    private void SelectOrganisation(AffiliatedOrganisationDto org)
    {
        TenantProvider.SetTenant(org.OrganisationId, org.OrganisationName, org.SdlNumber, isAdmin: false);
        Snackbar.Add($"Working organisation switched to {org.OrganisationName}.", Severity.Success);
        MudDialog.Close(DialogResult.Ok(org));
    }

    private void Cancel()
    {
        MudDialog.Cancel();
    }
}
