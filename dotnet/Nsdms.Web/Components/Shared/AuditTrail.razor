@namespace Nsdms.Web.Components.Shared
@using Nsdms.Application.Services
@using Nsdms.Domain.Entities
@using MudBlazor
@inject IWorkflowEngineService WorkflowService
@inject IAuditService AuditService

@*
  UI-STANDARD.md Contract (Section 9.2):
  Component: AuditTrail
  Inputs: EntityId, ProcessCode / EntityType
  Renders: Chronological status history with actor and timestamp.
*@

<div class="nsdms-audit-trail" role="region" aria-label="Audit History">
    <div class="d-flex justify-space-between align-center mb-3">
        <div class="d-flex align-center gap-2">
            <MudIcon Icon="@Icons.Material.Filled.History" Color="Color.Primary" />
            <MudText Typo="Typo.h6" Class="fw-bold">Audit History &amp; Workflow Trail</MudText>
        </div>
        <MudButton Variant="Variant.Text" Size="Size.Small" StartIcon="@Icons.Material.Filled.Refresh" OnClick="LoadAuditTrailAsync">
            Refresh
        </MudButton>
    </div>

    @if (_loading)
    {
        <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="my-4" />
    }
    else if (!_historyItems.Any())
    {
        <MudAlert Severity="Severity.Normal" Variant="Variant.Outlined" Class="my-2">
            No workflow transition events recorded for this entity yet.
        </MudAlert>
    }
    else
    {
        <MudTimeline TimelineOrientation="TimelineOrientation.Vertical" TimelinePosition="TimelinePosition.Start">
            @foreach (var item in _historyItems)
            {
                <MudTimelineItem Color="@GetColorForAction(item.ActionName)" Size="Size.Small" Elevation="1">
                    <ItemOpposite>
                        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="font-monospace">
                            @item.ActionDate.ToLocalTime().ToString("yyyy-MM-dd HH:mm")
                        </MudText>
                    </ItemOpposite>
                    <ItemContent>
                        <MudPaper Class="pa-3 border-default" Elevation="1">
                            <div class="d-flex justify-space-between align-center mb-1">
                                <MudText Typo="Typo.subtitle2" Class="fw-bold">
                                    @(item.ActionName ?? "State Transition")
                                </MudText>
                                <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Text">
                                    Actor: @(item.ActorName ?? "System") (@(item.ActorRole ?? "User"))
                                </MudChip>
                            </div>
                            <div class="d-flex align-center gap-2 mb-2">
                                <span class="text-secondary" style="font-size: 0.8rem;">From:</span>
                                <StatusBadge Status="@(item.FromState?.StateName ?? "Initial")" Size="Size.Small" />
                                <MudIcon Icon="@Icons.Material.Filled.ArrowForward" Size="Size.Small" Color="Color.Secondary" />
                                <span class="text-secondary" style="font-size: 0.8rem;">To:</span>
                                <StatusBadge Status="@(item.ToState?.StateName ?? "Target")" Size="Size.Small" />
                            </div>
                            @if (!string.IsNullOrWhiteSpace(item.Comments))
                            {
                                <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mt-1 bg-surface pa-2 rounded font-italic">
                                    "@item.Comments"
                                </MudText>
                            }
                        </MudPaper>
                    </ItemContent>
                </MudTimelineItem>
            }
        </MudTimeline>
    }
</div>

@code {
    [Parameter]
    public int EntityId { get; set; }

    [Parameter]
    public string ProcessCode { get; set; } = string.Empty;

    [Parameter]
    public string? EntityType { get; set; }

    private bool _loading = true;
    private List<WorkflowHistory> _historyItems = new();

    private string EffectiveCode => !string.IsNullOrWhiteSpace(ProcessCode) ? ProcessCode : (EntityType ?? "DEFAULT");

    protected override async Task OnParametersSetAsync()
    {
        if (EntityId > 0 && !string.IsNullOrWhiteSpace(EffectiveCode))
        {
            await LoadAuditTrailAsync();
        }
        else
        {
            _loading = false;
        }
    }

    private async Task LoadAuditTrailAsync()
    {
        _loading = true;
        try
        {
            var instance = await WorkflowService.GetInstanceByEntityAsync(EffectiveCode, EntityId);
            if (instance != null)
            {
                _historyItems = await WorkflowService.GetWorkflowHistoryAsync(instance.Id);
            }
            else
            {
                _historyItems.Clear();
            }
        }
        catch
        {
            _historyItems.Clear();
        }
        finally
        {
            _loading = false;
        }
    }

    private Color GetColorForAction(string? action)
    {
        if (string.IsNullOrWhiteSpace(action)) return Color.Primary;
        var a = action.ToLowerInvariant();
        if (a.Contains("reject") || a.Contains("decline") || a.Contains("withdraw")) return Color.Error;
        if (a.Contains("approve") || a.Contains("complete") || a.Contains("sign")) return Color.Success;
        return Color.Primary;
    }
}
