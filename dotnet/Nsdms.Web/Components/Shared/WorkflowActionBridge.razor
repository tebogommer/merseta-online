@namespace Nsdms.Web.Components.Shared
@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization
@using Nsdms.Application.Services
@using Nsdms.Domain.Entities
@inject IWorkflowEngineService WorkflowService
@inject AuthenticationStateProvider AuthStateProvider
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<MudPaper Elevation="0" Class="workflow-action-bridge pa-4 my-3 rounded-lg border-default" Style="background-color: var(--mud-palette-surface); border: 1px solid var(--mud-palette-lines-default);">
    <div class="d-flex flex-column flex-md-row align-start align-md-center justify-space-between gap-3">
        <!-- Current Workflow State Badge & Status Context -->
        <div class="d-flex align-center gap-3">
            <div class="d-flex align-center justify-center rounded p-2" style="background: rgba(184, 134, 11, 0.1); color: var(--mud-palette-primary); width: 36px; height: 36px;">
                <MudIcon Icon="@Icons.Material.Filled.AccountTree" Size="Size.Small" />
            </div>
            <div>
                <div class="d-flex align-center gap-2 flex-wrap">
                    <span style="font-size: 0.75rem; text-transform: uppercase; font-weight: 700; letter-spacing: 0.05em; color: var(--mud-palette-text-secondary);">
                        Current Stage:
                    </span>
                    @if (_instance != null && _instance.CurrentWorkflowState != null)
                    {
                        <StatusBadge Status="@_instance.CurrentWorkflowState.StateName" Size="Size.Small" />
                        @if (_instance.IsCompleted)
                        {
                            <MudChip T="string" Color="Color.Success" Variant="Variant.Filled" Size="Size.Small" Icon="@Icons.Material.Filled.CheckCircle">
                                Completed
                            </MudChip>
                        }
                    }
                    else
                    {
                        <StatusBadge Status="Draft / Uninitiated" Size="Size.Small" />
                    }

                    @if (_mandatoryDocsCount > 0)
                    {
                        <MudChip T="string" Color="Color.Info" Variant="Variant.Outlined" Size="Size.Small" Icon="@Icons.Material.Filled.FolderZip">
                            @_mandatoryDocsCount Mandatory Document@(_mandatoryDocsCount > 1 ? "s" : "") Enforced
                        </MudChip>
                    }
                </div>
                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="d-block mt-1">
                    @(_instance?.IsCompleted == true ? "Lifecycle successfully finalized and locked." : (_instance == null ? "Record is in draft. Click Initiate Workflow to trigger review and routing gates." : "Active workflow gate. Authorized officers can advance or return this record."))
                </MudText>
            </div>
        </div>

        <!-- Interactive Transition Action Buttons (Primary vs Destructive separated) -->
        <div class="d-flex flex-wrap align-center gap-2 align-self-stretch align-self-md-auto justify-end">
            @if (_instance == null)
            {
                <MudButton Variant="Variant.Filled" 
                           Color="Color.Primary" 
                           Size="Size.Medium"
                           StartIcon="@Icons.Material.Filled.PlayArrow"
                           Disabled="@_isProcessing"
                           OnClick="StartWorkflowAsync">
                    Initiate @(!string.IsNullOrEmpty(ProcessCode) ? ProcessCode : "Workflow")
                </MudButton>
            }
            else if (!_instance.IsCompleted && _availableTransitions.Any())
            {
                @foreach (var transition in _availableTransitions.OrderByDescending(t => !t.ActionName.Contains("Reject", StringComparison.OrdinalIgnoreCase) && !t.ActionName.Contains("Decline", StringComparison.OrdinalIgnoreCase)))
                {
                    var isReject = transition.ActionName.Contains("Reject", StringComparison.OrdinalIgnoreCase) || transition.ActionName.Contains("Decline", StringComparison.OrdinalIgnoreCase);
                    var icon = GetTransitionIcon(transition);
                    <MudButton Variant="@(isReject ? Variant.Outlined : Variant.Filled)"
                               Color="@(isReject ? Color.Error : Color.Primary)"
                               Size="Size.Medium"
                               StartIcon="@icon"
                               Disabled="@_isProcessing"
                               OnClick="() => HandleTransitionClickAsync(transition)">
                        @transition.ActionName
                    </MudButton>
                }
            }
            else if (_instance.IsCompleted)
            {
                <MudChip T="string" Color="Color.Success" Variant="Variant.Outlined" Size="Size.Small" Icon="@Icons.Material.Filled.CheckCircle">
                    Completed / Finalised
                </MudChip>
            }
        </div>
    </div>

    @if (_showCommentModal && _selectedTransition != null)
    {
        <MudPaper Elevation="0" Class="comment-modal mt-3 pa-4 rounded-lg border-default" style="background-color: var(--mud-palette-background-grey); border: 1px solid var(--mud-palette-lines-default);">
            <div class="d-flex align-center gap-2 mb-2">
                <MudIcon Icon="@(_selectedTransition.ActionName.Contains("Reject", StringComparison.OrdinalIgnoreCase) ? Icons.Material.Filled.Warning : Icons.Material.Filled.FactCheck)" 
                         Color="@(_selectedTransition.ActionName.Contains("Reject", StringComparison.OrdinalIgnoreCase) ? Color.Error : Color.Primary)" />
                <MudText Typo="Typo.subtitle2" Class="font-weight-bold">
                    Confirm Action: @_selectedTransition.ActionName
                </MudText>
            </div>
            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="d-block mb-3">
                Please provide notes or audit justification for advancing this workflow stage.
            </MudText>
            <MudTextField @bind-Value="_commentText" 
                          Label="Action Justification / Audit Remarks" 
                          Variant="Variant.Outlined" 
                          Lines="3" 
                          FullWidth="true"
                          Required="@_selectedTransition.RequiresComments" />
            <div class="d-flex justify-end gap-2 mt-3">
                <MudButton Variant="Variant.Text" OnClick="() => _showCommentModal = false" Disabled="@_isProcessing">
                    Cancel
                </MudButton>
                <MudButton Variant="Variant.Filled" 
                           Color="@(_selectedTransition.ActionName.Contains("Reject", StringComparison.OrdinalIgnoreCase) ? Color.Error : Color.Primary)" 
                           OnClick="ExecuteTransitionAsync" 
                           Disabled="@(_isProcessing || (_selectedTransition.RequiresComments && string.IsNullOrWhiteSpace(_commentText)))">
                    @(_isProcessing ? "Processing..." : "Confirm & Advance")
                </MudButton>
            </div>
        </MudPaper>
    }
</MudPaper>

@code {
    [Parameter] public string ProcessCode { get; set; } = string.Empty;
    [Parameter] public int EntityId { get; set; }
    [Parameter] public string EntityTitle { get; set; } = string.Empty;
    [Parameter] public string EntityRef { get; set; } = string.Empty;
    [Parameter] public EventCallback<string> OnStatusChanged { get; set; }

    private WorkflowInstance? _instance;
    private List<WorkflowTransition> _availableTransitions = new();
    private int _mandatoryDocsCount = 0;
    private bool _isProcessing = false;
    private bool _showCommentModal = false;
    private WorkflowTransition? _selectedTransition;
    private string _commentText = string.Empty;
    private ClaimsPrincipal? _currentUser;

    protected override async Task OnParametersSetAsync()
    {
        await LoadWorkflowStateAsync();
    }

    private async Task LoadWorkflowStateAsync()
    {
        if (string.IsNullOrEmpty(ProcessCode) || EntityId <= 0) return;

        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        _currentUser = authState.User;

        _instance = await WorkflowService.GetInstanceByEntityAsync(ProcessCode, EntityId);
        if (_instance != null)
        {
            _availableTransitions = await WorkflowService.GetAvailableTransitionsAsync(_instance.Id, _currentUser);
        }
        else
        {
            _availableTransitions.Clear();
        }

        var docRules = await WorkflowService.GetDocumentRequirementsAsync(ProcessCode);
        _mandatoryDocsCount = docRules.Count(r => r.IsMandatory);
    }

    private async Task StartWorkflowAsync()
    {
        _isProcessing = true;
        try
        {
            var userEmail = _currentUser?.Identity?.Name ?? "admin@merseta.org.za";
            var userName = _currentUser?.Claims.FirstOrDefault(c => c.Type == ClaimTypes.GivenName)?.Value ?? "Authorized User";

            var result = await WorkflowService.StartWorkflowAsync(
                ProcessCode, 
                EntityId, 
                EntityTitle, 
                EntityRef, 
                userEmail, 
                userName);

            if (result.Success)
            {
                Snackbar.Add($"Workflow initialized: {result.NewStateName}", Severity.Success);
                await LoadWorkflowStateAsync();
                await OnStatusChanged.InvokeAsync(result.NewStateName ?? "INITIALIZED");
            }
            else
            {
                Snackbar.Add(result.Message, Severity.Error);
            }
        }
        finally
        {
            _isProcessing = false;
        }
    }

    private async Task HandleTransitionClickAsync(WorkflowTransition transition)
    {
        _selectedTransition = transition;
        _commentText = string.Empty;

        if (transition.RequiresComments || transition.ActionName.Contains("Reject", StringComparison.OrdinalIgnoreCase) || transition.ActionName.Contains("Decline", StringComparison.OrdinalIgnoreCase))
        {
            _showCommentModal = true;
        }
        else
        {
            await ExecuteTransitionAsync();
        }
    }

    private async Task ExecuteTransitionAsync()
    {
        if (_instance == null || _selectedTransition == null) return;

        _isProcessing = true;
        try
        {
            var userEmail = _currentUser?.Identity?.Name ?? "admin@merseta.org.za";
            var userName = _currentUser?.Claims.FirstOrDefault(c => c.Type == ClaimTypes.GivenName)?.Value ?? "Authorized User";
            var userRole = _currentUser?.Claims.FirstOrDefault(c => c.Type == ClaimTypes.Role)?.Value ?? "Administrator";

            var result = await WorkflowService.AdvanceWorkflowAsync(
                _instance.Id,
                _selectedTransition.Id,
                userEmail,
                userName,
                userRole,
                _commentText);

            if (result.Success)
            {
                _showCommentModal = false;
                Snackbar.Add(result.Message, Severity.Success);
                await LoadWorkflowStateAsync();
                await OnStatusChanged.InvokeAsync(result.NewStateName ?? "UPDATED");
            }
            else
            {
                Snackbar.Add(result.Message, Severity.Error);
            }
        }
        finally
        {
            _isProcessing = false;
        }
    }

    private string GetTransitionIcon(WorkflowTransition transition)
    {
        if (!string.IsNullOrEmpty(transition.ButtonIcon))
        {
            return transition.ButtonIcon switch
            {
                "Send" => Icons.Material.Filled.Send,
                "Draw" => Icons.Material.Filled.Draw,
                "Verified" => Icons.Material.Filled.Verified,
                "Check" => Icons.Material.Filled.Check,
                "CheckCircle" => Icons.Material.Filled.CheckCircle,
                "DoneAll" => Icons.Material.Filled.DoneAll,
                "Event" => Icons.Material.Filled.Event,
                "EventAvailable" => Icons.Material.Filled.EventAvailable,
                "FactCheck" => Icons.Material.Filled.FactCheck,
                "Grading" => Icons.Material.Filled.Grading,
                "Group" => Icons.Material.Filled.Group,
                "HelpOutline" => Icons.Material.Filled.HelpOutline,
                "Engineering" => Icons.Material.Filled.Engineering,
                "HowToVote" => Icons.Material.Filled.HowToVote,
                "Schedule" => Icons.Material.Filled.Schedule,
                "ThumbUp" => Icons.Material.Filled.ThumbUp,
                "Warning" => Icons.Material.Filled.Warning,
                "VerifiedUser" => Icons.Material.Filled.VerifiedUser,
                "WorkspacePremium" => Icons.Material.Filled.WorkspacePremium,
                "Approval" => Icons.Material.Filled.Approval,
                "Checklist" => Icons.Material.Filled.Checklist,
                "Cancel" or "Close" or "Block" => Icons.Material.Filled.Cancel,
                _ => Icons.Material.Filled.CheckCircle
            };
        }

        var name = transition.ActionName.ToLowerInvariant();
        if (name.Contains("reject") || name.Contains("decline") || name.Contains("cancel"))
            return Icons.Material.Filled.Cancel;
        if (name.Contains("sign") || name.Contains("draw"))
            return Icons.Material.Filled.Draw;
        if (name.Contains("submit") || name.Contains("send"))
            return Icons.Material.Filled.Send;
        if (name.Contains("schedule") || name.Contains("audit") || name.Contains("visit"))
            return Icons.Material.Filled.Event;
        if (name.Contains("certif"))
            return Icons.Material.Filled.WorkspacePremium;
        if (name.Contains("approv") || name.Contains("endorse"))
            return Icons.Material.Filled.CheckCircle;
        
        return Icons.Material.Filled.CheckCircle;
    }
}
