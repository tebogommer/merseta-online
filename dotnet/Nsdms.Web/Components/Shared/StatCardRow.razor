@namespace Nsdms.Web.Components.Shared
@using MudBlazor

@*
  UI-STANDARD.md Contract (Section 9.2 & Clause 4.4.2.8):
  Component: StatCardRow
  Inputs: Cards (child content)
  Renders: Equal-height grid of up to four cards above a list or on a dashboard.
*@

<div class="@($"nsdms-stat-card-row mb-4 {Class}")" role="region" aria-label="Key Performance Metrics" @attributes="AdditionalAttributes">
    <MudGrid Spacing="3">
        @ChildContent
    </MudGrid>
</div>

@code {
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    [Parameter]
    public string? Class { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object>? AdditionalAttributes { get; set; }
}
