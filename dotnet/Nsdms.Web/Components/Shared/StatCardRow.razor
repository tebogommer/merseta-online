@namespace Nsdms.Web.Components.Shared
@using MudBlazor

<div class="stat-card-row mb-6 @Class">
    <MudGrid Spacing="4">
        @ChildContent
    </MudGrid>
</div>

@code {
    [Parameter] public string Class { get; set; } = string.Empty;
    [Parameter] public RenderFragment? ChildContent { get; set; }
}
