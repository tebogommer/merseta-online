@namespace Nsdms.Web.Components.Shared
@using MudBlazor

<div class="empty-state nsdms-empty-state d-flex flex-column align-center justify-center text-center pa-8 border rounded-lg"
     style="background-color: var(--surface); border: 1px dashed var(--border-strong); border-radius: var(--radius-lg);"
     role="region" aria-label="Empty State">
    <div class="d-flex align-center justify-center mb-3 rounded-circle pa-3" style="background-color: var(--background); width: 56px; height: 56px;">
        <MudIcon Icon="@(Icon ?? Icons.Material.Filled.Inbox)" Class="text-secondary" Size="Size.Large" />
    </div>
    <MudText Typo="Typo.subtitle1" Class="font-weight-bold mb-1" Style="color: var(--text-primary);">
        @(Message ?? "No records found")
    </MudText>
    @if (!string.IsNullOrWhiteSpace(Description))
    {
        <MudText Typo="Typo.body2" Class="text-secondary mb-4" Style="max-width: 440px;">
            @Description
        </MudText>
    }
    @if (Action != null)
    {
        <div class="mt-1">
            @Action
        </div>
    }
    else if (!string.IsNullOrWhiteSpace(ActionLabel))
    {
        <div class="mt-1">
            @if (!string.IsNullOrWhiteSpace(ActionHref))
            {
                <MudButton Variant="Variant.Filled" 
                           Color="Color.Primary" 
                           StartIcon="@Icons.Material.Filled.Add"
                           Href="@ActionHref">
                    @ActionLabel
                </MudButton>
            }
            else if (OnAction.HasDelegate)
            {
                <MudButton Variant="Variant.Filled" 
                           Color="Color.Primary" 
                           StartIcon="@Icons.Material.Filled.Refresh"
                           OnClick="OnAction">
                    @ActionLabel
                </MudButton>
            }
        </div>
    }
</div>

@code {
    [Parameter] public string? Message { get; set; }
    [Parameter] public string? Title { get => Message; set => Message = value; }
    [Parameter] public string? Description { get; set; }
    [Parameter] public string? Icon { get; set; }
    [Parameter] public RenderFragment? Action { get; set; }
    [Parameter] public string? ActionLabel { get; set; }
    [Parameter] public string? ActionHref { get; set; }
    [Parameter] public EventCallback OnAction { get; set; }
}
