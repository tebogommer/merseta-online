@namespace Nsdms.Web.Components.Shared
@using MudBlazor

@*
  UI-STANDARD.md Contract (Section 9.2, Clause 11.5, 13.2):
  Component: EmptyState
  Inputs: Message, Action
  Renders: Illustration/icon, explanatory line of guidance, and one resolving action.
*@

<div class="nsdms-empty-state pa-8 my-4 text-center rounded-lg bg-surface border-default" role="region" aria-label="Empty State">
    <div class="d-inline-flex align-center justify-center rounded-circle bg-light pa-4 mb-3" style="width: 72px; height: 72px;">
        <MudIcon Icon="@(string.IsNullOrWhiteSpace(Icon) ? Icons.Material.Outlined.FolderOpen : Icon)" 
                 Color="Color.Secondary" 
                 Size="Size.Large" />
    </div>

    <MudText Typo="Typo.h6" Class="font-weight-bold text-primary mb-1">
        @Message
    </MudText>

    @if (!string.IsNullOrWhiteSpace(Description))
    {
        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4" Style="max-width: 480px; margin: 0 auto;">
            @Description
        </MudText>
    }

    @if (!string.IsNullOrWhiteSpace(ActionLabel))
    {
        <div class="mt-4">
            @if (!string.IsNullOrWhiteSpace(ActionHref))
            {
                <MudButton Variant="Variant.Filled" 
                           Color="Color.Primary" 
                           StartIcon="@Icons.Material.Filled.Add"
                           Href="@ActionHref">
                    @ActionLabel
                </MudButton>
            }
            else if (OnAction.HasDelegate)
            {
                <MudButton Variant="Variant.Filled" 
                           Color="Color.Primary" 
                           StartIcon="@Icons.Material.Filled.Refresh"
                           OnClick="OnAction">
                    @ActionLabel
                </MudButton>
            }
        </div>
    }
</div>

@code {
    [Parameter]
    public string Message { get; set; } = "No records found.";

    [Parameter]
    public string? Description { get; set; }

    [Parameter]
    public string? Icon { get; set; }

    [Parameter]
    public string? ActionLabel { get; set; }

    [Parameter]
    public string? ActionHref { get; set; }

    [Parameter]
    public EventCallback OnAction { get; set; }
}
