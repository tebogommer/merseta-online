@namespace Nsdms.Web.Components.Shared.Forms
@using MudBlazor

<div class="nsdms-number-field">
    <MudGrid Spacing="2" Class="align-center">
        <MudItem xs="@(ShowSpecialToggle ? 8 : 12)">
            <MudNumericField T="int?"
                             Label="@Label"
                             Value="@Value"
                             ValueChanged="HandleValueChanged"
                             Min="@Min"
                             Max="@Max"
                             Step="@Step"
                             Disabled="@(Disabled || (ShowSpecialToggle && IsSpecialValue))"
                             Variant="@Variant"
                             HelperText="@(IsSpecialValue ? SpecialValueDisplayText : HelperText)"
                             Required="@Required"
                             Class="@Class" />
        </MudItem>

        @if (ShowSpecialToggle)
        {
            <MudItem xs="4" Class="d-flex align-center pt-3">
                <MudCheckBox T="bool"
                             Value="@IsSpecialValue"
                             ValueChanged="HandleSpecialToggleChanged"
                             Label="@SpecialToggleLabel"
                             Color="Color.Primary"
                             Dense="true" />
            </MudItem>
        }
    </MudGrid>
</div>

@code {
    [Parameter]
    public string? Label { get; set; }

    [Parameter]
    public int? Value { get; set; }

    [Parameter]
    public EventCallback<int?> ValueChanged { get; set; }

    [Parameter]
    public int? Min { get; set; }

    [Parameter]
    public int? Max { get; set; }

    [Parameter]
    public int Step { get; set; } = 1;

    [Parameter]
    public bool Required { get; set; }

    [Parameter]
    public bool Disabled { get; set; }

    [Parameter]
    public Variant Variant { get; set; } = Variant.Outlined;

    [Parameter]
    public string? HelperText { get; set; }

    [Parameter]
    public string? Class { get; set; }

    [Parameter]
    public bool ShowSpecialToggle { get; set; }

    [Parameter]
    public string SpecialToggleLabel { get; set; } = "Not applicable";

    [Parameter]
    public string SpecialValueDisplayText { get; set; } = "Set to not applicable";

    [Parameter]
    public bool IsSpecialValue { get; set; }

    [Parameter]
    public EventCallback<bool> IsSpecialValueChanged { get; set; }

    private async Task HandleValueChanged(int? val)
    {
        Value = val;
        if (ValueChanged.HasDelegate)
        {
            await ValueChanged.InvokeAsync(val);
        }
    }

    private async Task HandleSpecialToggleChanged(bool special)
    {
        IsSpecialValue = special;
        if (IsSpecialValueChanged.HasDelegate)
        {
            await IsSpecialValueChanged.InvokeAsync(special);
        }
        if (special)
        {
            Value = null;
            if (ValueChanged.HasDelegate)
            {
                await ValueChanged.InvokeAsync(null);
            }
        }
    }
}
