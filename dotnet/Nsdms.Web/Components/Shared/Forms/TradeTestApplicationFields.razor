    private string GetLearnerDisplayText(int? id)
    {
        if (!id.HasValue || Learners == null) return "Select candidate learner";
        var l = Learners.FirstOrDefault(x => x.Id == id.Value);
        return l == null ? "Select candidate learner" : $"{l.Person?.FirstName} {l.Person?.LastName} ({l.LearnerContractNumber ?? "Apprentice"})";
    }

    private string GetProviderDisplayText(int? id)
    {
        if (!id.HasValue || TrainingProviders == null) return "Select Trade Test Centre";
        var p = TrainingProviders.FirstOrDefault(x => x.Id == id.Value);
        if (p == null) return "Select Trade Test Centre";
        bool isAccredited = IsProviderAccredited(p);
        return $"{p.ProviderName} (Accreditation: {p.AccreditationNumber ?? "Active"}){(isAccredited ? " - Accredited for Trade" : "")}";
    }
