    // Local form state for adding an experience record
    private string _newExpEmployer = string.Empty;
    private string? _newExpRegNumber;
    private string? _newExpContactName;
    private string? _newExpContactPhone;
    private string? _newExpAddress;
    private string _newExpJobTitle = "Artisan Assistant";
    private DateTime? _newExpStartDate = DateTime.UtcNow.AddYears(-3);
    private DateTime? _newExpEndDate = DateTime.UtcNow.AddMonths(-6);
    private decimal _newExpYears = 2.5m;
    private string _newExpDuties = "Practical mechanical assembly, component maintenance, and safety log completion.";

    private decimal TotalExperienceYears => ExperienceDetails?.Sum(x => x.YearsOfExperience) ?? 0m;

    private bool IsToolkitTrade => ArplTradeValidator.RequiresToolkit(TradeTitle);

    private record DocRequirement(string Code, string Title, string Description);

    private List<DocRequirement> MandatoryDocumentList
    {
        get
        {
            if (IsToolkitTrade)
            {
                return new List<DocRequirement>
                {
                    new("STATEMENT_OF_RESULTS", "Statement of Results", "Official statement of modular curricular credits achieved"),
                    new("ARPL_APPLICATION_FORM", "ARPL Application Form (ETQ-TP-ARPL-01)", "Signed statutory ARPL registration application document"),
                    new("CERTIFIED_ID", "Certified RSA ID or Passport", "Clear certified copy of candidate identity document (not older than 3 months)"),
                    new("LEGAL_PROOF_SA", "Legal Status Proof in South Africa", "Permanent residence or valid statutory work permit documentation"),
                    new("NAMB_EVIDENCE_CONFIRMATION", "Confirmation of NAMB Evidence Packs", "Candidate evidence pack portfolio attestation"),
                    new("SERVICE_LETTER", "Service Letter(s)", "Official employment letters confirming trade practical exposure"),
                    new("POE_CHECKLIST", "Portfolio of Evidence (PoE) Checklist", "Signed practical task and toolkit assessment portfolio checklist")
                };
            }
            else
            {
                return new List<DocRequirement>
                {
                    new("ARPL_APPLICATION_FORM", "Trade Test Application Form (ETQ-TP-ARPL-01)", "Signed statutory registration application document"),
                    new("CERTIFIED_ID", "Certified RSA ID or Passport", "Clear certified copy of candidate identity document"),
                    new("HIGHEST_QUALIFICATION", "Certified Highest Qualification", "N2 / NCV Level 4 / Technical Grade 12 certified educational certificate"),
                    new("SERVICE_LETTER", "Service Letter(s)", "Official employer service letters confirming relevant trade experience"),
                    new("PRE_ASSESSMENT_REPORT", "Pre-Assessment Evaluation Report", "Report issued by accredited TTC confirming practical candidate readiness"),
                    new("LEGAL_PROOF_SA", "Legal Status Proof in South Africa", "Proof of citizenship or valid South African legal status")
                };
            }
        }
    }

    private bool AllMandatoryDocumentsConfirmed => MandatoryDocumentList.All(d => ConfirmedDocuments.Contains(d.Code));

    private async Task ToggleDocumentConfirmation(string code, bool isConfirmed)
    {
        if (isConfirmed)
        {
            ConfirmedDocuments.Add(code);
        }
        else
        {
            ConfirmedDocuments.Remove(code);
        }
        await ConfirmedDocumentsChanged.InvokeAsync(ConfirmedDocuments);
    }

    private async Task AddExperienceEntry()
    {
        if (string.IsNullOrWhiteSpace(_newExpEmployer)) return;

        var exp = new ArplExperienceDetail
        {
            EmployerName = _newExpEmployer.Trim(),
            CompanyRegistrationNumber = _newExpRegNumber?.Trim(),
            ContactPersonName = _newExpContactName?.Trim(),
            ContactPhoneNumber = _newExpContactPhone?.Trim(),
            EmployerAddress = _newExpAddress?.Trim(),
            JobTitle = _newExpJobTitle.Trim(),
            StartDate = _newExpStartDate ?? DateTime.UtcNow.AddYears(-2),
            EndDate = _newExpEndDate,
            YearsOfExperience = _newExpYears,
            DutiesDescription = _newExpDuties.Trim(),
            CreatedAt = DateTime.UtcNow,
            CreatedBy = "CandidateUser"
        };

        ExperienceDetails.Add(exp);
        await ExperienceDetailsChanged.InvokeAsync(ExperienceDetails);

        // Reset inputs
        _newExpEmployer = string.Empty;
        _newExpRegNumber = null;
        _newExpContactName = null;
        _newExpContactPhone = null;
        _newExpAddress = null;
        _newExpYears = 1.0m;
        _newExpDuties = string.Empty;
    }

    private async Task RemoveExperience(ArplExperienceDetail item)
    {
        ExperienceDetails.Remove(item);
        await ExperienceDetailsChanged.InvokeAsync(ExperienceDetails);
    }

    private bool IsProviderAccredited(TrainingProvider p)
    {
        if (p.Qualifications == null || !p.Qualifications.Any()) return true;
        if (string.IsNullOrWhiteSpace(TradeTitle)) return true;

        return p.Qualifications.Any(q =>
            (!string.IsNullOrEmpty(q.QualificationTitle) && q.QualificationTitle.Contains(TradeTitle, StringComparison.OrdinalIgnoreCase))
            || (!string.IsNullOrEmpty(TradeTitle) && TradeTitle.Contains(q.QualificationTitle, StringComparison.OrdinalIgnoreCase))
            || (TradeOfoCode != null && q.SaqaQualificationId.ToString() == TradeOfoCode));
    }

