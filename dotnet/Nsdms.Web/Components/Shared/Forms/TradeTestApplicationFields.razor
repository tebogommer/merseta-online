@namespace Nsdms.Web.Components.Shared.Forms
@using MudBlazor
@using Nsdms.Domain.Entities
@using Nsdms.Application.Common.Utilities

@if (Section == "Route" || Section == "All")
{
    <div class="nsdms-section-route mb-4">
        <FormRow>
            <MudItem xs="12" md="6">
                <MudSelect T="int?"
                           Label="Candidate learner"
                           Value="@CompanyLearnerId"
                           ValueChanged="OnCompanyLearnerChanged"
                           Variant="Variant.Outlined"
                           Required="true"
                           Disabled="@IsReadOnly"
                           ToStringFunc="@(id => GetLearnerDisplayText(id))"
                           HelperText="Select the registered apprentice or ARPL candidate">
                    @if (Learners != null)
                    {
                        @foreach (var l in Learners)
                        {
                            <MudSelectItem Value="@((int?)l.Id)">
                                @($"{l.Person?.FirstName} {l.Person?.LastName} (ID: {l.Person?.RsaIdNumber ?? "N/A"}) - {l.LearnerContractNumber ?? "Apprentice"}")
                            </MudSelectItem>
                        }
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12" md="6">
                <MudSelect T="string"
                           Label="Application route"
                           Value="@ApplicationTypeCode"
                           ValueChanged="OnApplicationTypeCodeChanged"
                           Variant="Variant.Outlined"
                           Required="true"
                           Disabled="@IsReadOnly"
                           HelperText="Statutory route under the Skills Development Act">
                    <MudSelectItem Value="@("Section26D")">Section 26D (Contracted Apprenticeship)</MudSelectItem>
                    <MudSelectItem Value="@("Section28")">Section 28 (ARPL - Recognition of Prior Learning)</MudSelectItem>
                    <MudSelectItem Value="@("Section26F")">Section 26F (National Artisan Moderation Body Special Direct)</MudSelectItem>
                </MudSelect>
            </MudItem>
            <MudItem xs="12" md="6">
                <MudTextField T="string"
                              Label="Designated trade title"
                              Value="@TradeTitle"
                              ValueChanged="OnTradeTitleChanged"
                              Variant="Variant.Outlined"
                              Required="true"
                              Disabled="@IsReadOnly"
                              HelperText="Statutory trade title (e.g. Fitter and Turner, Boilermaker, Electrician)" />
            </MudItem>
            <MudItem xs="12" md="3">
                <MudTextField T="string?"
                              Label="Trade OFO code"
                              Value="@TradeOfoCode"
                              ValueChanged="OnTradeOfoCodeChanged"
                              Variant="Variant.Outlined"
                              Disabled="@IsReadOnly"
                              HelperText="6-digit Organising Framework for Occupations code" />
            </MudItem>
            <MudItem xs="12" md="3">
                <MudNumericField T="int"
                                 Label="Attempt number"
                                 Value="@AttemptNumber"
                                 ValueChanged="OnAttemptNumberChanged"
                                 Variant="Variant.Outlined"
                                 Min="1"
                                 Max="3"
                                 Disabled="@IsReadOnly"
                                 HelperText="Max 3 attempts permitted under Section 5" />
            </MudItem>

            <!-- Statutory Employment Status (Signed 2023 Spec Section 4.2.3) -->
            <MudItem xs="12" md="6">
                <MudSelect T="string"
                           Label="Employment status"
                           Value="@EmploymentStatus"
                           ValueChanged="OnEmploymentStatusChanged"
                           Variant="Variant.Outlined"
                           Required="true"
                           Disabled="@IsReadOnly"
                           HelperText="Statutory employment status of the candidate">
                    <MudSelectItem Value="@("Employed")">Employed (Currently contracted at workplace)</MudSelectItem>
                    <MudSelectItem Value="@("Unemployed")">Unemployed (Informal sector, retrenched, or prior experience)</MudSelectItem>
                </MudSelect>
            </MudItem>

            @if (EmploymentStatus == "Unemployed")
            {
                <MudItem xs="12" md="6">
                    <MudTextField T="string?"
                                  Label="Non-registered employer / informal workshop (if applicable)"
                                  Value="@UnregisteredEmployerName"
                                  ValueChanged="OnUnregisteredEmployerNameChanged"
                                  Variant="Variant.Outlined"
                                  Disabled="@IsReadOnly"
                                  HelperText="Optional name of informal sector business where practical trade exposure was gained" />
                </MudItem>
            }

            @if (ApplicationTypeCode == "Section28")
            {
                <!-- Section 28 ARPL Specific Fields (Section 5 & 6.2) -->
                <MudItem xs="12" md="6">
                    <MudTextField T="string?"
                                  Label="Trade specialisation"
                                  Value="@Specialisation"
                                  ValueChanged="OnSpecialisationChanged"
                                  Variant="Variant.Outlined"
                                  Disabled="@IsReadOnly"
                                  HelperText="Candidate specific trade discipline (e.g. Arc Welding, CNC Turning, Heavy Plant Hydraulics)" />
                </MudItem>

                <MudItem xs="12">
                    <MudSelect T="ArplQualifyingCategory?"
                               Label="ARPL qualifying category (Section 5 Statutory Criteria)"
                               Value="@QualifyingCategory"
                               ValueChanged="OnQualifyingCategoryChanged"
                               Variant="Variant.Outlined"
                               Required="true"
                               Disabled="@IsReadOnly"
                               HelperText="Select qualifying educational and experience pathway under merSETA ARPL regulations">
                        <MudSelectItem Value="@((ArplQualifyingCategory?)ArplQualifyingCategory.Category1_Min3Years_N2)">Category 1: Min 3 Years Experience + N2 with Trade Theory</MudSelectItem>
                        <MudSelectItem Value="@((ArplQualifyingCategory?)ArplQualifyingCategory.Category2_Min3Years_NqfLevel3)">Category 2: Min 3 Years Experience + Engineering NQF Level 3 Certificate</MudSelectItem>
                        <MudSelectItem Value="@((ArplQualifyingCategory?)ArplQualifyingCategory.Category3_Min3Years_TechnicalGrade12)">Category 3: Min 3 Years Experience + Technical Grade 12 (Maths, Science &amp; Theory)</MudSelectItem>
                        <MudSelectItem Value="@((ArplQualifyingCategory?)ArplQualifyingCategory.Category4_Min18Months_NcvLevel4)">Category 4: Min 18 Months Experience + Engineering NCV Level 4 Certificate</MudSelectItem>
                        <MudSelectItem Value="@((ArplQualifyingCategory?)ArplQualifyingCategory.Category5_Min18Months_N6OrNationalDiploma)">Category 5: Min 18 Months Experience + N6 Certificate / National Technical Diploma</MudSelectItem>
                        <MudSelectItem Value="@((ArplQualifyingCategory?)ArplQualifyingCategory.Category6_Min4Years_Grade9)">Category 6: Min 4 Years Experience + Grade 9 (Standard 7)</MudSelectItem>
                        <MudSelectItem Value="@((ArplQualifyingCategory?)ArplQualifyingCategory.Category7_Min3Years_ToolkitAssessment)">Category 7: Min 3 Years Experience + ARPL Toolkits Assessment (17 Designated Trades Only)</MudSelectItem>
                        <MudSelectItem Value="@((ArplQualifyingCategory?)ArplQualifyingCategory.Category8_Min2Years_TradeLearnershipNqf2To4)">Category 8: Min 2 Years Experience + NQF Level 2-4 Trade-Related Learnership</MudSelectItem>
                    </MudSelect>
                </MudItem>

                <MudItem xs="12">
                    @if (ArplTradeValidator.RequiresToolkit(TradeTitle))
                    {
                        <MudAlert Severity="Severity.Success" Variant="Variant.Outlined" Dense="true" Class="my-2">
                            <strong>Designated Toolkit Trade:</strong> &lsquo;@TradeTitle&rsquo; is one of the 17 statutory designated trades equipped with toolkits. Category 7 admission is permitted.
                        </MudAlert>
                    }
                    else if (QualifyingCategory == ArplQualifyingCategory.Category7_Min3Years_ToolkitAssessment)
                    {
                        <MudAlert Severity="Severity.Warning" Variant="Variant.Filled" Dense="true" Class="my-2">
                            <strong>Notice:</strong> &lsquo;@TradeTitle&rsquo; is not a designated toolkit trade. Under statutory Section 5 regulations, Category 7 is restricted to the 17 designated trades. Please select an alternative qualifying category (1–6 or 8).
                        </MudAlert>
                    }
                </MudItem>

                <!-- Previous Trade Test Attempt (Section 6.2) -->
                <MudItem xs="12" md="4" Class="d-flex align-center">
                    <MudCheckBox T="bool"
                                 Label="Candidate previously attempted a trade test"
                                 Value="@HasAttemptedPreviously"
                                 ValueChanged="OnHasAttemptedPreviouslyChanged"
                                 Color="Color.Primary"
                                 Disabled="@IsReadOnly" />
                </MudItem>

                @if (HasAttemptedPreviously)
                {
                    <MudItem xs="12" md="4">
                        <MudTextField T="string?"
                                      Label="Previous Trade Test Centre name"
                                      Value="@PreviousCenterName"
                                      ValueChanged="OnPreviousCenterNameChanged"
                                      Variant="Variant.Outlined"
                                      Disabled="@IsReadOnly"
                                      HelperText="Name of testing facility where earlier assessment occurred" />
                    </MudItem>
                    <MudItem xs="12" md="2">
                        <MudDatePicker Label="Previous attempt date"
                                       Date="@PreviousAttemptDate"
                                       DateChanged="OnPreviousAttemptDateChanged"
                                       Variant="Variant.Outlined"
                                       Disabled="@IsReadOnly" />
                    </MudItem>
                    <MudItem xs="12" md="2">
                        <MudNumericField T="int?"
                                         Label="Total prior attempts"
                                         Value="@PreviousAttemptsCount"
                                         ValueChanged="OnPreviousAttemptsCountChanged"
                                         Variant="Variant.Outlined"
                                         Min="1"
                                         Max="2"
                                         Disabled="@IsReadOnly"
                                         HelperText="1 or 2 prior attempts" />
                    </MudItem>
                }
            }
        </FormRow>
    </div>
}

@if (Section == "Theory" || Section == "All")
{
    <div class="nsdms-section-theory mb-4">
        <FormRow>
            <MudItem xs="12" md="6">
                <MudTextField T="string"
                              Label="Technical qualification title"
                              Value="@TheoryQualificationTitle"
                              ValueChanged="OnTheoryQualificationTitleChanged"
                              Variant="Variant.Outlined"
                              Required="true"
                              Disabled="@IsReadOnly"
                              HelperText="e.g. National Technical Certificate N2, NCV Level 4, Technical Matric" />
            </MudItem>
            <MudItem xs="12" md="6">
                <MudTextField T="string"
                              Label="Training institution"
                              Value="@TheoryInstitutionName"
                              ValueChanged="OnTheoryInstitutionNameChanged"
                              Variant="Variant.Outlined"
                              Disabled="@IsReadOnly"
                              HelperText="TVET college, private technical college, or accredited SDP" />
            </MudItem>
            <MudItem xs="12">
                <MudTextField T="string"
                              Label="Compulsory technical subjects passed"
                              Value="@TheorySubjectsPassed"
                              ValueChanged="OnTheorySubjectsPassedChanged"
                              Variant="Variant.Outlined"
                              Required="true"
                              Disabled="@IsReadOnly"
                              HelperText="List completed subjects (e.g. Mathematics N2, Engineering Science N2, Trade Theory N2, Engineering Drawing N2)" />
            </MudItem>
            <MudItem xs="12" md="6">
                <MudDatePicker Label="Theory completion date"
                               Date="@TheoryCompletionDate"
                               DateChanged="OnTheoryCompletionDateChanged"
                               Variant="Variant.Outlined"
                               Disabled="@IsReadOnly"
                               HelperText="Date theoretical modular certification was achieved" />
            </MudItem>
            <MudItem xs="12" md="6" Class="d-flex align-center">
                <MudCheckBox T="bool"
                             Label="Candidate meets all statutory N2 / NCV Level 4 credit prerequisites"
                             Value="@IsCurricularPrerequisitesMet"
                             ValueChanged="OnIsCurricularPrerequisitesMetChanged"
                             Color="Color.Primary"
                             Disabled="@IsReadOnly" />
            </MudItem>
        </FormRow>
    </div>
}

@if (Section == "Logbook" || Section == "All")
{
    <div class="nsdms-section-logbook mb-4">
        @if (ApplicationTypeCode == "Section28")
        {
            <!-- Multi-Employer Workplace Experience Portfolio (Signed Spec Section 4.2.3) -->
            <MudCard Elevation="1" Class="pa-4 mb-4 rounded-lg" Style="border: 1px solid var(--mud-palette-divider);">
                <div class="d-flex align-center justify-space-between mb-3">
                    <div>
                        <MudText Typo="Typo.subtitle1" Class="font-weight-bold text-primary">
                            Workplace Experience Portfolio (Multi-Employer History)
                        </MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">
                            Capture verified practical trade experience across all previous employers. Cumulative total: <strong>@TotalExperienceYears.ToString("0.0") years</strong>.
                        </MudText>
                    </div>
                    <MudChip T="string" Color="@(TotalExperienceYears >= 3.0m ? Color.Success : Color.Warning)" Variant="Variant.Filled" Size="Size.Small">
                        @(TotalExperienceYears >= 3.0m ? "Meets 3-Year Threshold" : "Under 3-Year Minimum")
                    </MudChip>
                </div>

                @if (ExperienceDetails != null && ExperienceDetails.Any())
                {
                    <MudTable Items="@ExperienceDetails" Hover="true" Dense="true" Elevation="0" Outlined="true" Class="mb-3">
                        <HeaderContent>
                            <MudTh>Employer</MudTh>
                            <MudTh>Reg #</MudTh>
                            <MudTh>Contact Person &amp; Phone</MudTh>
                            <MudTh>Job Title / Scope</MudTh>
                            <MudTh>Period</MudTh>
                            <MudTh>Years</MudTh>
                            @if (!IsReadOnly)
                            {
                                <MudTh Style="text-align: right;">Action</MudTh>
                            }
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd><strong>@context.EmployerName</strong></MudTd>
                            <MudTd class="font-mono">@(context.CompanyRegistrationNumber ?? "N/A")</MudTd>
                            <MudTd>
                                @(context.ContactPersonName ?? "N/A")
                                @if (!string.IsNullOrWhiteSpace(context.ContactPhoneNumber))
                                {
                                    <span class="text-caption text-secondary d-block">@context.ContactPhoneNumber</span>
                                }
                            </MudTd>
                            <MudTd>@context.JobTitle</MudTd>
                            <MudTd>@context.StartDate.ToString("yyyy/MM") - @(context.EndDate?.ToString("yyyy/MM") ?? "Present")</MudTd>
                            <MudTd>@context.YearsOfExperience.ToString("0.0") yrs</MudTd>
                            @if (!IsReadOnly)
                            {
                                <MudTd Style="text-align: right;">
                                    <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                                   Color="Color.Error"
                                                   Size="Size.Small"
                                                   OnClick="@(() => RemoveExperience(context))"
                                                   aria-label="Remove Experience Entry" />
                                </MudTd>
                            }
                        </RowTemplate>
                    </MudTable>
                }
                else
                {
                    <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Dense="true" Class="mb-3">
                        No employer experience entries added yet. Use the form below to record historical work history.
                    </MudAlert>
                }

                @if (!IsReadOnly)
                {
                    <MudExpansionPanels Elevation="0" Outlined="true">
                        <MudExpansionPanel Text="Add workplace employer experience entry" Icon="@Icons.Material.Filled.AddBusiness">
                            <FormRow>
                                <MudItem xs="12" md="6">
                                    <MudTextField T="string"
                                                  Label="Employer / Company name"
                                                  @bind-Value="_newExpEmployer"
                                                  Variant="Variant.Outlined"
                                                  Dense="true" />
                                </MudItem>
                                <MudItem xs="12" md="6">
                                    <MudTextField T="string?"
                                                  Label="Company registration number (CIPC)"
                                                  @bind-Value="_newExpRegNumber"
                                                  Variant="Variant.Outlined"
                                                  Dense="true" />
                                </MudItem>
                                <MudItem xs="12" md="4">
                                    <MudTextField T="string?"
                                                  Label="Contact person name"
                                                  @bind-Value="_newExpContactName"
                                                  Variant="Variant.Outlined"
                                                  Dense="true" />
                                </MudItem>
                                <MudItem xs="12" md="4">
                                    <MudTextField T="string?"
                                                  Label="Contact phone number"
                                                  @bind-Value="_newExpContactPhone"
                                                  Variant="Variant.Outlined"
                                                  Dense="true" />
                                </MudItem>
                                <MudItem xs="12" md="4">
                                    <MudTextField T="string?"
                                                  Label="Employer physical address"
                                                  @bind-Value="_newExpAddress"
                                                  Variant="Variant.Outlined"
                                                  Dense="true" />
                                </MudItem>
                                <MudItem xs="12" md="4">
                                    <MudTextField T="string"
                                                  Label="Job title / Artisan role"
                                                  @bind-Value="_newExpJobTitle"
                                                  Variant="Variant.Outlined"
                                                  Dense="true" />
                                </MudItem>
                                <MudItem xs="12" md="3">
                                    <MudDatePicker Label="Start date"
                                                   @bind-Date="_newExpStartDate"
                                                   Variant="Variant.Outlined"
                                                   Dense="true" />
                                </MudItem>
                                <MudItem xs="12" md="3">
                                    <MudDatePicker Label="End date (blank if present)"
                                                   @bind-Date="_newExpEndDate"
                                                   Variant="Variant.Outlined"
                                                   Dense="true" />
                                </MudItem>
                                <MudItem xs="12" md="2">
                                    <MudNumericField T="decimal"
                                                     Label="Years"
                                                     @bind-Value="_newExpYears"
                                                     Variant="Variant.Outlined"
                                                     Dense="true"
                                                     Min="0.1m"
                                                     Max="30m"
                                                     Step="0.5m" />
                                </MudItem>
                                <MudItem xs="12">
                                    <MudTextField T="string"
                                                  Label="Scope of trade duties performed"
                                                  @bind-Value="_newExpDuties"
                                                  Variant="Variant.Outlined"
                                                  Dense="true"
                                                  HelperText="Summary of practical tooling, machinery, and daily technical operations handled" />
                                </MudItem>
                                <MudItem xs="12" Class="d-flex justify-end mt-2">
                                    <MudButton Variant="Variant.Filled"
                                               Color="Color.Primary"
                                               StartIcon="@Icons.Material.Filled.Add"
                                               OnClick="AddExperienceEntry"
                                               Disabled="@string.IsNullOrWhiteSpace(_newExpEmployer)">
                                        Add experience entry
                                    </MudButton>
                                </MudItem>
                            </FormRow>
                        </MudExpansionPanel>
                    </MudExpansionPanels>
                }
            </MudCard>
        }

        <FormRow>
            <MudItem xs="12" md="6">
                <MudTextField T="string"
                              Label="Current employer name"
                              Value="@CurrentEmployerName"
                              ValueChanged="OnCurrentEmployerNameChanged"
                              Variant="Variant.Outlined"
                              Required="true"
                              Disabled="@IsReadOnly"
                              HelperText="Employer organisation where practical workplace experience was gained" />
            </MudItem>
            <MudItem xs="12" md="6">
                <MudNumericField T="int"
                                 Label="Workplace practical duration (weeks)"
                                 Value="@LogbookWeeksCompleted"
                                 ValueChanged="OnLogbookWeeksCompletedChanged"
                                 Variant="Variant.Outlined"
                                 Min="1"
                                 Max="300"
                                 Required="true"
                                 Disabled="@IsReadOnly"
                                 HelperText="Minimum 80 weeks (approx. 3,200 hours) required for Section 28 ARPL entry" />
            </MudItem>
            <MudItem xs="12" md="6">
                <MudTextField T="string"
                              Label="Workplace artisan mentor full name"
                              Value="@WorkplaceMentorName"
                              ValueChanged="OnWorkplaceMentorNameChanged"
                              Variant="Variant.Outlined"
                              Required="true"
                              Disabled="@IsReadOnly"
                              HelperText="Qualified artisan responsible for workplace logbook supervision" />
            </MudItem>
            <MudItem xs="12" md="6">
                <MudTextField T="string?"
                              Label="Mentor Red Seal certificate number"
                              Value="@MentorArtisanTradeNumber"
                              ValueChanged="OnMentorArtisanTradeNumberChanged"
                              Variant="Variant.Outlined"
                              Disabled="@IsReadOnly"
                              HelperText="Mentor's Red Seal Trade Certificate serial number" />
            </MudItem>
            <MudItem xs="12" md="6">
                <MudTextField T="string"
                              Label="Employer contact phone number"
                              Value="@EmployerContactPhone"
                              ValueChanged="OnEmployerContactPhoneChanged"
                              Variant="Variant.Outlined"
                              Disabled="@IsReadOnly"
                              HelperText="Direct telephone for workplace logbook verification" />
            </MudItem>
            <MudItem xs="12" md="6" Class="d-flex align-center">
                <MudCheckBox T="bool"
                             Label="Verified employer logbook &amp; Portfolio of Evidence (PoE) attached"
                             Value="@IsLogbookAttestationVerified"
                             ValueChanged="OnIsLogbookAttestationVerifiedChanged"
                             Color="Color.Primary"
                             Disabled="@IsReadOnly" />
            </MudItem>
        </FormRow>
    </div>
}

@if (Section == "Centre" || Section == "All")
{
    <div class="nsdms-section-centre mb-4">
        <FormRow>
            <MudItem xs="12" md="6">
                <MudSelect T="int?"
                           Label="Accredited Trade Test Centre (TTC)"
                           Value="@TrainingProviderId"
                           ValueChanged="OnTrainingProviderChanged"
                           Variant="Variant.Outlined"
                           Required="true"
                           Disabled="@IsReadOnly"
                           ToStringFunc="@(id => GetProviderDisplayText(id))"
                           HelperText="Select the NAMB-accredited testing facility (filtered by trade accreditation)">
                    @if (TrainingProviders != null)
                    {
                        @foreach (var p in TrainingProviders)
                        {
                            bool isAccredited = IsProviderAccredited(p);
                            <MudSelectItem Value="@((int?)p.Id)">
                                @($"{p.ProviderName} (Accreditation: {p.AccreditationNumber ?? "Active"}){(isAccredited ? " - Accredited for Trade" : "")}")
                            </MudSelectItem>
                        }
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12" md="6">
                <MudDatePicker Label="Preferred assessment date"
                               Date="@PreferredAssessmentDate"
                               DateChanged="OnPreferredAssessmentDateChanged"
                               Variant="Variant.Outlined"
                               Required="true"
                               Disabled="@IsReadOnly"
                               HelperText="Earliest candidate availability for trade test practical examination" />
            </MudItem>
            <MudItem xs="12" md="6">
                <MudSelect T="string"
                           Label="Assessment funding subsidy category"
                           Value="@SubsidyCategory"
                           ValueChanged="OnSubsidyCategoryChanged"
                           Variant="Variant.Outlined"
                           Required="true"
                           Disabled="@IsReadOnly"
                           HelperText="Trade test examination fee funding mechanism">
                    <MudSelectItem Value="@("merSETA Subsidised")">merSETA Funded Grant Subsidy</MudSelectItem>
                    <MudSelectItem Value="@("Employer Funded")">Host Employer Funded</MudSelectItem>
                    <MudSelectItem Value="@("Private Candidate")">Private Candidate Self-Funded</MudSelectItem>
                </MudSelect>
            </MudItem>
            <MudItem xs="12" md="6" Class="d-flex align-center">
                <MudCheckBox T="bool"
                             Label="Candidate equipped with SABS-approved safety PPE and trade artisan toolkit"
                             Value="@IsToolAndPpeReady"
                             ValueChanged="OnIsToolAndPpeReadyChanged"
                             Color="Color.Primary"
                             Disabled="@IsReadOnly" />
            </MudItem>
        </FormRow>
    </div>
}

@if (Section == "Documents" || Section == "All")
{
    <div class="nsdms-section-documents mb-4">
        <MudCard Elevation="1" Class="pa-4 rounded-lg" Style="border: 1px solid var(--mud-palette-divider);">
            <div class="d-flex align-center justify-space-between mb-3">
                <div>
                    <MudText Typo="Typo.subtitle1" Class="font-weight-bold text-primary">
                        Statutory Document Verification Checklist
                    </MudText>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">
                        @(IsToolkitTrade ? "7 Statutory Documents Required for Designated Toolkit Trade" : "6 Statutory Documents Required for Non-Toolkit Trade") per Section 4.2.7 of Signed Specification.
                    </MudText>
                </div>
                <MudChip T="string" Color="@(AllMandatoryDocumentsConfirmed ? Color.Success : Color.Warning)" Variant="Variant.Filled" Size="Size.Small">
                    @(AllMandatoryDocumentsConfirmed ? "All Documents Confirmed" : $"{ConfirmedDocuments.Count} of {MandatoryDocumentList.Count} Confirmed")
                </MudChip>
            </div>

            <MudTable Items="@MandatoryDocumentList" Hover="true" Dense="true" Elevation="0" Outlined="true">
                <HeaderContent>
                    <MudTh Style="width: 50px;">Status</MudTh>
                    <MudTh>Document Name &amp; Description</MudTh>
                    <MudTh Style="width: 140px;">Requirement</MudTh>
                    @if (!IsReadOnly)
                    {
                        <MudTh Style="width: 120px; text-align: right;">Confirmation</MudTh>
                    }
                </HeaderContent>
                <RowTemplate>
                    <MudTd>
                        @if (ConfirmedDocuments.Contains(context.Code))
                        {
                            <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success" Size="Size.Small" />
                        }
                        else
                        {
                            <MudIcon Icon="@Icons.Material.Filled.HourglassEmpty" Color="Color.Warning" Size="Size.Small" />
                        }
                    </MudTd>
                    <MudTd>
                        <MudText Typo="Typo.body2" Class="fw-semibold">@context.Title</MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">@context.Description</MudText>
                    </MudTd>
                    <MudTd>
                        <MudChip T="string" Size="Size.Small" Color="Color.Info" Variant="Variant.Outlined">Mandatory</MudChip>
                    </MudTd>
                    @if (!IsReadOnly)
                    {
                        <MudTd Style="text-align: right;">
                            <MudCheckBox T="bool"
                                         Value="@ConfirmedDocuments.Contains(context.Code)"
                                         ValueChanged="@((val) => ToggleDocumentConfirmation(context.Code, val))"
                                         Color="Color.Primary"
                                         Dense="true" />
                        </MudTd>
                    }
                </RowTemplate>
            </MudTable>
        </MudCard>
    </div>
}

@if (Section == "Declaration" || Section == "All")
{
    <div class="nsdms-section-declaration mb-4">
        <MudAlert Severity="Severity.Info" Class="mb-3">
            In terms of Section 26D and Section 28 of the Skills Development Act (Act 97 of 1998) and NAMB Trade Test Regulations, all information supplied will be cross-referenced with national databases. Candidates achieving at least 70% in practical evaluations and 100% in compulsory safety modules qualify for Red Seal serial certification.
        </MudAlert>
        <MudCheckBox T="bool"
                     Label="I solemnly declare that all educational certificates, workplace logbooks, and candidate identity credentials submitted are authentic and correct."
                     Value="@IsPopiaAndCandidateDeclarationAccepted"
                     ValueChanged="OnIsPopiaAndCandidateDeclarationAcceptedChanged"
                     Color="Color.Primary"
                     Disabled="@IsReadOnly"
                     Required="true" />
    </div>
}

