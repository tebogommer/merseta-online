@namespace Nsdms.Web.Components.Shared.Forms
@using MudBlazor

<MudGrid Spacing="@Spacing" Class="@($"nsdms-form-row {Class}")">
    @ChildContent
</MudGrid>

@code {
    [Parameter]
    public int Spacing { get; set; } = 3;

    [Parameter]
    public string? Class { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }
}
