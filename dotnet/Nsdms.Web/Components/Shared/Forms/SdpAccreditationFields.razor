        await HasAdmissionsPolicyChanged.InvokeAsync(val);
    }

    private async Task OnHasAssessmentPolicyChanged(bool val)
    {
        HasAssessmentPolicy = val;
        await HasAssessmentPolicyChanged.InvokeAsync(val);
    }

    private async Task OnHasAppealsPolicyChanged(bool val)
    {
        HasAppealsPolicy = val;
        await HasAppealsPolicyChanged.InvokeAsync(val);
    }

    private async Task OnHasFinancialInsuranceChanged(bool val)
    {
        HasFinancialInsurance = val;
        await HasFinancialInsuranceChanged.InvokeAsync(val);
    }

    private async Task OnOhsCertificateNumberChanged(string val)
    {
        OhsCertificateNumber = val;
        await OhsCertificateNumberChanged.InvokeAsync(val);
    }

    private async Task OnQmsManualReferenceChanged(string val)
