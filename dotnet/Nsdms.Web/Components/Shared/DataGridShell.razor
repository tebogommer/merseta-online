@typeparam TItem
@namespace Nsdms.Web.Components.Shared
@using MudBlazor

<div class="data-grid-shell nsdms-datagrid-shell @Class" role="region" aria-label="@(string.IsNullOrWhiteSpace(Title) ? "Data Grid" : Title)">
    <!-- Optional Title / Top Bar Actions -->
    @if (!string.IsNullOrWhiteSpace(Title) || !string.IsNullOrWhiteSpace(CreateRoute) || TopBarActions != null)
    {
        <div class="d-flex flex-wrap justify-space-between align-center gap-3 mb-3">
            <div>
                @if (!string.IsNullOrWhiteSpace(Title))
                {
                    <h2 class="mud-typography mud-typography-h6 font-weight-bold ma-0 text-primary">
                        @Title
                    </h2>
                }
                @if (!string.IsNullOrWhiteSpace(Subtitle))
                {
                    <MudText Typo="Typo.caption" Color="Color.Secondary">
                        @Subtitle
                    </MudText>
                }
            </div>

            <div class="d-flex align-center gap-2">
                @if (TopBarActions != null)
                {
                    @TopBarActions
                }

                @if (!string.IsNullOrWhiteSpace(CreateRoute))
                {
                    <MudButton Variant="Variant.Filled" 
                               Color="Color.Primary" 
                               StartIcon="@Icons.Material.Filled.Add" 
                               Href="@CreateRoute">
                        @(string.IsNullOrWhiteSpace(CreateLabel) ? "New Record" : CreateLabel)
                    </MudButton>
                }
            </div>
        </div>
    }

    <!-- Toolbar: Search, Result Count, Columns, Custom Actions -->
    @if (QuickFilter != null || CustomActions != null || !string.IsNullOrWhiteSpace(SearchPlaceholder) || FilterContent != null || ActiveFilterChips != null)
    {
        <div class="grid-toolbar mb-3 d-flex flex-column flex-md-row justify-space-between align-start align-md-center gap-3">
            <div class="d-flex align-center gap-3 flex-grow-1" style="max-width: 480px; width: 100%;">
                <MudTextField @bind-Value="SearchString"
                              Placeholder="@(SearchPlaceholder ?? "Search records...")"
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Search"
                              IconSize="Size.Small"
                              Clearable="true"
                              Immediate="true"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              Class="flex-grow-1"
                              Style="border-radius: var(--radius-md); background: var(--surface);" />
            </div>

            <div class="d-flex align-center gap-2 flex-wrap">
                <span class="text-secondary font-mono mr-1" style="font-size: 0.8125rem;">
                    @EffectiveCount @(EffectiveCount == 1 ? "record" : "records")
                </span>

                <MudTooltip Text="Column visibility &amp; density">
                    <MudIconButton Icon="@Icons.Material.Filled.ViewWeek" 
                                   Color="Color.Default" 
                                   Size="Size.Small" 
                                   Style="border: 1px solid var(--border); border-radius: 6px; padding: 4px;"
                                   aria-label="Toggle column layout" />
                </MudTooltip>

                @if (CustomActions != null)
                {
                    @CustomActions
                }
                @if (ExportCallback.HasDelegate)
                {
                    <MudTooltip Text="Export visible data">
                        <MudIconButton Icon="@Icons.Material.Filled.Download" 
                                       Color="Color.Default" 
                                       Size="Size.Small" 
                                       OnClick="ExportCallback" 
                                       aria-label="Export data" />
                    </MudTooltip>
                }
            </div>
        </div>

        @if (FilterContent != null || ActiveFilterChips != null || (HasActiveFilters && OnClearFilters.HasDelegate))
        {
            <div class="pa-3 mb-3 rounded border" style="background: var(--surface); border-color: var(--border);">
                @if (FilterContent != null)
                {
                    <div class="d-flex flex-wrap align-center gap-2 flex-grow-1 mb-2">
                        @FilterContent
                    </div>
                }
                @if (ActiveFilterChips != null || (HasActiveFilters && OnClearFilters.HasDelegate))
                {
                    <div class="d-flex flex-wrap align-center gap-2 pt-2 border-t" style="border-color: var(--border);">
                        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="font-weight-medium">Active Filters:</MudText>
                        @ActiveFilterChips
                        @if (HasActiveFilters && OnClearFilters.HasDelegate)
                        {
                            <MudChip T="string" Color="Color.Error" Variant="Variant.Text" Size="Size.Small" OnClick="OnClearFilters" Icon="@Icons.Material.Filled.ClearAll">
                                Clear All
                            </MudChip>
                        }
                    </div>
                }
            </div>
        }
    }

    <!-- Bulk Action Bar -->
    @if (EffectiveSelectedItems != null && EffectiveSelectedItems.Any())
    {
        <MudPaper Elevation="0" Class="pa-3 mb-3 border rounded d-flex justify-space-between align-center flex-wrap gap-2" style="background-color: var(--brand-gold-subtle); border-color: var(--brand-gold);">
            <div class="d-flex align-center gap-2">
                <MudChip T="string" Color="Color.Primary" Size="Size.Small">
                    @EffectiveSelectedItems.Count() selected
                </MudChip>
                <MudButton Variant="Variant.Text" Color="Color.Default" Size="Size.Small" OnClick="ClearSelection">
                    Clear selection
                </MudButton>
            </div>
            <div class="d-flex align-center gap-2">
                @if (BulkActionBarContent != null)
                {
                    @BulkActionBarContent
                }
                else if (BulkActions != null)
                {
                    @BulkActions(EffectiveSelectedItems)
                }
            </div>
        </MudPaper>
    }

    <!-- 5 Discrete Grid States -->
    <MudCard Elevation="0" Class="border rounded-lg overflow-hidden" Style="border: 1px solid var(--border); border-radius: var(--radius-lg); background: var(--surface);">
        @if (IsLoading)
        {
            <div class="pa-6">
                @for (int i = 0; i < 5; i++)
                {
                    <div class="d-flex gap-4 py-3 border-b" style="border-color: var(--border);">
                        <MudSkeleton Width="20%" Height="24px" Animation="Animation.Wave" />
                        <MudSkeleton Width="40%" Height="24px" Animation="Animation.Wave" />
                        <MudSkeleton Width="25%" Height="24px" Animation="Animation.Wave" />
                        <MudSkeleton Width="15%" Height="24px" Animation="Animation.Wave" />
                    </div>
                }
            </div>
        }
        else if (IsError || !string.IsNullOrWhiteSpace(ErrorMessage))
        {
            <div class="pa-10 text-center">
                <MudIcon Icon="@Icons.Material.Filled.ErrorOutline" Color="Color.Error" Size="Size.Large" Class="mb-3" />
                <MudText Typo="Typo.subtitle1" Class="font-weight-bold text-danger">Failed to load records</MudText>
                <MudText Typo="Typo.body2" Class="text-secondary mb-4">
                    @(ErrorMessage ?? "A connection or database error occurred while querying records.")
                </MudText>
                @if (OnRetry.HasDelegate)
                {
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Refresh" OnClick="OnRetry">
                        Retry query
                    </MudButton>
                }
            </div>
        }
        else if (ChildContent != null)
        {
            @ChildContent
        }
        else if (Items == null || !Items.Any())
        {
            <div class="pa-4">
                <EmptyState Message="@(EmptyMessage ?? "No records registered yet")"
                            Description="@(EmptyDescription ?? "Create your first record to begin tracking assets.")"
                            ActionLabel="@(!string.IsNullOrWhiteSpace(CreateRoute) ? (CreateLabel ?? "Create Record") : (OnEmptyAction.HasDelegate ? EmptyActionLabel : null))"
                            ActionHref="@CreateRoute"
                            OnAction="OnEmptyAction"
                            Action="@EmptyAction" />
            </div>
        }
        else if (!FilteredItems.Any())
        {
            <div class="pa-10 text-center">
                <MudIcon Icon="@Icons.Material.Filled.FilterAltOff" Color="Color.Default" Size="Size.Large" Class="text-secondary mb-3" />
                <MudText Typo="Typo.subtitle1" Class="font-weight-bold">No matching results</MudText>
                <MudText Typo="Typo.body2" Class="text-secondary mb-4">
                    @(FilterEmptyMessage ?? "Your search or active filters excluded all records.")
                </MudText>
                <MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="@(() => SearchString = "")">
                    Clear search filter
                </MudButton>
            </div>
        }
        else if (Columns != null)
        {
            <div class="table-responsive" style="width: 100%; max-width: 100%; overflow-x: auto; -webkit-overflow-scrolling: touch;">
                <MudDataGrid T="TItem"
                             Items="@FilteredItems"
                             MultiSelection="@Selectable"
                             SelectedItems="@SelectedItems"
                             SelectedItemsChanged="@SelectedItemsChanged"
                             Filterable="false"
                             SortMode="SortMode.Multiple"
                             Hover="true"
                             Dense="true"
                             Elevation="0"
                             RowsPerPage="20">
                    <Columns>
                        @if (Selectable)
                        {
                            <SelectColumn T="TItem" />
                        }
                        @Columns
                    </Columns>
                    <PagerContent>
                        <div class="d-flex justify-end align-center px-4 py-2 border-t" style="border-color: var(--border);">
                            <MudDataGridPager T="TItem" PageSizeOptions="new int[] { 10, 20, 50, 100 }" />
                        </div>
                    </PagerContent>
                </MudDataGrid>
            </div>
        }
        else if (RowTemplate != null)
        {
            <MudTable Items="@FilteredItems" Hover="true" Dense="true" Striped="true" Breakpoint="Breakpoint.Sm" T="TItem">
                <HeaderContent>
                    @HeaderContent
                </HeaderContent>
                <RowTemplate Context="rowContext">
                    @RowTemplate(rowContext)
                </RowTemplate>
                <PagerContent>
                    <div class="d-flex flex-wrap justify-space-between align-center pa-3">
                        <MudText Typo="Typo.caption" Color="Color.Secondary">
                            Total Records: <strong class="font-monospace">@EffectiveCount.ToString("N0")</strong>
                        </MudText>
                        <MudTablePager PageSizeOptions="new int[] { 10, 20, 50, 100 }" />
                    </div>
                </PagerContent>
            </MudTable>
        }
    </MudCard>
</div>

@code {
    [Parameter] public string GridKey { get; set; } = "DefaultGrid";
    [Parameter] public string? Title { get; set; }
    [Parameter] public string? Subtitle { get; set; }
    [Parameter] public string? CreateRoute { get; set; }
    [Parameter] public string? CreateLabel { get; set; }
    [Parameter] public IEnumerable<TItem>? Items { get; set; } = new List<TItem>();
    [Parameter] public Func<TItem, string, bool>? QuickFilter { get; set; }
    [Parameter] public RenderFragment? Columns { get; set; }
    [Parameter] public RenderFragment<IEnumerable<TItem>>? BulkActions { get; set; }
    [Parameter] public RenderFragment? BulkActionBarContent { get; set; }
    [Parameter] public RenderFragment? CustomActions { get; set; }
    [Parameter] public RenderFragment? TopBarActions { get; set; }
    [Parameter] public RenderFragment? EmptyAction { get; set; }
    [Parameter] public RenderFragment? FilterContent { get; set; }
    [Parameter] public RenderFragment? ActiveFilterChips { get; set; }
    [Parameter] public RenderFragment? HeaderContent { get; set; }
    [Parameter] public RenderFragment<TItem>? RowTemplate { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public string? SearchPlaceholder { get; set; }
    [Parameter] public string? EmptyMessage { get; set; }
    [Parameter] public string? EmptyTitle { get; set; }
    [Parameter] public string? EmptyDescription { get; set; }
    [Parameter] public string? EmptyActionLabel { get; set; }
    [Parameter] public string? FilterEmptyMessage { get; set; }
    [Parameter] public string? ErrorMessage { get; set; }
    [Parameter] public bool IsLoading { get; set; } = false;
    [Parameter] public bool IsError { get; set; } = false;
    [Parameter] public bool Selectable { get; set; } = false;
    [Parameter] public string Class { get; set; } = "";
    [Parameter] public int TotalCount { get; set; }
    [Parameter] public int TotalItemsCount { get => TotalCount; set => TotalCount = value; }
    [Parameter] public bool HasActiveFilters { get; set; } = false;
    [Parameter] public EventCallback OnClearFilters { get; set; }
    [Parameter] public EventCallback OnEmptyAction { get; set; }
    [Parameter] public EventCallback OnClearSelection { get; set; }
    [Parameter] public EventCallback ExportCallback { get; set; }
    [Parameter] public EventCallback OnRetry { get; set; }
    [Parameter] public HashSet<TItem>? SelectedItems { get; set; }
    [Parameter] public EventCallback<HashSet<TItem>> SelectedItemsChanged { get; set; }

    private string SearchString = "";

    private IEnumerable<TItem>? EffectiveSelectedItems => SelectedItems;

    private IEnumerable<TItem> FilteredItems
    {
        get
        {
            if (Items == null) return Enumerable.Empty<TItem>();
            if (string.IsNullOrWhiteSpace(SearchString) || QuickFilter == null)
                return Items;

            return Items.Where(item => QuickFilter(item, SearchString));
        }
    }

    private int EffectiveCount => TotalCount > 0 ? TotalCount : (Items?.Count() ?? 0);

    private void ClearSelection()
    {
        SelectedItems = new HashSet<TItem>();
        SelectedItemsChanged.InvokeAsync(SelectedItems);
        if (OnClearSelection.HasDelegate)
        {
            OnClearSelection.InvokeAsync();
        }
    }
}
