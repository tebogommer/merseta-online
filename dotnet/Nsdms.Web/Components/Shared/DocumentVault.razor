@using Nsdms.Application.Services
@using Nsdms.Domain.Entities
@inject IStorageService StorageService
@inject ISnackbar Snackbar

<MudPaper Elevation="1" Class="document-vault pa-4 rounded-lg">
    <div class="d-flex align-center justify-space-between mb-3">
        <div class="d-flex align-center gap-2">
            <MudIcon Icon="@Icons.Material.Filled.FolderZip" Color="Color.Primary" Size="Size.Small" />
            <MudText Typo="Typo.subtitle1" Class="font-weight-bold">Document &amp; Evidence Vault</MudText>
        </div>
        <MudButton Variant="Variant.Outlined" 
                   Color="Color.Primary" 
                   Size="Size.Small" 
                   StartIcon="@Icons.Material.Filled.CloudUpload"
                   OnClick="() => _showUploadModal = true">
            Upload Document
        </MudButton>
    </div>

    @if (_loading)
    {
        <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="my-2" />
    }
    else if (!_documents.Any())
    {
        <MudPaper Elevation="0" Class="pa-4 text-center rounded border border-dashed">
            <MudIcon Icon="@Icons.Material.Filled.UploadFile" Size="Size.Large" Color="Color.Secondary" />
            <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mt-1">No compliance evidence documents uploaded yet.</MudText>
        </MudPaper>
    }
    else
    {
        <MudTable Items="@_documents" Dense="true" Hover="true" Elevation="0" Outlined="true">
            <HeaderContent>
                <MudTh>Document Type</MudTh>
                <MudTh>File Name</MudTh>
                <MudTh>Size</MudTh>
                <MudTh>Uploaded By</MudTh>
                <MudTh>Upload Date</MudTh>
                <MudTh>Status</MudTh>
                <MudTh Style="text-align: right;">Actions</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Document Type">
                    <MudText Typo="Typo.body2" Class="font-weight-bold">@context.DocumentTypeName</MudText>
                    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="font-mono">@context.DocumentTypeCode</MudText>
                </MudTd>
                <MudTd DataLabel="File Name">
                    <div class="d-flex align-center gap-1">
                        <MudIcon Icon="@Icons.Material.Filled.PictureAsPdf" Size="Size.Small" Color="Color.Error" />
                        <MudText Typo="Typo.body2">@context.FileName</MudText>
                    </div>
                </MudTd>
                <MudTd DataLabel="Size">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">@FormatFileSize(context.FileSizeBytes)</MudText>
                </MudTd>
                <MudTd DataLabel="Uploaded By">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">@(context.UploadedByUserName ?? "System User")</MudText>
                </MudTd>
                <MudTd DataLabel="Upload Date">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">@context.UploadDate.ToLocalTime().ToString("dd MMM yyyy")</MudText>
                </MudTd>
                <MudTd DataLabel="Status">
                    @if (context.IsVerified)
                    {
                        <MudChip T="string" Color="Color.Success" Variant="Variant.Filled" Size="Size.Small">
                            Verified
                        </MudChip>
                    }
                    else
                    {
                        <MudChip T="string" Color="Color.Warning" Variant="Variant.Filled" Size="Size.Small">
                            Pending Check
                        </MudChip>
                    }
                </MudTd>
                <MudTd DataLabel="Actions" Style="text-align: right;">
                    <div class="d-flex justify-end gap-1">
                        @if (!context.IsVerified)
                        {
                            <MudIconButton Icon="@Icons.Material.Filled.CheckCircle" 
                                           Color="Color.Success" 
                                           Size="Size.Small" 
                                           aria-label="Verify document"
                                           OnClick="() => VerifyDocAsync(context.Id)" />
                        }
                        <MudIconButton Icon="@Icons.Material.Filled.Delete" 
                                       Color="Color.Error" 
                                       Size="Size.Small" 
                                       aria-label="Delete document"
                                       OnClick="() => DeleteDocAsync(context.Id)" />
                    </div>
                </MudTd>
            </RowTemplate>
        </MudTable>
    }

    <!-- Upload Modal -->
    @if (_showUploadModal)
    {
        <MudPaper Elevation="2" Class="upload-modal pa-4 mt-3 rounded-lg">
            <MudText Typo="Typo.subtitle2" Class="font-weight-bold mb-3">
                Upload Compliance Evidence
            </MudText>
            <MudGrid Spacing="2">
                <MudItem xs="12" md="6">
                    <MudSelect T="string" @bind-Value="_selectedDocType" Label="Document Requirement Type" Variant="Variant.Outlined" Margin="Margin.Dense">
                        <MudSelectItem Value="@("RSA_ID")">Certified RSA ID Document</MudSelectItem>
                        <MudSelectItem Value="@("BANK_CONFIRM")">Proof of Banking Details</MudSelectItem>
                        <MudSelectItem Value="@("ACCREDIT_CERT")">Accreditation Certificate</MudSelectItem>
                        <MudSelectItem Value="@("TOOL_EVIDENCE")">Tool &amp; Workshop Checklist</MudSelectItem>
                        <MudSelectItem Value="@("WSP_SIGNOFF")">WSP Management Signoff Sheet</MudSelectItem>
                        <MudSelectItem Value="@("TRADE_RESULT")">Trade Test Assessment Report</MudSelectItem>
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudTextField @bind-Value="_inputFileName" Label="File Name" Variant="Variant.Outlined" Margin="Margin.Dense" Placeholder="e.g. proof_of_banking_2026.pdf" />
                </MudItem>
            </MudGrid>
            <div class="d-flex justify-end gap-2 mt-3">
                <MudButton Variant="Variant.Text" OnClick="() => _showUploadModal = false">Cancel</MudButton>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.CloudUpload" OnClick="UploadSampleDocAsync">
                    Upload to Vault
                </MudButton>
            </div>
        </MudPaper>
    }
</MudPaper>

@code {
    [Parameter] public string TargetEntityName { get; set; } = string.Empty;
    [Parameter] public int TargetEntityId { get; set; }

    private List<DocumentMetadata> _documents = new();
    private bool _loading = true;
    private bool _showUploadModal = false;
    private string _selectedDocType = "RSA_ID";
    private string _inputFileName = "compliance_document_2026.pdf";

    protected override async Task OnParametersSetAsync()
    {
        await LoadDocumentsAsync();
    }

    public async Task RefreshAsync()
    {
        await LoadDocumentsAsync();
        StateHasChanged();
    }

    private async Task LoadDocumentsAsync()
    {
        if (string.IsNullOrEmpty(TargetEntityName) || TargetEntityId <= 0)
        {
            _loading = false;
            return;
        }

        _loading = true;
        try
        {
            _documents = await StorageService.GetDocumentsForEntityAsync(TargetEntityName, TargetEntityId);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task UploadSampleDocAsync()
    {
        if (string.IsNullOrWhiteSpace(_inputFileName)) return;

        var sampleBytes = System.Text.Encoding.UTF8.GetBytes($"Sample document content for {TargetEntityName} #{TargetEntityId}");
        using var stream = new MemoryStream(sampleBytes);

        var docName = _selectedDocType switch
        {
            "RSA_ID" => "Certified RSA ID Document",
            "BANK_CONFIRM" => "Proof of Banking Details",
            "ACCREDIT_CERT" => "Accreditation Certificate",
            "TOOL_EVIDENCE" => "Tool & Workshop Checklist",
            "WSP_SIGNOFF" => "WSP Management Signoff Sheet",
            "TRADE_RESULT" => "Trade Test Assessment Report",
            _ => "Compliance Document"
        };

        await StorageService.UploadDocumentAsync(
            TargetEntityName,
            TargetEntityId,
            _selectedDocType,
            docName,
            _inputFileName,
            stream,
            "application/pdf",
            "admin@merseta.org.za",
            "Administrator");

        _showUploadModal = false;
        Snackbar.Add($"Document '{_inputFileName}' vaulted successfully.", Severity.Success);
        await LoadDocumentsAsync();
    }

    private async Task VerifyDocAsync(int documentId)
    {
        await StorageService.VerifyDocumentAsync(documentId, "admin@merseta.org.za", "Verified by Administrator");
        Snackbar.Add("Document marked as verified.", Severity.Success);
        await LoadDocumentsAsync();
    }

    private async Task DeleteDocAsync(int documentId)
    {
        await StorageService.DeleteDocumentAsync(documentId);
        Snackbar.Add("Document removed from vault.", Severity.Info);
        await LoadDocumentsAsync();
    }

    private static string FormatFileSize(long bytes)
    {
        if (bytes < 1024) return $"{bytes} B";
        if (bytes < 1024 * 1024) return $"{bytes / 1024.0:F1} KB";
        return $"{bytes / (1024.0 * 1024.0):F2} MB";
    }
}
