@using Nsdms.Application.Services
@using Nsdms.Domain.Entities
@inject IWorkflowEngineService WorkflowService

<MudPaper Elevation="1" Class="workflow-timeline pa-4 rounded-lg">
    <div class="d-flex align-center gap-2 mb-3">
        <MudIcon Icon="@Icons.Material.Filled.History" Color="Color.Primary" Size="Size.Small" />
        <MudText Typo="Typo.subtitle1" Class="font-weight-bold" Color="Color.Primary">Workflow History &amp; Audit Trail</MudText>
    </div>

    @if (_loading)
    {
        <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="my-2" />
    }
    else if (!_historyItems.Any())
    {
        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="font-italic">
            No workflow transition events recorded yet.
        </MudText>
    }
    else
    {
        <MudTimeline TimelinePosition="TimelinePosition.Start" Class="pa-0">
            @foreach (var item in _historyItems)
            {
                <MudTimelineItem Color="Color.Primary" Size="Size.Small">
                    <ItemOpposite>
                        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="font-weight-bold">
                            @item.ActionDate.ToLocalTime().ToString("dd MMM yyyy HH:mm")
                        </MudText>
                    </ItemOpposite>
                    <ItemContent>
                        <MudPaper Elevation="0" Outlined="true" Class="pa-3 rounded">
                            <div class="d-flex align-center justify-space-between gap-2">
                                <MudText Typo="Typo.body2" Class="font-weight-bold" Color="Color.Primary">
                                    @item.ActionName
                                </MudText>
                                <MudChip T="string" Size="Size.Small" Color="Color.Info" Variant="Variant.Filled">
                                    @(item.ToState?.StateName ?? "Advanced")
                                </MudChip>
                            </div>
                            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-1 d-block">
                                By: <strong>@(item.ActorName ?? "System")</strong> <span>(@(item.ActorRole ?? "User"))</span>
                            </MudText>
                            @if (!string.IsNullOrEmpty(item.Comments))
                            {
                                <MudPaper Elevation="0" Class="mt-2 pa-2 rounded" Style="border-left: 3px solid var(--mud-palette-primary); background-color: var(--mud-palette-background);">
                                    <MudText Typo="Typo.caption" Class="font-italic">
                                        "@item.Comments"
                                    </MudText>
                                </MudPaper>
                            }
                        </MudPaper>
                    </ItemContent>
                </MudTimelineItem>
            }
        </MudTimeline>
    }
</MudPaper>

@code {
    [Parameter] public string ProcessCode { get; set; } = string.Empty;
    [Parameter] public int EntityId { get; set; }

    private List<WorkflowHistory> _historyItems = new();
    private bool _loading = true;

    protected override async Task OnParametersSetAsync()
    {
        await LoadHistoryAsync();
    }

    public async Task RefreshAsync()
    {
        await LoadHistoryAsync();
        StateHasChanged();
    }

    private async Task LoadHistoryAsync()
    {
        if (string.IsNullOrEmpty(ProcessCode) || EntityId <= 0)
        {
            _loading = false;
            return;
        }

        _loading = true;
        try
        {
            var instance = await WorkflowService.GetInstanceByEntityAsync(ProcessCode, EntityId);
            if (instance != null)
            {
                _historyItems = await WorkflowService.GetWorkflowHistoryAsync(instance.Id);
            }
            else
            {
                _historyItems.Clear();
            }
        }
        finally
        {
            _loading = false;
        }
    }
}
