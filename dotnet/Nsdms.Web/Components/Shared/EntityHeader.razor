@namespace Nsdms.Web.Components.Shared
@using MudBlazor

<div class="entity-header nsdms-page-header mb-6" role="region" aria-label="Page Header">
    @if (BreadcrumbItems != null && BreadcrumbItems.Any())
    {
        <MudBreadcrumbs Items="BreadcrumbItems" Class="pa-0 mb-2 text-secondary" Separator="›" Style="font-size: 0.8125rem;" />
    }

    <div class="d-flex flex-column flex-md-row justify-space-between align-start align-md-center gap-4" style="width: 100%; min-width: 0;">
        <div style="min-width: 0; flex: 1 1 auto; max-width: 100%;">
            <div class="d-flex align-center flex-wrap gap-2">
                <MudText Typo="Typo.h5" Class="font-weight-bold break-words nsdms-page-header-title" Style="color: var(--text-primary); letter-spacing: -0.02em; max-width: 100%;">
                    @Title
                </MudText>
                @if (ShouldShowReference && !string.IsNullOrWhiteSpace(EffectiveReference))
                {
                    <span class="font-mono px-2 py-0.5 border rounded text-secondary" style="font-size: 0.8125rem; background: var(--background); border-color: var(--border); white-space: nowrap;">
                        @EffectiveReference
                    </span>
                }
                @if (ShouldShowStatus)
                {
                    <StatusBadge Status="@Status" Size="Size.Medium" />
                }
                @if (Flags != null && Flags.Any())
                {
                    <FlagBadge Flags="@Flags" />
                }
            </div>
            @if (!string.IsNullOrWhiteSpace(Subtitle))
            {
                <MudText Typo="Typo.body2" Class="text-secondary mt-1 break-words nsdms-page-header-subtitle">
                    @Subtitle
                </MudText>
            }
        </div>

        @if (EffectiveActions != null)
        {
            <div class="action-zone nsdms-action-zone d-flex align-center gap-2 flex-wrap justify-start justify-md-end" style="flex: 0 1 auto; max-width: 100%; min-width: 0;">
                @EffectiveActions
            </div>
        }
    </div>

    @if (ContextStrip != null)
    {
        <MudPaper Elevation="0" Class="pa-3 mt-4 border rounded-lg d-flex flex-wrap gap-6 align-center" Style="background-color: var(--background); border-color: var(--border);">
            @ContextStrip
        </MudPaper>
    }
</div>

@code {
    [Parameter] public string Title { get; set; } = string.Empty;
    [Parameter] public string? Reference { get; set; }
    [Parameter] public string? ReferenceKey { get; set; }
    [Parameter] public string? Status { get; set; }
    [Parameter] public string? Subtitle { get; set; }
    [Parameter] public IEnumerable<string>? Flags { get; set; }
    [Parameter] public List<BreadcrumbItem>? BreadcrumbItems { get; set; }
    [Parameter] public RenderFragment? Actions { get; set; }
    [Parameter] public RenderFragment? ActionZone { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public RenderFragment? ContextStrip { get; set; }

    private string? EffectiveReference => !string.IsNullOrWhiteSpace(Reference) ? Reference : ReferenceKey;
    private RenderFragment? EffectiveActions => Actions ?? ActionZone ?? ChildContent;

    private bool ShouldShowReference
    {
        get
        {
            if (string.IsNullOrWhiteSpace(EffectiveReference)) return false;
            if (EffectiveReference.StartsWith("T1-", StringComparison.OrdinalIgnoreCase) ||
                EffectiveReference.StartsWith("T2-", StringComparison.OrdinalIgnoreCase) ||
                EffectiveReference.StartsWith("T3-", StringComparison.OrdinalIgnoreCase) ||
                EffectiveReference.StartsWith("A1-", StringComparison.OrdinalIgnoreCase) ||
                EffectiveReference.StartsWith("A2-", StringComparison.OrdinalIgnoreCase) ||
                EffectiveReference.StartsWith("A3-", StringComparison.OrdinalIgnoreCase) ||
                EffectiveReference.StartsWith("A4-", StringComparison.OrdinalIgnoreCase) ||
                EffectiveReference.StartsWith("A5-", StringComparison.OrdinalIgnoreCase))
            {
                return false;
            }
            return true;
        }
    }

    private bool ShouldShowStatus
    {
        get
        {
            if (string.IsNullOrWhiteSpace(Status)) return false;
            if (!string.IsNullOrWhiteSpace(EffectiveReference) &&
                (EffectiveReference.StartsWith("T1-", StringComparison.OrdinalIgnoreCase) ||
                 EffectiveReference.StartsWith("T2-", StringComparison.OrdinalIgnoreCase) ||
                 EffectiveReference.StartsWith("A1-", StringComparison.OrdinalIgnoreCase) ||
                 EffectiveReference.StartsWith("A2-", StringComparison.OrdinalIgnoreCase)))
            {
                return false;
            }
            return true;
        }
    }
}
