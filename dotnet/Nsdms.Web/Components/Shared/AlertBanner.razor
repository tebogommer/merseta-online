<div class="nsdms-alert-banner @Class" role="alert">
    <div class="alert-left">
        <MudIcon Icon="@(Icon ?? Icons.Material.Filled.WarningAmber)" Style="color: #D97706; font-size: 1.5rem; flex-shrink: 0;" />
        <div>
            <div class="alert-title">@Title</div>
            @if (!string.IsNullOrWhiteSpace(Subtitle))
            {
                <div class="alert-subtitle">@Subtitle</div>
            }
        </div>
    </div>
    @if (!string.IsNullOrWhiteSpace(BadgeText))
    {
        <div class="alert-badge">
            @if (!string.IsNullOrWhiteSpace(BadgeIcon))
            {
                <MudIcon Icon="@BadgeIcon" Size="Size.Small" Style="font-size: 0.9rem;" />
            }
            @BadgeText
        </div>
    }
</div>

@code {
    [Parameter] public string Title { get; set; } = "Attention required — Active operational exceptions";
    [Parameter] public string? Subtitle { get; set; } = "Items requiring administrative action or governance intervention.";
    [Parameter] public string? BadgeText { get; set; }
    [Parameter] public string? BadgeIcon { get; set; } = Icons.Material.Filled.Security;
    [Parameter] public string? Icon { get; set; }
    [Parameter] public string Class { get; set; } = string.Empty;
}
