@namespace Nsdms.Web.Components.Shared
@using Nsdms.Application.Services
@using Nsdms.Domain.Entities
@using MudBlazor
@inject IWorkflowEngineService WorkflowService

<div class="workflow-stepper nsdms-workflow-stepper my-4 pa-4 border rounded-lg" style="background: var(--surface); border-color: var(--border);">
    @if (_loading)
    {
        <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="my-2" />
    }
    else if (DisplayStates.Any())
    {
        <!-- Horizontal Stepper for Medium/Expanded Screens -->
        <div class="d-none d-md-flex align-center justify-space-between position-relative px-2 py-2">
            @for (int i = 0; i < DisplayStates.Count; i++)
            {
                var stepIndex = i;
                var stepName = DisplayStates[i];
                var isCurrent = stepName.Equals(CurrentState, StringComparison.OrdinalIgnoreCase);
                var isCompleted = CurrentIndex > stepIndex && !IsTerminalNegative;
                var isFuture = CurrentIndex < stepIndex && !IsTerminalNegative;
                var isTerminatedHere = IsTerminalNegative && isCurrent;

                <div class="step-item d-flex align-center gap-2 flex-grow-1 @(isCurrent ? "current-step" : "")">
                    <div class="step-badge d-flex align-center justify-center font-weight-bold"
                         style="width: 32px; height: 32px; border-radius: 50%; @GetBadgeStyle(isCurrent, isCompleted, isFuture, isTerminatedHere)">
                        @if (isCompleted)
                        {
                            <MudIcon Icon="@Icons.Material.Filled.Check" Size="Size.Small" Color="Color.Inherit" />
                        }
                        else if (isTerminatedHere)
                        {
                            <MudIcon Icon="@Icons.Material.Filled.Close" Size="Size.Small" Color="Color.Inherit" />
                        }
                        else
                        {
                            <span>@(stepIndex + 1)</span>
                        }
                    </div>

                    <div class="step-label">
                        <MudText Typo="Typo.body2" Class="@(isCurrent ? "font-weight-bold text-primary" : isCompleted ? "text-muted font-weight-medium" : "text-muted")">
                            @stepName
                        </MudText>
                        @if (isCurrent && !string.IsNullOrWhiteSpace(BlockingStatus))
                        {
                            <MudText Typo="Typo.caption" Color="Color.Warning" Class="d-block font-weight-bold">
                                ⚠️ @BlockingStatus
                            </MudText>
                        }
                    </div>

                    @if (stepIndex < DisplayStates.Count - 1 && !isTerminatedHere)
                    {
                        <div class="step-connector flex-grow-1 d-none d-md-block" style="height: 2px; background: @(isCompleted ? "var(--status-success)" : "var(--border)"); min-width: 24px;"></div>
                    }
                </div>
            }
        </div>

        <!-- Vertical Stepper for Compact Mobile Viewports -->
        <div class="d-flex d-md-none flex-column gap-2 py-1">
            @for (int i = 0; i < DisplayStates.Count; i++)
            {
                var stepIndex = i;
                var stepName = DisplayStates[i];
                var isCurrent = stepName.Equals(CurrentState, StringComparison.OrdinalIgnoreCase);
                var isCompleted = CurrentIndex > stepIndex && !IsTerminalNegative;
                var isTerminatedHere = IsTerminalNegative && isCurrent;

                <div class="d-flex align-start gap-3 pa-2 rounded @(isCurrent ? "border" : "")" style="@(isCurrent ? "background-color: var(--brand-gold-subtle); border-color: var(--brand-gold);" : "")">
                    <div class="step-badge d-flex align-center justify-center font-weight-bold"
                         style="width: 26px; height: 26px; min-width: 26px; border-radius: 50%; font-size: 0.75rem; @GetBadgeStyle(isCurrent, isCompleted, false, isTerminatedHere)">
                        @if (isCompleted) { <MudIcon Icon="@Icons.Material.Filled.Check" Size="Size.Small" /> }
                        else if (isTerminatedHere) { <MudIcon Icon="@Icons.Material.Filled.Close" Size="Size.Small" /> }
                        else { <span>@(stepIndex + 1)</span> }
                    </div>
                    <div>
                        <MudText Typo="Typo.body2" Class="@(isCurrent ? "font-weight-bold text-primary" : "text-secondary")">
                            @stepName
                        </MudText>
                        @if (isCurrent && !string.IsNullOrWhiteSpace(BlockingStatus))
                        {
                            <MudChip T="string" Color="Color.Warning" Size="Size.Small" Class="mt-1">
                                ⚠️ @BlockingStatus
                            </MudChip>
                        }
                    </div>
                </div>
            }
        </div>
    }
</div>

@code {
    [Parameter] public List<string>? StringStates { get; set; }
    [Parameter] public List<WorkflowState>? WorkflowStates { get; set; }
    [Parameter] public object? States { get; set; }
    [Parameter] public string? CurrentState { get; set; }
    [Parameter] public string? BlockingStatus { get; set; }
    [Parameter] public string? TerminalOutcome { get; set; }
    [Parameter] public string? StepOwner { get; set; }
    [Parameter] public DateTime? StepDue { get; set; }
    [Parameter] public string? ProcessCode { get; set; }
    [Parameter] public int EntityId { get; set; }

    private bool _loading = false;
    private List<string> _stateList = new();

    private bool IsTerminalNegative => 
        !string.IsNullOrWhiteSpace(TerminalOutcome) || 
        (!string.IsNullOrWhiteSpace(CurrentState) && (CurrentState.Contains("Reject", StringComparison.OrdinalIgnoreCase) || CurrentState.Contains("Decline", StringComparison.OrdinalIgnoreCase) || CurrentState.Contains("Withdraw", StringComparison.OrdinalIgnoreCase)));

    private int CurrentIndex => _stateList.FindIndex(s => s.Equals(CurrentState, StringComparison.OrdinalIgnoreCase));

    private List<string> DisplayStates
    {
        get
        {
            if (IsTerminalNegative && CurrentIndex >= 0)
                return _stateList.Take(CurrentIndex + 1).ToList();
            return _stateList.Take(7).ToList();
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        if (States is List<string> sl)
        {
            _stateList = sl;
            _loading = false;
        }
        else if (States is List<WorkflowState> wl)
        {
            _stateList = wl.OrderBy(s => s.StepOrder).Select(s => s.StateName).ToList();
            _loading = false;
        }
        else if (StringStates != null && StringStates.Any())
        {
            _stateList = StringStates;
            _loading = false;
        }
        else if (WorkflowStates != null && WorkflowStates.Any())
        {
            _stateList = WorkflowStates.OrderBy(s => s.StepOrder).Select(s => s.StateName).ToList();
            _loading = false;
        }
        else if (!string.IsNullOrWhiteSpace(ProcessCode) && EntityId > 0)
        {
            await LoadFromServiceAsync();
        }
    }

    private async Task LoadFromServiceAsync()
    {
        _loading = true;
        try
        {
            var inst = await WorkflowService.GetInstanceByEntityAsync(ProcessCode!, EntityId);
            var raw = await WorkflowService.GetWorkflowDefinitionStatesAsync(ProcessCode!);
            var sorted = raw.OrderBy(s => s.StepOrder).ToList();
            _stateList = sorted.Select(s => s.StateName).ToList();

            if (inst != null)
            {
                CurrentState = inst.CurrentWorkflowState?.StateName;
            }
            else if (sorted.Any())
            {
                var initial = sorted.FirstOrDefault(s => s.IsInitial) ?? sorted.First();
                CurrentState = initial.StateName;
            }
        }
        catch
        {
            _stateList.Clear();
        }
        finally
        {
            _loading = false;
        }
    }

    private string GetBadgeStyle(bool isCurrent, bool isCompleted, bool isFuture, bool isTerminatedHere)
    {
        if (isCompleted) return "background-color: var(--status-success); color: var(--mud-palette-white, #ffffff);";
        if (isTerminatedHere) return "background-color: var(--status-danger); color: var(--mud-palette-white, #ffffff);";
        if (isCurrent) return "background-color: var(--brand-navy); color: var(--mud-palette-white, #ffffff);";
        return "background-color: var(--surface-subtle); color: var(--text-disabled); border: 1px solid var(--border);";
    }
}
