@using Microsoft.AspNetCore.Components.Authorization
@using Nsdms.Application.Services
@using Nsdms.Domain.Entities
@inject IEntraResilienceService EntraService
@inject IIdentityService IdentityService
@inject AuthenticationStateProvider AuthStateProvider
@inject ISnackbar Snackbar

<MudDialog>
    <TitleContent>
        <div class="d-flex align-center gap-2">
            <MudIcon Icon="@Icons.Material.Filled.Security" Color="Color.Primary" />
            <MudText Typo="Typo.h6" Class="fw-bold">Disaster recovery backup password</MudText>
        </div>
    </TitleContent>
    <DialogContent>
        @if (_isLoading)
        {
            <div class="d-flex justify-center pa-6">
                <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
            </div>
        }
        else if (_userStatus != null)
        {
            <!-- Entra Synchronization Status Banner -->
            <MudPaper Elevation="0" Class="pa-3 mb-4 rounded-lg" Style="border: 1px solid var(--mud-palette-lines-default); background-color: var(--mud-palette-background);">
                <div class="d-flex align-center justify-space-between mb-2">
                    <div class="d-flex align-center gap-2">
                        <MudIcon Icon="@Icons.Material.Filled.CloudSync" Color="Color.Primary" Size="Size.Small" />
                        <MudText Typo="Typo.subtitle2" Class="fw-bold">Microsoft Entra directory state</MudText>
                    </div>
                    @if (_userStatus.EntraAccountEnabled != false)
                    {
                        <MudChip T="string" Color="Color.Success" Size="Size.Small" Variant="Variant.Filled">Active on Entra</MudChip>
                    }
                    else
                    {
                        <MudChip T="string" Color="Color.Error" Size="Size.Small" Variant="Variant.Filled">Disabled on Entra</MudChip>
                    }
                </div>

                <div class="d-flex flex-column gap-1">
                    <div class="d-flex justify-space-between">
                        <MudText Typo="Typo.caption" Color="Color.Secondary">Directory UPN:</MudText>
                        <MudText Typo="Typo.caption" Class="fw-bold font-mono">@(_userStatus.EntraUserPrincipalName ?? _userStatus.Email)</MudText>
                    </div>
                    <div class="d-flex justify-space-between">
                        <MudText Typo="Typo.caption" Color="Color.Secondary">Last directory sync:</MudText>
                        <MudText Typo="Typo.caption">@(_userStatus.LastEntraSyncUtc?.ToLocalTime().ToString("yyyy-MM-dd HH:mm") ?? "Pending sync")</MudText>
                    </div>
                    <div class="d-flex justify-space-between">
                        <MudText Typo="Typo.caption" Color="Color.Secondary">Offline grace window:</MudText>
                        <MudText Typo="Typo.caption" Color="@(_userStatus.IsOfflineGraceValid ? Color.Success : Color.Error)">
                            @(_userStatus.GracePeriodDaysRemaining) days remaining
                        </MudText>
                    </div>
                    <div class="d-flex justify-space-between">
                        <MudText Typo="Typo.caption" Color="Color.Secondary">Emergency password status:</MudText>
                        @if (_userStatus.HasBackupPassword)
                        {
                            <MudText Typo="Typo.caption" Color="Color.Success" Class="fw-bold">
                                Configured (@(_userStatus.BackupPasswordSetAt?.ToLocalTime().ToString("yyyy-MM-dd") ?? "Active"))
                            </MudText>
                        }
                        else
                        {
                            <MudText Typo="Typo.caption" Color="Color.Warning" Class="fw-bold">Not configured</MudText>
                        }
                    </div>
                </div>
            </MudPaper>

            <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="mb-4" Dense="true">
                Your emergency backup password allows you to log in to merSETA NSDMS if Microsoft Entra ID is down or experiencing cloud outages. It is only valid as long as your account is <strong>not disabled</strong> on Entra.
            </MudAlert>

            <!-- Password Entry Form -->
            <div class="d-flex flex-column gap-3">
                <MudTextField @bind-Value="_newPassword"
                              Label="New emergency backup password"
                              InputType="@(_showPassword ? InputType.Text : InputType.Password)"
                              Variant="Variant.Outlined"
                              Adornment="Adornment.End"
                              AdornmentIcon="@(_showPassword ? Icons.Material.Filled.Visibility : Icons.Material.Filled.VisibilityOff)"
                              AdornmentAriaLabel="@(_showPassword ? "Hide password" : "Show password")"
                              OnAdornmentClick="@(() => _showPassword = !_showPassword)"
                              Immediate="true"
                              Required="true" />

                <MudTextField @bind-Value="_confirmPassword"
                              Label="Confirm emergency backup password"
                              InputType="@(_showConfirmPassword ? InputType.Text : InputType.Password)"
                              Variant="Variant.Outlined"
                              Adornment="Adornment.End"
                              AdornmentIcon="@(_showConfirmPassword ? Icons.Material.Filled.Visibility : Icons.Material.Filled.VisibilityOff)"
                              AdornmentAriaLabel="@(_showConfirmPassword ? "Hide password" : "Show password")"
                              OnAdornmentClick="@(() => _showConfirmPassword = !_showConfirmPassword)"
                              Immediate="true"
                              Required="true"
                              Error="@(!string.IsNullOrEmpty(_confirmPassword) && _newPassword != _confirmPassword)"
                              ErrorText="Passwords do not match." />

                <!-- Complexity Checklist -->
                <div class="pa-2 rounded" style="background-color: var(--mud-palette-background); border: 1px solid var(--mud-palette-lines-inputs);">
                    <MudText Typo="Typo.caption" Class="fw-bold d-block mb-1" Color="Color.Secondary">Password requirements:</MudText>
                    <div class="d-flex flex-column gap-1">
                        <div class="d-flex align-center gap-1">
                            <MudIcon Icon="@(_newPassword?.Length >= 8 ? Icons.Material.Filled.CheckCircle : Icons.Material.Filled.Cancel)"
                                     Size="Size.Small"
                                     Color="@(_newPassword?.Length >= 8 ? Color.Success : Color.Secondary)" />
                            <MudText Typo="Typo.caption" Style="font-size: 0.72rem;">At least 8 characters long</MudText>
                        </div>
                        <div class="d-flex align-center gap-1">
                            <MudIcon Icon="@(_newPassword?.Any(char.IsUpper) == true ? Icons.Material.Filled.CheckCircle : Icons.Material.Filled.Cancel)"
                                     Size="Size.Small"
                                     Color="@(_newPassword?.Any(char.IsUpper) == true ? Color.Success : Color.Secondary)" />
                            <MudText Typo="Typo.caption" Style="font-size: 0.72rem;">At least one uppercase letter (A-Z)</MudText>
                        </div>
                        <div class="d-flex align-center gap-1">
                            <MudIcon Icon="@(_newPassword?.Any(char.IsLower) == true ? Icons.Material.Filled.CheckCircle : Icons.Material.Filled.Cancel)"
                                     Size="Size.Small"
                                     Color="@(_newPassword?.Any(char.IsLower) == true ? Color.Success : Color.Secondary)" />
                            <MudText Typo="Typo.caption" Style="font-size: 0.72rem;">At least one lowercase letter (a-z)</MudText>
                        </div>
                        <div class="d-flex align-center gap-1">
                            <MudIcon Icon="@(_newPassword?.Any(char.IsDigit) == true ? Icons.Material.Filled.CheckCircle : Icons.Material.Filled.Cancel)"
                                     Size="Size.Small"
                                     Color="@(_newPassword?.Any(char.IsDigit) == true ? Color.Success : Color.Secondary)" />
                            <MudText Typo="Typo.caption" Style="font-size: 0.72rem;">At least one number (0-9)</MudText>
                        </div>
                        <div class="d-flex align-center gap-1">
                            <MudIcon Icon="@(_newPassword?.Any(ch => !char.IsLetterOrDigit(ch)) == true ? Icons.Material.Filled.CheckCircle : Icons.Material.Filled.Cancel)"
                                     Size="Size.Small"
                                     Color="@(_newPassword?.Any(ch => !char.IsLetterOrDigit(ch)) == true ? Color.Success : Color.Secondary)" />
                            <MudText Typo="Typo.caption" Style="font-size: 0.72rem;">At least one special character (!@@#$%^&amp;*)</MudText>
                        </div>
                    </div>
                </div>
            </div>
        }
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Text" OnClick="Cancel">Cancel</MudButton>
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Save"
                   OnClick="SaveBackupPasswordAsync"
                   Disabled="@(!IsFormValid() || _isSaving)">
            @if (_isSaving)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                <span>Saving...</span>
            }
            else
            {
                <span>Save emergency password</span>
            }
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter]
    public int? UserId { get; set; }

    private EntraStatusDto? _userStatus;
    private bool _isLoading = true;
    private bool _isSaving = false;
    private string _newPassword = string.Empty;
    private string _confirmPassword = string.Empty;
    private bool _showPassword = false;
    private bool _showConfirmPassword = false;
    private string _currentUsername = "SYSTEM";

    protected override async Task OnInitializedAsync()
    {
        _isLoading = true;
        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;
            _currentUsername = user.Identity?.Name ?? "SYSTEM";

            var targetUserId = UserId;
            if (!targetUserId.HasValue)
            {
                var idClaim = user.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
                if (int.TryParse(idClaim, out var parsedId))
                {
                    targetUserId = parsedId;
                }
            }

            if (targetUserId.HasValue)
            {
                _userStatus = await EntraService.GetUserEntraStatusAsync(targetUserId.Value);
            }
        }
        finally
        {
            _isLoading = false;
        }
    }

    private bool IsFormValid()
    {
        if (string.IsNullOrWhiteSpace(_newPassword) || string.IsNullOrWhiteSpace(_confirmPassword))
        {
            return false;
        }

        if (_newPassword != _confirmPassword)
        {
            return false;
        }

        if (_newPassword.Length < 8 ||
            !_newPassword.Any(char.IsUpper) ||
            !_newPassword.Any(char.IsLower) ||
            !_newPassword.Any(char.IsDigit) ||
            !_newPassword.Any(ch => !char.IsLetterOrDigit(ch)))
        {
            return false;
        }

        return true;
    }

    private async Task SaveBackupPasswordAsync()
    {
        if (!IsFormValid() || _userStatus == null) return;

        _isSaving = true;
        try
        {
            var (succeeded, errorMessage) = await EntraService.SetBackupPasswordAsync(_userStatus.UserId, _newPassword, _currentUsername);
            if (succeeded)
            {
                Snackbar.Add("Disaster recovery emergency backup password updated successfully.", Severity.Success);
                MudDialog.Close(DialogResult.Ok(true));
            }
            else
            {
                Snackbar.Add(errorMessage ?? "Failed to set emergency backup password.", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isSaving = false;
        }
    }

    private void Cancel()
    {
        MudDialog.Cancel();
    }
}
