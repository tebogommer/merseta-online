@namespace Nsdms.Web.Components.Shared
@using MudBlazor

@*
  UI-STANDARD.md Contract (Section 9.2 & Clause 6.1, 7.2):
  Component: StatusBadge
  Inputs: Status, Size
  Renders: The status pill. Resolves its own colour from the semantic map. Never clickable.
*@

<span class="nsdms-status-badge nsdms-status-@GetSemanticClass() @(Size == Size.Small ? "nsdms-status-sm" : Size == Size.Large ? "nsdms-status-lg" : "nsdms-status-md")" 
      role="status" 
      aria-label="Status: @DisplayLabel">
    <MudChip T="string" 
             Color="@ResolveMudColor()" 
             Size="@Size" 
             Variant="Variant.Filled" 
             Class="ma-0 px-2 font-weight-bold pointer-events-none"
             Style="cursor: default !important; user-select: none;">
        @DisplayLabel
    </MudChip>
</span>

@code {
    [Parameter]
    public string? Status { get; set; }

    [Parameter]
    public Size Size { get; set; } = Size.Small;

    private string DisplayLabel => string.IsNullOrWhiteSpace(Status) ? "None" : Status.Trim();

    private string GetSemanticClass()
    {
        var s = (Status ?? "").ToLowerInvariant();
        if (s.Contains("approve") || s.Contains("complete") || s.Contains("accredit") || s.Contains("certif") || s == "active" || s == "verified" || s == "endorsed")
            return "success";
        if (s.Contains("reject") || s.Contains("decline") || s.Contains("terminat") || s.Contains("withdraw") || s.Contains("lapsed") || s.Contains("fail"))
            return "danger";
        if (s.Contains("review") || s.Contains("assess") || s.Contains("inspect") || s.Contains("progress") || s.Contains("schedul") || s.Contains("training") || s.Contains("evaluat"))
            return "active";
        if (s.Contains("submit") || s.Contains("pending") || s.Contains("await") || s.Contains("applied") || s.Contains("requested") || s.Contains("moderation"))
            return "pending";
        return "neutral";
    }

    private Color ResolveMudColor()
    {
        return GetSemanticClass() switch
        {
            "success" => Color.Success,
            "danger" => Color.Error,
            "active" => Color.Info,
            "pending" => Color.Warning,
            _ => Color.Default
        };
    }
}
