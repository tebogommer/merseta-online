@namespace Nsdms.Web.Components.Shared
@using MudBlazor

@*
  UI-STANDARD.md Contract (Section 9.2, Clause 8.3.4, 8.3.5, 8.3.6):
  Component: ConfirmDialog
  Inputs: Title, Consequence, ConfirmLabel, RequiresReason, IsDestructive
  Renders: Dialog naming the exact consequence, with mandatory reason where required.
*@

<MudDialog>
    <TitleContent>
        <div class="d-flex align-center gap-2">
            <MudIcon Icon="@(IsDestructive ? Icons.Material.Filled.Warning : Icons.Material.Filled.Info)" 
                     Color="@(IsDestructive ? Color.Error : Color.Primary)" />
            <MudText Typo="Typo.h6" Class="font-weight-bold">
                @Title
            </MudText>
        </div>
    </TitleContent>
    <DialogContent>
        <div class="py-2">
            <MudText Typo="Typo.body1" Class="mb-3">
                @Consequence
            </MudText>

            @if (RequiresReason)
            {
                <MudTextField @bind-Value="_reason" 
                              Label="Mandatory Reason / Justification" 
                              Variant="Variant.Outlined" 
                              Lines="3" 
                              Required="true" 
                              Immediate="true"
                              HelperText="Please provide a clear justification for this action."
                              Error="@(_submitted && string.IsNullOrWhiteSpace(_reason))"
                              ErrorText="Reason is required before proceeding."
                              Class="mt-2" />
            }
        </div>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel" Variant="Variant.Text">
            @(string.IsNullOrWhiteSpace(CancelLabel) ? "Cancel" : CancelLabel)
        </MudButton>
        <MudButton Color="@(IsDestructive ? Color.Error : Color.Primary)" 
                   Variant="Variant.Filled" 
                   OnClick="Submit"
                   Disabled="@(RequiresReason && string.IsNullOrWhiteSpace(_reason))">
            @(string.IsNullOrWhiteSpace(ConfirmLabel) ? "Confirm" : ConfirmLabel)
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter]
    public string Title { get; set; } = "Confirm Action";

    [Parameter]
    public string Consequence { get; set; } = "Please review the consequence of this operation before continuing.";

    [Parameter]
    public string? ConfirmLabel { get; set; }

    [Parameter]
    public string? CancelLabel { get; set; }

    [Parameter]
    public bool RequiresReason { get; set; } = false;

    [Parameter]
    public bool IsDestructive { get; set; } = false;

    private string _reason = string.Empty;
    private bool _submitted = false;

    private void Submit()
    {
        _submitted = true;
        if (RequiresReason && string.IsNullOrWhiteSpace(_reason))
        {
            return;
        }

        MudDialog.Close(DialogResult.Ok(_reason));
    }

    private void Cancel() => MudDialog.Cancel();
}
