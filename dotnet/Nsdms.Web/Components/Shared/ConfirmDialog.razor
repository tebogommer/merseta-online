@namespace Nsdms.Web.Components.Shared
@using MudBlazor

<MudDialog>
    <TitleContent>
        <div class="d-flex align-center gap-2">
            @if (IsDestructive)
            {
                <MudIcon Icon="@Icons.Material.Filled.Warning" Color="Color.Error" Size="Size.Small" />
            }
            else
            {
                <MudIcon Icon="@Icons.Material.Filled.Info" Color="Color.Primary" Size="Size.Small" />
            }
            <MudText Typo="Typo.h6" Class="font-weight-bold">
                @Title
            </MudText>
        </div>
    </TitleContent>
    <DialogContent>
        <MudText Typo="Typo.body2" Class="text-secondary mb-3">
            @Consequence
        </MudText>

        @if (RequiresReason)
        {
            <MudTextField @bind-Value="Reason"
                          Immediate="true"
                          Label="Reason / Justification (Mandatory)"
                          Variant="Variant.Outlined"
                          Lines="3"
                          Required="true"
                          HelperText="Provide a clear business reason for this decision."
                          Class="mt-4" />
        }
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Close" OnClick="Cancel" Size="Size.Medium">
            @(CancelLabel ?? "Cancel")
        </MudButton>
        <MudButton Variant="Variant.Filled"
                   Color="@(IsDestructive ? Color.Error : Color.Primary)"
                   StartIcon="@(IsDestructive ? Icons.Material.Filled.Delete : Icons.Material.Filled.Check)"
                   Disabled="@(RequiresReason && string.IsNullOrWhiteSpace(Reason))"
                   OnClick="Confirm"
                   Size="Size.Medium">
            @(ConfirmLabel ?? "Confirm")
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public string Title { get; set; } = "Confirm Action";
    [Parameter] public string Consequence { get; set; } = string.Empty;
    [Parameter] public string? ConfirmLabel { get; set; } = "Confirm";
    [Parameter] public string? CancelLabel { get; set; } = "Cancel";
    [Parameter] public bool RequiresReason { get; set; } = false;
    [Parameter] public bool IsDestructive { get; set; } = false;

    private string Reason { get; set; } = string.Empty;

    private void Cancel() => MudDialog.Cancel();
    private void Confirm()
    {
        if (RequiresReason && string.IsNullOrWhiteSpace(Reason)) return;
        MudDialog.Close(DialogResult.Ok(Reason));
    }
}
