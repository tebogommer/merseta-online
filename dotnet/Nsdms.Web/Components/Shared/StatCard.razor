<MudItem xs="@Xs" sm="@Sm" md="@Md" lg="@Lg">
    <div class="nsdms-stat-card @Class">
        <div class="stat-header">
            <span class="stat-title">@(string.IsNullOrWhiteSpace(Title) ? Label : Title)</span>
            @if (!string.IsNullOrWhiteSpace(Icon))
            {
                <div class="d-flex align-center gap-1">
                    <MudIcon Icon="@Icon" Size="Size.Small" Style="color: var(--mud-palette-text-secondary); font-size: 1.1rem;" />
                    @if (!string.IsNullOrWhiteSpace(Href))
                    {
                        <MudLink Href="@Href" Underline="Underline.None">
                            <MudIcon Icon="@Icons.Material.Filled.ArrowForward" Size="Size.Small" Style="color: var(--mud-palette-text-disabled); font-size: 0.9rem;" />
                        </MudLink>
                    }
                </div>
            }
            else if (!string.IsNullOrWhiteSpace(Href))
            {
                <div class="d-flex align-center gap-1">
                    <MudLink Href="@Href" Underline="Underline.None">
                        <MudIcon Icon="@Icons.Material.Filled.ArrowForward" Size="Size.Small" Style="color: var(--mud-palette-text-disabled); font-size: 0.9rem;" />
                    </MudLink>
                </div>
            }
        </div>
        <div class="stat-value">@Value</div>
        @if (!string.IsNullOrWhiteSpace(TargetText) || !string.IsNullOrWhiteSpace(Context))
        {
            <div class="stat-target" style="color: @GetTargetColor();">
                @(string.IsNullOrWhiteSpace(TargetText) ? Context : TargetText)
            </div>
        }
    </div>
</MudItem>

@code {
    [Parameter] public int Xs { get; set; } = 12;
    [Parameter] public int Sm { get; set; } = 6;
    [Parameter] public int Md { get; set; } = 3;
    [Parameter] public int Lg { get; set; } = 3;
    [Parameter] public string Title { get; set; } = string.Empty;
    [Parameter] public string Label { get; set; } = string.Empty;
    [Parameter] public string Value { get; set; } = string.Empty;
    [Parameter] public string? TargetText { get; set; }
    [Parameter] public string? Context { get; set; }
    [Parameter] public bool IsTargetGreen { get; set; } = true;
    [Parameter] public Color TrendColor { get; set; } = Color.Primary;
    [Parameter] public string? Icon { get; set; }
    [Parameter] public string? Href { get; set; }
    [Parameter] public string Class { get; set; } = string.Empty;

    private string GetTargetColor()
    {
        if (!IsTargetGreen) return "var(--mud-palette-text-secondary)";
        if (TrendColor == Color.Success) return "var(--mud-palette-success)";
        if (TrendColor == Color.Warning) return "var(--mud-palette-warning)";
        if (TrendColor == Color.Info) return "var(--mud-palette-info)";
        if (TrendColor == Color.Error) return "var(--mud-palette-error)";
        return "var(--mud-palette-success)";
    }
}
