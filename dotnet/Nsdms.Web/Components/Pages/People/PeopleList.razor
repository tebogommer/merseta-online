@page "/people"
@using Nsdms.Application.Services
@using Nsdms.Domain.Entities
@using Nsdms.Web.Components.Shared
@using MudBlazor
@inject IPersonService PersonService
@inject NavigationManager NavManager
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@rendermode InteractiveServer

@*
  UI-STANDARD.md Archetype: A1 / T1 (Transactional List - People & Demographics Registry)
  Clauses: 4.2, 4.3, 6.1, 7.2, 8.1, 8.3, 11.1–11.9, 15.2.5
*@

<EntityHeader Title="People &amp; Demographics Registry"
              Subtitle="Centralized identity, demographic, and contact registry for learners, assessors, moderators, and SDFs"
              ReferenceKey="T1-PEOPLE"
              Status="Active"
              BreadcrumbItems="@_breadcrumbs">
    <ActionZone>
        <MudButton Variant="Variant.Filled" 
                   Color="Color.Primary" 
                   StartIcon="@Icons.Material.Filled.PersonAdd" 
                   OnClick="CreateNewPerson">
            New Person
        </MudButton>
    </ActionZone>
</EntityHeader>

<!-- Filter Bar (Clause 11.4) -->
<FilterBar SearchPlaceholder="Search by Name, RSA ID, Passport, Email, Phone..."
           @bind-SearchText="_searchString"
           OnSearch="HandleFilterChanged"
           OnClear="HandleFilterCleared">
    <FilterContent>
        <MudSelect T="string" 
                   Label="Status Filter" 
                   @bind-Value="_statusFilter" 
                   @bind-Value:after="HandleFilterChanged"
                   Variant="Variant.Outlined" 
                   Margin="Margin.Dense"
                   Dense="true">
            <MudSelectItem Value="@("All")">All People</MudSelectItem>
            <MudSelectItem Value="@("Active")">Active Only</MudSelectItem>
            <MudSelectItem Value="@("Inactive")">Inactive Only</MudSelectItem>
        </MudSelect>
    </FilterContent>
    <ActiveFilterChips>
        @if (!string.IsNullOrWhiteSpace(_searchString))
        {
            <MudChip T="string" Size="Size.Small" OnClose="@(() => { _searchString = string.Empty; HandleFilterChanged(); })">
                Keyword: @_searchString
            </MudChip>
        }
        @if (_statusFilter != "All")
        {
            <MudChip T="string" Size="Size.Small" Color="Color.Primary" OnClose="@(() => { _statusFilter = "All"; HandleFilterChanged(); })">
                Status: @_statusFilter
            </MudChip>
        }
    </ActiveFilterChips>
</FilterBar>

<!-- Data Grid Shell (Clause 11.9) -->
<DataGridShell TItem="Person"
               GridKey="PeopleRegistryGrid"
               Items="@FilteredPeople"
               IsLoading="@_loading"
               TotalItemsCount="@FilteredPeople.Count"
               SelectedItems="@_selectedPeople"
               SelectedItemsChanged="OnSelectedPeopleChanged"
               EmptyTitle="No Persons Found"
               EmptyMessage="No person records match your search or filter criteria. Create a new person record to populate the demographic registry."
               EmptyActionLabel="Capture New Person"
               OnEmptyAction="CreateNewPerson">
    <BulkActionBarContent>
        <MudText Typo="Typo.body2" Class="fw-bold text-white">
            @_selectedPeople.Count person record(s) selected
        </MudText>
        <MudButton Variant="Variant.Filled" 
                   Color="Color.Surface" 
                   Size="Size.Small" 
                   StartIcon="@Icons.Material.Filled.FileDownload"
                   OnClick="ExportSelected">
            Export Selected
        </MudButton>
    </BulkActionBarContent>
    <ChildContent>
        <MudTable Items="@FilteredPeople"
                  Hover="true"
                  Dense="true"
                  Elevation="0"
                  MultiSelection="true"
                  @bind-SelectedItems="_selectedPeople"
                  Breakpoint="Breakpoint.Sm"
                  Class="border-default">
            <HeaderContent>
                <MudTh>Full Name (Hyperlink)</MudTh>
                <MudTh>RSA ID / Passport</MudTh>
                <MudTh>Gender</MudTh>
                <MudTh>Date of Birth</MudTh>
                <MudTh>Contact (Email / Cell)</MudTh>
                <MudTh>Province</MudTh>
                <MudTh>Status</MudTh>
                <MudTh Style="text-align:right">Actions</MudTh>
            </HeaderContent>
            <RowTemplate>
                <!-- Key column is real hyperlink (Clause 11.1) -->
                <MudTd DataLabel="Full Name">
                    <div class="d-flex align-center gap-2">
                        <MudAvatar Color="Color.Primary" Size="Size.Small">
                            @GetInitials(context)
                        </MudAvatar>
                        <div>
                            <a href="/people/@context.Id" class="fw-bold text-primary text-decoration-none">
                                @(!string.IsNullOrWhiteSpace(context.Title) ? $"{context.Title} " : "")@context.FirstName @context.LastName
                            </a>
                            @if (!string.IsNullOrWhiteSpace(context.MiddleName))
                            {
                                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="d-block">Middle: @context.MiddleName</MudText>
                            }
                        </div>
                    </div>
                </MudTd>
                <MudTd DataLabel="RSA ID / Passport">
                    @if (!string.IsNullOrWhiteSpace(context.RsaIdNumber))
                    {
                        <div class="d-flex align-center gap-1 font-monospace">
                            <MudIcon Icon="@Icons.Material.Filled.Badge" Size="Size.Small" Color="Color.Info" />
                            <span>@context.RsaIdNumber</span>
                        </div>
                    }
                    else if (!string.IsNullOrWhiteSpace(context.PassportNumber))
                    {
                        <div class="d-flex align-center gap-1">
                            <MudIcon Icon="@Icons.Material.Filled.Public" Size="Size.Small" Color="Color.Secondary" />
                            <span>@context.PassportNumber</span>
                        </div>
                    }
                    else
                    {
                        <MudText Typo="Typo.caption" Color="Color.Secondary">—</MudText>
                    }
                </MudTd>
                <MudTd DataLabel="Gender">
                    @(!string.IsNullOrWhiteSpace(context.Gender) ? context.Gender : "—")
                </MudTd>
                <MudTd DataLabel="Date of Birth">
                    @(context.DateOfBirth.HasValue ? context.DateOfBirth.Value.ToString("yyyy-MM-dd") : "—")
                </MudTd>
                <MudTd DataLabel="Contact (Email / Cell)">
                    <div>
                        @if (!string.IsNullOrWhiteSpace(context.EmailAddress))
                        {
                            <MudText Typo="Typo.caption" Class="d-block text-truncate" Style="max-width: 180px;">@context.EmailAddress</MudText>
                        }
                        @if (!string.IsNullOrWhiteSpace(context.CellPhoneNumber))
                        {
                            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="d-block font-monospace">@context.CellPhoneNumber</MudText>
                        }
                        @if (string.IsNullOrWhiteSpace(context.EmailAddress) && string.IsNullOrWhiteSpace(context.CellPhoneNumber))
                        {
                            <span>—</span>
                        }
                    </div>
                </MudTd>
                <MudTd DataLabel="Province">
                    @(!string.IsNullOrWhiteSpace(context.ProvinceCode) ? context.ProvinceCode : "—")
                </MudTd>
                <MudTd DataLabel="Status">
                    <!-- Non-clickable status pill (Clause 6.1, 7.2) -->
                    <StatusBadge Status="@(context.IsActive ? "Active" : "Inactive")" Size="Size.Small" />
                </MudTd>
                <MudTd Style="text-align:right" DataLabel="Actions">
                    <div class="d-flex justify-end gap-1">
                        <MudTooltip Text="View Profile">
                            <MudIconButton Icon="@Icons.Material.Filled.Visibility" 
                                           Color="Color.Primary" 
                                           Size="Size.Small" 
                                           OnClick="@(() => OpenDetail(context.Id))" 
                                           aria-label="View Profile" />
                        </MudTooltip>
                        <MudTooltip Text="Edit Person">
                            <MudIconButton Icon="@Icons.Material.Filled.Edit" 
                                           Color="Color.Secondary" 
                                           Size="Size.Small" 
                                           OnClick="@(() => OpenEdit(context.Id))" 
                                           aria-label="Edit Person" />
                        </MudTooltip>
                        <MudTooltip Text="Delete Record">
                            <MudIconButton Icon="@Icons.Material.Filled.Delete" 
                                           Color="Color.Error" 
                                           Size="Size.Small" 
                                           OnClick="@(() => DeletePerson(context.Id, $"{context.FirstName} {context.LastName}"))" 
                                           aria-label="Delete Record" />
                        </MudTooltip>
                    </div>
                </MudTd>
            </RowTemplate>
            <PagerContent>
                <!-- Fixed page size ladder (Clause 11.3.3) -->
                <MudTablePager PageSizeOptions="new int[] { 5, 10, 20, 50, 100, 250, 500 }" />
            </PagerContent>
        </MudTable>
    </ChildContent>
</DataGridShell>

@code {
    private List<Person> _people = new();
    private HashSet<Person> _selectedPeople = new();
    private string _searchString = string.Empty;
    private string _statusFilter = "All";
    private bool _loading = true;

    private List<BreadcrumbItem> _breadcrumbs = new()
    {
        new BreadcrumbItem("Home", href: "/"),
        new BreadcrumbItem("Core Registries", href: null, disabled: true),
        new BreadcrumbItem("People", href: "/people")
    };

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        _loading = true;
        _people = await PersonService.GetAllAsync();
        _loading = false;
    }

    private List<Person> FilteredPeople
    {
        get
        {
            var query = _people.AsEnumerable();

            if (_statusFilter == "Active")
            {
                query = query.Where(x => x.IsActive);
            }
            else if (_statusFilter == "Inactive")
            {
                query = query.Where(x => !x.IsActive);
            }

            if (!string.IsNullOrWhiteSpace(_searchString))
            {
                var s = _searchString.Trim();
                query = query.Where(x =>
                    (x.FirstName != null && x.FirstName.Contains(s, StringComparison.OrdinalIgnoreCase)) ||
                    (x.LastName != null && x.LastName.Contains(s, StringComparison.OrdinalIgnoreCase)) ||
                    (x.RsaIdNumber != null && x.RsaIdNumber.Contains(s, StringComparison.OrdinalIgnoreCase)) ||
                    (x.PassportNumber != null && x.PassportNumber.Contains(s, StringComparison.OrdinalIgnoreCase)) ||
                    (x.EmailAddress != null && x.EmailAddress.Contains(s, StringComparison.OrdinalIgnoreCase)) ||
                    (x.CellPhoneNumber != null && x.CellPhoneNumber.Contains(s, StringComparison.OrdinalIgnoreCase)));
            }

            return query.ToList();
        }
    }

    private string GetInitials(Person person)
    {
        var first = !string.IsNullOrWhiteSpace(person.FirstName) ? person.FirstName[0].ToString().ToUpper() : "";
        var last = !string.IsNullOrWhiteSpace(person.LastName) ? person.LastName[0].ToString().ToUpper() : "";
        return $"{first}{last}";
    }

    private void HandleFilterChanged()
    {
        StateHasChanged();
    }

    private void HandleFilterCleared()
    {
        _searchString = string.Empty;
        _statusFilter = "All";
        StateHasChanged();
    }

    private void OnSelectedPeopleChanged(HashSet<Person> selected)
    {
        _selectedPeople = selected;
    }

    private void OpenDetail(int id)
    {
        NavManager.NavigateTo($"/people/{id}");
    }

    private void OpenEdit(int id)
    {
        NavManager.NavigateTo($"/people/{id}/edit");
    }

    private void CreateNewPerson()
    {
        NavManager.NavigateTo("/people/create");
    }

    private void ExportSelected()
    {
        Snackbar.Add($"Exporting {_selectedPeople.Count} person records to CSV...", Severity.Info);
    }

    private async Task DeletePerson(int id, string name)
    {
        bool? confirmed = await DialogService.ShowMessageBoxAsync(
            "Delete Person Record?",
            $"Are you sure you wish to delete person record '{name}'? This action will perform an audit-tracked soft delete.",
            yesText: "Delete Record",
            cancelText: "Cancel"
        );

        if (confirmed == true)
        {
            var deleted = await PersonService.DeleteAsync(id, "Admin");
            if (deleted)
            {
                Snackbar.Add($"Person record '{name}' deleted successfully with audit confirmation.", Severity.Success);
                await LoadData();
            }
            else
            {
                Snackbar.Add("Could not delete the person record.", Severity.Error);
            }
        }
    }
}
