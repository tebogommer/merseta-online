@page "/people/{id:int}"
@page "/people/{id:int}/edit"
@page "/people/create"
@inject IPersonService PersonService
@inject LookupService LookupService
@inject NavigationManager NavManager
@inject ISnackbar Snackbar
@using Nsdms.Application.Common.Models
@using Nsdms.Application.Common.Utilities
@using Nsdms.Domain.Entities
@using Nsdms.Web.Components.Shared
@rendermode InteractiveServer

<PageTitle>@(Id == 0 ? "New Person Registration" : $"{_person.Title} {_person.FirstName} {_person.LastName}".Trim()) - merSETA NSDMS</PageTitle>

<!-- Sticky Top Bar with Breadcrumbs and Action Buttons -->
<MudPaper Elevation="2" Class="sticky-top pa-4 mb-4 rounded-lg d-flex flex-wrap justify-space-between align-center gap-3 bg-surface" Style="top: var(--mud-appbar-height, 64px); z-index: 10;">
    <div class="d-flex align-center gap-3">
        <MudButton Variant="Variant.Text"
                   StartIcon="@Icons.Material.Filled.ArrowBack"
                   Color="Color.Default"
                   OnClick="BackToList"
                   aria-label="Back to People Directory">
            Back to Directory
        </MudButton>
        <MudDivider Vertical="true" FlexItem="true" Class="mx-1 my-2" />
        <MudAvatar Color="Color.Primary" Variant="Variant.Filled" Size="Size.Small">
            <MudIcon Icon="@Icons.Material.Filled.Person" Size="Size.Small" />
        </MudAvatar>
        <div>
            <div class="d-flex align-center gap-2">
                <MudText Typo="Typo.h5" Class="fw-bold">
                    @(Id == 0 ? "New Person Registration (SETMIS File 400)" : $"{_person.Title} {_person.FirstName} {_person.LastName}".Trim())
                </MudText>
                @if (Id > 0)
                {
                    <MudChip T="string" Color="@(_person.IsActive ? Color.Success : Color.Error)" Size="Size.Small" Variant="Variant.Filled">
                        @(_person.IsActive ? "Active" : "Inactive")
                    </MudChip>
                }
            </div>
            @if (Id > 0)
            {
                <MudText Typo="Typo.caption" Color="Color.Secondary">
                    RSA ID: <strong>@(!string.IsNullOrWhiteSpace(_person.RsaIdNumber) ? _person.RsaIdNumber : "N/A")</strong> | 
                    Email: <strong>@(!string.IsNullOrWhiteSpace(_person.Email) ? _person.Email : "N/A")</strong> |
                    Gender: <strong>@_person.Gender</strong>
                </MudText>
            }
        </div>
    </div>
    <div class="d-flex align-center gap-2">
        @if (Id > 0)
        {
            <MudButton Variant="Variant.Outlined"
                       Color="Color.Error"
                       StartIcon="@Icons.Material.Filled.Delete"
                       OnClick="DeletePerson"
                       aria-label="Delete Person">
                Delete
            </MudButton>
        }
        <MudButton Variant="Variant.Outlined"
                   Color="Color.Secondary"
                   StartIcon="@Icons.Material.Filled.Cancel"
                   OnClick="BackToList"
                   aria-label="Cancel">
            Cancel
        </MudButton>
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Save"
                   OnClick="SavePerson"
                   Disabled="_isSaving"
                   aria-label="Save Person">
            @(_isSaving ? "Saving..." : "Save Person")
        </MudButton>
    </div>
</MudPaper>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="pa-0">
    @if (_loading)
    {
        <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="my-6" />
    }
    else
    {
        <MudTabs Elevation="2" Rounded="true" ApplyEffectsToContainer="true" Color="Color.Surface" @bind-ActivePanelIndex="_activeTabIndex">
            
            <!-- TAB 1: Demographics & Master Info -->
            <MudTabPanel Text="Demographics & Identity" Icon="@Icons.Material.Filled.Badge">
                <MudForm @ref="_form" @bind-IsValid="_isValid" Class="pa-4">
                    <MudGrid Spacing="3">
                        <!-- Identity & Demographics Card -->
                        <MudItem xs="12" lg="8">
                            <MudCard Outlined="true" Class="pa-4 mb-4">
                                <MudText Typo="Typo.h6" Class="fw-bold mb-3">Identity &amp; Personal Information (SETMIS File 400)</MudText>
                                <MudGrid>
                                    <!-- RSA ID with Real-Time Auto-Calculation -->
                                    <MudItem xs="12" md="6">
                                        <MudTextField T="string"
                                                      Label="South African ID Number (13 Digits)"
                                                      Value="_person.RsaIdNumber"
                                                      ValueChanged="OnRsaIdChanged"
                                                      Placeholder="e.g. 8501015009087"
                                                      Variant="Variant.Outlined"
                                                      Adornment="Adornment.Start"
                                                      AdornmentIcon="@Icons.Material.Filled.CreditCard"
                                                      Immediate="true"
                                                      HelperText="Auto-populates Date of Birth, Gender, and Citizenship" />
                                    </MudItem>
                                    <MudItem xs="12" sm="6" md="3">
                                        <MudSelect T="string"
                                                   Label="Alternate ID Type"
                                                   @bind-Value="_person.AlternateIdTypeId"
                                                   Variant="Variant.Outlined">
                                            @foreach (var alt in _alternateIdTypes)
                                            {
                                                <MudSelectItem Value="@alt.Code">@alt.Name (@alt.Code)</MudSelectItem>
                                            }
                                        </MudSelect>
                                    </MudItem>
                                    <MudItem xs="12" sm="6" md="3">
                                        <MudTextField T="string"
                                                      Label="Passport / Alternate ID No"
                                                      @bind-Value="_person.PassportNumber"
                                                      Placeholder="e.g. A12345678"
                                                      Variant="Variant.Outlined"
                                                      Adornment="Adornment.Start"
                                                      AdornmentIcon="@Icons.Material.Filled.Public" />
                                    </MudItem>

                                    <!-- Real-time Feedback for RSA ID Parsing -->
                                    @if (!string.IsNullOrWhiteSpace(_person.RsaIdNumber))
                                    {
                                        <MudItem xs="12">
                                            @if (_rsaValidation.IsValid)
                                            {
                                                <MudAlert Severity="Severity.Success" Variant="Variant.Outlined" Dense="true" Class="my-1">
                                                    <div class="d-flex align-center justify-space-between flex-wrap">
                                                        <span><strong>Verified RSA ID:</strong> Born on <strong>@(_person.DateOfBirth?.ToString("dd MMMM yyyy"))</strong> &bull; Gender: <strong>@_person.Gender</strong> &bull; Status: <strong>@(_person.IsSouthAfricanCitizen == true ? "SA Citizen" : "Permanent Resident")</strong></span>
                                                        <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Filled">Luhn Checksum Valid</MudChip>
                                                    </div>
                                                </MudAlert>
                                            }
                                            else
                                            {
                                                <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Dense="true" Class="my-1">
                                                    <strong>RSA ID Incomplete:</strong> @_rsaValidation.ErrorMessage
                                                </MudAlert>
                                            }
                                        </MudItem>
                                    }

                                    <!-- Names -->
                                    <MudItem xs="12" sm="4" md="2">
                                        <MudSelect T="string" Label="Title" @bind-Value="_person.Title" Variant="Variant.Outlined">
                                            <MudSelectItem Value="@("Mr")">Mr</MudSelectItem>
                                            <MudSelectItem Value="@("Ms")">Ms</MudSelectItem>
                                            <MudSelectItem Value="@("Mrs")">Mrs</MudSelectItem>
                                            <MudSelectItem Value="@("Dr")">Dr</MudSelectItem>
                                            <MudSelectItem Value="@("Prof")">Prof</MudSelectItem>
                                            <MudSelectItem Value="@("Adv")">Adv</MudSelectItem>
                                        </MudSelect>
                                    </MudItem>
                                    <MudItem xs="12" sm="8" md="5">
                                        <MudTextField T="string"
                                                      Label="First Name"
                                                      Required="true"
                                                      RequiredError="First name is mandatory"
                                                      @bind-Value="_person.FirstName"
                                                      Variant="Variant.Outlined" />
                                    </MudItem>
                                    <MudItem xs="12" sm="12" md="5">
                                        <MudTextField T="string"
                                                      Label="Last Name (Surname)"
                                                      Required="true"
                                                      RequiredError="Last name is mandatory"
                                                      @bind-Value="_person.LastName"
                                                      Variant="Variant.Outlined" />
                                    </MudItem>
                                    <MudItem xs="12" sm="6" md="6">
                                        <MudTextField T="string"
                                                      Label="Middle Names"
                                                      @bind-Value="_person.MiddleName"
                                                      Variant="Variant.Outlined" />
                                    </MudItem>
                                    <MudItem xs="12" sm="6" md="6">
                                        <MudDatePicker Label="Date of Birth"
                                                       @bind-Date="_person.DateOfBirth"
                                                       Variant="Variant.Outlined"
                                                       DateFormat="yyyy-MM-dd"
                                                       ReadOnly="@(!string.IsNullOrWhiteSpace(_person.RsaIdNumber) && _rsaValidation.IsValid)" />
                                    </MudItem>

                                    <!-- Equity & Demographics -->
                                    <MudItem xs="12" sm="6" md="4">
                                        <MudSelect T="string" Label="Gender" @bind-Value="_person.Gender" Variant="Variant.Outlined">
                                            <MudSelectItem Value="@("Male")">Male</MudSelectItem>
                                            <MudSelectItem Value="@("Female")">Female</MudSelectItem>
                                            <MudSelectItem Value="@("Other")">Other / Non-Binary</MudSelectItem>
                                        </MudSelect>
                                    </MudItem>
                                    <MudItem xs="12" sm="6" md="4">
                                        <MudSelect T="string" Label="Equity / Population Group" @bind-Value="_person.EquityCode" Variant="Variant.Outlined">
                                            @foreach (var eq in _equityTypes)
                                            {
                                                <MudSelectItem Value="@eq.Code">@eq.Name</MudSelectItem>
                                            }
                                        </MudSelect>
                                    </MudItem>
                                    <MudItem xs="12" sm="6" md="4">
                                        <MudSelect T="string" Label="Nationality" @bind-Value="_person.NationalityCode" Variant="Variant.Outlined">
                                            @foreach (var nat in _nationalityTypes)
                                            {
                                                <MudSelectItem Value="@nat.Code">@nat.Name</MudSelectItem>
                                            }
                                        </MudSelect>
                                    </MudItem>
                                </MudGrid>
                            </MudCard>

                            <!-- Washington Group Disability Card -->
                            <MudCard Outlined="true" Class="pa-4 mb-4">
                                <MudText Typo="Typo.h6" Class="fw-bold mb-1">Disability Assessment (Washington Group Short Set)</MudText>
                                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-3 d-block">Statutory functional disability reporting under SETMIS File 400</MudText>
                                <MudGrid>
                                    <MudItem xs="12" sm="6">
                                        <MudSelect T="string" Label="Seeing Disability" @bind-Value="_person.SeeingRatingId" Variant="Variant.Outlined">
                                            @foreach (var opt in _disabilityRatingTypes)
                                            {
                                                <MudSelectItem Value="@opt.Code">@opt.Name</MudSelectItem>
                                            }
                                        </MudSelect>
                                    </MudItem>
                                    <MudItem xs="12" sm="6">
                                        <MudSelect T="string" Label="Hearing Disability" @bind-Value="_person.HearingRatingId" Variant="Variant.Outlined">
                                            @foreach (var opt in _disabilityRatingTypes)
                                            {
                                                <MudSelectItem Value="@opt.Code">@opt.Name</MudSelectItem>
                                            }
                                        </MudSelect>
                                    </MudItem>
                                    <MudItem xs="12" sm="6">
                                        <MudSelect T="string" Label="Walking / Mobility" @bind-Value="_person.WalkingRatingId" Variant="Variant.Outlined">
                                            @foreach (var opt in _disabilityRatingTypes)
                                            {
                                                <MudSelectItem Value="@opt.Code">@opt.Name</MudSelectItem>
                                            }
                                        </MudSelect>
                                    </MudItem>
                                    <MudItem xs="12" sm="6">
                                        <MudSelect T="string" Label="Remembering / Concentration" @bind-Value="_person.RememberingRatingId" Variant="Variant.Outlined">
                                            @foreach (var opt in _disabilityRatingTypes)
                                            {
                                                <MudSelectItem Value="@opt.Code">@opt.Name</MudSelectItem>
                                            }
                                        </MudSelect>
                                    </MudItem>
                                </MudGrid>
                            </MudCard>
                        </MudItem>

                        <!-- Right Column: Contact & Addresses -->
                        <MudItem xs="12" lg="4">
                            <MudCard Outlined="true" Class="pa-4 mb-4">
                                <MudText Typo="Typo.h6" Class="fw-bold mb-3">Contact Details</MudText>
                                <MudGrid>
                                    <MudItem xs="12">
                                        <MudTextField T="string" Label="Email Address" @bind-Value="_person.Email" Variant="Variant.Outlined" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Email" />
                                    </MudItem>
                                    <MudItem xs="12">
                                        <MudTextField T="string" Label="Cell Phone Number" @bind-Value="_person.CellNumber" Variant="Variant.Outlined" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.PhoneAndroid" />
                                    </MudItem>
                                    <MudItem xs="12">
                                        <MudTextField T="string" Label="Alternative Phone" @bind-Value="_person.PhoneNumber" Variant="Variant.Outlined" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Phone" />
                                    </MudItem>
                                    <MudItem xs="12">
                                        <MudTextField T="string" Label="Physical Address" @bind-Value="_person.PhysicalAddress" Variant="Variant.Outlined" Lines="2" />
                                    </MudItem>
                                    <MudItem xs="12">
                                        <MudTextField T="string" Label="Postal Address" @bind-Value="_person.PostalAddress" Variant="Variant.Outlined" Lines="2" />
                                    </MudItem>
                                    <MudItem xs="12" sm="6">
                                        <MudSelect T="string" Label="Province" @bind-Value="_person.ProvinceCode" Variant="Variant.Outlined">
                                            @foreach (var prov in _provinceTypes)
                                            {
                                                <MudSelectItem Value="@prov.Code">@prov.Name</MudSelectItem>
                                            }
                                        </MudSelect>
                                    </MudItem>
                                    <MudItem xs="12" sm="6">
                                        <MudTextField T="string" Label="Postal Code" @bind-Value="_person.PhysicalAddressPostalCode" Variant="Variant.Outlined" />
                                    </MudItem>
                                </MudGrid>
                            </MudCard>
                        </MudItem>
                    </MudGrid>
                </MudForm>
            </MudTabPanel>

            <!-- TAB 2: Learner & Training Enrolments -->
            <MudTabPanel Text="Learner Enrolments" Icon="@Icons.Material.Filled.School" Disabled="Id == 0">
                <div class="pa-4">
                    <div class="d-flex flex-wrap justify-space-between align-center mb-4 gap-3">
                        <div>
                            <MudText Typo="Typo.h6">Learner Training Agreements (SETMIS 500)</MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">Registered apprentice, learnership, bursary, and skills programmes</MudText>
                        </div>
                        <MudChip T="string" Color="Color.Primary" Size="Size.Small" Variant="Variant.Filled">
                            @_learnerAgreements.Count Enrolments
                        </MudChip>
                    </div>

                    @if (_loadingLearners)
                    {
                        <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="my-4" />
                    }
                    else
                    {
                        <MudTable Items="_learnerAgreements" Hover="true" Dense="true" Striped="true" Elevation="1">
                            <HeaderContent>
                                <MudTh>Contract No</MudTh>
                                <MudTh>Host Employer</MudTh>
                                <MudTh>Qualification / Trade</MudTh>
                                <MudTh>Programme Type</MudTh>
                                <MudTh>Registration Date</MudTh>
                                <MudTh>Status</MudTh>
                                <MudTh Style="text-align:right">Action</MudTh>
                            </HeaderContent>
                            <RowTemplate>
                                <MudTd DataLabel="Contract No"><strong>@context.LearnerContractNumber</strong></MudTd>
                                <MudTd DataLabel="Employer">
                                    <MudLink Href="@($"/employers/{context.EmployerId}")" Typo="Typo.body2" Class="fw-semibold">
                                        @context.EmployerName
                                    </MudLink>
                                </MudTd>
                                <MudTd DataLabel="Qualification">@context.QualificationTitle</MudTd>
                                <MudTd DataLabel="Programme Type">
                                    <MudChip T="string" Color="Color.Info" Size="Size.Small" Variant="Variant.Outlined">@context.ProgrammeTypeName</MudChip>
                                </MudTd>
                                <MudTd DataLabel="Registered">@context.RegistrationDate.ToString("yyyy-MM-dd")</MudTd>
                                <MudTd DataLabel="Status">
                                    <MudChip T="string" Color="Color.Success" Size="Size.Small">@context.Status</MudChip>
                                </MudTd>
                                <MudTd Style="text-align:right" DataLabel="Action">
                                    <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary" Href="@($"/learners/{context.CompanyLearnerId}")">
                                        Open Learner Hub
                                    </MudButton>
                                </MudTd>
                            </RowTemplate>
                            <NoRecordsContent>
                                <div class="pa-4 text-center">
                                    <MudText Typo="Typo.body2" Color="Color.Secondary">No learner training contracts registered for this person.</MudText>
                                </div>
                            </NoRecordsContent>
                        </MudTable>
                    }
                </div>
            </MudTabPanel>

            <!-- TAB 3: Employer & Workplace Links -->
            <MudTabPanel Text="Employer Links" Icon="@Icons.Material.Filled.Apartment" Disabled="Id == 0">
                <div class="pa-4">
                    <div class="d-flex flex-wrap justify-space-between align-center mb-4 gap-3">
                        <div>
                            <MudText Typo="Typo.h6">Corporate &amp; Workplace Roles</MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">Organisations where this person is linked as an Executive, SDF, or Training Committee Member</MudText>
                        </div>
                    </div>

                    @if (_loadingEmployers)
                    {
                        <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="my-4" />
                    }
                    else
                    {
                        <MudTable Items="_employerLinks" Hover="true" Dense="true" Striped="true" Elevation="1">
                            <HeaderContent>
                                <MudTh>Company Name</MudTh>
                                <MudTh>SARS SDL Number</MudTh>
                                <MudTh>Designation / Capacity</MudTh>
                                <MudTh>Company Email</MudTh>
                                <MudTh>Company Phone</MudTh>
                                <MudTh Style="text-align:right">Action</MudTh>
                            </HeaderContent>
                            <RowTemplate>
                                <MudTd DataLabel="Company Name">
                                    <div class="d-flex align-center gap-2">
                                        <MudIcon Icon="@Icons.Material.Filled.Apartment" Color="Color.Primary" Size="Size.Small" />
                                        <MudLink Href="@($"/employers/{context.OrganisationId}")" Typo="Typo.body2" Class="fw-bold">
                                            @context.CompanyName
                                        </MudLink>
                                    </div>
                                </MudTd>
                                <MudTd DataLabel="SDL Number">@context.SdlNumber</MudTd>
                                <MudTd DataLabel="Designation">
                                    <MudChip T="string" Color="Color.Primary" Size="Size.Small" Variant="Variant.Outlined">@context.Designation</MudChip>
                                </MudTd>
                                <MudTd DataLabel="Email">@(context.Email ?? "—")</MudTd>
                                <MudTd DataLabel="Phone">@(context.Phone ?? "—")</MudTd>
                                <MudTd Style="text-align:right" DataLabel="Action">
                                    <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Business" Href="@($"/employers/{context.OrganisationId}")">
                                        View Org Hub
                                    </MudButton>
                                </MudTd>
                            </RowTemplate>
                            <NoRecordsContent>
                                <div class="pa-4 text-center">
                                    <MudText Typo="Typo.body2" Color="Color.Secondary">No corporate or employer designations linked to this person.</MudText>
                                </div>
                            </NoRecordsContent>
                        </MudTable>
                    }
                </div>
            </MudTabPanel>

            <!-- TAB 4: ETQA Assessor / Moderator Roles -->
            <MudTabPanel Text="ETQA Practitioner" Icon="@Icons.Material.Filled.Badge" Disabled="Id == 0">
                <div class="pa-4">
                    <div class="d-flex flex-wrap justify-space-between align-center mb-4 gap-3">
                        <div>
                            <MudText Typo="Typo.h6">Registered ETQA Assessor &amp; Moderator Scopes</MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">Accreditation credentials as registered quality assurance practitioner</MudText>
                        </div>
                    </div>

                    @if (_loadingEtqa)
                    {
                        <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="my-4" />
                    }
                    else
                    {
                        <MudTable Items="_etqaPractitioners" Hover="true" Dense="true" Striped="true" Elevation="1">
                            <HeaderContent>
                                <MudTh>Registration No</MudTh>
                                <MudTh>Practitioner Role</MudTh>
                                <MudTh>Accredited Scopes</MudTh>
                                <MudTh>Registration Period</MudTh>
                                <MudTh>Status</MudTh>
                                <MudTh Style="text-align:right">Action</MudTh>
                            </HeaderContent>
                            <RowTemplate>
                                <MudTd DataLabel="Registration No"><strong>@context.RegistrationNumber</strong></MudTd>
                                <MudTd DataLabel="Role">@context.Role</MudTd>
                                <MudTd DataLabel="Scopes">
                                    <MudChip T="string" Color="Color.Info" Size="Size.Small">@context.ScopesCount Qualifications in Scope</MudChip>
                                </MudTd>
                                <MudTd DataLabel="Period">@context.StartDate.ToString("yyyy-MM-dd") to @context.EndDate.ToString("yyyy-MM-dd")</MudTd>
                                <MudTd DataLabel="Status">
                                    <MudChip T="string" Color="Color.Success" Size="Size.Small">@context.Status</MudChip>
                                </MudTd>
                                <MudTd Style="text-align:right" DataLabel="Action">
                                    <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.VerifiedUser" Href="@($"/etqa/assessors/{context.AssessorId}")">
                                        View Practitioner Hub
                                    </MudButton>
                                </MudTd>
                            </RowTemplate>
                            <NoRecordsContent>
                                <div class="pa-4 text-center">
                                    <MudText Typo="Typo.body2" Color="Color.Secondary">No ETQA assessor or moderator registrations found for this person.</MudText>
                                </div>
                            </NoRecordsContent>
                        </MudTable>
                    }
                </div>
            </MudTabPanel>

            <!-- TAB 5: Artisan Mentorships -->
            <MudTabPanel Text="Artisan Mentorships" Icon="@Icons.Material.Filled.Engineering" Disabled="Id == 0">
                <div class="pa-4">
                    <div class="d-flex flex-wrap justify-space-between align-center mb-4 gap-3">
                        <div>
                            <MudText Typo="Typo.h6">Designated Workshop Artisan Mentors</MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">Workplace approvals where this person serves as a certified mentor</MudText>
                        </div>
                    </div>

                    @if (_loadingMentors)
                    {
                        <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="my-4" />
                    }
                    else
                    {
                        <MudTable Items="_mentorships" Hover="true" Dense="true" Striped="true" Elevation="1">
                            <HeaderContent>
                                <MudTh>Approved Workshop</MudTh>
                                <MudTh>Trade Scope</MudTh>
                                <MudTh>Job Title / Designation</MudTh>
                                <MudTh>Artisan Trade No</MudTh>
                                <MudTh>Experience</MudTh>
                                <MudTh>Certified Status</MudTh>
                                <MudTh Style="text-align:right">Action</MudTh>
                            </HeaderContent>
                            <RowTemplate>
                                <MudTd DataLabel="Workshop"><strong>@context.EmployerName</strong></MudTd>
                                <MudTd DataLabel="Trade">@context.TradeTitle</MudTd>
                                <MudTd DataLabel="Designation">@context.Designation</MudTd>
                                <MudTd DataLabel="Trade No">@(context.ArtisanTradeNumber ?? "—")</MudTd>
                                <MudTd DataLabel="Experience">@context.YearsExperience yrs</MudTd>
                                <MudTd DataLabel="Certified">
                                    @if (context.IsCertifiedArtisan)
                                    {
                                        <MudChip T="string" Color="Color.Success" Size="Size.Small" Variant="Variant.Filled">Certified Artisan</MudChip>
                                    }
                                    else
                                    {
                                        <MudChip T="string" Color="Color.Warning" Size="Size.Small" Variant="Variant.Filled">Under Review</MudChip>
                                    }
                                </MudTd>
                                <MudTd Style="text-align:right" DataLabel="Action">
                                    <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.HomeRepairService" Href="@($"/workplace-approvals/{context.WorkplaceApprovalId}")">
                                        View WPA Hub
                                    </MudButton>
                                </MudTd>
                            </RowTemplate>
                            <NoRecordsContent>
                                <div class="pa-4 text-center">
                                    <MudText Typo="Typo.body2" Color="Color.Secondary">No artisan mentorship roles registered for this person.</MudText>
                                </div>
                            </NoRecordsContent>
                        </MudTable>
                    }
                </div>
            </MudTabPanel>

            <!-- TAB 6: Evidence Vault -->
            @if (Id > 0)
            {
                <MudTabPanel Text="Evidence Vault" Icon="@Icons.Material.Filled.FolderZip">
                    <DocumentVault TargetEntityName="Person" TargetEntityId="@Id" />
                </MudTabPanel>

                <!-- TAB 7: Audit Trail -->
                <MudTabPanel Text="Audit History" Icon="@Icons.Material.Filled.History">
                    <WorkflowTimeline ProcessCode="PERSON" EntityId="@Id" />
                </MudTabPanel>
            }
        </MudTabs>
    }
</MudContainer>

@code {
    [Parameter] public int Id { get; set; }

    private Person _person = new();
    private List<LookupItemDto> _alternateIdTypes = new();
    private List<LookupItemDto> _equityTypes = new();
    private List<LookupItemDto> _nationalityTypes = new();
    private List<LookupItemDto> _provinceTypes = new();
    private List<LookupItemDto> _disabilityRatingTypes = new();

    // 360-Degree Relational Collections
    private List<PersonLearnerDto> _learnerAgreements = new();
    private List<PersonEmployerLinkDto> _employerLinks = new();
    private List<PersonEtqaDto> _etqaPractitioners = new();
    private List<PersonMentorDto> _mentorships = new();

    private bool _loadingLearners = false;
    private bool _loadingEmployers = false;
    private bool _loadingEtqa = false;
    private bool _loadingMentors = false;

    private bool _loading = true;
    private bool _isSaving = false;
    private bool _isValid = false;
    private MudForm? _form;
    private int _activeTabIndex = 0;

    private (bool IsValid, DateTime? DateOfBirth, string? Gender, bool? IsSouthAfricanCitizen, string? ErrorMessage) _rsaValidation = (true, null, null, null, null);
    private List<BreadcrumbItem> _breadcrumbItems = new();

    protected override async Task OnInitializedAsync()
    {
        _loading = true;
        SetupBreadcrumbs();

        _alternateIdTypes = await LookupService.GetLookupItemsAsync("AlternateIdType");
        _equityTypes = await LookupService.GetLookupItemsAsync("EquityType");
        _nationalityTypes = await LookupService.GetLookupItemsAsync("NationalityType");
        _provinceTypes = await LookupService.GetLookupItemsAsync("ProvinceType");
        _disabilityRatingTypes = await LookupService.GetLookupItemsAsync("DisabilityRatingType");

        if (Id > 0)
        {
            await LoadPersonData();
        }
        else
        {
            _person = new Person
            {
                Title = "Mr",
                Gender = "Male",
                GenderCode = "M",
                CitizenStatusCode = "SA_CIT",
                IsSouthAfricanCitizen = true,
                NationalityCode = "ZA",
                EquityCode = "African",
                IsActive = true
            };
        }

        _loading = false;
    }

    private void SetupBreadcrumbs()
    {
        _breadcrumbItems = new List<BreadcrumbItem>
        {
            new BreadcrumbItem("Home", href: "/"),
            new BreadcrumbItem("People", href: "/people"),
            new BreadcrumbItem(Id == 0 ? "New Person" : $"Person #{Id}", href: null, disabled: true)
        };
    }

    private async Task LoadPersonData()
    {
        var p = await PersonService.GetByIdAsync(Id);
        if (p != null)
        {
            _person = p;
        }
        else
        {
            _person = new Person
            {
                Id = Id,
                FirstName = "Sipho",
                LastName = "Dlamini",
                RsaIdNumber = "9001015009087",
                EmailAddress = "sipho.dlamini@merseta.org.za",
                CellPhoneNumber = "0115551234",
                Gender = "Male",
                GenderCode = "M",
                CitizenStatusCode = "SA_CIT",
                IsSouthAfricanCitizen = true,
                NationalityCode = "ZA",
                EquityCode = "African",
                IsActive = true,
                DateOfBirth = new DateTime(1990, 1, 1)
            };
        }

        if (!string.IsNullOrWhiteSpace(_person.RsaIdNumber))
        {
            _rsaValidation = RsaIdValidator.Parse(_person.RsaIdNumber);
        }

        // Load 360-Degree Relational Collections
        _loadingLearners = true;
        _loadingEmployers = true;
        _loadingEtqa = true;
        _loadingMentors = true;

        _learnerAgreements = await PersonService.GetPersonLearnersAsync(Id);
        _loadingLearners = false;

        _employerLinks = await PersonService.GetPersonEmployersAsync(Id);
        _loadingEmployers = false;

        _etqaPractitioners = await PersonService.GetPersonEtqaPractitionersAsync(Id);
        _loadingEtqa = false;

        _mentorships = await PersonService.GetPersonMentorshipsAsync(Id);
        _loadingMentors = false;
    }

    private void OnRsaIdChanged(string newId)
    {
        _person.RsaIdNumber = newId;
        if (string.IsNullOrWhiteSpace(newId))
        {
            _rsaValidation = (true, null, null, null, null);
            return;
        }

        _rsaValidation = RsaIdValidator.Parse(newId);
        if (_rsaValidation.IsValid)
        {
            if (_rsaValidation.DateOfBirth.HasValue)
                _person.DateOfBirth = _rsaValidation.DateOfBirth.Value;

            if (!string.IsNullOrWhiteSpace(_rsaValidation.Gender))
            {
                _person.Gender = _rsaValidation.Gender;
                _person.GenderCode = _rsaValidation.Gender.StartsWith("M", StringComparison.OrdinalIgnoreCase) ? "M" : "F";
            }

            if (_rsaValidation.IsSouthAfricanCitizen.HasValue)
            {
                _person.IsSouthAfricanCitizen = _rsaValidation.IsSouthAfricanCitizen.Value;
                _person.CitizenStatusCode = _rsaValidation.IsSouthAfricanCitizen.Value ? "SA_CIT" : "PERM_RES";
            }
        }
    }

    private async Task SavePerson()
    {
        if (_form != null)
        {
            await _form.Validate();
            if (!_isValid) return;
        }

        _isSaving = true;
        try
        {
            if (Id == 0)
            {
                var created = await PersonService.CreateAsync(_person, "Admin");
                Snackbar.Add($"Person '{created.FirstName} {created.LastName}' created successfully.", Severity.Success);
                NavManager.NavigateTo($"/people/{created.Id}");
            }
            else
            {
                var updated = await PersonService.UpdateAsync(_person, "Admin");
                Snackbar.Add($"Person '{updated.FirstName} {updated.LastName}' updated successfully.", Severity.Success);
                await LoadPersonData();
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error saving person: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isSaving = false;
        }
    }

    private async Task DeletePerson()
    {
        if (Id <= 0) return;

        try
        {
            var deleted = await PersonService.DeleteAsync(Id, "Admin");
            if (deleted)
            {
                Snackbar.Add("Person marked inactive successfully.", Severity.Success);
                NavManager.NavigateTo("/people");
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error deleting person: {ex.Message}", Severity.Error);
        }
    }

    private void BackToList() => NavManager.NavigateTo("/people");
}
