@page "/non-seta/verifications/{Id:int}"
@using Nsdms.Application.Common.Interfaces
@using Nsdms.Domain.Entities
@using Nsdms.Web.Components.Shared
@inject INonSetaVerificationService NonSetaService
@inject NavigationManager Nav
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<PageTitle>Non-SETA Verification Workbench | merSETA NSDMS</PageTitle>

@if (_verif == null)
{
    <MudContainer Class="my-8 text-center">
        <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
        <MudText Typo="Typo.body1" Class="mt-3">Loading qualification verification record...</MudText>
    </MudContainer>
}
else
{
    <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="my-4">
        <!-- Sticky Top Bar -->
        <MudCard Elevation="2" Class="mb-4 sticky-top-header" Style="position: sticky; top: var(--mud-appbar-height, 64px) !important; z-index: 10;">
            <MudCardContent Class="d-flex align-center justify-space-between py-3">
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                    <MudIconButton Icon="@Icons.Material.Filled.ArrowBack" Color="Color.Primary" OnClick="@(() => Nav.NavigateTo("/non-seta/verifications"))" />
                    <div>
                        <MudText Typo="Typo.h5" Class="fw-bold">@_verif.QualificationTitle</MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">
                            Originating SETA: <strong>@_verif.OriginatingSetaCode</strong> | Candidate: <strong>@_verif.Person?.FirstName @_verif.Person?.LastName</strong> (ID: @_verif.Person?.RsaIdNumber) | Certificate: <strong>@_verif.ExternalCertificateNumber</strong>
                        </MudText>
                    </div>
                </MudStack>

                <MudStack Row="true" Spacing="2">
                    <MudButton Variant="Variant.Outlined" Color="Color.Secondary" StartIcon="@Icons.Material.Filled.Cancel" OnClick="@(() => Nav.NavigateTo("/non-seta/verifications"))">
                        Cancel
                    </MudButton>

                    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Save" OnClick="SaveAsync">
                        Save
                    </MudButton>

                    @if (_verif.VerificationStatusCode == "EndorsedByMerSeta")
                    {
                        <MudChip T="string" Color="Color.Success" Variant="Variant.Filled" Size="Size.Large" Icon="@Icons.Material.Filled.Verified">
                            ENDORSED FOR ARTICULATION
                        </MudChip>
                    }
                </MudStack>
            </MudCardContent>
        </MudCard>

        <!-- Workflow State Tracker & Action Bridge -->
        <WorkflowProgressBar ProcessCode="NONSETA" 
                             EntityId="@Id" 
                             EntityTitle="@_verif.QualificationTitle" 
                             EntityRef="@_verif.ExternalCertificateNumber" />

        <WorkflowActionBridge ProcessCode="NONSETA" 
                              EntityId="@Id" 
                              EntityTitle="@_verif.QualificationTitle" 
                              EntityRef="@_verif.ExternalCertificateNumber" 
                              OnStatusChanged="OnWorkflowStatusChanged" />

        <!-- Main Content -->
        <MudGrid>
            <MudItem xs="12" md="6">
                <MudCard Outlined="true" Class="pa-4 h-100">
                    <MudText Typo="Typo.h6" Class="fw-bold mb-3">Qualification &amp; External Provider Details</MudText>
                    <MudSimpleTable Dense="true" Elevation="0">
                        <tbody>
                            <tr><td><strong>Qualification Title:</strong></td><td>@_verif.QualificationTitle</td></tr>
                            <tr><td><strong>SAQA Qual ID:</strong></td><td>@(_verif.SaqaQualificationId ?? "N/A")</td></tr>
                            <tr><td><strong>Originating SETA:</strong></td><td>@_verif.OriginatingSetaCode</td></tr>
                            <tr><td><strong>NQF Level:</strong></td><td>Level @_verif.NqfLevel</td></tr>
                            <tr><td><strong>Credits Achieved:</strong></td><td>@_verif.TotalCreditsAchieved Credits</td></tr>
                            <tr><td><strong>External Certificate #:</strong></td><td>@_verif.ExternalCertificateNumber</td></tr>
                            <tr><td><strong>Achievement Date:</strong></td><td>@_verif.AchievementDate.ToString("dd MMMM yyyy")</td></tr>
                            <tr><td><strong>External Institution:</strong></td><td>@(_verif.NonSetaCompany?.CompanyName ?? "External TVET / Provider")</td></tr>
                        </tbody>
                    </MudSimpleTable>
                </MudCard>
            </MudItem>

            <MudItem xs="12" md="6">
                <MudCard Outlined="true" Class="pa-4 h-100">
                    <MudText Typo="Typo.h6" Class="fw-bold mb-3">merSETA ETQA Endorsement Status</MudText>
                    <MudSimpleTable Dense="true" Elevation="0">
                        <tbody>
                            <tr><td><strong>Verification Status:</strong></td><td><span class="badge bg-success">@_verif.VerificationStatusCode</span></td></tr>
                            <tr><td><strong>Endorsement Date:</strong></td><td>@(_verif.EndorsementDate?.ToString("dd MMMM yyyy HH:mm") ?? "Pending Review")</td></tr>
                            <tr><td><strong>Endorsed By:</strong></td><td>@(_verif.EndorsedByUserId ?? "Quality Assurance Officer")</td></tr>
                            <tr><td><strong>Notes / Remarks:</strong></td><td>@(_verif.EndorsementNotes ?? "Credits verified against National Learners' Records Database (NLRD).")</td></tr>
                        </tbody>
                    </MudSimpleTable>
                </MudCard>
            </MudItem>
        </MudGrid>
    </MudContainer>
}

@code {
    [Parameter] public int Id { get; set; }
    private NonSetaQualificationsCompletion? _verif;

    protected override async Task OnInitializedAsync()
    {
        await LoadRecordAsync();
    }

    private async Task LoadRecordAsync()
    {
        _verif = await NonSetaService.GetVerificationByIdAsync(Id);
    }

    private async Task SaveAsync()
    {
        try
        {
            Snackbar.Add("Non-SETA qualification record updated with audit log.", Severity.Success);
            await LoadRecordAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
    }

    private async Task EndorseAsync()
    {
        try
        {
            _verif = await NonSetaService.EndorseNonSetaQualificationAsync(Id, true, "Verified against NLRD national qualification record. Endorsed for credit articulation.", "EtqaManager");
            Snackbar.Add("Non-SETA qualification endorsed successfully.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
    }

    private async Task RejectAsync()
    {
        try
        {
            _verif = await NonSetaService.EndorseNonSetaQualificationAsync(Id, false, "External certificate could not be validated with issuing authority.", "EtqaManager");
            Snackbar.Add("Verification rejected.", Severity.Warning);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
    }

    private async Task OnWorkflowStatusChanged(string newStatus)
    {
        await LoadRecordAsync();
        StateHasChanged();
    }
}
