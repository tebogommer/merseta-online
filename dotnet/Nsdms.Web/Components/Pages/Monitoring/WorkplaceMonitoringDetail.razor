@page "/monitoring/{Id:int}"
@page "/monitoring/{Id:int}/edit"
@page "/monitoring/create"
@using Nsdms.Application.Common.Interfaces
@using Nsdms.Domain.Entities
@using Nsdms.Web.Components.Common
@inject IWorkplaceMonitoringService MonitoringService
@inject IOrganisationService OrganisationService
@inject IPersonService PersonService
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<PageTitle>@(IsNew ? "Schedule Workplace Monitoring Visit" : $"Monitoring Visit #{_visit.Id} - {_visit.Organisation?.CompanyName}") | merSETA NSDMS</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="my-4">
    <!-- STICKY TOP BAR -->
    <MudCard Elevation="2" Class="mb-4 sticky-top" Style="top: var(--mud-appbar-height, 64px); z-index: 10;">
        <MudCardContent Class="d-flex align-center justify-space-between py-3">
            <div class="d-flex align-center gap-3">
                <MudIconButton Icon="@Icons.Material.Filled.ArrowBack" Color="Color.Default" OnClick="@(() => Navigation.NavigateTo("/monitoring"))" Title="Back to List" />
                <div>
                    <MudBreadcrumbs Items="_breadcrumbs" Class="pa-0 mb-1" />
                    <MudText Typo="Typo.h5" Class="fw-bold">
                        @(IsNew ? "Schedule New Workplace Monitoring Visit" : $"Workplace Audit #{_visit.Id}: {_visit.Organisation?.CompanyName}")
                    </MudText>
                </div>
            </div>
            <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
                @if (!IsNew)
                {
                    @if (_visit.MonitoringStatusCode == "Approved")
                    {
                        <MudChip T="string" Color="Color.Success" Variant="Variant.Filled" Icon="@Icons.Material.Filled.CheckCircle">Approved</MudChip>
                    }
                    else if (_visit.MonitoringStatusCode == "NonComplianceIdentified" || _visit.NonCompliancesIdentified)
                    {
                        <MudChip T="string" Color="Color.Error" Variant="Variant.Filled" Icon="@Icons.Material.Filled.Warning">Non-Compliant</MudChip>
                    }
                    else if (_visit.MonitoringStatusCode == "PendingApproval")
                    {
                        <MudChip T="string" Color="Color.Warning" Variant="Variant.Filled">Pending Approval</MudChip>
                    }
                    else
                    {
                        <MudChip T="string" Color="Color.Default" Variant="Variant.Outlined">@_visit.MonitoringStatusCode</MudChip>
                    }

                    @if (_visit.MonitoringStatusCode == "Draft")
                    {
                        <MudButton Variant="Variant.Outlined" Color="Color.Warning" StartIcon="@Icons.Material.Filled.Send" OnClick="SubmitForApprovalAsync">
                            Submit for Approval
                        </MudButton>
                    }

                    @if (_visit.MonitoringStatusCode == "PendingApproval" || _visit.MonitoringStatusCode == "Draft")
                    {
                        <MudButton Variant="Variant.Filled" Color="Color.Success" StartIcon="@Icons.Material.Filled.Check" OnClick="ApproveVisitAsync">
                            Approve Visit
                        </MudButton>
                        <MudButton Variant="Variant.Outlined" Color="Color.Error" StartIcon="@Icons.Material.Filled.ReportProblem" OnClick="FlagNonComplianceAsync">
                            Flag Non-Compliance
                        </MudButton>
                    }
                }

                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Save" OnClick="SaveAsync" Disabled="@_isSaving">
                    @if (_isSaving)
                    {
                        <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="me-2" />
                        <span>Saving...</span>
                    }
                    else
                    {
                        <span>Save Visit</span>
                    }
                </MudButton>
            </MudStack>
        </MudCardContent>
    </MudCard>

    @if (_isLoading)
    {
        <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="mb-4" />
    }
    else
    {
        <MudTabs Elevation="2" Rounded="true" ApplyEffectsToContainer="true" PanelClass="pa-6" Color="Color.Primary">
            <!-- TAB 1: General Master Details -->
            <MudTabPanel Text="Visit Details" Icon="@Icons.Material.Filled.Business">
                <MudGrid>
                    <MudItem xs="12" md="8">
                        <MudCard Outlined="true" Class="pa-4 mb-4">
                            <MudText Typo="Typo.h6" Class="mb-3">Employer &amp; Inspection Scope</MudText>
                            <MudGrid>
                                <MudItem xs="12" md="6">
                                    <MudSelect T="int" Label="Employer / Organisation" @bind-Value="_visit.OrganisationId" Variant="Variant.Outlined" Required="true" RequiredError="Employer is mandatory">
                                        @foreach (var org in _organisations)
                                        {
                                            <MudSelectItem Value="@org.Id">@org.CompanyName (@org.SdlNumber)</MudSelectItem>
                                        }
                                    </MudSelect>
                                </MudItem>
                                <MudItem xs="12" md="6">
                                    <MudSelect T="int" Label="Mandatory Employer Contact Person" @bind-Value="_visit.ContactPersonId" Variant="Variant.Outlined" Required="true" RequiredError="Employer Contact Person must be selected per governance rules">
                                        @foreach (var person in _people)
                                        {
                                            <MudSelectItem Value="@person.Id">@person.FullName (@(person.RsaIdNumber ?? person.Email))</MudSelectItem>
                                        }
                                    </MudSelect>
                                </MudItem>
                                <MudItem xs="12" md="6">
                                    <MudDatePicker @bind-Date="_monitoringDate" Label="Monitoring Visit Date" Variant="Variant.Outlined" />
                                </MudItem>
                                <MudItem xs="12" md="6">
                                    <MudTextField @bind-Value="_visit.CloUserId" Label="Client Liaison Officer (CLO)" Variant="Variant.Outlined" Placeholder="e.g. CLO-Gauteng-01" />
                                </MudItem>
                                <MudItem xs="12" md="6">
                                    <MudTextField @bind-Value="_visit.CrmUserId" Label="Client Relationship Manager (CRM)" Variant="Variant.Outlined" Placeholder="e.g. CRM-Regional-02" />
                                </MudItem>
                                <MudItem xs="12" md="6">
                                    <MudTextField @bind-Value="_visit.MonitoringStatusCode" Label="Workflow Status" Variant="Variant.Outlined" ReadOnly="true" />
                                </MudItem>
                            </MudGrid>
                        </MudCard>

                        @if (_visit.NonCompliancesIdentified || !string.IsNullOrWhiteSpace(_visit.NonComplianceNotes))
                        {
                            <MudAlert Severity="Severity.Error" Variant="Variant.Filled" Class="mb-4">
                                <MudText Typo="Typo.subtitle2" Class="fw-bold">Non-Compliance Notice</MudText>
                                <MudText Typo="Typo.body2">@_visit.NonComplianceNotes</MudText>
                                @if (_visit.NonComplianceSubmittedDate.HasValue)
                                {
                                    <MudText Typo="Typo.caption" Class="d-block mt-1">Submitted to holding area on: @_visit.NonComplianceSubmittedDate.Value.ToString("yyyy-MM-dd HH:mm")</MudText>
                                }
                            </MudAlert>
                        }
                    </MudItem>

                    <MudItem xs="12" md="4">
                        <MudCard Outlined="true" Class="pa-4 mb-4">
                            <MudText Typo="Typo.h6" Class="mb-2">Visit Governance</MudText>
                            <MudList T="string" Dense="true">
                                <MudListItem Icon="@Icons.Material.Filled.Security">
                                    <strong>Audit Log:</strong> Captured atomically
                                </MudListItem>
                                <MudListItem Icon="@Icons.Material.Filled.Person">
                                    <strong>Created By:</strong> @(_visit.CreatedBy ?? "Current User")
                                </MudListItem>
                                <MudListItem Icon="@Icons.Material.Filled.AccessTime">
                                    <strong>Created Date:</strong> @_visit.CreatedAt.ToString("yyyy-MM-dd HH:mm")
                                </MudListItem>
                                @if (_visit.ApprovalDate.HasValue)
                                {
                                    <MudListItem Icon="@Icons.Material.Filled.Verified" IconColor="Color.Success">
                                        <strong>Approved Date:</strong> @_visit.ApprovalDate.Value.ToString("yyyy-MM-dd")
                                    </MudListItem>
                                    <MudListItem Icon="@Icons.Material.Filled.CheckCircle">
                                        <strong>Approved By:</strong> @_visit.ApprovedByUserId
                                    </MudListItem>
                                }
                            </MudList>
                        </MudCard>
                    </MudItem>
                </MudGrid>
            </MudTabPanel>

            <!-- TAB 2: Statutory 10-Point Compliance Checklist -->
            @if (!IsNew)
            {
                <MudTabPanel Text="10-Point Checklist" Icon="@Icons.Material.Filled.FactCheck">
                    <MudCard Outlined="true" Class="pa-4 mb-4">
                        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-3">
                            <div>
                                <MudText Typo="Typo.h6">Statutory Workplace Compliance Checklist</MudText>
                                <MudText Typo="Typo.caption" Color="Color.Secondary">Evaluates toolboxes, mentors, wages, PPE, curriculum exposure, and OHS compliance</MudText>
                            </div>
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Save" OnClick="SaveChecklistAsync">
                                Save Checklist Responses
                            </MudButton>
                        </MudStack>

                        <MudTable Items="_visit.ComplianceSurveys" Hover="true" Dense="true" Elevation="0" Outlined="true">
                            <HeaderContent>
                                <MudTh Style="width: 50px;">#</MudTh>
                                <MudTh Style="width: 140px;">Category</MudTh>
                                <MudTh>Statutory Inspection Criterion</MudTh>
                                <MudTh Style="width: 160px;">Finding</MudTh>
                                <MudTh>Assessor Remarks</MudTh>
                            </HeaderContent>
                            <RowTemplate>
                                <MudTd DataLabel="#"><strong>@context.QuestionNumber</strong></MudTd>
                                <MudTd DataLabel="Category">
                                    <MudChip T="string" Size="Size.Small" Color="Color.Info" Variant="Variant.Outlined">@context.Category</MudChip>
                                </MudTd>
                                <MudTd DataLabel="Question">@context.QuestionText</MudTd>
                                <MudTd DataLabel="Answer">
                                    <MudSelect T="string" @bind-Value="context.Answer" Dense="true" Margin="Margin.Dense" Variant="Variant.Outlined">
                                        <MudSelectItem Value="@("Yes")">Yes (Compliant)</MudSelectItem>
                                        <MudSelectItem Value="@("No")">No (Defect / Risk)</MudSelectItem>
                                        <MudSelectItem Value="@("NotApplicable")">N/A</MudSelectItem>
                                    </MudSelect>
                                </MudTd>
                                <MudTd DataLabel="Remarks">
                                    <MudTextField @bind-Value="context.Comments" Placeholder="Optional evaluation notes..." Dense="true" Margin="Margin.Dense" Variant="Variant.Outlined" />
                                </MudTd>
                            </RowTemplate>
                        </MudTable>
                    </MudCard>
                </MudTabPanel>

                <!-- TAB 3: Action Plans -->
                <MudTabPanel Text="Action Plans" Icon="@Icons.Material.Filled.AssignmentTurnedIn">
                    <MudCard Outlined="true" Class="pa-4 mb-4">
                        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-3">
                            <div>
                                <MudText Typo="Typo.h6">Corrective Action Plans</MudText>
                                <MudText Typo="Typo.caption" Color="Color.Secondary">Remediation milestones for identified non-compliances</MudText>
                            </div>
                            <MudButton Variant="Variant.Filled" Color="Color.Secondary" StartIcon="@Icons.Material.Filled.Add" OnClick="OpenAddActionPlanDialog">
                                Add Action Plan Item
                            </MudButton>
                        </MudStack>

                        <MudTable Items="_visit.ActionPlans" Hover="true" Dense="true" Elevation="0" Outlined="true">
                            <HeaderContent>
                                <MudTh>Validation Type</MudTh>
                                <MudTh>Criteria</MudTh>
                                <MudTh>Action Required</MudTh>
                                <MudTh>Responsible Person</MudTh>
                                <MudTh>Target Date</MudTh>
                                <MudTh>Status</MudTh>
                                <MudTh Style="text-align: right;">Action</MudTh>
                            </HeaderContent>
                            <RowTemplate>
                                <MudTd DataLabel="Type">
                                    <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Text">@context.ValidationTypeCode</MudChip>
                                </MudTd>
                                <MudTd DataLabel="Criteria">@context.Criteria</MudTd>
                                <MudTd DataLabel="Action">@context.ActionRequired</MudTd>
                                <MudTd DataLabel="Responsible">@context.ResponsiblePersonName</MudTd>
                                <MudTd DataLabel="Target Date">@context.TargetCompletionDate.ToString("yyyy-MM-dd")</MudTd>
                                <MudTd DataLabel="Status">
                                    @if (context.ActionPlanStatusCode == "Completed")
                                    {
                                        <MudChip T="string" Color="Color.Success" Size="Size.Small" Variant="Variant.Filled">Completed</MudChip>
                                    }
                                    else
                                    {
                                        <MudChip T="string" Color="Color.Warning" Size="Size.Small" Variant="Variant.Filled">@context.ActionPlanStatusCode</MudChip>
                                    }
                                </MudTd>
                                <MudTd DataLabel="Action" Style="text-align: right;">
                                    @if (context.ActionPlanStatusCode != "Completed")
                                    {
                                        <MudButton Variant="Variant.Outlined" Color="Color.Success" Size="Size.Small" OnClick="@(() => ResolveActionPlanAsync(context.Id))">
                                            Resolve
                                        </MudButton>
                                    }
                                </MudTd>
                            </RowTemplate>
                            <NoRecordsContent>
                                <div class="pa-3 text-center text-muted">No corrective action plans registered.</div>
                            </NoRecordsContent>
                        </MudTable>
                    </MudCard>
                </MudTabPanel>

                <!-- TAB 4: Mitigation Plans -->
                <MudTabPanel Text="Mitigation Plans" Icon="@Icons.Material.Filled.Shield">
                    <MudCard Outlined="true" Class="pa-4 mb-4">
                        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-3">
                            <div>
                                <MudText Typo="Typo.h6">Risk Mitigation Matrix</MudText>
                                <MudText Typo="Typo.caption" Color="Color.Secondary">Mitigations for high-impact workplace risks</MudText>
                            </div>
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="OpenAddMitigationDialog">
                                Add Mitigation Plan
                            </MudButton>
                        </MudStack>

                        <MudTable Items="_visit.MitigationPlans" Hover="true" Dense="true" Elevation="0" Outlined="true">
                            <HeaderContent>
                                <MudTh>Identified Risk</MudTh>
                                <MudTh>Mitigation Steps</MudTh>
                                <MudTh>Target Date</MudTh>
                                <MudTh>Status</MudTh>
                            </HeaderContent>
                            <RowTemplate>
                                <MudTd DataLabel="Risk" Class="fw-bold text-error">@context.IdentifiedRisk</MudTd>
                                <MudTd DataLabel="Steps">@context.MitigationSteps</MudTd>
                                <MudTd DataLabel="Target Date">@context.TargetResolutionDate.ToString("yyyy-MM-dd")</MudTd>
                                <MudTd DataLabel="Status">
                                    <MudChip T="string" Size="Size.Small" Color="Color.Info" Variant="Variant.Filled">@context.MitigationStatusCode</MudChip>
                                </MudTd>
                            </RowTemplate>
                            <NoRecordsContent>
                                <div class="pa-3 text-center text-muted">No high-risk mitigation plans recorded.</div>
                            </NoRecordsContent>
                        </MudTable>
                    </MudCard>
                </MudTabPanel>

                <!-- TAB 5: Learner Feedback & Surveys -->
                <MudTabPanel Text="Learner Interviews" Icon="@Icons.Material.Filled.RecordVoiceOver">
                    <MudCard Outlined="true" Class="pa-4 mb-4">
                        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-3">
                            <div>
                                <MudText Typo="Typo.h6">Confidential Learner Interview Logs</MudText>
                                <MudText Typo="Typo.caption" Color="Color.Secondary">On-site verification of toolboxes, stipend wages, and protective gear</MudText>
                            </div>
                            <MudButton Variant="Variant.Filled" Color="Color.Secondary" StartIcon="@Icons.Material.Filled.PersonAdd" OnClick="OpenAddLearnerSurveyDialog">
                                Log Learner Interview
                            </MudButton>
                        </MudStack>

                        <MudTable Items="_visit.LearnerSurveys" Hover="true" Dense="true" Elevation="0" Outlined="true">
                            <HeaderContent>
                                <MudTh>Learner Name</MudTh>
                                <MudTh>Toolbox</MudTh>
                                <MudTh>Curriculum</MudTh>
                                <MudTh>Mentor</MudTh>
                                <MudTh>Stipend</MudTh>
                                <MudTh>PPE</MudTh>
                                <MudTh>Learner Feedback</MudTh>
                            </HeaderContent>
                            <RowTemplate>
                                <MudTd DataLabel="Learner" Class="fw-bold">@context.LearnerName</MudTd>
                                <MudTd DataLabel="Toolbox">
                                    <MudIcon Icon="@(context.ReceivedToolbox ? Icons.Material.Filled.CheckCircle : Icons.Material.Filled.Cancel)" Color="@(context.ReceivedToolbox ? Color.Success : Color.Error)" Size="Size.Small" />
                                </MudTd>
                                <MudTd DataLabel="Curriculum">
                                    <MudIcon Icon="@(context.ExposedToFullCurriculum ? Icons.Material.Filled.CheckCircle : Icons.Material.Filled.Cancel)" Color="@(context.ExposedToFullCurriculum ? Color.Success : Color.Error)" Size="Size.Small" />
                                </MudTd>
                                <MudTd DataLabel="Mentor">
                                    <MudIcon Icon="@(context.HasQualifiedMentor ? Icons.Material.Filled.CheckCircle : Icons.Material.Filled.Cancel)" Color="@(context.HasQualifiedMentor ? Color.Success : Color.Error)" Size="Size.Small" />
                                </MudTd>
                                <MudTd DataLabel="Stipend">
                                    <MudIcon Icon="@(context.ReceivesStipendWage ? Icons.Material.Filled.CheckCircle : Icons.Material.Filled.Cancel)" Color="@(context.ReceivesStipendWage ? Color.Success : Color.Error)" Size="Size.Small" />
                                </MudTd>
                                <MudTd DataLabel="PPE">
                                    <MudIcon Icon="@(context.HasRequiredPPE ? Icons.Material.Filled.CheckCircle : Icons.Material.Filled.Cancel)" Color="@(context.HasRequiredPPE ? Color.Success : Color.Error)" Size="Size.Small" />
                                </MudTd>
                                <MudTd DataLabel="Feedback">@context.LearnerComments</MudTd>
                            </RowTemplate>
                            <NoRecordsContent>
                                <div class="pa-3 text-center text-muted">No learner on-site interviews logged yet.</div>
                            </NoRecordsContent>
                        </MudTable>
                    </MudCard>
                </MudTabPanel>

                <!-- TAB 6: Evidence & Photos -->
                <MudTabPanel Text="Inspection Evidence" Icon="@Icons.Material.Filled.AttachFile">
                    <DocumentUploadWidget TargetEntityName="WorkplaceMonitoringSiteVisit" TargetEntityId="@Id" />
                </MudTabPanel>
            }
        </MudTabs>
    }
</MudContainer>

@code {
    [Parameter]
    public int Id { get; set; }

    private bool IsNew => Id == 0;

    private List<BreadcrumbItem> _breadcrumbs = new();
    private WorkplaceMonitoringSiteVisit _visit = new();
    private List<Organisation> _organisations = new();
    private List<Person> _people = new();
    private DateTime? _monitoringDate = DateTime.UtcNow;
    private bool _isLoading = true;
    private bool _isSaving = false;

    protected override async Task OnParametersSetAsync()
    {
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        _isLoading = true;
        try
        {
            _organisations = await OrganisationService.GetAllAsync();
            _people = await PersonService.GetAllAsync();

            if (!IsNew)
            {
                var existing = await MonitoringService.GetSiteVisitByIdAsync(Id);
                if (existing != null)
                {
                    _visit = existing;
                    _monitoringDate = _visit.MonitoringDate;
                }
                else
                {
                    Snackbar.Add("Monitoring visit not found.", Severity.Error);
                    Navigation.NavigateTo("/monitoring");
                    return;
                }
            }
            else
            {
                _visit = new WorkplaceMonitoringSiteVisit
                {
                    MonitoringDate = DateTime.UtcNow,
                    MonitoringStatusCode = "Draft"
                };
                if (_organisations.Count > 0) _visit.OrganisationId = _organisations[0].Id;
                if (_people.Count > 0) _visit.ContactPersonId = _people[0].Id;
            }

            _breadcrumbs = new List<BreadcrumbItem>
            {
                new BreadcrumbItem("Home", href: "/"),
                new BreadcrumbItem("Workplace Monitoring", href: "/monitoring"),
                new BreadcrumbItem(IsNew ? "New Visit" : $"Visit #{_visit.Id}", href: null, disabled: true)
            };
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error loading data: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task SaveAsync()
    {
        if (_visit.ContactPersonId <= 0)
        {
            Snackbar.Add("Please select a specific Contact Person at the employer site.", Severity.Warning);
            return;
        }

        if (_visit.OrganisationId <= 0)
        {
            Snackbar.Add("Please select an Employer Organisation.", Severity.Warning);
            return;
        }

        _isSaving = true;
        try
        {
            if (_monitoringDate.HasValue) _visit.MonitoringDate = _monitoringDate.Value;

            if (IsNew)
            {
                var created = await MonitoringService.CreateSiteVisitAsync(_visit, "AdminUser");
                Snackbar.Add("Workplace monitoring visit created successfully.", Severity.Success);
                Navigation.NavigateTo($"/monitoring/{created.Id}");
            }
            else
            {
                await MonitoringService.UpdateSiteVisitAsync(_visit, "AdminUser");
                Snackbar.Add("Monitoring visit updated successfully.", Severity.Success);
                await LoadDataAsync();
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Save failed: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isSaving = false;
        }
    }

    private async Task SubmitForApprovalAsync()
    {
        try
        {
            await MonitoringService.SubmitForApprovalAsync(Id, "AdminUser");
            Snackbar.Add("Visit submitted for managerial review.", Severity.Info);
            await LoadDataAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Submission failed: {ex.Message}", Severity.Error);
        }
    }

    private async Task ApproveVisitAsync()
    {
        var confirm = await DialogService.ShowMessageBoxAsync("Approve Monitoring Visit", "Confirm that all inspection criteria have been met and approve this site visit?", yesText: "Approve", cancelText: "Cancel");
        if (confirm == true)
        {
            try
            {
                await MonitoringService.ApproveSiteVisitAsync(Id, "All standards verified and approved.", "AdminUser");
                Snackbar.Add("Workplace monitoring visit approved.", Severity.Success);
                await LoadDataAsync();
            }
            catch (Exception ex)
            {
                Snackbar.Add($"Approval failed: {ex.Message}", Severity.Error);
            }
        }
    }

    private async Task FlagNonComplianceAsync()
    {
        var result = await DialogService.ShowMessageBoxAsync("Flag Non-Compliance", "Are you sure you want to flag statutory non-compliance and move this employer into the remediation holding area?", yesText: "Flag Non-Compliance", cancelText: "Cancel");
        if (result == true)
        {
            try
            {
                await MonitoringService.FlagNonComplianceAsync(Id, "Critical defects identified during on-site inspection.", "AdminUser");
                Snackbar.Add("Non-compliance notice logged.", Severity.Warning);
                await LoadDataAsync();
            }
            catch (Exception ex)
            {
                Snackbar.Add($"Flagging failed: {ex.Message}", Severity.Error);
            }
        }
    }

    private async Task SaveChecklistAsync()
    {
        try
        {
            await MonitoringService.SaveComplianceSurveysAsync(Id, _visit.ComplianceSurveys.ToList(), "AdminUser");
            Snackbar.Add("Checklist responses saved.", Severity.Success);
            await LoadDataAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Failed to save checklist: {ex.Message}", Severity.Error);
        }
    }

    private async Task OpenAddActionPlanDialog()
    {
        var newPlan = new WorkplaceMonitoringActionPlan
        {
            WorkplaceMonitoringSiteVisitId = Id,
            ValidationTypeCode = "DiscretionaryGrant",
            Criteria = "Learner Logbook Maintenance",
            ActionRequired = "Employer must implement weekly supervisor sign-off on all apprentice logbooks.",
            ResponsiblePersonName = _visit.ContactPerson?.FullName ?? "Employer SDF",
            TargetCompletionDate = DateTime.UtcNow.AddDays(30)
        };

        await MonitoringService.AddActionPlanAsync(newPlan, "AdminUser");
        Snackbar.Add("Added corrective action plan.", Severity.Success);
        await LoadDataAsync();
    }

    private async Task ResolveActionPlanAsync(int planId)
    {
        try
        {
            await MonitoringService.ResolveActionPlanAsync(planId, "Evidence submitted and verified on follow-up check.", "AdminUser");
            Snackbar.Add("Action plan marked as completed.", Severity.Success);
            await LoadDataAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Resolution failed: {ex.Message}", Severity.Error);
        }
    }

    private async Task OpenAddMitigationDialog()
    {
        var mitigation = new WorkplaceMonitoringMitigationPlan
