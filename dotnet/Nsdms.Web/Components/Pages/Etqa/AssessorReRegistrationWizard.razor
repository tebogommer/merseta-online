@page "/etqa/assessors/{AssessorId:int}/re-register"
@using Nsdms.Application.Services
@using Nsdms.Domain.Entities
@using Nsdms.Application.Common.Interfaces
@inject IAssessorReRegistrationService ReRegService
@inject IEtqaService EtqaService
@inject IPdfDocumentService PdfService
@inject NavigationManager NavManager
@inject ISnackbar Snackbar
@inject IJSRuntime JsRuntime
@rendermode InteractiveServer

<div class="mb-4">
    <div class="d-flex align-center gap-2 mb-2">
        <MudButton Variant="Variant.Text"
                   StartIcon="@Icons.Material.Filled.ArrowBack"
                   Color="Color.Default"
                   OnClick="GoBack">
            Back to practitioner profile
        </MudButton>
        <MudBreadcrumbs Items="_breadcrumbs" Separator=">" Class="pa-0 ma-0" />
    </div>
</div>

@if (_loading)
{
    <div class="d-flex justify-center align-center py-12">
        <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Large" />
    </div>
}
else if (_renewalStatus == null)
{
    <MudAlert Severity="Severity.Error">Practitioner with ID @AssessorId was not found.</MudAlert>
}
else if (_currentApplication?.ReviewStatusCode == "Approved")
{
    <MudCard Elevation="2" Class="pa-6 rounded-lg text-center">
        <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success" Size="Size.Large" Class="mb-3" />
        <h1 class="text-h5 font-weight-bold text-primary mb-2">Re-registration approved</h1>
        <p class="text-body1 text-secondary mb-4">
            Registration has been extended until @_currentApplication.ProposedNewExpirationDate.ToString("dd MMMM yyyy").
        </p>
        <div class="d-flex justify-center gap-3">
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Download"
                       OnClick="DownloadCertificate">
                Download certificate of registration
            </MudButton>
            <MudButton Variant="Variant.Outlined"
                       Color="Color.Default"
                       OnClick="GoBack">
                Return to practitioner profile
            </MudButton>
        </div>
    </MudCard>
}
else
{
    <WizardShell Title="Assessor and moderator re-registration"
                 Subtitle="Statutory 3-year practitioner renewal under SAQA and QCTO regulations"
                 ActiveStepIndex="@_activeStep"
                 ActiveStepIndexChanged="OnStepChanged"
                 FinishButtonText="Submit application"
                 IsBusy="@_isProcessing"
                 OnCancel="GoBack"
                 OnSaveDraft="SaveDraftAsync"
                 OnFinish="SubmitApplicationAsync">

        <!-- STEP 1: Controlling Choice (Application Type) -->
        <WizardStep Label="Application type"
                    Heading="Select application type"
                    Description="Choose the re-registration category and verify practitioner registration standing"
                    ValidateAsync="ValidateStep1Async">
            
            <AssessorReRegistrationFields Section="ApplicationType"
                                          ApplicationTypeCode="@_applicationTypeCode"
                                          ApplicationTypeCodeChanged="OnApplicationTypeChanged"
                                          RegistrationNumber="@_renewalStatus.RegistrationNumber" />

            <div class="pa-4 rounded-lg mt-4" style="background: var(--surface-subtle); border: 1px solid var(--border);">
                <span class="text-caption text-secondary d-block">Practitioner name</span>
                <span class="text-body1 font-weight-bold text-primary d-block mb-2">@_renewalStatus.PractitionerName</span>

                <span class="text-caption text-secondary d-block">Designation</span>
                <span class="text-body2 text-primary d-block">@_renewalStatus.Designation</span>
            </div>
        </WizardStep>

        <!-- STEP 2: Practice Standing & Experience -->
        <WizardStep Label="Practice standing"
                    Heading="Practice summary and renewal period"
                    Description="Confirm proposed renewal expiration date and document assessment experience"
                    ValidateAsync="ValidateStep2Async">

            <AssessorReRegistrationFields Section="Standing"
                                          CurrentExpirationDateText="@_renewalStatus.RegistrationEndDate.ToString("yyyy-MM-dd")"
                                          ProposedExpirationDateText="@_renewalStatus.RegistrationEndDate.AddYears(3).ToString("yyyy-MM-dd")"
                                          CpdPortfolioSummary="@_cpdPortfolioSummary"
                                          CpdPortfolioSummaryChanged="OnSummaryChanged" />
        </WizardStep>

        <!-- STEP 3: CPD Evidence -->
        <WizardStep Label="CPD evidence"
                    Heading="Continuous professional development portfolio"
                    Description="Record continuous professional development activities towards the 30-point statutory benchmark"
                    ValidateAsync="ValidateStep3Async">

            <div class="pa-4 rounded-lg mb-4" style="background: var(--surface-subtle); border: 1px solid var(--border);">
                <div class="d-flex align-center justify-space-between mb-2">
                    <span class="text-subtitle2 font-weight-bold text-primary">
                        CPD target: 30 points
                    </span>
                    <span class="text-body2 font-weight-bold @(CurrentPoints >= 30 ? "text-success" : "text-warning")">
                        @CurrentPoints / 30 points
                    </span>
                </div>
                <MudProgressLinear Color="@(CurrentPoints >= 30 ? Color.Success : Color.Warning)"
                                   Value="@Math.Min(100, (CurrentPoints * 100) / 30)"
                                   Rounded="true"
                                   Size="Size.Medium" />
            </div>

            <!-- Add CPD Activity -->
            <div class="pa-4 rounded-lg mb-4" style="background: var(--surface); border: 1px solid var(--border);">
                <span class="text-subtitle2 font-weight-bold text-primary d-block mb-3">Add CPD activity</span>
                <AssessorReRegistrationFields Section="Cpd"
                                              NewCpdTitle="@_newCpdTitle"
                                              NewCpdTitleChanged="@((v) => _newCpdTitle = v)"
                                              NewCpdCategory="@_newCpdCategory"
                                              NewCpdCategoryChanged="@((v) => _newCpdCategory = v)"
                                              NewCpdPoints="@_newCpdPoints"
                                              NewCpdPointsChanged="@((v) => _newCpdPoints = v)" />

                <div class="d-flex justify-end mt-2">
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.Add"
                               Disabled="@(string.IsNullOrWhiteSpace(_newCpdTitle) || _isProcessing)"
                               OnClick="AddCpdActivityAsync">
                        Log activity
                    </MudButton>
                </div>
            </div>

            <!-- Logged Activities Table -->
            <MudTable Items="_cpdActivities" Dense="true" Hover="true" Elevation="0" Class="rounded-lg border">
                <HeaderContent>
                    <MudTh>Date</MudTh>
                    <MudTh>Activity title</MudTh>
                    <MudTh>Category</MudTh>
                    <MudTh>Points</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd>@context.ActivityDate.ToString("yyyy-MM-dd")</MudTd>
                    <MudTd Class="font-weight-medium">@context.ActivityTitle</MudTd>
                    <MudTd>
                        <MudChip T="string" Size="Size.Small" Color="Color.Info" Variant="Variant.Outlined">
                            @context.ActivityCategory
                        </MudChip>
                    </MudTd>
                    <MudTd Class="font-weight-bold text-success">@context.PointsApproved</MudTd>
                </RowTemplate>
                <NoRecordsContent>
                    <div class="pa-4 text-center text-muted">
                        No continuous professional development activities logged yet.
                    </div>
                </NoRecordsContent>
            </MudTable>
        </WizardStep>

        <!-- STEP 4: Review & Statutory Declarations -->
        <WizardStep Label="Review and submit"
                    Heading="Review application and statutory declarations"
                    Description="Review all captured information and confirm statutory declarations before submission"
                    ValidateAsync="ValidateStep4Async">

            <WizardReviewStep ReviewGroups="@GetReviewGroups()" OnEditStep="OnNavigateToStep">
                <LifecycleContent>
                    <AssessorReRegistrationFields Section="Declarations"
                                                  ConfirmAllScopes="@_confirmAllScopes"
                                                  ConfirmAllScopesChanged="@((v) => _confirmAllScopes = v)"
                                                  AcceptCodeOfConduct="@_acceptCodeOfConduct"
                                                  AcceptCodeOfConductChanged="@((v) => _acceptCodeOfConduct = v)"
                                                  AcceptPopia="@_acceptPopia"
                                                  AcceptPopiaChanged="@((v) => _acceptPopia = v)" />
                </LifecycleContent>
            </WizardReviewStep>
        </WizardStep>
    </WizardShell>
}

@code {
    [Parameter]
    public int AssessorId { get; set; }

    private bool _loading = true;
    private bool _isProcessing = false;
    private int _activeStep = 0;

    private AssessorRenewalStatusDto? _renewalStatus;
    private AssessorReRegistrationApplication? _currentApplication;

    // Step 1
    private string _applicationTypeCode = "StandardReRegistration";

    // Step 2
    private string _cpdPortfolioSummary = "Active industry assessment experience and compliance with merSETA assessor criteria.";

    // Step 3
    private string _newCpdTitle = string.Empty;
    private string _newCpdCategory = "IndustryPractice";
    private int _newCpdPoints = 5;
    private List<AssessorCpdActivity> _cpdActivities = new();

    // Step 4
    private bool _confirmAllScopes = false;
    private bool _acceptCodeOfConduct = false;
    private bool _acceptPopia = false;

    private List<BreadcrumbItem> _breadcrumbs = new();

    private int CurrentPoints => _cpdActivities.Sum(a => a.PointsApproved);

    protected override async Task OnInitializedAsync()
    {
        _breadcrumbs = new List<BreadcrumbItem>
        {
            new("ETQA registry", "/etqa"),
            new("Practitioner", $"/etqa/assessors/{AssessorId}"),
            new("Re-registration", null, disabled: true)
        };

        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        _loading = true;
        try
        {
            _renewalStatus = await ReRegService.GetAssessorRenewalStatusAsync(AssessorId);
            var apps = await ReRegService.GetApplicationsForAssessorAsync(AssessorId);
            _currentApplication = apps.FirstOrDefault(a => a.ReviewStatusCode != "Rejected");

            if (_currentApplication != null)
            {
                _applicationTypeCode = _currentApplication.ApplicationTypeCode ?? "StandardReRegistration";
                _cpdPortfolioSummary = _currentApplication.CpdPortfolioSummary ?? string.Empty;
                _cpdActivities = _currentApplication.CpdActivities.ToList();
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error loading renewal status: {ex.Message}", Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private void OnStepChanged(int newStep)
    {
        _activeStep = newStep;
    }

    private void OnNavigateToStep(int stepIndex)
    {
        _activeStep = stepIndex;
    }

    private void OnApplicationTypeChanged(string val)
    {
        _applicationTypeCode = val;
    }

    private void OnSummaryChanged(string val)
    {
        _cpdPortfolioSummary = val;
    }

    private Task<bool> ValidateStep1Async()
    {
        if (string.IsNullOrWhiteSpace(_applicationTypeCode))
        {
            Snackbar.Add("Please select an application type.", Severity.Warning);
            return Task.FromResult(false);
        }
        return Task.FromResult(true);
    }

    private async Task<bool> ValidateStep2Async()
    {
        if (string.IsNullOrWhiteSpace(_cpdPortfolioSummary))
        {
            Snackbar.Add("Practice summary is required.", Severity.Warning);
            return false;
        }

        if (_currentApplication == null)
        {
            await EnsureApplicationCreatedAsync();
        }
        else
        {
            await ReRegService.UpdateDraftApplicationAsync(_currentApplication.Id, _cpdPortfolioSummary);
        }

        return true;
    }

    private Task<bool> ValidateStep3Async()
    {
        if (_cpdActivities.Count == 0)
        {
            Snackbar.Add("Please log at least one continuous professional development activity.", Severity.Warning);
            return Task.FromResult(false);
        }
        return Task.FromResult(true);
    }

    private Task<bool> ValidateStep4Async()
    {
        if (!_confirmAllScopes || !_acceptCodeOfConduct || !_acceptPopia)
        {
            Snackbar.Add("All statutory declarations must be confirmed before submitting.", Severity.Warning);
            return Task.FromResult(false);
        }
        return Task.FromResult(true);
    }

    private async Task EnsureApplicationCreatedAsync()
    {
        if (_currentApplication != null) return;

        _isProcessing = true;
        try
        {
            _currentApplication = await ReRegService.InitiateReRegistrationApplicationAsync(new InitiateReRegistrationRequest
            {
                EtqaAssessorId = AssessorId,
                ApplicationTypeCode = _applicationTypeCode,
                CpdPortfolioSummary = _cpdPortfolioSummary
            });
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error initiating application: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isProcessing = false;
        }
    }

    private async Task AddCpdActivityAsync()
    {
        if (string.IsNullOrWhiteSpace(_newCpdTitle)) return;

        await EnsureApplicationCreatedAsync();
        if (_currentApplication == null) return;

        _isProcessing = true;
        try
        {
            var activity = await ReRegService.LogCpdActivityAsync(new LogCpdActivityRequest
            {
                ApplicationId = _currentApplication.Id,
                ActivityTitle = _newCpdTitle,
                ActivityCategory = _newCpdCategory,
                PointsClaimed = _newCpdPoints
            });

            _cpdActivities.Add(activity);
            _newCpdTitle = string.Empty;
            Snackbar.Add($"Logged {activity.PointsApproved} CPD points.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error adding CPD activity: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isProcessing = false;
        }
    }

    private async Task SaveDraftAsync()
    {
        await EnsureApplicationCreatedAsync();
        if (_currentApplication == null) return;

        _isProcessing = true;
        try
        {
            await ReRegService.UpdateDraftApplicationAsync(_currentApplication.Id, _cpdPortfolioSummary);
            Snackbar.Add("Draft saved successfully.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error saving draft: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isProcessing = false;
        }
    }

    private async Task SubmitApplicationAsync()
    {
        await EnsureApplicationCreatedAsync();
        if (_currentApplication == null) return;

        _isProcessing = true;
        try
        {
            await ReRegService.SubmitApplicationForReviewAsync(_currentApplication.Id);
            Snackbar.Add("Re-registration application submitted for committee review.", Severity.Success);
            NavManager.NavigateTo($"/etqa/assessors/{AssessorId}");
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error submitting application: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isProcessing = false;
        }
    }

    private List<WizardReviewGroup> GetReviewGroups()
    {
        return new List<WizardReviewGroup>
        {
            new()
            {
                Title = "Application type",
                Icon = Icons.Material.Filled.Assignment,
                TargetStepIndex = 0,
                Items = new()
                {
                    new("Type", _applicationTypeCode == "StandardReRegistration" ? "Standard 3-year re-registration" : "Scope extension and renewal"),
                    new("Registration number", _renewalStatus?.RegistrationNumber, isMonospace: true)
                }
            },
            new()
            {
                Title = "Practice standing",
                Icon = Icons.Material.Filled.Badge,
                TargetStepIndex = 1,
                Items = new()
                {
                    new("Current expiry", _renewalStatus?.RegistrationEndDate.ToString("yyyy-MM-dd")),
                    new("Proposed new expiry", _renewalStatus?.RegistrationEndDate.AddYears(3).ToString("yyyy-MM-dd")),
                    new("Practice summary", _cpdPortfolioSummary)
                }
            },
            new()
            {
                Title = "CPD evidence",
                Icon = Icons.Material.Filled.TrendingUp,
                TargetStepIndex = 2,
                Items = new()
                {
                    new("Points accumulated", $"{CurrentPoints} / 30 points"),
                    new("Activities logged", $"{_cpdActivities.Count} activities")
                }
            }
        };
    }

    private async Task DownloadCertificate()
    {
        try
        {
            var assessor = await EtqaService.GetAssessorByIdAsync(AssessorId);
            if (assessor == null)
            {
                Snackbar.Add("Assessor not found.", Severity.Error);
                return;
            }
            var bytes = await PdfService.GenerateAssessorRegistrationCertificatePdfAsync(assessor);
            var base64 = Convert.ToBase64String(bytes);
            await JsRuntime.InvokeVoidAsync("downloadFileFromBytes", $"Certificate_Assessor_{assessor.RegistrationNumber}.pdf", "application/pdf", base64);
            Snackbar.Add("Certificate of Registration generated successfully.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error generating certificate: {ex.Message}", Severity.Error);
        }
    }

    private void GoBack()
    {
        NavManager.NavigateTo($"/etqa/assessors/{AssessorId}");
    }
}
