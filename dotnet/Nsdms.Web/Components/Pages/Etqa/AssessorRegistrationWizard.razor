    }

    private void OnEditStepRequested(int targetStep)
    {
        _activeStep = targetStep;
    }

    private async Task SubmitApplicationAsync()
    {
        _isProcessing = true;
        try
        {
            await EnsureDraftApplicationAsync();

            var submitted = await RegService.SignOffAndSubmitAsync(ApplicationId, "SYSTEM");
            _registeredApplicationNumber = submitted.ApplicationNumber;
            _isSuccess = true;
            Snackbar.Add($"Application {_registeredApplicationNumber} successfully submitted!", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Submission failed: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isProcessing = false;
        }
    }

