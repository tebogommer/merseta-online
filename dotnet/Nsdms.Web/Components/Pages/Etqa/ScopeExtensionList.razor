@page "/etqa/scope-extensions"
@using Nsdms.Application.Common.Interfaces
@using Nsdms.Domain.Entities
@inject IExtensionOfScopeService ScopeService
@inject NavigationManager Nav
@inject ISnackbar Snackbar

<PageTitle>Accreditation Scope Extensions | merSETA NSDMS</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="my-4">
    <!-- Top Bar -->
    <MudCard Elevation="2" Class="mb-4">
        <MudCardContent Class="d-flex align-center justify-space-between py-3">
            <div>
                <MudBreadcrumbs Items="_breadcrumbs" Class="pa-0 mb-1" />
                <MudText Typo="Typo.h5" Class="fw-bold">Provider &amp; Assessor Scope Extensions</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">
                    Skills Development Provider additional qualification applications, site evaluation audits, and committee endorsement.
                </MudText>
            </div>
            <MudStack Row="true" Spacing="2">
                <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Refresh" OnClick="LoadDataAsync">
                    Refresh
                </MudButton>
            </MudStack>
        </MudCardContent>
    </MudCard>

    @if (_isLoading)
    {
        <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="mb-4" />
    }

    <!-- Table -->
    <MudCard Elevation="2">
        <MudCardContent>
            <MudTable Items="_extensions" Hover="true" Dense="true" Elevation="0" Filter="FilterExtensions">
                <ToolBarContent>
                    <MudText Typo="Typo.h6">Scope Extension Applications (@_extensions.Count)</MudText>
                    <MudSpacer />
                    <MudTextField @bind-Value="_searchString" Placeholder="Search by application #, qualification, provider..." Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Medium" Class="mt-0" Immediate="true" />
                </ToolBarContent>
                <HeaderContent>
                    <MudTh>App #</MudTh>
                    <MudTh>Provider Name</MudTh>
                    <MudTh>Additional Qualification</MudTh>
                    <MudTh>NQF Level</MudTh>
                    <MudTh>Credits</MudTh>
                    <MudTh>Site Inspection</MudTh>
                    <MudTh>Status</MudTh>
                    <MudTh Style="text-align: right;">Action</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="App #" Class="font-monospace fw-bold">@context.ApplicationNumber</MudTd>
                    <MudTd DataLabel="Provider Name">@(context.TrainingProvider?.ProviderName ?? "Accredited SDP")</MudTd>
                    <MudTd DataLabel="Additional Qualification">@context.AdditionalQualificationTitle</MudTd>
                    <MudTd DataLabel="NQF Level">Level @context.NqfLevel</MudTd>
                    <MudTd DataLabel="Credits">@context.Credits</MudTd>
                    <MudTd DataLabel="Site Inspection">
                        <MudChip T="string" Size="Size.Small" Color="@(context.SiteInspectionPassed ? Color.Success : Color.Warning)" Variant="Variant.Outlined">
                            @(context.SiteInspectionPassed ? "Passed" : "Pending Inspection")
                        </MudChip>
                    </MudTd>
                    <MudTd DataLabel="Status">
                        <MudChip T="string" Size="Size.Small" Color="@GetStatusColor(context.StatusCode)" Variant="Variant.Filled">
                            @context.StatusCode
                        </MudChip>
                    </MudTd>
                    <MudTd DataLabel="Action" Style="text-align: right;">
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" StartIcon="@Icons.Material.Filled.FactCheck" OnClick="@(() => Nav.NavigateTo($"/etqa/scope-extensions/{context.Id}"))">
                            Evaluate Scope
                        </MudButton>
                    </MudTd>
                </RowTemplate>
                <PagerContent>
                    <MudTablePager />
                </PagerContent>
            </MudTable>
        </MudCardContent>
    </MudCard>
</MudContainer>

@code {
    private List<BreadcrumbItem> _breadcrumbs = new()
    {
        new BreadcrumbItem("Home", href: "/"),
        new BreadcrumbItem("Quality Assurance", href: "/etqa"),
        new BreadcrumbItem("Scope Extensions", href: null, disabled: true)
    };

    private List<SdpExtensionOfScope> _extensions = new();
    private bool _isLoading = true;
    private string _searchString = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        _isLoading = true;
        try
        {
            _extensions = await ScopeService.GetSdpScopeExtensionsAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Failed to load scope extensions: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isLoading = false;
        }
    }

    private bool FilterExtensions(SdpExtensionOfScope s)
    {
        if (string.IsNullOrWhiteSpace(_searchString)) return true;
        return s.ApplicationNumber.Contains(_searchString, StringComparison.OrdinalIgnoreCase) ||
               s.AdditionalQualificationTitle.Contains(_searchString, StringComparison.OrdinalIgnoreCase) ||
               (s.TrainingProvider != null && s.TrainingProvider.ProviderName.Contains(_searchString, StringComparison.OrdinalIgnoreCase));
    }

    private Color GetStatusColor(string status) => status switch
    {
        "Approved" => Color.Success,
        "CommitteeReview" => Color.Info,
        "Submitted" => Color.Warning,
        "Rejected" => Color.Error,
        _ => Color.Default
    };
}
