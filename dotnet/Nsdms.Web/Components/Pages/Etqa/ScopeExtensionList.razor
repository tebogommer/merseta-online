@page "/etqa/scope-extensions"
@using Nsdms.Application.Common.Interfaces
@using Nsdms.Domain.Entities
@inject IExtensionOfScopeService ScopeService
@inject NavigationManager Nav
@inject ISnackbar Snackbar
@inject IJSRuntime JS
@rendermode InteractiveServer

<PageTitle>Accreditation Scope Extensions | merSETA NSDMS</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="my-4">
    <!-- Top Bar -->
    <MudCard Elevation="2" Class="mb-4">
        <MudCardContent Class="d-flex flex-wrap align-center justify-space-between gap-3 py-3">
            <div>
                <MudBreadcrumbs Items="_breadcrumbs" Class="pa-0 mb-1" />
                <MudText Typo="Typo.h5" Class="fw-bold">Provider &amp; Assessor Scope Extensions</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">
                    Skills Development Provider additional qualification applications, site evaluation audits, and committee endorsement.
                </MudText>
            </div>
            <MudStack Row="true" Spacing="2" Class="align-center">
                <MudButton Variant="Variant.Outlined" Color="Color.Default" StartIcon="@Icons.Material.Filled.FileDownload" OnClick="ExportCsvAsync">
                    Export CSV
                </MudButton>

                <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Refresh" OnClick="LoadDataAsync">
                    Refresh
                </MudButton>

                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.AddCircle" OnClick="@(() => Nav.NavigateTo("/sdp"))">
                    Apply for Scope
                </MudButton>
            </MudStack>
        </MudCardContent>
    </MudCard>

    <!-- Quick Status Filter Chips -->
    <MudPaper Elevation="0" Class="d-flex flex-wrap align-center gap-2 mb-3 px-1 py-1">
        <MudChip T="string" Color="@(_statusFilter == null ? Color.Primary : Color.Default)" Variant="@(_statusFilter == null ? Variant.Filled : Variant.Outlined)" OnClick="@(() => _statusFilter = null)">
            All (@_extensions.Count)
        </MudChip>
        <MudChip T="string" Color="Color.Success" Variant="@(_statusFilter == "Approved" ? Variant.Filled : Variant.Outlined)" OnClick="@(() => _statusFilter = "Approved")">
            Approved (@_extensions.Count(e => e.StatusCode == "Approved"))
        </MudChip>
        <MudChip T="string" Color="Color.Info" Variant="@(_statusFilter == "CommitteeReview" ? Variant.Filled : Variant.Outlined)" OnClick="@(() => _statusFilter = "CommitteeReview")">
            Committee Review (@_extensions.Count(e => e.StatusCode == "CommitteeReview"))
        </MudChip>
        <MudChip T="string" Color="Color.Warning" Variant="@(_statusFilter == "Submitted" ? Variant.Filled : Variant.Outlined)" OnClick="@(() => _statusFilter = "Submitted")">
            Submitted (@_extensions.Count(e => e.StatusCode == "Submitted"))
        </MudChip>
    </MudPaper>

    @if (_isLoading)
    {
        <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="mb-4" />
    }

    <!-- Table -->
    <MudCard Elevation="2">
        <MudCardContent>
            <MudTable Items="_filteredExtensions" Hover="true" Dense="true" Elevation="0">
                <ToolBarContent>
                    <MudText Typo="Typo.h6">Scope Extension Applications (@_filteredExtensions.Count)</MudText>
                    <MudSpacer />
                    <MudTextField @bind-Value="_searchString" Placeholder="Search by application #, qualification, provider..." Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Medium" Class="mt-0" Immediate="true" />
                </ToolBarContent>
                <HeaderContent>
                    <MudTh>App #</MudTh>
                    <MudTh>Provider Name</MudTh>
                    <MudTh>Additional Qualification</MudTh>
                    <MudTh>NQF Level</MudTh>
                    <MudTh>Credits</MudTh>
                    <MudTh>Site Inspection</MudTh>
                    <MudTh>Status</MudTh>
                    <MudTh Style="text-align: right;">Actions</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="App #" Class="font-monospace fw-bold">
                        <MudLink Href="@($"/etqa/scope-extensions/{context.Id}")" Color="Color.Primary" Underline="Underline.Hover">
                            @context.ApplicationNumber
                        </MudLink>
                    </MudTd>
                    <MudTd DataLabel="Provider Name">
                        @if (context.TrainingProviderId > 0)
                        {
                            <MudLink Href="@($"/sdp/{context.TrainingProviderId}")" Color="Color.Inherit" Underline="Underline.Hover">
                                @(context.TrainingProvider?.ProviderName ?? "Accredited SDP")
                            </MudLink>
                        }
                        else
                        {
                            <span>@(context.TrainingProvider?.ProviderName ?? "Accredited SDP")</span>
                        }
                    </MudTd>
                    <MudTd DataLabel="Additional Qualification">@context.AdditionalQualificationTitle</MudTd>
                    <MudTd DataLabel="NQF Level">Level @context.NqfLevel</MudTd>
                    <MudTd DataLabel="Credits">@context.Credits</MudTd>
                    <MudTd DataLabel="Site Inspection">
                        <MudChip T="string" Size="Size.Small" Color="@(context.SiteInspectionPassed ? Color.Success : Color.Warning)" Variant="Variant.Outlined">
                            @(context.SiteInspectionPassed ? "Passed" : "Pending Inspection")
                        </MudChip>
                    </MudTd>
                    <MudTd DataLabel="Status">
                        <MudChip T="string" Size="Size.Small" Color="@GetStatusColor(context.StatusCode)" Variant="Variant.Filled">
                            @context.StatusCode
                        </MudChip>
                    </MudTd>
                    <MudTd DataLabel="Actions" Style="text-align: right;">
                        <MudButtonGroup Size="Size.Small" Variant="Variant.Outlined">
                            <MudIconButton Icon="@Icons.Material.Filled.Visibility"
                                           Color="Color.Primary"
                                           Size="Size.Small"
                                           OnClick="@(() => Nav.NavigateTo($"/etqa/scope-extensions/{context.Id}"))"
                                           aria-label="Evaluate Scope"
                                           Title="Evaluate Scope Application" />

                            <MudIconButton Icon="@Icons.Material.Filled.Download"
                                           Color="Color.Secondary"
                                           Size="Size.Small"
                                           OnClick="@(() => DownloadScopeSchedulePdf(context.Id))"
                                           aria-label="Download Scope Schedule"
                                           Title="Download Scope Schedule" />
                        </MudButtonGroup>
                    </MudTd>
                </RowTemplate>
                <PagerContent>
                    <MudTablePager />
                </PagerContent>
            </MudTable>
        </MudCardContent>
    </MudCard>
</MudContainer>

@code {
    private List<BreadcrumbItem> _breadcrumbs = new()
    {
        new BreadcrumbItem("Home", href: "/"),
        new BreadcrumbItem("Quality Assurance", href: "/etqa"),
        new BreadcrumbItem("Scope Extensions", href: null, disabled: true)
    };

    private List<SdpExtensionOfScope> _extensions = new();
    private bool _isLoading = true;
    private string _searchString = string.Empty;
    private string? _statusFilter = null;

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        _isLoading = true;
        try
        {
            _extensions = await ScopeService.GetSdpScopeExtensionsAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Failed to load scope extensions: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isLoading = false;
        }
    }

    private List<SdpExtensionOfScope> _filteredExtensions => _extensions.Where(s =>
    {
        if (!string.IsNullOrEmpty(_statusFilter) && !string.Equals(s.StatusCode, _statusFilter, StringComparison.OrdinalIgnoreCase))
            return false;

        if (string.IsNullOrWhiteSpace(_searchString)) return true;
        return s.ApplicationNumber.Contains(_searchString, StringComparison.OrdinalIgnoreCase) ||
               s.AdditionalQualificationTitle.Contains(_searchString, StringComparison.OrdinalIgnoreCase) ||
               (s.TrainingProvider != null && s.TrainingProvider.ProviderName.Contains(_searchString, StringComparison.OrdinalIgnoreCase)) ||
               s.StatusCode.Contains(_searchString, StringComparison.OrdinalIgnoreCase);
    }).ToList();

    private void DownloadScopeSchedulePdf(int id)
    {
        Snackbar.Add($"Generating Scope Schedule Document for application #{id}...", Severity.Info);
        Nav.NavigateTo($"/api/documents/tradetest/{id}/pdf", forceLoad: true);
    }

    private async Task ExportCsvAsync()
    {
        var csv = new System.Text.StringBuilder();
        csv.AppendLine("ApplicationNumber,ProviderName,QualificationTitle,NqfLevel,Credits,SiteInspectionPassed,Status");
        foreach (var item in _filteredExtensions)
        {
            csv.AppendLine($"\"{item.ApplicationNumber}\",\"{item.TrainingProvider?.ProviderName}\",\"{item.AdditionalQualificationTitle}\",{item.NqfLevel},{item.Credits},{item.SiteInspectionPassed},\"{item.StatusCode}\"");
        }

        var bytes = System.Text.Encoding.UTF8.GetBytes(csv.ToString());
        var base64 = Convert.ToBase64String(bytes);
        await JS.InvokeVoidAsync("nsdmsDownloadFile", $"ScopeExtensions_{DateTime.UtcNow:yyyyMMdd}.csv", base64, "text/csv");
        Snackbar.Add("Scope extensions exported to CSV successfully.", Severity.Success);
    }

    private Color GetStatusColor(string status) => status switch
    {
        "Approved" => Color.Success,
        "CommitteeReview" => Color.Info,
        "Submitted" => Color.Warning,
        "Rejected" => Color.Error,
        _ => Color.Default
    };
}
