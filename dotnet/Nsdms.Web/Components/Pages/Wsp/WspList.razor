@page "/wsp"
@using Nsdms.Application.Common.Models
@using Nsdms.Application.Services
@using Nsdms.Domain.Entities
@using Nsdms.Web.Components.Shared
@using MudBlazor
@inject IWspService WspService
@inject NavigationManager NavManager
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@rendermode InteractiveServer

@*
  UI-STANDARD.md Archetype: A1 / T1 (Transactional List - WSP & Mandatory Grants)
  Clauses: 4.2, 4.3, 6.1, 7.2, 8.1, 8.3, 11.1–11.9, 15.2.5
*@

<EntityHeader Title="WSP &amp; Mandatory Grants"
              Subtitle="Annual Workplace Skills Plans (WSP), Annual Training Reports (ATR), and mandatory levy grant claims"
              ReferenceKey="T1-WSP"
              Status="Active"
              BreadcrumbItems="@_breadcrumbs">
    <ActionZone>
        <MudButton Variant="Variant.Outlined"
                   Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.DateRange"
                   OnClick="OpenWindowSettingsDialogAsync"
                   aria-label="Configure Mandatory Grant Submission Window Dates and Times">
            Window Settings
        </MudButton>
        <MudButton Variant="Variant.Outlined"
                   Color="Color.Warning"
                   StartIcon="@Icons.Material.Filled.AssignmentLate"
                   OnClick="@(() => NavManager.NavigateTo("/admin/wsp-extensions"))"
                   aria-label="Review Statutory Deadline Extensions">
            Review Extensions
        </MudButton>
        <MudButton Variant="Variant.Outlined"
                   Color="Color.Secondary"
                   StartIcon="@Icons.Material.Filled.EventBusy"
                   OnClick="@(() => NavManager.NavigateTo("/wsp/extension-request"))"
                   aria-label="Request Statutory Deadline Extension">
            Request Deadline Extension
        </MudButton>
        <MudButton Variant="Variant.Outlined"
                   Color="Color.Info"
                   StartIcon="@Icons.Material.Filled.Groups"
                   OnClick="@(() => NavManager.NavigateTo("/wsp/committees"))"
                   aria-label="View Consultative Training Committees">
            Training Committees
        </MudButton>
        <MudButton Variant="Variant.Filled" 
                   Color="Color.Primary" 
                   StartIcon="@Icons.Material.Filled.PostAdd" 
                   OnClick="CreateNewWsp"
                   aria-label="Initiate New WSP Submission">
            New WSP Submission
        </MudButton>
    </ActionZone>
</EntityHeader>

<!-- Filter Bar (Clause 11.4) -->
<FilterBar SearchPlaceholder="Search by Reference No, Organisation Name, SDL No, Fin Year..."
           @bind-SearchText="_searchString"
           OnSearch="HandleFilterChanged"
           OnClear="HandleFilterCleared">
    <FilterContent>
        <div class="d-flex flex-column gap-1">
            <MudText Typo="Typo.caption" Color="Color.Secondary">Status</MudText>
            <MudToggleGroup T="string"
                            Value="_statusFilter"
                            ValueChanged="HandleStatusToggleChanged"
                            SelectionMode="SelectionMode.SingleSelection"
                            Color="Color.Primary"
                            Variant="Variant.Outlined"
                            Dense="true"
                            Size="Size.Small"
                            aria-label="Filter WSP submissions by status">
                <MudToggleItem Value="@("All")" Text="All" />
                <MudToggleItem Value="@("DRAFT")" Text="Draft" />
                <MudToggleItem Value="@("SUBMITTED")" Text="Submitted" />
                <MudToggleItem Value="@("APPROVED")" Text="Approved" />
                <MudToggleItem Value="@("REJECTED")" Text="Rejected" />
            </MudToggleGroup>
        </div>
    </FilterContent>
    <ActiveFilterChips>
        @if (!string.IsNullOrWhiteSpace(_searchString))
        {
            <MudChip T="string" Size="Size.Small" OnClose="@(async () => { _searchString = string.Empty; await HandleFilterChanged(); })">
                Keyword: @_searchString
            </MudChip>
        }
        @if (_statusFilter != "All")
        {
            <MudChip T="string" Size="Size.Small" Color="Color.Primary" OnClose="@(async () => { _statusFilter = "All"; await HandleFilterChanged(); })">
                Status: @_statusFilter
            </MudChip>
        }
    </ActiveFilterChips>
</FilterBar>

<!-- Data Grid Shell (Clause 11.9) -->
<DataGridShell TItem="WspSubmission"
               GridKey="WspSubmissionsGrid"
               Items="@_currentPagedItems"
               IsLoading="false"
               TotalItemsCount="@_totalCount"
               SelectedItems="@_selectedSubmissions"
               SelectedItemsChanged="OnSelectedSubmissionsChanged"
               EmptyTitle="No WSP Submissions Found"
               EmptyMessage="No Workplace Skills Plan submissions match your search or filter criteria. Submit a new WSP to initiate the mandatory grant process."
               EmptyActionLabel="Capture New WSP"
               OnEmptyAction="CreateNewWsp">
    <BulkActionBarContent>
        <MudText Typo="Typo.body2" Class="fw-bold text-white">
            @_selectedSubmissions.Count WSP submission(s) selected
        </MudText>
        <MudButton Variant="Variant.Filled" 
                   Color="Color.Surface" 
                   Size="Size.Small" 
                   StartIcon="@Icons.Material.Filled.FileDownload"
                   OnClick="ExportSelected">
            Export Selected
        </MudButton>
    </BulkActionBarContent>
    <ChildContent>
        <MudTable @ref="_table"
                  T="WspSubmission"
                  ServerData="ServerReload"
                  Hover="true"
                  Dense="true"
                  Elevation="0"
                  MultiSelection="true"
                  @bind-SelectedItems="_selectedSubmissions"
                  Breakpoint="Breakpoint.Sm"
                  Class="border-default">
            <HeaderContent>
                <MudTh>Reference No</MudTh>
                <MudTh>Fin Year</MudTh>
                <MudTh>Organisation / SDL</MudTh>
                <MudTh>Employees</MudTh>
                <MudTh>Planned Training Budget</MudTh>
                <MudTh Class="d-none d-md-table-cell">Submission Date</MudTh>
                <MudTh>Status</MudTh>
                <MudTh Style="text-align:right">Actions</MudTh>
            </HeaderContent>
            <RowTemplate>
                <!-- Key column is real hyperlink (Clause 11.1) -->
                <MudTd DataLabel="Reference No">
                    <a href="/wsp/@context.Id" class="d-flex align-center gap-1 font-monospace fw-bold text-primary text-decoration-none">
                        <MudIcon Icon="@Icons.Material.Filled.Assignment" Size="Size.Small" />
                        <span>@(string.IsNullOrWhiteSpace(context.ReferenceNumber) ? $"WSP-{context.Id}" : context.ReferenceNumber)</span>
                    </a>
                </MudTd>
                <MudTd DataLabel="Fin Year">
                    <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Outlined">@context.FinYear</MudChip>
                </MudTd>
                <MudTd DataLabel="Organisation / SDL">
                    <MudText Typo="Typo.body2" Class="fw-bold">@(context.Organisation?.CompanyName ?? "Unlinked")</MudText>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">SDL: @(context.Organisation?.SdlNumber ?? "—")</MudText>
                </MudTd>
                <MudTd DataLabel="Employees">
                    <MudText Typo="Typo.body2">@context.EmployeeCount.ToString("N0")</MudText>
                </MudTd>
                <MudTd DataLabel="Planned Training Budget">
                    <MudText Typo="Typo.body2" Class="fw-bold text-success">@context.PlannedTrainingBudget.ToString("C")</MudText>
                </MudTd>
                <MudTd Class="d-none d-md-table-cell" DataLabel="Submission Date">
                    @(context.SubmissionDate.HasValue ? context.SubmissionDate.Value.ToString("yyyy-MM-dd") : "Not submitted")
                </MudTd>
                <MudTd DataLabel="Status">
                    <!-- Non-clickable status pill (Clause 6.1, 7.2) -->
                    <StatusBadge Status="@(!string.IsNullOrWhiteSpace(context.StatusCode) ? context.StatusCode : "DRAFT")" Size="Size.Small" />
                </MudTd>
                <MudTd Style="text-align:right" DataLabel="Actions">
                    <div class="d-flex justify-end gap-1">
                        <MudTooltip Text="View Submission">
                            <MudIconButton Icon="@Icons.Material.Filled.Visibility" 
                                           Color="Color.Primary" 
                                           Size="Size.Small" 
                                           OnClick="@(() => OpenDetail(context.Id))" 
                                           aria-label="View Submission" />
                        </MudTooltip>
                        <MudTooltip Text="Edit Submission">
                            <MudIconButton Icon="@Icons.Material.Filled.Edit" 
                                           Color="Color.Secondary" 
                                           Size="Size.Small" 
                                           OnClick="@(() => OpenEdit(context.Id))" 
                                           aria-label="Edit Submission" />
                        </MudTooltip>
                        <MudTooltip Text="Delete Record">
                            <MudIconButton Icon="@Icons.Material.Filled.Delete" 
                                           Color="Color.Error" 
                                           Size="Size.Small" 
                                           OnClick="@(() => DeleteWsp(context.Id, context.ReferenceNumber))" 
                                           aria-label="Delete Record" />
                        </MudTooltip>
                    </div>
                </MudTd>
            </RowTemplate>
            <PagerContent>
                <!-- Fixed page size ladder (Clause 11.3.3) -->
                <MudTablePager PageSizeOptions="new int[] { 5, 10, 20, 50, 100, 250, 500 }" />
            </PagerContent>
        </MudTable>
    </ChildContent>
</DataGridShell>

@code {
    private MudTable<WspSubmission>? _table;
    private IReadOnlyCollection<WspSubmission> _currentPagedItems = Array.Empty<WspSubmission>();
    private int _totalCount = 0;
    private HashSet<WspSubmission> _selectedSubmissions = new();
    private string _searchString = string.Empty;
    private string _statusFilter = "All";

    private List<BreadcrumbItem> _breadcrumbs = new()
    {
        new BreadcrumbItem("Home", href: "/"),
        new BreadcrumbItem("Grants & WSP", href: null, disabled: true),
        new BreadcrumbItem("WSP Submissions", href: "/wsp")
    };

    private async Task<TableData<WspSubmission>> ServerReload(TableState state, CancellationToken ct)
    {
        var query = new PaginationQuery
        {
            PageIndex = state.Page,
            PageSize = state.PageSize,
            SearchText = _searchString,
            SortBy = state.SortLabel,
            SortDescending = state.SortDirection == SortDirection.Descending
        };

        if (!string.IsNullOrWhiteSpace(_statusFilter) && _statusFilter != "All")
        {
            query.FilterParams["status"] = _statusFilter;
        }

        var result = await WspService.GetPagedSubmissionsAsync(query, ct);
        _currentPagedItems = result.Items;
        _totalCount = result.TotalCount;

        return new TableData<WspSubmission>
        {
            TotalItems = result.TotalCount,
            Items = result.Items
        };
    }

    private async Task HandleStatusToggleChanged(string? val)
    {
        _statusFilter = string.IsNullOrEmpty(val) ? "All" : val;
        await HandleFilterChanged();
    }

    private async Task HandleFilterChanged()
    {
        if (_table != null)
        {
            await _table.ReloadServerData();
        }
    }

    private async Task HandleFilterCleared()
    {
        _searchString = string.Empty;
        _statusFilter = "All";
        if (_table != null)
        {
            await _table.ReloadServerData();
        }
    }

    private void OnSelectedSubmissionsChanged(HashSet<WspSubmission> selected)
    {
        _selectedSubmissions = selected;
    }

    private void OpenDetail(int id)
    {
        NavManager.NavigateTo($"/wsp/{id}");
    }

    private void OpenEdit(int id)
    {
        NavManager.NavigateTo($"/wsp/{id}/edit");
    }

    private void CreateNewWsp()
    {
        NavManager.NavigateTo("/wsp/create");
    }

    private void ExportSelected()
    {
        Snackbar.Add($"Exporting {_selectedSubmissions.Count} WSP submissions to CSV...", Severity.Info);
    }

    private async Task DeleteWsp(int id, string refNo)
    {
        bool? confirmed = await DialogService.ShowMessageBoxAsync(
            "Delete WSP Submission?",
            $"Are you sure you wish to delete WSP submission '{refNo}'? This action will perform an audit-tracked soft delete.",
            yesText: "Delete Submission",
            cancelText: "Cancel"
        );

        if (confirmed == true)
        {
            var deleted = await WspService.DeleteAsync(id, "Admin");
            if (deleted)
            {
                Snackbar.Add($"WSP submission '{refNo}' deleted successfully with audit confirmation.", Severity.Success);
                if (_table != null)
                {
                    await _table.ReloadServerData();
                }
            }
            else
            {
                Snackbar.Add("Could not delete the WSP submission.", Severity.Error);
            }
        }
    }

    private async Task OpenWindowSettingsDialogAsync()
    {
        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Medium, FullWidth = true };
        var dialog = await DialogService.ShowAsync<ConfigureMgWindowDialog>("Mandatory Grant (MG) Window Schedule", options);
        var result = await dialog.Result;
        if (!result.Canceled && _table != null)
        {
            await _table.ReloadServerData();
        }
    }
}
