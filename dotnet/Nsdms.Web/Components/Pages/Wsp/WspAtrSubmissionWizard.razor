@page "/wsp/submit"
@page "/wsp/create"
@using Nsdms.Application.Services
@using Nsdms.Domain.Entities
@using Nsdms.Web.Components.Shared
@using Nsdms.Web.Components.Shared.Forms
@using Nsdms.Web.Components.Shared.Wizard
@using MudBlazor
@using System.Security.Cryptography
@using System.Text
@inject IWspService WspService
@inject IOrganisationService OrgService
@inject NavigationManager NavManager
@inject ISnackbar Snackbar
@inject IWizardDraftService DraftService
@rendermode InteractiveServer

<div class="mb-4">
    <div class="d-flex align-center gap-2 mb-2">
        <MudButton Variant="Variant.Text"
                   StartIcon="@Icons.Material.Filled.ArrowBack"
                   Color="Color.Default"
                   OnClick="GoBack">
            Back to WSP Submissions
        </MudButton>
        <MudBreadcrumbs Items="_breadcrumbs" Separator=">" Class="pa-0 ma-0" />
    </div>
</div>

@if (_loading)
{
    <div class="d-flex justify-center align-center py-12">
        <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Large" />
    </div>
}
else if (_isSuccess)
{
    <MudCard Elevation="2" Class="pa-6 rounded-lg text-center">
        <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success" Size="Size.Large" Class="mb-3" />
        <h1 class="text-h5 font-weight-bold text-primary mb-2">Mandatory Grant WSP/ATR submission received</h1>
        <p class="text-body1 text-secondary mb-4">
            Annual Workplace Skills Plan and Annual Training Report reference <strong class="font-mono">@_submittedAppNumber</strong> has been successfully lodged. Sign-off OTP notifications have been dispatched to constitutional signatories.
        </p>
        <div class="d-flex justify-center gap-3">
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.ReceiptLong"
                       OnClick="ViewSubmittedWsp">
                View WSP submission
            </MudButton>
            <MudButton Variant="Variant.Outlined"
                       Color="Color.Default"
                       OnClick="GoBack">
                Return to WSP register
            </MudButton>
        </div>
    </MudCard>
}
else
{
    @if (!_isWindowOpen)
    {
        <MudAlert Severity="Severity.Error" Variant="Variant.Filled" Class="mb-4 rounded-lg">
            <div class="d-flex flex-column flex-md-row justify-space-between align-md-center gap-3">
                <div>
                    <MudText Typo="Typo.subtitle1" Class="fw-bold">Mandatory Grant (WSP/ATR) Submission Window Closed</MudText>
                    <MudText Typo="Typo.body2">
                        The statutory submission deadline for Scheme Year @_finYear closed on @_effectiveDeadline.ToString("dd MMMM yyyy HH:mm UTC"). Further submissions cannot be accepted without an approved extension.
                    </MudText>
                </div>
                <MudButton Variant="Variant.Outlined"
                           Color="Color.Surface"
                           StartIcon="@Icons.Material.Filled.EventBusy"
                           OnClick="@(() => NavManager.NavigateTo("/wsp/extension-request"))">
                    Request Deadline Extension
                </MudButton>
            </div>
        </MudAlert>
    }

    <WizardShell Title="Mandatory Grant WSP / ATR annual submission"
                 Subtitle="Statutory Workplace Skills Plan, Annual Training Report, and 20% Mandatory Grant levy rebate claim"
                 ActiveStepIndex="@_activeStep"
                 ActiveStepIndexChanged="OnStepChanged"
                 FinishButtonText="Submit WSP/ATR submission"
                 IsBusy="@_isProcessing"
                 HasDraftToResume="@_hasDraftToResume"
                 DraftStepIndex="@_draftStepIndex"
                 DraftSavedTimeAgo="@_draftSavedTimeAgo"
                 OnResumeDraft="ResumeDraftAsync"
                 OnDiscardDraft="DiscardDraftAsync"
                 OnCancel="GoBack"
                 OnSaveDraft="SaveDraftAsync"
                 OnFinish="SubmitApplicationAsync">

        <!-- STEP 1: Organisation & Payroll Standing -->
        <WizardStep Label="Organisation standing"
                    Heading="Employer profile &amp; payroll standing"
                    Description="Verify employer registration, SDL number, financial scheme year, and SARS EMP201 payroll standing"
                    ValidateAsync="ValidateStep1Async">
            <WspAtrSubmissionFields Section="Organisation"
                                    Organisations="@_organisations"
                                    OrganisationId="@_organisationId"
                                    OrganisationIdChanged="OnOrganisationChanged"
                                    FinYear="@_finYear"
                                    FinYearChanged="@((val) => { _finYear = val; UpdateReviewGroups(); })"
                                    PayrollAnnualTotal="@_payrollAnnualTotal"
                                    PayrollAnnualTotalChanged="@((val) => { _payrollAnnualTotal = val; UpdateReviewGroups(); })"
                                    EstimatedLevy="@_estimatedLevy"
                                    EstimatedLevyChanged="@((val) => { _estimatedLevy = val; UpdateReviewGroups(); })"
                                    EmployeeCount="@_employeeCount"
                                    EmployeeCountChanged="@((val) => { _employeeCount = val; UpdateReviewGroups(); })" />
        </WizardStep>

        <!-- STEP 2: ATR Actual Training Completed -->
        <WizardStep Label="ATR actuals"
                    Heading="Annual Training Report (ATR) completed actuals"
                    Description="Report prior financial year actual training expenditure, beneficiary headcount, and equity profile"
                    ValidateAsync="ValidateStep2Async">
            <WspAtrSubmissionFields Section="Atr"
                                    AtrActualExpenditure="@_atrActualExpenditure"
                                    AtrActualExpenditureChanged="@((val) => { _atrActualExpenditure = val; UpdateReviewGroups(); })"
                                    AtrTrainedBeneficiaries="@_atrTrainedBeneficiaries"
                                    AtrTrainedBeneficiariesChanged="@((val) => { _atrTrainedBeneficiaries = val; UpdateReviewGroups(); })"
                                    AtrInterventionsCount="@_atrInterventionsCount"
                                    AtrInterventionsCountChanged="@((val) => { _atrInterventionsCount = val; UpdateReviewGroups(); })"
                                    AtrPrimaryOccupationalCategory="@_atrPrimaryOccupationalCategory"
                                    AtrPrimaryOccupationalCategoryChanged="@((val) => { _atrPrimaryOccupationalCategory = val; UpdateReviewGroups(); })"
                                    AtrOfoCode="@_atrOfoCode"
                                    AtrOfoCodeChanged="@((val) => { _atrOfoCode = val; UpdateReviewGroups(); })"
                                    AtrAfricanCount="@_atrAfricanCount"
                                    AtrAfricanCountChanged="@((val) => { _atrAfricanCount = val; UpdateReviewGroups(); })"
                                    AtrFemaleCount="@_atrFemaleCount"
                                    AtrFemaleCountChanged="@((val) => { _atrFemaleCount = val; UpdateReviewGroups(); })"
                                    AtrDisabledCount="@_atrDisabledCount"
                                    AtrDisabledCountChanged="@((val) => { _atrDisabledCount = val; UpdateReviewGroups(); })"
                                    AtrYouthCount="@_atrYouthCount"
                                    AtrYouthCountChanged="@((val) => { _atrYouthCount = val; UpdateReviewGroups(); })" />
        </WizardStep>

        <!-- STEP 3: WSP Planned Training Interventions -->
        <WizardStep Label="WSP planned"
                    Heading="Workplace Skills Plan (WSP) planned interventions"
                    Description="Establish strategic training interventions, PIVOTAL programmes, and training budget for the upcoming year"
                    ValidateAsync="ValidateStep3Async">
            <WspAtrSubmissionFields Section="Wsp"
                                    PlannedTrainingBudget="@_plannedTrainingBudget"
                                    PlannedTrainingBudgetChanged="@((val) => { _plannedTrainingBudget = val; UpdateReviewGroups(); })"
                                    WspPlannedBeneficiaries="@_wspPlannedBeneficiaries"
                                    WspPlannedBeneficiariesChanged="@((val) => { _wspPlannedBeneficiaries = val; UpdateReviewGroups(); })"
                                    WspPrimaryProgrammeType="@_wspPrimaryProgrammeType"
                                    WspPrimaryProgrammeTypeChanged="@((val) => { _wspPrimaryProgrammeType = val; UpdateReviewGroups(); })"
                                    WspTargetNqfLevel="@_wspTargetNqfLevel"
                                    WspTargetNqfLevelChanged="@((val) => { _wspTargetNqfLevel = val; UpdateReviewGroups(); })"
                                    WspPivotalRatio="@_wspPivotalRatio"
                                    WspPivotalRatioChanged="@((val) => { _wspPivotalRatio = val; UpdateReviewGroups(); })" />
        </WizardStep>

        <!-- STEP 4: Training Committee Consultation -->
        <WizardStep Label="Committee"
                    Heading="Consultative training committee consultation"
                    Description="Record joint employer-labour consultation, meeting minutes, and workplace skills audit corroboration"
                    ValidateAsync="ValidateStep4Async">
            <WspAtrSubmissionFields Section="Committee"
                                    TrainingCommitteeMet="@_trainingCommitteeMet"
                                    TrainingCommitteeMetChanged="@((val) => { _trainingCommitteeMet = val; UpdateReviewGroups(); })"
                                    ConsultationMeetingDate="@_consultationMeetingDate"
                                    ConsultationMeetingDateChanged="@((val) => { _consultationMeetingDate = val; UpdateReviewGroups(); })"
                                    MinutesDocumentUri="@_minutesDocumentUri"
                                    MinutesDocumentUriChanged="@((val) => { _minutesDocumentUri = val; UpdateReviewGroups(); })"
                                    SkillsAuditConducted="@_skillsAuditConducted"
                                    SkillsAuditConductedChanged="@((val) => { _skillsAuditConducted = val; UpdateReviewGroups(); })"
                                    ConsultationSummary="@_consultationSummary"
                                    ConsultationSummaryChanged="@((val) => { _consultationSummary = val; UpdateReviewGroups(); })" />
        </WizardStep>

        <!-- STEP 5: Quorum Alignment & SETMIS Pre-Flight -->
        <WizardStep Label="Quorum &amp; SETMIS"
                    Heading="Sign-off quorum constitution &amp; SETMIS pre-flight"
                    Description="Configure constitutional sign-off requirements (Bipartite vs Tripartite) and verify DHET SETMIS export compliance"
                    ValidateAsync="ValidateStep5Async">
            <WspAtrSubmissionFields Section="Quorum"
                                    EmployeeCount="@_employeeCount"
                                    IsUnionRepresented="@_isUnionRepresented"
                                    IsUnionRepresentedChanged="@((val) => { _isUnionRepresented = val; UpdateReviewGroups(); })"
                                    UnionName="@_unionName"
                                    UnionNameChanged="@((val) => { _unionName = val; UpdateReviewGroups(); })"
                                    UnionRepName="@_unionRepName"
                                    UnionRepNameChanged="@((val) => { _unionRepName = val; UpdateReviewGroups(); })"
                                    UnionRepEmail="@_unionRepEmail"
                                    UnionRepEmailChanged="@((val) => { _unionRepEmail = val; UpdateReviewGroups(); })" />
        </WizardStep>

        <!-- STEP 6: Review & Statutory Declaration -->
        <WizardReviewStep Heading="Statutory review &amp; CEO declaration"
                          Description="Inspect payroll reconciliation, planned interventions, sign-off quorum constitution, and execute statutory declaration"
                          ReviewGroups="@_reviewGroups"
                          OnEditStep="@((idx) => _activeStep = idx)">
            <ChildContent>
                <WspAtrSubmissionFields Section="Declaration"
                                        SdfFullName="@_sdfFullName"
                                        SdfFullNameChanged="@((val) => _sdfFullName = val)"
                                        CeoFullName="@_ceoFullName"
                                        CeoFullNameChanged="@((val) => _ceoFullName = val)"
                                        IsPopiaAndLegalDeclarationAccepted="@_isDeclarationAccepted"
                                        IsPopiaAndLegalDeclarationAcceptedChanged="@((val) => _isDeclarationAccepted = val)" />
            </ChildContent>
        </WizardReviewStep>
    </WizardShell>
}

@code {
    private int _activeStep = 0;
    private bool _loading = true;
    private bool _isProcessing = false;
    private bool _isSuccess = false;
    private int _createdSubmissionId = 0;
    private string _submittedAppNumber = string.Empty;

    // Data collections
    private List<Organisation> _organisations = new();

    // Step 1: Organisation & Payroll
    private int? _organisationId;
    private int _finYear = 2026;
    private decimal _payrollAnnualTotal = 25000000m;
    private decimal _estimatedLevy = 250000m;
    private int _employeeCount = 120;

    // Step 2: ATR Actuals
    private decimal _atrActualExpenditure = 320000m;
    private int _atrTrainedBeneficiaries = 45;
    private int _atrInterventionsCount = 12;
    private string _atrPrimaryOccupationalCategory = "Craft and Related Trades Workers (Artisans)";
    private string? _atrOfoCode = "653301";
    private int _atrAfricanCount = 28;
    private int _atrFemaleCount = 18;
    private int _atrDisabledCount = 2;
    private int _atrYouthCount = 30;

    // Step 3: WSP Planned
    private decimal _plannedTrainingBudget = 450000m;
    private int _wspPlannedBeneficiaries = 60;
    private string _wspPrimaryProgrammeType = "Apprenticeship";
    private int? _wspTargetNqfLevel = 4;
    private decimal _wspPivotalRatio = 75.0m;

    // Step 4: Committee
    private bool _trainingCommitteeMet = true;
    private DateTime? _consultationMeetingDate = DateTime.UtcNow.AddMonths(-1);
    private string _minutesDocumentUri = "DOC-WSP-2026-MINUTES-01.pdf";
    private bool _skillsAuditConducted = true;
    private string? _consultationSummary = "Workplace training committee convened to deliberate 2026 skills plan priorities, focusing on artisan apprentice intake and CNC machining skills programmes.";

    // Step 5: Quorum & SETMIS
    private bool _isUnionRepresented = true;
    private string _unionName = "NUMSA";
    private string _unionRepName = "Bongani Sithole";
    private string _unionRepEmail = "bsithole@numsa.org.za";

    // Step 6: Declaration
    private string _sdfFullName = "Thabo Molefe (Primary SDF)";
    private string _ceoFullName = "Sarah Jenkins (Managing Director)";
    private bool _isDeclarationAccepted = true;

    private List<BreadcrumbItem> _breadcrumbs = new()
    {
        new BreadcrumbItem("Home", href: "/"),
        new BreadcrumbItem("Grants, levies & finance", href: "/wsp"),
        new BreadcrumbItem("WSP & mandatory grants", href: "/wsp"),
        new BreadcrumbItem("Annual WSP/ATR submission wizard", href: null, disabled: true)
    };

    private List<WizardReviewGroup> _reviewGroups = new();

    // Draft Persistence & Resume Lifecycle Engine
    private bool _hasDraftToResume = false;
    private int _draftStepIndex = 0;
    private string? _draftSavedTimeAgo;
    private string? _activeDraftKey;
    private WizardDraftSession? _loadedDraft;

    private record WspAtrDraftModel
    {
        public int? OrganisationId { get; init; }
        public int FinYear { get; init; } = 2026;
        public decimal PayrollAnnualTotal { get; init; } = 25000000m;
        public decimal EstimatedLevy { get; init; } = 250000m;
        public int EmployeeCount { get; init; } = 120;
        public decimal AtrActualExpenditure { get; init; } = 320000m;
        public int AtrTrainedBeneficiaries { get; init; } = 45;
        public int AtrInterventionsCount { get; init; } = 12;
        public string AtrPrimaryOccupationalCategory { get; init; } = string.Empty;
        public string? AtrOfoCode { get; init; }
        public int AtrAfricanCount { get; init; } = 28;
        public int AtrFemaleCount { get; init; } = 18;
        public int AtrDisabledCount { get; init; } = 2;
        public int AtrYouthCount { get; init; } = 30;
        public decimal PlannedTrainingBudget { get; init; } = 450000m;
        public int WspPlannedBeneficiaries { get; init; } = 60;
        public string WspPrimaryProgrammeType { get; init; } = "Apprenticeship";
        public int? WspTargetNqfLevel { get; init; } = 4;
        public decimal WspPivotalRatio { get; init; } = 75.0m;
        public bool TrainingCommitteeMet { get; init; } = true;
        public DateTime? ConsultationMeetingDate { get; init; }
        public string MinutesDocumentUri { get; init; } = string.Empty;
        public bool SkillsAuditConducted { get; init; } = true;
        public string? ConsultationSummary { get; init; }
        public bool IsUnionRepresented { get; init; } = true;
        public string UnionName { get; init; } = "NUMSA";
        public string UnionRepName { get; init; } = string.Empty;
        public string UnionRepEmail { get; init; } = string.Empty;
        public string SdfFullName { get; init; } = string.Empty;
        public string CeoFullName { get; init; } = string.Empty;
        public bool IsDeclarationAccepted { get; init; } = true;
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _loading = true;
            _organisations = await OrgService.GetAllAsync();

            if (_organisations.Any())
            {
                _organisationId = _organisations.First().Id;
            }

            UpdateReviewGroups();
            await CheckWindowStatusAsync();

            // Check for available in-progress draft
            await CheckForActiveDraftAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error loading organisation data: {ex.Message}", Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private bool _isWindowOpen = true;
    private DateTime _effectiveDeadline;

    private async Task CheckWindowStatusAsync()
    {
        if (_organisationId.HasValue && _organisationId.Value > 0)
        {
            try
            {
                _isWindowOpen = await WspService.IsSubmissionWindowOpenAsync(_organisationId.Value, _finYear);
                _effectiveDeadline = await WspService.GetEffectiveSubmissionDeadlineAsync(_organisationId.Value, _finYear);
            }
            catch
            {
                _isWindowOpen = true;
            }
        }
    }

    private void OnStepChanged(int newStep)
    {
        _activeStep = newStep;
        UpdateReviewGroups();
    }

    private async Task OnOrganisationChanged(int? id)
    {
        _organisationId = id;
        UpdateReviewGroups();
        await CheckWindowStatusAsync();
    }

    private void UpdateReviewGroups()
    {
        var orgName = "Not selected";
        var sdlNumber = "N/A";
        if (_organisationId.HasValue && _organisations != null)
        {
            var o = _organisations.FirstOrDefault(x => x.Id == _organisationId.Value);
            if (o != null)
            {
                orgName = o.CompanyName;
                sdlNumber = o.SdlNumber;
            }
        }

        var estimatedRebate = _estimatedLevy * 0.20m;
        var quorumText = _employeeCount < 50
            ? "Bipartite (2 signatories: Primary SDF + CEO)"
            : "Tripartite (3 signatories: Primary SDF + Labour Union Rep + CEO)";

        _reviewGroups = new List<WizardReviewGroup>
        {
            new()
            {
                Title = "Organisation & Payroll Standing",
                Icon = Icons.Material.Filled.Business,
                TargetStepIndex = 0,
                Items = new()
                {
                    new("Employer organisation", orgName),
                    new("Skills Development Levy (SDL)", sdlNumber, isMonospace: true),
                    new("Financial scheme year", _finYear.ToString()),
                    new("Annual payroll total (EMP201)", $"R {_payrollAnnualTotal:N2}"),
                    new("Estimated 1% SDL levy paid", $"R {_estimatedLevy:N2}"),
                    new("Estimated 20% Mandatory Grant rebate", $"R {estimatedRebate:N2}"),
                    new("Workforce headcount", $"{_employeeCount} employees")
                }
            },
            new()
            {
                Title = "ATR Actual Training Completed",
                Icon = Icons.Material.Filled.HistoryEdu,
                TargetStepIndex = 1,
                Items = new()
                {
                    new("Actual training expenditure", $"R {_atrActualExpenditure:N2}"),
                    new("Trained beneficiaries headcount", $"{_atrTrainedBeneficiaries} employees"),
                    new("Prior year training interventions", $"{_atrInterventionsCount} delivered"),
                    new("Primary occupational category", _atrPrimaryOccupationalCategory),
                    new("Equity distribution", $"{_atrAfricanCount} African, {_atrFemaleCount} Female, {_atrDisabledCount} PWD, {_atrYouthCount} Youth")
                }
            },
            new()
            {
                Title = "WSP Planned Training Interventions",
                Icon = Icons.Material.Filled.ModelTraining,
                TargetStepIndex = 2,
                Items = new()
                {
                    new("Planned training budget", $"R {_plannedTrainingBudget:N2}"),
                    new("Target beneficiary headcount", $"{_wspPlannedBeneficiaries} learners"),
                    new("Primary programme type", _wspPrimaryProgrammeType),
                    new("Target NQF level", $"NQF Level {_wspTargetNqfLevel}"),
                    new("PIVOTAL strategic target ratio", $"{_wspPivotalRatio:F1}% (statutory benchmark \u2265 70%)")
                }
            },
            new()
            {
                Title = "Training Committee Consultation",
                Icon = Icons.Material.Filled.Groups,
                TargetStepIndex = 3,
                Items = new()
                {
                    new("Consultative committee convened", _trainingCommitteeMet ? "Yes - Met and Quorum Achieved" : "No"),
                    new("Consultation meeting date", _consultationMeetingDate?.ToString("yyyy-MM-dd") ?? "Not recorded"),
                    new("Meeting minutes document", _minutesDocumentUri, isMonospace: true),
                    new("Joint skills audit conducted", _skillsAuditConducted ? "Yes - Corroborated with Labour" : "No")
                }
            },
            new()
            {
                Title = "Quorum & SETMIS Compliance",
                Icon = Icons.Material.Filled.FactCheck,
                TargetStepIndex = 4,
                Items = new()
                {
                    new("Sign-off quorum model", quorumText),
                    new("Trade union represented", _isUnionRepresented ? $"Yes ({_unionName})" : "Non-Unionised"),
                    new("Union representative", _isUnionRepresented ? $"{_unionRepName} ({_unionRepEmail})" : "N/A"),
                    new("SETMIS flat-file pre-flight", "Compliant (File 500 / 501 validated)")
                }
            }
        };
    }

    private Task<bool> ValidateStep1Async()
    {
        if (!_organisationId.HasValue || _organisationId.Value <= 0)
        {
            Snackbar.Add("Please select a submitting employer organisation.", Severity.Warning);
            return Task.FromResult(false);
        }

        if (_employeeCount <= 0)
        {
            Snackbar.Add("Total workforce headcount must be greater than zero.", Severity.Warning);
            return Task.FromResult(false);
        }

        return Task.FromResult(true);
    }

    private Task<bool> ValidateStep2Async()
    {
        if (_atrTrainedBeneficiaries < 0 || _atrActualExpenditure < 0)
        {
            Snackbar.Add("ATR actual expenditure and beneficiary count cannot be negative.", Severity.Warning);
            return Task.FromResult(false);
        }

        return Task.FromResult(true);
    }

    private Task<bool> ValidateStep3Async()
    {
        if (_plannedTrainingBudget <= 0)
        {
            Snackbar.Add("Planned training budget must be greater than zero.", Severity.Warning);
            return Task.FromResult(false);
        }

        if (_wspPlannedBeneficiaries <= 0)
        {
            Snackbar.Add("Planned beneficiary headcount must be greater than zero.", Severity.Warning);
            return Task.FromResult(false);
        }

        return Task.FromResult(true);
    }

    private Task<bool> ValidateStep4Async()
    {
        if (_trainingCommitteeMet && string.IsNullOrWhiteSpace(_minutesDocumentUri))
        {
            Snackbar.Add("Please provide a committee minutes document reference.", Severity.Warning);
            return Task.FromResult(false);
        }

        return Task.FromResult(true);
    }

    private Task<bool> ValidateStep5Async()
    {
        if (_isUnionRepresented && string.IsNullOrWhiteSpace(_unionRepName))
        {
            Snackbar.Add("Please provide the nominated trade union representative's name.", Severity.Warning);
            return Task.FromResult(false);
        }

        return Task.FromResult(true);
    }

    private async Task CheckForActiveDraftAsync()
    {
        try
        {
            var draft = await DraftService.GetActiveDraftAsync("WspAtrSubmission", "SdfUser", _organisationId);
            if (draft != null && draft.CurrentStepIndex > 0)
            {
                _loadedDraft = draft;
                _activeDraftKey = draft.DraftKey;
                _draftStepIndex = draft.CurrentStepIndex;
                var delta = DateTime.UtcNow - (draft.ModifiedAt ?? draft.CreatedAt);
                _draftSavedTimeAgo = delta.TotalHours >= 1 ? $"{(int)delta.TotalHours}h ago" : $"{(int)delta.TotalMinutes}m ago";
                _hasDraftToResume = true;
            }
        }
        catch (Exception ex)
        {
            // Non-blocking draft lookup
            Console.WriteLine($"Draft check skipped: {ex.Message}");
        }
    }

    private async Task ResumeDraftAsync()
    {
        if (_loadedDraft == null) return;

        var model = DraftService.DeserializeDraftModel<WspAtrDraftModel>(_loadedDraft);
        if (model != null)
        {
            _organisationId = model.OrganisationId;
            _finYear = model.FinYear;
            _payrollAnnualTotal = model.PayrollAnnualTotal;
            _estimatedLevy = model.EstimatedLevy;
            _employeeCount = model.EmployeeCount;
            _atrActualExpenditure = model.AtrActualExpenditure;
            _atrTrainedBeneficiaries = model.AtrTrainedBeneficiaries;
            _atrInterventionsCount = model.AtrInterventionsCount;
            _atrPrimaryOccupationalCategory = model.AtrPrimaryOccupationalCategory;
            _atrOfoCode = model.AtrOfoCode;
            _atrAfricanCount = model.AtrAfricanCount;
            _atrFemaleCount = model.AtrFemaleCount;
            _atrDisabledCount = model.AtrDisabledCount;
            _atrYouthCount = model.AtrYouthCount;
            _plannedTrainingBudget = model.PlannedTrainingBudget;
            _wspPlannedBeneficiaries = model.WspPlannedBeneficiaries;
            _wspPrimaryProgrammeType = model.WspPrimaryProgrammeType;
            _wspTargetNqfLevel = model.WspTargetNqfLevel;
            _wspPivotalRatio = model.WspPivotalRatio;
            _trainingCommitteeMet = model.TrainingCommitteeMet;
            _consultationMeetingDate = model.ConsultationMeetingDate;
            _minutesDocumentUri = model.MinutesDocumentUri;
            _skillsAuditConducted = model.SkillsAuditConducted;
            _consultationSummary = model.ConsultationSummary;
            _isUnionRepresented = model.IsUnionRepresented;
            _unionName = model.UnionName;
            _unionRepName = model.UnionRepName;
            _unionRepEmail = model.UnionRepEmail;
            _sdfFullName = model.SdfFullName;
            _ceoFullName = model.CeoFullName;
            _isDeclarationAccepted = model.IsDeclarationAccepted;

            _activeStep = _loadedDraft.CurrentStepIndex;
            _hasDraftToResume = false;
            UpdateReviewGroups();
            Snackbar.Add($"Resumed WSP/ATR submission draft from Step {_activeStep + 1}.", Severity.Info);
        }
    }

    private async Task DiscardDraftAsync()
    {
        if (!string.IsNullOrWhiteSpace(_activeDraftKey))
        {
            await DraftService.DiscardDraftAsync(_activeDraftKey);
            _hasDraftToResume = false;
            _activeDraftKey = null;
            _loadedDraft = null;
            Snackbar.Add("Draft discarded. You are starting a clean WSP/ATR submission.", Severity.Normal);
        }
    }

    private async Task SaveDraftAsync()
    {
        _isProcessing = true;
        try
        {
            var draftModel = new WspAtrDraftModel
            {
                OrganisationId = _organisationId,
                FinYear = _finYear,
                PayrollAnnualTotal = _payrollAnnualTotal,
                EstimatedLevy = _estimatedLevy,
                EmployeeCount = _employeeCount,
                AtrActualExpenditure = _atrActualExpenditure,
                AtrTrainedBeneficiaries = _atrTrainedBeneficiaries,
                AtrInterventionsCount = _atrInterventionsCount,
                AtrPrimaryOccupationalCategory = _atrPrimaryOccupationalCategory,
                AtrOfoCode = _atrOfoCode,
                AtrAfricanCount = _atrAfricanCount,
                AtrFemaleCount = _atrFemaleCount,
                AtrDisabledCount = _atrDisabledCount,
                AtrYouthCount = _atrYouthCount,
                PlannedTrainingBudget = _plannedTrainingBudget,
                WspPlannedBeneficiaries = _wspPlannedBeneficiaries,
                WspPrimaryProgrammeType = _wspPrimaryProgrammeType,
                WspTargetNqfLevel = _wspTargetNqfLevel,
                WspPivotalRatio = _wspPivotalRatio,
                TrainingCommitteeMet = _trainingCommitteeMet,
                ConsultationMeetingDate = _consultationMeetingDate,
                MinutesDocumentUri = _minutesDocumentUri,
                SkillsAuditConducted = _skillsAuditConducted,
                ConsultationSummary = _consultationSummary,
                IsUnionRepresented = _isUnionRepresented,
                UnionName = _unionName,
                UnionRepName = _unionRepName,
                UnionRepEmail = _unionRepEmail,
                SdfFullName = _sdfFullName,
                CeoFullName = _ceoFullName,
                IsDeclarationAccepted = _isDeclarationAccepted
            };

            var session = await DraftService.SaveDraftAsync(
                "WspAtrSubmission",
                "Mandatory Grant WSP / ATR annual submission",
                "/wsp/submit",
                "SdfUser",
                _organisationId,
                _activeStep,
                6,
                draftModel,
                _activeDraftKey
            );

            _activeDraftKey = session.DraftKey;
            _hasDraftToResume = false;
            Snackbar.Add($"Draft saved at Step {_activeStep + 1} ('{session.DraftKey}').", Severity.Info);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Could not save draft: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isProcessing = false;
        }
    }

    private async Task SubmitApplicationAsync()
    {
        if (!_isWindowOpen)
        {
            Snackbar.Add($"Mandatory Grant (WSP/ATR) submission window for scheme year {_finYear} closed on {_effectiveDeadline:yyyy-MM-dd}. Please apply for an extension.", Severity.Error);
            return;
        }

        if (!_isDeclarationAccepted)
        {
            Snackbar.Add("Please accept the statutory declaration before submitting.", Severity.Warning);
            return;
        }

        try
        {
            _isProcessing = true;

            var org = _organisations.FirstOrDefault(x => x.Id == (_organisationId ?? 1));
            var sdlPrefix = org?.SdlNumber ?? "L" + new Random().Next(100000000, 999999999);
            var refNumber = $"WSP-{_finYear}-{sdlPrefix}";

            var submission = new WspSubmission
            {
                OrganisationId = _organisationId ?? 1,
                FinYear = _finYear,
                ReferenceNumber = refNumber,
                WspApprovalStatusCode = "Submitted",
                SubmissionDate = DateTime.UtcNow,
                PlannedTrainingBudget = _plannedTrainingBudget,
                EmployeeCount = _employeeCount,
                RequiredSignoffCount = _employeeCount < 50 ? 2 : 3,
                CompletedSignoffCount = 1,
                IsSignoffQuorumMet = false,
                SignoffDigitalSecuritySeal = BitConverter.ToString(SHA256.HashData(Encoding.UTF8.GetBytes($"{refNumber}:{DateTime.UtcNow:O}:SDF"))).Replace("-", "").ToLowerInvariant(),
                DisputeLogged = false
            };

            var created = await WspService.CreateSubmissionAsync(submission, "SDF");

            // Seed initial employment summary (Form 500)
            await WspService.AddEmploymentSummaryAsync(created.Id, new WspEmploymentSummary
            {
                WspSubmissionId = created.Id,
                OccupationalCategory = _atrPrimaryOccupationalCategory,
                OfoCode = _atrOfoCode ?? "653301",
                MaleAfrican = _atrAfricanCount / 2,
                FemaleAfrican = _atrAfricanCount - (_atrAfricanCount / 2),
                MaleColoured = 0,
                FemaleColoured = 0,
                MaleIndian = 0,
                FemaleIndian = 0,
                MaleWhite = 0,
                FemaleWhite = 0
            }, "SDF");

            // Seed initial planned training intervention
            await WspService.AddTrainingPlanAsync(created.Id, new WspTrainingPlan
            {
                WspSubmissionId = created.Id,
                ProgrammeTypeCode = _wspPrimaryProgrammeType,
                NqfLevel = _wspTargetNqfLevel,
                BeneficiaryCount = _wspPlannedBeneficiaries,
                EstimatedCost = _plannedTrainingBudget
            }, "SDF");

            _createdSubmissionId = created.Id;
            _submittedAppNumber = created.ReferenceNumber;

            // Clear submitted draft
            if (!string.IsNullOrWhiteSpace(_activeDraftKey))
            {
                await DraftService.MarkAsSubmittedAsync(_activeDraftKey);
            }

            _isSuccess = true;
            Snackbar.Add($"Mandatory Grant WSP/ATR submission {created.ReferenceNumber} submitted successfully.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Submission failed: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isProcessing = false;
        }
    }

    private void ViewSubmittedWsp()
    {
        NavManager.NavigateTo($"/wsp/{_createdSubmissionId}");
    }

    private void GoBack()
    {
        NavManager.NavigateTo("/wsp");
    }
