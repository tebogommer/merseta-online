@page "/finance/dg-moa"
@page "/finance"
@page "/finance/grants"
@using Nsdms.Application.Services
@using Nsdms.Domain.Entities
@using Nsdms.Web.Components.Shared
@using MudBlazor
@inject IFinanceService FinanceService
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject IJSRuntime JS
@rendermode InteractiveServer

@*
  UI-STANDARD.md Archetype: A1 / T1 (Transactional List - Grant MOAs & Tranche Disbursements)
  Clauses: 4.2, 4.3, 4.4, 6.1, 7.2, 8.1, 8.3, 11.1–11.9, 15.2.5
*@

<PageTitle>Discretionary Grant (DG) MOAs - merSETA NSDMS</PageTitle>

<EntityHeader Title="Discretionary Grant (DG) MOAs &amp; Tranches"
              Subtitle="Memorandum of Agreements, milestone deliverable contracting, and tranche invoice payment matrix"
              ReferenceKey="T1-FINANCE-DG-MOA"
              BreadcrumbItems="@_breadcrumbs">
    <ActionZone>
        <MudButton Variant="Variant.Outlined" 
                   Color="Color.Primary" 
                   StartIcon="@Icons.Material.Filled.Payments" 
                   OnClick="@(() => Navigation.NavigateTo("/finance/mg-rebates"))">
            Mandatory Grant (MG) Rebates
        </MudButton>
        <MudButton Variant="Variant.Filled" 
                   Color="Color.Primary" 
                   StartIcon="@Icons.Material.Filled.PostAdd" 
                   OnClick="@(() => Navigation.NavigateTo("/finance/dg-moa/create"))">
            New DG MOA Contract
        </MudButton>
    </ActionZone>
</EntityHeader>

<!-- Summary Metric Cards (Clause 4.4) -->
<StatCardRow Class="mb-4">
    <StatCard Value="@_moas.Count.ToString("N0")" 
              Label="Total Active MOAs" 
              Context="Contract agreements" />
    <StatCard Value="@_moas.Sum(m => m.TotalContractValue).ToString("C0")" 
              Label="Committed Contract Value" 
              TrendColor="Color.Success" 
              Context="Total allocation budget" />
    <StatCard Value="@_moas.SelectMany(m => m.Milestones).Count(ms => ms.MilestoneStatusCode == "Verified" || ms.MilestoneStatusCode == "Submitted").ToString("N0")" 
              Label="Milestones Awaiting Payout" 
              TrendColor="Color.Warning" 
              Context="Pending verification" />
    <StatCard Value="@_moas.SelectMany(m => m.Milestones).SelectMany(ms => ms.Payments).Where(p => p.PaymentStatusCode == "Paid").Sum(p => p.ApprovedPaymentAmount).ToString("C0")" 
              Label="Tranches Disbursed" 
              TrendColor="Color.Info" 
              Context="Paid to beneficiaries" />
</StatCardRow>

<!-- Filter Bar (Clause 11.4) -->
<FilterBar SearchPlaceholder="Search by MOA Number, Employer Name, SDL, Grant Ref..."
           @bind-SearchText="_searchString"
           OnSearch="HandleFilterChanged"
           OnClear="ClearFilters">
    <FilterContent>
        <MudSelect T="string" 
                   Label="Contract Status" 
                   @bind-Value="_statusFilter" 
                   @bind-Value:after="HandleFilterChanged"
                   Variant="Variant.Outlined" 
                   Margin="Margin.Dense"
                   Dense="true">
            <MudSelectItem Value="@("All")">All Statuses</MudSelectItem>
            <MudSelectItem Value="@("Active")">Active</MudSelectItem>
            <MudSelectItem Value="@("Pending Signature")">Pending Signature</MudSelectItem>
            <MudSelectItem Value="@("Completed")">Completed</MudSelectItem>
            <MudSelectItem Value="@("Terminated")">Terminated</MudSelectItem>
        </MudSelect>
    </FilterContent>
    <ActiveFilterChips>
        @if (!string.IsNullOrWhiteSpace(_searchString))
        {
            <MudChip T="string" Size="Size.Small" OnClose="@(() => { _searchString = string.Empty; HandleFilterChanged(); })">
                Keyword: @_searchString
            </MudChip>
        }
        @if (_statusFilter != "All")
        {
            <MudChip T="string" Size="Size.Small" Color="Color.Primary" OnClose="@(() => { _statusFilter = "All"; HandleFilterChanged(); })">
                Status: @_statusFilter
            </MudChip>
        }
    </ActiveFilterChips>
</FilterBar>

<!-- Data Grid Shell (Clause 11.9) -->
<DataGridShell TItem="GrantMoa"
               GridKey="GrantMoaGrid"
               Items="@FilteredMoas"
               IsLoading="@_loading"
               TotalItemsCount="@FilteredMoas.Count"
               SelectedItems="@_selectedMoas"
               SelectedItemsChanged="OnSelectedMoasChanged"
               ExportCallback="ExportSelected"
               EmptyTitle="No Grant MOAs Found"
               EmptyMessage="No grant contracting memorandum of agreements match your active search or filter criteria."
               EmptyActionLabel="Contract New MOA"
               OnEmptyAction="@(() => Navigation.NavigateTo("/finance/dg-moa/create"))">
    <BulkActionBarContent>
        <MudText Typo="Typo.body2" Class="fw-bold text-white">
            @_selectedMoas.Count MOA(s) selected
        </MudText>
        <MudButton Variant="Variant.Filled" 
                   Color="Color.Surface" 
                   Size="Size.Small" 
                   StartIcon="@Icons.Material.Filled.FileDownload"
                   OnClick="ExportSelected">
            Export Selected
        </MudButton>
    </BulkActionBarContent>
    <ChildContent>
        <MudTable Items="@FilteredMoas"
                  Hover="true"
                  Dense="true"
                  Elevation="0"
                  MultiSelection="true"
                  @bind-SelectedItems="_selectedMoas"
                  Breakpoint="Breakpoint.Sm"
                  Class="border-default">
            <HeaderContent>
                <MudTh>MOA Number</MudTh>
                <MudTh>Employer / Beneficiary</MudTh>
                <MudTh>Contract Value</MudTh>
                <MudTh>Disbursed Amount</MudTh>
                <MudTh>Milestones</MudTh>
                <MudTh>Status</MudTh>
                <MudTh Style="text-align:right">Actions</MudTh>
            </HeaderContent>
            <RowTemplate>
                <!-- Key column is real hyperlink (Clause 11.1) -->
                <MudTd DataLabel="MOA Number">
                    <a href="/finance/dg-moa/@context.Id" class="d-flex align-center gap-1 font-monospace fw-bold text-primary text-decoration-none">
                        <MudIcon Icon="@Icons.Material.Filled.Description" Size="Size.Small" />
                        <span>@(string.IsNullOrWhiteSpace(context.MoaNumber) ? $"MOA-{context.Id}" : context.MoaNumber)</span>
                    </a>
                </MudTd>
                <MudTd DataLabel="Employer">
                    <MudText Typo="Typo.body2" Class="fw-bold">@(context.Organisation?.CompanyName ?? "Unlinked Organisation")</MudText>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">SDL: @(context.Organisation?.SdlNumber ?? "—")</MudText>
                </MudTd>
                <MudTd DataLabel="Contract Value">
                    <MudText Typo="Typo.body2" Class="fw-bold">@context.TotalContractValue.ToString("C")</MudText>
                </MudTd>
                <MudTd DataLabel="Disbursed">
                    @{
                        var paid = context.Milestones?.SelectMany(m => m.Payments ?? new List<GrantTranchePayment>())
                                        .Where(p => p.PaymentStatusCode == "Paid")
                                        .Sum(p => p.ApprovedPaymentAmount) ?? 0m;
                    }
                    <MudText Typo="Typo.body2" Class="fw-bold text-success">@paid.ToString("C")</MudText>
                </MudTd>
                <MudTd DataLabel="Milestones">
                    <MudChip T="string" Size="Size.Small" Color="Color.Info" Variant="Variant.Outlined">
                        @(context.Milestones?.Count ?? 0) Tranches
                    </MudChip>
                </MudTd>
                <MudTd DataLabel="Status">
                    <!-- Non-clickable status pill (Clause 6.1, 7.2) -->
                    <StatusBadge Status="@(context.MoaStatusCode ?? "Draft")" Size="Size.Small" />
                </MudTd>
                <MudTd Style="text-align:right" DataLabel="Actions">
                    <div class="d-flex justify-end gap-1">
                        <MudTooltip Text="View DG MOA">
                            <MudIconButton Icon="@Icons.Material.Filled.Visibility" 
                                           Color="Color.Primary" 
                                           Size="Size.Small" 
                                           OnClick="@(() => Navigation.NavigateTo($"/finance/dg-moa/{context.Id}"))" 
                                           aria-label="View DG MOA" />
                        </MudTooltip>
                    </div>
                </MudTd>
            </RowTemplate>
            <NoRecordsContent>
                <EmptyState Icon="@Icons.Material.Filled.AssignmentLate"
                            Message="No Discretionary Grant (DG) MOAs Found"
                            Description="@(_moas.Count == 0 ? "No active Discretionary Grant (DG) memorandum of agreements in the system. Initiate contracting from an approved DG application." : "No MOA records match your active search or filter criteria. Try clearing your filters.")"
                            ActionLabel="@(_moas.Count == 0 ? "New DG MOA Contract" : "Clear Filters")"
                            ActionHref="@(_moas.Count == 0 ? "/finance/dg-moa/create" : null)"
                            OnAction="ClearFilters" />
            </NoRecordsContent>
            <PagerContent>
                <!-- Fixed page size ladder (Clause 11.3.3) -->
                <MudTablePager PageSizeOptions="new int[] { 5, 10, 20, 50, 100, 250, 500 }" />
            </PagerContent>
        </MudTable>
    </ChildContent>
</DataGridShell>

@code {
    private List<GrantMoa> _moas = new();
    private HashSet<GrantMoa> _selectedMoas = new();
    private string _searchString = string.Empty;
    private string _statusFilter = "All";
    private bool _loading = true;

    private List<BreadcrumbItem> _breadcrumbs = new()
    {
        new BreadcrumbItem("Home", href: "/"),
        new BreadcrumbItem("Finance & Disbursements", href: null, disabled: true),
        new BreadcrumbItem("Discretionary Grant (DG) MOAs", href: "/finance/dg-moa")
    };

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        _loading = true;
        try
        {
            _moas = await FinanceService.GetGrantMoasAsync();
        }
        finally
        {
            _loading = false;
        }
    }

    private List<GrantMoa> FilteredMoas
    {
        get
        {
            var query = _moas.AsEnumerable();

            if (_statusFilter != "All")
            {
                query = query.Where(m => m.MoaStatusCode != null && m.MoaStatusCode.Equals(_statusFilter, StringComparison.OrdinalIgnoreCase));
            }

            if (!string.IsNullOrWhiteSpace(_searchString))
            {
                var s = _searchString.Trim();
                query = query.Where(m =>
                    (m.MoaNumber != null && m.MoaNumber.Contains(s, StringComparison.OrdinalIgnoreCase)) ||
                    (m.Organisation != null && m.Organisation.CompanyName != null && m.Organisation.CompanyName.Contains(s, StringComparison.OrdinalIgnoreCase)) ||
                    (m.Organisation != null && m.Organisation.SdlNumber != null && m.Organisation.SdlNumber.Contains(s, StringComparison.OrdinalIgnoreCase)));
            }

            return query.ToList();
        }
    }

    private void HandleFilterChanged()
    {
        StateHasChanged();
    }

    private void ClearFilters()
    {
        _searchString = string.Empty;
        _statusFilter = "All";
        StateHasChanged();
    }

    private void OnSelectedMoasChanged(HashSet<GrantMoa> selected)
    {
        _selectedMoas = selected;
    }

    private async Task ExportSelected()
    {
        var targetList = _selectedMoas.Count > 0 ? _selectedMoas.ToList() : FilteredMoas.ToList();
        if (targetList.Count == 0)
        {
            Snackbar.Add("No Discretionary Grant (DG) MOA records available to export.", Severity.Warning);
            return;
        }

        var sb = new System.Text.StringBuilder();
        sb.AppendLine("MOA Number,Organisation Name,Project Title,Contract Value,Status");
        foreach (var moa in targetList)
        {
            sb.AppendLine($"\"{EscapeCsv(moa.MoaNumber)}\",\"{EscapeCsv(moa.Organisation?.CompanyName ?? "Unknown")}\",\"{EscapeCsv(moa.ProjectTitle)}\",\"{moa.TotalContractValue.ToString("F2", System.Globalization.CultureInfo.InvariantCulture)}\",\"{EscapeCsv(moa.MoaStatusCode)}\"");
        }

        var bytes = System.Text.Encoding.UTF8.GetBytes(sb.ToString());
        var base64 = Convert.ToBase64String(bytes);
        await JS.InvokeVoidAsync("downloadFileFromBytes", $"Grant_MOAs_Export_{DateTime.UtcNow:yyyyMMdd_HHmmss}.csv", "text/csv", base64);
        Snackbar.Add($"Exported {targetList.Count} Discretionary Grant (DG) MOA records to CSV.", Severity.Success);
    }

    private static string EscapeCsv(string? val) => (val ?? "").Replace("\"", "\"\"").Replace("\r", " ").Replace("\n", " ");
}
