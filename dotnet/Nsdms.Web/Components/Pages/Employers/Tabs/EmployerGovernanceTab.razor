    private async Task DeleteMemberAsync(OrganisationGovernanceMember member)
    {
        var confirm = await DialogService.ShowAsync<ConfirmDialog>(
            "Delete Governance Record",
            new DialogParameters
            {
                { "ContentText", $"Are you sure you want to remove '{member.DisplayName}' from this organisation's corporate governance register? This change is audited." },
                { "ButtonText", "Delete Record" },
                { "Color", Color.Error }
            });

        var res = await confirm.Result;
        if (!res.Canceled)
        {
            try
            {
                var success = await ConflictService.DeleteGovernanceMemberAsync(member.Id, "Admin");
                if (success)
                {
                    Snackbar.Add("Governance record deleted successfully.", Severity.Success);
                    await LoadGovernanceDataAsync();
                }
            }
            catch (Exception ex)
            {
                Snackbar.Add($"Error deleting governance record: {ex.Message}", Severity.Error);
            }
        }
    }

    private async Task RunCoiScanAsync()
    {
        _isScanning = true;
        try
        {
            var flagsRaised = await ConflictService.EvaluateOrganisationConflictsAsync(OrganisationId, "Admin");
            await LoadGovernanceDataAsync();

            if (flagsRaised.Count > 0)
            {
                Snackbar.Add($"COI Scan Complete: Flagged {flagsRaised.Count} potential statutory conflicts for review.", Severity.Warning);
            }
            else
            {
                Snackbar.Add("COI Scan Complete: Zero insider conflicts or multi-entity grant syndicates detected.", Severity.Success);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error executing COI scan: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isScanning = false;
        }
    }
}
