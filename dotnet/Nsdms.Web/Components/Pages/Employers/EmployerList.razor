@page "/employers"
@using Nsdms.Application.Services
@using Nsdms.Domain.Entities
@using Nsdms.Web.Components.Shared
@using MudBlazor
@inject IOrganisationService OrgService
@inject NavigationManager NavManager
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject IJSRuntime JS
@rendermode InteractiveServer

@*
  UI-STANDARD.md Archetype: A1 / T1 (Transactional List - Employer & Organisation Registry)
  Clauses: 4.2, 4.3, 6.1, 7.2, 8.1, 8.3, 11.1–11.9, 15.2.5
*@

<EntityHeader Title="Employer &amp; Organisation Registry"
              Subtitle="Centralized master register of levy-paying employers, chambers, providers, and accredited entities"
              ReferenceKey="T1-EMPLOYERS"
              BreadcrumbItems="@_breadcrumbs">
    <ActionZone>
        <MudButton Variant="Variant.Filled" 
                   Color="Color.Primary" 
                   StartIcon="@Icons.Material.Filled.AddBusiness" 
                   OnClick="CreateNewEmployer">
            New Organisation
        </MudButton>
    </ActionZone>
</EntityHeader>

<!-- Data Grid Shell (Clause 11.9) with integrated filters and search -->
<DataGridShell TItem="Organisation"
               GridKey="EmployerRegistryGrid"
               Items="@FilteredEmployers"
               IsLoading="@_loading"
               TotalItemsCount="@FilteredEmployers.Count"
               SelectedItems="@_selectedEmployers"
               SelectedItemsChanged="OnSelectedEmployersChanged"
               @bind-SearchString="_searchString"
               SearchPlaceholder="Search by SDL Number, Organisation Name, Registration No, Tax No..."
               HasActiveFilters="@(!string.IsNullOrWhiteSpace(_searchString) || _statusFilter != "All")"
               OnClearFilters="HandleFilterCleared"
               EmptyTitle="No Organisations Found"
               EmptyMessage="No registered employers match your active search and filter criteria. Register a new employer to populate the master registry."
               EmptyActionLabel="Register New Organisation"
               OnEmptyAction="CreateNewEmployer"
               ExportCallback="ExportSelected">
    <FilterContent>
        <div class="d-flex flex-column gap-1">
            <MudText Typo="Typo.caption" Color="Color.Secondary">Status</MudText>
            <MudToggleGroup T="string"
                            Value="_statusFilter"
                            ValueChanged="HandleStatusToggleChanged"
                            SelectionMode="SelectionMode.SingleSelection"
                            Color="Color.Primary"
                            Variant="Variant.Outlined"
                            Dense="true"
                            Size="Size.Small"
                            aria-label="Filter organisations by status">
                <MudToggleItem Value="@("All")" Text="All" />
                <MudToggleItem Value="@("Active")" Text="Active" />
                <MudToggleItem Value="@("Inactive")" Text="Inactive" />
            </MudToggleGroup>
        </div>
    </FilterContent>
    <ActiveFilterChips>
        @if (!string.IsNullOrWhiteSpace(_searchString))
        {
            <MudChip T="string" Size="Size.Small" OnClose="@(() => { _searchString = string.Empty; HandleFilterChanged(); })">
                Keyword: @_searchString
            </MudChip>
        }
        @if (_statusFilter != "All")
        {
            <MudChip T="string" Size="Size.Small" Color="Color.Primary" OnClose="@(() => { _statusFilter = "All"; HandleFilterChanged(); })">
                Status: @_statusFilter
            </MudChip>
        }
    </ActiveFilterChips>
    <BulkActionBarContent>
        <MudText Typo="Typo.body2" Class="fw-bold text-white">
            @_selectedEmployers.Count organisation(s) selected
        </MudText>
        <MudButton Variant="Variant.Filled" 
                   Color="Color.Surface" 
                   Size="Size.Small" 
                   StartIcon="@Icons.Material.Filled.FileDownload"
                   OnClick="ExportSelected">
            Export Selected
        </MudButton>
    </BulkActionBarContent>
    <ChildContent>
        <MudTable Items="@FilteredEmployers"
                  Hover="true"
                  Dense="true"
                  Elevation="0"
                  MultiSelection="true"
                  @bind-SelectedItems="_selectedEmployers"
                  Breakpoint="Breakpoint.Sm"
                  Class="border-default">
            <HeaderContent>
                <MudTh>SDL Number</MudTh>
                <MudTh>Organisation Name</MudTh>
                <MudTh Class="d-none d-md-table-cell">Trading Name</MudTh>
                <MudTh Class="d-none d-md-table-cell">Registration / Tax No</MudTh>
                <MudTh>Chamber / Sector</MudTh>
                <MudTh>Status</MudTh>
                <MudTh Style="text-align:right">Actions</MudTh>
            </HeaderContent>
            <RowTemplate>
                <!-- Key column is real hyperlink (Clause 11.1) -->
                <MudTd DataLabel="SDL Number">
                    <a href="/employers/@context.Id" class="d-flex align-center gap-1 font-monospace fw-bold text-primary text-decoration-none">
                        <MudIcon Icon="@Icons.Material.Filled.Business" Size="Size.Small" />
                        <span>@(string.IsNullOrWhiteSpace(context.SdlNumber) ? $"ORG-{context.Id}" : context.SdlNumber)</span>
                    </a>
                </MudTd>
                <MudTd DataLabel="Organisation Name">
                    <MudText Typo="Typo.body2" Class="fw-bold">@context.CompanyName</MudText>
                    @if (context.PrimaryContactPerson != null)
                    {
                        <MudText Typo="Typo.caption" Color="Color.Secondary">
                            Contact: @context.PrimaryContactPerson.FirstName @context.PrimaryContactPerson.LastName
                        </MudText>
                    }
                </MudTd>
                <MudTd Class="d-none d-md-table-cell" DataLabel="Trading Name">
                    @(!string.IsNullOrWhiteSpace(context.TradingName) ? context.TradingName : "—")
                </MudTd>
                <MudTd Class="d-none d-md-table-cell" DataLabel="Registration / Tax No">
                    <div>
                        @if (!string.IsNullOrWhiteSpace(context.RegistrationNumber))
                        {
                            <MudText Typo="Typo.caption" Class="d-block">Reg: @context.RegistrationNumber</MudText>
                        }
                        @if (!string.IsNullOrWhiteSpace(context.TaxNumber))
                        {
                            <MudText Typo="Typo.caption" Class="d-block text-secondary">Tax: @context.TaxNumber</MudText>
                        }
                        @if (string.IsNullOrWhiteSpace(context.RegistrationNumber) && string.IsNullOrWhiteSpace(context.TaxNumber))
                        {
                            <span>—</span>
                        }
                    </div>
                </MudTd>
                <MudTd DataLabel="Chamber / Sector">
                    <div class="d-flex align-center gap-1">
                        @if (!string.IsNullOrWhiteSpace(context.ChamberCode))
                        {
                            <MudChip T="string" Size="Size.Small" Color="Color.Info" Variant="Variant.Outlined">@context.ChamberCode</MudChip>
                        }
                        @if (!string.IsNullOrWhiteSpace(context.SectorCode))
                        {
                            <MudText Typo="Typo.caption" Class="text-secondary">@context.SectorCode</MudText>
                        }
                    </div>
                </MudTd>
                <MudTd DataLabel="Status">
                    <!-- Non-clickable status pill (Clause 6.1, 7.2) -->
                    <StatusBadge Status="@(context.IsActive ? "Active" : "Inactive")" Size="Size.Small" />
                </MudTd>
                <MudTd Style="text-align:right" DataLabel="Actions">
                    <div class="d-flex justify-end gap-1">
                        <MudTooltip Text="View Details">
                            <MudIconButton Icon="@Icons.Material.Filled.Visibility" 
                                           Color="Color.Primary" 
                                           Size="Size.Small" 
                                           OnClick="@(() => OpenDetail(context.Id))" 
                                           aria-label="View Details" />
                        </MudTooltip>
                        <MudTooltip Text="Edit Organisation">
                            <MudIconButton Icon="@Icons.Material.Filled.Edit" 
                                           Color="Color.Secondary" 
                                           Size="Size.Small" 
                                           OnClick="@(() => OpenEdit(context.Id))" 
                                           aria-label="Edit Organisation" />
                        </MudTooltip>
                        <MudTooltip Text="Delete Record">
                            <MudIconButton Icon="@Icons.Material.Filled.Delete" 
                                           Color="Color.Error" 
                                           Size="Size.Small" 
                                           OnClick="@(() => DeleteEmployer(context.Id, context.CompanyName))" 
                                           aria-label="Delete Record" />
                        </MudTooltip>
                    </div>
                </MudTd>
            </RowTemplate>
            <NoRecordsContent>
                <EmptyState Icon="@Icons.Material.Filled.Business"
                            Message="No Organisations Found"
                            Description="@(_employers.Count == 0 ? "No registered employers in the database. Register a new employer to populate the master registry." : "No registered employers match your active search and filter criteria. Try clearing your search or status filter.")"
                            ActionLabel="@(_employers.Count == 0 ? "Register New Organisation" : "Clear Filters")"
                            ActionHref="@(_employers.Count == 0 ? "/employers/create" : null)"
                            OnAction="HandleFilterCleared" />
            </NoRecordsContent>
            <PagerContent>
                <!-- Fixed page size ladder (Clause 11.3.3) -->
                <MudTablePager PageSizeOptions="new int[] { 5, 10, 20, 50, 100, 250, 500 }" />
            </PagerContent>
        </MudTable>
    </ChildContent>
</DataGridShell>

@code {
    private List<Organisation> _employers = new();
    private HashSet<Organisation> _selectedEmployers = new();
    private string _searchString = string.Empty;
    private string _statusFilter = "All";
    private bool _loading = true;

    private List<BreadcrumbItem> _breadcrumbs = new()
    {
        new BreadcrumbItem("Home", href: "/"),
        new BreadcrumbItem("Core Registries", href: null, disabled: true),
        new BreadcrumbItem("Employers", href: "/employers")
    };

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        _loading = true;
        _employers = await OrgService.GetAllAsync();
        _loading = false;
    }

    private List<Organisation> FilteredEmployers
    {
        get
        {
            var query = _employers.AsEnumerable();

            if (_statusFilter == "Active")
            {
                query = query.Where(x => x.IsActive);
            }
            else if (_statusFilter == "Inactive")
            {
                query = query.Where(x => !x.IsActive);
            }

            if (!string.IsNullOrWhiteSpace(_searchString))
            {
                var s = _searchString.Trim();
                query = query.Where(x =>
                    (x.CompanyName != null && x.CompanyName.Contains(s, StringComparison.OrdinalIgnoreCase)) ||
                    (x.TradingName != null && x.TradingName.Contains(s, StringComparison.OrdinalIgnoreCase)) ||
                    (x.SdlNumber != null && x.SdlNumber.Contains(s, StringComparison.OrdinalIgnoreCase)) ||
                    (x.RegistrationNumber != null && x.RegistrationNumber.Contains(s, StringComparison.OrdinalIgnoreCase)) ||
                    (x.TaxNumber != null && x.TaxNumber.Contains(s, StringComparison.OrdinalIgnoreCase)));
            }

            return query.ToList();
        }
    }

    private void HandleStatusToggleChanged(string? val)
    {
        _statusFilter = string.IsNullOrEmpty(val) ? "All" : val;
        HandleFilterChanged();
    }

    private void HandleFilterChanged()
    {
        StateHasChanged();
    }

    private void HandleFilterCleared()
    {
        _searchString = string.Empty;
        _statusFilter = "All";
        StateHasChanged();
    }

    private void OnSelectedEmployersChanged(HashSet<Organisation> selected)
    {
        _selectedEmployers = selected;
    }

    private void OpenDetail(int id)
    {
        NavManager.NavigateTo($"/employers/{id}");
    }

    private void OpenEdit(int id)
    {
        NavManager.NavigateTo($"/employers/{id}/edit");
    }

    private void CreateNewEmployer()
    {
        NavManager.NavigateTo("/employers/create");
    }

    private async Task ExportSelected()
    {
        var targetList = _selectedEmployers.Count > 0 ? _selectedEmployers.ToList() : FilteredEmployers.ToList();
        if (targetList.Count == 0)
        {
            Snackbar.Add("No organisation records available to export.", Severity.Warning);
            return;
        }

        var sb = new System.Text.StringBuilder();
        sb.AppendLine("SDL Number,Organisation Name,Trading Name,Registration Number,SIC Code,Status");
        foreach (var org in targetList)
        {
            sb.AppendLine($"\"{EscapeCsv(org.SdlNumber)}\",\"{EscapeCsv(org.CompanyName)}\",\"{EscapeCsv(org.TradingName)}\",\"{EscapeCsv(org.RegistrationNumber)}\",\"{EscapeCsv(org.SicCode)}\",\"{(org.IsActive ? "Active" : "Inactive")}\"");
        }

        var bytes = System.Text.Encoding.UTF8.GetBytes(sb.ToString());
        var base64 = Convert.ToBase64String(bytes);
        await JS.InvokeVoidAsync("downloadFileFromBytes", $"Organisations_Export_{DateTime.UtcNow:yyyyMMdd_HHmmss}.csv", "text/csv", base64);
        Snackbar.Add($"Exported {targetList.Count} organisations to CSV.", Severity.Success);
    }

    private static string EscapeCsv(string? val) => (val ?? "").Replace("\"", "\"\"").Replace("\r", " ").Replace("\n", " ");

    private async Task DeleteEmployer(int id, string companyName)
    {
        bool? confirmed = await DialogService.ShowMessageBoxAsync(
            "Delete Employer Record?",
            $"Are you sure you wish to delete organisation '{companyName}'? This action will perform an audit-tracked soft delete.",
            yesText: "Delete Record",
            cancelText: "Cancel"
        );

        if (confirmed == true)
        {
            var deleted = await OrgService.DeleteAsync(id, "Admin");
            if (deleted)
            {
                Snackbar.Add($"Employer '{companyName}' deleted successfully with audit confirmation.", Severity.Success);
                await LoadData();
            }
            else
            {
                Snackbar.Add("Could not delete the employer record.", Severity.Error);
            }
        }
    }
}
