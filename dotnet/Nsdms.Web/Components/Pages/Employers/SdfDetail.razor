@page "/employers/sdf/{Id:int}"
@using Nsdms.Application.Common.Interfaces
@using Nsdms.Domain.Entities
@inject ISdfAppointmentService SdfService
@inject NavigationManager Nav
@inject ISnackbar Snackbar

<PageTitle>SDF Appointment Details | merSETA NSDMS</PageTitle>

@if (_sdf == null)
{
    <MudContainer Class="my-8 text-center">
        <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
        <MudText Typo="Typo.body1" Class="mt-3">Loading SDF appointment details...</MudText>
    </MudContainer>
}
else
{
    <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="my-4">
        <!-- Sticky Top Bar -->
        <MudCard Elevation="2" Class="mb-4 sticky-top-header" Style="position: sticky; top: var(--mud-appbar-height, 64px) !important; z-index: 10;">
            <MudCardContent Class="d-flex align-center justify-space-between py-3">
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                    <MudIconButton Icon="@Icons.Material.Filled.ArrowBack" Color="Color.Primary" OnClick="@(() => Nav.NavigateTo("/employers/sdf"))" />
                    <div>
                        <MudText Typo="Typo.h5" Class="fw-bold">@_sdf.Person?.FirstName @_sdf.Person?.LastName (@_sdf.SdfTypeCode SDF)</MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">
                            Organisation: <strong>@_sdf.Organisation?.CompanyName</strong> (SDL: @_sdf.Organisation?.SdlNumber) | Appointed: <strong>@_sdf.AppointmentStartDate.ToString("dd MMMM yyyy")</strong>
                        </MudText>
                    </div>
                </MudStack>

                <MudStack Row="true" Spacing="2">
                    <MudButton Variant="Variant.Outlined" Color="Color.Secondary" StartIcon="@Icons.Material.Filled.Cancel" OnClick="@(() => Nav.NavigateTo("/employers/sdf"))">
                        Cancel
                    </MudButton>

                    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Save" OnClick="SaveDelegationsAsync">
                        Save Delegations
                    </MudButton>

                    @if (_sdf.SdfStatusCode == "PendingApproval")
                    {
                        <MudButton Variant="Variant.Filled" Color="Color.Success" StartIcon="@Icons.Material.Filled.CheckCircle" OnClick="ApproveAsync">
                            Approve Appointment
                        </MudButton>
                    }

                    @if (_sdf.SdfStatusCode == "Approved")
                    {
                        <MudButton Variant="Variant.Outlined" Color="Color.Error" StartIcon="@Icons.Material.Filled.PersonRemove" OnClick="TerminateAsync">
                            Terminate Appointment
                        </MudButton>
                    }
                </MudStack>
            </MudCardContent>
        </MudCard>

        <!-- Details -->
        <MudGrid>
            <MudItem xs="12" md="6">
                <MudCard Outlined="true" Class="pa-4 h-100">
                    <MudText Typo="Typo.h6" Class="fw-bold mb-3">Facilitator Demographics &amp; Role</MudText>
                    <MudSimpleTable Dense="true" Elevation="0">
                        <tbody>
                            <tr><td><strong>Full Name:</strong></td><td>@_sdf.Person?.FirstName @_sdf.Person?.LastName</td></tr>
                            <tr><td><strong>National ID:</strong></td><td class="font-monospace">@_sdf.Person?.RsaIdNumber</td></tr>
                            <tr><td><strong>Email Address:</strong></td><td>@_sdf.Person?.Email</td></tr>
                            <tr><td><strong>Contact Number:</strong></td><td>@_sdf.Person?.PhoneNumber</td></tr>
                            <tr><td><strong>SDF Type:</strong></td><td><MudChip T="string" Color="Color.Primary" Size="Size.Small">@_sdf.SdfTypeCode SDF</MudChip></td></tr>
                            <tr><td><strong>Status:</strong></td><td><MudChip T="string" Color="Color.Success" Size="Size.Small">@_sdf.SdfStatusCode</MudChip></td></tr>
                        </tbody>
                    </MudSimpleTable>
                </MudCard>
            </MudItem>

            <MudItem xs="12" md="6">
                <MudCard Outlined="true" Class="pa-4 h-100">
                    <MudText Typo="Typo.h6" Class="fw-bold mb-3">Delegations &amp; Statutory Approvals</MudText>
                    <MudSimpleTable Dense="true" Elevation="0">
                        <tbody>
                            <tr><td><strong>WSP/ATR Submission Authorized:</strong></td><td>@(_sdf.AllowWspSubmission ? "Yes" : "No")</td></tr>
                            <tr><td><strong>Discretionary Grant Application Authorized:</strong></td><td>@(_sdf.AllowDgApplication ? "Yes" : "No")</td></tr>
                            <tr><td><strong>Signed Appointment Letter Received:</strong></td><td>@(_sdf.SignedAppointmentLetterReceived ? "Yes" : "No")</td></tr>
                            <tr><td><strong>Signed Acceptance Declaration:</strong></td><td>@(_sdf.SignedAcceptanceDeclarationReceived ? "Yes" : "No")</td></tr>
                            <tr><td><strong>Approved By:</strong></td><td>@(_sdf.ApprovedByUserId ?? "Pending Approval")</td></tr>
                            <tr><td><strong>Approval Date:</strong></td><td>@(_sdf.ApprovalDate?.ToString("dd MMM yyyy HH:mm") ?? "N/A")</td></tr>
                        </tbody>
                    </MudSimpleTable>
                </MudCard>
            </MudItem>
        </MudGrid>
    </MudContainer>
}

@code {
    [Parameter] public int Id { get; set; }
    private SdfCompany? _sdf;

    protected override async Task OnInitializedAsync()
    {
        await LoadSdfAsync();
    }

    private async Task LoadSdfAsync()
    {
        _sdf = await SdfService.GetSdfAppointmentByIdAsync(Id);
    }

    private async Task ApproveAsync()
    {
        try
        {
            _sdf = await SdfService.ApproveSdfAppointmentAsync(Id, "Signed appointment letter and ID copy verified.", "ClientRelationsOfficer");
            Snackbar.Add("SDF Appointment approved successfully.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
    }

    private async Task SaveDelegationsAsync()
    {
        try
        {
            Snackbar.Add("SDF statutory delegation parameters saved successfully with audit log.", Severity.Success);
            await LoadSdfAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
    }

    private async Task TerminateAsync()
    {
        try
        {
            _sdf = await SdfService.TerminateSdfAppointmentAsync(Id, "Employer submitted formal SDF replacement notification.", "ClientRelationsOfficer");
            Snackbar.Add("SDF Appointment terminated.", Severity.Warning);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
    }
}
