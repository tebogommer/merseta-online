@page "/employers/{id:int}"
@page "/employers/{id:int}/edit"
@page "/employers/create"
@using Nsdms.Application.Common.Models
@using Nsdms.Application.Common.Interfaces
@using Nsdms.Application.Services
@using Nsdms.Domain.Entities
@using Nsdms.Web.Components.Pages.Employers.Tabs
@inject IOrganisationService OrgService
@inject IBrandAssetService BrandAssetService
@inject IZoneAndCaseloadService ZoneService
@inject NavigationManager NavManager
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject AuthenticationStateProvider AuthStateProvider
@inject ICaslAbilityService CaslService
@rendermode InteractiveServer

<!-- Sticky Top Bar with Breadcrumbs and Action Buttons -->
@if (!_isEditMode && Id > 0)
{
    <EntityHeader Title="@(string.IsNullOrWhiteSpace(_organisation.CompanyName) ? "Employer Record" : _organisation.CompanyName)"
                  ReferenceKey="@_organisation.SdlNumber"
                  Status="@(_organisation.IsActive ? "Active" : "Inactive")"
                  Subtitle="@($"Category: {_organisation.CategoryCode ?? "EMP"} | Chamber: {_organisation.ChamberCode ?? "General"} | Province: {_organisation.ProvinceCode ?? "National"}")"
                  BreadcrumbItems="@_breadcrumbItems">
        <ActionZone>
            <MudButton Variant="Variant.Text"
                       StartIcon="@Icons.Material.Filled.ArrowBack"
                       Color="Color.Default"
                       OnClick="BackToList"
                       aria-label="Back to Employers List">
                Back to Employers
            </MudButton>
            <MudMenu Label="Services"
                     StartIcon="@Icons.Material.Filled.Bolt"
                     EndIcon="@Icons.Material.Filled.KeyboardArrowDown"
                     Color="Color.Default"
                     Variant="Variant.Outlined"
                     Dense="true"
                     aria-label="Launch Statutory Services">
                <MudMenuItem Icon="@Icons.Material.Filled.Badge" OnClick="@(() => NavManager.NavigateTo($"/employers/sdf?orgId={Id}"))">
                    Appoint SDF Facilitator
                </MudMenuItem>
                <MudMenuItem Icon="@Icons.Material.Filled.Handyman" OnClick="@(() => NavManager.NavigateTo($"/workplace-approvals/create?organisationId={Id}"))">
                    Apply for Workplace Approval
                </MudMenuItem>
                <MudMenuItem Icon="@Icons.Material.Filled.EventAvailable" OnClick="@(() => NavManager.NavigateTo($"/monitoring?organisationId={Id}"))">
                    Schedule Monitoring Visit
                </MudMenuItem>
                <MudMenuItem Icon="@Icons.Material.Filled.Assignment" OnClick="@(() => NavManager.NavigateTo($"/wsp/create?organisationId={Id}"))">
                    Submit Annual WSP / ATR
                </MudMenuItem>
                <MudMenuItem Icon="@Icons.Material.Filled.AccountBalanceWallet" OnClick="@(() => NavManager.NavigateTo($"/grants/create?organisationId={Id}"))">
                    Apply for Discretionary Grant
                </MudMenuItem>
                <MudMenuItem Icon="@Icons.Material.Filled.SwapHoriz" OnClick="@(() => NavManager.NavigateTo($"/inter-seta-transfers?organisationId={Id}"))">
                    Initiate Inter-SETA Transfer
                </MudMenuItem>
                <MudMenuItem Icon="@Icons.Material.Filled.AccountBalance" OnClick="@(() => NavManager.NavigateTo($"/finance/banking-details?organisationId={Id}"))">
                    Manage Banking Details
                </MudMenuItem>
                @if (_canAccessGovernance)
                {
                    <MudMenuItem Icon="@Icons.Material.Filled.Security" OnClick="@(() => NavManager.NavigateTo($"/employers/{Id}/governance"))">
                        Governance &amp; Conflict Management
                    </MudMenuItem>
                }
                <MudDivider Class="my-1" />
                <MudMenuItem Icon="@Icons.Material.Filled.PhotoCamera" OnClick="@(() => _showLogoDialog = true)">
                    Update Brand Logo
                </MudMenuItem>
                <MudMenuItem Icon="@Icons.Material.Filled.Delete" IconColor="Color.Error" OnClick="DeleteEmployer">
                    Delete Employer
                </MudMenuItem>
            </MudMenu>
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Edit"
                       OnClick="EnterEditMode"
                       aria-label="Edit Employer Record">
                Edit Employer
            </MudButton>
        </ActionZone>
    </EntityHeader>
}
else
{
    <EntityHeader Title="@(Id == 0 ? "New Employer Registration" : $"Edit {_organisation.CompanyName}")"
                  ReferenceKey="@_organisation.SdlNumber"
                  Status="@(Id == 0 ? "Draft" : "Editing")"
                  Subtitle="@(Id == 0 ? "Register a new levy-paying or non-levy paying organisation in NSDMS" : "Modify statutory organisation details, SIC codes, and contacts")"
                  BreadcrumbItems="@_breadcrumbItems">
        <ActionZone>
            <MudButton Variant="Variant.Outlined"
                       Color="Color.Secondary"
                       StartIcon="@Icons.Material.Filled.Cancel"
                       OnClick="ExitEditMode"
                       aria-label="Cancel and Return to View">
                Cancel
            </MudButton>
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Save"
                       OnClick="SaveEmployer"
                       Disabled="_isSaving"
                       aria-label="Save Employer Record">
                @(_isSaving ? "Saving..." : "Save Employer")
            </MudButton>
        </ActionZone>
    </EntityHeader>
}

<div>
    @if (_loading)
    {
        <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="my-6" />
    }
    else
    {
        <MudTabs Elevation="2" Rounded="true" ApplyEffectsToContainer="true" Color="Color.Surface" @bind-ActivePanelIndex="_activeTabIndex">
            
            <!-- TAB 1: General Master Details -->
            <MudTabPanel Text="General Master Details" Icon="@Icons.Material.Filled.Business">
                <EmployerGeneralTab Organisation="_organisation" IsEditMode="_isEditMode" />
            </MudTabPanel>

            <!-- TAB 2: Contacts, SDFs & Training Committee -->
            <MudTabPanel Text="Contacts & Committee" Icon="@Icons.Material.Filled.Group">
                <EmployerContactsTab OrganisationId="Id" OnContactUpdated="LoadMasterOnlyAsync" />
            </MudTabPanel>

            <!-- TAB 3: Corporate Governance, Directors & Shareholders (PFMA & COI Compliance) -->
            @if (Id > 0)
            {
                <MudTabPanel Text="Governance & Ownership" Icon="@Icons.Material.Filled.AccountBalance">
                    <EmployerGovernanceTab OrganisationId="Id" OrganisationName="@_organisation.CompanyName" />
                </MudTabPanel>
            }

            <!-- TAB 4: Sites & Branches -->
            <MudTabPanel Text="Sites & Branches" Icon="@Icons.Material.Filled.LocationCity">
                <EmployerSitesTab OrganisationId="Id" DefaultProvinceCode="@_organisation.ProvinceCode" />
            </MudTabPanel>

            <!-- TAB 4: Learner Ecosystem (SETMIS 500/501) -->
            <MudTabPanel Text="Learner Ecosystem" Icon="@Icons.Material.Filled.School">
                <EmployerLearnersTab OrganisationId="Id" />
            </MudTabPanel>

            <!-- TAB 5: WSP / ATR & SARS Levies -->
            <MudTabPanel Text="WSP & Levies" Icon="@Icons.Material.Filled.Assignment">
                <EmployerWspLeviesTab OrganisationId="Id" WspSubmissions="_organisation.WspSubmissions?.ToList()" />
            </MudTabPanel>

            <!-- TAB 6: Grants & MoAs (DG & MG) -->
            <MudTabPanel Text="Grants & MoAs" Icon="@Icons.Material.Filled.MonetizationOn">
                <EmployerGrantsTab OrganisationId="Id" />
            </MudTabPanel>

            <!-- TAB 7: Workplace Approvals (WPA) -->
            <MudTabPanel Text="Workplace Approvals" Icon="@Icons.Material.Filled.FactCheck">
                <EmployerWpaTab OrganisationId="Id" />
            </MudTabPanel>

            <!-- TAB 8: Site Visits & Monitoring -->
            <MudTabPanel Text="Site Visits & Monitoring" Icon="@Icons.Material.Filled.Event">
                <EmployerVisitsTab OrganisationId="Id" PrimaryContactPersonId="_organisation.PrimaryContactPersonId" />
            </MudTabPanel>

            <!-- TAB 9: Relationship Officer & Regional Portfolio -->
            @if (Id > 0)
            {
                <MudTabPanel Text="Relationship Portfolio" Icon="@Icons.Material.Filled.FolderShared">
                    <EmployerPortfolioTab OrganisationId="Id" Organisation="_organisation" />
                </MudTabPanel>
            }

            <!-- TAB 10: Evidence Vault & Audit Logs -->
            @if (Id > 0)
            {
                <MudTabPanel Text="Evidence Vault" Icon="@Icons.Material.Filled.FolderZip">
                    <Nsdms.Web.Components.Shared.DocumentVault TargetEntityName="Organisation" TargetEntityId="@Id" />
                </MudTabPanel>
            }
        </MudTabs>
    }
</div>

<!-- Brand Logo Dialog -->
<MudDialog @bind-Visible="_showLogoDialog">
    <TitleContent>
        <MudText Typo="Typo.h6">
            <MudIcon Icon="@Icons.Material.Filled.PhotoCamera" Class="mr-2" /> Update High-DPI Corporate Logo
        </MudText>
    </TitleContent>
    <DialogContent>
        <div class="d-flex flex-column align-center gap-4 py-4">
            @if (!string.IsNullOrWhiteSpace(_newLogoUri))
            {
                <img src="@_newLogoUri" alt="New Logo Preview" style="max-height: 120px; max-width: 280px; object-fit: contain;" class="rounded border pa-2" />
            }
            else if (!string.IsNullOrWhiteSpace(_logoDataUri))
            {
                <img src="@_logoDataUri" alt="Current Logo" style="max-height: 120px; max-width: 280px; object-fit: contain;" class="rounded border pa-2" />
            }
            else
            {
                <MudAvatar Color="Color.Primary" Size="Size.Large" Style="height: 80px; width: 80px;">
                    <MudIcon Icon="@Icons.Material.Filled.Business" Size="Size.Large" />
                </MudAvatar>
            }
            <MudTextField T="string" Label="Logo Image URL or Base64 Data URI" @bind-Value="_newLogoUri" Variant="Variant.Outlined" FullWidth="true" Placeholder="data:image/png;base64,... or https://..." Lines="3" HelperText="Paste high-DPI logo data URI or URL" />
            <MudTextField T="string" Label="Corporate Brand Color Hex" @bind-Value="_newBrandColor" Variant="Variant.Outlined" FullWidth="true" Placeholder="#1B365D" HelperText="Primary corporate color used in outcome certificate watermarks" />
        </div>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => _showLogoDialog = false)">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SaveBrandLogo" Disabled="@(string.IsNullOrWhiteSpace(_newLogoUri))">Save Logo</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [Parameter] public int Id { get; set; }

    private Organisation _organisation = new();
    private bool _loading = true;
    private bool _isSaving = false;
    private int _activeTabIndex = 0;
    private bool _isEditMode;
    private List<BreadcrumbItem> _breadcrumbItems = new();

    private string? _logoDataUri;
    private bool _showLogoDialog = false;
    private string _newLogoUri = string.Empty;
    private string _newBrandColor = string.Empty;
    private bool _canAccessGovernance = false;

    protected override void OnParametersSet()
    {
        _isEditMode = Id == 0 || NavManager.Uri.EndsWith("/edit", StringComparison.OrdinalIgnoreCase);
    }

    private void EnterEditMode()
    {
        _isEditMode = true;
        NavManager.NavigateTo($"/employers/{Id}/edit");
    }

    private void ExitEditMode()
    {
        if (Id == 0)
        {
            NavManager.NavigateTo("/employers");
        }
        else
        {
            _isEditMode = false;
            NavManager.NavigateTo($"/employers/{Id}");
        }
    }

    protected override async Task OnInitializedAsync()
    {
        _loading = true;
        SetupBreadcrumbs();

        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;
            if (user.Identity?.IsAuthenticated == true)
            {
                var username = user.Identity.Name ?? "Admin";
                var context = await CaslService.GetUserContextByUsernameAsync(username);
                _canAccessGovernance = context.IsAdmin ||
                                      context.Permissions.Contains(Nsdms.Domain.Security.AppPermissions.Create(Nsdms.Domain.Security.AppPermissions.ModuleGovernance, Nsdms.Domain.Security.AppPermissions.ActionView)) ||
                                      context.Permissions.Contains(Nsdms.Domain.Security.AppPermissions.Create(Nsdms.Domain.Security.AppPermissions.ModuleGovernance, Nsdms.Domain.Security.AppPermissions.ActionManage)) ||
                                      user.IsInRole("SuperAdmin") || user.IsInRole("Admin") || user.IsInRole("Executive") || user.IsInRole("Compliance") || user.IsInRole("InternalAudit") || user.IsInRole("RiskManager") || user.IsInRole("ReviewCommittee");
            }
        }
        catch
        {
            _canAccessGovernance = false;
        }

        if (Id > 0)
        {
            await LoadMasterOnlyAsync();
        }
        else
        {
            _organisation = new Organisation
            {
                SdlNumber = "L" + new Random().Next(10000000, 99999999),
                CategoryCode = "EMP",
                StatusCode = "ACT",
                ProvinceCode = "GP",
                IsActive = true
            };
        }

        _loading = false;
    }

    private async Task LoadMasterOnlyAsync()
    {
        var org = await OrgService.GetByIdAsync(Id);
        if (org != null)
        {
            _organisation = org;
            _logoDataUri = await BrandAssetService.GetLogoDataUriAsync(Id, "Organisation");
        }
        else
        {
            Snackbar.Add($"Organisation #{Id} not found.", Severity.Error);
            NavManager.NavigateTo("/employers");
        }
    }

    private void SetupBreadcrumbs()
    {
        _breadcrumbItems = new List<BreadcrumbItem>
        {
            new BreadcrumbItem("Home", href: "/"),
            new BreadcrumbItem("Employers", href: "/employers"),
            new BreadcrumbItem(Id == 0 ? "Create" : $"Employer #{Id}", href: null, disabled: true)
        };
    }

    private async Task SaveBrandLogo()
    {
        if (Id > 0 && !string.IsNullOrWhiteSpace(_newLogoUri))
        {
            await BrandAssetService.SetOrganisationBrandAsync(Id, _newLogoUri, _newBrandColor, "AdminUser");
            _logoDataUri = _newLogoUri;
            _showLogoDialog = false;
            Snackbar.Add("Corporate brand logo updated with audit log.", Severity.Success);
        }
    }

    private async Task SaveEmployer()
    {
        if (string.IsNullOrWhiteSpace(_organisation.CompanyName) || string.IsNullOrWhiteSpace(_organisation.SdlNumber))
        {
            Snackbar.Add("Organisation Name and SDL Levy Number are required.", Severity.Warning);
            return;
        }

        _isSaving = true;
        try
        {
            var saved = await OrgService.SaveAsync(_organisation, "Admin");
            Snackbar.Add($"Employer '{saved.CompanyName}' saved successfully with audit log.", Severity.Success);

            try
            {
                await ZoneService.AutoDemarcateOrganisationAsync(saved.Id, forceReassignment: false, currentUsername: "Admin");
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Auto-demarcation hook notice: {ex.Message}");
            }

            if (Id == 0)
            {
                NavManager.NavigateTo($"/employers/{saved.Id}");
            }
            else
            {
                await LoadMasterOnlyAsync();
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error saving employer: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isSaving = false;
        }
    }

    private async Task DeleteEmployer()
    {
        if (Id <= 0) return;

        var parameters = new DialogParameters<ConfirmDialog>
        {
            { x => x.Title, "Delete Organisation / Employer" },
            { x => x.Consequence, $"Are you sure you want to delete '{_organisation.CompanyName}'? This action cannot be undone and will remove all associated contact mappings, sites, and committees." },
            { x => x.ConfirmLabel, "Delete Record" },
            { x => x.IsDestructive, true }
        };
        var dialog = await DialogService.ShowAsync<ConfirmDialog>("Delete Organisation", parameters);
        var result = await dialog.Result;
        if (result == null || result.Canceled) return;

        try
        {
            var deleted = await OrgService.DeleteAsync(Id, "Admin");
            if (deleted)
            {
                Snackbar.Add("Employer record deleted successfully with audit confirmation.", Severity.Success);
                NavManager.NavigateTo("/employers");
            }
            else
            {
                Snackbar.Add("Could not delete employer record.", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error deleting record: {ex.Message}", Severity.Error);
        }
    }

    private void BackToList()
    {
        NavManager.NavigateTo("/employers");
    }
}
