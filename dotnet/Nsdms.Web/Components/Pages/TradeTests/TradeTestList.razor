@page "/tradetests"
@using Nsdms.Application.Common.Interfaces
@using Nsdms.Domain.Entities
@inject ITradeTestAndArplService TradeTestService
@inject NavigationManager Nav
@inject ISnackbar Snackbar

<PageTitle>Trade Test & ARPL Administration | merSETA NSDMS</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="my-4">
    <!-- Top Bar -->
    <MudCard Elevation="2" Class="mb-4">
        <MudCardContent Class="d-flex align-center justify-space-between py-3">
            <div>
                <MudBreadcrumbs Items="_breadcrumbs" Class="pa-0 mb-1" />
                <MudText Typo="Typo.h5" Class="fw-bold">Artisan Trade Test & ARPL Administration</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">
                    National artisan assessment scheduling, NAMB serial allocation, ARPL portfolio evaluation, and trade certification.
                </MudText>
            </div>
            <MudStack Row="true" Spacing="2">
                <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Refresh" OnClick="LoadDataAsync">
                    Refresh
                </MudButton>
            </MudStack>
        </MudCardContent>
    </MudCard>

    @if (_isLoading)
    {
        <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="mb-4" />
    }

    <!-- Filter & Master Grid -->
    <MudCard Elevation="2">
        <MudCardContent>
            <MudTable Items="_applications" Hover="true" Dense="true" Elevation="0" Filter="FilterApplications">
                <ToolBarContent>
                    <MudText Typo="Typo.h6">Trade Test Applications (@_applications.Count)</MudText>
                    <MudSpacer />
                    <MudTextField @bind-Value="_searchString" Placeholder="Search by application #, candidate, trade..." Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Medium" Class="mt-0" Immediate="true" />
                </ToolBarContent>
                <HeaderContent>
                    <MudTh>App #</MudTh>
                    <MudTh>Candidate</MudTh>
                    <MudTh>Trade Title</MudTh>
                    <MudTh>Type</MudTh>
                    <MudTh>Assessment Date</MudTh>
                    <MudTh>NAMB Serial</MudTh>
                    <MudTh>Outcome</MudTh>
                    <MudTh>Status</MudTh>
                    <MudTh Style="text-align: right;">Action</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="App #" Class="font-monospace fw-bold">@context.ApplicationNumber</MudTd>
                    <MudTd DataLabel="Candidate">@(context.Person != null ? $"{context.Person.FirstName} {context.Person.LastName}" : "Candidate")</MudTd>
                    <MudTd DataLabel="Trade Title">@context.TradeTitle</MudTd>
                    <MudTd DataLabel="Type">
                        <MudChip T="string" Size="Size.Small" Color="@(context.ApplicationTypeCode == "Section28" ? Color.Warning : Color.Info)" Variant="Variant.Outlined">
                            @context.ApplicationTypeCode
                        </MudChip>
                    </MudTd>
                    <MudTd DataLabel="Assessment Date">@(context.AssessmentDate?.ToString("yyyy-MM-dd") ?? "Unscheduled")</MudTd>
                    <MudTd DataLabel="NAMB Serial" Class="font-monospace">@(context.NambSerialNumber ?? "Pending")</MudTd>
                    <MudTd DataLabel="Outcome">
                        @if (context.CompetencyStatusCode == "Competent")
                        {
                            <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Filled">Competent</MudChip>
                        }
                        else if (context.CompetencyStatusCode == "NotYetCompetent")
                        {
                            <MudChip T="string" Size="Size.Small" Color="Color.Error" Variant="Variant.Outlined">Not Yet Competent</MudChip>
                        }
                        else
                        {
                            <MudChip T="string" Size="Size.Small" Color="Color.Default" Variant="Variant.Text">Pending</MudChip>
                        }
                    </MudTd>
                    <MudTd DataLabel="Status">
                        <MudChip T="string" Size="Size.Small" Color="@GetStatusColor(context.StatusCode)" Variant="Variant.Filled">
                            @context.StatusCode
                        </MudChip>
                    </MudTd>
                    <MudTd DataLabel="Action" Style="text-align: right;">
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" StartIcon="@Icons.Material.Filled.Visibility" OnClick="@(() => Nav.NavigateTo($"/tradetests/{context.Id}"))">
                            View / Evaluate
                        </MudButton>
                    </MudTd>
                </RowTemplate>
                <PagerContent>
                    <MudTablePager />
                </PagerContent>
            </MudTable>
        </MudCardContent>
    </MudCard>
</MudContainer>

@code {
    private List<BreadcrumbItem> _breadcrumbs = new()
    {
        new BreadcrumbItem("Home", href: "/"),
        new BreadcrumbItem("Quality Assurance", href: "/etqa/accreditation"),
        new BreadcrumbItem("Trade Tests & ARPL", href: null, disabled: true)
    };

    private List<LearnerTradeTestApplication> _applications = new();
    private bool _isLoading = true;
    private string _searchString = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        _isLoading = true;
        try
        {
            _applications = await TradeTestService.GetApplicationsAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Failed to load trade test applications: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isLoading = false;
        }
    }

    private bool FilterApplications(LearnerTradeTestApplication app)
    {
        if (string.IsNullOrWhiteSpace(_searchString)) return true;
        var personName = app.Person != null ? $"{app.Person.FirstName} {app.Person.LastName}" : "";
        return app.ApplicationNumber.Contains(_searchString, StringComparison.OrdinalIgnoreCase) ||
               app.TradeTitle.Contains(_searchString, StringComparison.OrdinalIgnoreCase) ||
               personName.Contains(_searchString, StringComparison.OrdinalIgnoreCase) ||
               (app.NambSerialNumber != null && app.NambSerialNumber.Contains(_searchString, StringComparison.OrdinalIgnoreCase));
    }

    private Color GetStatusColor(string status) => status switch
    {
        "Certified" => Color.Success,
        "Competent" => Color.Success,
        "Assessing" => Color.Warning,
        "AwaitingNambApproval" => Color.Info,
        "TradeCenterAllocated" => Color.Primary,
        "Rejected" => Color.Error,
        _ => Color.Default
    };
}
