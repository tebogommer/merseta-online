@page "/tradetests"
@using Nsdms.Application.Common.Interfaces
@using Nsdms.Domain.Entities
@using Nsdms.Web.Components.Shared
@using MudBlazor
@inject ITradeTestAndArplService TradeTestService
@inject NavigationManager Nav
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@rendermode InteractiveServer

@*
  UI-STANDARD.md Archetype: A1 / T1 (Transactional List - Artisan Trade Test & ARPL Administration)
  Clauses: 4.2, 4.3, 6.1, 7.2, 8.1, 8.3, 11.1–11.9, 15.2.5
*@

<EntityHeader Title="Artisan Trade Test &amp; ARPL Administration"
              Subtitle="National artisan assessment scheduling, NAMB serial allocation, ARPL portfolio evaluation, and trade certification"
              ReferenceKey="T1-TRADETESTS"
              Status="Active"
              BreadcrumbItems="@_breadcrumbs">
    <ActionZone>
        <MudButton Variant="Variant.Outlined" 
                   Color="Color.Secondary" 
                   StartIcon="@Icons.Material.Filled.Refresh" 
                   OnClick="LoadDataAsync"
                   aria-label="Refresh Trade Test Records">
            Refresh
        </MudButton>
        <MudButton Variant="Variant.Outlined" 
                   Color="Color.Info" 
                   StartIcon="@Icons.Material.Filled.AssignmentTurnedIn" 
                   OnClick="@(() => Nav.NavigateTo("/tradetests/cla-queue"))"
                   aria-label="CLA Review Queue">
            CLA queue
        </MudButton>
        <MudButton Variant="Variant.Outlined" 
                   Color="Color.Success" 
                   StartIcon="@Icons.Material.Filled.VerifiedUser" 
                   OnClick="@(() => Nav.NavigateTo("/tradetests/qa-queue"))"
                   aria-label="QA Approval Queue">
            QA queue
        </MudButton>
        <MudButton Variant="Variant.Outlined" 
                   Color="Color.Primary" 
                   StartIcon="@Icons.Material.Filled.Handyman" 
                   OnClick="@(() => Nav.NavigateTo("/tradetests/create?type=Section28"))"
                   aria-label="New Section 28 ARPL Candidate Application">
            Apply Section 28 (ARPL)
        </MudButton>
        <MudButton Variant="Variant.Filled" 
                   Color="Color.Primary" 
                   StartIcon="@Icons.Material.Filled.FactCheck" 
                   OnClick="@(() => Nav.NavigateTo("/tradetests/create?type=Apprenticeship"))"
                   aria-label="New Contracted Apprenticeship Trade Test">
            Apply Trade Test (26D)
        </MudButton>
    </ActionZone>
</EntityHeader>

<!-- Filter Bar (Clause 11.4) -->
<FilterBar SearchPlaceholder="Search by application #, candidate name, trade title..."
           @bind-SearchText="_searchString"
           OnSearch="HandleFilterChanged"
           OnClear="ClearFilters">
    <FilterContent>
        <MudSelect T="string" 
                   Label="Application Type" 
                   @bind-Value="_typeFilter" 
                   @bind-Value:after="HandleFilterChanged"
                   Variant="Variant.Outlined" 
                   Margin="Margin.Dense"
                   Dense="true">
            <MudSelectItem Value="@("All")">All Types</MudSelectItem>
            <MudSelectItem Value="@("Section28")">Section 28 (ARPL)</MudSelectItem>
            <MudSelectItem Value="@("Apprenticeship")">Apprenticeship</MudSelectItem>
        </MudSelect>

        <MudSelect T="string" 
                   Label="Competency Outcome" 
                   @bind-Value="_outcomeFilter" 
                   @bind-Value:after="HandleFilterChanged"
                   Variant="Variant.Outlined" 
                   Margin="Margin.Dense"
                   Dense="true">
            <MudSelectItem Value="@("All")">All Outcomes</MudSelectItem>
            <MudSelectItem Value="@("Competent")">Competent</MudSelectItem>
            <MudSelectItem Value="@("NotYetCompetent")">Not Yet Competent</MudSelectItem>
            <MudSelectItem Value="@("Pending")">Pending</MudSelectItem>
        </MudSelect>

        <MudSelect T="string" 
                   Label="Workflow status" 
                   @bind-Value="_statusFilter" 
                   @bind-Value:after="HandleFilterChanged"
                   Variant="Variant.Outlined" 
                   Margin="Margin.Dense"
                   Dense="true">
            <MudSelectItem Value="@("All")">All statuses</MudSelectItem>
            <MudSelectItem Value="@("Submitted")">Submitted</MudSelectItem>
            <MudSelectItem Value="@("RecommendedApplication")">Recommended (CLA)</MudSelectItem>
            <MudSelectItem Value="@("Registered")">Registered (QA)</MudSelectItem>
            <MudSelectItem Value="@("Assessing")">Assessing</MudSelectItem>
            <MudSelectItem Value="@("Competent")">Competent</MudSelectItem>
            <MudSelectItem Value="@("Certified")">Certified</MudSelectItem>
            <MudSelectItem Value="@("RejectedForResubmission")">Returned for resubmission</MudSelectItem>
            <MudSelectItem Value="@("Withdrawn")">Withdrawn</MudSelectItem>
            <MudSelectItem Value="@("Rejected")">Rejected</MudSelectItem>
        </MudSelect>
    </FilterContent>
    <ActiveFilterChips>
        @if (!string.IsNullOrWhiteSpace(_searchString))
        {
            <MudChip T="string" Size="Size.Small" OnClose="@(() => { _searchString = string.Empty; HandleFilterChanged(); })">
                Keyword: @_searchString
            </MudChip>
        }
        @if (_typeFilter != "All")
        {
            <MudChip T="string" Size="Size.Small" Color="Color.Info" OnClose="@(() => { _typeFilter = "All"; HandleFilterChanged(); })">
                Type: @_typeFilter
            </MudChip>
        }
        @if (_outcomeFilter != "All")
        {
            <MudChip T="string" Size="Size.Small" Color="Color.Success" OnClose="@(() => { _outcomeFilter = "All"; HandleFilterChanged(); })">
                Outcome: @_outcomeFilter
            </MudChip>
        }
        @if (_statusFilter != "All")
        {
            <MudChip T="string" Size="Size.Small" Color="Color.Primary" OnClose="@(() => { _statusFilter = "All"; HandleFilterChanged(); })">
                Status: @_statusFilter
            </MudChip>
        }
    </ActiveFilterChips>
</FilterBar>

<!-- Data Grid Shell (Clause 11.9) -->
<DataGridShell TItem="LearnerTradeTestApplication"
               GridKey="TradeTestRegistryGrid"
               Items="@FilteredApplications"
               IsLoading="@_isLoading"
               TotalItemsCount="@FilteredApplications.Count"
               SelectedItems="@_selectedTradeTests"
               SelectedItemsChanged="OnSelectedTradeTestsChanged"
               EmptyTitle="No Trade Test Applications Found"
               EmptyMessage="No artisan assessment applications match your active filters. Register a new candidate to begin trade test administration."
               EmptyActionLabel="New Application"
               OnEmptyAction="@(() => Nav.NavigateTo("/tradetests/create"))">
    <BulkActionBarContent>
        <MudText Typo="Typo.body2" Class="fw-bold text-white">
            @_selectedTradeTests.Count application(s) selected
        </MudText>
        <MudButton Variant="Variant.Filled" 
                   Color="Color.Surface" 
                   Size="Size.Small" 
                   StartIcon="@Icons.Material.Filled.FileDownload"
                   OnClick="ExportSelected">
            Export Selected
        </MudButton>
    </BulkActionBarContent>
    <ChildContent>
        <MudTable T="LearnerTradeTestApplication"
                  Items="@FilteredApplications"
                  Hover="true"
                  Dense="true"
                  Elevation="0"
                  MultiSelection="true"
                  @bind-SelectedItems="_selectedTradeTests"
                  Breakpoint="Breakpoint.Sm"
                  Class="border-default">
            <HeaderContent>
                <MudTh>App #</MudTh>
                <MudTh>Candidate Name</MudTh>
                <MudTh>Trade Title</MudTh>
                <MudTh>Type</MudTh>
                <MudTh>Assessment Date</MudTh>
                <MudTh>NAMB Serial</MudTh>
                <MudTh>Outcome</MudTh>
                <MudTh>Status</MudTh>
                <MudTh Style="text-align: right;">Action</MudTh>
            </HeaderContent>
            <RowTemplate>
                <!-- Key column is real hyperlink (Clause 11.1) -->
                <MudTd DataLabel="App #">
                    <a href="/tradetests/@context.Id" class="d-flex align-center gap-1 font-monospace fw-bold text-primary text-decoration-none">
                        <MudIcon Icon="@Icons.Material.Filled.FactCheck" Size="Size.Small" />
                        <span>@context.ApplicationNumber</span>
                    </a>
                </MudTd>
                <MudTd DataLabel="Candidate Name">
                    <div class="d-flex align-center gap-2">
                        <MudAvatar Color="Color.Primary" Size="Size.Small">
                            @(context.Person != null ? $"{context.Person.FirstName?[0]}{context.Person.LastName?[0]}" : "TT")
                        </MudAvatar>
                        <div>
                            <MudText Typo="Typo.body2" Class="fw-bold">
                                @(context.Person != null ? $"{context.Person.FirstName} {context.Person.LastName}" : "Candidate")
                            </MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="font-monospace">
                                @(context.Person?.RsaIdNumber ?? context.Person?.PassportNumber ?? "No ID")
                            </MudText>
                        </div>
                    </div>
                </MudTd>
                <MudTd DataLabel="Trade Title">
                    <MudText Typo="Typo.body2" Class="fw-medium">@context.TradeTitle</MudText>
                </MudTd>
                <MudTd DataLabel="Type">
                    <MudChip T="string" Size="Size.Small" Color="@(context.ApplicationTypeCode == "Section28" ? Color.Warning : Color.Info)" Variant="Variant.Outlined">
                        @context.ApplicationTypeCode
                    </MudChip>
                </MudTd>
                <MudTd DataLabel="Assessment Date">
                    @(context.AssessmentDate?.ToString("yyyy-MM-dd") ?? "Unscheduled")
                </MudTd>
                <MudTd DataLabel="NAMB Serial" Class="font-monospace">
                    @(context.NambSerialNumber ?? "Pending")
                </MudTd>
                <MudTd DataLabel="Outcome">
                    @if (context.CompetencyStatusCode == "Competent")
                    {
                        <StatusBadge Status="Competent" Size="Size.Small" />
                    }
                    else if (context.CompetencyStatusCode == "NotYetCompetent")
                    {
                        <StatusBadge Status="Declined" Size="Size.Small" />
                    }
                    else
                    {
                        <StatusBadge Status="Draft" Size="Size.Small" />
                    }
                </MudTd>
                <MudTd DataLabel="Status">
                    <StatusBadge Status="@context.StatusCode" Size="Size.Small" />
                </MudTd>
                <MudTd DataLabel="Action" Style="text-align: right;">
                    <div class="d-flex justify-end gap-1">
                        <MudTooltip Text="View / Evaluate Assessment">
                            <MudIconButton Icon="@Icons.Material.Filled.Visibility" 
                                           Color="Color.Primary" 
                                           Size="Size.Small" 
                                           OnClick="@(() => Nav.NavigateTo($"/tradetests/{context.Id}"))" 
                                           aria-label="View Assessment" />
                        </MudTooltip>
                    </div>
                </MudTd>
            </RowTemplate>
            <PagerContent>
                <!-- Fixed page size ladder (Clause 11.3.3) -->
                <MudTablePager PageSizeOptions="new int[] { 5, 10, 20, 50, 100, 250, 500 }" />
            </PagerContent>
        </MudTable>
    </ChildContent>
</DataGridShell>

@code {
    private List<LearnerTradeTestApplication> _applications = new();
    private HashSet<LearnerTradeTestApplication> _selectedTradeTests = new();
    private string _searchString = string.Empty;
    private string _typeFilter = "All";
    private string _outcomeFilter = "All";
    private string _statusFilter = "All";
    private bool _isLoading = true;

    private List<BreadcrumbItem> _breadcrumbs = new()
    {
        new BreadcrumbItem("Home", href: "/"),
        new BreadcrumbItem("Learner Lifecycle", href: null, disabled: true),
        new BreadcrumbItem("Trade Tests", href: "/tradetests")
    };

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        _isLoading = true;
        try
        {
            _applications = await TradeTestService.GetApplicationsAsync();
        }
        finally
        {
            _isLoading = false;
        }
    }

    private List<LearnerTradeTestApplication> FilteredApplications
    {
        get
        {
            var query = _applications.AsEnumerable();

            if (_typeFilter != "All")
            {
                query = query.Where(x => x.ApplicationTypeCode != null && x.ApplicationTypeCode.Equals(_typeFilter, StringComparison.OrdinalIgnoreCase));
            }

            if (_outcomeFilter != "All")
            {
                query = query.Where(x => x.CompetencyStatusCode != null && x.CompetencyStatusCode.Equals(_outcomeFilter, StringComparison.OrdinalIgnoreCase));
            }

            if (_statusFilter != "All")
            {
                query = query.Where(x => x.StatusCode != null && x.StatusCode.Equals(_statusFilter, StringComparison.OrdinalIgnoreCase));
            }

            if (!string.IsNullOrWhiteSpace(_searchString))
            {
                var s = _searchString.Trim();
                query = query.Where(x =>
                    (x.ApplicationNumber != null && x.ApplicationNumber.Contains(s, StringComparison.OrdinalIgnoreCase)) ||
                    (x.TradeTitle != null && x.TradeTitle.Contains(s, StringComparison.OrdinalIgnoreCase)) ||
                    (x.Person != null && ((x.Person.FirstName != null && x.Person.FirstName.Contains(s, StringComparison.OrdinalIgnoreCase)) || (x.Person.LastName != null && x.Person.LastName.Contains(s, StringComparison.OrdinalIgnoreCase)))) ||
                    (x.NambSerialNumber != null && x.NambSerialNumber.Contains(s, StringComparison.OrdinalIgnoreCase)));
            }

            return query.ToList();
        }
    }

    private void HandleFilterChanged()
    {
        StateHasChanged();
    }

    private void ClearFilters()
    {
        _searchString = string.Empty;
        _typeFilter = "All";
        _outcomeFilter = "All";
        _statusFilter = "All";
        StateHasChanged();
    }

    private void OnSelectedTradeTestsChanged(HashSet<LearnerTradeTestApplication> selected)
    {
        _selectedTradeTests = selected;
    }

    private void ExportSelected()
    {
        Snackbar.Add($"Exporting {_selectedTradeTests.Count} trade tests to CSV...", Severity.Info);
    }
}
