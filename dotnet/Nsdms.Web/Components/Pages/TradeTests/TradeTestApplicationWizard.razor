@page "/trade-tests/apply"
@page "/trade-tests/apply/{CompanyLearnerId:int}"
@page "/trade-tests/create"
@page "/tradetests/apply"
@page "/tradetests/create"
@using Nsdms.Application.Services
@using Nsdms.Domain.Entities
@using Nsdms.Web.Components.Shared
@using Nsdms.Web.Components.Shared.Forms
@using Nsdms.Web.Components.Shared.Wizard
@using Nsdms.Application.Common.Utilities
@using MudBlazor
@inject ITradeTestAndArplService TradeTestService
@inject ILearnerService LearnerService
@inject ITrainingProviderService ProviderService
@inject NavigationManager NavManager
@inject ISnackbar Snackbar
@inject IWizardDraftService DraftService
@rendermode InteractiveServer

<div class="mb-4">
    <div class="d-flex align-center gap-2 mb-2">
        <MudButton Variant="Variant.Text"
                   StartIcon="@Icons.Material.Filled.ArrowBack"
                   Color="Color.Default"
                   OnClick="GoBack">
            Back to Trade Tests
        </MudButton>
        <MudBreadcrumbs Items="_breadcrumbs" Separator=">" Class="pa-0 ma-0" />
    </div>
</div>

@if (_loading)
{
    <div class="d-flex justify-center align-center py-12">
        <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Large" />
    </div>
}
else if (_isSuccess)
{
    <MudCard Elevation="2" Class="pa-6 rounded-lg text-center">
        <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success" Size="Size.Large" Class="mb-3" />
        <h1 class="text-h5 font-weight-bold text-primary mb-2">Trade test application submitted</h1>
        <p class="text-body1 text-secondary mb-4">
            Statutory trade test application reference <strong class="font-mono">@_submittedAppNumber</strong> has been successfully registered and queued for NAMB moderation pre-clearance.
        </p>
        <div class="d-flex justify-center gap-3">
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.ReceiptLong"
                       OnClick="ViewSubmittedApplication">
                View trade test record
            </MudButton>
            <MudButton Variant="Variant.Outlined"
                       Color="Color.Default"
                       OnClick="GoBack">
                Return to Trade Test register
            </MudButton>
        </div>
    </MudCard>
}
else
{
    <WizardShell Title="Artisan trade test &amp; ARPL application"
                 Subtitle="Statutory Section 26D / Section 28 assessment scheduling and pre-trade clearance"
                 ActiveStepIndex="@_activeStep"
                 ActiveStepIndexChanged="OnStepChanged"
                 FinishButtonText="Submit trade test application"
                 IsBusy="@_isProcessing"
                 HasDraftToResume="@_hasDraftToResume"
                 DraftStepIndex="@_draftStepIndex"
                 DraftSavedTimeAgo="@_draftSavedTimeAgo"
                 OnResumeDraft="ResumeDraftAsync"
                 OnDiscardDraft="DiscardDraftAsync"
                 OnCancel="GoBack"
                 OnSaveDraft="SaveDraftAsync"
                 OnFinish="SubmitApplicationAsync">

        <!-- STEP 1: Candidate Route Selection -->
        <WizardStep Label="Candidate route"
                    Heading="Select candidate &amp; designated trade"
                    Description="Choose the apprentice or ARPL candidate, statutory application route, and trade classification"
                    ValidateAsync="ValidateStep1Async">
            <TradeTestApplicationFields Section="Route"
                                        Learners="@_learners"
                                        CompanyLearnerId="@_companyLearnerId"
                                        CompanyLearnerIdChanged="OnLearnerChanged"
                                        ApplicationTypeCode="@_applicationTypeCode"
                                        ApplicationTypeCodeChanged="@((val) => _applicationTypeCode = val)"
                                        TradeTitle="@_tradeTitle"
                                        TradeTitleChanged="@((val) => _tradeTitle = val)"
                                        TradeOfoCode="@_tradeOfoCode"
                                        TradeOfoCodeChanged="@((val) => _tradeOfoCode = val)"
                                        AttemptNumber="@_attemptNumber"
                                        AttemptNumberChanged="@((val) => _attemptNumber = val)"
                                        EmploymentStatus="@_employmentStatus"
                                        EmploymentStatusChanged="@((val) => _employmentStatus = val)"
                                        UnregisteredEmployerName="@_unregisteredEmployerName"
                                        UnregisteredEmployerNameChanged="@((val) => _unregisteredEmployerName = val)"
                                        QualifyingCategory="@_qualifyingCategory"
                                        QualifyingCategoryChanged="@((val) => _qualifyingCategory = val)"
                                        Specialisation="@_specialisation"
                                        SpecialisationChanged="@((val) => _specialisation = val)"
                                        HasAttemptedPreviously="@_hasAttemptedPreviously"
                                        HasAttemptedPreviouslyChanged="@((val) => _hasAttemptedPreviously = val)"
                                        PreviousCenterName="@_previousCenterName"
                                        PreviousCenterNameChanged="@((val) => _previousCenterName = val)"
                                        PreviousAttemptDate="@_previousAttemptDate"
                                        PreviousAttemptDateChanged="@((val) => _previousAttemptDate = val)"
                                        PreviousAttemptsCount="@_previousAttemptsCount"
                                        PreviousAttemptsCountChanged="@((val) => _previousAttemptsCount = val)" />
        </WizardStep>

        <!-- STEP 2: Curricular & Theory Clearance -->
        <WizardStep Label="Theory clearance"
                    Heading="Verify N2 / NCV theoretical credits"
                    Description="Confirm formal curricular subjects, TVET college completion date, and statutory educational prerequisites"
                    ValidateAsync="ValidateStep2Async">
            <TradeTestApplicationFields Section="Theory"
                                        TheoryQualificationTitle="@_theoryQualificationTitle"
                                        TheoryQualificationTitleChanged="@((val) => _theoryQualificationTitle = val)"
                                        TheoryInstitutionName="@_theoryInstitutionName"
                                        TheoryInstitutionNameChanged="@((val) => _theoryInstitutionName = val)"
                                        TheorySubjectsPassed="@_theorySubjectsPassed"
                                        TheorySubjectsPassedChanged="@((val) => _theorySubjectsPassed = val)"
                                        TheoryCompletionDate="@_theoryCompletionDate"
                                        TheoryCompletionDateChanged="@((val) => _theoryCompletionDate = val)"
                                        IsCurricularPrerequisitesMet="@_isCurricularPrerequisitesMet"
                                        IsCurricularPrerequisitesMetChanged="@((val) => _isCurricularPrerequisitesMet = val)" />
        </WizardStep>

        <!-- STEP 3: Workplace Practical Hours & Logbook -->
        <WizardStep Label="Logbook &amp; portfolio"
                    Heading="Employer logbook &amp; multi-employer portfolio"
                    Description="Verify workplace modular practical training duration, multi-employer experience portfolio, and mentor credentials"
                    ValidateAsync="ValidateStep3Async">
            <TradeTestApplicationFields Section="Logbook"
                                        ApplicationTypeCode="@_applicationTypeCode"
                                        CurrentEmployerName="@_currentEmployerName"
                                        CurrentEmployerNameChanged="@((val) => _currentEmployerName = val)"
                                        LogbookWeeksCompleted="@_logbookWeeksCompleted"
                                        LogbookWeeksCompletedChanged="@((val) => _logbookWeeksCompleted = val)"
                                        WorkplaceMentorName="@_workplaceMentorName"
                                        WorkplaceMentorNameChanged="@((val) => _workplaceMentorName = val)"
                                        MentorArtisanTradeNumber="@_mentorArtisanTradeNumber"
                                        MentorArtisanTradeNumberChanged="@((val) => _mentorArtisanTradeNumber = val)"
                                        EmployerContactPhone="@_employerContactPhone"
                                        EmployerContactPhoneChanged="@((val) => _employerContactPhone = val)"
                                        IsLogbookAttestationVerified="@_isLogbookAttestationVerified"
                                        IsLogbookAttestationVerifiedChanged="@((val) => _isLogbookAttestationVerified = val)"
                                        ExperienceDetails="@_experienceDetails"
                                        ExperienceDetailsChanged="@((val) => _experienceDetails = val)" />
        </WizardStep>

        <!-- STEP 4: Accredited Trade Test Centre (TTC) & Scheduling -->
        <WizardStep Label="Testing centre"
                    Heading="Select Trade Test Centre &amp; schedule"
                    Description="Designate accredited testing facility (filtered by trade accreditation), earliest practical examination date, and tool readiness"
                    ValidateAsync="ValidateStep4Async">
            <TradeTestApplicationFields Section="Centre"
                                        TradeTitle="@_tradeTitle"
                                        TradeOfoCode="@_tradeOfoCode"
                                        TrainingProviders="@FilteredTrainingProviders"
                                        TrainingProviderId="@_trainingProviderId"
                                        TrainingProviderIdChanged="@((val) => _trainingProviderId = val)"
                                        PreferredAssessmentDate="@_preferredAssessmentDate"
                                        PreferredAssessmentDateChanged="@((val) => _preferredAssessmentDate = val)"
                                        SubsidyCategory="@_subsidyCategory"
                                        SubsidyCategoryChanged="@((val) => _subsidyCategory = val)"
                                        IsToolAndPpeReady="@_isToolAndPpeReady"
                                        IsToolAndPpeReadyChanged="@((val) => _isToolAndPpeReady = val)" />
        </WizardStep>

        <!-- STEP 5: Statutory Document Verification Checklist -->
        <WizardStep Label="Documents"
                    Heading="Statutory document verification"
                    Description="Confirm statutory documents required for trade test registration (7 toolkit vs 6 non-toolkit trades)"
                    ValidateAsync="ValidateStep5Async">
            <TradeTestApplicationFields Section="Documents"
                                        TradeTitle="@_tradeTitle"
                                        ConfirmedDocuments="@_confirmedDocuments"
                                        ConfirmedDocumentsChanged="@((val) => _confirmedDocuments = val)" />
        </WizardStep>

        <!-- STEP 6: Review & Statutory Declaration -->
        <WizardReviewStep Heading="Application review &amp; pre-trade clearance"
                          Description="Inspect candidate credentials, verified logbook hours, and testing centre arrangements prior to dispatch"
                          ReviewGroups="@_reviewGroups"
                          OnEditStep="@((idx) => _activeStep = idx)">
            <ChildContent>
                <TradeTestApplicationFields Section="Declaration"
                                            IsPopiaAndCandidateDeclarationAccepted="@_isDeclarationAccepted"
                                            IsPopiaAndCandidateDeclarationAcceptedChanged="@((val) => _isDeclarationAccepted = val)" />
            </ChildContent>
        </WizardReviewStep>
    </WizardShell>
}

@code {
    [Parameter] public int? CompanyLearnerId { get; set; }

    private int _activeStep = 0;
    private bool _loading = true;
    private bool _isProcessing = false;
    private bool _isSuccess = false;
    private int _createdApplicationId = 0;
    private string _submittedAppNumber = string.Empty;

    // Data collections
    private List<CompanyLearner> _learners = new();
    private List<TrainingProvider> _trainingProviders = new();

    // Step 1: Candidate Route
    private int? _companyLearnerId;
    private string _applicationTypeCode = "Section26D";
    private string _tradeTitle = "Fitter and Turner";
    private string? _tradeOfoCode = "653306";
    private int _attemptNumber = 1;
    private string _employmentStatus = "Employed";
    private string? _unregisteredEmployerName;
    private ArplQualifyingCategory? _qualifyingCategory = ArplQualifyingCategory.Category1_Min3Years_N2;
    private string? _specialisation;
    private bool _hasAttemptedPreviously = false;
    private string? _previousCenterName;
    private DateTime? _previousAttemptDate;
    private int? _previousAttemptsCount = 1;

    // Step 2: Curricular & Theory
    private string _theoryQualificationTitle = "National Technical Certificate N2";
    private string _theoryInstitutionName = "Ekurhuleni East TVET College";
    private string _theorySubjectsPassed = "Mathematics N2, Engineering Science N2, Trade Theory N2, Engineering Drawing N2";
    private DateTime? _theoryCompletionDate = DateTime.UtcNow.AddMonths(-12);
    private bool _isCurricularPrerequisitesMet = true;

    // Step 3: Workplace Logbook & Portfolio
    private string _currentEmployerName = "Toyota SA Manufacturing";
    private int _logbookWeeksCompleted = 120;
    private string _workplaceMentorName = "Johan van der Merwe";
    private string? _mentorArtisanTradeNumber = "TT-NAMB-2018-0941";
    private string _employerContactPhone = "011 884 9000";
    private bool _isLogbookAttestationVerified = true;
    private List<ArplExperienceDetail> _experienceDetails = new();

    // Step 4: Centre & Scheduling
    private int? _trainingProviderId;
    private DateTime? _preferredAssessmentDate = DateTime.UtcNow.AddDays(30);
    private string _subsidyCategory = "merSETA Subsidised";
    private bool _isToolAndPpeReady = true;

    // Step 5: Documents Checklist
    private HashSet<string> _confirmedDocuments = new();

    // Step 6: Declaration
    private bool _isDeclarationAccepted = true;

    private List<TrainingProvider> FilteredTrainingProviders
    {
        get
        {
            if (_trainingProviders == null || !_trainingProviders.Any())
                return new List<TrainingProvider>();

            if (string.IsNullOrWhiteSpace(_tradeTitle))
                return _trainingProviders;

            var matching = _trainingProviders.Where(p =>
                p.Qualifications != null && p.Qualifications.Any(q =>
                    (!string.IsNullOrEmpty(q.QualificationTitle) && q.QualificationTitle.Contains(_tradeTitle, StringComparison.OrdinalIgnoreCase))
                    || _tradeTitle.Contains(q.QualificationTitle, StringComparison.OrdinalIgnoreCase)
                    || (_tradeOfoCode != null && q.SaqaQualificationId.ToString() == _tradeOfoCode)
                )
            ).ToList();

            return matching.Any() ? matching : _trainingProviders;
        }
    }

    private List<BreadcrumbItem> _breadcrumbs = new()
    {
        new BreadcrumbItem("Home", href: "/"),
        new BreadcrumbItem("Learner & artisan development", href: "/tradetests"),
        new BreadcrumbItem("Trade tests", href: "/tradetests"),
        new BreadcrumbItem("Apply for trade test", href: null, disabled: true)
    };

    private List<WizardReviewGroup> _reviewGroups = new();

    // Draft Persistence & Resume Lifecycle Engine
    private bool _hasDraftToResume = false;
    private int _draftStepIndex = 0;
    private string? _draftSavedTimeAgo;
    private string? _activeDraftKey;
    private WizardDraftSession? _loadedDraft;

    private record TradeTestDraftModel
    {
        public int? CompanyLearnerId { get; init; }
        public string ApplicationTypeCode { get; init; } = "Section26D";
        public string TradeTitle { get; init; } = "Fitter and Turner";
        public string? TradeOfoCode { get; init; } = "653306";
        public int AttemptNumber { get; init; } = 1;
        public string EmploymentStatus { get; init; } = "Employed";
        public string? UnregisteredEmployerName { get; init; }
        public ArplQualifyingCategory? QualifyingCategory { get; init; }
        public string? Specialisation { get; init; }
        public bool HasAttemptedPreviously { get; init; }
        public string? PreviousCenterName { get; init; }
        public DateTime? PreviousAttemptDate { get; init; }
        public int? PreviousAttemptsCount { get; init; }
        public string TheoryQualificationTitle { get; init; } = string.Empty;
        public string TheoryInstitutionName { get; init; } = string.Empty;
        public string TheorySubjectsPassed { get; init; } = string.Empty;
        public DateTime? TheoryCompletionDate { get; init; }
        public bool IsCurricularPrerequisitesMet { get; init; } = true;
        public string CurrentEmployerName { get; init; } = string.Empty;
        public int LogbookWeeksCompleted { get; init; } = 120;
        public string WorkplaceMentorName { get; init; } = string.Empty;
        public string? MentorArtisanTradeNumber { get; init; }
        public string EmployerContactPhone { get; init; } = string.Empty;
        public bool IsLogbookAttestationVerified { get; init; } = true;
        public List<ArplExperienceDetail>? ExperienceDetails { get; init; }
        public int? TrainingProviderId { get; init; }
        public DateTime? PreferredAssessmentDate { get; init; }
        public string SubsidyCategory { get; init; } = "merSETA Subsidised";
        public bool IsToolAndPpeReady { get; init; } = true;
        public List<string>? ConfirmedDocuments { get; init; }
        public bool IsDeclarationAccepted { get; init; } = true;
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _loading = true;
            _learners = await LearnerService.GetAllAsync();
            _trainingProviders = await ProviderService.GetAllAsync();

            if (CompanyLearnerId.HasValue && CompanyLearnerId.Value > 0)
            {
                _companyLearnerId = CompanyLearnerId.Value;
            }
            else if (_learners.Any())
            {
                _companyLearnerId = _learners.First().Id;
            }

            if (_trainingProviders.Any())
            {
                _trainingProviderId = _trainingProviders.First().Id;
            }

            UpdateReviewGroups();

            // Check for available in-progress draft for the candidate
            await CheckForActiveDraftAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error loading trade test reference data: {ex.Message}", Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private void OnStepChanged(int newStep)
    {
        _activeStep = newStep;
        UpdateReviewGroups();
    }

    private void OnLearnerChanged(int? id)
    {
        _companyLearnerId = id;
        if (id.HasValue && _learners != null)
        {
            var l = _learners.FirstOrDefault(x => x.Id == id.Value);
            if (l != null && l.Organisation != null)
            {
                _currentEmployerName = l.Organisation.CompanyName;
            }
        }
        UpdateReviewGroups();
    }

    private void UpdateReviewGroups()
    {
        var learnerName = "Not selected";
        if (_companyLearnerId.HasValue && _learners != null)
        {
            var l = _learners.FirstOrDefault(x => x.Id == _companyLearnerId.Value);
            if (l != null)
            {
                learnerName = $"{l.Person?.FirstName} {l.Person?.LastName} ({l.Person?.RsaIdNumber ?? "N/A"})";
            }
        }

        var centreName = "Not selected";
        if (_trainingProviderId.HasValue && _trainingProviders != null)
        {
            var p = _trainingProviders.FirstOrDefault(x => x.Id == _trainingProviderId.Value);
            if (p != null)
            {
                centreName = p.ProviderName;
            }
        }

        var reviewItemsStep0 = new List<WizardReviewItem>
        {
            new("Candidate learner", learnerName),
            new("Application route", _applicationTypeCode),
            new("Employment status", string.IsNullOrWhiteSpace(_unregisteredEmployerName) ? _employmentStatus : $"{_employmentStatus} ({_unregisteredEmployerName})"),
            new("Designated trade", _tradeTitle),
            new("Trade OFO code", _tradeOfoCode ?? "N/A", isMonospace: true),
            new("Attempt number", $"Attempt #{_attemptNumber}")
        };

        if (_applicationTypeCode == "Section28")
        {
            reviewItemsStep0.Add(new("ARPL category", _qualifyingCategory?.ToString() ?? "Not specified"));
            if (!string.IsNullOrWhiteSpace(_specialisation))
            {
                reviewItemsStep0.Add(new("Specialisation", _specialisation));
            }
            reviewItemsStep0.Add(new("Prior attempts", _hasAttemptedPreviously ? $"Yes ({_previousCenterName ?? "TTC"}, {_previousAttemptDate?.ToString("yyyy-MM") ?? "N/A"}, #{_previousAttemptsCount})" : "First attempt"));
        }

        var reviewItemsStep2 = new List<WizardReviewItem>
        {
            new("Current employer", _currentEmployerName),
            new("Practical duration", $"{_logbookWeeksCompleted} weeks verified"),
            new("Lead artisan mentor", _workplaceMentorName),
            new("Mentor certificate #", _mentorArtisanTradeNumber ?? "N/A", isMonospace: true),
            new("Employer phone", _employerContactPhone),
            new("Logbook attestation", _isLogbookAttestationVerified ? "Signed & Attached" : "Pending")
        };

        if (_applicationTypeCode == "Section28" && _experienceDetails.Any())
        {
            reviewItemsStep2.Insert(0, new("Experience portfolio", $"{_experienceDetails.Count} employers recorded ({_experienceDetails.Sum(x => x.YearsOfExperience):0.0} yrs total)"));
        }

        int reqDocCount = ArplTradeValidator.RequiresToolkit(_tradeTitle) ? 7 : 6;
        var reviewItemsStep4 = new List<WizardReviewItem>
        {
            new("Required documents", $"{reqDocCount} statutory documents ({(ArplTradeValidator.RequiresToolkit(_tradeTitle) ? "Toolkit Trade" : "Standard Trade")})"),
            new("Confirmed items", $"{_confirmedDocuments.Count} of {reqDocCount} verified"),
            new("Checklist status", _confirmedDocuments.Count >= reqDocCount ? "100% Compliant" : "Verification in progress")
        };

        _reviewGroups = new List<WizardReviewGroup>
        {
            new()
            {
                Title = "Candidate & Trade Route",
                Icon = Icons.Material.Filled.Person,
                TargetStepIndex = 0,
                Items = reviewItemsStep0
            },
            new()
            {
                Title = "Curricular & Theory Clearance",
                Icon = Icons.Material.Filled.School,
                TargetStepIndex = 1,
                Items = new()
                {
                    new("Qualification title", _theoryQualificationTitle),
                    new("Training institution", _theoryInstitutionName),
                    new("Subjects passed", _theorySubjectsPassed),
                    new("Completion date", _theoryCompletionDate?.ToString("yyyy-MM-dd") ?? "N/A"),
                    new("Credit prerequisite standing", _isCurricularPrerequisitesMet ? "Verified (100% compliant)" : "Non-compliant")
                }
            },
            new()
            {
                Title = "Workplace Logbook & Hours",
                Icon = Icons.Material.Filled.Work,
                TargetStepIndex = 2,
                Items = reviewItemsStep2
            },
            new()
            {
                Title = "Trade Test Centre & Scheduling",
                Icon = Icons.Material.Filled.LocationOn,
                TargetStepIndex = 3,
                Items = new()
                {
                    new("Accredited TTC", centreName),
                    new("Preferred assessment date", _preferredAssessmentDate?.ToString("yyyy-MM-dd") ?? "N/A"),
                    new("Funding subsidy", _subsidyCategory),
                    new("Tooling & PPE status", _isToolAndPpeReady ? "Fully equipped & compliant" : "Pending")
                }
            },
            new()
            {
                Title = "Statutory Document Verification",
                Icon = Icons.Material.Filled.AttachFile,
                TargetStepIndex = 4,
                Items = reviewItemsStep4
            }
        };
    }

    private Task<bool> ValidateStep1Async()
    {
        if (!_companyLearnerId.HasValue)
        {
            Snackbar.Add("Please select a registered candidate learner.", Severity.Warning);
            return Task.FromResult(false);
        }
        if (string.IsNullOrWhiteSpace(_tradeTitle))
        {
            Snackbar.Add("Designated trade title is required.", Severity.Warning);
            return Task.FromResult(false);
        }
        if (_applicationTypeCode == "Section28" && _qualifyingCategory == ArplQualifyingCategory.Category7_Min3Years_ToolkitAssessment)
        {
            if (!ArplTradeValidator.RequiresToolkit(_tradeTitle))
            {
                Snackbar.Add($"Category 7 is strictly restricted to the 17 designated toolkit trades. '{_tradeTitle}' requires prerequisites under Categories 1–6 or 8.", Severity.Warning);
                return Task.FromResult(false);
            }
        }
        return Task.FromResult(true);
    }

    private Task<bool> ValidateStep2Async()
    {
        if (string.IsNullOrWhiteSpace(_theoryQualificationTitle))
        {
            Snackbar.Add("Technical qualification title is required.", Severity.Warning);
            return Task.FromResult(false);
        }
        if (!_isCurricularPrerequisitesMet)
        {
            Snackbar.Add("Candidate must meet statutory theoretical credit prerequisites before proceeding.", Severity.Warning);
            return Task.FromResult(false);
        }
        return Task.FromResult(true);
    }

    private Task<bool> ValidateStep3Async()
    {
        if (string.IsNullOrWhiteSpace(_currentEmployerName))
        {
            Snackbar.Add("Current employer name is required.", Severity.Warning);
            return Task.FromResult(false);
        }
        if (_applicationTypeCode == "Section28")
        {
            decimal totalYears = _experienceDetails.Any() ? _experienceDetails.Sum(x => x.YearsOfExperience) : (_logbookWeeksCompleted / 52m);
            if (totalYears < 1.5m)
            {
                Snackbar.Add("Section 28 ARPL candidates must possess at least 18 months of verified practical experience.", Severity.Warning);
                return Task.FromResult(false);
            }
        }
        if (!_isLogbookAttestationVerified)
        {
            Snackbar.Add("Verified employer logbook attestation is mandatory for trade test scheduling.", Severity.Warning);
            return Task.FromResult(false);
        }
        return Task.FromResult(true);
    }

    private Task<bool> ValidateStep4Async()
    {
        if (!_trainingProviderId.HasValue)
        {
            Snackbar.Add("Please select an accredited Trade Test Centre (TTC).", Severity.Warning);
            return Task.FromResult(false);
        }
        if (!_preferredAssessmentDate.HasValue)
        {
            Snackbar.Add("Please specify a preferred assessment date.", Severity.Warning);
            return Task.FromResult(false);
        }
        return Task.FromResult(true);
    }

    private Task<bool> ValidateStep5Async()
    {
        int reqCount = ArplTradeValidator.RequiresToolkit(_tradeTitle) ? 7 : 6;
        if (_confirmedDocuments.Count < reqCount)
        {
            Snackbar.Add($"Please confirm all {reqCount} statutory documents before continuing to final review.", Severity.Warning);
            return Task.FromResult(false);
        }
        return Task.FromResult(true);
    }

    private async Task CheckForActiveDraftAsync()
    {
        try
        {
            var draft = await DraftService.GetActiveDraftAsync("TradeTestApplication", "CandidateUser");
            if (draft != null && draft.CurrentStepIndex > 0)
            {
                _loadedDraft = draft;
                _activeDraftKey = draft.DraftKey;
                _draftStepIndex = draft.CurrentStepIndex;
                var delta = DateTime.UtcNow - (draft.ModifiedAt ?? draft.CreatedAt);
                _draftSavedTimeAgo = delta.TotalHours >= 1 ? $"{(int)delta.TotalHours}h ago" : $"{(int)delta.TotalMinutes}m ago";
                _hasDraftToResume = true;
            }
        }
        catch (Exception ex)
        {
            // Non-blocking draft lookup
            Console.WriteLine($"Draft check skipped: {ex.Message}");
        }
    }

    private async Task ResumeDraftAsync()
    {
        if (_loadedDraft == null) return;

        var model = DraftService.DeserializeDraftModel<TradeTestDraftModel>(_loadedDraft);
        if (model != null)
        {
            _companyLearnerId = model.CompanyLearnerId;
            _applicationTypeCode = model.ApplicationTypeCode;
            _tradeTitle = model.TradeTitle;
            _tradeOfoCode = model.TradeOfoCode;
            _attemptNumber = model.AttemptNumber;
            _employmentStatus = model.EmploymentStatus ?? "Employed";
            _unregisteredEmployerName = model.UnregisteredEmployerName;
            _qualifyingCategory = model.QualifyingCategory ?? ArplQualifyingCategory.Category1_Min3Years_N2;
            _specialisation = model.Specialisation;
            _hasAttemptedPreviously = model.HasAttemptedPreviously;
            _previousCenterName = model.PreviousCenterName;
            _previousAttemptDate = model.PreviousAttemptDate;
            _previousAttemptsCount = model.PreviousAttemptsCount ?? 1;
            _theoryQualificationTitle = model.TheoryQualificationTitle;
            _theoryInstitutionName = model.TheoryInstitutionName;
            _theorySubjectsPassed = model.TheorySubjectsPassed;
            _theoryCompletionDate = model.TheoryCompletionDate;
            _isCurricularPrerequisitesMet = model.IsCurricularPrerequisitesMet;
            _currentEmployerName = model.CurrentEmployerName;
            _logbookWeeksCompleted = model.LogbookWeeksCompleted;
            _workplaceMentorName = model.WorkplaceMentorName;
            _mentorArtisanTradeNumber = model.MentorArtisanTradeNumber;
            _employerContactPhone = model.EmployerContactPhone;
            _isLogbookAttestationVerified = model.IsLogbookAttestationVerified;
            if (model.ExperienceDetails != null)
            {
                _experienceDetails = model.ExperienceDetails;
            }
            _trainingProviderId = model.TrainingProviderId;
            _preferredAssessmentDate = model.PreferredAssessmentDate;
            _subsidyCategory = model.SubsidyCategory;
            _isToolAndPpeReady = model.IsToolAndPpeReady;
            if (model.ConfirmedDocuments != null)
            {
                _confirmedDocuments = new HashSet<string>(model.ConfirmedDocuments);
            }
            _isDeclarationAccepted = model.IsDeclarationAccepted;

            _activeStep = _loadedDraft.CurrentStepIndex;
            _hasDraftToResume = false;
            UpdateReviewGroups();
            Snackbar.Add($"Resumed trade test application draft from Step {_activeStep + 1}.", Severity.Info);
        }
    }

    private async Task DiscardDraftAsync()
    {
        if (!string.IsNullOrWhiteSpace(_activeDraftKey))
        {
            await DraftService.DiscardDraftAsync(_activeDraftKey);
            _hasDraftToResume = false;
            _activeDraftKey = null;
            _loadedDraft = null;
            Snackbar.Add("Draft discarded. You are starting a clean trade test application.", Severity.Normal);
        }
    }

    private async Task SaveDraftAsync()
    {
        _isProcessing = true;
        try
        {
            var draftModel = new TradeTestDraftModel
            {
                CompanyLearnerId = _companyLearnerId,
                ApplicationTypeCode = _applicationTypeCode,
                TradeTitle = _tradeTitle,
                TradeOfoCode = _tradeOfoCode,
                AttemptNumber = _attemptNumber,
                EmploymentStatus = _employmentStatus,
                UnregisteredEmployerName = _unregisteredEmployerName,
                QualifyingCategory = _qualifyingCategory,
                Specialisation = _specialisation,
                HasAttemptedPreviously = _hasAttemptedPreviously,
                PreviousCenterName = _previousCenterName,
                PreviousAttemptDate = _previousAttemptDate,
                PreviousAttemptsCount = _previousAttemptsCount,
                TheoryQualificationTitle = _theoryQualificationTitle,
                TheoryInstitutionName = _theoryInstitutionName,
                TheorySubjectsPassed = _theorySubjectsPassed,
                TheoryCompletionDate = _theoryCompletionDate,
                IsCurricularPrerequisitesMet = _isCurricularPrerequisitesMet,
                CurrentEmployerName = _currentEmployerName,
                LogbookWeeksCompleted = _logbookWeeksCompleted,
                WorkplaceMentorName = _workplaceMentorName,
                MentorArtisanTradeNumber = _mentorArtisanTradeNumber,
                EmployerContactPhone = _employerContactPhone,
                IsLogbookAttestationVerified = _isLogbookAttestationVerified,
                ExperienceDetails = _experienceDetails,
                TrainingProviderId = _trainingProviderId,
                PreferredAssessmentDate = _preferredAssessmentDate,
                SubsidyCategory = _subsidyCategory,
                IsToolAndPpeReady = _isToolAndPpeReady,
                ConfirmedDocuments = _confirmedDocuments.ToList(),
                IsDeclarationAccepted = _isDeclarationAccepted
            };

            var session = await DraftService.SaveDraftAsync(
                "TradeTestApplication",
                "Artisan trade test & ARPL application",
                "/trade-tests/apply",
                "CandidateUser",
                null,
                _activeStep,
                6,
                draftModel,
                _activeDraftKey
            );

            _activeDraftKey = session.DraftKey;
            _hasDraftToResume = false;
            Snackbar.Add($"Draft saved at Step {_activeStep + 1} ('{session.DraftKey}').", Severity.Info);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Could not save draft: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isProcessing = false;
        }
    }

    private async Task SubmitApplicationAsync()
    {
        if (!_isDeclarationAccepted)
        {
            Snackbar.Add("You must accept the statutory candidate declaration before submitting.", Severity.Warning);
            return;
        }

        _isProcessing = true;
        try
        {
            var app = await TradeTestService.CreateTradeTestApplicationAsync(
                companyLearnerId: _companyLearnerId!.Value,
                tradeTitle: _tradeTitle,
                applicationTypeCode: _applicationTypeCode,
                attemptNumber: _attemptNumber,
                tradeOfoCode: _tradeOfoCode,
                preferredTrainingCenterId: _trainingProviderId,
                qualificationId: null,
                specialisation: _specialisation,
                hasAttemptedPreviously: _hasAttemptedPreviously,
                previousCenterName: _previousCenterName,
                previousAttemptDate: _previousAttemptDate,
                previousAttemptsCount: _previousAttemptsCount,
                qualifyingCategory: _qualifyingCategory,
                employmentStatus: _employmentStatus,
                unregisteredEmployerName: _unregisteredEmployerName,
                currentUsername: "CandidateUser"
            );

            _createdApplicationId = app.Id;
            _submittedAppNumber = app.ApplicationNumber;

            // If ARPL route, also record portfolio details
            if (_applicationTypeCode == "Section28")
            {
                int experienceYears = _experienceDetails.Any()
                    ? (int)Math.Round(_experienceDetails.Sum(x => x.YearsOfExperience))
                    : (_logbookWeeksCompleted / 52);

                await TradeTestService.SubmitArplEvidenceAndChecklistAsync(
                    applicationId: app.Id,
                    yearsOfExperience: Math.Max(1, experienceYears),
                    currentEmployerName: _currentEmployerName,
                    employerContactPhone: _employerContactPhone,
                    experienceDetails: _experienceDetails,
                    trainingDetails: new List<ArplTrainingDetail>(),
                    portfolioScorePercentage: 75m,
                    currentUsername: "CandidateUser"
                );
            }

            // Persist verified statutory documents
            if (_confirmedDocuments.Any())
            {
                var docTuples = _confirmedDocuments.Select(docCode => (DocTypeCode: docCode, AttachmentId: (int?)null)).ToList();
                await TradeTestService.SaveDocumentChecklistAsync(app.Id, docTuples, "CandidateUser");
            }

            // Clear submitted draft
            if (!string.IsNullOrWhiteSpace(_activeDraftKey))
            {
                await DraftService.MarkAsSubmittedAsync(_activeDraftKey);
            }

            _isSuccess = true;
            Snackbar.Add($"Trade test application '{_submittedAppNumber}' successfully registered!", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Application submission failed: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isProcessing = false;
        }
    }

    private void ViewSubmittedApplication()
    {
        NavManager.NavigateTo($"/trade-tests/{_createdApplicationId}");
    }

    private void GoBack()
    {
        NavManager.NavigateTo("/tradetests");
    }
}
