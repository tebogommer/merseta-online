@page "/"
@inject IPersonService PersonService
@inject IOrganisationService OrgService
@inject ITrainingProviderService ProviderService
@inject IWspService WspService
@inject IGrantService GrantService
@inject ILevyService LevyService
@inject IEtqaService EtqaService
@inject IWorkplaceApprovalService WpaService
@inject ILearnerService LearnerService
@inject NavigationManager Navigation

<PageTitle>Executive Dashboard - MerSETA NSDMS</PageTitle>

<div class="nsdms-dashboard">
    <!-- Main Top Header Card with H1 -->
    <MudPaper Elevation="1" Class="d-flex flex-wrap justify-space-between align-center mb-6 pa-4 pa-md-5 rounded-lg gap-4" Style="border-left: 6px solid var(--mud-palette-primary); background-color: var(--mud-palette-surface);">
        <div>
            <h1 class="font-weight-bold" style="font-size: 1.5rem; margin: 0; color: var(--mud-palette-text-primary);">MerSETA NSDMS Executive Operations Portal</h1>
            <p style="margin: 4px 0 0 0; font-size: 0.9rem; color: var(--mud-palette-text-secondary);">National Skills Development Management System &bull; Enterprise Operations &amp; Governance Hub</p>
        </div>
        <div class="d-none d-md-flex align-center gap-3">
            <MudChip T="string" Color="Color.Primary" Variant="Variant.Outlined" Size="Size.Small">Financial Year 2026/27</MudChip>
            <MudChip T="string" Color="Color.Success" Variant="Variant.Filled" Size="Size.Small">Live Operations</MudChip>
        </div>
    </MudPaper>

    <!-- Operational Metrics Section -->
    <section aria-labelledby="kpi-heading" class="mb-6">
        <MudText Typo="Typo.h5" id="kpi-heading" Class="font-weight-bold mb-4">Operational Key Metrics</MudText>
        <MudGrid Spacing="3">
            <MudItem xs="12" sm="6" md="4" lg="3">
                <a href="/employers" class="dashboard-metric-link" style="text-decoration: none; color: inherit; display: block;">
                    <MudPaper Elevation="2" Class="pa-4 rounded-lg dashboard-metric-card" Style="border-left: 4px solid var(--mud-palette-primary);">
                        <div class="d-flex align-center justify-space-between">
                            <div>
                                <MudText Typo="Typo.caption" Class="text-uppercase font-weight-bold" Color="Color.Secondary">Registered Employers</MudText>
                                <MudText Typo="Typo.h4" Class="font-weight-bold mt-1" Color="Color.Primary">@_employerCount</MudText>
                                <MudText Typo="Typo.caption" Color="Color.Success" Class="font-weight-bold">Active Levy &amp; Non-Levy</MudText>
                            </div>
                            <MudAvatar Color="Color.Primary" Variant="Variant.Outlined" Size="Size.Medium">
                                <MudIcon Icon="@Icons.Material.Filled.Business" />
                            </MudAvatar>
                        </div>
                    </MudPaper>
                </a>
            </MudItem>

            <MudItem xs="12" sm="6" md="4" lg="3">
                <a href="/learners" class="dashboard-metric-link" style="text-decoration: none; color: inherit; display: block;">
                    <MudPaper Elevation="2" Class="pa-4 rounded-lg dashboard-metric-card" Style="border-left: 4px solid var(--mud-palette-success);">
                        <div class="d-flex align-center justify-space-between">
                            <div>
                                <MudText Typo="Typo.caption" Class="text-uppercase font-weight-bold" Color="Color.Secondary">Active Learners</MudText>
                                <MudText Typo="Typo.h4" Class="font-weight-bold mt-1" Color="Color.Success">@_learnerCount</MudText>
                                <MudText Typo="Typo.caption" Color="Color.Success" Class="font-weight-bold">Apprentices &amp; Interns</MudText>
                            </div>
                            <MudAvatar Color="Color.Success" Variant="Variant.Outlined" Size="Size.Medium">
                                <MudIcon Icon="@Icons.Material.Filled.School" />
                            </MudAvatar>
                        </div>
                    </MudPaper>
                </a>
            </MudItem>

            <MudItem xs="12" sm="6" md="4" lg="3">
                <a href="/workplace-approvals" class="dashboard-metric-link" style="text-decoration: none; color: inherit; display: block;">
                    <MudPaper Elevation="2" Class="pa-4 rounded-lg dashboard-metric-card" Style="border-left: 4px solid var(--mud-palette-info);">
                        <div class="d-flex align-center justify-space-between">
                            <div>
                                <MudText Typo="Typo.caption" Class="text-uppercase font-weight-bold" Color="Color.Secondary">Workplace Approvals</MudText>
                                <MudText Typo="Typo.h4" Class="font-weight-bold mt-1" Color="Color.Info">@_approvalCount</MudText>
                                <MudText Typo="Typo.caption" Color="Color.Info" Class="font-weight-bold">Inspected Sites &amp; Tools</MudText>
                            </div>
                            <MudAvatar Color="Color.Info" Variant="Variant.Outlined" Size="Size.Medium">
                                <MudIcon Icon="@Icons.Material.Filled.FactCheck" />
                            </MudAvatar>
                        </div>
                    </MudPaper>
                </a>
            </MudItem>

            <MudItem xs="12" sm="6" md="4" lg="3">
                <a href="/grants" class="dashboard-metric-link" style="text-decoration: none; color: inherit; display: block;">
                    <MudPaper Elevation="2" Class="pa-4 rounded-lg dashboard-metric-card" Style="border-left: 4px solid var(--mud-palette-warning);">
                        <div class="d-flex align-center justify-space-between">
                            <div>
                                <MudText Typo="Typo.caption" Class="text-uppercase font-weight-bold" Color="Color.Secondary">DG Funding Windows</MudText>
                                <MudText Typo="Typo.h4" Class="font-weight-bold mt-1" Color="Color.Warning">@_grantCount</MudText>
                                <MudText Typo="Typo.caption" Color="Color.Warning" Class="font-weight-bold">R45.0M Allocated</MudText>
                            </div>
                            <MudAvatar Color="Color.Warning" Variant="Variant.Outlined" Size="Size.Medium">
                                <MudIcon Icon="@Icons.Material.Filled.MonetizationOn" />
                            </MudAvatar>
                        </div>
                    </MudPaper>
                </a>
            </MudItem>
        </MudGrid>
    </section>

    <!-- Operations & Modules Section -->
    <section aria-labelledby="modules-heading" class="mb-6">
        <MudText Typo="Typo.h5" id="modules-heading" Class="font-weight-bold mb-4">Core Operational Modules</MudText>
        <MudGrid Spacing="3">
            <MudItem xs="12" sm="6" md="4">
                <MudCard Elevation="2" Class="pa-4 rounded-lg h-100 d-flex flex-column justify-space-between">
                    <div>
                        <div class="d-flex align-center gap-3 mb-3">
                            <MudAvatar Color="Color.Primary" Variant="Variant.Filled" Size="Size.Small">
                                <MudIcon Icon="@Icons.Material.Filled.People" />
                            </MudAvatar>
                            <div>
                                <MudText Typo="Typo.subtitle1" Class="font-weight-bold">People &amp; Demographics</MudText>
                                <MudText Typo="Typo.caption" Color="Color.Secondary">RSA ID Validated Records</MudText>
                            </div>
                        </div>
                        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4">
                            Manage individual master profiles, contacts, SDFs, assessors, and demographic classifications with real-time Luhn algorithm validation.
                        </MudText>
                    </div>
                    <div>
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" Href="/people" EndIcon="@Icons.Material.Filled.ArrowForward">
                            View People
                        </MudButton>
                    </div>
                </MudCard>
            </MudItem>

            <MudItem xs="12" sm="6" md="4">
                <MudCard Elevation="2" Class="pa-4 rounded-lg h-100 d-flex flex-column justify-space-between">
                    <div>
                        <div class="d-flex align-center gap-3 mb-3">
                            <MudAvatar Color="Color.Success" Variant="Variant.Filled" Size="Size.Small">
                                <MudIcon Icon="@Icons.Material.Filled.Domain" />
                            </MudAvatar>
                            <div>
                                <MudText Typo="Typo.subtitle1" Class="font-weight-bold">Skills Development Providers</MudText>
                                <MudText Typo="Typo.caption" Color="Color.Secondary">SDP &amp; TVET Accreditation</MudText>
                            </div>
                        </div>
                        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4">
                            Track provider accreditation status, SAQA qualifications, unit standards, maximum learner capacity, and ETQA decision approvals.
                        </MudText>
                    </div>
                    <div>
                        <MudButton Variant="Variant.Filled" Color="Color.Success" Size="Size.Small" Href="/sdp" EndIcon="@Icons.Material.Filled.ArrowForward">
                            View Providers
                        </MudButton>
                    </div>
                </MudCard>
            </MudItem>

            <MudItem xs="12" sm="6" md="4">
                <MudCard Elevation="2" Class="pa-4 rounded-lg h-100 d-flex flex-column justify-space-between">
                    <div>
                        <div class="d-flex align-center gap-3 mb-3">
                            <MudAvatar Color="Color.Info" Variant="Variant.Filled" Size="Size.Small">
                                <MudIcon Icon="@Icons.Material.Filled.Description" />
                            </MudAvatar>
                            <div>
                                <MudText Typo="Typo.subtitle1" Class="font-weight-bold">WSP &amp; Mandatory Grants</MudText>
                                <MudText Typo="Typo.caption" Color="Color.Secondary">Workplace Skills Plans (FinYear 2026)</MudText>
                            </div>
                        </div>
                        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4">
                            Review annual WSP submissions, OFO demographic summaries, planned training budgets, and statutory mandatory grant disbursements.
                        </MudText>
                    </div>
                    <div>
                        <MudButton Variant="Variant.Filled" Color="Color.Info" Size="Size.Small" Href="/wsp" EndIcon="@Icons.Material.Filled.ArrowForward">
                            View WSP Submissions
                        </MudButton>
                    </div>
                </MudCard>
            </MudItem>

            <MudItem xs="12" sm="6" md="4">
                <MudCard Elevation="2" Class="pa-4 rounded-lg h-100 d-flex flex-column justify-space-between">
                    <div>
                        <div class="d-flex align-center gap-3 mb-3">
                            <MudAvatar Color="Color.Warning" Variant="Variant.Filled" Size="Size.Small">
                                <MudIcon Icon="@Icons.Material.Filled.AccountBalanceWallet" />
                            </MudAvatar>
                            <div>
                                <MudText Typo="Typo.subtitle1" Class="font-weight-bold">SARS Monthly Levies</MudText>
                                <MudText Typo="Typo.caption" Color="Color.Secondary">Levy Split Breakdown Engine</MudText>
                            </div>
                        </div>
                        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4">
                            Automated statutory calculation (20% Mandatory, 49.5% DG, 10.5% Admin, 0.5% QCTO) and SDL payment reconciliation against SARS monthly files.
                        </MudText>
                    </div>
                    <div>
                        <MudButton Variant="Variant.Filled" Color="Color.Warning" Size="Size.Small" Href="/levies" EndIcon="@Icons.Material.Filled.ArrowForward">
                            View Levies
                        </MudButton>
                    </div>
                </MudCard>
            </MudItem>

            <MudItem xs="12" sm="6" md="4">
                <MudCard Elevation="2" Class="pa-4 rounded-lg h-100 d-flex flex-column justify-space-between">
                    <div>
                        <div class="d-flex align-center gap-3 mb-3">
                            <MudAvatar Color="Color.Error" Variant="Variant.Filled" Size="Size.Small">
                                <MudIcon Icon="@Icons.Material.Filled.VerifiedUser" />
                            </MudAvatar>
                            <div>
                                <MudText Typo="Typo.subtitle1" Class="font-weight-bold">ETQA &amp; Trade Testing</MudText>
                                <MudText Typo="Typo.caption" Color="Color.Secondary">Quality Assurance &amp; Certification</MudText>
                            </div>
                        </div>
                        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4">
                            Register and monitor registered assessors, moderators, scope registrations, trade test attempts, serial certificate numbers, and competency results.
                        </MudText>
                    </div>
                    <div>
                        <MudButton Variant="Variant.Filled" Color="Color.Error" Size="Size.Small" Href="/trade-tests" EndIcon="@Icons.Material.Filled.ArrowForward">
                            View Trade Tests
                        </MudButton>
                    </div>
                </MudCard>
            </MudItem>

            <MudItem xs="12" sm="6" md="4">
                <MudCard Elevation="2" Class="pa-4 rounded-lg h-100 d-flex flex-column justify-space-between">
                    <div>
                        <div class="d-flex align-center gap-3 mb-3">
                            <MudAvatar Color="Color.Dark" Variant="Variant.Filled" Size="Size.Small">
                                <MudIcon Icon="@Icons.Material.Filled.Settings" />
                            </MudAvatar>
                            <div>
                                <MudText Typo="Typo.subtitle1" Class="font-weight-bold">System Lookups &amp; Config</MudText>
                                <MudText Typo="Typo.caption" Color="Color.Secondary">Master Lookup Types (17 Types)</MudText>
                            </div>
                        </div>
                        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4">
                            Manage standardized lookup tables including Province, Sector, Chamber, Gender, Equity, Citizen, Disability, and Accreditation types.
                        </MudText>
                    </div>
                    <div>
                        <MudButton Variant="Variant.Filled" Color="Color.Dark" Size="Size.Small" Href="/admin/lookups" EndIcon="@Icons.Material.Filled.ArrowForward">
                            Manage Lookups
                        </MudButton>
                    </div>
                </MudCard>
            </MudItem>
        </MudGrid>
    </section>
</div>

<style>
    .dashboard-metric-card {
        transition: transform 0.2s ease-in-out, box-shadow 0.2s ease-in-out;
    }
    .dashboard-metric-card:hover, .dashboard-metric-card:focus {
        transform: translateY(-3px);
        box-shadow: 0 8px 24px rgba(0, 0, 0, 0.18) !important;
    }
</style>

@code {
    private int _employerCount = 0;
    private int _learnerCount = 0;
    private int _approvalCount = 0;
    private int _grantCount = 0;

    protected override async Task OnInitializedAsync()
    {
        var orgs = await OrgService.GetAllAsync();
        _employerCount = orgs.Count;

        var learners = await LearnerService.GetAllLearnersAsync();
        _learnerCount = learners.Count;

        var approvals = await WpaService.GetAllAsync();
        _approvalCount = approvals.Count;

        var grants = await GrantService.GetAllApplicationsAsync();
        _grantCount = grants.Count;
    }
}
