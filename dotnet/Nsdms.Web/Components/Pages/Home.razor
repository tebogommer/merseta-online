@page "/"
@using Nsdms.Application.Services
@using Nsdms.Domain.Entities
@using Nsdms.Web.Components.Shared
@inject IPersonService PersonService
@inject IOrganisationService OrgService
@inject ITrainingProviderService ProviderService
@inject IWspService WspService
@inject IGrantService GrantService
@inject ILevyService LevyService
@inject IEtqaService EtqaService
@inject IWorkplaceApprovalService WpaService
@inject ILearnerService LearnerService
@inject IWorkflowEngineService WorkflowService
@inject NavigationManager Navigation

@*
  UI-STANDARD.md Archetype: A5 (Dashboard / Executive Operations Portal)
  Focus: Operational intelligence, SLA urgent queues, and executive action items.
*@

<PageTitle>Executive Operations Portal - MerSETA NSDMS</PageTitle>

<EntityHeader Title="Executive Operations Portal"
              Subtitle="National Skills Development Management System • Enterprise Governance &amp; Action Matrix"
              ReferenceKey="A5-OPERATIONS"
              Status="Active"
              BreadcrumbItems="@_breadcrumbItems">
    <ActionZone>
        <MudChip T="string" Color="Color.Primary" Variant="Variant.Outlined" Size="Size.Small">
            Financial Year 2026/27
        </MudChip>
        <MudButton Variant="Variant.Filled" 
                   Color="Color.Primary" 
                   StartIcon="@Icons.Material.Filled.Inbox" 
                   OnClick="@(() => Navigation.NavigateTo("/tasks"))">
            Universal Task Inbox
        </MudButton>
    </ActionZone>
</EntityHeader>

<!-- Operational KPI Stat Cards (Clause 4.4) -->
<section aria-labelledby="kpi-heading" class="mb-6">
    <div class="d-flex align-center justify-space-between mb-3">
        <MudText Typo="Typo.h6" id="kpi-heading" Class="fw-bold">
            Operational Key Metrics &amp; Registries
        </MudText>
        <MudText Typo="Typo.caption" Color="Color.Secondary">
            Updated in real time &bull; Current Fiscal Year
        </MudText>
    </div>
    <StatCardRow>
        <StatCard Value="@_employerCount.ToString("N0")"
                  Label="Registered Organisations"
                  Context="Active Levy &amp; Non-Levy"
                  TrendColor="Color.Primary"
                  Href="/employers" />
        <StatCard Value="@_learnerCount.ToString("N0")"
                  Label="Active Learners"
                  Context="In Training &amp; Apprenticeships"
                  TrendColor="Color.Success"
                  Href="/learners" />
        <StatCard Value="@_providerCount.ToString("N0")"
                  Label="Accredited SDPs"
                  Context="Primary &amp; Secondary Scope"
                  TrendColor="Color.Info"
                  Href="/sdp" />
        <StatCard Value="@_grantCount.ToString("N0")"
                  Label="DG Grant Applications"
                  Context="Strategic Skills Projects"
                  TrendColor="Color.Warning"
                  Href="/grants" />
    </StatCardRow>
</section>

<!-- WHAT REQUIRES MANAGEMENT ATTENTION? Action Queues & SLA Status -->
<MudGrid Spacing="3" Class="mb-6">
    <!-- Left Column: Items Approaching SLA & Critical Authorisations -->
    <MudItem xs="12" lg="8">
        <MudCard Elevation="0" Class="border-default rounded-lg" style="border: 1px solid var(--mud-palette-lines-default);">
            <MudCardHeader Class="pb-2">
                <CardHeaderAvatar>
                    <MudAvatar Color="Color.Warning" Variant="Variant.Filled" Size="Size.Small">
                        <MudIcon Icon="@Icons.Material.Filled.AssignmentLate" Size="Size.Small" />
                    </MudAvatar>
                </CardHeaderAvatar>
                <CardHeaderContent>
                    <MudText Typo="Typo.subtitle1" Class="fw-bold">Applications Awaiting Action &amp; Approaching SLA</MudText>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Prioritized by governance SLA deadline and workflow stage</MudText>
                </CardHeaderContent>
                <CardHeaderActions>
                    <MudButton Variant="Variant.Text" Color="Color.Primary" Size="Size.Small" Href="/tasks" EndIcon="@Icons.Material.Filled.ArrowForward">
                        View All Tasks
                    </MudButton>
                </CardHeaderActions>
            </MudCardHeader>
            <MudCardContent Class="pt-0">
                <MudTable Items="@_actionItems" Hover="true" Dense="true" Elevation="0">
                    <HeaderContent>
                        <MudTh>Application / Entity</MudTh>
                        <MudTh>Process Category</MudTh>
                        <MudTh>Stage / Gate</MudTh>
                        <MudTh>SLA Deadline</MudTh>
                        <MudTh Style="text-align:right">Action</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="Entity">
                            <a href="@context.TargetUrl" class="fw-bold text-primary text-decoration-none">
                                @context.EntityTitle
                            </a>
                            <span class="d-block font-monospace text-secondary" style="font-size: 0.75rem;">@context.ReferenceNumber</span>
                        </MudTd>
                        <MudTd DataLabel="Process">
                            <MudText Typo="Typo.caption" Class="fw-bold">@context.ProcessName</MudText>
                        </MudTd>
                        <MudTd DataLabel="Stage">
                            <StatusBadge Status="@context.CurrentStage" Size="Size.Small" />
                        </MudTd>
                        <MudTd DataLabel="SLA Deadline">
                            @if (context.IsOverdue)
                            {
                                <MudChip T="string" Color="Color.Error" Size="Size.Small" Variant="Variant.Filled" Icon="@Icons.Material.Filled.Warning">
                                    Overdue (@context.DaysRemaining days)
                                </MudChip>
                            }
                            else if (context.IsDueSoon)
                            {
                                <MudChip T="string" Color="Color.Warning" Size="Size.Small" Variant="Variant.Filled" Icon="@Icons.Material.Filled.AccessTime">
                                    Due in @context.DaysRemaining days
                                </MudChip>
                            }
                            else
                            {
                                <MudText Typo="Typo.caption" Color="Color.Secondary">@context.DaysRemaining days remaining</MudText>
                            }
                        </MudTd>
                        <MudTd Style="text-align:right" DataLabel="Action">
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" Href="@context.TargetUrl">
                                Review
                            </MudButton>
                        </MudTd>
                    </RowTemplate>
                </MudTable>
            </MudCardContent>
        </MudCard>
    </MudItem>

    <!-- Right Column: Operational Health & Fast Drill-Downs -->
    <MudItem xs="12" lg="4">
        <!-- Quick Action Shortcuts -->
        <MudCard Elevation="0" Class="border-default rounded-lg mb-4" style="border: 1px solid var(--mud-palette-lines-default);">
            <MudCardHeader Class="pb-2">
                <CardHeaderAvatar>
                    <MudAvatar Color="Color.Primary" Variant="Variant.Filled" Size="Size.Small">
                        <MudIcon Icon="@Icons.Material.Filled.Bolt" Size="Size.Small" />
                    </MudAvatar>
                </CardHeaderAvatar>
                <CardHeaderContent>
                    <MudText Typo="Typo.subtitle1" Class="fw-bold">Executive Actions</MudText>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Frequent operational tasks</MudText>
                </CardHeaderContent>
            </MudCardHeader>
            <MudCardContent Class="pt-0">
                <div class="d-flex flex-column gap-2">
                    <MudButton Variant="Variant.Outlined" Color="Color.Primary" FullWidth="true" Class="justify-start" StartIcon="@Icons.Material.Filled.PersonAdd" Href="/people/create">
                        Register New Person
                    </MudButton>
                    <MudButton Variant="Variant.Outlined" Color="Color.Success" FullWidth="true" Class="justify-start" StartIcon="@Icons.Material.Filled.Business" Href="/employers">
                        Review Employer Registrations
                    </MudButton>
                    <MudButton Variant="Variant.Outlined" Color="Color.Info" FullWidth="true" Class="justify-start" StartIcon="@Icons.Material.Filled.School" Href="/sdp/create">
                        New SDP Accreditation
                    </MudButton>
                    <MudButton Variant="Variant.Outlined" Color="Color.Warning" FullWidth="true" Class="justify-start" StartIcon="@Icons.Material.Filled.AccountBalance" Href="/finance/banking-details">
                        Authorize Banking Details
                    </MudButton>
                </div>
            </MudCardContent>
        </MudCard>

        <!-- Compliance & Governance Summary -->
        <MudCard Elevation="0" Class="border-default rounded-lg" style="border: 1px solid var(--mud-palette-lines-default);">
            <MudCardHeader Class="pb-2">
                <CardHeaderAvatar>
                    <MudAvatar Color="Color.Dark" Variant="Variant.Filled" Size="Size.Small">
                        <MudIcon Icon="@Icons.Material.Filled.Shield" Size="Size.Small" />
                    </MudAvatar>
                </CardHeaderAvatar>
                <CardHeaderContent>
                    <MudText Typo="Typo.subtitle1" Class="fw-bold">Statutory Governance</MudText>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">SETMIS &amp; DHET Compliance</MudText>
                </CardHeaderContent>
            </MudCardHeader>
            <MudCardContent Class="pt-0">
                <div class="d-flex flex-column gap-3">
                    <div class="d-flex justify-space-between align-center">
                        <span style="font-size: 0.8125rem;">SETMIS File 400 (Person)</span>
                        <MudChip T="string" Color="Color.Success" Size="Size.Small" Variant="Variant.Text">Compliant</MudChip>
                    </div>
                    <div class="d-flex justify-space-between align-center">
                        <span style="font-size: 0.8125rem;">SETMIS File 505 (Trade Test)</span>
                        <MudChip T="string" Color="Color.Success" Size="Size.Small" Variant="Variant.Text">Compliant</MudChip>
                    </div>
                    <div class="d-flex justify-space-between align-center">
                        <span style="font-size: 0.8125rem;">POPIA Consent Records</span>
                        <MudChip T="string" Color="Color.Success" Size="Size.Small" Variant="Variant.Text">100% Captured</MudChip>
                    </div>
                    <div class="d-flex justify-space-between align-center">
                        <span style="font-size: 0.8125rem;">SARS Levy File Reconciliations</span>
                        <MudChip T="string" Color="Color.Info" Size="Size.Small" Variant="Variant.Text">In Progress</MudChip>
                    </div>
                </div>
            </MudCardContent>
        </MudCard>
    </MudItem>
</MudGrid>

@code {
    private int _employerCount = 0;
    private int _learnerCount = 0;
    private int _providerCount = 0;
    private int _grantCount = 0;

    private List<DashboardActionItem> _actionItems = new();

    private List<BreadcrumbItem> _breadcrumbItems = new()
    {
        new BreadcrumbItem("Home", href: "/"),
        new BreadcrumbItem("Executive Operations", href: null, disabled: true)
    };

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var orgs = await OrgService.GetAllAsync();
            _employerCount = orgs.Count;

            var learners = await LearnerService.GetAllLearnersAsync();
            _learnerCount = learners.Count;

            var providers = await ProviderService.GetAllAsync();
            _providerCount = providers.Count;

            var grants = await GrantService.GetAllAsync();
            _grantCount = grants.Count;

            // Operational Action Queues
            _actionItems = new List<DashboardActionItem>
            {
                new()
                {
                    EntityTitle = "Apex Technical Academy",
                    ReferenceNumber = "SDP-2026-0812",
                    ProcessName = "Provider Accreditation",
                    CurrentStage = "Site Audit Scheduled",
                    DaysRemaining = 3,
                    IsDueSoon = true,
                    IsOverdue = false,
                    TargetUrl = "/sdp"
                },
                new()
                {
                    EntityTitle = "Sasol Synfuels Secunda",
                    ReferenceNumber = "WSP-2026-0042",
                    ProcessName = "Workplace Skills Plan",
                    CurrentStage = "Under Review",
                    DaysRemaining = -1,
                    IsDueSoon = false,
                    IsOverdue = true,
                    TargetUrl = "/wsp"
                },
                new()
                {
                    EntityTitle = "Scaw Metals Heavy Foundry",
                    ReferenceNumber = "DG-2026-0199",
                    ProcessName = "Discretionary Grant",
                    CurrentStage = "Committee Review",
                    DaysRemaining = 5,
                    IsDueSoon = false,
                    IsOverdue = false,
                    TargetUrl = "/grants"
                },
                new()
                {
                    EntityTitle = "First National Bank (FNB)",
                    ReferenceNumber = "BNK-2026-0018",
                    ProcessName = "Banking Details Approval",
                    CurrentStage = "Pending Signoff",
                    DaysRemaining = 1,
                    IsDueSoon = true,
                    IsOverdue = false,
                    TargetUrl = "/finance/banking-details"
                }
            };
        }
        catch
        {
            // Graceful fallback during prerendering
        }
    }

    private class DashboardActionItem
    {
        public string EntityTitle { get; set; } = string.Empty;
        public string ReferenceNumber { get; set; } = string.Empty;
        public string ProcessName { get; set; } = string.Empty;
        public string CurrentStage { get; set; } = string.Empty;
        public int DaysRemaining { get; set; }
        public bool IsDueSoon { get; set; }
        public bool IsOverdue { get; set; }
        public string TargetUrl { get; set; } = string.Empty;
    }
}
