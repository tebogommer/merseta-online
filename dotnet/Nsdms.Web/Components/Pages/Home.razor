@page "/"
@page "/dashboard"
@using Microsoft.EntityFrameworkCore
@using Nsdms.Application.Common
@using Nsdms.Application.Services
@using Nsdms.Domain.Entities
@using Nsdms.Web.Components.Shared
@inject IAnalyticsService AnalyticsService
@inject NavigationManager Navigation
@inject ILogger<Home> Logger
@inject AuthenticationStateProvider AuthStateProvider

@*
  UI-STANDARD.md Archetype: A5 (Dashboard / Executive Operations Portal & Applicant Portal)
  Focus: Operational intelligence, SLA urgent queues, and executive action items for admins; Stakeholder application portal for standard users.
*@

@if (_isStandardUserOnly)
{
    <PageTitle>Stakeholder Registration &amp; Applicant Portal - MerSETA NSDMS</PageTitle>

    <EntityHeader Title="Stakeholder Registration &amp; Applications"
                  Subtitle="Apply for statutory stakeholder roles including SDF, SDP Provider, Organisation Contact, Assessor, or Moderator"
                  ReferenceKey="STAKEHOLDER-PORTAL"
                  Status="Applicant Active"
                  BreadcrumbItems="@_breadcrumbItems">
        <ActionZone>
            <MudChip T="string" Color="Color.Info" Variant="Variant.Filled" Size="Size.Small">
                Role: Standard User
            </MudChip>
        </ActionZone>
    </EntityHeader>

    <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="mb-6 rounded-lg">
        <div class="d-flex flex-column">
            <span class="font-weight-bold mb-1">Welcome to the merSETA National Skills Development Management System.</span>
            <span>Your personal profile is registered with standard user permissions. Use the statutory applications below to apply for official stakeholder recognition. Once verified by merSETA, your administrative privileges and linked organisation workspaces will be activated automatically.</span>
        </div>
    </MudAlert>

    <div class="d-flex align-center justify-space-between mb-3">
        <MudText Typo="Typo.h6" Class="fw-bold">Available Stakeholder Applications</MudText>
        <MudText Typo="Typo.caption" Color="Color.Secondary">Select an application category to proceed</MudText>
    </div>

    <MudGrid Spacing="3" Class="mb-6">
        <!-- 1. SDF Appointment -->
        <MudItem xs="12" md="6" lg="4">
            <MudCard Elevation="2" Class="rounded-lg h-100 d-flex flex-column justify-space-between" Style="border: 1px solid var(--mud-palette-lines-default);">
                <MudCardContent>
                    <div class="d-flex align-center gap-2 mb-3">
                        <MudAvatar Color="Color.Primary" Variant="Variant.Filled" Size="Size.Medium">
                            <MudIcon Icon="@Icons.Material.Filled.Work" Size="Size.Small" />
                        </MudAvatar>
                        <div>
                            <MudText Typo="Typo.subtitle1" Class="fw-bold">Skills Development Facilitator</MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">SDF Appointment</MudText>
                        </div>
                    </div>
                    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-3">
                        Appoint as Primary, Secondary, or Labour SDF for a participating levy-paying employer to submit WSP/ATR and manage grant allocations.
                    </MudText>
                </MudCardContent>
                <MudCardActions Class="pa-4 pt-0">
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" Href="/employers/sdf/create" StartIcon="@Icons.Material.Filled.AssignmentInd">
                        Apply to be an SDF
                    </MudButton>
                </MudCardActions>
            </MudCard>
        </MudItem>

        <!-- 2. SDP Provider / Contact -->
        <MudItem xs="12" md="6" lg="4">
            <MudCard Elevation="2" Class="rounded-lg h-100 d-flex flex-column justify-space-between" Style="border: 1px solid var(--mud-palette-lines-default);">
                <MudCardContent>
                    <div class="d-flex align-center gap-2 mb-3">
                        <MudAvatar Color="Color.Info" Variant="Variant.Filled" Size="Size.Medium">
                            <MudIcon Icon="@Icons.Material.Filled.School" Size="Size.Small" />
                        </MudAvatar>
                        <div>
                            <MudText Typo="Typo.subtitle1" Class="fw-bold">Skills Development Provider</MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">SDP Contact &amp; Accreditation</MudText>
                        </div>
                    </div>
                    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-3">
                        Apply for training provider accreditation (Primary, Secondary, or QCTO Scope) or register as a contact person for an accredited training academy.
                    </MudText>
                </MudCardContent>
                <MudCardActions Class="pa-4 pt-0">
                    <MudButton Variant="Variant.Filled" Color="Color.Info" FullWidth="true" Href="/providers/apply-accreditation" StartIcon="@Icons.Material.Filled.AccountBalance">
                        Apply for SDP Accreditation
                    </MudButton>
                </MudCardActions>
            </MudCard>
        </MudItem>

        <!-- 3. Organisation Contact -->
        <MudItem xs="12" md="6" lg="4">
            <MudCard Elevation="2" Class="rounded-lg h-100 d-flex flex-column justify-space-between" Style="border: 1px solid var(--mud-palette-lines-default);">
                <MudCardContent>
                    <div class="d-flex align-center gap-2 mb-3">
                        <MudAvatar Color="Color.Secondary" Variant="Variant.Filled" Size="Size.Medium">
                            <MudIcon Icon="@Icons.Material.Filled.Business" Size="Size.Small" />
                        </MudAvatar>
                        <div>
                            <MudText Typo="Typo.subtitle1" Class="fw-bold">Organisation Contact</MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">Employer Official Designation</MudText>
                        </div>
                    </div>
                    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-3">
                        Register as an authorized contact person (CEO, HR Director, Finance Lead, or Workshop Manager) linked to a registered employer entity.
                    </MudText>
                </MudCardContent>
                <MudCardActions Class="pa-4 pt-0">
                    <MudButton Variant="Variant.Filled" Color="Color.Secondary" FullWidth="true" Href="/employers/sdf/create?type=contact" StartIcon="@Icons.Material.Filled.PersonAddAlt1">
                        Register as Organisation Contact
                    </MudButton>
                </MudCardActions>
            </MudCard>
        </MudItem>

        <!-- 4. Assessor Application -->
        <MudItem xs="12" md="6" lg="6">
            <MudCard Elevation="2" Class="rounded-lg h-100 d-flex flex-column justify-space-between" Style="border: 1px solid var(--mud-palette-lines-default);">
                <MudCardContent>
                    <div class="d-flex align-center gap-2 mb-3">
                        <MudAvatar Color="Color.Success" Variant="Variant.Filled" Size="Size.Medium">
                            <MudIcon Icon="@Icons.Material.Filled.FactCheck" Size="Size.Small" />
                        </MudAvatar>
                        <div>
                            <MudText Typo="Typo.subtitle1" Class="fw-bold">ETQA Registered Assessor</MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">Occupational Assessment Scope</MudText>
                        </div>
                    </div>
                    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-3">
                        Submit an application for registration as an accredited constituent Assessor under merSETA ETQA scope with unit standard mapping.
                    </MudText>
                </MudCardContent>
                <MudCardActions Class="pa-4 pt-0">
                    <MudButton Variant="Variant.Filled" Color="Color.Success" FullWidth="true" Href="/etqa/register?type=Assessor" StartIcon="@Icons.Material.Filled.HowToReg">
                        Apply to be an Assessor
                    </MudButton>
                </MudCardActions>
            </MudCard>
        </MudItem>

        <!-- 5. Moderator Application -->
        <MudItem xs="12" md="6" lg="6">
            <MudCard Elevation="2" Class="rounded-lg h-100 d-flex flex-column justify-space-between" Style="border: 1px solid var(--mud-palette-lines-default);">
                <MudCardContent>
                    <div class="d-flex align-center gap-2 mb-3">
                        <MudAvatar Color="Color.Warning" Variant="Variant.Filled" Size="Size.Medium">
                            <MudIcon Icon="@Icons.Material.Filled.VerifiedUser" Size="Size.Small" />
                        </MudAvatar>
                        <div>
                            <MudText Typo="Typo.subtitle1" Class="fw-bold">ETQA Registered Moderator</MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">Quality Assurance &amp; Moderation Scope</MudText>
                        </div>
                    </div>
                    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-3">
                        Apply for initial registration or scope extension as an accredited constituent Moderator for occupational qualifications and unit standards.
                    </MudText>
                </MudCardContent>
                <MudCardActions Class="pa-4 pt-0">
                    <MudButton Variant="Variant.Filled" Color="Color.Warning" FullWidth="true" Href="/etqa/register?type=Moderator" StartIcon="@Icons.Material.Filled.Security">
                        Apply to be a Moderator
                    </MudButton>
                </MudCardActions>
            </MudCard>
        </MudItem>
    </MudGrid>
}
else
{
<PageTitle>Executive Operations Portal - MerSETA NSDMS</PageTitle>

<EntityHeader Title="Executive Operations Portal"
              Subtitle="National Skills Development Management System • Enterprise Governance &amp; Action Matrix"
              ReferenceKey="A5-OPERATIONS"
              Status="Active"
              BreadcrumbItems="@_breadcrumbItems">
    <ActionZone>
        <MudChip T="string" Color="Color.Primary" Variant="Variant.Outlined" Size="Size.Small">
            Financial Year 2026/27
        </MudChip>
        <MudButton Variant="Variant.Filled" 
                   Color="Color.Primary" 
                   StartIcon="@Icons.Material.Filled.Inbox" 
                   OnClick="@(() => Navigation.NavigateTo("/tasks"))">
            Universal Task Inbox
        </MudButton>
    </ActionZone>
</EntityHeader>

<!-- Operational KPI Stat Cards (Clause 4.4) -->
<section aria-labelledby="kpi-heading" class="mb-6">
    <div class="d-flex align-center justify-space-between mb-3">
        <MudText Typo="Typo.h6" id="kpi-heading" Class="fw-bold">
            Operational Key Metrics &amp; Registries
        </MudText>
        <MudText Typo="Typo.caption" Color="Color.Secondary">
            Updated in real time &bull; Current Fiscal Year
        </MudText>
    </div>
    <StatCardRow>
        <StatCard Value="@_employerCount.ToString("N0")"
                  Label="Registered Organisations"
                  Context="Active Levy &amp; Non-Levy"
                  TrendColor="Color.Primary"
                  Href="/employers" />
        <StatCard Value="@_learnerCount.ToString("N0")"
                  Label="Active Learners"
                  Context="In Training &amp; Apprenticeships"
                  TrendColor="Color.Success"
                  Href="/learners" />
        <StatCard Value="@_providerCount.ToString("N0")"
                  Label="Accredited SDPs"
                  Context="Primary &amp; Secondary Scope"
                  TrendColor="Color.Info"
                  Href="/sdp" />
        <StatCard Value="@_grantCount.ToString("N0")"
                  Label="DG Grant Applications"
                  Context="Strategic Skills Projects"
                  TrendColor="Color.Warning"
                  Href="/dg-grants" />
    </StatCardRow>
</section>

<!-- WHAT REQUIRES MANAGEMENT ATTENTION? Action Queues & SLA Status -->
<MudGrid Spacing="3" Class="mb-6">
    <!-- Left Column: Items Approaching SLA & Critical Authorisations -->
    <MudItem xs="12" lg="8">
        <MudCard Elevation="0" Class="border-default rounded-lg" style="border: 1px solid var(--mud-palette-lines-default);">
            <MudCardHeader Class="pb-2">
                <CardHeaderAvatar>
                    <MudAvatar Color="Color.Warning" Variant="Variant.Filled" Size="Size.Small">
                        <MudIcon Icon="@Icons.Material.Filled.AssignmentLate" Size="Size.Small" />
                    </MudAvatar>
                </CardHeaderAvatar>
                <CardHeaderContent>
                    <MudText Typo="Typo.subtitle1" Class="fw-bold">Applications Awaiting Action &amp; Approaching SLA</MudText>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Prioritized by governance SLA deadline and workflow stage</MudText>
                </CardHeaderContent>
                <CardHeaderActions>
                    <MudButton Variant="Variant.Text" Color="Color.Primary" Size="Size.Small" Href="/tasks" EndIcon="@Icons.Material.Filled.ArrowForward">
                        View All Tasks
                    </MudButton>
                </CardHeaderActions>
            </MudCardHeader>
            <MudCardContent Class="pt-0">
                <MudTable Items="@_actionItems" Hover="true" Dense="true" Elevation="0">
                    <HeaderContent>
                        <MudTh>Application / Entity</MudTh>
                        <MudTh>Process Category</MudTh>
                        <MudTh>Workflow Stage</MudTh>
                        <MudTh>SLA Deadline</MudTh>
                        <MudTh Style="text-align:right">Action</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="Entity">
                            <a href="@context.TargetUrl" class="fw-bold text-primary text-decoration-none">
                                @context.EntityTitle
                            </a>
                            <span class="d-block font-monospace text-secondary" style="font-size: 0.75rem;">@context.ReferenceNumber</span>
                        </MudTd>
                        <MudTd DataLabel="Process">
                            <MudText Typo="Typo.caption" Class="fw-bold">@context.ProcessName</MudText>
                        </MudTd>
                        <MudTd DataLabel="Stage">
                            <StatusBadge Status="@context.CurrentStage" Size="Size.Small" />
                        </MudTd>
                        <MudTd DataLabel="SLA Deadline">
                            @if (context.IsOverdue)
                            {
                                <MudChip T="string" Color="Color.Error" Size="Size.Small" Variant="Variant.Filled" Icon="@Icons.Material.Filled.Warning">
                                    Overdue (@context.DaysRemaining days)
                                </MudChip>
                            }
                            else if (context.IsDueSoon)
                            {
                                <MudChip T="string" Color="Color.Warning" Size="Size.Small" Variant="Variant.Filled" Icon="@Icons.Material.Filled.AccessTime">
                                    Due in @context.DaysRemaining days
                                </MudChip>
                            }
                            else
                            {
                                <MudText Typo="Typo.caption" Color="Color.Secondary">@context.DaysRemaining days remaining</MudText>
                            }
                        </MudTd>
                        <MudTd Style="text-align:right" DataLabel="Action">
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" Href="@context.TargetUrl">
                                Review
                            </MudButton>
                        </MudTd>
                    </RowTemplate>
                    <NoRecordsContent>
                        <div class="pa-6 text-center">
                            <EmptyState Title="No Pending SLA Actions"
                                        Description="All discretionary grants and operational queues are currently up to date."
                                        Icon="@Icons.Material.Filled.TaskAlt" />
                        </div>
                    </NoRecordsContent>
                </MudTable>
            </MudCardContent>
        </MudCard>
    </MudItem>

    <!-- Right Column: Operational Health & Fast Drill-Downs -->
    <MudItem xs="12" lg="4">
        <!-- Quick Action Shortcuts -->
        <MudCard Elevation="0" Class="border-default rounded-lg mb-4" style="border: 1px solid var(--mud-palette-lines-default);">
            <MudCardHeader Class="pb-2">
                <CardHeaderAvatar>
                    <MudAvatar Color="Color.Primary" Variant="Variant.Filled" Size="Size.Small">
                        <MudIcon Icon="@Icons.Material.Filled.Bolt" Size="Size.Small" />
                    </MudAvatar>
                </CardHeaderAvatar>
                <CardHeaderContent>
                    <MudText Typo="Typo.subtitle1" Class="fw-bold">Executive Actions</MudText>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Frequent operational tasks</MudText>
                </CardHeaderContent>
            </MudCardHeader>
            <MudCardContent Class="pt-0">
                <MudList T="string" Dense="true" Class="pa-0">
                    <MudListItem T="string" Href="/people/create" Class="rounded px-3 py-2 my-1 border" Style="border-color: var(--mud-palette-lines-default); transition: background 0.15s ease;">
                        <div class="d-flex justify-space-between align-center">
                            <div class="d-flex align-center gap-3">
                                <MudIcon Icon="@Icons.Material.Outlined.PersonAdd" Color="Color.Default" Size="Size.Small" Style="opacity: 0.8;" />
                                <div>
                                    <MudText Typo="Typo.body2" Class="font-weight-medium">Register new person</MudText>
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">SETMIS File 400 demographics</MudText>
                                </div>
                            </div>
                            <MudIcon Icon="@Icons.Material.Filled.ChevronRight" Size="Size.Small" Color="Color.Secondary" />
                        </div>
                    </MudListItem>
                    <MudListItem T="string" Href="/employers" Class="rounded px-3 py-2 my-1 border" Style="border-color: var(--mud-palette-lines-default); transition: background 0.15s ease;">
                        <div class="d-flex justify-space-between align-center">
                            <div class="d-flex align-center gap-3">
                                <MudIcon Icon="@Icons.Material.Outlined.Business" Color="Color.Default" Size="Size.Small" Style="opacity: 0.8;" />
                                <div>
                                    <MudText Typo="Typo.body2" Class="font-weight-medium">Review employer registrations</MudText>
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">SDL levy-paying organisations</MudText>
                                </div>
                            </div>
                            <MudIcon Icon="@Icons.Material.Filled.ChevronRight" Size="Size.Small" Color="Color.Secondary" />
                        </div>
                    </MudListItem>
                    <MudListItem T="string" Href="/sdp/create" Class="rounded px-3 py-2 my-1 border" Style="border-color: var(--mud-palette-lines-default); transition: background 0.15s ease;">
                        <div class="d-flex justify-space-between align-center">
                            <div class="d-flex align-center gap-3">
                                <MudIcon Icon="@Icons.Material.Outlined.School" Color="Color.Default" Size="Size.Small" Style="opacity: 0.8;" />
                                <div>
                                    <MudText Typo="Typo.body2" Class="font-weight-medium">New SDP accreditation</MudText>
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">Skills development providers</MudText>
                                </div>
                            </div>
                            <MudIcon Icon="@Icons.Material.Filled.ChevronRight" Size="Size.Small" Color="Color.Secondary" />
                        </div>
                    </MudListItem>
                    <MudListItem T="string" Href="/finance/banking-details" Class="rounded px-3 py-2 my-1 border" Style="border-color: var(--mud-palette-lines-default); transition: background 0.15s ease;">
                        <div class="d-flex justify-space-between align-center">
                            <div class="d-flex align-center gap-3">
                                <MudIcon Icon="@Icons.Material.Outlined.AccountBalance" Color="Color.Default" Size="Size.Small" Style="opacity: 0.8;" />
                                <div>
                                    <MudText Typo="Typo.body2" Class="font-weight-medium">Authorise banking details</MudText>
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">Dual-signoff approval queue</MudText>
                                </div>
                            </div>
                            <MudIcon Icon="@Icons.Material.Filled.ChevronRight" Size="Size.Small" Color="Color.Secondary" />
                        </div>
                    </MudListItem>
                </MudList>
            </MudCardContent>
        </MudCard>

        <!-- Compliance & Governance Summary -->
        <MudCard Elevation="0" Class="border-default rounded-lg" style="border: 1px solid var(--mud-palette-lines-default);">
            <MudCardHeader Class="pb-2">
                <CardHeaderAvatar>
                    <MudAvatar Color="Color.Dark" Variant="Variant.Filled" Size="Size.Small">
                        <MudIcon Icon="@Icons.Material.Filled.Shield" Size="Size.Small" />
                    </MudAvatar>
                </CardHeaderAvatar>
                <CardHeaderContent>
                    <MudText Typo="Typo.subtitle1" Class="fw-bold">Statutory Governance</MudText>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">SETMIS &amp; DHET Compliance</MudText>
                </CardHeaderContent>
            </MudCardHeader>
            <MudCardContent Class="pt-0">
                <div class="d-flex flex-column gap-3">
                    <div class="d-flex justify-space-between align-center">
                        <span style="font-size: 0.8125rem;">SETMIS File 400 (Person)</span>
                        <MudChip T="string" Color="Color.Success" Size="Size.Small" Variant="Variant.Text">Compliant</MudChip>
                    </div>
                    <div class="d-flex justify-space-between align-center">
                        <span style="font-size: 0.8125rem;">SETMIS File 505 (Trade Test)</span>
                        <MudChip T="string" Color="Color.Success" Size="Size.Small" Variant="Variant.Text">Compliant</MudChip>
                    </div>
                    <div class="d-flex justify-space-between align-center">
                        <span style="font-size: 0.8125rem;">POPIA Consent Records</span>
                        <MudChip T="string" Color="Color.Success" Size="Size.Small" Variant="Variant.Text">100% Captured</MudChip>
                    </div>
                    <div class="d-flex justify-space-between align-center">
                        <span style="font-size: 0.8125rem;">SARS Levy File Reconciliations</span>
                        <MudChip T="string" Color="Color.Info" Size="Size.Small" Variant="Variant.Text">In Progress</MudChip>
                    </div>
                </div>
            </MudCardContent>
        </MudCard>
    </MudItem>
</MudGrid>
}

@code {
    private bool _isStandardUserOnly = false;
    private int _employerCount = 0;
    private int _learnerCount = 0;
    private int _providerCount = 0;
    private int _grantCount = 0;

    private List<DashboardActionItemDto> _actionItems = new();

    private List<BreadcrumbItem> _breadcrumbItems = new()
    {
        new BreadcrumbItem("Home", href: "/"),
        new BreadcrumbItem("Dashboard", href: null, disabled: true)
    };

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;
            var roles = user.FindAll(System.Security.Claims.ClaimTypes.Role).Select(c => c.Value).ToList();
            _isStandardUserOnly = roles.Contains("User") && !roles.Any(r => r is "SuperAdmin" or "Admin" or "Executive" or "CLO" or "Finance" or "FinanceManager" or "Legal" or "Compliance" or "ReviewCommittee" or "SDF");

            if (!_isStandardUserOnly)
            {
                var summary = await AnalyticsService.GetExecutiveDashboardSummaryAsync();
                _employerCount = summary.EmployerCount;
                _learnerCount = summary.LearnerCount;
                _providerCount = summary.ProviderCount;
                _grantCount = summary.GrantCount;
                _actionItems = summary.ActionItems;
            }
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Failed to load dashboard operational metrics during initialization.");
        }
    }
}
