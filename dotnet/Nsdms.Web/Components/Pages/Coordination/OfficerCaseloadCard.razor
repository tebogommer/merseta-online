@using Nsdms.Application.Common.Interfaces
@using MudBlazor
@inject IZoneAndCaseloadService ZoneService
@inject NavigationManager Navigation

<MudCard Elevation="2" Class="mb-4">
    <MudCardHeader>
        <CardHeaderContent>
            <div class="d-flex align-center justify-space-between flex-wrap gap-2">
                <div>
                    <MudText Typo="Typo.h6" Color="Color.Primary" Class="d-flex align-center gap-2">
                        <MudIcon Icon="@Icons.Material.Filled.Speed" />
                        Officer Caseload &amp; Capacity Heatmap
                    </MudText>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">
                        Real-time workload distribution, open workflow tasks, and PFMA SLA capacity tiers
                    </MudText>
                </div>
                <div class="d-flex align-center gap-2">
                    <MudSelect T="string"
                               Dense="true"
                               Margin="Margin.Dense"
                               Variant="Variant.Outlined"
                               Value="@_selectedRegion"
                               ValueChanged="OnRegionChanged"
                               Label="Filter Region"
                               Style="min-width: 220px;">
                        <MudSelectItem T="string" Value="@("")">All Regional Offices</MudSelectItem>
                        <MudSelectItem T="string" Value="@("GAUTENG_SOUTH")">Gauteng South</MudSelectItem>
                        <MudSelectItem T="string" Value="@("GAUTENG_NORTH")">Gauteng North</MudSelectItem>
                        <MudSelectItem T="string" Value="@("KZN")">KwaZulu-Natal</MudSelectItem>
                        <MudSelectItem T="string" Value="@("WESTERN_CAPE")">Western Cape</MudSelectItem>
                        <MudSelectItem T="string" Value="@("EASTERN_CAPE")">Eastern Cape</MudSelectItem>
                        <MudSelectItem T="string" Value="@("FREE_STATE_NC")">Free State &amp; NC</MudSelectItem>
                        <MudSelectItem T="string" Value="@("MPUMALANGA_LIMPOPO")">Mpumalanga &amp; Limpopo</MudSelectItem>
                    </MudSelect>
                    <MudIconButton Icon="@Icons.Material.Filled.Refresh"
                                   Size="Size.Small"
                                   OnClick="LoadHeatmapAsync"
                                   aria-label="Refresh caseload heatmap" />
                </div>
            </div>
        </CardHeaderContent>
    </MudCardHeader>
    <MudCardContent>
        @if (_isLoading)
        {
            <div class="d-flex justify-center pa-4">
                <MudProgressCircular Indeterminate="true" Color="Color.Primary" Size="Size.Medium" />
            </div>
        }
        else if (_metrics == null || _metrics.Count == 0)
        {
            <MudAlert Severity="Severity.Info" Dense="true" Class="my-2">
                No active relationship officers found for the selected region filter.
            </MudAlert>
        }
        else
        {
            <div class="d-flex flex-column gap-3">
                <div class="d-flex gap-4 flex-wrap align-center pb-2 border-b">
                    <div class="d-flex align-center gap-1">
                        <MudBadge Color="Color.Success" Dot="true" />
                        <MudText Typo="Typo.caption">Normal (&lt;60 orgs, 0 overdue): <strong>@_metrics.Count(m => m.CapacityStatus == "Normal")</strong></MudText>
                    </div>
                    <div class="d-flex align-center gap-1">
                        <MudBadge Color="Color.Warning" Dot="true" />
                        <MudText Typo="Typo.caption">Elevated (60-90 orgs): <strong>@_metrics.Count(m => m.CapacityStatus == "Elevated")</strong></MudText>
                    </div>
                    <div class="d-flex align-center gap-1">
                        <MudBadge Color="Color.Error" Dot="true" />
                        <MudText Typo="Typo.caption">Critical (&gt;90 orgs or overdue): <strong>@_metrics.Count(m => m.CapacityStatus == "Critical")</strong></MudText>
                    </div>
                </div>

                <div class="overflow-x-auto">
                    <table class="mud-table-root w-100" style="font-size: 0.875rem;">
                        <thead>
                            <tr class="mud-table-row border-b">
                                <th class="pa-2 text-start">Relationship Officer</th>
                                <th class="pa-2 text-start">Regional Office</th>
                                <th class="pa-2 text-center">Active Portfolios</th>
                                <th class="pa-2 text-center">Open Tasks</th>
                                <th class="pa-2 text-center">Visits This Month</th>
                                <th class="pa-2 text-center">Overdue SLAs</th>
                                <th class="pa-2 text-start" style="min-width: 160px;">Capacity Load</th>
                                <th class="pa-2 text-end">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var m in _metrics)
                            {
                                var statusColor = m.CapacityStatus == "Critical" ? Color.Error :
                                                 (m.CapacityStatus == "Elevated" ? Color.Warning : Color.Success);

                                <tr class="mud-table-row border-b hover:bg-slate-50">
                                    <td class="pa-2">
                                        <div class="d-flex align-center gap-2">
                                            <MudAvatar Size="Size.Small" Color="Color.Primary">
                                                @m.OfficerName.Substring(0, Math.Min(2, m.OfficerName.Length)).ToUpper()
                                            </MudAvatar>
                                            <div>
                                                <MudText Typo="Typo.body2" Class="fw-bold">@m.OfficerName</MudText>
                                                <MudText Typo="Typo.caption" Color="Color.Secondary">@m.OfficerUserId • @m.PrimaryRole</MudText>
                                            </div>
                                        </div>
                                    </td>
                                    <td class="pa-2">
                                        <MudText Typo="Typo.caption">@m.RegionName</MudText>
                                    </td>
                                    <td class="pa-2 text-center">
                                        <MudChip T="string" Size="Size.Small" Color="Color.Default" Variant="Variant.Outlined">
                                            @m.AssignedOrganisationsCount
                                        </MudChip>
                                    </td>
                                    <td class="pa-2 text-center">
                                        <MudChip T="string" Size="Size.Small" Color="Color.Info" Variant="Variant.Text">
                                            @m.OpenWorkflowTasksCount
                                        </MudChip>
                                    </td>
                                    <td class="pa-2 text-center">
                                        <MudText Typo="Typo.caption">@m.PendingVisitsThisMonthCount</MudText>
                                    </td>
                                    <td class="pa-2 text-center">
                                        @if (m.OverdueSlaCount > 0)
                                        {
                                            <MudChip T="string" Size="Size.Small" Color="Color.Error" Variant="Variant.Filled">
                                                @m.OverdueSlaCount Overdue
                                            </MudChip>
                                        }
                                        else
                                        {
                                            <MudText Typo="Typo.caption" Color="Color.Success">0</MudText>
                                        }
                                    </td>
                                    <td class="pa-2">
                                        <div class="d-flex flex-column gap-1">
                                            <div class="d-flex justify-space-between align-center">
                                                <MudText Typo="Typo.caption" Class="fw-bold">@m.CapacityLoadPercentage%</MudText>
                                                <MudChip T="string" Size="Size.Small" Color="@statusColor" Variant="Variant.Outlined" Class="pa-1" Style="font-size: 0.7rem; height: 18px;">
                                                    @m.CapacityStatus
                                                </MudChip>
                                            </div>
                                            <MudProgressLinear Value="@m.CapacityLoadPercentage" Color="@statusColor" Rounded="true" Size="Size.Small" />
                                        </div>
                                    </td>
                                    <td class="pa-2 text-end">
                                        <MudButton Variant="Variant.Text"
                                                   Size="Size.Small"
                                                   Color="Color.Primary"
                                                   StartIcon="@Icons.Material.Filled.SwapHoriz"
                                                   OnClick="@(() => OnRebalanceClicked(m.OfficerUserId))">
                                            Rebalance
                                        </MudButton>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
    </MudCardContent>
</MudCard>

@code {
    [Parameter]
    public EventCallback<string> OnOfficerRebalanceRequested { get; set; }

    private bool _isLoading = true;
    private string _selectedRegion = "";
    private List<OfficerCaseloadMetricDto> _metrics = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadHeatmapAsync();
    }

    private async Task OnRegionChanged(string newRegion)
    {
        _selectedRegion = newRegion;
        await LoadHeatmapAsync();
    }

    private async Task LoadHeatmapAsync()
    {
        _isLoading = true;
        try
        {
            var filter = string.IsNullOrWhiteSpace(_selectedRegion) ? null : _selectedRegion;
            _metrics = await ZoneService.GetOfficerCaseloadHeatmapAsync(filter);
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task OnRebalanceClicked(string officerUserId)
    {
        if (OnOfficerRebalanceRequested.HasDelegate)
        {
            await OnOfficerRebalanceRequested.InvokeAsync(officerUserId);
        }
        else
        {
            Navigation.NavigateTo($"/coordination/portfolios");
        }
    }
}
