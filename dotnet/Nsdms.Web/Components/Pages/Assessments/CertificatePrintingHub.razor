@page "/assessments/printing-hub"
@using Microsoft.EntityFrameworkCore
@using Nsdms.Application.Common
@using Nsdms.Application.Common.Interfaces
@using Nsdms.Domain.Entities
@inject ISummativeAssessmentAndModerationService AssessmentService
@inject IPdfDocumentService PdfService
@inject NavigationManager Nav
@inject ISnackbar Snackbar
@inject IJSRuntime JS
@rendermode InteractiveServer

<PageTitle>Certificate Printing & Distribution Hub | merSETA NSDMS</PageTitle>

<div class="mb-4">
    <!-- Sticky Top Action Bar -->
    <MudCard Elevation="2" Class="mb-4" Style="position: sticky; top: var(--mud-appbar-height, 64px) !important; z-index: 10;">
        <MudCardContent Class="d-flex flex-wrap align-center justify-space-between gap-3 py-3">
            <div>
                <MudBreadcrumbs Items="_breadcrumbs" Class="pa-0 mb-1" />
                <MudText Typo="Typo.h5" Class="fw-bold">Certificate Printing & Distribution Hub</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">
                    Batched qualification certificate generation, ETQ-LT-012 transmittal letters, distribution logs, and asymmetric reprint governance (Use Case 4.3 & 4.4).
                </MudText>
            </div>
            <MudStack Row="true" Spacing="2" Class="align-center">
                <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Refresh" OnClick="LoadDataAsync">
                    Refresh
                </MudButton>
                @if (_selectedBatch != null)
                {
                    <MudButton Variant="Variant.Outlined" Color="Color.Secondary" StartIcon="@Icons.Material.Filled.Mail" OnClick="PrintDistributionLetterAsync">
                        Print Distribution Letter
                    </MudButton>
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Print" OnClick="PrintBatchCertificatesAsync" Disabled="_isPrinting">
                        @if (_isPrinting)
                        {
                            <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-1" />
                            <span>Generating PDFs...</span>
                        }
                        else
                        {
                            <span>Print Batch Certificates</span>
                        }
                    </MudButton>
                }
            </MudStack>
        </MudCardContent>
    </MudCard>

    @if (_isLoading)
    {
        <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="mb-4" />
    }

    <MudGrid>
        <!-- Left Panel: Upheld Batches Queue -->
        <MudItem xs="12" md="4">
            <MudCard Elevation="2" Class="mb-4">
                <MudCardHeader>
                    <CardHeaderContent>
                        <MudText Typo="Typo.subtitle1" Class="fw-bold">
                            <MudIcon Icon="@Icons.Material.Filled.Inventory" Size="Size.Small" Class="mr-2" />
                            Certified Batches for Release (@_upheldBatches.Count)
                        </MudText>
                    </CardHeaderContent>
                </MudCardHeader>
                <MudCardContent Class="pa-2">
                    <MudTextField @bind-Value="_searchBatch" Placeholder="Search batch #, provider..." Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Small" Immediate="true" Class="mb-2 px-2" />

                    @if (FilteredBatches.Count == 0)
                    {
                        <div class="pa-4 text-center">
                            <MudText Typo="Typo.body2" Color="Color.Secondary">No certified batches pending release.</MudText>
                        </div>
                    }
                    else
                    {
                        <MudList T="AssessmentBatch" SelectedValue="_selectedBatch" SelectedValueChanged="OnBatchSelected" Dense="true">
                            @foreach (var b in FilteredBatches)
                            {
                                <MudListItem T="AssessmentBatch" Value="@b">
                                    <div class="d-flex justify-space-between align-center">
                                        <div>
                                            <MudText Typo="Typo.body2" Class="fw-bold font-mono">@b.BatchNumber</MudText>
                                            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="d-block text-truncate" Style="max-width: 200px;">
                                                @b.TrainingProvider?.ProviderName
                                            </MudText>
                                            <MudText Typo="Typo.caption">
                                                @b.TotalLearnersCount certified learners
                                            </MudText>
                                        </div>
                                        <div>
                                            <MudChip T="string" Size="Size.Small" Color="Color.Success">
                                                @b.StatusCode
                                            </MudChip>
                                        </div>
                                    </div>
                                </MudListItem>
                                <MudDivider />
                            }
                        </MudList>
                    }
                </MudCardContent>
            </MudCard>
        </MudItem>

        <!-- Right Panel: Batch Certificates, Distribution Form & Attachment Drawer -->
        <MudItem xs="12" md="8">
            @if (_selectedBatch == null)
            {
                <MudPaper Elevation="2" Class="pa-8 text-center">
                    <MudIcon Icon="@Icons.Material.Filled.TouchApp" Size="Size.Large" Color="Color.Secondary" Class="mb-2" />
                    <MudText Typo="Typo.h6">Select a Certified Batch</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">Select an upheld external moderation batch to generate certificates and log delivery transmittals.</MudText>
                </MudPaper>
            }
            else
            {
                <!-- Batch Overview Header -->
                <MudCard Elevation="2" Class="mb-4">
                    <MudCardContent>
                        <div class="d-flex justify-space-between align-start mb-2">
                            <div>
                                <MudText Typo="Typo.h6" Class="fw-bold font-mono">@_selectedBatch.BatchNumber</MudText>
                                <MudText Typo="Typo.body2"><strong>SDP:</strong> @_selectedBatch.TrainingProvider?.ProviderName (Accreditation: @(_selectedBatch.TrainingProvider?.AccreditationNumber ?? "N/A"))</MudText>
                                <MudText Typo="Typo.body2"><strong>Qualification:</strong> @_selectedBatch.QualificationTitle</MudText>
                            </div>
                            <div class="text-right">
                                <MudButton Variant="Variant.Filled" Color="Color.Success" Size="Size.Small" StartIcon="@Icons.Material.Filled.LocalShipping" OnClick="@(() => _isDistributionDialogOpen = true)">
                                    Record Distribution Event
                                </MudButton>
                            </div>
                        </div>
                    </MudCardContent>
                </MudCard>

                <!-- Issued Certificates & SORs Grid -->
                <MudCard Elevation="2" Class="mb-4">
                    <MudCardHeader>
                        <CardHeaderContent>
                            <MudText Typo="Typo.subtitle1" Class="fw-bold">
                                <MudIcon Icon="@Icons.Material.Filled.CardMembership" Size="Size.Small" Class="mr-2" />
                                Issued Credentials & Statutory Numbering (Formula: '17' + ID Middle 4 + 6 Digits)
                            </MudText>
                        </CardHeaderContent>
                    </MudCardHeader>
                    <MudCardContent>
                        <MudTable Items="_batchLearners" Hover="true" Dense="true" Elevation="0">
                            <HeaderContent>
                                <MudTh>Learner Name</MudTh>
                                <MudTh>RSA ID / Passport</MudTh>
                                <MudTh>Certificate Number</MudTh>
                                <MudTh>SOR Serial</MudTh>
                                <MudTh Class="text-right">Print Actions</MudTh>
                            </HeaderContent>
                            <RowTemplate>
                                <MudTd DataLabel="Learner">
                                    <MudText Typo="Typo.body2" Class="fw-bold">@context.SummativeAssessmentReport?.Person?.FirstName @context.SummativeAssessmentReport?.Person?.LastName</MudText>
                                </MudTd>
                                <MudTd DataLabel="ID"><span class="font-mono">@(context.SummativeAssessmentReport?.Person?.RsaIdNumber ?? context.SummativeAssessmentReport?.Person?.PassportNumber ?? "N/A")</span></MudTd>
                                <MudTd DataLabel="Certificate">
                                    @{
                                        var cert = GetCert(context.SummativeAssessmentReportId);
                                    }
                                    @if (cert != null)
                                    {
                                        <span class="font-mono fw-bold text-primary">@cert.CertificateNumber</span>
                                    }
                                    else
                                    {
                                        <span class="text-secondary font-mono">17@(context.SummativeAssessmentReport?.Person?.RsaIdNumber?.Length >= 9 ? context.SummativeAssessmentReport.Person.RsaIdNumber.Substring(5, 4) : "9999")******</span>
                                    }
                                </MudTd>
                                <MudTd DataLabel="SOR">
                                    @{
                                        var sor = GetSor(context.SummativeAssessmentReportId);
                                    }
                                    <span class="font-mono">@(sor?.SorSerialNumber ?? "SOR-PENDING")</span>
                                </MudTd>
                                <MudTd DataLabel="Actions" Class="text-right">
                                    <MudStack Row="true" Spacing="1" Class="justify-end">
                                        @{
                                            var rowCert = GetCert(context.SummativeAssessmentReportId);
                                        }
                                        @if (rowCert != null)
                                        {
                                            <MudIconButton Icon="@Icons.Material.Filled.PictureAsPdf" Size="Size.Small" Color="Color.Primary" OnClick="@(() => DownloadIndividualCertAsync(rowCert.Id))" />
                                        }
                                        <MudButton Variant="Variant.Outlined" Size="Size.Small" Color="Color.Default" StartIcon="@Icons.Material.Filled.UploadFile" OnClick="@(() => OpenScanDrawer(context))">
                                            Scan Ingest
                                        </MudButton>
                                    </MudStack>
                                </MudTd>
                            </RowTemplate>
                        </MudTable>
                    </MudCardContent>
                </MudCard>

                <!-- Asymmetric Reprint Policy Notice -->
                <MudAlert Severity="Severity.Normal" Dense="true">
                    <strong>Asymmetric Reprint Governance:</strong> Distribution transmittal letters may be re-issued on demand. Formal qualification certificates are restricted controlled assets; certificate re-prints require verified justification and are permanently recorded in the audited change log.
                </MudAlert>
            }
        </MudItem>
    </MudGrid>
</div>

<!-- Record Distribution Event Dialog -->
<MudDialog @bind-Visible="_isDistributionDialogOpen" Options="_dialogOptions">
    <TitleContent>
        <MudText Typo="Typo.h6">
            <MudIcon Icon="@Icons.Material.Filled.LocalShipping" Class="mr-2" />
            Record Certificate Batch Distribution Event (Use Case 4.4)
        </MudText>
    </TitleContent>
    <DialogContent>
        <MudStack Spacing="3">
            <MudAlert Severity="Severity.Info" Dense="true">
                Logging formal physical handover/transmittal for batch <strong>@_selectedBatch?.BatchNumber</strong>.
            </MudAlert>

            <MudDatePicker Label="Date of Handover / Collection *" @bind-Date="_distDate" Dense="true" Outlined="true" Editable="true" />
            <MudTextField Label="Recipient Person Name *" @bind-Value="_distRecipientName" Dense="true" Outlined="true" Placeholder="e.g. Johnathan Khumalo (SDP Principal)" Required="true" />
            <MudTextField Label="Recipient RSA ID Number" @bind-Value="_distRecipientId" Dense="true" Outlined="true" Placeholder="13-digit National ID" />
            <MudTextField Label="Courier Waybill / Delivery Reference" @bind-Value="_distTrackingRef" Dense="true" Outlined="true" Placeholder="e.g. WBL-RAM-884210" />
            <MudTextField Label="Handover Notes / Acknowledgment of Receipt" @bind-Value="_distNotes" Lines="2" Dense="true" Outlined="true" Placeholder="Transmitted via secure courier..." />
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => _isDistributionDialogOpen = false)">Cancel</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Save" OnClick="ConfirmRecordDistributionAsync" Disabled="@(string.IsNullOrWhiteSpace(_distRecipientName))">
            Confirm Distribution Event
        </MudButton>
    </DialogActions>
</MudDialog>

<!-- Scanned Certificate Ingest Drawer -->
<MudDrawer @bind-Open="_isScanDrawerOpen" Anchor="Anchor.Right" Elevation="4" Variant="DrawerVariant.Temporary" Width="400px">
    <MudDrawerHeader Class="d-flex align-center justify-space-between">
        <MudText Typo="Typo.h6">Attach Scanned Physical Certificate</MudText>
        <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small" OnClick="@(() => _isScanDrawerOpen = false)" />
    </MudDrawerHeader>
    <div class="pa-4">
        <MudStack Spacing="3">
            <MudAlert Severity="Severity.Info" Dense="true">
                Attaching scanned verified physical certificate with digital security seal.
            </MudAlert>

            <MudTextField Label="Learner" Value="@($"{_scanLearner?.SummativeAssessmentReport?.Person?.FirstName} {_scanLearner?.SummativeAssessmentReport?.Person?.LastName}")" ReadOnly="true" Dense="true" Outlined="true" />
            <MudTextField Label="Statutory Certificate Number" Value="@(_scanCertificate?.CertificateNumber ?? "Pending Generation")" ReadOnly="true" Dense="true" Outlined="true" />

            <MudTextField Label="Scanned Document Reference / Barcode *" @bind-Value="_scannedDocRef" Dense="true" Outlined="true" Placeholder="e.g. SCAN-CERT-2026-00412" HelperText="Barcode value or archive document identifier." Required="true" />

            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Save" FullWidth="true" OnClick="SaveScannedCertificateAsync" Disabled="@(string.IsNullOrWhiteSpace(_scannedDocRef))">
                Seal & Attach Scanned Certificate
            </MudButton>
        </MudStack>
    </div>
</MudDrawer>

@code {
    private readonly List<BreadcrumbItem> _breadcrumbs = new()
    {
        new BreadcrumbItem("Overview & tasks", href: "/"),
        new BreadcrumbItem("Summative assessments", href: "/assessments/summative"),
        new BreadcrumbItem("Printing & distribution", href: null, disabled: true)
    };

    private bool _isLoading = false;
    private bool _isPrinting = false;
    private string _searchBatch = string.Empty;
    private List<AssessmentBatch> _upheldBatches = new();
    private AssessmentBatch? _selectedBatch;
    private List<AssessmentBatchLearner> _batchLearners = new();
    private Dictionary<int, LearnerCertificate> _certificates = new();
    private Dictionary<int, StatementOfResults> _sors = new();

    private LearnerCertificate? GetCert(int reportId) => _certificates.GetValueOrDefault(reportId);
    private StatementOfResults? GetSor(int reportId) => _sors.GetValueOrDefault(reportId);

    // Distribution dialog state
    private bool _isDistributionDialogOpen;
    private DateTime? _distDate = DateTime.UtcNow;
    private string _distRecipientName = string.Empty;
    private string? _distRecipientId;
    private string? _distTrackingRef;
    private string? _distNotes;

    // Scan drawer state
    private bool _isScanDrawerOpen;
    private AssessmentBatchLearner? _scanLearner;
    private LearnerCertificate? _scanCertificate;
    private string _scannedDocRef = string.Empty;

    private DialogOptions _dialogOptions = new() { MaxWidth = MaxWidth.Small, FullWidth = true, CloseButton = true };

    private List<AssessmentBatch> FilteredBatches =>
        _upheldBatches
            .Where(b => string.IsNullOrEmpty(_searchBatch) ||
                        b.BatchNumber.Contains(_searchBatch, StringComparison.OrdinalIgnoreCase) ||
                        (b.TrainingProvider?.ProviderName?.Contains(_searchBatch, StringComparison.OrdinalIgnoreCase) ?? false))
            .ToList();

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        _isLoading = true;
        try
        {
            _upheldBatches = await AssessmentService.GetUpheldBatchesPendingPrintingAsync();

            if (_selectedBatch == null && _upheldBatches.Count > 0)
            {
                _selectedBatch = _upheldBatches.First();
            }

            if (_selectedBatch != null)
            {
                await LoadBatchDetailsAsync(_selectedBatch.Id);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error loading batches: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task OnBatchSelected(AssessmentBatch batch)
    {
        _selectedBatch = batch;
        if (batch != null)
        {
            await LoadBatchDetailsAsync(batch.Id);
        }
    }

    private async Task LoadBatchDetailsAsync(int batchId)
    {
        var details = await AssessmentService.GetBatchCredentialsDetailsAsync(batchId);
        _batchLearners = details.Learners;
        _certificates = details.Certificates;
        _sors = details.Sors;
    }

    private async Task PrintBatchCertificatesAsync()
    {
        if (_selectedBatch == null) return;

        _isPrinting = true;
        try
        {
            if (_certificates.Values.Count == 0)
            {
                Snackbar.Add("No issued certificates found in this batch.", Severity.Warning);
                return;
            }

            var pdfBytes = await PdfService.GenerateBatchConsolidatedCertificatesPdfAsync(_selectedBatch.Id);
            var base64 = Convert.ToBase64String(pdfBytes);
            await JS.InvokeVoidAsync("downloadFile", $"Certificates_Batch_{_selectedBatch.BatchNumber}.pdf", "application/pdf", base64);
            Snackbar.Add($"Consolidated batch certificates downloaded for {_selectedBatch.BatchNumber}.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error generating certificates: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isPrinting = false;
        }
    }

    private async Task PrintDistributionLetterAsync()
    {
        if (_selectedBatch == null) return;

        try
        {
            var pdfBytes = await PdfService.GenerateBatchDistributionLetterPdfAsync(_selectedBatch.Id);
            var base64 = Convert.ToBase64String(pdfBytes);
            await JS.InvokeVoidAsync("downloadFile", $"DistributionLetter_{_selectedBatch.BatchNumber}.pdf", "application/pdf", base64);
            Snackbar.Add($"Distribution letter ETQ-LT-012 downloaded for {_selectedBatch.BatchNumber}.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error generating distribution letter: {ex.Message}", Severity.Error);
        }
    }

    private async Task DownloadIndividualCertAsync(int certId)
    {
        try
        {
            var pdfBytes = await PdfService.GenerateLearnerQualificationCertificatePdfAsync(certId);
            var base64 = Convert.ToBase64String(pdfBytes);
            await JS.InvokeVoidAsync("downloadFile", $"Certificate_{certId}.pdf", "application/pdf", base64);
            Snackbar.Add("Qualification certificate downloaded.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error downloading certificate: {ex.Message}", Severity.Error);
        }
    }

    private async Task ConfirmRecordDistributionAsync()
    {
        if (_selectedBatch == null) return;

        try
        {
            int defaultCertId = _certificates.Values.FirstOrDefault()?.Id ?? 1;
            await AssessmentService.LogCertificateDistributionAsync(
                defaultCertId,
                "Courier",
                _distTrackingRef,
                _distRecipientName,
                _distRecipientId,
                _distNotes,
                "Certification Officer");

            Snackbar.Add($"Distribution event logged successfully for batch {_selectedBatch.BatchNumber}.", Severity.Success);
            _isDistributionDialogOpen = false;
            await LoadDataAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error recording distribution: {ex.Message}", Severity.Error);
        }
    }

    private void OpenScanDrawer(AssessmentBatchLearner learner)
    {
        _scanLearner = learner;
        _certificates.TryGetValue(learner.SummativeAssessmentReportId, out _scanCertificate);
        _scannedDocRef = $"SCAN-{learner.SummativeAssessmentReport?.Person?.RsaIdNumber ?? "CERT"}-{DateTime.UtcNow:yyyyMMdd}";
        _isScanDrawerOpen = true;
    }

    private async Task SaveScannedCertificateAsync()
    {
        if (_scanLearner == null) return;

        try
        {
            if (_scanCertificate != null)
            {
                await AssessmentService.AttachScannedCertificateAsync(
                    _scanCertificate.Id,
                    $"CERT/{_scanCertificate.CertificateNumber}.pdf",
                    $"{_scanCertificate.CertificateNumber}_Scan.pdf",
                    102400,
                    _scanLearner.SummativeAssessmentReport?.Person?.RsaIdNumber,
                    _scanCertificate.CertificateNumber,
                    "Certification Officer");
            }

            Snackbar.Add($"Scanned certificate sealed and linked to learner record.", Severity.Success);
            _isScanDrawerOpen = false;
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error saving scanned certificate: {ex.Message}", Severity.Error);
        }
    }
}
