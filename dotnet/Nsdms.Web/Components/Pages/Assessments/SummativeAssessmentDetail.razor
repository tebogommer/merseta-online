@page "/assessments/summative/{Id:int}"
@using Nsdms.Application.Common.Interfaces
@using Nsdms.Domain.Entities
@inject ISummativeAssessmentAndModerationService AssessmentService
@inject NavigationManager Nav
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<PageTitle>Summative Assessment Detail | merSETA NSDMS</PageTitle>

@if (_report == null)
{
    <MudContainer Class="my-8 text-center">
        <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
        <MudText Typo="Typo.body1" Class="mt-3">Loading summative assessment report...</MudText>
    </MudContainer>
}
else
{
    <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="my-4">
        <!-- Sticky Top Bar -->
        <MudCard Elevation="2" Class="mb-4 sticky-top-header" Style="position: sticky; top: var(--mud-appbar-height, 64px) !important; z-index: 10;">
            <MudCardContent Class="d-flex align-center justify-space-between py-3">
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                    <MudIconButton Icon="@Icons.Material.Filled.ArrowBack" Color="Color.Primary" OnClick="@(() => Nav.NavigateTo("/assessments/summative"))" />
                    <div>
                        <MudText Typo="Typo.h5" Class="fw-bold">@_report.ReportNumber — @_report.QualificationTitle</MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">
                            Learner: <strong>@(_report.Person?.FirstName) @(_report.Person?.LastName)</strong> (RSA ID: @_report.Person?.RsaIdNumber) | Credits: <strong>@_report.TotalCreditsEarned / @_report.TotalCreditsRequired</strong>
                        </MudText>
                    </div>
                </MudStack>

                <MudStack Row="true" Spacing="2">
                    <MudButton Variant="Variant.Outlined" Color="Color.Secondary" StartIcon="@Icons.Material.Filled.Cancel" OnClick="@(() => Nav.NavigateTo("/assessments/summative"))">
                        Cancel
                    </MudButton>

                    @if (_report.StatusCode == "Draft")
                    {
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Save" OnClick="RecordCreditsAsync">
                            Save &amp; Capture Credits
                        </MudButton>
                    }

                    @if (_report.StatusCode == "Assessed")
                    {
                        <MudButton Variant="Variant.Filled" Color="Color.Warning" StartIcon="@Icons.Material.Filled.VerifiedUser" OnClick="PerformModerationAsync">
                            Internal Moderation
                        </MudButton>
                    }

                    @if (_report.StatusCode == "InternalModerated")
                    {
                        <MudButton Variant="Variant.Filled" Color="Color.Info" StartIcon="@Icons.Material.Filled.Approval" OnClick="PerformEtqaApprovalAsync">
                            ETQA External Approval
                        </MudButton>
                    }

                    @if (_report.StatusCode == "CreditsApproved")
                    {
                        <MudButton Variant="Variant.Filled" Color="Color.Success" StartIcon="@Icons.Material.Filled.WorkspacePremium" OnClick="IssueSorAsync">
                            Issue Statement of Results (SOR)
                        </MudButton>
                    }

                    @if (_report.StatusCode == "SorIssued")
                    {
                        <MudChip T="string" Color="Color.Success" Variant="Variant.Filled" Size="Size.Large" Icon="@Icons.Material.Filled.Verified">
                            SOR CERTIFIED
                        </MudChip>
                    }
                </MudStack>
            </MudCardContent>
        </MudCard>

        <!-- Main Structure Tabs -->
        <MudTabs Elevation="2" Rounded="true" ApplyEffectsToContainer="true" PanelClass="pa-6" Color="Color.Primary">
            <!-- Tab 1: Overview & Registrations -->
            <MudTabPanel Text="Overview & Registrations" Icon="@Icons.Material.Filled.Person">
                <MudGrid>
                    <MudItem xs="12" md="6">
                        <MudCard Outlined="true" Class="pa-4 h-100">
                            <MudText Typo="Typo.h6" Class="fw-bold mb-3">Learner & Programme Details</MudText>
                            <MudSimpleTable Dense="true" Elevation="0">
                                <tbody>
                                    <tr><td><strong>Qualification Title:</strong></td><td>@_report.QualificationTitle</td></tr>
                                    <tr><td><strong>SAQA Qualification ID:</strong></td><td>@(_report.SaqaQualificationId ?? "SAQA-65409")</td></tr>
                                    <tr><td><strong>NQF Level:</strong></td><td>Level @_report.NqfLevel</td></tr>
                                    <tr><td><strong>Learner Name:</strong></td><td>@_report.Person?.FirstName @_report.Person?.LastName</td></tr>
                                    <tr><td><strong>RSA ID:</strong></td><td>@_report.Person?.RsaIdNumber</td></tr>
                                    <tr><td><strong>Employer:</strong></td><td>@(_report.Organisation?.CompanyName ?? "Independent")</td></tr>
                                    <tr><td><strong>Intervention Type:</strong></td><td>@_report.InterventionTypeCode</td></tr>
                                </tbody>
                            </MudSimpleTable>
                        </MudCard>
                    </MudItem>

                    <MudItem xs="12" md="6">
                        <MudCard Outlined="true" Class="pa-4 h-100">
                            <MudText Typo="Typo.h6" Class="fw-bold mb-3">Assessor & Moderation Standing</MudText>
                            <MudSimpleTable Dense="true" Elevation="0">
                                <tbody>
                                    <tr><td><strong>Assessor:</strong></td><td>@(_report.AssessorPerson != null ? $"{_report.AssessorPerson.FirstName} {_report.AssessorPerson.LastName}" : "TBD") (Reg: @(_report.AssessorRegistrationNumber ?? "N/A"))</td></tr>
                                    <tr><td><strong>Internal Moderator:</strong></td><td>@(_report.InternalModeratorPerson != null ? $"{_report.InternalModeratorPerson.FirstName} {_report.InternalModeratorPerson.LastName}" : "TBD") (Reg: @(_report.InternalModeratorRegistrationNumber ?? "N/A"))</td></tr>
                                    <tr><td><strong>External ETQA Approver:</strong></td><td>@(_report.ExternalModeratorUserId ?? "Awaiting Verification")</td></tr>
                                    <tr><td><strong>Assessment Date:</strong></td><td>@_report.AssessmentDate.ToString("yyyy-MM-dd")</td></tr>
                                    <tr><td><strong>Moderation Date:</strong></td><td>@(_report.ModerationDate?.ToString("yyyy-MM-dd") ?? "Pending")</td></tr>
                                    <tr><td><strong>Total Credits:</strong></td><td><strong class="text-success">@_report.TotalCreditsEarned / @_report.TotalCreditsRequired</strong></td></tr>
                                    <tr><td><strong>Status:</strong></td><td><span class="badge bg-primary">@_report.StatusCode</span></td></tr>
                                </tbody>
                            </MudSimpleTable>
                        </MudCard>
                    </MudItem>
                </MudGrid>
            </MudTabPanel>

            <!-- Tab 2: Unit Standard Credits Grid -->
            <MudTabPanel Text="Unit Standard Credits" Icon="@Icons.Material.Filled.FormatListNumbered">
                <MudTable Items="_report.UnitStandardAssessments" Dense="true" Elevation="0" Outlined="true">
                    <HeaderContent>
                        <MudTh>Code</MudTh>
                        <MudTh>Unit Standard Title</MudTh>
                        <MudTh>NQF</MudTh>
                        <MudTh>Credits</MudTh>
                        <MudTh>Outcome</MudTh>
                        <MudTh>Moderation</MudTh>
                        <MudTh>Comments</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd Class="font-monospace fw-bold">@context.UnitStandardCode</MudTd>
                        <MudTd>@context.UnitStandardTitle</MudTd>
                        <MudTd>Level @context.NqfLevel</MudTd>
                        <MudTd><strong>@context.Credits</strong></MudTd>
                        <MudTd>
                            @if (context.CompetencyStatusCode == "Competent")
                            {
                                <MudChip T="string" Color="Color.Success" Size="Size.Small">COMPETENT</MudChip>
                            }
                            else
                            {
                                <MudChip T="string" Color="Color.Error" Size="Size.Small">NOT YET COMPETENT</MudChip>
                            }
                        </MudTd>
                        <MudTd>
                            @if (context.IsModerated)
                            {
                                <MudChip T="string" Color="Color.Info" Size="Size.Small">@context.ModerationOutcome</MudChip>
                            }
                            else
                            {
                                <MudText Typo="Typo.caption" Color="Color.Secondary">Unmoderated</MudText>
                            }
                        </MudTd>
                        <MudTd>@context.AssessorComments</MudTd>
                    </RowTemplate>
                </MudTable>
            </MudTabPanel>

            <!-- Tab 3: EISA Occupational Exams -->
            <MudTabPanel Text="EISA Occupational Exams" Icon="@Icons.Material.Filled.School">
                <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-3">
                    <MudText Typo="Typo.h6">External Integrated Summative Assessment (EISA)</MudText>
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" StartIcon="@Icons.Material.Filled.Add" OnClick="RecordEisaExamAsync">
                        Record EISA Exam Result
                    </MudButton>
                </MudStack>

                <MudTable Items="_report.EisaEntries" Dense="true" Elevation="0" Outlined="true">
                    <HeaderContent>
                        <MudTh>Assessment Date</MudTh>
                        <MudTh>Exam Centre</MudTh>
                        <MudTh>Paper Code</MudTh>
                        <MudTh>Score Achieved</MudTh>
                        <MudTh>Percentage</MudTh>
                        <MudTh>Result</MudTh>
                        <MudTh>QCTO Reference</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd>@context.EisaAssessmentDate.ToString("yyyy-MM-dd")</MudTd>
                        <MudTd>@context.EisaCenterName</MudTd>
                        <MudTd Class="font-monospace">@context.AssessmentPaperCode</MudTd>
                        <MudTd>@context.ScoreAchieved / @context.TotalScorePossible</MudTd>
                        <MudTd><strong>@context.PercentageScore%</strong></MudTd>
                        <MudTd>
                            <MudChip T="string" Color="@(context.CompetencyStatusCode == "Competent" ? Color.Success : Color.Error)" Size="Size.Small">
                                @context.CompetencyStatusCode
                            </MudChip>
                        </MudTd>
                        <MudTd Class="font-monospace">@context.QctoModerationReferenceNumber</MudTd>
                    </RowTemplate>
                </MudTable>
            </MudTabPanel>

            <!-- Tab 4: Issued Statement of Results (SOR) -->
            <MudTabPanel Text="Statement of Results (SOR)" Icon="@Icons.Material.Filled.Verified">
                @if (!_report.StatementOfResultsList.Any())
                {
                    <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">
                        Statement of Results has not yet been issued. Complete ETQA external moderation approval to generate the formal cryptographic SOR document.
                    </MudAlert>
                }
                else
                {
                    @foreach (var sor in _report.StatementOfResultsList)
                    {
                        <MudCard Outlined="true" Class="pa-4 mb-3">
                            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                                <div>
                                    <MudText Typo="Typo.h6" Class="fw-bold text-success">
                                        <MudIcon Icon="@Icons.Material.Filled.WorkspacePremium" Class="mr-2" />
                                        @sor.SorSerialNumber
                                    </MudText>
                                    <MudText Typo="Typo.body2">Total Credits Certified: <strong>@sor.TotalCreditsCertified Credits</strong></MudText>
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">Issued on @sor.DateIssued.ToString("dd MMMM yyyy HH:mm") by @sor.IssuedByUserId</MudText>
                                    <MudText Typo="Typo.caption" Class="d-block font-monospace text-muted mt-2">
                                        SHA-256 Hash: @sor.TamperProofHashSha256
                                    </MudText>
                                </div>
                                <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.QrCodeScanner" Href="@sor.QrVerificationUrl" Target="_blank">
                                    Verify Online
                                </MudButton>
                            </MudStack>
                        </MudCard>
                    }
                }
            </MudTabPanel>
        </MudTabs>
    </MudContainer>
}

@code {
    [Parameter] public int Id { get; set; }
    private SummativeAssessmentReport? _report;

    protected override async Task OnInitializedAsync()
    {
        await LoadReportAsync();
    }

    private async Task LoadReportAsync()
    {
        _report = await AssessmentService.GetReportByIdAsync(Id);
    }

    private async Task RecordCreditsAsync()
    {
        try
        {
            var units = new List<SummativeAssessmentUnitStandard>
            {
                new() { UnitStandardCode = "US-119472", UnitStandardTitle = "Accommodate audience and purpose in oral communications", NqfLevel = 3, Credits = 5, CompetencyStatusCode = "Competent", AssessorComments = "Competent in workplace briefings." },
                new() { UnitStandardCode = "US-119457", UnitStandardTitle = "Write texts for a range of communicative contexts", NqfLevel = 3, Credits = 5, CompetencyStatusCode = "Competent", AssessorComments = "Reports clear and accurate." },
                new() { UnitStandardCode = "US-9844", UnitStandardTitle = "Perform mechanical engineering fitting and assembly", NqfLevel = 4, Credits = 40, CompetencyStatusCode = "Competent", AssessorComments = "Demonstrated full precision assembly." },
                new() { UnitStandardCode = "US-9845", UnitStandardTitle = "Maintain pneumatic and hydraulic control circuits", NqfLevel = 4, Credits = 40, CompetencyStatusCode = "Competent", AssessorComments = "Flawless fault tracing." },
                new() { UnitStandardCode = "US-9846", UnitStandardTitle = "Apply workplace health and safety compliance standards", NqfLevel = 4, Credits = 30, CompetencyStatusCode = "Competent", AssessorComments = "Exemplary safety standards." }
            };

            _report = await AssessmentService.RecordUnitStandardCreditsAsync(Id, 1, "ASSR-REG-2026-091", units, "AssessorUser");
            Snackbar.Add($"Recorded {_report.TotalCreditsEarned} credits successfully.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
    }

    private async Task PerformModerationAsync()
    {
        try
        {
            var decisions = _report!.UnitStandardAssessments.ToDictionary(u => u.Id, u => ("Upheld", (string?)"Assessor judgement verified and upheld."));
            _report = await AssessmentService.PerformInternalModerationAsync(Id, 2, "MOD-REG-2026-088", decisions, "ModeratorUser");
            Snackbar.Add("Internal moderation concluded successfully.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
    }

    private async Task PerformEtqaApprovalAsync()
    {
        try
        {
            _report = await AssessmentService.PerformEtqaExternalModerationAsync(Id, true, "ETQA Committee approved all 120 credits for qualification certification.", "EtqaManager");
            Snackbar.Add("ETQA external moderation approved.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
    }

    private async Task RecordEisaExamAsync()
    {
        try
        {
            await AssessmentService.RecordEisaExamEntryAsync(Id, DateTime.UtcNow, "Midrand National Assessment Centre", "EISA-AUTO-2026", 88m, 100m, null, "QctoOfficer");
            Snackbar.Add("Recorded EISA exam entry.", Severity.Success);
            await LoadReportAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
    }

    private async Task IssueSorAsync()
    {
        try
        {
            var sor = await AssessmentService.IssueStatementOfResultsAsync(Id, "CertificationOfficer");
            Snackbar.Add($"Statement of Results issued: {sor.SorSerialNumber}", Severity.Success);
            await LoadReportAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
    }
}
