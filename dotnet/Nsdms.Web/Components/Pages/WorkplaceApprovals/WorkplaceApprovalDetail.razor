@page "/workplace-approvals/{Id:int}"
@page "/workplace-approvals/{Id:int}/edit"
@using Nsdms.Application.Common.Models
@using Nsdms.Application.Services
@using Nsdms.Domain.Entities
@using Nsdms.Web.Components.Shared
@rendermode InteractiveServer
@inject IWorkplaceApprovalService ApprovalService
@inject IMentorRatioPolicyEngine RatioEngine
@inject IOrganisationService OrganisationService
@inject IPersonService PersonService
@inject IVisitService VisitService
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject Nsdms.Application.Common.Interfaces.IPdfDocumentService PdfService

<PageTitle>@(IsNew ? "New Workplace Approval" : $"Workplace Approval {_approval.ApprovalNumber}") - NSDMS</PageTitle>

@if (!_isEditMode && !IsNew)
{
    <!-- VIEW BY DEFAULT: ENTITY HEADER (16-Point UI Standard compliant) -->
    <EntityHeader Title="@($"{_approval.QualificationTitle} ({_approval.ApprovalNumber})")"
                  ReferenceKey="@_approval.ApprovalNumber"
                  Status="@_approval.ApprovalStatusCode"
                  Subtitle="@($"Host Employer: {(_approval.Organisation?.CompanyName ?? "Organisation")} | Trade Scope: {_approval.QualificationTitle} | Site: {(_approval.OrganisationSite?.SiteName ?? "Main Plant")}")"
                  BreadcrumbItems="@_breadcrumbItems">
        <ActionZone>
            <MudButton Variant="Variant.Text"
                       StartIcon="@Icons.Material.Filled.ArrowBack"
                       Color="Color.Default"
                       OnClick="@(() => Navigation.NavigateTo("/workplace-approvals"))"
                       aria-label="Back to Workplace Approvals">
                Back to Approvals
            </MudButton>

            <!-- SLA / Inspection Countdown Badge -->
            @if (_approval.InspectionDueDate.HasValue)
            {
                var daysRemaining = (_approval.InspectionDueDate.Value.Date - DateTime.Today).Days;
                @if (daysRemaining < 0)
                {
                    <MudChip T="string" Color="Color.Error" Size="Size.Small" Variant="Variant.Filled" Icon="@Icons.Material.Filled.Alarm">
                        SLA Overdue (@Math.Abs(daysRemaining) days past deadline)
                    </MudChip>
                }
                else if (daysRemaining <= 5)
                {
                    <MudChip T="string" Color="Color.Warning" Size="Size.Small" Variant="Variant.Filled" Icon="@Icons.Material.Filled.HourglassBottom">
                        SLA Deadline: @daysRemaining days left (@_approval.InspectionDueDate.Value.ToString("yyyy-MM-dd"))
                    </MudChip>
                }
                else
                {
                    <MudChip T="string" Color="Color.Info" Size="Size.Small" Variant="Variant.Outlined" Icon="@Icons.Material.Filled.AccessTime">
                        Inspection Due: @_approval.InspectionDueDate.Value.ToString("yyyy-MM-dd") (@daysRemaining days)
                    </MudChip>
                }
            }

            <!-- Statutory Services & Actions Menu -->
            <MudMenu Label="Statutory Services"
                     StartIcon="@Icons.Material.Filled.Bolt"
                     EndIcon="@Icons.Material.Filled.KeyboardArrowDown"
                     Color="Color.Default"
                     Variant="Variant.Outlined"
                     Dense="true"
                     aria-label="Launch Statutory Services">
                <MudMenuItem Icon="@Icons.Material.Filled.EventAvailable" OnClick="OpenScheduleVisitDialog">
                    Schedule Site Inspection Visit
                </MudMenuItem>
                <MudMenuItem Icon="@Icons.Material.Filled.FactCheck" OnClick="OpenVerificationDialog" Disabled="@(_approval.ApprovalStatusCode != "APPLICATION" && _approval.ApprovalStatusCode != "AUDIT_SCHEDULED")">
                    Conduct Workplace Verification (Audit)
                </MudMenuItem>
                <MudMenuItem Icon="@Icons.Material.Filled.AssignmentTurnedIn" OnClick="OpenEvaluationDialog" Disabled="@(_approval.ApprovalStatusCode != "VERIFIED" && _approval.ApprovalStatusCode != "UNDER_EVALUATION")">
                    Render Committee Decision (Maker-Checker)
                </MudMenuItem>
                <MudDivider Class="my-1" />
                <MudMenuItem Icon="@Icons.Material.Filled.PictureAsPdf" OnClick="DownloadOutcomeLetterPdf">
                    Workplace Approval Outcome Letter (ETQ-TP-003)
                </MudMenuItem>
                <MudMenuItem Icon="@Icons.Material.Filled.Description" OnClick="DownloadInspectionReportPdf">
                    Workplace Approval Report (ETQ-TP-054)
                </MudMenuItem>
                <MudDivider Class="my-1" />
                <MudMenuItem Icon="@Icons.Material.Filled.Block" IconColor="Color.Warning" OnClick="OpenWithdrawDialog" Disabled="@(_approval.ApprovalStatusCode == "WITHDRAWN" || _approval.ApprovalStatusCode == "REJECTED")">
                    Withdraw Approval Application
                </MudMenuItem>
                <MudMenuItem Icon="@Icons.Material.Filled.Delete" IconColor="Color.Error" OnClick="DeleteAsync">
                    Delete Approval Record
                </MudMenuItem>
            </MudMenu>

            <!-- Edit Button -->
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Edit"
                       OnClick="EnterEditMode"
                       aria-label="Edit Workplace Approval">
                Edit Approval
            </MudButton>
        </ActionZone>
    </EntityHeader>
}
else
{
    <!-- EDIT MODE HEADER -->
    <EntityHeader Title="@(IsNew ? "New Workplace Approval Application" : $"Edit {_approval.QualificationTitle}")"
                  ReferenceKey="@_approval.ApprovalNumber"
                  Status="@(IsNew ? "DRAFT" : "Editing")"
                  Subtitle="@(IsNew ? "Create a new workplace approval record under the statutory QCTO & NAMB standards" : "Modify workplace approval scope, ratio policy overrides, or designated contact persons")"
                  BreadcrumbItems="@_breadcrumbItems">
        <ActionZone>
            <MudButton Variant="Variant.Outlined"
                       Color="Color.Secondary"
                       StartIcon="@Icons.Material.Filled.Cancel"
                       OnClick="ExitEditMode"
                       aria-label="Cancel Edit">
                Cancel
            </MudButton>
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Save"
                       OnClick="SaveAsync"
                       Disabled="_saving"
                       aria-label="Save Workplace Approval">
                @if (_saving)
                {
                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                    <span>Saving...</span>
                }
                else
                {
                    <span>Save</span>
                }
            </MudButton>
        </ActionZone>
    </EntityHeader>
}

@if (!IsNew)
{
    <!-- Visual Workflow Step Tracker -->
    <WorkflowProgressBar ProcessCode="WPAPP" 
                         EntityId="@Id" 
                         EntityTitle="@($"{_approval.QualificationTitle} ({_approval.ApprovalNumber})")" 
                         EntityRef="@_approval.ApprovalNumber" />

    <!-- Workflow Action Bridge -->
    <WorkflowActionBridge ProcessCode="WPAPP" 
                          EntityId="@Id" 
                          EntityTitle="@($"{_approval.QualificationTitle} ({_approval.ApprovalNumber})")" 
                          EntityRef="@_approval.ApprovalNumber" 
                          OnStatusChanged="OnWorkflowStatusChanged" />
}

@if (_loading)
{
    <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="my-6" />
}
else
{
    <MudTabs Elevation="2" Rounded="true" ApplyEffectsToContainer="true" Color="Color.Surface" @bind-ActivePanelIndex="_activeTabIndex">
        
        <!-- TAB 1: MASTER APPLICATION DETAILS -->
        <MudTabPanel Text="Workplace & Scope" Icon="@Icons.Material.Filled.FactCheck">
            @if (!_isEditMode && !IsNew)
            {
                <!-- READ-ONLY VIEW (View by default) -->
                <MudCard Outlined="true" Class="pa-4">
                    <MudGrid Spacing="3">
                        <MudItem xs="12" md="6">
                            <ReadOnlyField Label="Host Employer / Organisation" 
                                           Value="@($"{_approval.Organisation?.CompanyName} ({_approval.Organisation?.SdlNumber})")" 
                                           Icon="@Icons.Material.Filled.Business" />
                        </MudItem>
                        <MudItem xs="12" md="6">
                            <ReadOnlyField Label="Approval Reference Number" 
                                           Value="@_approval.ApprovalNumber" 
                                           IsMonospace="true" 
                                           AllowCopy="true" 
                                           Icon="@Icons.Material.Filled.ConfirmationNumber" />
                        </MudItem>

                        <MudItem xs="12" md="6">
                            <ReadOnlyField Label="Learning Programme Stream" 
                                           Value="@_approval.LearningProgramTypeCode" 
                                           Icon="@Icons.Material.Filled.School" />
                        </MudItem>
                        <MudItem xs="12" md="6">
                            <ReadOnlyField Label="Designated Site / Operating Plant" 
                                           Value="@(_approval.OrganisationSite?.SiteName ?? "Main Plant / Head Office")" 
                                           Icon="@Icons.Material.Filled.Place" />
                        </MudItem>

                        <MudItem xs="12" md="8">
                            <ReadOnlyField Label="Qualification / Trade Scope" 
                                           Value="@_approval.QualificationTitle" 
                                           Icon="@Icons.Material.Filled.Work" />
                        </MudItem>
                        <MudItem xs="12" md="4">
                            <ReadOnlyField Label="SAQA Qualification ID" 
                                           Value="@(_approval.SaqaQualificationId?.ToString() ?? "—")" 
                                           IsMonospace="true" />
                        </MudItem>

                        <MudItem xs="12" md="4">
                            <ReadOnlyField Label="Site Inspection Date" 
                                           Value="@(_approval.InspectionDate?.ToString("yyyy-MM-dd") ?? "Pending Inspection")" 
                                           Icon="@Icons.Material.Filled.CalendarMonth" />
                        </MudItem>
                        <MudItem xs="12" md="4">
                            <ReadOnlyField Label="Approval Granted Date" 
                                           Value="@(_approval.ApprovalDate?.ToString("yyyy-MM-dd") ?? "Pending Approval")" 
                                           Icon="@Icons.Material.Filled.CheckCircle" />
                        </MudItem>
                        <MudItem xs="12" md="4">
                            <ReadOnlyField Label="Accreditation Expiry Date" 
                                           Value="@(_approval.ExpiryDate?.ToString("yyyy-MM-dd") ?? "—")" 
                                           Icon="@Icons.Material.Filled.EventBusy" />
                        </MudItem>

                        <MudItem xs="12" md="6">
                            <ReadOnlyField Label="Mandatory Employer Contact Person" 
                                           Value="@(_approval.ContactPerson != null ? $"{_approval.ContactPerson.FullName} ({_approval.ContactPerson.Email ?? _approval.ContactPerson.CellNumber ?? _approval.ContactPerson.RsaIdNumber})" : "Not Selected")" 
                                           Icon="@Icons.Material.Filled.PersonPin" />
                        </MudItem>
                        <MudItem xs="12" md="6">
                            <ReadOnlyField Label="Assigned Verification Officer / Assessor" 
                                           Value="@(_approval.AssessorPerson?.FullName ?? (_approval.VerifiedByPerson?.FullName ?? "Unassigned"))" 
                                           Icon="@Icons.Material.Filled.Badge" />
                        </MudItem>

                        <MudItem xs="12" md="4">
                            <ReadOnlyField Label="Designated Trade Ratio Policy" 
                                           Value="@(!string.IsNullOrWhiteSpace(_approval.TradeCode) ? $"{_approval.TradeCode} (Standard 1:{_ratioEval.StandardTradeRatio})" : "Auto-detected")" />
                        </MudItem>
                        <MudItem xs="12" md="4">
                            <ReadOnlyField Label="Ratio Enforcement Override" 
                                           Value="@(_approval.IsRatioEnforced == true ? "Strictly Enforced" : (_approval.IsRatioEnforced == false ? "Exempt from Ratios" : "Inherit Org/Global"))" />
                        </MudItem>
                        <MudItem xs="12" md="4">
                            <ReadOnlyField Label="Custom Site Ratio" 
                                           Value="@(_approval.CustomTradeRatio.HasValue ? $"1:{_approval.CustomTradeRatio.Value}" : "Using Standard Trade Policy")" />
                        </MudItem>

                        @if (_approval.IsNonMerSetaCompany)
                        {
                            <MudItem xs="12" md="6">
                                <ReadOnlyField Label="Originating Home SETA" Value="@(_approval.HomeSetaName ?? "Non-merSETA")" />
                            </MudItem>
                            <MudItem xs="12" md="6">
                                <ReadOnlyField Label="Inter-SETA Agreement Reference" Value="@(_approval.HomeSetaAgreementRef ?? "—")" IsMonospace="true" />
                            </MudItem>
                        }

                        @if (!string.IsNullOrWhiteSpace(_approval.MentorRatioExemptionNotes))
                        {
                            <MudItem xs="12">
                                <ReadOnlyField Label="Ratio Exemption Justification / Dispensation" Value="@_approval.MentorRatioExemptionNotes" />
                            </MudItem>
                        }

                        @if (!string.IsNullOrWhiteSpace(_approval.Recommendations))
                        {
                            <MudItem xs="12">
                                <ReadOnlyField Label="Audit Findings & Recommendations" Value="@_approval.Recommendations" />
                            </MudItem>
                        }
                    </MudGrid>
                </MudCard>
            }
            else
            {
                <!-- EDITABLE FORM (When in edit mode or new record) -->
                <MudCard Outlined="true" Class="pa-4">
                    <MudGrid Spacing="3">
                        <MudItem xs="12" md="6">
                            <MudSelect T="int" @bind-Value="_approval.OrganisationId" Label="Host Employer / Organisation" Variant="Variant.Outlined" Required="true">
                                <MudSelectItem Value="0">-- Select Employer --</MudSelectItem>
                                @foreach (var org in _organisations)
                                {
                                    <MudSelectItem Value="@org.Id">@org.CompanyName (@org.SdlNumber)</MudSelectItem>
                                }
                            </MudSelect>
                        </MudItem>
                        <MudItem xs="12" md="6">
                            <MudTextField @bind-Value="_approval.ApprovalNumber" Label="Approval Reference Number" Variant="Variant.Outlined" ReadOnly="!IsNew" HelperText="Auto-generated upon creation" />
                        </MudItem>

                        <MudItem xs="12" md="6">
                            <MudSelect T="string" @bind-Value="_approval.LearningProgramTypeCode" Label="Learning Programme Stream" Variant="Variant.Outlined" Required="true">
                                <MudSelectItem Value="@("Apprenticeship")">Apprenticeship (Section 13/28 Trade)</MudSelectItem>
                                <MudSelectItem Value="@("Learnership")">Learnership (NQF Aligned)</MudSelectItem>
                                <MudSelectItem Value="@("InternshipNDiploma")">Internship / N-Diploma Practical</MudSelectItem>
                                <MudSelectItem Value="@("OccupationalQual")">Occupational Qualification (QCTO)</MudSelectItem>
                                <MudSelectItem Value="@("SkillsProgramme")">Skills Programme</MudSelectItem>
                                <MudSelectItem Value="@("Candidacy")">Candidacy Programme</MudSelectItem>
                            </MudSelect>
                        </MudItem>
                        <MudItem xs="12" md="6">
                            <MudSelect T="int?" @bind-Value="_approval.OrganisationSiteId" Label="Designated Site / Plant" Variant="Variant.Outlined" Clearable="true">
                                <MudSelectItem Value="@((int?)null)">-- Main Plant / Head Office --</MudSelectItem>
                                @foreach (var s in _sites)
                                {
                                    <MudSelectItem Value="@((int?)s.Id)">@s.SiteName (@(s.City ?? s.ProvinceCode))</MudSelectItem>
                                }
                            </MudSelect>
                        </MudItem>

                        <MudItem xs="12" md="8">
                            <MudTextField @bind-Value="_approval.QualificationTitle" Label="Qualification / Trade Scope" Variant="Variant.Outlined" Required="true"
                                          Placeholder="e.g. Automotive Motor Mechanic, Boilermaker, Electrician, Fitter &amp; Turner" />
                        </MudItem>
                        <MudItem xs="12" md="4">
                            <MudNumericField @bind-Value="_approval.SaqaQualificationId" Label="SAQA Qualification ID" Variant="Variant.Outlined" />
                        </MudItem>

                        <MudItem xs="12" md="4">
                            <MudDatePicker @bind-Date="_inspectionDate" Label="Site Inspection Date" Variant="Variant.Outlined" />
                        </MudItem>
                        <MudItem xs="12" md="4">
                            <MudDatePicker @bind-Date="_approvalDate" Label="Approval Granted Date" Variant="Variant.Outlined" />
                        </MudItem>
                        <MudItem xs="12" md="4">
                            <MudDatePicker @bind-Date="_expiryDate" Label="Accreditation Expiry Date" Variant="Variant.Outlined" />
                        </MudItem>

                        <MudItem xs="12" md="6">
                            <MudSelect T="int?" @bind-Value="_approval.ContactPersonId" Label="Mandatory Employer Contact Person" Variant="Variant.Outlined" Required="true" RequiredError="Employer Contact Person must be selected per visit governance rules" Clearable="true">
                                <MudSelectItem Value="@((int?)null)">-- Select Employer Contact Person --</MudSelectItem>
                                @foreach (var person in _people)
                                {
                                    <MudSelectItem Value="@((int?)person.Id)">@person.FullName (@(person.RsaIdNumber ?? person.Email))</MudSelectItem>
                                }
                            </MudSelect>
                        </MudItem>
                        <MudItem xs="12" md="6">
                            <MudSelect T="int?" @bind-Value="_approval.AssessorPersonId" Label="Evaluating Assessor / Inspector" Variant="Variant.Outlined" Clearable="true">
                                <MudSelectItem Value="@((int?)null)">-- Select Assessor --</MudSelectItem>
                                @foreach (var person in _people)
                                {
                                    <MudSelectItem Value="@((int?)person.Id)">@person.FullName (@person.RsaIdNumber)</MudSelectItem>
                                }
                            </MudSelect>
                        </MudItem>
                        <MudItem xs="12" md="12">
                            <ReadOnlyField Label="Approval Status">
                                <StatusBadge Status="@_approval.ApprovalStatusCode" />
                            </ReadOnlyField>
                        </MudItem>

                        <MudItem xs="12" md="6">
                            <MudSelect T="string" @bind-Value="_approval.TradeCode" Label="Designated Trade Ratio Policy" Variant="Variant.Outlined" Clearable="true" HelperText="Determines statutory apprentice-to-mentor ratio standard">
                                <MudSelectItem Value="@((string?)null)">-- Auto-detect from Qualification --</MudSelectItem>
                                @foreach (var tp in _tradePolicies)
                                {
                                    <MudSelectItem Value="@tp.TradeCode">@tp.TradeTitle (@tp.TradeCode - 1:@tp.StandardRatio)</MudSelectItem>
                                }
                            </MudSelect>
                        </MudItem>
                        <MudItem xs="12" md="3">
                            <MudSelect T="bool?" @bind-Value="_approval.IsRatioEnforced" Label="Ratio Enforcement Override" Variant="Variant.Outlined">
                                <MudSelectItem Value="@((bool?)null)">Default (Inherit Org/Global)</MudSelectItem>
                                <MudSelectItem Value="@((bool?)true)">Strictly Enforce Ratios</MudSelectItem>
                                <MudSelectItem Value="@((bool?)false)">Exempt from Ratio Checking</MudSelectItem>
                            </MudSelect>
                        </MudItem>
                        <MudItem xs="12" md="3">
                            <MudNumericField @bind-Value="_approval.CustomTradeRatio" Label="Custom Site Ratio (e.g. 3 for 1:3)" Variant="Variant.Outlined" Min="1" Max="20" HelperText="Overrides trade standard" />
                        </MudItem>

                        @if (_approval.IsRatioEnforced == false)
                        {
                            <MudItem xs="12">
                                <MudTextField @bind-Value="_approval.MentorRatioExemptionNotes" Label="Workplace Ratio Exemption Justification / Dispensation" Variant="Variant.Outlined" Required="true" Placeholder="e.g. Approved board dispensation for dual-shift master artisan rotation" />
                            </MudItem>
                        }

                        <MudItem xs="12">
                            <MudTextField @bind-Value="_approval.Recommendations" Label="Audit Findings &amp; Recommendations" Variant="Variant.Outlined" Lines="3"
                                          Placeholder="Enter evaluator findings on tooling, safety equipment, and artisan ratios..." />
                        </MudItem>
                    </MudGrid>
                </MudCard>
            }
        </MudTabPanel>

        <!-- TAB 2: CERTIFIED WORKSHOP MENTORS -->
        <MudTabPanel Text="Workshop Mentors" Icon="@Icons.Material.Filled.Engineering" Disabled="IsNew">
            
            <!-- RATIO & SUPERVISION CAPACITY DASHBOARD CARD -->
            <MudCard Outlined="true" Class="pa-4 mb-4 elevation-1">
                <div class="d-flex flex-wrap justify-space-between align-center mb-3 gap-2">
                    <div class="d-flex align-center gap-2">
                        <MudIcon Icon="@Icons.Material.Filled.Speed" Color="Color.Primary" />
                        <MudText Typo="Typo.h6" Class="fw-bold">Artisan Mentor-to-Apprentice Ratio &amp; Capacity</MudText>
                    </div>
                    <div>
                        @if (_ratioEval.Status == MentorRatioComplianceStatus.Exempt)
                        {
                            <MudChip T="string" Color="Color.Info" Size="Size.Small" Variant="Variant.Filled" Icon="@Icons.Material.Filled.Shield">
                                @GetEnforcementStateDisplay(_ratioEval.EnforcementState)
                            </MudChip>
                        }
                        else if (_ratioEval.Status == MentorRatioComplianceStatus.OverCapacity)
                        {
                            <MudChip T="string" Color="Color.Error" Size="Size.Small" Variant="Variant.Filled" Icon="@Icons.Material.Filled.Warning">
                                Over Capacity
                            </MudChip>
                        }
                        else if (_ratioEval.Status == MentorRatioComplianceStatus.NearCapacity)
                        {
                            <MudChip T="string" Color="Color.Warning" Size="Size.Small" Variant="Variant.Filled" Icon="@Icons.Material.Filled.ReportProblem">
                                Near Capacity (@_ratioEval.UtilizationPercentage%)
                            </MudChip>
                        }
                        else
                        {
                            <MudChip T="string" Color="Color.Success" Size="Size.Small" Variant="Variant.Filled" Icon="@Icons.Material.Filled.CheckCircle">
                                Compliant (@_ratioEval.UtilizationPercentage%)
                            </MudChip>
                        }
                    </div>
                </div>

                <MudGrid Class="mb-2">
                    <MudItem xs="12" sm="6" md="3">
                        <MudPaper Outlined="true" Class="pa-3 text-center">
                            <MudText Typo="Typo.caption" Color="Color.Secondary">Designated Trade Policy</MudText>
                            <div class="fw-bold mt-1">@_ratioEval.TradeTitle</div>
                            <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Outlined" Class="mt-1">
                                Standard: 1:@_ratioEval.StandardTradeRatio
                            </MudChip>
                        </MudPaper>
                    </MudItem>
                    <MudItem xs="12" sm="6" md="3">
                        <MudPaper Outlined="true" Class="pa-3 text-center">
                            <MudText Typo="Typo.caption" Color="Color.Secondary">Active Certified Mentors</MudText>
                            <div class="fw-bold mt-1 fs-5">@_ratioEval.TotalActiveMentors</div>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">Supervising at site</MudText>
                        </MudPaper>
                    </MudItem>
                    <MudItem xs="12" sm="6" md="3">
                        <MudPaper Outlined="true" Class="pa-3 text-center">
                            <MudText Typo="Typo.caption" Color="Color.Secondary">Total Supervision Capacity</MudText>
                            <div class="fw-bold mt-1 fs-5 text-primary">@_ratioEval.EffectiveTotalCapacity Learners</div>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">Combined mentor quota</MudText>
                        </MudPaper>
                    </MudItem>
                    <MudItem xs="12" sm="6" md="3">
                        <MudPaper Outlined="true" Class="pa-3 text-center">
                            <MudText Typo="Typo.caption" Color="Color.Secondary">Placed / Available Slots</MudText>
                            <div class="fw-bold mt-1 fs-5">@_ratioEval.TotalPlacedLearners / <span class="text-success">@_ratioEval.AvailableSlots Available</span></div>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">Active enrolled apprentices</MudText>
                        </MudPaper>
                    </MudItem>
                </MudGrid>

                <div class="mt-2 mb-2">
                    <div class="d-flex justify-space-between align-center mb-1">
                        <MudText Typo="Typo.caption" Class="fw-bold">Supervision Capacity Utilization</MudText>
                        <MudText Typo="Typo.caption" Class="fw-bold">@_ratioEval.UtilizationPercentage% (@_ratioEval.TotalPlacedLearners / @_ratioEval.EffectiveTotalCapacity)</MudText>
                    </div>
                    <MudProgressLinear Value="@Math.Min(100.0, _ratioEval.UtilizationPercentage)"
                                       Color="@GetCapacityColor(_ratioEval.Status)"
                                       Size="Size.Medium"
                                       Rounded="true" />
                </div>

                @if (!string.IsNullOrWhiteSpace(_ratioEval.StatusMessage))
                {
                    <MudAlert Severity="@GetAlertSeverity(_ratioEval.Status)" Dense="true" Class="mt-2">
                        @_ratioEval.StatusMessage
                        @if (!string.IsNullOrWhiteSpace(_ratioEval.ExemptionReason))
                        {
                            <span class="d-block mt-1 fst-italic">Exemption Reason: @_ratioEval.ExemptionReason</span>
                        }
                    </MudAlert>
                }

                @if (_ratioEval.Warnings.Any())
                {
                    <div class="mt-2">
                        @foreach (var warn in _ratioEval.Warnings)
                        {
                            <MudAlert Severity="Severity.Warning" Dense="true" Class="my-1">@warn</MudAlert>
                        }
                    </div>
                }
            </MudCard>

            <div class="d-flex justify-space-between align-center mb-4">
                <div>
                    <MudText Typo="Typo.h6" Class="fw-bold">Designated Workshop Mentors &amp; Artisans</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">Qualified artisans supervising apprentices and learners in the workshop.</MudText>
                </div>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.PersonAdd" OnClick="OpenAddMentorDialog" aria-label="Add Mentor">
                    Add Mentor
                </MudButton>
            </div>

            <MudTable Items="_approval.Mentors" Hover="true" Striped="true" Elevation="1" Class="rounded-lg">
                <HeaderContent>
                    <MudTh>Mentor Name</MudTh>
                    <MudTh>RSA ID Number</MudTh>
                    <MudTh>Designation / Trade Title</MudTh>
                    <MudTh>Artisan Trade Number</MudTh>
                    <MudTh>Experience (Years)</MudTh>
                    <MudTh>Certified</MudTh>
                    <MudTh>Supervision Capacity</MudTh>
                    <MudTh>Ratio Status</MudTh>
                    <MudTh Style="text-align: right;">Action</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Mentor Name">
                        <div class="fw-bold">@(context.Person?.FullName ?? "Unknown")</div>
                        @if (!string.IsNullOrWhiteSpace(context.Notes))
                        {
                            <MudText Typo="Typo.caption" Color="Color.Secondary">@context.Notes</MudText>
                        }
                    </MudTd>
                    <MudTd DataLabel="RSA ID">@(context.Person?.RsaIdNumber ?? "N/A")</MudTd>
                    <MudTd DataLabel="Designation">@context.Designation</MudTd>
                    <MudTd DataLabel="Trade No">@(context.ArtisanTradeNumber ?? "—")</MudTd>
                    <MudTd DataLabel="Experience">@context.YearsExperience yrs</MudTd>
                    <MudTd DataLabel="Certified">
                        @if (context.IsCertifiedArtisan)
                        {
                            <MudChip T="string" Color="Color.Success" Size="Size.Small" Variant="Variant.Filled">Certified</MudChip>
                        }
                        else
                        {
                            <MudChip T="string" Color="Color.Warning" Size="Size.Small" Variant="Variant.Filled">Under Review</MudChip>
                        }
                    </MudTd>
                    <MudTd DataLabel="Capacity">
                        @if (context.MaxLearnerCapacity.HasValue && context.MaxLearnerCapacity.Value > 0)
                        {
                            <MudChip T="string" Color="Color.Primary" Size="Size.Small" Variant="Variant.Filled">
                                Custom (1:@context.MaxLearnerCapacity.Value)
                            </MudChip>
                        }
                        else
                        {
                            <MudChip T="string" Color="Color.Default" Size="Size.Small" Variant="Variant.Outlined">
                                Default (1:@_ratioEval.StandardTradeRatio)
                            </MudChip>
                        }
                    </MudTd>
                    <MudTd DataLabel="Ratio Status">
                        @if (context.IsRatioExempt || !context.IsRatioEnforced)
                        {
                            <MudChip T="string" Color="Color.Info" Size="Size.Small" Variant="Variant.Filled">Exempt</MudChip>
                        }
                        else
                        {
                            <MudChip T="string" Color="Color.Success" Size="Size.Small" Variant="Variant.Outlined">Enforced</MudChip>
                        }
                    </MudTd>
                    <MudTd DataLabel="Action" Style="text-align: right;">
                        <div class="d-flex justify-end gap-1">
                            <MudIconButton Icon="@Icons.Material.Filled.Tune"
                                           Color="Color.Primary"
                                           Size="Size.Small"
                                           OnClick="@(() => OpenEditMentorCapacityDialog(context))"
                                           aria-label="Configure Mentor Capacity" />
                            <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                           Color="Color.Error"
                                           Size="Size.Small"
                                           OnClick="@(() => RemoveMentor(context.Id))"
                                           aria-label="Remove Mentor" />
                        </div>
                    </MudTd>
                </RowTemplate>
            </MudTable>
        </MudTabPanel>

        <!-- TAB 3: WORKSHOP TOOL & EQUIPMENT CHECKLIST -->
        <MudTabPanel Text="Tools &amp; Equipment" Icon="@Icons.Material.Filled.Handyman" Disabled="IsNew">
            <div class="d-flex justify-space-between align-center mb-4">
                <div>
                    <MudText Typo="Typo.h6" Class="fw-bold">Workshop Tools &amp; Machinery Inventory</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">Required equipment verification for curriculum training delivery.</MudText>
                </div>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="OpenAddToolDialog" aria-label="Add Tool">
                    Add Tool / Equipment
                </MudButton>
            </div>

            <MudTable Items="_approval.ToolItems" Hover="true" Striped="true" Elevation="1" Class="rounded-lg">
                <HeaderContent>
                    <MudTh>Tool / Equipment Name</MudTh>
                    <MudTh>Category</MudTh>
                    <MudTh>Required Qty</MudTh>
                    <MudTh>Available Qty</MudTh>
                    <MudTh>Compliance Status</MudTh>
                    <MudTh>Remarks</MudTh>
                    <MudTh Style="text-align: right;">Action</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Tool Name">
                        <div class="fw-bold">@context.ToolName</div>
                    </MudTd>
                    <MudTd DataLabel="Category">
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Info">@context.Category</MudChip>
                    </MudTd>
                    <MudTd DataLabel="Required">@context.RequiredQuantity</MudTd>
                    <MudTd DataLabel="Available">@context.AvailableQuantity</MudTd>
                    <MudTd DataLabel="Compliance">
                        @if (context.IsCompliant)
                        {
                            <MudChip T="string" Color="Color.Success" Size="Size.Small" Variant="Variant.Filled" Icon="@Icons.Material.Filled.Check">Compliant</MudChip>
                        }
                        else
                        {
                            <MudChip T="string" Color="Color.Error" Size="Size.Small" Variant="Variant.Filled" Icon="@Icons.Material.Filled.Warning">Deficient</MudChip>
                        }
                    </MudTd>
                    <MudTd DataLabel="Remarks">@(context.Remarks ?? "—")</MudTd>
                    <MudTd DataLabel="Action" Style="text-align: right;">
                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small" OnClick="@(() => RemoveToolItem(context.Id))" aria-label="Remove Tool" />
                    </MudTd>
                </RowTemplate>
            </MudTable>
        </MudTabPanel>

        <!-- TAB 4: Placed & Active Learners -->
        <MudTabPanel Text="Placed Learners" Icon="@Icons.Material.Filled.School" Disabled="IsNew">
            <div class="d-flex flex-wrap justify-space-between align-center mb-4 gap-3">
                <div>
                    <MudText Typo="Typo.h6">Placed Apprentices &amp; Learners</MudText>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Learners gaining practical workplace logbook experience under this approved trade scope</MudText>
                </div>
                <MudChip T="string" Color="Color.Primary" Size="Size.Small" Variant="Variant.Filled">
                    @_placedLearners.Count Active Learners Placed
                </MudChip>
            </div>

            @if (_loadingLearners)
            {
                <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="my-4" />
            }
            else
            {
                <MudTable Items="_placedLearners" Hover="true" Dense="true" Striped="true" Elevation="1">
                    <HeaderContent>
                        <MudTh>Contract No</MudTh>
                        <MudTh>Learner Full Name</MudTh>
                        <MudTh>RSA ID / Passport</MudTh>
                        <MudTh>Trade / Qualification</MudTh>
                        <MudTh>Programme Type</MudTh>
                        <MudTh>Enrolment Status</MudTh>
                        <MudTh>Registered Date</MudTh>
                        <MudTh Style="text-align:right">Action</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="Contract No"><strong>@context.LearnerContractNumber</strong></MudTd>
                        <MudTd DataLabel="Learner Name">@context.FullName</MudTd>
                        <MudTd DataLabel="RSA ID">@(!string.IsNullOrWhiteSpace(context.RsaIdNumber) ? context.RsaIdNumber : "-")</MudTd>
                        <MudTd DataLabel="Qualification">@context.QualificationTitle</MudTd>
                        <MudTd DataLabel="Programme Type">
                            <MudChip T="string" Color="Color.Info" Size="Size.Small" Variant="Variant.Outlined">
                                @context.ProgrammeTypeName
                            </MudChip>
                        </MudTd>
                        <MudTd DataLabel="Status">
                            <MudChip T="string" Color="Color.Success" Size="Size.Small">@context.EnrolmentStatus</MudChip>
                        </MudTd>
                        <MudTd DataLabel="Registered">@context.RegistrationDate.ToString("yyyy-MM-dd")</MudTd>
                        <MudTd Style="text-align:right" DataLabel="Action">
                            <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary" Href="@($"/learners/{context.CompanyLearnerId}")">
                                Open Learner
                            </MudButton>
                        </MudTd>
                    </RowTemplate>
                    <NoRecordsContent>
                        <div class="pa-4 text-center">
                            <MudText Typo="Typo.body2" Color="Color.Secondary">No active learners currently placed under this workplace approval scope.</MudText>
                        </div>
                    </NoRecordsContent>
                </MudTable>
            }
        </MudTabPanel>

        <!-- TAB 5: Partnering Providers (SDP) -->
        <MudTabPanel Text="Training Providers (SDP)" Icon="@Icons.Material.Filled.AccountBalance" Disabled="IsNew">
            <div class="d-flex flex-wrap justify-space-between align-center mb-4 gap-3">
                <div>
                    <MudText Typo="Typo.h6">Partnering Skills Development Providers (SDP)</MudText>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Accredited training institutions providing theoretical training for placed candidates</MudText>
                </div>
            </div>

            @if (_loadingSdps)
            {
                <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="my-4" />
            }
            else
            {
                <MudTable Items="_partnerSdps" Hover="true" Dense="true" Striped="true" Elevation="1">
                    <HeaderContent>
                        <MudTh>Provider Name</MudTh>
                        <MudTh>Accreditation No</MudTh>
                        <MudTh>Contact Person</MudTh>
                        <MudTh>Contact Email</MudTh>
                        <MudTh>Cohort Placed</MudTh>
                        <MudTh Style="text-align:right">Action</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="Provider Name">
                            <div class="d-flex align-center gap-2">
                                <MudIcon Icon="@Icons.Material.Filled.School" Color="Color.Primary" Size="Size.Small" />
                                <MudLink Href="@($"/sdp/{context.ProviderId}")" Typo="Typo.body2" Class="fw-bold">
                                    @context.ProviderName
                                </MudLink>
                            </div>
                        </MudTd>
                        <MudTd DataLabel="Accreditation No">@context.AccreditationNumber</MudTd>
                        <MudTd DataLabel="Contact">@(context.ContactPersonName ?? "-")</MudTd>
                        <MudTd DataLabel="Email">@(context.ContactEmail ?? "-")</MudTd>
                        <MudTd DataLabel="Cohort">
                            <MudChip T="string" Color="Color.Info" Size="Size.Small">
                                @context.CohortCount Learners
                            </MudChip>
                        </MudTd>
                        <MudTd Style="text-align:right" DataLabel="Action">
                            <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.School" Href="@($"/sdp/{context.ProviderId}")">
                                View SDP
                            </MudButton>
                        </MudTd>
                    </RowTemplate>
                    <NoRecordsContent>
                        <div class="pa-4 text-center">
                            <MudText Typo="Typo.body2" Color="Color.Secondary">No external training providers mapped to this workplace agreement.</MudText>
                        </div>
                    </NoRecordsContent>
                </MudTable>
            }
        </MudTabPanel>

        <!-- TAB 6: Site Verification Visits -->
        <MudTabPanel Text="Site Visits &amp; Audits" Icon="@Icons.Material.Filled.EventAvailable" Disabled="IsNew">
            <div class="d-flex justify-space-between align-center mb-4">
                <div>
                    <MudText Typo="Typo.h6" Class="fw-bold">Workplace Site Inspection &amp; Monitoring Visits</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">Physical on-site audit trail and compliance verification visits.</MudText>
                </div>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.AddLocationAlt" OnClick="OpenScheduleVisitDialog" aria-label="Schedule Site Visit">
                    Schedule Site Visit
                </MudButton>
            </div>

            @if (_loadingVisits)
            {
                <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="my-4" />
            }
            else
            {
                <MudTable Items="_verificationVisits" Hover="true" Dense="true" Striped="true" Elevation="1">
                    <HeaderContent>
                        <MudTh>Visit Date</MudTh>
                        <MudTh>Visit Type</MudTh>
                        <MudTh>Designated Contact Person</MudTh>
                        <MudTh>Location</MudTh>
                        <MudTh>Purpose</MudTh>
                        <MudTh>Status</MudTh>
                        <MudTh>Outcome Findings</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="Visit Date">@context.VisitDate.ToString("yyyy-MM-dd")</MudTd>
                        <MudTd DataLabel="Visit Type">
                            <MudChip T="string" Color="Color.Info" Size="Size.Small" Variant="Variant.Outlined">
                                @context.VisitType
                            </MudChip>
                        </MudTd>
                        <MudTd DataLabel="Contact">@(context.ContactPersonName ?? "—")</MudTd>
                        <MudTd DataLabel="Location">@(context.Location ?? "Main Plant")</MudTd>
                        <MudTd DataLabel="Purpose">@context.Purpose</MudTd>
                        <MudTd DataLabel="Status">
                            <MudChip T="string" Color="@GetStatusColor(context.VisitStatus)" Size="Size.Small">
                                @context.VisitStatus
                            </MudChip>
                        </MudTd>
                        <MudTd DataLabel="Findings">@(context.OutcomeNotes ?? "—")</MudTd>
                    </RowTemplate>
                    <NoRecordsContent>
                        <div class="pa-4 text-center">
                            <MudText Typo="Typo.body2" Color="Color.Secondary">No site verification visits recorded for this approval yet.</MudText>
                        </div>
                    </NoRecordsContent>
                </MudTable>
            }
        </MudTabPanel>

        <!-- TAB 7: Statutory Audit & Compliance Outcome -->
        @if (!IsNew && (_approval.VerifiedDate.HasValue || _approval.DecisionDate.HasValue || !string.IsNullOrWhiteSpace(_approval.VerificationRecommendationReason) || !string.IsNullOrWhiteSpace(_approval.ApprovalReason)))
        {
            <MudTabPanel Text="Verification & Decision Audit" Icon="@Icons.Material.Filled.VerifiedUser">
                <MudGrid Spacing="3">
                    <MudItem xs="12" md="6">
                        <MudCard Outlined="true" Class="pa-4">
                            <MudCardHeader>
                                <CardHeaderAvatar>
                                    <MudAvatar Color="Color.Info" Variant="Variant.Filled">
                                        <MudIcon Icon="@Icons.Material.Filled.FactCheck" />
                                    </MudAvatar>
                                </CardHeaderAvatar>
                                <CardHeaderContent>
                                    <MudText Typo="Typo.h6">Workplace Verification Audit</MudText>
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">Concluded by Verification Officer</MudText>
                                </CardHeaderContent>
                            </MudCardHeader>
                            <MudCardContent>
                                <ReadOnlyField Label="Verification Officer" Value="@(_approval.VerifiedByPerson?.FullName ?? "—")" />
                                <ReadOnlyField Label="Verification Date" Value="@(_approval.VerifiedDate?.ToString("yyyy-MM-dd") ?? "—")" />
                                <ReadOnlyField Label="Site Visit Conducted" Value="@(_approval.IsSiteVisitRequired == true ? "Yes (Physical Inspection)" : "No (Desktop Verification)")" />
                                @if (!string.IsNullOrWhiteSpace(_approval.SiteVisitJustification))
                                {
                                    <ReadOnlyField Label="Site Visit Justification" Value="@_approval.SiteVisitJustification" />
                                }
                                @if (!string.IsNullOrWhiteSpace(_approval.VerificationRecommendationReason))
                                {
                                    <ReadOnlyField Label="Recommendation Reason" Value="@_approval.VerificationRecommendationReason" />
                                    <ReadOnlyField Label="Recommendation Explanation" Value="@_approval.VerificationRecommendationExplanation" />
                                }
                                @if (!string.IsNullOrWhiteSpace(_approval.VerificationRejectionReason))
                                {
                                    <ReadOnlyField Label="Rejection / Return Reason" Value="@_approval.VerificationRejectionReason" />
                                    <ReadOnlyField Label="Rejection / Return Explanation" Value="@_approval.VerificationRejectionExplanation" />
                                }
                            </MudCardContent>
                        </MudCard>
                    </MudItem>

                    <MudItem xs="12" md="6">
                        <MudCard Outlined="true" Class="pa-4">
                            <MudCardHeader>
                                <CardHeaderAvatar>
                                    <MudAvatar Color="Color.Success" Variant="Variant.Filled">
                                        <MudIcon Icon="@Icons.Material.Filled.Gavel" />
                                    </MudAvatar>
                                </CardHeaderAvatar>
                                <CardHeaderContent>
                                    <MudText Typo="Typo.h6">Committee / Executive Decision</MudText>
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">Rendered by Approval Authority (Maker-Checker)</MudText>
                                </CardHeaderContent>
                            </MudCardHeader>
                            <MudCardContent>
                                <ReadOnlyField Label="Decision Maker" Value="@(_approval.DecisionByPerson?.FullName ?? "—")" />
                                <ReadOnlyField Label="Decision Date" Value="@(_approval.DecisionDate?.ToString("yyyy-MM-dd") ?? "—")" />
                                <ReadOnlyField Label="Approval Outcome" Value="@_approval.ApprovalStatusCode" />
                                @if (!string.IsNullOrWhiteSpace(_approval.ApprovalReason))
                                {
                                    <ReadOnlyField Label="Approval Reason" Value="@_approval.ApprovalReason" />
                                    <ReadOnlyField Label="Approval Explanation" Value="@_approval.ApprovalExplanation" />
                                }
                                @if (!string.IsNullOrWhiteSpace(_approval.RejectionReason))
                                {
                                    <ReadOnlyField Label="Rejection Reason" Value="@_approval.RejectionReason" />
                                    <ReadOnlyField Label="Rejection Explanation" Value="@_approval.RejectionExplanation" />
                                }
                            </MudCardContent>
                        </MudCard>
                    </MudItem>
                </MudGrid>
            </MudTabPanel>
        }

        <!-- TAB 8: Evidence Vault -->
        @if (!IsNew)
        {
            <MudTabPanel Text="Evidence Vault" Icon="@Icons.Material.Filled.FolderZip">
                <DocumentVault TargetEntityName="WorkplaceApproval" TargetEntityId="@Id" />
            </MudTabPanel>

            <!-- TAB 9: Workflow History -->
            <MudTabPanel Text="Workflow History" Icon="@Icons.Material.Filled.History">
                <WorkflowTimeline ProcessCode="WPAPP" EntityId="@Id" />
            </MudTabPanel>
        }
    </MudTabs>
}

<!-- STATUTORY VERIFICATION AUDIT DIALOG (Role-Neutral Verification Officer) -->
<MudDialog @bind-Visible="_verificationDialogOpen">
    <TitleContent>
        <div class="d-flex align-center gap-2">
            <MudIcon Icon="@Icons.Material.Filled.FactCheck" Color="Color.Primary" />
            <MudText Typo="Typo.h6">Conclude Workplace Verification (Audit Report)</MudText>
        </div>
    </TitleContent>
    <DialogContent>
        <MudGrid>
            <MudItem xs="12">
                <MudAlert Severity="Severity.Info" Dense="true" Class="mb-2">
                    Record compliance audit findings per the statutory criteria. A generated inspection report (ETQ-TP-054) will be produced.
                </MudAlert>
            </MudItem>
            <MudItem xs="12" md="6">
                <MudSwitch T="bool" @bind-Value="_verifyIsSiteVisitRequired" Label="Physical Site Inspection Conducted" Color="Color.Primary" />
            </MudItem>
            <MudItem xs="12" md="6">
                <MudSelect T="int?" @bind-Value="_verifyOfficerPersonId" Label="Verification Officer" Variant="Variant.Outlined" Required="true">
                    @foreach (var p in _people)
                    {
                        <MudSelectItem Value="@((int?)p.Id)">@p.FullName (@(p.RsaIdNumber ?? p.Email))</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>

            @if (!_verifyIsSiteVisitRequired)
            {
                <MudItem xs="12">
                    <MudTextField @bind-Value="_verifySiteVisitJustification" Label="Desktop Verification Justification" Variant="Variant.Outlined" Required="true"
                                  Placeholder="e.g. Existing approved workshop site with valid tooling certification and unchanged plant layout..." />
                </MudItem>
            }

            <MudItem xs="12">
                <MudRadioGroup T="bool" @bind-Value="_verifyIsRecommended">
                    <MudRadio Value="true" Color="Color.Success">Recommend Workplace Approval</MudRadio>
                    <MudRadio Value="false" Color="Color.Error">Recommend Rejection / Return for Updates</MudRadio>
                </MudRadioGroup>
            </MudItem>

            @if (_verifyIsRecommended)
            {
                <MudItem xs="12" md="6">
                    <MudSelect T="string" @bind-Value="_verifyRecommendationReason" Label="Recommendation Reason" Variant="Variant.Outlined" Required="true">
                        <MudSelectItem Value="@("FullCompliance")">Full Compliance with Trade Curriculum & Tooling</MudSelectItem>
                        <MudSelectItem Value="@("QualifiedArtisans")">Sufficient Qualified Artisan Mentors at 1:4 Ratio</MudSelectItem>
                        <MudSelectItem Value="@("SafeWorkingEnvironment")">OHS Act & Safety Standards Satisfied</MudSelectItem>
                    </MudSelect>
                </MudItem>
                <MudItem xs="12">
                    <MudTextField @bind-Value="_verifyRecommendationExplanation" Label="Detailed Recommendation Findings" Variant="Variant.Outlined" Lines="2"
                                  Placeholder="Detail observations on toolroom condition, mentor credentials, and training capacity..." />
                </MudItem>
            }
            else
            {
                <MudItem xs="12" md="6">
                    <MudSelect T="string" @bind-Value="_verifyRejectionReason" Label="Rejection / Return Reason" Variant="Variant.Outlined" Required="true">
                        <MudSelectItem Value="@("MissingTools")">Mandatory Curriculum Tools Deficient or Unavailable</MudSelectItem>
                        <MudSelectItem Value="@("NoCertifiedMentors")">Insufficient Qualified Artisan Mentors for Trade</MudSelectItem>
                        <MudSelectItem Value="@("OHSNonCompliance")">Occupational Health & Safety Hazard Identified</MudSelectItem>
                        <MudSelectItem Value="@("IncompleteEvidence")">Incomplete Portfolio / Evidence Documentation</MudSelectItem>
                    </MudSelect>
                </MudItem>
                <MudItem xs="12">
                    <MudTextField @bind-Value="_verifyRejectionExplanation" Label="Deficiency Explanation & Corrective Actions" Variant="Variant.Outlined" Lines="2"
                                  Placeholder="Specify exact deficiencies required to be rectified before re-inspection..." />
                </MudItem>
            }
        </MudGrid>
    </DialogContent>
    <DialogActions>
        <MudButton StartIcon="@Icons.Material.Filled.Cancel" OnClick="@(() => _verificationDialogOpen = false)">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Check" OnClick="SaveVerificationAsync">
            Submit Verification
        </MudButton>
    </DialogActions>
</MudDialog>

<!-- STATUTORY EVALUATION & DECISION DIALOG (Role-Neutral Approval Authority) -->
<MudDialog @bind-Visible="_evaluationDialogOpen">
    <TitleContent>
        <div class="d-flex align-center gap-2">
            <MudIcon Icon="@Icons.Material.Filled.Gavel" Color="Color.Success" />
            <MudText Typo="Typo.h6">Render Statutory Approval Decision (Maker-Checker)</MudText>
        </div>
    </TitleContent>
    <DialogContent>
        <MudGrid>
            <MudItem xs="12">
                <MudAlert Severity="Severity.Info" Dense="true" Class="mb-2">
                    Approval Authority gatekeeper. Approval triggers issuance of the official Workplace Approval Letter (ETQ-TP-003).
                </MudAlert>
            </MudItem>
            <MudItem xs="12" md="6">
                <MudSelect T="int?" @bind-Value="_evalDecisionMakerPersonId" Label="Approval Authority / Committee Chair" Variant="Variant.Outlined" Required="true">
                    @foreach (var p in _people)
                    {
                        <MudSelectItem Value="@((int?)p.Id)">@p.FullName (@(p.RsaIdNumber ?? p.Email))</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12" md="6">
                <MudRadioGroup T="bool" @bind-Value="_evalIsApproved">
                    <MudRadio Value="true" Color="Color.Success">Grant Workplace Approval</MudRadio>
                    <MudRadio Value="false" Color="Color.Error">Decline Workplace Approval</MudRadio>
                </MudRadioGroup>
            </MudItem>

            @if (_evalIsApproved)
            {
                <MudItem xs="12" md="6">
                    <MudSelect T="string" @bind-Value="_evalReason" Label="Approval Decision Category" Variant="Variant.Outlined" Required="true">
                        <MudSelectItem Value="@("AuditVerified")">Audit Criteria Fully Met & Verified</MudSelectItem>
                        <MudSelectItem Value="@("CommitteeApproved")">ETQA Committee Ratified Approval</MudSelectItem>
                        <MudSelectItem Value="@("StandardAccredited")">National Artisan Moderation Body Standards Met</MudSelectItem>
                    </MudSelect>
                </MudItem>
                <MudItem xs="12">
                    <MudTextField @bind-Value="_evalExplanation" Label="Decision Rationale & Terms of Accreditation" Variant="Variant.Outlined" Lines="2"
                                  Placeholder="Accredited for 3-year term subject to annual monitoring audits..." />
                </MudItem>
            }
            else
            {
                <MudItem xs="12" md="6">
                    <MudSelect T="string" @bind-Value="_evalReason" Label="Decline Reason Category" Variant="Variant.Outlined" Required="true">
                        <MudSelectItem Value="@("FailedAudit")">Critical Audit Deficiencies Unresolved</MudSelectItem>
                        <MudSelectItem Value="@("NonCompliantRatios")">Artisan Supervision Ratio Exceeded</MudSelectItem>
                        <MudSelectItem Value="@("CommitteeDeclined")">Committee Adjudication Declined</MudSelectItem>
                    </MudSelect>
                </MudItem>
                <MudItem xs="12">
                    <MudTextField @bind-Value="_evalExplanation" Label="Formal Decline Reason" Variant="Variant.Outlined" Lines="2"
                                  Placeholder="Detailed reasons for declining accreditation..." />
                </MudItem>
            }
        </MudGrid>
    </DialogContent>
    <DialogActions>
        <MudButton StartIcon="@Icons.Material.Filled.Cancel" OnClick="@(() => _evaluationDialogOpen = false)">Cancel</MudButton>
        <MudButton Color="@(_evalIsApproved ? Color.Success : Color.Error)" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Save" OnClick="SaveEvaluationAsync">
            @(_evalIsApproved ? "Grant Approval" : "Decline Approval")
        </MudButton>
    </DialogActions>
</MudDialog>

