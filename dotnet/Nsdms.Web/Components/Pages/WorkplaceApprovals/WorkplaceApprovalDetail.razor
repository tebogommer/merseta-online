@code {
    [Parameter] public int Id { get; set; }
    private bool IsNew => Id == 0;
    private bool _isEditMode = false;

    private WorkplaceApproval _approval = new();
    private List<Organisation> _organisations = new();
    private List<OrganisationSite> _sites = new();
    private List<Person> _people = new();
    private List<BreadcrumbItem> _breadcrumbItems = new();

    private bool _loading = true;
    private bool _saving = false;
    private int _activeTabIndex = 0;

    private DateTime? _inspectionDate;
    private DateTime? _approvalDate;
    private DateTime? _expiryDate;

    // 360-Degree Relational Collections
    private List<WpaLearnerDto> _placedLearners = new();
    private List<WpaSdpDto> _partnerSdps = new();
    private List<WpaVisitDto> _verificationVisits = new();

    private bool _loadingLearners = false;
    private bool _loadingSdps = false;
    private bool _loadingVisits = false;

    // Ratio & Policy State
    private MentorRatioEvaluationResult _ratioEval = new();
    private List<TradeMentorRatioPolicy> _tradePolicies = new();
    private bool _editMentorCapacityOpen = false;
    private WorkplaceApprovalMentor? _editingMentor;
    private int? _overrideMentorCap;
    private bool _overrideMentorIsExempt;
    private bool _overrideMentorIsEnforced = true;
    private string? _overrideMentorNotes;

    // Modals
    private bool _addMentorOpen = false;
    private WorkplaceApprovalMentor _newMentor = new();

    private bool _addToolOpen = false;
    private WorkplaceApprovalToolList _newTool = new();

    private bool _scheduleVisitOpen = false;
    private DateTime? _newVisitDate = DateTime.Today.AddDays(7);
    private int _newVisitContactPersonId;
    private string _newVisitLocation = string.Empty;
    private string _newVisitPurpose = "Workplace Approval Site Audit & Tool Inspection";

    // Statutory Verification Dialog State (Role-Neutral)
    private bool _verificationDialogOpen = false;
    private bool _verifyIsSiteVisitRequired = true;
    private string? _verifySiteVisitJustification;
    private bool _verifyIsRecommended = true;
    private string? _verifyRecommendationReason = "FullCompliance";
    private string? _verifyRecommendationExplanation;
    private string? _verifyRejectionReason = "MissingTools";
    private string? _verifyRejectionExplanation;
    private int? _verifyOfficerPersonId;

    // Statutory Evaluation Dialog State (Role-Neutral)
    private bool _evaluationDialogOpen = false;
    private bool _evalIsApproved = true;
    private string? _evalReason = "AuditVerified";
    private string? _evalExplanation;
    private int? _evalDecisionMakerPersonId;

    // Withdraw Dialog State
    private bool _withdrawDialogOpen = false;
    private string? _withdrawReason;

    protected override async Task OnInitializedAsync()
    {
        _loading = true;
        try
        {
            _isEditMode = IsNew || Navigation.Uri.EndsWith("/edit", StringComparison.OrdinalIgnoreCase);

            _organisations = await OrganisationService.GetAllAsync();
            _people = await PersonService.GetAllAsync();
            _tradePolicies = await RatioEngine.GetAllTradePoliciesAsync(activeOnly: true);

            SetupBreadcrumbs();

            if (!IsNew)
            {
                await LoadApprovalDataAsync();
            }
            else
            {
                _approval = new WorkplaceApproval
                {
                    ApprovalStatusCode = "DRAFT",
                    LearningProgramTypeCode = "Apprenticeship",
                    RequiresWorkplaceApproval = true,
                    IsSiteVisitRequired = true,
                    InspectionDate = DateTime.Today,
                    ApprovalDate = DateTime.Today,
                    ExpiryDate = DateTime.Today.AddYears(3),
                    IsActive = true
                };
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error loading approval details: {ex.Message}", Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private void SetupBreadcrumbs()
    {
        _breadcrumbItems = new List<BreadcrumbItem>
        {
            new BreadcrumbItem("Home", href: "/"),
            new BreadcrumbItem("Workplace Approvals", href: "/workplace-approvals"),
            new BreadcrumbItem(IsNew ? "New Application" : $"Approval #{Id}", href: null, disabled: true)
        };
    }

    private void EnterEditMode()
    {
        _isEditMode = true;
        Navigation.NavigateTo($"/workplace-approvals/{Id}/edit", replace: true);
    }

    private void ExitEditMode()
    {
        _isEditMode = false;
        Navigation.NavigateTo($"/workplace-approvals/{Id}", replace: true);
    }

    private async Task LoadApprovalDataAsync()
    {
        var existing = await ApprovalService.GetByIdAsync(Id);
        if (existing != null)
        {
            _approval = existing;
            _inspectionDate = _approval.InspectionDate;
            _approvalDate = _approval.ApprovalDate;
            _expiryDate = _approval.ExpiryDate;

            if (_approval.OrganisationId > 0)
            {
                _sites = await OrganisationService.GetSitesAsync(_approval.OrganisationId);
            }

            // Load 360-Degree Relational Collections
            _loadingLearners = true;
            _loadingSdps = true;
            _loadingVisits = true;

            _placedLearners = await ApprovalService.GetPlacedLearnersAsync(Id);
            _loadingLearners = false;

            _partnerSdps = await ApprovalService.GetPartnerSdpsAsync(Id);
            _loadingSdps = false;

            _verificationVisits = await ApprovalService.GetVerificationVisitsAsync(Id);
            _loadingVisits = false;

            // Evaluate live statutory mentor ratio and supervision capacity
            try
            {
                _ratioEval = await RatioEngine.EvaluateWorkplaceApprovalCapacityAsync(Id);
            }
            catch
            {
                _ratioEval = new MentorRatioEvaluationResult();
            }
        }
        else
        {
            Snackbar.Add($"Workplace approval with ID {Id} not found.", Severity.Warning);
            Navigation.NavigateTo("/workplace-approvals");
        }
    }

    private async Task OnWorkflowStatusChanged(string newStatus)
    {
        await LoadApprovalDataAsync();
        StateHasChanged();
    }

    private async Task SaveAsync()
    {
        if (_approval.OrganisationId <= 0)
        {
            Snackbar.Add("Please select a valid Host Employer.", Severity.Warning);
            return;
        }

        if (!_approval.ContactPersonId.HasValue || _approval.ContactPersonId.Value <= 0)
        {
            Snackbar.Add("Please select a mandatory Employer Contact Person per visit governance rules.", Severity.Warning);
            return;
        }

        if (string.IsNullOrWhiteSpace(_approval.QualificationTitle))
        {
            Snackbar.Add("Please specify the Qualification / Trade Title.", Severity.Warning);
            return;
        }

        _saving = true;
        try
        {
            _approval.InspectionDate = _inspectionDate;
            _approval.ApprovalDate = _approvalDate;
            _approval.ExpiryDate = _expiryDate;

            var saved = await ApprovalService.SaveAsync(_approval, "ADMIN");
            Snackbar.Add("Workplace Approval saved successfully!", Severity.Success);

            if (IsNew)
            {
                Navigation.NavigateTo($"/workplace-approvals/{saved.Id}");
            }
            else
            {
                _approval = saved;
                _isEditMode = false;
                Navigation.NavigateTo($"/workplace-approvals/{Id}", replace: true);
                await LoadApprovalDataAsync();
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error saving approval: {ex.Message}", Severity.Error);
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task DeleteAsync()
    {
        var confirm = await DialogService.ShowMessageBoxAsync(
            "Delete Workplace Approval",
            $"Are you sure you want to delete Workplace Approval '{_approval.ApprovalNumber}'? This action cannot be undone.",
            yesText: "Delete", cancelText: "Cancel");

        if (confirm == true)
        {
            var success = await ApprovalService.DeleteAsync(Id, "ADMIN");
            if (success)
            {
                Snackbar.Add("Workplace Approval deleted successfully.", Severity.Success);
                Navigation.NavigateTo("/workplace-approvals");
            }
        }
    }

    private void DownloadOutcomeLetterPdf()
    {
        Navigation.NavigateTo($"/api/documents/workplace-approval/{Id}/letter-pdf", forceLoad: true);
    }

    private void DownloadInspectionReportPdf()
    {
        Navigation.NavigateTo($"/api/documents/workplace-approval/{Id}/report-pdf", forceLoad: true);
    }

    private void OpenVerificationDialog()
    {
        _verifyIsSiteVisitRequired = _approval.IsSiteVisitRequired ?? true;
        _verifySiteVisitJustification = _approval.SiteVisitJustification;
        _verifyOfficerPersonId = _approval.VerifiedByPersonId ?? _approval.AssessorPersonId ?? _people.FirstOrDefault()?.Id;
        _verificationDialogOpen = true;
    }

    private async Task SaveVerificationAsync()
    {
        try
        {
            await ApprovalService.VerifyWorkplaceAsync(
                Id,
                _verifyIsSiteVisitRequired,
                _verifySiteVisitJustification,
                _approval.InspectionDate,
                _verifyIsRecommended ? _verifyRecommendationReason : null,
                _verifyIsRecommended ? _verifyRecommendationExplanation : null,
                !_verifyIsRecommended ? _verifyRejectionReason : null,
                !_verifyIsRecommended ? _verifyRejectionExplanation : null,
                _verifyOfficerPersonId,
                "ADMIN");

            Snackbar.Add("Workplace verification report concluded and transition executed.", Severity.Success);
            _verificationDialogOpen = false;
            await LoadApprovalDataAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Verification error: {ex.Message}", Severity.Error);
        }
    }

    private void OpenEvaluationDialog()
    {
        _evalDecisionMakerPersonId = _approval.DecisionByPersonId ?? _people.FirstOrDefault()?.Id;
        _evaluationDialogOpen = true;
    }

    private async Task SaveEvaluationAsync()
    {
        try
        {
            await ApprovalService.EvaluateWorkplaceAsync(
                Id,
                _evalIsApproved,
                _evalReason,
                _evalExplanation,
                _evalDecisionMakerPersonId,
                "ADMIN");

            Snackbar.Add(_evalIsApproved ? "Workplace Approval granted by authority!" : "Workplace Approval rejected.", _evalIsApproved ? Severity.Success : Severity.Warning);
            _evaluationDialogOpen = false;
            await LoadApprovalDataAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Evaluation error: {ex.Message}", Severity.Error);
        }
    }

    private void OpenWithdrawDialog()
    {
        _withdrawDialogOpen = true;
    }

    private async Task SaveWithdrawAsync()
    {
        if (string.IsNullOrWhiteSpace(_withdrawReason))
        {
            Snackbar.Add("Please provide a reason for withdrawal.", Severity.Warning);
            return;
        }

        try
        {
            await ApprovalService.WithdrawWorkplaceApprovalAsync(Id, _withdrawReason, "ADMIN");
            Snackbar.Add("Workplace Approval application withdrawn.", Severity.Info);
            _withdrawDialogOpen = false;
            await LoadApprovalDataAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Withdrawal error: {ex.Message}", Severity.Error);
        }
    }

    private void OpenAddMentorDialog()
    {
        _newMentor = new WorkplaceApprovalMentor
        {
            WorkplaceApprovalId = _approval.Id,
            PersonId = _people.FirstOrDefault()?.Id ?? 0,
            IsCertifiedArtisan = true
        };
        _addMentorOpen = true;
    }

    private async Task SaveNewMentor()
    {
        if (_newMentor.PersonId <= 0)
        {
            Snackbar.Add("Please select a person.", Severity.Warning);
            return;
        }

        try
        {
            await ApprovalService.AddMentorAsync(_newMentor, "ADMIN");
            Snackbar.Add("Mentor added successfully.", Severity.Success);
            _addMentorOpen = false;
            await LoadApprovalDataAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error adding mentor: {ex.Message}", Severity.Error);
        }
    }

    private async Task RemoveMentor(int mentorId)
    {
        var success = await ApprovalService.RemoveMentorAsync(mentorId, "ADMIN");
        if (success)
        {
            Snackbar.Add("Mentor removed.", Severity.Success);
            await LoadApprovalDataAsync();
        }
    }

    private void OpenAddToolDialog()
    {
        _newTool = new WorkplaceApprovalToolList
        {
            WorkplaceApprovalId = _approval.Id,
            Category = "Mechanical",
            RequiredQuantity = 1,
            AvailableQuantity = 1
        };
        _addToolOpen = true;
    }

    private async Task SaveNewTool()
    {
        if (string.IsNullOrWhiteSpace(_newTool.ToolName))
        {
            Snackbar.Add("Tool name is required.", Severity.Warning);
            return;
        }

        try
        {
            await ApprovalService.AddToolItemAsync(_newTool, "ADMIN");
            Snackbar.Add("Tool added successfully.", Severity.Success);
            _addToolOpen = false;
            await LoadApprovalDataAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error adding tool: {ex.Message}", Severity.Error);
        }
    }

    private async Task RemoveToolItem(int toolItemId)
    {
        var success = await ApprovalService.RemoveToolItemAsync(toolItemId, "ADMIN");
        if (success)
        {
            Snackbar.Add("Tool removed.", Severity.Success);
            await LoadApprovalDataAsync();
        }
    }

    private void OpenScheduleVisitDialog()
    {
        _newVisitContactPersonId = _approval.ContactPersonId ?? _people.FirstOrDefault()?.Id ?? 0;
        _newVisitDate = DateTime.Today.AddDays(7);
        _newVisitLocation = _approval.OrganisationSite?.SiteName ?? _approval.Organisation?.CompanyName ?? "Main Plant";
        _newVisitPurpose = $"Workplace Approval Site Audit: {_approval.QualificationTitle}";
        _scheduleVisitOpen = true;
    }

    private async Task SaveScheduledVisit()
    {
        if (_newVisitContactPersonId <= 0)
        {
            Snackbar.Add("A specific Employer Contact Person must be selected per visit governance rules.", Severity.Warning);
            return;
        }

        try
        {
            var v = new Visit
            {
                OrganisationId = _approval.OrganisationId,
                ContactPersonId = _newVisitContactPersonId,
                VisitTypeCode = "WorkplaceApproval",
                VisitStatusCode = "Scheduled",
                VisitDate = _newVisitDate ?? DateTime.Today.AddDays(7),
                Location = _newVisitLocation,
                Purpose = _newVisitPurpose,
                Title = $"WPA Audit - {_approval.QualificationTitle}"
            };

            await VisitService.ScheduleVisitAsync(v, "ADMIN");
            Snackbar.Add("Site verification visit scheduled successfully with contact person validation.", Severity.Success);
            _scheduleVisitOpen = false;
            await LoadApprovalDataAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error scheduling visit: {ex.Message}", Severity.Error);
        }
    }

    private void OpenEditMentorCapacityDialog(WorkplaceApprovalMentor mentor)
    {
        _editingMentor = mentor;
        _overrideMentorCap = mentor.MaxLearnerCapacity;
        _overrideMentorIsExempt = mentor.IsRatioExempt;
        _overrideMentorIsEnforced = mentor.IsRatioEnforced;
        _overrideMentorNotes = mentor.Notes;
        _editMentorCapacityOpen = true;
    }

    private async Task SaveMentorCapacityOverrideAsync()
    {
        if (_editingMentor == null) return;

        try
        {
            await RatioEngine.SetMentorCapacityOverrideAsync(
                _editingMentor.Id,
                _overrideMentorCap,
                _overrideMentorIsExempt,
                _overrideMentorIsEnforced,
                _overrideMentorNotes,
                "ADMIN");

            Snackbar.Add($"Supervision capacity override updated for {_editingMentor.Person?.FullName ?? "Mentor"}.", Severity.Success);
            _editMentorCapacityOpen = false;
            await LoadApprovalDataAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error saving mentor override: {ex.Message}", Severity.Error);
        }
    }

    private static Color GetCapacityColor(MentorRatioComplianceStatus status) => status switch
    {
        MentorRatioComplianceStatus.Compliant => Color.Success,
        MentorRatioComplianceStatus.NearCapacity => Color.Warning,
        MentorRatioComplianceStatus.OverCapacity => Color.Error,
        MentorRatioComplianceStatus.Exempt => Color.Info,
        _ => Color.Default
    };

    private static Severity GetAlertSeverity(MentorRatioComplianceStatus status) => status switch
    {
        MentorRatioComplianceStatus.Compliant => Severity.Success,
        MentorRatioComplianceStatus.NearCapacity => Severity.Warning,
        MentorRatioComplianceStatus.OverCapacity => Severity.Error,
        MentorRatioComplianceStatus.Exempt => Severity.Info,
        _ => Severity.Normal
    };

    private static string GetEnforcementStateDisplay(MentorRatioEnforcementState state) => state switch
    {
        MentorRatioEnforcementState.StrictlyEnforced => "Statutory Enforced",
        MentorRatioEnforcementState.OrgExempt => "Organisation Exempt",
        MentorRatioEnforcementState.WorkplaceExempt => "Workplace Exempt",
        MentorRatioEnforcementState.GlobalDisabled => "Global Bypass",
        MentorRatioEnforcementState.TradeAdvisoryOnly => "Advisory Mode",
        MentorRatioEnforcementState.CustomOverride => "Custom Cap Active",
        _ => "Default"
    };

    private static Color GetStatusColor(string? status) => status?.ToUpperInvariant() switch
    {
        "APPROVED" or "ACTIVE" => Color.Success,
        "AUDITED" or "AUDIT_SCHEDULED" or "VERIFIED" or "UNDER_EVALUATION" => Color.Info,
        "DRAFT" or "APPLICATION" or "PENDING" => Color.Warning,
        "REJECTED" or "EXPIRED" or "WITHDRAWN" => Color.Error,
        _ => Color.Default
    };
}
