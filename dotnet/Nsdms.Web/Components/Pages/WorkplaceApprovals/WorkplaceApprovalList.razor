@page "/workplace-approvals"
@rendermode InteractiveServer
@inject IWorkplaceApprovalService ApprovalService
@inject NavigationManager Navigation
@inject ISnackbar Snackbar

<PageTitle>Workplace Approvals - NSDMS</PageTitle>

<div class="mb-4 d-flex justify-space-between align-center">
    <div>
        <MudBreadcrumbs Items="_breadcrumbItems" Class="pa-0 mb-1" />
        <MudText Typo="Typo.h4" Class="fw-bold">Workplace Approvals (WPA)</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary">Evaluate, approve, and verify host employer training infrastructure and workshop mentors.</MudText>
    </div>
    <div>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="@(() => Navigation.NavigateTo("/workplace-approvals/create"))">
            New Approval Application
        </MudButton>
    </div>
</div>

<MudCard Outlined="true" Class="mb-4">
    <MudCardContent Class="py-3">
        <MudGrid AlignItems="Center">
            <MudItem xs="12" sm="6" md="4">
                <MudTextField @bind-Value="_searchString" Immediate="true" Placeholder="Search approval no, qualification, employer..."
                              Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                              Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true" OnClearButtonClick="@(() => OnSearch(""))" TextChanged="OnSearch" />
            </MudItem>
            <MudItem xs="12" sm="6" md="3">
                <MudSelect T="string" Value="_selectedStatus" Label="Status Filter" Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true" ValueChanged="OnStatusFilterChanged">
                    <MudSelectItem Value="@("Pending")">Pending</MudSelectItem>
                    <MudSelectItem Value="@("Approved")">Approved</MudSelectItem>
                    <MudSelectItem Value="@("Rejected")">Rejected</MudSelectItem>
                    <MudSelectItem Value="@("Expired")">Expired</MudSelectItem>
                </MudSelect>
            </MudItem>
            <MudItem xs="12" sm="12" md="5" Class="d-flex justify-end gap-2">
                <MudButton Variant="Variant.Outlined" Color="Color.Default" StartIcon="@Icons.Material.Filled.Refresh" OnClick="LoadData">
                    Refresh
                </MudButton>
            </MudItem>
        </MudGrid>
    </MudCardContent>
</MudCard>

@if (_loading)
{
    <div class="d-flex justify-center my-8">
        <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Large" />
    </div>
}
else
{
    <MudTable T="WorkplaceApproval" Items="_approvals" Hover="true" Striped="true" Elevation="1" Class="rounded-lg" RowClass="cursor-pointer" OnRowClick="@(args => Navigation.NavigateTo($"/workplace-approvals/{args.Item.Id}"))">
        <HeaderContent>
            <MudTh>Approval Number</MudTh>
            <MudTh>Employer / Organisation</MudTh>
            <MudTh>Qualification Scope</MudTh>
            <MudTh>Inspection Date</MudTh>
            <MudTh>Expiry Date</MudTh>
            <MudTh>Mentors</MudTh>
            <MudTh>Status</MudTh>
            <MudTh Style="text-align: right;">Actions</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Approval Number">
                <div class="d-flex align-center gap-2">
                    <MudIcon Icon="@Icons.Material.Filled.FactCheck" Color="Color.Primary" Size="Size.Small" />
                    <span class="fw-bold font-monospace">@context.ApprovalNumber</span>
                </div>
            </MudTd>
            <MudTd DataLabel="Employer">
                <div>
                    <div class="fw-semibold">@(context.Organisation?.CompanyName ?? "Unknown")</div>
                    <div class="text-muted small">SDL: @(context.Organisation?.SdlNumber ?? "N/A")</div>
                </div>
            </MudTd>
            <MudTd DataLabel="Qualification">
                <div class="fw-medium">@context.QualificationTitle</div>
                @if (context.SaqaQualificationId.HasValue)
                {
                    <div class="text-muted small">SAQA ID: @context.SaqaQualificationId</div>
                }
            </MudTd>
            <MudTd DataLabel="Inspection Date">
                @(context.InspectionDate?.ToString("yyyy-MM-dd") ?? "Pending")
            </MudTd>
            <MudTd DataLabel="Expiry Date">
                @(context.ExpiryDate?.ToString("yyyy-MM-dd") ?? "—")
            </MudTd>
            <MudTd DataLabel="Mentors">
                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Info" Icon="@Icons.Material.Filled.Engineering">
                    @context.Mentors.Count Mentors
                </MudChip>
            </MudTd>
            <MudTd DataLabel="Status">
                @if (context.ApprovalStatusCode == "Approved")
                {
                    <MudChip T="string" Color="Color.Success" Size="Size.Small" Variant="Variant.Filled" Icon="@Icons.Material.Filled.CheckCircle">Approved</MudChip>
                }
                else if (context.ApprovalStatusCode == "Pending")
                {
                    <MudChip T="string" Color="Color.Warning" Size="Size.Small" Variant="Variant.Filled" Icon="@Icons.Material.Filled.Schedule">Pending</MudChip>
                }
                else if (context.ApprovalStatusCode == "Rejected")
                {
                    <MudChip T="string" Color="Color.Error" Size="Size.Small" Variant="Variant.Filled" Icon="@Icons.Material.Filled.Cancel">Rejected</MudChip>
                }
                else
                {
                    <MudChip T="string" Color="Color.Default" Size="Size.Small" Variant="Variant.Filled">@context.ApprovalStatusCode</MudChip>
                }
            </MudTd>
            <MudTd DataLabel="Actions" Style="text-align: right;">
                <MudIconButton Icon="@Icons.Material.Filled.Visibility" Color="Color.Primary" Size="Size.Small" Title="View Details"
                               OnClick="@(() => Navigation.NavigateTo($"/workplace-approvals/{context.Id}"))" />
                <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small" Title="Delete"
                               OnClick="@(() => DeleteApproval(context.Id))" />
            </MudTd>
        </RowTemplate>
        <PagerContent>
            <MudTablePager PageSizeOptions="new int[] { 10, 25, 50, 100 }" />
        </PagerContent>
    </MudTable>
}

@code {
    private List<WorkplaceApproval> _approvals = new();
    private bool _loading = true;
    private string _searchString = "";
    private string? _selectedStatus;

    private List<BreadcrumbItem> _breadcrumbItems = new()
    {
        new BreadcrumbItem("Dashboard", href: "/"),
        new BreadcrumbItem("Workplace Approvals", href: null, disabled: true)
    };

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        _loading = true;
        try
        {
            _approvals = await ApprovalService.GetAllAsync(_searchString, _selectedStatus);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error loading approvals: {ex.Message}", Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task OnSearch(string text)
    {
        _searchString = text;
        await LoadData();
    }

    private async Task OnStatusFilterChanged(string value)
    {
        _selectedStatus = value;
        await LoadData();
    }

    private async Task DeleteApproval(int id)
    {
        var success = await ApprovalService.DeleteAsync(id, "ADMIN");
        if (success)
        {
            Snackbar.Add("Workplace approval record deleted successfully.", Severity.Success);
            await LoadData();
        }
        else
        {
            Snackbar.Add("Failed to delete record.", Severity.Error);
        }
    }
}
