@page "/tasks"
@implements IDisposable
@using Nsdms.Application.Services
@using Nsdms.Domain.Entities
@inject IWorkflowEngineService WorkflowService
@inject IRealtimeNotificationService NotificationService
@inject NavigationManager Navigation
@inject ISnackbar Snackbar

<PageTitle>Universal Task Inbox - MerSETA NSDMS</PageTitle>

<div class="tasks-inbox-page">
    <!-- Top Header Bar -->
    <MudPaper Elevation="1" Class="d-flex flex-wrap justify-space-between align-center mb-6 pa-4 rounded-lg gap-3" Style="border-left: 6px solid var(--mud-palette-primary); background-color: var(--mud-palette-surface);">
        <div>
            <h1 class="font-weight-bold" style="font-size: 1.5rem; margin: 0; color: var(--mud-palette-text-primary);">Universal Task Inbox</h1>
            <p style="margin: 4px 0 0 0; font-size: 0.875rem; color: var(--mud-palette-text-secondary);">
                Cross-Module Workflow Orchestration &bull; Pending Approvals &amp; SLA Tracking
            </p>
        </div>
        <div class="d-flex align-center gap-2">
            <MudChip T="string" Color="Color.Primary" Variant="Variant.Filled" Size="Size.Small">
                @_filteredTasks.Count Pending Task(s)
            </MudChip>
        </div>
    </MudPaper>

    <!-- Filters & Search Toolbar -->
    <MudPaper Elevation="1" Class="pa-4 rounded-lg mb-4">
        <MudGrid Spacing="2" Class="align-center">
            <MudItem xs="12" sm="6" md="4">
                <MudTextField @bind-Value="_searchString" 
                              Placeholder="Search task title, process or entity..." 
                              Adornment="Adornment.Start" 
                              AdornmentIcon="@Icons.Material.Filled.Search" 
                              Variant="Variant.Outlined" 
                              Margin="Margin.Dense"
                              Immediate="true" />
            </MudItem>
            <MudItem xs="6" sm="3" md="2">
                <MudSelect T="string" @bind-Value="_statusFilter" Label="Task Status" Variant="Variant.Outlined" Margin="Margin.Dense">
                    <MudSelectItem Value="@("All")">All Statuses</MudSelectItem>
                    <MudSelectItem Value="@("Open")">Open</MudSelectItem>
                    <MudSelectItem Value="@("Claimed")">Claimed</MudSelectItem>
                    <MudSelectItem Value="@("Completed")">Completed</MudSelectItem>
                </MudSelect>
            </MudItem>
            <MudItem xs="6" sm="3" md="2">
                <MudSelect T="string" @bind-Value="_priorityFilter" Label="Priority" Variant="Variant.Outlined" Margin="Margin.Dense">
                    <MudSelectItem Value="@("All")">All Priorities</MudSelectItem>
                    <MudSelectItem Value="@("High")">High</MudSelectItem>
                    <MudSelectItem Value="@("Normal")">Normal</MudSelectItem>
                    <MudSelectItem Value="@("Low")">Low</MudSelectItem>
                </MudSelect>
            </MudItem>
            <MudItem xs="12" sm="12" md="4" Class="d-flex justify-end gap-2">
                <MudButton Variant="Variant.Outlined" 
                           Color="Color.Primary" 
                           StartIcon="@Icons.Material.Filled.Refresh" 
                           OnClick="LoadTasksAsync">
                    Refresh
                </MudButton>
            </MudItem>
        </MudGrid>
    </MudPaper>

    <!-- Tasks DataGrid -->
    <MudPaper Elevation="2" Class="rounded-lg" Style="overflow: hidden;">
        @if (_loading)
        {
            <div class="pa-8 text-center">
                <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
                <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mt-2">Loading workflow tasks...</MudText>
            </div>
        }
        else if (!_filteredTasks.Any())
        {
            <div class="pa-8 text-center">
                <MudIcon Icon="@Icons.Material.Filled.CheckCircleOutline" Size="Size.Large" Color="Color.Success" />
                <MudText Typo="Typo.h6" Class="mt-2 font-weight-bold">All Caught Up!</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">No pending tasks require your action at this time.</MudText>
            </div>
        }
        else
        {
            <MudTable T="WorkflowTask"
                      Items="@_filteredTasks" 
                      Dense="false" 
                      Hover="true" 
                      Elevation="0" 
                      Outlined="false"
                      RowClass="cursor-pointer"
                      OnRowClick="@(args => NavigateToTask(args.Item))">
                <HeaderContent>
                    <MudTh>Process / Title</MudTh>
                    <MudTh>Assigned Role</MudTh>
                    <MudTh>Priority</MudTh>
                    <MudTh>Due Date</MudTh>
                    <MudTh>Status</MudTh>
                    <MudTh Style="text-align: right;">Action</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Process / Title">
                        <div class="d-flex flex-column">
                            <MudText Typo="Typo.body2" Class="font-weight-bold" Color="Color.Primary">
                                @context.TaskTitle
                            </MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-1">
                                @context.TaskDescription
                            </MudText>
                        </div>
                    </MudTd>
                    <MudTd DataLabel="Assigned Role">
                        <MudChip T="string" Color="Color.Default" Variant="Variant.Filled" Size="Size.Small">
                            @(context.AssignedGroupRole ?? "Any Reviewer")
                        </MudChip>
                        @if (!string.IsNullOrEmpty(context.AssignedUserName))
                        {
                            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="d-block mt-1">
                                Claimed by: @context.AssignedUserName
                            </MudText>
                        }
                    </MudTd>
                    <MudTd DataLabel="Priority">
                        @if (context.Priority == "High" || context.Priority == "Urgent")
                        {
                            <MudChip T="string" Color="Color.Error" Variant="Variant.Filled" Size="Size.Small">
                                High
                            </MudChip>
                        }
                        else
                        {
                            <MudChip T="string" Color="Color.Default" Variant="Variant.Outlined" Size="Size.Small">
                                Normal
                            </MudChip>
                        }
                    </MudTd>
                    <MudTd DataLabel="Due Date">
                        <MudText Typo="Typo.body2" Class="font-weight-bold">
                            @context.DueDate.ToString("dd MMM yyyy")
                        </MudText>
                    </MudTd>
                    <MudTd DataLabel="Status">
                        @if (context.TaskStatus == "Open")
                        {
                            <MudChip T="string" Color="Color.Info" Variant="Variant.Filled" Size="Size.Small">
                                Open
                            </MudChip>
                        }
                        else if (context.TaskStatus == "Claimed")
                        {
                            <MudChip T="string" Color="Color.Warning" Variant="Variant.Filled" Size="Size.Small">
                                In Progress
                            </MudChip>
                        }
                        else
                        {
                            <MudChip T="string" Color="Color.Success" Variant="Variant.Filled" Size="Size.Small">
                                Completed
                            </MudChip>
                        }
                    </MudTd>
                    <MudTd DataLabel="Action" Style="text-align: right;">
                        <div class="d-flex justify-end gap-1">
                            @if (context.TaskStatus == "Open")
                            {
                                <MudButton Variant="Variant.Outlined" 
                                           Color="Color.Primary" 
                                           Size="Size.Medium"
                                           StartIcon="@Icons.Material.Filled.PersonAdd"
                                           OnClick="@((e) => ClaimTaskAsync(context))">
                                    Claim
                                </MudButton>
                            }
                            <MudButton Variant="Variant.Filled" 
                                       Color="Color.Primary" 
                                       Size="Size.Medium"
                                       EndIcon="@Icons.Material.Filled.ArrowForward"
                                       OnClick="@((e) => NavigateToTask(context))">
                                Review
                            </MudButton>
                        </div>
                    </MudTd>
                </RowTemplate>
            </MudTable>
        }
    </MudPaper>
</div>

@code {
    private List<WorkflowTask> _tasks = new();
    private bool _loading = true;
    private string _searchString = string.Empty;
    private string _statusFilter = "All";
    private string _priorityFilter = "All";

    private List<WorkflowTask> _filteredTasks => _tasks
        .Where(t => _statusFilter == "All" || t.TaskStatus.Equals(_statusFilter, StringComparison.OrdinalIgnoreCase))
        .Where(t => _priorityFilter == "All" || t.Priority.Equals(_priorityFilter, StringComparison.OrdinalIgnoreCase))
        .Where(t => string.IsNullOrWhiteSpace(_searchString) 
                    || t.TaskTitle.Contains(_searchString, StringComparison.OrdinalIgnoreCase) 
                    || (t.TaskDescription ?? "").Contains(_searchString, StringComparison.OrdinalIgnoreCase)
                    || (t.AssignedGroupRole ?? "").Contains(_searchString, StringComparison.OrdinalIgnoreCase))
        .ToList();

    protected override async Task OnInitializedAsync()
    {
        NotificationService.TaskAssignedReceived += OnRealtimeTaskReceived;
        NotificationService.WorkflowTransitionReceived += OnRealtimeWorkflowReceived;
        await LoadTasksAsync();
    }

    private void OnRealtimeTaskReceived(string taskId, string taskTitle, string assignedRole, string priority)
    {
        InvokeAsync(async () =>
        {
            await LoadTasksAsync();
            StateHasChanged();
        });
    }

    private void OnRealtimeWorkflowReceived(string entityType, int entityId, string fromState, string toState, string actor)
    {
        InvokeAsync(async () =>
        {
            await LoadTasksAsync();
            StateHasChanged();
        });
    }

    public void Dispose()
    {
        NotificationService.TaskAssignedReceived -= OnRealtimeTaskReceived;
        NotificationService.WorkflowTransitionReceived -= OnRealtimeWorkflowReceived;
    }

    private async Task LoadTasksAsync()
    {
        _loading = true;
        try
        {
            _tasks = await WorkflowService.GetUserTasksAsync();
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task ClaimTaskAsync(WorkflowTask task)
    {
        var updated = await WorkflowService.ClaimTaskAsync(task.Id, "admin@merseta.org.za", "Administrator");
        if (updated != null)
        {
            Snackbar.Add("Task claimed successfully.", Severity.Success);
            await LoadTasksAsync();
        }
    }

    private void NavigateToTask(WorkflowTask task)
    {
        if (!string.IsNullOrEmpty(task.TargetRoute))
        {
            Navigation.NavigateTo(task.TargetRoute);
        }
    }
}
