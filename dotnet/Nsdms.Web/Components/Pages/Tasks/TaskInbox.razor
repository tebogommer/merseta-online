@page "/tasks"
@implements IDisposable
@using Nsdms.Application.Services
@using Nsdms.Domain.Entities
@using Nsdms.Web.Components.Shared
@using MudBlazor
@inject IWorkflowEngineService WorkflowService
@inject IRealtimeNotificationService NotificationService
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@rendermode InteractiveServer

@*
  UI-STANDARD.md Archetype: A2 / T2 (Work Queue - Universal Task Inbox)
  Clauses: 4.2, 4.3 (A2), 6.1, 7.2, 7.4, 8.1, 8.3, 11.1–11.9, 15.2.5
  Distinctive elements:
  - SLA visual cues (due soon, overdue, critical).
  - Priority badges.
  - Claim / Unclaim / Reassign actions.
  - Tabbed queues: "My Active Tasks", "Unassigned Pool", "Completed Tasks".
*@

<EntityHeader Title="Universal Task Inbox"
              Subtitle="Cross-module workflow orchestration, SLA tracking and pending task authorisations"
              Status="Active"
              BreadcrumbItems="@_breadcrumbItems">
    <ActionZone>
        <MudButton Variant="Variant.Outlined" 
                   Color="Color.Default" 
                   Size="Size.Small"
                   StartIcon="@Icons.Material.Filled.Refresh" 
                   OnClick="LoadTasksAsync">
            Refresh
        </MudButton>
    </ActionZone>
</EntityHeader>

<!-- Enterprise Segmented Task Navigation (Sentence case, subtle count badges, neutral surface) -->
<nav class="nsdms-tab-nav" aria-label="Task Queues">
    <button type="button" 
            class="nsdms-tab-item @(_activeTabIndex == 0 ? "active" : "")" 
            @onclick="@(() => SwitchTab(0))"
            role="tab"
            aria-selected="@(_activeTabIndex == 0 ? "true" : "false")">
        <MudIcon Icon="@Icons.Material.Outlined.AssignmentInd" Size="Size.Small" Class="mr-2 text-secondary" />
        <span>My tasks</span>
        <span class="nsdms-tab-badge">@_myTasksCount</span>
    </button>
    <button type="button" 
            class="nsdms-tab-item @(_activeTabIndex == 1 ? "active" : "")" 
            @onclick="@(() => SwitchTab(1))"
            role="tab"
            aria-selected="@(_activeTabIndex == 1 ? "true" : "false")">
        <MudIcon Icon="@Icons.Material.Outlined.Group" Size="Size.Small" Class="mr-2 text-secondary" />
        <span>Unassigned</span>
        <span class="nsdms-tab-badge">@_unassignedCount</span>
    </button>
    <button type="button" 
            class="nsdms-tab-item @(_activeTabIndex == 2 ? "active" : "")" 
            @onclick="@(() => SwitchTab(2))"
            role="tab"
            aria-selected="@(_activeTabIndex == 2 ? "true" : "false")">
        <MudIcon Icon="@Icons.Material.Outlined.TaskAlt" Size="Size.Small" Class="mr-2 text-secondary" />
        <span>Completed</span>
    </button>
</nav>

<!-- Unified Task Workspace Surface -->
<div class="nsdms-workspace-surface" role="region" aria-label="Task Queue Workspace">
    <!-- Compact Enterprise Toolbar -->
    <div class="nsdms-table-toolbar d-flex flex-wrap align-center justify-space-between gap-3">
        <div class="d-flex align-center flex-grow-1 gap-2" style="max-width: 620px;">
            <div class="flex-grow-1" style="max-width: 360px;">
                <MudTextField T="string"
                              @bind-Value="_searchString"
                              @bind-Value:after="HandleFilterChanged"
                              Placeholder="Search tasks..."
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Search"
                              IconSize="Size.Small"
                              Margin="Margin.Dense"
                              Variant="Variant.Outlined"
                              Clearable="true"
                              Immediate="true"
                              DebounceInterval="250"
                              aria-label="Search tasks" />
            </div>

            <div style="width: 220px;">
                <MudSelect T="string"
                           Value="@_priorityFilter"
                           ValueChanged="OnPriorityFilterChanged"
                           Margin="Margin.Dense"
                           Variant="Variant.Outlined"
                           Dense="true"
                           AnchorOrigin="Origin.BottomLeft"
                           aria-label="Priority filter">
                    <MudSelectItem Value="@("All")">All Priorities</MudSelectItem>
                    <MudSelectItem Value="@("High")">High Priority</MudSelectItem>
                    <MudSelectItem Value="@("Normal")">Normal Priority</MudSelectItem>
                    <MudSelectItem Value="@("Low")">Low Priority</MudSelectItem>
                </MudSelect>
            </div>
        </div>

        <div class="d-flex align-center gap-2">
            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="font-monospace">
                @FilteredTasks.Count task@(FilteredTasks.Count == 1 ? "" : "s")
            </MudText>
        </div>
    </div>

    <!-- Active Filters Row (Rendered ONLY when filters exist) -->
    @if (HasActiveFilters)
    {
        <div class="d-flex flex-wrap align-center gap-2 px-4 py-2 bg-light border-bottom" style="border-bottom: 1px solid var(--mud-palette-lines-default);" role="region" aria-label="Active Filters">
            <span style="font-size: 0.75rem; font-weight: 600; color: var(--mud-palette-text-secondary);">Active filters:</span>
            @if (!string.IsNullOrWhiteSpace(_searchString))
            {
                <MudChip T="string" Size="Size.Small" OnClose="@(() => { _searchString = string.Empty; HandleFilterChanged(); })">
                    Search: @_searchString
                </MudChip>
            }
            @if (_priorityFilter != "All")
            {
                <MudChip T="string" Size="Size.Small" Color="Color.Warning" OnClose="@(() => { _priorityFilter = "All"; HandleFilterChanged(); })">
                    Priority: @_priorityFilter
                </MudChip>
            }
            <MudButton Variant="Variant.Text" Color="Color.Error" Size="Size.Small" OnClick="ClearFilters" StartIcon="@Icons.Material.Filled.ClearAll">
                Clear all
            </MudButton>
        </div>
    }

    <!-- Bulk Action Bar when items selected -->
    @if (_selectedTasks.Any())
    {
        <div class="pa-2 px-4 d-flex justify-space-between align-center" style="background-color: var(--mud-palette-dark); color: var(--mud-palette-white, #ffffff);" role="region" aria-label="Bulk Selection Actions">
            <div class="d-flex align-center gap-2">
                <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Primary" Size="Size.Small" />
                <span class="font-weight-bold" style="font-size: 0.85rem;">@_selectedTasks.Count task(s) selected</span>
                <MudButton Variant="Variant.Text" Color="Color.Inherit" Size="Size.Small" OnClick="@(() => _selectedTasks.Clear())">
                    Clear selection
                </MudButton>
            </div>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" StartIcon="@Icons.Material.Filled.AssignmentTurnedIn" OnClick="ClaimSelectedTasksAsync">
                Claim Selected
            </MudButton>
        </div>
    }

    <!-- Table Workspace or Structured Empty State -->
    @if (_loading)
    {
        <div class="pa-8">
            <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="mb-3" />
            <div class="d-flex flex-column gap-2">
                <MudSkeleton Height="36px" />
                <MudSkeleton Height="36px" />
                <MudSkeleton Height="36px" />
            </div>
        </div>
    }
    else if (!FilteredTasks.Any())
    {
        @if (HasActiveFilters)
        {
            <div class="nsdms-empty-state">
                <div class="nsdms-empty-icon-wrap">
                    <MudIcon Icon="@Icons.Material.Outlined.FilterListOff" Color="Color.Secondary" Size="Size.Medium" />
                </div>
                <MudText Typo="Typo.subtitle1" Class="font-weight-bold mb-1">No matching tasks</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-3">
                    Try changing your search or removing some filters.
                </MudText>
                <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small" StartIcon="@Icons.Material.Filled.ClearAll" OnClick="ClearFilters">
                    Clear filters
                </MudButton>
            </div>
        }
        else if (_activeTabIndex == 0)
        {
            <div class="nsdms-empty-state">
                <div class="nsdms-empty-icon-wrap">
                    <MudIcon Icon="@Icons.Material.Outlined.CheckCircleOutline" Color="Color.Secondary" Size="Size.Medium" />
                </div>
                <MudText Typo="Typo.subtitle1" Class="font-weight-bold mb-1">No active tasks</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-3">
                    You're all caught up. Tasks assigned to you will appear here.
                </MudText>
                <MudButton Variant="Variant.Outlined" Color="Color.Default" Size="Size.Small" StartIcon="@Icons.Material.Filled.Refresh" OnClick="LoadTasksAsync">
                    Refresh
                </MudButton>
            </div>
        }
        else if (_activeTabIndex == 1)
        {
            <div class="nsdms-empty-state">
                <div class="nsdms-empty-icon-wrap">
                    <MudIcon Icon="@Icons.Material.Outlined.Inbox" Color="Color.Secondary" Size="Size.Medium" />
                </div>
                <MudText Typo="Typo.subtitle1" Class="font-weight-bold mb-1">No unassigned tasks</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-3">
                    There are currently no tasks waiting to be claimed.
                </MudText>
                <MudButton Variant="Variant.Outlined" Color="Color.Default" Size="Size.Small" StartIcon="@Icons.Material.Filled.Refresh" OnClick="LoadTasksAsync">
                    Refresh
                </MudButton>
            </div>
        }
        else
        {
            <div class="nsdms-empty-state">
                <div class="nsdms-empty-icon-wrap">
                    <MudIcon Icon="@Icons.Material.Outlined.History" Color="Color.Secondary" Size="Size.Medium" />
                </div>
                <MudText Typo="Typo.subtitle1" Class="font-weight-bold mb-1">No completed tasks</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">
                    Completed workflow tasks will appear here.
                </MudText>
            </div>
        }
    }
    else
    {
        <MudTable T="WorkflowTask"
                  Items="@FilteredTasks"
                  Hover="true"
                  Dense="true"
                  Elevation="0"
                  MultiSelection="true"
                  @bind-SelectedItems="_selectedTasks"
                  Breakpoint="Breakpoint.Sm">
            <HeaderContent>
                <MudTh>Task ID</MudTh>
                <MudTh>Task Title &amp; Entity</MudTh>
                <MudTh>Assigned Role</MudTh>
                <MudTh>Priority</MudTh>
                <MudTh>SLA Due Status</MudTh>
                <MudTh>Task Status</MudTh>
                <MudTh Style="text-align: right;">Action</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Task ID">
                    <a href="@GetTaskNavigationUrl(context)" class="d-flex align-center gap-1 font-monospace fw-bold text-primary text-decoration-none">
                        <MudIcon Icon="@Icons.Material.Filled.Task" Size="Size.Small" />
                        <span>TSK-@context.Id</span>
                    </a>
                </MudTd>
                <MudTd DataLabel="Task Title">
                    <MudText Typo="Typo.body2" Class="fw-bold">@context.TaskTitle</MudText>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">
                        @(string.IsNullOrWhiteSpace(context.TaskDescription) ? "Standard Review Gate" : context.TaskDescription)
                    </MudText>
                </MudTd>
                <MudTd DataLabel="Assigned Role">
                    <MudChip T="string" Size="Size.Small" Color="Color.Dark" Variant="Variant.Text">
                        @(context.AssignedGroupRole ?? "Any Reviewer")
                    </MudChip>
                </MudTd>
                <MudTd DataLabel="Priority">
                    @if (context.Priority == "High")
                    {
                        <MudChip T="string" Size="Size.Small" Color="Color.Error" Variant="Variant.Filled" Icon="@Icons.Material.Filled.PriorityHigh">
                            High Priority
                        </MudChip>
                    }
                    else if (context.Priority == "Normal")
                    {
                        <MudChip T="string" Size="Size.Small" Color="Color.Info" Variant="Variant.Outlined">
                            Normal
                        </MudChip>
                    }
                    else
                    {
                        <MudChip T="string" Size="Size.Small" Color="Color.Default" Variant="Variant.Text">
                            Low
                        </MudChip>
                    }
                </MudTd>
                <MudTd DataLabel="SLA Status">
                    @{
                        var isOverdue = context.DueDate < DateTime.UtcNow && context.TaskStatus != "Completed";
                        var isDueSoon = !isOverdue && (context.DueDate - DateTime.UtcNow).TotalHours <= 24;
                    }
                    <div class="d-flex align-center gap-1">
                        @if (isOverdue)
                        {
                            <MudChip T="string" Size="Size.Small" Color="Color.Error" Variant="Variant.Filled" Icon="@Icons.Material.Filled.Warning">
                                Overdue (@context.DueDate.ToString("MMM dd"))
                            </MudChip>
                        }
                        else if (isDueSoon)
                        {
                            <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Filled" Icon="@Icons.Material.Filled.AccessTime">
                                Due Soon
                            </MudChip>
                        }
                        else
                        {
                            <MudText Typo="Typo.caption" Color="Color.Secondary">@context.DueDate.ToString("yyyy-MM-dd HH:mm")</MudText>
                        }
                    </div>
                </MudTd>
                <MudTd DataLabel="Status">
                    <StatusBadge Status="@context.TaskStatus" Size="Size.Small" />
                </MudTd>
                <MudTd Style="text-align: right;" DataLabel="Action">
                    <div class="d-flex justify-end gap-1">
                        @if (context.TaskStatus == "Open" || string.IsNullOrWhiteSpace(context.AssignedUserId))
                        {
                            <MudButton Variant="Variant.Filled" 
                                       Color="Color.Primary" 
                                       Size="Size.Small" 
                                       StartIcon="@Icons.Material.Filled.Lock" 
                                       OnClick="@(() => ClaimTaskAsync(context))">
                                Claim
                            </MudButton>
                        }
                        else
                        {
                            <MudButton Variant="Variant.Filled" 
                                       Color="Color.Success" 
                                       Size="Size.Small" 
                                       StartIcon="@Icons.Material.Filled.ArrowForward" 
                                       OnClick="@(() => NavigateToTask(context))">
                                Open
                            </MudButton>
                        }
                    </div>
                </MudTd>
            </RowTemplate>
            <PagerContent>
                <div class="d-flex flex-wrap justify-space-between align-center pa-3 border-top" style="border-top: 1px solid var(--mud-palette-lines-default);">
                    <MudText Typo="Typo.caption" Color="Color.Secondary">
                        Total Tasks: <strong class="font-monospace">@FilteredTasks.Count</strong>
                    </MudText>
                    <MudTablePager PageSizeOptions="new int[] { 10, 20, 50, 100 }" />
                </div>
            </PagerContent>
        </MudTable>
    }
</div>

@code {
    private List<WorkflowTask> _tasks = new();
    private HashSet<WorkflowTask> _selectedTasks = new();
    private bool _loading = true;
    private string _searchString = string.Empty;
    private string _priorityFilter = "All";
    private int _activeTabIndex = 0;
    private int _myTasksCount = 0;
    private int _unassignedCount = 0;
    private string _currentUsername = "admin@merseta.org.za";
    private string _currentFullName = "Admin Officer";

    private List<BreadcrumbItem> _breadcrumbItems = new()
    {
        new BreadcrumbItem("Home", href: "/"),
        new BreadcrumbItem("Workflow Orchestration", href: null, disabled: true),
        new BreadcrumbItem("Tasks", href: "/tasks")
    };

    protected override async Task OnInitializedAsync()
    {
        NotificationService.TaskAssignedReceived += OnTaskAssignedEvent;
        await LoadTasksAsync();
    }

    private async Task LoadTasksAsync()
    {
        _loading = true;
        try
        {
            _tasks = await WorkflowService.GetUserTasksAsync("SuperAdmin", _currentUsername);
            CalculateQueueCounts();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error loading tasks: {ex.Message}", Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private void CalculateQueueCounts()
    {
        _myTasksCount = _tasks.Count(t => t.AssignedUserId == _currentUsername && t.TaskStatus != "Completed");
        _unassignedCount = _tasks.Count(t => string.IsNullOrWhiteSpace(t.AssignedUserId) && t.TaskStatus != "Completed");
    }

    private List<WorkflowTask> FilteredTasks
    {
        get
        {
            var query = _tasks.AsEnumerable();

            // Tab Queue filtering (Clause 4.3 A2)
            if (_activeTabIndex == 0) // My Tasks
            {
                query = query.Where(t => t.AssignedUserId == _currentUsername && t.TaskStatus != "Completed");
            }
            else if (_activeTabIndex == 1) // Unassigned Pool
            {
                query = query.Where(t => string.IsNullOrWhiteSpace(t.AssignedUserId) && t.TaskStatus != "Completed");
            }
            else // Completed Archive
            {
                query = query.Where(t => t.TaskStatus == "Completed");
            }

            if (_priorityFilter != "All")
            {
                query = query.Where(t => t.Priority.Equals(_priorityFilter, StringComparison.OrdinalIgnoreCase));
            }

            if (!string.IsNullOrWhiteSpace(_searchString))
            {
                var s = _searchString.Trim();
                query = query.Where(t =>
                    (t.TaskTitle != null && t.TaskTitle.Contains(s, StringComparison.OrdinalIgnoreCase)) ||
                    (t.TaskDescription != null && t.TaskDescription.Contains(s, StringComparison.OrdinalIgnoreCase)) ||
                    (t.AssignedGroupRole != null && t.AssignedGroupRole.Contains(s, StringComparison.OrdinalIgnoreCase)));
            }

            return query.ToList();
        }
    }

    private bool HasActiveFilters => !string.IsNullOrWhiteSpace(_searchString) || _priorityFilter != "All";

    private void SwitchTab(int index)
    {
        _activeTabIndex = index;
        _selectedTasks.Clear();
        StateHasChanged();
    }

    private void OnPriorityFilterChanged(string val)
    {
        _priorityFilter = val;
        HandleFilterChanged();
    }

    private void HandleTabChanged()
    {
        StateHasChanged();
    }

    private void HandleFilterChanged()
    {
        StateHasChanged();
    }

    private void ClearFilters()
    {
        _searchString = string.Empty;
        _priorityFilter = "All";
        StateHasChanged();
    }

    private void OnSelectedTasksChanged(HashSet<WorkflowTask> selected)
    {
        _selectedTasks = selected;
    }

    private async Task ClaimTaskAsync(WorkflowTask task)
    {
        try
        {
            var claimed = await WorkflowService.ClaimTaskAsync(task.Id, _currentUsername, _currentFullName);
            if (claimed != null)
            {
                Snackbar.Add($"Task #{task.Id} claimed successfully.", Severity.Success);
                await LoadTasksAsync();
            }
            else
            {
                Snackbar.Add("Unable to claim task — it may have been claimed by another officer.", Severity.Warning);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
    }

    private async Task ClaimSelectedTasksAsync()
    {
        int count = 0;
        foreach (var task in _selectedTasks)
        {
            if (string.IsNullOrWhiteSpace(task.AssignedUserId))
            {
                var ok = await WorkflowService.ClaimTaskAsync(task.Id, _currentUsername, _currentFullName);
                if (ok != null) count++;
            }
        }
        Snackbar.Add($"Claimed {count} tasks into your active queue.", Severity.Success);
        await LoadTasksAsync();
    }

    private string GetTaskNavigationUrl(WorkflowTask task)
    {
        if (!string.IsNullOrWhiteSpace(task.TargetRoute))
            return task.TargetRoute;
        return "/tasks";
    }

    private void NavigateToTask(WorkflowTask task)
    {
        Navigation.NavigateTo(GetTaskNavigationUrl(task));
    }

    private void OnTaskAssignedEvent(string taskId, string taskTitle, string role, string priority)
    {
        InvokeAsync(async () =>
        {
            await LoadTasksAsync();
            StateHasChanged();
        });
    }

    public void Dispose()
    {
        NotificationService.TaskAssignedReceived -= OnTaskAssignedEvent;
    }
}
