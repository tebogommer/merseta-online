@page "/dg-funding-windows/{id:int}"
@page "/dg-funding-windows/{id:int}/edit"
@page "/dg-funding-windows/create"
@page "/grants/windows/{id:int}"
@page "/grants/windows/{id:int}/edit"
@page "/grants/windows/create"
@using Nsdms.Application.Services
@using Nsdms.Domain.Entities
@using Nsdms.Domain.Lookups
@using Nsdms.Web.Components.Shared
@using MudBlazor
@inject IGrantService GrantService
@inject ILookupService LookupService
@inject NavigationManager NavManager
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@rendermode InteractiveServer

<PageTitle>@(Id == 0 ? "Open New DG Funding Window" : _window.WindowName) - merSETA NSDMS</PageTitle>

<!-- Sticky Top Bar with Breadcrumbs and Action Buttons -->
<MudPaper Elevation="2" Class="sticky-top pa-4 mb-4 rounded-lg d-flex flex-wrap justify-space-between align-center gap-3 bg-surface" Style="top: var(--mud-appbar-height, 64px); z-index: 10;">
    <div class="d-flex align-center gap-3">
        <MudButton Variant="Variant.Text"
                   StartIcon="@Icons.Material.Filled.ArrowBack"
                   Color="Color.Default"
                   OnClick="BackToList"
                   aria-label="Back to Discretionary Grant Funding Windows">
            Back to DG Windows
        </MudButton>
        <MudDivider Vertical="true" FlexItem="true" Class="mx-1 my-2" />
        <MudAvatar Color="Color.Primary" Variant="Variant.Filled" Size="Size.Small">
            <MudIcon Icon="@Icons.Material.Filled.EventNote" Size="Size.Small" />
        </MudAvatar>
        <div>
            <div class="d-flex align-center gap-2">
                <MudText Typo="Typo.h5" Class="fw-bold">
                    @(Id == 0 ? "Open New DG Funding Window" : _window.WindowName)
                </MudText>
                @if (Id > 0)
                {
                    <MudChip T="string" Color="@GetStatusColor()" Size="Size.Small" Variant="Variant.Filled">
                        @_window.StatusDisplay
                    </MudChip>
                    <MudChip T="string" Color="@(_window.IsPivotal ? Color.Primary : Color.Secondary)" Size="Size.Small" Variant="Variant.Outlined">
                        @(_window.IsPivotal ? "PIVOTAL" : "Non-PIVOTAL")
                    </MudChip>
                    <MudChip T="string" Color="@(_window.RequireWspCompliance ? Color.Warning : Color.Success)" Size="Size.Small" Variant="Variant.Text">
                        @(_window.RequireWspCompliance ? "WSP Enforced" : "WSP Optional")
                    </MudChip>
                }
            </div>
            @if (Id > 0)
            {
                <MudText Typo="Typo.caption" Color="Color.Secondary">
                    Scheme Year: <strong>@_window.FinYear</strong> | 
                    Type: <strong>@(!string.IsNullOrWhiteSpace(_window.GrantTypeCode) ? _window.GrantTypeCode : "PIVOTAL")</strong> | 
                    Budget: <strong>@_window.TotalAvailableBudget.ToString("C")</strong> | 
                    Eligible Stakeholders: <strong>@_selectedStakeholderCodes.Count</strong> |
                    Allowed Interventions: <strong>@_selectedInterventionCodes.Count</strong> |
                    Applications: <strong>@(_window.Applications?.Count ?? 0)</strong>
                </MudText>
            }
        </div>
    </div>
    <div class="d-flex align-center gap-2">
        @if (Id > 0 && _window.ApprovalStatusCode == "Draft")
        {
            <MudButton Variant="Variant.Filled"
                       Color="Color.Info"
                       StartIcon="@Icons.Material.Filled.Send"
                       OnClick="ProposeWindow"
                       aria-label="Propose Window for Approval">
                Propose for Approval
            </MudButton>
        }
        @if (Id > 0 && _window.ApprovalStatusCode == "PendingApproval")
        {
            <MudButton Variant="Variant.Filled"
                       Color="Color.Success"
                       StartIcon="@Icons.Material.Filled.VerifiedUser"
                       OnClick="ApproveWindow"
                       aria-label="Approve & Activate Window">
                Approve &amp; Activate
            </MudButton>
            <MudButton Variant="Variant.Outlined"
                       Color="Color.Error"
                       StartIcon="@Icons.Material.Filled.ThumbDown"
                       OnClick="RejectWindow"
                       aria-label="Reject Window Proposal">
                Reject
            </MudButton>
        }
        @if (Id > 0 && _window.IsActive && _window.ClosingDate >= DateTime.UtcNow)
        {
            <MudButton Variant="Variant.Outlined"
                       Color="Color.Warning"
                       StartIcon="@Icons.Material.Filled.Lock"
                       OnClick="CloseWindowEarly"
                       aria-label="Close Window Early">
                Close Window Early
            </MudButton>
        }
        @if (Id > 0 && (_window.Applications == null || !_window.Applications.Any()))
        {
            <MudButton Variant="Variant.Outlined"
                       Color="Color.Error"
                       StartIcon="@Icons.Material.Filled.Delete"
                       OnClick="DeleteWindow"
                       aria-label="Delete Window">
                Delete
            </MudButton>
        }
        <MudButton Variant="Variant.Outlined"
                   Color="Color.Secondary"
                   StartIcon="@Icons.Material.Filled.Cancel"
                   OnClick="BackToList"
                   aria-label="Cancel">
            Cancel
        </MudButton>
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Save"
                   OnClick="SaveWindow"
                   Disabled="_isSaving"
                   aria-label="Save Window">
            @(_isSaving ? "Saving..." : (Id == 0 ? "Gazette & Open Window" : "Save Changes"))
        </MudButton>
    </div>
</MudPaper>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="pa-0">
    @if (_loading)
    {
        <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="my-6" />
    }
    else
    {
        <!-- Specification Template Selection Banner (Option B) -->
        @if (Id == 0 || _showTemplatePicker)
        {
            <MudCard Outlined="true" Class="pa-4 mb-4 border-primary" Style="border: 2px dashed var(--mud-palette-primary); background-color: var(--mud-palette-background-grey);">
                <div class="d-flex justify-space-between align-center mb-2">
                    <div class="d-flex align-center gap-2">
                        <MudIcon Icon="@Icons.Material.Filled.AutoFixHigh" Color="Color.Primary" />
                        <MudText Typo="Typo.subtitle1" Class="fw-bold">
                            Template Specification Engine (1-Click Window Pre-Configuration)
                        </MudText>
                    </div>
                    @if (Id > 0)
                    {
                        <MudButton Variant="Variant.Text" Size="Size.Small" OnClick="@(() => _showTemplatePicker = false)">Dismiss</MudButton>
                    }
                </div>
                <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-3">
                    Select a standardized template specification to instantly populate funding window parameters, eligible stakeholder groups, and permitted skills development interventions:
                </MudText>
                <MudGrid Spacing="2">
                    @foreach (var tmpl in _templates)
                    {
                        <MudItem xs="12" md="4">
                            <MudCard Outlined="true" Class="@($"pa-3 h-100 cursor-pointer {(_selectedTemplateId == tmpl.Id ? "border-primary bg-primary-lighten" : "")}")"
                                     Style="@(_selectedTemplateId == tmpl.Id ? "border: 2px solid var(--mud-palette-primary);" : "")"
                                     @onclick="@(() => ApplyTemplate(tmpl))">
                                <div class="d-flex justify-space-between align-start mb-1">
                                    <MudChip T="string" Size="Size.Small" Color="@(tmpl.IsPivotal ? Color.Primary : Color.Secondary)" Variant="Variant.Filled">
                                        @(tmpl.IsPivotal ? "PIVOTAL" : "Non-PIVOTAL")
                                    </MudChip>
                                    <MudChip T="string" Size="Size.Small" Color="@(tmpl.RequireWspComplianceDefault ? Color.Warning : Color.Success)" Variant="Variant.Outlined">
                                        @(tmpl.RequireWspComplianceDefault ? "WSP Required" : "WSP Optional")
                                    </MudChip>
                                </div>
                                <MudText Typo="Typo.subtitle2" Class="fw-bold mt-1">@tmpl.Name</MudText>
                                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="d-block mb-2">
                                    @tmpl.Description
                                </MudText>
                                <div class="d-flex justify-space-between align-center text-secondary small mt-auto pt-2 border-top">
                                    <span>Duration: <strong>@tmpl.EstimatedDurationDays days</strong></span>
                                    <span>Stakeholders: <strong>@tmpl.DefaultEligibilities.Count</strong></span>
                                    <span>Interventions: <strong>@tmpl.DefaultInterventions.Count</strong></span>
                                </div>
                                <div class="text-end mt-2">
                                    <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small" StartIcon="@Icons.Material.Filled.Check">
                                        Apply Template
                                    </MudButton>
                                </div>
                            </MudCard>
                        </MudItem>
                    }
                </MudGrid>
            </MudCard>
        }

        <MudTabs Elevation="2" Rounded="true" ApplyEffectsToContainer="true" Color="Color.Surface" @bind-ActivePanelIndex="_activeTabIndex">
            <!-- TAB 1: Window Configuration -->
            <MudTabPanel Text="Window Configuration" Icon="@Icons.Material.Filled.Settings">
                <MudForm @ref="_form" @bind-IsValid="_isValid" Class="pa-4">
                    <MudGrid Spacing="3">
                        <MudItem xs="12" lg="8">
                            <MudCard Outlined="true" Class="pa-4 mb-4">
                                <div class="d-flex justify-space-between align-center mb-3">
                                    <MudText Typo="Typo.h6" Class="fw-bold">Gazetted Funding Cycle Details</MudText>
                                    @if (Id > 0 && !_showTemplatePicker)
                                    {
                                        <MudButton Variant="Variant.Outlined" 
                                                   Color="Color.Primary" 
                                                   Size="Size.Small" 
                                                   StartIcon="@Icons.Material.Filled.AutoFixHigh" 
                                                   OnClick="@(() => _showTemplatePicker = true)">
                                            Apply Template Specification
                                        </MudButton>
                                    }
                                </div>
                                <MudGrid>
                                    <MudItem xs="12" md="4">
                                        <MudNumericField T="int"
                                                         Label="Financial Scheme Year"
                                                         Required="true"
                                                         RequiredError="Financial year is required"
                                                         @bind-Value="_window.FinYear"
                                                         Variant="Variant.Outlined"
                                                         Min="2020"
                                                         Max="2040" />
                                    </MudItem>
                                    <MudItem xs="12" md="4">
                                        <MudSelect T="string" Label="Grant Funding Programme" Required="true" @bind-Value="_window.GrantTypeCode" Variant="Variant.Outlined">
                                            @foreach (var gt in _grantTypes)
                                            {
                                                <MudSelectItem Value="@gt.Code">@gt.Name (@gt.Code)</MudSelectItem>
                                            }
                                        </MudSelect>
                                    </MudItem>
                                    <MudItem xs="12" md="4">
                                        <MudSelect T="string" Label="Window Classification" Required="true" @bind-Value="_window.WindowClassification" Variant="Variant.Outlined">
                                            <MudSelectItem Value="@("PIVOTAL")">PIVOTAL (Credit / NQF Bound)</MudSelectItem>
                                            <MudSelectItem Value="@("NON_PIVOTAL")">Non-PIVOTAL (Special Projects)</MudSelectItem>
                                            <MudSelectItem Value="@("SPECIAL_PROJECT")">Special Strategic Allocation</MudSelectItem>
                                            <MudSelectItem Value="@("HYBRID")">Hybrid (PIVOTAL &amp; Special)</MudSelectItem>
                                        </MudSelect>
                                    </MudItem>
                                    <MudItem xs="12">
                                        <MudTextField T="string"
                                                       Label="Window Title / Gazette Announcement"
                                                       Required="true"
                                                       RequiredError="Window name is mandatory"
                                                       @bind-Value="_window.WindowName"
                                                       Variant="Variant.Outlined"
                                                       Placeholder="e.g. 2026/27 Discretionary Grant Funding Window 1 (PIVOTAL &amp; Apprenticeships)" />
                                    </MudItem>

                                    <!-- Governance Toggles: PIVOTAL vs Non-PIVOTAL and WSP Compliance Requirement -->
                                    <MudItem xs="12" md="6">
                                        <MudCard Outlined="true" Class="pa-3 bg-surface">
                                            <div class="d-flex align-center justify-space-between">
                                                <div>
                                                    <MudText Typo="Typo.subtitle2" Class="fw-bold">Grant Intervention Type</MudText>
                                                    <MudText Typo="Typo.caption" Color="Color.Secondary">
                                                        @(_window.IsPivotal 
                                                            ? "PIVOTAL: Credit-bearing qualifications, artisan apprenticeships, learnerships." 
                                                            : "Non-PIVOTAL: Non-credit bursaries, career guidance, TVET equipment, research.")
                                                    </MudText>
                                                </div>
                                                <MudSwitch T="bool" 
                                                           @bind-Value="_window.IsPivotal" 
                                                           Color="Color.Primary" 
                                                           Label="@(_window.IsPivotal ? "PIVOTAL" : "Non-PIVOTAL")" />
                                            </div>
                                        </MudCard>
                                    </MudItem>
                                    <MudItem xs="12" md="6">
                                        <MudCard Outlined="true" Class="pa-3 bg-surface">
                                            <div class="d-flex align-center justify-space-between">
                                                <div>
                                                    <MudText Typo="Typo.subtitle2" Class="fw-bold">Mandatory Grant (WSP) Precondition</MudText>
                                                    <MudText Typo="Typo.caption" Color="Color.Secondary">
                                                        @(_window.RequireWspCompliance 
                                                            ? "Enforced: Applicants must have an approved WSP for the scheme year." 
                                                            : "Optional: Independent/early window opening before WSP deadlines.")
                                                    </MudText>
                                                </div>
                                                <MudSwitch T="bool" 
                                                           @bind-Value="_window.RequireWspCompliance" 
                                                           Color="Color.Warning" 
                                                           Label="@(_window.RequireWspCompliance ? "Enforced" : "Optional")" />
                                            </div>
                                        </MudCard>
                                    </MudItem>

                                    <MudItem xs="12" md="6">
                                        <MudDatePicker Label="Opening Date"
                                                       Required="true"
                                                       @bind-Date="_openDate"
                                                       Variant="Variant.Outlined"
                                                       DateFormat="yyyy-MM-dd" />
                                    </MudItem>
                                    <MudItem xs="12" md="6">
                                        <MudDatePicker Label="Hard Closing Deadline"
                                                       Required="true"
                                                       @bind-Date="_closeDate"
                                                       Variant="Variant.Outlined"
                                                       DateFormat="yyyy-MM-dd" />
                                    </MudItem>
                                    <MudItem xs="12" md="6">
                                        <MudNumericField T="decimal"
                                                         Label="Total Discretionary Budget Allocation (ZAR)"
                                                         Required="true"
                                                         @bind-Value="_window.TotalAvailableBudget"
                                                         Variant="Variant.Outlined"
                                                         Format="N2"
                                                         Min="0" />
                                    </MudItem>
                                    <MudItem xs="12" md="6">
                                        <div class="pt-2">
                                            <MudSwitch T="bool" @bind-Value="_window.IsActive" Color="Color.Success" Label="Window Operational Status (Active &amp; Open)" />
                                        </div>
                                    </MudItem>
                                    <MudItem xs="12">
                                        <MudTextField T="string"
                                                       Label="Gazette Notice Reference / Policy Guidelines"
                                                       Lines="3"
                                                       @bind-Value="_window.Description"
                                                       Variant="Variant.Outlined"
                                                       Placeholder="Enter official Government Gazette notice numbers, priority focus sectors, or specific policy criteria for this window..." />
                                    </MudItem>
                                </MudGrid>
                            </MudCard>
                        </MudItem>

                        <!-- Right Column: Summary & Governance -->
                        <MudItem xs="12" lg="4">
                            <MudCard Outlined="true" Class="pa-4 mb-4">
                                <MudText Typo="Typo.h6" Class="fw-bold mb-3">Window Status &amp; Metrics</MudText>
                                <div class="d-flex flex-column gap-3">
                                    <div class="d-flex justify-space-between align-center">
                                        <MudText Typo="Typo.body2">Current State:</MudText>
                                        <MudChip T="string" Size="Size.Small" Color="@GetStatusColor()" Variant="Variant.Filled">
                                            @_window.StatusDisplay
                                        </MudChip>
                                    </div>
                                    <div class="d-flex justify-space-between">
                                        <MudText Typo="Typo.body2">Available Budget:</MudText>
                                        <MudText Typo="Typo.body2" Class="fw-bold text-success">@_window.TotalAvailableBudget.ToString("C")</MudText>
                                    </div>
                                    <div class="d-flex justify-space-between">
                                        <MudText Typo="Typo.body2">Eligible Stakeholder Tags:</MudText>
                                        <MudText Typo="Typo.body2" Class="fw-bold text-primary">@_selectedStakeholderCodes.Count selected</MudText>
                                    </div>
                                    <div class="d-flex justify-space-between">
                                        <MudText Typo="Typo.body2">Allowed Interventions:</MudText>
                                        <MudText Typo="Typo.body2" Class="fw-bold text-primary">@_selectedInterventionCodes.Count selected</MudText>
                                    </div>
                                    <div class="d-flex justify-space-between">
                                        <MudText Typo="Typo.body2">Applications Lodged:</MudText>
                                        <MudText Typo="Typo.body2" Class="fw-bold">@(_window.Applications?.Count ?? 0)</MudText>
                                    </div>
                                    <MudDivider />
                                    <div class="d-flex justify-space-between">
                                        <MudText Typo="Typo.caption">Created At:</MudText>
                                        <MudText Typo="Typo.caption">@(_window.CreatedAt > DateTime.MinValue ? _window.CreatedAt.ToString("yyyy-MM-dd HH:mm") : "-")</MudText>
                                    </div>
                                    <div class="d-flex justify-space-between">
                                        <MudText Typo="Typo.caption">Created By:</MudText>
                                        <MudText Typo="Typo.caption">@(!string.IsNullOrWhiteSpace(_window.CreatedBy) ? _window.CreatedBy : "-")</MudText>
                                    </div>
                                    <div class="d-flex justify-space-between">
                                        <MudText Typo="Typo.caption">Modified At:</MudText>
                                        <MudText Typo="Typo.caption">@(_window.ModifiedAt.HasValue ? _window.ModifiedAt.Value.ToString("yyyy-MM-dd HH:mm") : "-")</MudText>
                                    </div>
                                </div>
                            </MudCard>
                        </MudItem>
                    </MudGrid>
                </MudForm>
            </MudTabPanel>

            <!-- TAB 2: Eligible Stakeholder Types -->
            <MudTabPanel Text="Eligible Stakeholders" Icon="@Icons.Material.Filled.GroupWork" BadgeData="@_selectedStakeholderCodes.Count" BadgeColor="Color.Primary">
                <div class="pa-4">
                    <div class="d-flex justify-space-between align-center mb-3">
                        <div>
                            <MudText Typo="Typo.h6" Class="fw-bold">Eligible Stakeholder Classifications</MudText>
                            <MudText Typo="Typo.body2" Color="Color.Secondary">
                                Configure which organizational entities and institutional classifications are permitted to submit grant applications against this window.
                            </MudText>
                        </div>
                        <div class="d-flex gap-2">
                            <MudButton Variant="Variant.Outlined" Size="Size.Small" OnClick="SelectAllStakeholders">Select All</MudButton>
                            <MudButton Variant="Variant.Outlined" Size="Size.Small" OnClick="SelectEmployersOnly">Employers Only</MudButton>
                            <MudButton Variant="Variant.Outlined" Size="Size.Small" OnClick="SelectProvidersOnly">TVETs &amp; Providers</MudButton>
                            <MudButton Variant="Variant.Outlined" Size="Size.Small" Color="Color.Secondary" OnClick="ClearAllStakeholders">Clear All</MudButton>
                        </div>
                    </div>

                    <MudGrid Spacing="2">
                        @foreach (var st in _stakeholderTypes)
                        {
                            var isChecked = _selectedStakeholderCodes.Contains(st.Code);
                            <MudItem xs="12" md="6">
                                <MudCard Outlined="true" Class="@($"pa-3 cursor-pointer {(isChecked ? "border-primary" : "")}")"
                                         Style="@(isChecked ? "border: 2px solid var(--mud-palette-primary);" : "")"
                                         @onclick="@(() => ToggleStakeholder(st.Code))">
                                    <div class="d-flex align-center justify-space-between">
                                        <div class="d-flex align-center gap-3">
                                            <MudCheckBox T="bool" Value="@isChecked" ValueChanged="@((bool val) => SetStakeholder(st.Code, val))" Color="Color.Primary" />
                                            <div>
                                                <div class="d-flex align-center gap-2">
                                                    <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Outlined" Class="font-monospace">
                                                        @st.Code
                                                    </MudChip>
                                                    <MudText Typo="Typo.subtitle2" Class="fw-bold">@st.Name</MudText>
                                                </div>
                                                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="d-block mt-1">
                                                    @st.Description
                                                </MudText>
                                            </div>
                                        </div>
                                    </div>
                                </MudCard>
                            </MudItem>
                        }
                    </MudGrid>
                </div>
            </MudTabPanel>

            <!-- TAB 3: Allowed Interventions & Dynamic Catalog -->
            <MudTabPanel Text="Allowed Interventions" Icon="@Icons.Material.Filled.ChecklistRtl" BadgeData="@_selectedInterventionCodes.Count" BadgeColor="Color.Secondary">
                <div class="pa-4">
                    <div class="d-flex flex-wrap justify-space-between align-center gap-2 mb-3">
                        <div>
                            <MudText Typo="Typo.h6" Class="fw-bold">Skills Development &amp; Strategic Interventions</MudText>
                            <MudText Typo="Typo.body2" Color="Color.Secondary">
                                Whitelist which learning programmes, apprenticeships, bursaries, or special strategic projects applicants may request funding for.
                            </MudText>
                        </div>
                        <div class="d-flex flex-wrap align-center gap-2">
                            <MudButtonGroup Variant="Variant.Outlined" Size="Size.Small">
                                <MudButton Color="@(_interventionFilter == "All" ? Color.Primary : Color.Default)" OnClick="@(() => _interventionFilter = "All")">All (@_interventionCatalog.Count)</MudButton>
                                <MudButton Color="@(_interventionFilter == "Pivotal" ? Color.Primary : Color.Default)" OnClick="@(() => _interventionFilter = "Pivotal")">PIVOTAL (@_interventionCatalog.Count(i => i.IsPivotal))</MudButton>
                                <MudButton Color="@(_interventionFilter == "NonPivotal" ? Color.Primary : Color.Default)" OnClick="@(() => _interventionFilter = "NonPivotal")">Non-PIVOTAL (@_interventionCatalog.Count(i => !i.IsPivotal))</MudButton>
                            </MudButtonGroup>
                            <MudButton Variant="Variant.Filled"
                                       Color="Color.Primary"
                                       Size="Size.Small"
                                       StartIcon="@Icons.Material.Filled.LibraryAdd"
                                       OnClick="OpenAddInterventionDialog">
                                Add New Intervention to Catalog
                            </MudButton>
                        </div>
                    </div>

                    <div class="d-flex justify-space-between align-center mb-3">
                        <div class="d-flex gap-2">
                            <MudButton Variant="Variant.Text" Size="Size.Small" OnClick="SelectAllInterventions">Select All Visible</MudButton>
                            <MudButton Variant="Variant.Text" Size="Size.Small" Color="Color.Secondary" OnClick="ClearAllInterventions">Clear Visible</MudButton>
                        </div>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">
                            Showing @FilteredInterventions.Count interventions (@_selectedInterventionCodes.Count selected for window)
                        </MudText>
                    </div>

                    <MudTable Items="@FilteredInterventions" Hover="true" Dense="true" Elevation="0">
                        <HeaderContent>
                            <MudTh Style="width: 50px;">Allow</MudTh>
                            <MudTh>Code</MudTh>
                            <MudTh>Intervention Name</MudTh>
                            <MudTh>Classification</MudTh>
                            <MudTh>Category</MudTh>
                            <MudTh>Benchmark Unit Cost</MudTh>
                            <MudTh>Regulatory Scope</MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            @{
                                var isAllowed = _selectedInterventionCodes.Contains(context.Code);
                            }
                            <MudTd>
                                <MudCheckBox T="bool" Value="@isAllowed" ValueChanged="@((bool val) => SetIntervention(context.Code, val))" Color="Color.Primary" />
                            </MudTd>
                            <MudTd>
                                <MudChip T="string" Size="Size.Small" Color="Color.Default" Variant="Variant.Outlined" Class="font-monospace">
                                    @context.Code
                                </MudChip>
                            </MudTd>
                            <MudTd>
                                <div class="fw-bold">@context.Name</div>
                            </MudTd>
                            <MudTd>
                                <MudChip T="string" Size="Size.Small" Color="@(context.IsPivotal ? Color.Primary : Color.Secondary)" Variant="Variant.Filled">
                                    @(context.IsPivotal ? "PIVOTAL" : "Non-PIVOTAL")
                                </MudChip>
                            </MudTd>
                            <MudTd>
                                <MudChip T="string" Size="Size.Small" Color="Color.Default" Variant="Variant.Text">
                                    @(context.Category ?? "Standard")
                                </MudChip>
                            </MudTd>
                            <MudTd Class="fw-bold text-success">
                                @(context.DefaultUnitCost > 0 ? context.DefaultUnitCost.ToString("C") : "Variable / Project")
                            </MudTd>
                            <MudTd>
                                <MudText Typo="Typo.caption" Color="Color.Secondary">
                                    @(context.Description ?? "-")
                                </MudText>
                            </MudTd>
                        </RowTemplate>
                    </MudTable>
                </div>
            </MudTabPanel>

            <!-- TAB 4: Strategic Themes & Priorities -->
            @if (Id > 0)
            {
                <MudTabPanel Text="Strategic Themes &amp; Priorities" Icon="@Icons.Material.Filled.Stars" BadgeData="@(_window.StrategicPriorities?.Count(p => p.IsActive) ?? 0)" BadgeColor="Color.Secondary">
                    <div class="pa-4">
                        <!-- Envelopes Summary -->
                        <MudGrid Class="mb-4">
                            <MudItem xs="12" md="3">
                                <MudCard Outlined="true" Class="pa-4 text-center">
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">Window Budget</MudText>
                                    <MudText Typo="Typo.h6" Class="fw-bold text-primary">@_window.TotalAvailableBudget.ToString("C")</MudText>
                                </MudCard>
                            </MudItem>
                            <MudItem xs="12" md="3">
                                <MudCard Outlined="true" Class="pa-4 text-center">
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">Allocated to Themes</MudText>
                                    <MudText Typo="Typo.h6" Class="fw-bold text-success">@(_window.StrategicPriorities?.Where(p => p.IsActive).Sum(p => p.AllocatedBudget).ToString("C") ?? "R 0.00")</MudText>
                                </MudCard>
                            </MudItem>
                            <MudItem xs="12" md="3">
                                <MudCard Outlined="true" Class="pa-4 text-center">
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">Unallocated Buffer</MudText>
                                    @{
                                        var allocatedThemesTotal = _window.StrategicPriorities?.Where(p => p.IsActive).Sum(p => p.AllocatedBudget) ?? 0m;
                                        var unallocatedBuffer = Math.Max(0, _window.TotalAvailableBudget - allocatedThemesTotal);
                                    }
                                    <MudText Typo="Typo.h6" Class="fw-bold text-warning">@unallocatedBuffer.ToString("C")</MudText>
                                </MudCard>
                            </MudItem>
                            <MudItem xs="12" md="3">
                                <MudCard Outlined="true" Class="pa-4 text-center">
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">Total Target Beneficiaries</MudText>
                                    <MudText Typo="Typo.h6" Class="fw-bold text-info">@(_window.StrategicPriorities?.Where(p => p.IsActive).Sum(p => p.TargetBeneficiaries) ?? 0) Learners</MudText>
                                </MudCard>
                            </MudItem>
                        </MudGrid>

                        <!-- Add Theme to Window Card -->
                        <MudCard Outlined="true" Class="pa-4 mb-4 bg-light">
                            <MudText Typo="Typo.subtitle1" Class="fw-bold mb-3 d-flex align-center gap-2">
                                <MudIcon Icon="@Icons.Material.Filled.AddCircleOutline" Color="Color.Primary" />
                                Assign Strategic Priority / Theme to this Window
                            </MudText>
                            <MudGrid>
                                <MudItem xs="12" md="5">
                                    <MudSelect T="int" Label="Strategic Theme / Key Focus Area"
                                               Variant="Variant.Outlined"
                                               @bind-Value="_newPriorityId"
                                               ToStringFunc="@(id => FormatStrategicPriority(id))">
                                        <MudSelectItem Value="0">-- Select Strategic Priority --</MudSelectItem>
                                        @foreach (var sp in _allStrategicPriorities.Where(s => !_window.StrategicPriorities.Any(wp => wp.IsActive && wp.StrategicPriorityId == s.Id)))
                                        {
                                            <MudSelectItem Value="@sp.Id">@sp.Code - @sp.Name</MudSelectItem>
                                        }
                                    </MudSelect>
                                </MudItem>
                                <MudItem xs="12" md="3">
                                    <MudNumericField T="decimal"
                                                     Label="Sub-Budget Envelope (ZAR)"
                                                     Variant="Variant.Outlined"
                                                     @bind-Value="_newAllocatedBudget"
                                                     Format="N2"
                                                     Min="0" />
                                </MudItem>
                                <MudItem xs="12" md="2">
                                    <MudNumericField T="int"
                                                     Label="Target Beneficiaries"
                                                     Variant="Variant.Outlined"
                                                     @bind-Value="_newTargetBeneficiaries"
                                                     Min="0" />
                                </MudItem>
                                <MudItem xs="12" md="2">
                                    <MudNumericField T="decimal"
                                                     Label="Min Score (%)"
                                                     Variant="Variant.Outlined"
                                                     @bind-Value="_newMinScore"
                                                     Min="0"
                                                     Max="100" />
                                </MudItem>
                                <MudItem xs="12" md="8">
                                    <div class="d-flex align-center gap-4">
                                        <MudSwitch T="bool" @bind-Value="_newIsRingFenced" Color="Color.Warning" Label="Ring-Fenced Allocation (Requires Board Approval for Virement)" />
                                    </div>
                                </MudItem>
                                <MudItem xs="12" md="4" Class="d-flex justify-end align-center">
                                    <MudButton Variant="Variant.Filled"
                                               Color="Color.Primary"
                                               StartIcon="@Icons.Material.Filled.Add"
                                               OnClick="AddThemeToWindow"
                                               Disabled="_isAddingTheme || _newPriorityId == 0">
                                        @(_isAddingTheme ? "Assigning..." : "Assign Theme")
                                    </MudButton>
                                </MudItem>
                            </MudGrid>
                        </MudCard>

                        <!-- Strategic Priorities Table -->
                        @if (_window.StrategicPriorities != null && _window.StrategicPriorities.Any(p => p.IsActive))
                        {
                            <MudTable Items="@_window.StrategicPriorities.Where(p => p.IsActive)" Hover="true" Dense="true" Elevation="0">
                                <HeaderContent>
                                    <MudTh>Priority Code</MudTh>
                                    <MudTh>Strategic Theme</MudTh>
                                    <MudTh>NSDP III Outcome &amp; SIP Category</MudTh>
                                    <MudTh>Sub-Budget Envelope</MudTh>
                                    <MudTh>Target Learners</MudTh>
                                    <MudTh>Min Passing Score</MudTh>
                                    <MudTh>Ring-Fence</MudTh>
                                    <MudTh Style="text-align:right">Action</MudTh>
                                </HeaderContent>
                                <RowTemplate>
                                    <MudTd>
                                        <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Outlined" Class="font-monospace">
                                            @(context.StrategicPriority?.Code ?? "SP-THEME")
                                        </MudChip>
                                    </MudTd>
                                    <MudTd>
                                        <div class="fw-bold">@(context.StrategicPriority?.Name ?? "Strategic Theme")</div>
                                        <MudText Typo="Typo.caption" Color="Color.Secondary">@(context.StrategicPriority?.TargetSector ?? "All Sectors")</MudText>
                                    </MudTd>
                                    <MudTd>
                                        <div class="small fw-semibold">@(context.StrategicPriority?.NsdpOutcomeCode ?? "NSDP Outcome")</div>
                                        <MudText Typo="Typo.caption" Color="Color.Secondary">@(context.StrategicPriority?.SipCategory ?? "Standard SIP")</MudText>
                                    </MudTd>
                                    <MudTd Class="fw-bold text-success">@context.AllocatedBudget.ToString("C")</MudTd>
                                    <MudTd Class="fw-bold">@context.TargetBeneficiaries</MudTd>
                                    <MudTd>@context.MinScoreThreshold.ToString("F1")%</MudTd>
                                    <MudTd>
                                        @if (context.IsRingFenced)
                                        {
                                            <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Filled">Ring-Fenced</MudChip>
                                        }
                                        else
                                        {
                                            <MudChip T="string" Size="Size.Small" Color="Color.Default" Variant="Variant.Text">Flexible</MudChip>
                                        }
                                    </MudTd>
                                    <MudTd Style="text-align:right">
                                        <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                                       Color="Color.Error"
                                                       Size="Size.Small"
                                                       OnClick="@(() => RemoveThemeFromWindow(context.Id))"
                                                       Title="Remove Theme from Window" />
                                    </MudTd>
                                </RowTemplate>
                            </MudTable>
                        }
                        else
                        {
                            <MudAlert Severity="Severity.Info" Class="pa-4 text-center">
                                No strategic priority themes assigned to this funding window yet. Use the form above to assign priorities.
                            </MudAlert>
                        }
                    </div>
                </MudTabPanel>

                <!-- TAB 5: Applications Lodged -->
                <MudTabPanel Text="Applications Lodged" Icon="@Icons.Material.Filled.Assignment" BadgeData="@(_window.Applications?.Count ?? 0)" BadgeColor="Color.Primary">
                    <div class="pa-4">
                        @if (_window.Applications != null && _window.Applications.Any())
                        {
                            <MudTable Items="@_window.Applications" Hover="true" Dense="true" Elevation="0">
                                <HeaderContent>
                                    <MudTh>Application No</MudTh>
                                    <MudTh>Organisation</MudTh>
                                    <MudTh>Strategic Theme</MudTh>
                                    <MudTh>Project Title</MudTh>
                                    <MudTh>Requested Amount</MudTh>
                                    <MudTh>Approved Amount</MudTh>
                                    <MudTh>Status</MudTh>
                                    <MudTh Style="text-align:right">Action</MudTh>
                                </HeaderContent>
                                <RowTemplate>
                                    <MudTd>
                                        <a href="/dg-grants/@context.Id" class="fw-bold text-primary font-monospace text-decoration-none">
                                            @context.ApplicationNumber
                                        </a>
                                    </MudTd>
                                    <MudTd>@(context.Organisation?.CompanyName ?? "Unlinked Organisation")</MudTd>
                                    <MudTd>
                                        @if (context.StrategicPriority != null)
                                        {
                                            <MudChip T="string" Size="Size.Small" Color="Color.Secondary" Variant="Variant.Filled">
                                                @context.StrategicPriority.Code - @context.StrategicPriority.Name
                                            </MudChip>
                                        }
                                        else
                                        {
                                            <MudText Typo="Typo.caption" Color="Color.Secondary">General Discretionary</MudText>
                                        }
                                    </MudTd>
                                    <MudTd><strong>@context.ProjectTitle</strong></MudTd>
                                    <MudTd Class="fw-bold">@context.RequestedAmount.ToString("C")</MudTd>
                                    <MudTd Class="fw-bold text-success">@((context.ApprovedAmount ?? 0m).ToString("C"))</MudTd>
                                    <MudTd>
                                        <MudChip T="string" Size="Size.Small" Color="Color.Info" Variant="Variant.Filled">@context.StatusCode</MudChip>
                                    </MudTd>
                                    <MudTd Style="text-align:right">
                                        <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small" StartIcon="@Icons.Material.Filled.OpenInNew" Href="@($"/dg-grants/{context.Id}")">
                                            Open DG Application
                                        </MudButton>
                                    </MudTd>
                                </RowTemplate>
                            </MudTable>
                        }
                        else
                        {
                            <MudAlert Severity="Severity.Info" Class="pa-4 text-center">
                                No applications have been submitted against this funding window yet.
                            </MudAlert>
                        }
                    </div>
                </MudTabPanel>

                <!-- TAB 6: Budget & Allocation Metrics -->
                <MudTabPanel Text="Budget Metrics" Icon="@Icons.Material.Filled.PieChart">
                    <div class="pa-4">
                        @if (_summary != null)
                        {
                            <MudGrid>
                                <MudItem xs="12" md="3">
                                    <MudCard Outlined="true" Class="pa-4 text-center border-primary" Style="border: 2px solid var(--mud-palette-primary);">
                                        <MudText Typo="Typo.caption" Color="Color.Secondary">Total Gazetted Budget</MudText>
                                        <MudText Typo="Typo.h5" Class="fw-bold text-primary">@_summary.TotalAvailableBudget.ToString("C")</MudText>
                                    </MudCard>
                                </MudItem>
                                <MudItem xs="12" md="3">
                                    <MudCard Outlined="true" Class="pa-4 text-center border-info" Style="border: 2px solid var(--mud-palette-info);">
                                        <MudText Typo="Typo.caption" Color="Color.Secondary">Total Requested</MudText>
                                        <MudText Typo="Typo.h5" Class="fw-bold text-info">@_summary.TotalRequestedAmount.ToString("C")</MudText>
                                    </MudCard>
                                </MudItem>
                                <MudItem xs="12" md="3">
                                    <MudCard Outlined="true" Class="pa-4 text-center border-success" Style="border: 2px solid var(--mud-palette-success);">
                                        <MudText Typo="Typo.caption" Color="Color.Secondary">Approved Allocation</MudText>
                                        <MudText Typo="Typo.h5" Class="fw-bold text-success">@_summary.TotalApprovedAmount.ToString("C")</MudText>
                                    </MudCard>
                                </MudItem>
                                <MudItem xs="12" md="3">
                                    <MudCard Outlined="true" Class="pa-4 text-center border-warning" Style="border: 2px solid var(--mud-palette-warning);">
                                        <MudText Typo="Typo.caption" Color="Color.Secondary">Remaining Balance</MudText>
                                        <MudText Typo="Typo.h5" Class="fw-bold text-warning">@_summary.RemainingBudget.ToString("C")</MudText>
                                    </MudCard>
                                </MudItem>
                            </MudGrid>

                            <MudCard Outlined="true" Class="pa-6 mt-4">
                                <MudText Typo="Typo.subtitle1" Class="fw-bold mb-2">Budget Utilization</MudText>
                                @{
                                    var percent = _summary.TotalAvailableBudget > 0 
                                        ? Math.Min(100, (int)((_summary.TotalApprovedAmount / _summary.TotalAvailableBudget) * 100)) 
                                        : 0;
                                }
                                <MudProgressLinear Color="Color.Success" Value="@percent" Size="Size.Large" Class="my-3" />
                                <div class="d-flex justify-space-between">
                                    <MudText Typo="Typo.body2">@percent% Allocated</MudText>
                                    <MudText Typo="Typo.body2">@_summary.RemainingBudget.ToString("C") Unallocated</MudText>
                                </div>
                            </MudCard>
                        }
                    </div>
                </MudTabPanel>

                <!-- TAB 7: Evidence Vault -->
                <MudTabPanel Text="Gazette Documents" Icon="@Icons.Material.Filled.FolderZip">
                    <DocumentVault TargetEntityName="GrantFundingWindow" TargetEntityId="@Id" />
                </MudTabPanel>
            }
        </MudTabs>
    }
</MudContainer>

@code {
    [Parameter] public int Id { get; set; }

    private GrantFundingWindow _window = new();
    private FundingWindowSummaryDto? _summary;
    private MudForm? _form;
    private bool _isValid;
    private bool _loading = true;
    private bool _isSaving = false;
    private int _activeTabIndex = 0;

    private List<LookupItemDto> _grantTypes = new();
    private List<StrategicPriority> _allStrategicPriorities = new();
    private List<GrantWindowTemplate> _templates = new();
    private List<StakeholderEligibilityType> _stakeholderTypes = new();
    private List<InterventionType> _interventionCatalog = new();

    private HashSet<string> _selectedStakeholderCodes = new(StringComparer.OrdinalIgnoreCase);
    private HashSet<string> _selectedInterventionCodes = new(StringComparer.OrdinalIgnoreCase);

    private DateTime? _openDate;
    private DateTime? _closeDate;
    private int? _selectedTemplateId;
    private bool _showTemplatePicker = false;
    private string _interventionFilter = "All";

    // Add Theme form state
    private int _newPriorityId = 0;
    private decimal _newAllocatedBudget = 5000000m;
    private int _newTargetBeneficiaries = 50;
    private decimal _newMinScore = 65.00m;
    private bool _newIsRingFenced = false;
    private bool _isAddingTheme = false;

    private List<InterventionType> FilteredInterventions => _interventionFilter switch
    {
        "Pivotal" => _interventionCatalog.Where(i => i.IsPivotal).ToList(),
        "NonPivotal" => _interventionCatalog.Where(i => !i.IsPivotal).ToList(),
        _ => _interventionCatalog
    };

    protected override async Task OnInitializedAsync()
    {
        _loading = true;
        _grantTypes = await LookupService.GetLookupItemsAsync("GrantTypeType");
        _allStrategicPriorities = await GrantService.GetStrategicPrioritiesAsync(activeOnly: true);
        _templates = await GrantService.GetWindowTemplatesAsync(activeOnly: true);
        _stakeholderTypes = await GrantService.GetStakeholderEligibilityTypesAsync(activeOnly: true);
        _interventionCatalog = await GrantService.GetInterventionCatalogAsync(isPivotal: null, activeOnly: true);

        if (Id > 0)
        {
            await LoadWindowData();
        }
        else
        {
            _showTemplatePicker = true;
            _window = new GrantFundingWindow
            {
                FinYear = DateTime.UtcNow.Year,
                WindowName = $"{DateTime.UtcNow.Year}/{DateTime.UtcNow.Year + 1} Discretionary Grant Funding Window",
                GrantTypeCode = "PIVOTAL",
                WindowClassification = "PIVOTAL",
                IsPivotal = true,
                RequireWspCompliance = false,
                OpeningDate = DateTime.UtcNow.Date,
                ClosingDate = DateTime.UtcNow.Date.AddMonths(2),
                TotalAvailableBudget = 25000000m,
                IsActive = true
            };
            _openDate = _window.OpeningDate;
            _closeDate = _window.ClosingDate;

            // Default to first template if available
            if (_templates.Any())
            {
                ApplyTemplate(_templates.First());
            }
            else
            {
                // Select standard employer eligibility by default
                _selectedStakeholderCodes.Add("LEVY_PAYING");
                _selectedStakeholderCodes.Add("SMME_EXEMPT");
                foreach (var it in _interventionCatalog.Where(i => i.IsPivotal))
                {
                    _selectedInterventionCodes.Add(it.Code);
                }
            }
        }

        _loading = false;
    }

    private async Task LoadWindowData()
    {
        var w = await GrantService.GetFundingWindowByIdAsync(Id);
        if (w != null)
        {
            _window = w;
            _openDate = _window.OpeningDate;
            _closeDate = _window.ClosingDate;
            _summary = await GrantService.GetFundingWindowSummaryAsync(Id);

            // Load window stakeholder eligibilities
            var eligibilities = await GrantService.GetWindowEligibilitiesAsync(Id);
            _selectedStakeholderCodes = eligibilities
                .Select(e => e.StakeholderEligibilityTypeCode)
                .ToHashSet(StringComparer.OrdinalIgnoreCase);

            // Load window interventions
            var interventions = await GrantService.GetWindowInterventionsAsync(Id);
            _selectedInterventionCodes = interventions
                .Select(i => i.InterventionTypeCode)
                .ToHashSet(StringComparer.OrdinalIgnoreCase);
        }
        else
        {
            Snackbar.Add("Discretionary Grant Funding Window not found.", Severity.Error);
            NavManager.NavigateTo("/dg-funding-windows");
        }
    }

    private void ApplyTemplate(GrantWindowTemplate tmpl)
    {
        _selectedTemplateId = tmpl.Id;
        _window.TemplateId = tmpl.Id;
        _window.WindowName = $"{_window.FinYear}/{_window.FinYear + 1} {tmpl.Name}";
        _window.GrantTypeCode = tmpl.IsPivotal ? "PIVOTAL" : "PROJECT";
        _window.WindowClassification = tmpl.WindowClassification;
        _window.IsPivotal = tmpl.IsPivotal;
        _window.RequireWspCompliance = tmpl.RequireWspComplianceDefault;
        _window.Description = tmpl.Description;

        _openDate = DateTime.UtcNow.Date;
        _closeDate = DateTime.UtcNow.Date.AddDays(tmpl.EstimatedDurationDays);

        // Pre-populate eligibilities from blueprint
        _selectedStakeholderCodes.Clear();
        foreach (var el in tmpl.DefaultEligibilities)
        {
            _selectedStakeholderCodes.Add(el.StakeholderEligibilityTypeCode);
        }

        // Pre-populate interventions from blueprint
        _selectedInterventionCodes.Clear();
        foreach (var it in tmpl.DefaultInterventions)
        {
            _selectedInterventionCodes.Add(it.InterventionTypeCode);
        }

        Snackbar.Add($"Template specification '{tmpl.Name}' applied successfully. {_selectedStakeholderCodes.Count} stakeholders and {_selectedInterventionCodes.Count} interventions configured.", Severity.Info);
    }

    // Stakeholder Selection Handlers
    private void ToggleStakeholder(string code)
    {
        if (_selectedStakeholderCodes.Contains(code))
            _selectedStakeholderCodes.Remove(code);
        else
            _selectedStakeholderCodes.Add(code);
    }

    private void SetStakeholder(string code, bool isSelected)
    {
        if (isSelected) _selectedStakeholderCodes.Add(code);
        else _selectedStakeholderCodes.Remove(code);
    }

    private void SelectAllStakeholders()
    {
        foreach (var st in _stakeholderTypes) _selectedStakeholderCodes.Add(st.Code);
    }

    private void SelectEmployersOnly()
    {
        _selectedStakeholderCodes.Clear();
        _selectedStakeholderCodes.Add("LEVY_PAYING");
        _selectedStakeholderCodes.Add("SMME_EXEMPT");
        _selectedStakeholderCodes.Add("EMPLOYER_ASSOC");
    }

    private void SelectProvidersOnly()
    {
        _selectedStakeholderCodes.Clear();
        _selectedStakeholderCodes.Add("PUBLIC_TVET");
        _selectedStakeholderCodes.Add("PRIVATE_TVET_SDP");
        _selectedStakeholderCodes.Add("PUBLIC_UNIVERSITY");
        _selectedStakeholderCodes.Add("CET_COLLEGE");
    }

    private void ClearAllStakeholders() => _selectedStakeholderCodes.Clear();

    // Intervention Selection Handlers
    private void SetIntervention(string code, bool isSelected)
    {
        if (isSelected) _selectedInterventionCodes.Add(code);
        else _selectedInterventionCodes.Remove(code);
    }

    private void SelectAllInterventions()
    {
        foreach (var it in FilteredInterventions) _selectedInterventionCodes.Add(it.Code);
    }

    private void ClearAllInterventions()
    {
        foreach (var it in FilteredInterventions) _selectedInterventionCodes.Remove(it.Code);
    }

    private async Task OpenAddInterventionDialog()
    {
        var options = new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Medium, FullWidth = true };
        var dialog = await DialogService.ShowAsync<RegisterInterventionDialog>("Add New Intervention to Catalog", options);
        var result = await dialog.Result;

        if (result != null && !result.Canceled && result.Data is InterventionType newIntervention)
        {
            // Refresh catalog and add to selected list
            _interventionCatalog = await GrantService.GetInterventionCatalogAsync(isPivotal: null, activeOnly: true);
            _selectedInterventionCodes.Add(newIntervention.Code);
            StateHasChanged();
        }
    }

    private string FormatStrategicPriority(int id)
    {
        if (id == 0) return "-- Select Strategic Priority --";
        var sp = _allStrategicPriorities.FirstOrDefault(s => s.Id == id);
        return sp != null ? $"{sp.Code} - {sp.Name} ({sp.NsdpOutcomeCode})" : "Strategic Priority";
    }

    private async Task AddThemeToWindow()
    {
        if (_newPriorityId == 0)
        {
            Snackbar.Add("Please select a Strategic Priority theme.", Severity.Warning);
            return;
        }

        if (_newAllocatedBudget <= 0)
        {
            Snackbar.Add("Sub-budget allocation must be greater than zero.", Severity.Warning);
            return;
        }

        _isAddingTheme = true;
        try
        {
            var item = new FundingWindowPriority
            {
                FundingWindowId = Id,
                StrategicPriorityId = _newPriorityId,
                AllocatedBudget = _newAllocatedBudget,
                TargetBeneficiaries = _newTargetBeneficiaries,
                MinScoreThreshold = _newMinScore,
                IsRingFenced = _newIsRingFenced,
                IsActive = true
            };

            await GrantService.AddWindowPriorityAsync(item, "AdminUser");
            Snackbar.Add("Strategic Priority theme assigned to funding window successfully.", Severity.Success);
            _newPriorityId = 0;
            _newAllocatedBudget = 5000000m;
            _newTargetBeneficiaries = 50;
            await LoadWindowData();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _isAddingTheme = false;
        }
    }

    private async Task RemoveThemeFromWindow(int windowPriorityId)
    {
        bool? confirmed = await DialogService.ShowMessageBoxAsync(
            "Remove Theme Allocation",
            "Are you sure you want to remove this Strategic Theme allocation from the funding window?",
            yesText: "Remove", cancelText: "Cancel");

        if (confirmed == true)
        {
            try
            {
                var success = await GrantService.RemoveWindowPriorityAsync(windowPriorityId, "AdminUser");
                if (success)
                {
                    Snackbar.Add("Strategic Theme removed from window successfully.", Severity.Success);
                    await LoadWindowData();
                }
            }
            catch (Exception ex)
            {
                Snackbar.Add(ex.Message, Severity.Error);
            }
        }
    }

    private async Task SaveWindow()
    {
        if (_form != null)
        {
            await _form.Validate();
            if (!_isValid) return;
        }

        _isSaving = true;
        try
        {
            if (_openDate.HasValue) _window.OpeningDate = _openDate.Value;
            if (_closeDate.HasValue) _window.ClosingDate = _closeDate.Value;

            if (_window.ClosingDate < _window.OpeningDate)
            {
                Snackbar.Add("Closing deadline cannot be earlier than opening date.", Severity.Warning);
                return;
            }

            if (!_selectedStakeholderCodes.Any())
            {
                Snackbar.Add("Please configure at least one eligible stakeholder classification.", Severity.Warning);
                return;
            }

            if (!_selectedInterventionCodes.Any())
            {
                Snackbar.Add("Please configure at least one allowed skills development intervention.", Severity.Warning);
                return;
            }

            GrantFundingWindow savedWindow;
            if (Id == 0)
            {
                savedWindow = await GrantService.CreateFundingWindowAsync(_window, "AdminUser");
            }
            else
            {
                savedWindow = await GrantService.UpdateFundingWindowAsync(_window, "AdminUser");
            }

            // Save relational eligibilities and interventions
            await GrantService.SetWindowEligibilitiesAsync(savedWindow.Id, _selectedStakeholderCodes, "AdminUser");
            await GrantService.SetWindowInterventionsAsync(savedWindow.Id, _selectedInterventionCodes, "AdminUser");

            if (Id == 0)
            {
                Snackbar.Add($"Funding window '{savedWindow.WindowName}' gazetted and opened successfully.", Severity.Success);
                NavManager.NavigateTo($"/dg-funding-windows/{savedWindow.Id}");
            }
            else
            {
                Snackbar.Add($"Funding window '{savedWindow.WindowName}' updated successfully with {_selectedStakeholderCodes.Count} eligible stakeholders and {_selectedInterventionCodes.Count} interventions.", Severity.Success);
                await LoadWindowData();
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error saving funding window: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isSaving = false;
        }
    }

    private async Task ProposeWindow()
    {
        try
        {
            var res = await GrantService.ProposeFundingWindowAsync(Id, "OfficerProposer");
            Snackbar.Add($"Funding Window '{res.WindowName}' proposed for approval. Pending independent executive review.", Severity.Info);
            await LoadWindowData();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private async Task ApproveWindow()
    {
        bool? confirmed = await DialogService.ShowMessageBoxAsync(
            "Dual Authorisation: Approve Funding Window",
            $"Approve and activate '{_window.WindowName}' with budget of {_window.TotalAvailableBudget:C}? This opens the window for external employer applications.",
            yesText: "Approve & Activate", cancelText: "Cancel");

        if (confirmed == true)
        {
            try
            {
                var res = await GrantService.ApproveAndActivateFundingWindowAsync(Id, "ExecutiveApprover", "Approved per MANCO gazette notice");
                Snackbar.Add($"Funding Window '{res.WindowName}' approved and activated successfully.", Severity.Success);
                await LoadWindowData();
            }
            catch (Exception ex)
            {
                Snackbar.Add(ex.Message, Severity.Error);
            }
        }
    }

    private async Task RejectWindow()
    {
        bool? confirmed = await DialogService.ShowMessageBoxAsync(
            "Reject Funding Window Proposal",
            $"Are you sure you want to reject the proposal for '{_window.WindowName}'?",
            yesText: "Reject", cancelText: "Cancel");

        if (confirmed == true)
        {
            try
            {
                var res = await GrantService.RejectFundingWindowAsync(Id, "ExecutiveApprover", "Proposal returned for revision");
                Snackbar.Add("Funding window proposal rejected.", Severity.Warning);
                await LoadWindowData();
            }
            catch (Exception ex)
            {
                Snackbar.Add(ex.Message, Severity.Error);
            }
        }
    }

    private async Task CloseWindowEarly()
    {
        bool? confirmed = await DialogService.ShowMessageBoxAsync(
            "Close Funding Window Early",
            $"Are you sure you want to close '{_window.WindowName}' early? No further applications will be accepted.",
            yesText: "Close Window", cancelText: "Cancel");

        if (confirmed == true)
        {
            var success = await GrantService.CloseFundingWindowAsync(Id, "AdminUser");
            if (success)
            {
                Snackbar.Add("Funding window closed successfully.", Severity.Success);
                await LoadWindowData();
            }
        }
    }

    private async Task DeleteWindow()
    {
        bool? confirmed = await DialogService.ShowMessageBoxAsync(
            "Delete Funding Window",
            $"Are you sure you want to delete '{_window.WindowName}'?",
            yesText: "Delete", cancelText: "Cancel");

        if (confirmed == true)
        {
            try
            {
                var success = await GrantService.DeleteFundingWindowAsync(Id, "AdminUser");
                if (success)
                {
                    Snackbar.Add("Funding window deleted successfully.", Severity.Success);
                    NavManager.NavigateTo("/dg-funding-windows");
                }
            }
            catch (Exception ex)
            {
                Snackbar.Add(ex.Message, Severity.Error);
            }
        }
    }

    private void BackToList() => NavManager.NavigateTo("/dg-funding-windows");

    private Color GetStatusColor() => !_window.IsActive 
        ? Color.Error 
        : (DateTime.UtcNow < _window.OpeningDate 
            ? Color.Warning 
            : (DateTime.UtcNow > _window.ClosingDate ? Color.Dark : Color.Success));
}
