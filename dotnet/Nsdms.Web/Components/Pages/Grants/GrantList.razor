@page "/dg-grants"
@page "/grants"
@using Nsdms.Application.Common.Models
@using Nsdms.Application.Services
@using Nsdms.Domain.Entities
@using Nsdms.Web.Components.Shared
@using MudBlazor
@inject IGrantService GrantService
@inject NavigationManager NavManager
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject IJSRuntime JS
@rendermode InteractiveServer

@*
  UI-STANDARD.md Archetype: A1 / T1 (Transactional List - Discretionary Grants)
  Clauses: 4.2, 4.3, 6.1, 7.2, 8.1, 8.3, 11.1–11.9, 15.2.5
*@

<PageTitle>Discretionary Grants (DG) - merSETA NSDMS</PageTitle>

<EntityHeader Title="Discretionary Grants (DG)"
              Subtitle="Strategic project funding applications, allocation windows, budget approvals, and disbursement management"
              ReferenceKey="T1-DG-GRANTS"
              BreadcrumbItems="@_breadcrumbs">
    <ActionZone>
        <MudButton Variant="Variant.Outlined" 
                    Color="Color.Secondary" 
                    StartIcon="@Icons.Material.Filled.Insights" 
                    OnClick="@(() => NavManager.NavigateTo("/reports/dg-strategic"))"
                    Class="mr-2">
            Strategic BI Hub
        </MudButton>
        <MudButton Variant="Variant.Outlined" 
                   Color="Color.Primary" 
                   StartIcon="@Icons.Material.Filled.EventNote" 
                   OnClick="@(() => NavManager.NavigateTo("/dg-funding-windows"))"
                   Class="mr-2">
            DG Funding Windows
        </MudButton>
        <MudButton Variant="Variant.Filled" 
                   Color="Color.Primary" 
                   StartIcon="@Icons.Material.Filled.AddCard" 
                   OnClick="CreateNewGrant">
            New Discretionary Grant (DG) Application
        </MudButton>
    </ActionZone>
</EntityHeader>

<!-- Filter Bar (Clause 11.4) -->
<FilterBar SearchPlaceholder="Search by Application No, Project Title, Organisation Name, Grant Type..."
           @bind-SearchText="_searchString"
           OnSearch="HandleFilterChanged"
           OnClear="HandleFilterCleared">
    <FilterContent>
        <div class="d-flex flex-column gap-1">
            <MudText Typo="Typo.caption" Color="Color.Secondary">Status</MudText>
            <MudToggleGroup T="string"
                            Value="_statusFilter"
                            ValueChanged="HandleStatusToggleChanged"
                            SelectionMode="SelectionMode.SingleSelection"
                            Color="Color.Primary"
                            Variant="Variant.Outlined"
                            Dense="true"
                            Size="Size.Small"
                            aria-label="Filter DG applications by status">
                <MudToggleItem Value="@("All")" Text="All" />
                <MudToggleItem Value="@("DRAFT")" Text="Draft" />
                <MudToggleItem Value="@("SUBMITTED")" Text="Submitted" />
                <MudToggleItem Value="@("APPROVED")" Text="Approved" />
                <MudToggleItem Value="@("REJECTED")" Text="Rejected" />
            </MudToggleGroup>
        </div>
    </FilterContent>
    <ActiveFilterChips>
        @if (!string.IsNullOrWhiteSpace(_searchString))
        {
            <MudChip T="string" Size="Size.Small" OnClose="@(async () => { _searchString = string.Empty; await HandleFilterChanged(); })">
                Keyword: @_searchString
            </MudChip>
        }
        @if (_statusFilter != "All")
        {
            <MudChip T="string" Size="Size.Small" Color="Color.Primary" OnClose="@(async () => { _statusFilter = "All"; await HandleFilterChanged(); })">
                Status: @_statusFilter
            </MudChip>
        }
    </ActiveFilterChips>
</FilterBar>

<!-- Data Grid Shell (Clause 11.9) -->
<DataGridShell TItem="GrantApplication"
               GridKey="GrantsRegistryGrid"
               Items="@_currentPagedItems"
               IsLoading="false"
               TotalItemsCount="@_totalCount"
               SelectedItems="@_selectedGrants"
               SelectedItemsChanged="OnSelectedGrantsChanged"
               ExportCallback="ExportSelected"
               EmptyTitle="No Grant Applications Found"
               EmptyMessage="No Discretionary Grant applications match your active search or filter criteria. Create a new grant application to initiate funding allocation."
               EmptyActionLabel="Apply for Grant"
               OnEmptyAction="CreateNewGrant">
    <BulkActionBarContent>
        <MudText Typo="Typo.body2" Class="fw-bold text-white">
            @_selectedGrants.Count grant application(s) selected
        </MudText>
        <MudButton Variant="Variant.Filled" 
                   Color="Color.Surface" 
                   Size="Size.Small" 
                   StartIcon="@Icons.Material.Filled.FileDownload"
                   OnClick="ExportSelected">
            Export Selected
        </MudButton>
    </BulkActionBarContent>
    <ChildContent>
        <MudTable @ref="_table"
                  T="GrantApplication"
                  ServerData="ServerReload"
                  Hover="true"
                  Dense="true"
                  Elevation="0"
                  MultiSelection="true"
                  @bind-SelectedItems="_selectedGrants"
                  Breakpoint="Breakpoint.Sm"
                  Class="border-default">
            <HeaderContent>
                <MudTh>Application No</MudTh>
                <MudTh>Project Title</MudTh>
                <MudTh>Organisation</MudTh>
                <MudTh Class="d-none d-md-table-cell">Grant Type</MudTh>
                <MudTh>Requested Amount</MudTh>
                <MudTh>Approved Amount</MudTh>
                <MudTh Class="d-none d-lg-table-cell">WSP Compliance</MudTh>
                <MudTh>Status</MudTh>
                <MudTh Style="text-align:right">Actions</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Application No">
                    <a href="/dg-grants/@context.Id" class="d-flex align-center gap-1 font-monospace fw-bold text-primary text-decoration-none">
                        <MudIcon Icon="@Icons.Material.Filled.AccountBalanceWallet" Size="Size.Small" />
                        <span>@(string.IsNullOrWhiteSpace(context.ApplicationNumber) ? $"DG-{context.Id}" : context.ApplicationNumber)</span>
                    </a>
                </MudTd>
                <MudTd DataLabel="Project Title">
                    <MudText Typo="Typo.body2" Class="fw-bold">@context.ProjectTitle</MudText>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Date: @context.ApplicationDate.ToString("yyyy-MM-dd")</MudText>
                </MudTd>
                <MudTd DataLabel="Organisation">
                    <MudText Typo="Typo.body2">@(context.Organisation?.CompanyName ?? "Unlinked Organisation")</MudText>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">SDL: @(context.Organisation?.SdlNumber ?? "—")</MudText>
                </MudTd>
                <MudTd Class="d-none d-md-table-cell" DataLabel="Grant Type">
                    <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Outlined">
                        @(!string.IsNullOrWhiteSpace(context.GrantTypeCode) ? context.GrantTypeCode : "PIVOTAL")
                    </MudChip>
                </MudTd>
                <MudTd DataLabel="Requested Amount">
                    <MudText Typo="Typo.body2" Class="fw-bold">@context.RequestedAmount.ToString("C")</MudText>
                </MudTd>
                <MudTd DataLabel="Approved Amount">
                    @if (context.ApprovedAmount.HasValue)
                    {
                        <MudText Typo="Typo.body2" Class="fw-bold text-success">@context.ApprovedAmount.Value.ToString("C")</MudText>
                    }
                    else
                    {
                        <span class="text-secondary">—</span>
                    }
                </MudTd>
                <MudTd Class="d-none d-lg-table-cell" DataLabel="WSP Compliance">
                    @if (context.IsWspExempt)
                    {
                        <MudChip T="string" Size="Size.Small" Color="Color.Info" Variant="Variant.Filled">Exempt</MudChip>
                    }
                    else if (context.IsWspCompliant)
                    {
                        <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Filled">Compliant</MudChip>
                    }
                    else
                    {
                        <MudChip T="string" Size="Size.Small" Color="Color.Error" Variant="Variant.Filled">Pending WSP</MudChip>
                    }
                </MudTd>
                <MudTd DataLabel="Status">
                    <MudChip T="string" Size="Size.Small" Color="@GetStatusColor(context.StatusCode)" Variant="Variant.Filled">
                        @context.StatusCode
                    </MudChip>
                </MudTd>
                <MudTd Style="text-align:right" DataLabel="Actions">
                    <div class="d-flex justify-end gap-1">
                        <MudTooltip Text="View DG Application">
                            <MudIconButton Icon="@Icons.Material.Filled.Visibility" 
                                           Color="Color.Primary" 
                                           Size="Size.Small" 
                                           OnClick="@(() => OpenDetail(context.Id))" 
                                           aria-label="View Application" />
                        </MudTooltip>
                        <MudTooltip Text="Edit DG Application">
                            <MudIconButton Icon="@Icons.Material.Filled.Edit" 
                                           Color="Color.Secondary" 
                                           Size="Size.Small" 
                                           OnClick="@(() => OpenEdit(context.Id))" 
                                           aria-label="Edit Application" />
                        </MudTooltip>
                        <MudTooltip Text="Delete DG Application">
                            <MudIconButton Icon="@Icons.Material.Filled.Delete" 
                                           Color="Color.Error" 
                                           Size="Size.Small" 
                                           OnClick="@(() => DeleteGrant(context.Id, context.ApplicationNumber))" 
                                           aria-label="Delete Application" />
                        </MudTooltip>
                    </div>
                </MudTd>
            </RowTemplate>
            <NoRecordsContent>
                <EmptyState Icon="@Icons.Material.Filled.Description"
                            Message="No Discretionary Grant Applications Found"
                            Description="@(_totalCount == 0 ? "No Discretionary Grant applications currently registered in the database. Submit a new application to initiate the approval cycle." : "No grant applications match your active search or filter criteria. Try clearing your filters.")"
                            ActionLabel="@(_totalCount == 0 ? "Apply for Discretionary Grant" : "Clear Filters")"
                            ActionHref="@(_totalCount == 0 ? "/dg-grants/create" : null)"
                            OnAction="HandleFilterCleared" />
            </NoRecordsContent>
            <PagerContent>
                <MudTablePager PageSizeOptions="new int[] { 5, 10, 20, 50, 100, 250, 500 }" />
            </PagerContent>
        </MudTable>
    </ChildContent>
</DataGridShell>

@code {
    private MudTable<GrantApplication>? _table;
    private IReadOnlyList<GrantApplication> _currentPagedItems = Array.Empty<GrantApplication>();
    private int _totalCount;
    private HashSet<GrantApplication> _selectedGrants = new();
    private string _searchString = string.Empty;
    private string _statusFilter = "All";

    private List<BreadcrumbItem> _breadcrumbs = new()
    {
        new BreadcrumbItem("Home", href: "/"),
        new BreadcrumbItem("Grants & WSP", href: null, disabled: true),
        new BreadcrumbItem("Discretionary Grants (DG)", href: "/dg-grants")
    };

    private async Task<TableData<GrantApplication>> ServerReload(TableState state, CancellationToken ct)
    {
        var query = new PaginationQuery
        {
            PageIndex = state.Page,
            PageSize = state.PageSize,
            SearchText = _searchString,
            SortBy = state.SortLabel,
            SortDescending = state.SortDirection == SortDirection.Descending
        };

        if (!string.IsNullOrWhiteSpace(_statusFilter) && _statusFilter != "All")
        {
            query.FilterParams["status"] = _statusFilter;
        }

        var result = await GrantService.GetPagedApplicationsAsync(query, ct);
        _currentPagedItems = result.Items;
        _totalCount = result.TotalCount;

        return new TableData<GrantApplication>
        {
            TotalItems = result.TotalCount,
            Items = result.Items
        };
    }

    private Color GetStatusColor(string? status) => status switch
    {
        "APPROVED" => Color.Success,
        "SUBMITTED" => Color.Info,
        "REJECTED" => Color.Error,
        _ => Color.Default
    };

    private async Task HandleStatusToggleChanged(string? val)
    {
        _statusFilter = string.IsNullOrEmpty(val) ? "All" : val;
        await HandleFilterChanged();
    }

    private async Task HandleFilterChanged()
    {
        if (_table != null)
        {
            await _table.ReloadServerData();
        }
    }

    private async Task HandleFilterCleared()
    {
        _searchString = string.Empty;
        _statusFilter = "All";
        if (_table != null)
        {
            await _table.ReloadServerData();
        }
    }

    private void OnSelectedGrantsChanged(HashSet<GrantApplication> selected)
    {
        _selectedGrants = selected;
    }

    private void OpenDetail(int id)
    {
        NavManager.NavigateTo($"/dg-grants/{id}");
    }

    private void OpenEdit(int id)
    {
        NavManager.NavigateTo($"/dg-grants/{id}/edit");
    }

    private void CreateNewGrant()
    {
        NavManager.NavigateTo("/dg-grants/create");
    }

    private async Task ExportSelected()
    {
        var targetList = _selectedGrants.Count > 0 ? _selectedGrants.ToList() : _currentPagedItems.ToList();
        if (targetList.Count == 0)
        {
            Snackbar.Add("No grant applications available to export.", Severity.Warning);
            return;
        }

        var sb = new System.Text.StringBuilder();
        sb.AppendLine("Application Number,Organisation Name,Project Title,Grant Type Code,Requested Amount,Approved Amount,Status");
        foreach (var g in targetList)
        {
            sb.AppendLine($"\"{EscapeCsv(g.ApplicationNumber)}\",\"{EscapeCsv(g.Organisation?.CompanyName ?? "Unknown")}\",\"{EscapeCsv(g.ProjectTitle)}\",\"{EscapeCsv(g.GrantTypeCode)}\",\"{g.RequestedAmount.ToString("F2", System.Globalization.CultureInfo.InvariantCulture)}\",\"{(g.ApprovedAmount?.ToString("F2", System.Globalization.CultureInfo.InvariantCulture) ?? "")}\",\"{EscapeCsv(g.ApplicationStatusCode)}\"");
        }

        var bytes = System.Text.Encoding.UTF8.GetBytes(sb.ToString());
        var base64 = Convert.ToBase64String(bytes);
        await JS.InvokeVoidAsync("downloadFileFromBytes", $"Discretionary_Grants_Export_{DateTime.UtcNow:yyyyMMdd_HHmmss}.csv", "text/csv", base64);
        Snackbar.Add($"Exported {targetList.Count} grant applications to CSV.", Severity.Success);
    }

    private static string EscapeCsv(string? val) => (val ?? "").Replace("\"", "\"\"").Replace("\r", " ").Replace("\n", " ");

    private async Task DeleteGrant(int id, string appNo)
    {
        bool? confirmed = await DialogService.ShowMessageBoxAsync(
            "Delete Grant Application?",
            $"Are you sure you wish to delete grant application '{appNo}'? This action will perform an audit-tracked soft delete.",
            yesText: "Delete Application",
            cancelText: "Cancel"
        );

        if (confirmed == true)
        {
            var deleted = await GrantService.DeleteAsync(id, "Admin");
            if (deleted)
            {
                Snackbar.Add($"Grant application '{appNo}' deleted successfully with audit confirmation.", Severity.Success);
                if (_table != null)
                {
                    await _table.ReloadServerData();
                }
            }
            else
            {
                Snackbar.Add("Could not delete the grant application.", Severity.Error);
            }
        }
    }
}
