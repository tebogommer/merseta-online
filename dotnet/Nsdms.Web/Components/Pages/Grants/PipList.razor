@page "/grants/pip"
@using Nsdms.Application.Common.Interfaces
@using Nsdms.Domain.Entities
@inject IDgProjectImplementationService PipService
@inject NavigationManager Navigation
@inject ISnackbar Snackbar

<PageTitle>Project Implementation Plans (PIP) | merSETA NSDMS</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="my-4">
    <MudCard Elevation="2" Class="mb-4">
        <MudCardContent Class="d-flex align-center justify-space-between py-3">
            <div>
                <MudBreadcrumbs Items="_breadcrumbs" Class="pa-0 mb-1" />
                <MudText Typo="Typo.h5" Class="fw-bold">DG Project Implementation Plans (PIP)</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">
                    Contracting milestones, learner allocation budgets, and tranche payment claims.
                </MudText>
            </div>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="@(() => Navigation.NavigateTo("/grants/pip/create"))">
                Create New PIP Plan
            </MudButton>
        </MudCardContent>
    </MudCard>

    <MudCard Elevation="2">
        <MudTable Items="_pips" Hover="true" Dense="true" Elevation="0" OnRowClick="@((TableRowClickEventArgs<ProjectImplementationPlan> args) => Navigation.NavigateTo($"/grants/pip/{args.Item.Id}"))" RowClass="cursor-pointer">
            <HeaderContent>
                <MudTh>Plan Reference</MudTh>
                <MudTh>Employer / Organisation</MudTh>
                <MudTh>Intervention Type</MudTh>
                <MudTh>Awarded Learners</MudTh>
                <MudTh>Total Awarded Amount</MudTh>
                <MudTh>Status</MudTh>
                <MudTh Style="text-align: right;">Action</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Plan" Class="fw-bold">@context.PlanReferenceNumber</MudTd>
                <MudTd DataLabel="Employer">@(context.Organisation?.CompanyName ?? "Apex Engineering")</MudTd>
                <MudTd DataLabel="Type">
                    <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Outlined">@context.InterventionTypeCode</MudChip>
                </MudTd>
                <MudTd DataLabel="Learners">@context.TotalLearnersAwarded</MudTd>
                <MudTd DataLabel="Amount" Class="fw-bold">@context.TotalAwardedAmount.ToString("C2")</MudTd>
                <MudTd DataLabel="Status">
                    <MudChip T="string" Size="Size.Small" Color="@(context.StatusCode == "ActiveContractsSigned" ? Color.Success : Color.Info)" Variant="Variant.Filled">
                        @context.StatusCode
                    </MudChip>
                </MudTd>
                <MudTd DataLabel="Action" Style="text-align: right;">
                    <MudIconButton Icon="@Icons.Material.Filled.ArrowForward" Color="Color.Primary" Size="Size.Small" OnClick="@(() => Navigation.NavigateTo($"/grants/pip/{context.Id}"))" />
                </MudTd>
            </RowTemplate>
        </MudTable>
    </MudCard>
</MudContainer>

@code {
    private List<BreadcrumbItem> _breadcrumbs = new()
    {
        new BreadcrumbItem("Home", href: "/"),
        new BreadcrumbItem("Grants", href: "/grants"),
        new BreadcrumbItem("Project Implementation Plans", href: null, disabled: true)
    };

    private List<ProjectImplementationPlan> _pips = new();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _pips = await PipService.GetAllPipsAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error loading PIPs: {ex.Message}", Severity.Error);
        }
    }
}
