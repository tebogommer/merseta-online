@page "/grants/pip/{Id:int}"
@using Nsdms.Application.Common.Interfaces
@using Nsdms.Domain.Entities
@using Nsdms.Web.Components.Shared
@inject IDgProjectImplementationService PipService
@inject NavigationManager Navigation
@inject ISnackbar Snackbar

<PageTitle>PIP Plan @_pip.PlanReferenceNumber | merSETA NSDMS</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="my-4">
    <!-- Top Bar -->
    <MudCard Elevation="2" Class="mb-4 sticky-top-header" Style="position: sticky; top: var(--mud-appbar-height, 64px) !important; z-index: 10;">
        <MudCardContent Class="d-flex align-center justify-space-between py-3">
            <div class="d-flex align-center gap-3">
                <MudIconButton Icon="@Icons.Material.Filled.ArrowBack" Color="Color.Default" OnClick="@(() => Navigation.NavigateTo("/grants/pip"))" />
                <div>
                    <MudBreadcrumbs Items="_breadcrumbs" Class="pa-0 mb-1" />
                    <MudText Typo="Typo.h5" Class="fw-bold">@_pip.PlanReferenceNumber - @(_pip.Organisation?.CompanyName ?? "Apex Engineering")</MudText>
                </div>
            </div>
            <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
                <MudButton Variant="Variant.Outlined" Color="Color.Secondary" StartIcon="@Icons.Material.Filled.Cancel" OnClick="@(() => Navigation.NavigateTo("/grants/pip"))">
                    Cancel
                </MudButton>
                <MudChip T="string" Color="Color.Success" Variant="Variant.Filled">@_pip.StatusCode</MudChip>
            </MudStack>
        </MudCardContent>
    </MudCard>

    <!-- Workflow State Tracker & Action Bridge -->
    <WorkflowProgressBar ProcessCode="PIP" 
                         EntityId="@Id" 
                         EntityTitle="@($"PIP #{_pip.PlanReferenceNumber} - {_pip.Organisation?.CompanyName}")" 
                         EntityRef="@_pip.PlanReferenceNumber" />

    <WorkflowActionBridge ProcessCode="PIP" 
                          EntityId="@Id" 
                          EntityTitle="@($"PIP #{_pip.PlanReferenceNumber} - {_pip.Organisation?.CompanyName}")" 
                          EntityRef="@_pip.PlanReferenceNumber" 
                          OnStatusChanged="OnWorkflowStatusChanged" />

    <MudTabs Elevation="2" Rounded="true" ApplyEffectsToContainer="true" PanelClass="pa-6" Color="Color.Primary">
        <!-- TAB 1: Master Scope -->
        <MudTabPanel Text="Plan Details" Icon="@Icons.Material.Filled.Description">
            <MudGrid>
                <MudItem xs="12" md="6">
                    <MudTextField @bind-Value="_pip.PlanReferenceNumber" Label="PIP Reference" Variant="Variant.Outlined" ReadOnly="true" />
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudTextField @bind-Value="_pip.InterventionTypeCode" Label="Intervention Type" Variant="Variant.Outlined" ReadOnly="true" />
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudNumericField @bind-Value="_pip.TotalAwardedAmount" Label="Total Awarded Budget (ZAR)" Variant="Variant.Outlined" Format="C2" ReadOnly="true" />
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudNumericField @bind-Value="_pip.TotalLearnersAwarded" Label="Total Learners" Variant="Variant.Outlined" ReadOnly="true" />
                </MudItem>
            </MudGrid>
        </MudTabPanel>

        <!-- TAB 2: Payment Claims & Tranches -->
        <MudTabPanel Text="Payment Claims &amp; Tranches" Icon="@Icons.Material.Filled.Payments">
            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-3">
                <MudText Typo="Typo.h6">Tranche Payment Claims</MudText>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="SubmitClaimAsync">
                    Submit Tranche Payment Claim
                </MudButton>
            </MudStack>

            <MudTable Items="_pip.Claims" Hover="true" Dense="true" Elevation="0" Outlined="true">
                <HeaderContent>
                    <MudTh>Claim #</MudTh>
                    <MudTh>Tranche</MudTh>
                    <MudTh>Claim Amount</MudTh>
                    <MudTh>Deliverable</MudTh>
                    <MudTh>Status</MudTh>
                    <MudTh>ERP Batch</MudTh>
                    <MudTh Style="text-align: right;">Action</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Claim" Class="fw-bold">@context.ClaimNumber</MudTd>
                    <MudTd DataLabel="Tranche">Tranche #@context.TrancheNumber</MudTd>
                    <MudTd DataLabel="Amount" Class="fw-bold">@context.ClaimAmount.ToString("C2")</MudTd>
                    <MudTd DataLabel="Deliverable">@context.DeliverableDescription</MudTd>
                    <MudTd DataLabel="Status">
                        <MudChip T="string" Size="Size.Small" Color="@(context.StatusCode == "Paid" ? Color.Success : Color.Warning)" Variant="Variant.Filled">
                            @context.StatusCode
                        </MudChip>
                    </MudTd>
                    <MudTd DataLabel="ERP"><code>@(context.ErpBatchNumber ?? "Pending")</code></MudTd>
                    <MudTd DataLabel="Action" Style="text-align: right;">
                        @if (context.StatusCode != "Paid")
                        {
                            <MudButton Variant="Variant.Filled" Color="Color.Success" Size="Size.Small" OnClick="@(() => ApproveClaimAsync(context.Id))">
                                Disburse via ERP
                            </MudButton>
                        }
                    </MudTd>
                </RowTemplate>
            </MudTable>
        </MudTabPanel>
    </MudTabs>
</MudContainer>

@code {
    [Parameter]
    public int Id { get; set; }

    private ProjectImplementationPlan _pip = new();
    private List<BreadcrumbItem> _breadcrumbs = new();

    protected override async Task OnParametersSetAsync()
    {
        await LoadPipAsync();
    }

    private async Task LoadPipAsync()
    {
        var existing = await PipService.GetPipByIdAsync(Id);
        if (existing != null)
        {
            _pip = existing;
            _breadcrumbs = new List<BreadcrumbItem>
            {
                new BreadcrumbItem("Home", href: "/"),
                new BreadcrumbItem("Grants", href: "/grants"),
                new BreadcrumbItem("PIP Plans", href: "/grants/pip"),
                new BreadcrumbItem($"PIP #{_pip.PlanReferenceNumber}", href: null, disabled: true)
            };
        }
    }

    private async Task SignOffContractsAsync()
    {
        await PipService.SignOffContractsAsync(Id, "AdminUser");
        Snackbar.Add("PIP contracts signed and activated.", Severity.Success);
        await LoadPipAsync();
    }

    private async Task SubmitClaimAsync()
    {
        var claim = new GrantPaymentClaim
        {
            ProjectImplementationPlanId = Id,
            TrancheNumber = _pip.Claims.Count + 1,
            ClaimAmount = _pip.TotalAwardedAmount / 4,
            DeliverableDescription = $"Deliverable Milestone for Tranche #{_pip.Claims.Count + 1}"
        };
        await PipService.SubmitPaymentClaimAsync(claim, "AdminUser");
        Snackbar.Add("Payment claim submitted.", Severity.Success);
        await LoadPipAsync();
    }

    private async Task ApproveClaimAsync(int claimId)
    {
        await PipService.ApproveAndDisburseClaimAsync(claimId, "AdminUser");
        Snackbar.Add("Payment disbursed through ERP adapter.", Severity.Success);
        await LoadPipAsync();
    }

    private async Task OnWorkflowStatusChanged(string newStatus)
    {
        await LoadPipAsync();
        StateHasChanged();
    }
}
