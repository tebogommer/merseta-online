@page "/dg-funding-windows"
@page "/grants/windows"
@using Nsdms.Application.Services
@using Nsdms.Domain.Entities
@using Nsdms.Web.Components.Shared
@using MudBlazor
@inject IGrantService GrantService
@inject NavigationManager NavManager
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@rendermode InteractiveServer

@*
  UI-STANDARD.md Archetype: A1 / T1 (Transactional List - DG Funding Windows)
  Clauses: 4.2, 4.3, 6.1, 7.2, 8.1, 8.3, 11.1–11.9
*@

<PageTitle>DG Funding Windows - merSETA NSDMS</PageTitle>

<EntityHeader Title="Discretionary Grant (DG) Funding Windows"
              Subtitle="Gazetted Discretionary Grant funding allocation cycles, opening and closing deadlines, and budget allocations"
              ReferenceKey="T1-DG-WINDOWS"
              Status="Active"
              BreadcrumbItems="@_breadcrumbs">
    <ActionZone>
        <MudButton Variant="Variant.Outlined"
                   Color="Color.Default"
                   StartIcon="@Icons.Material.Filled.ArrowBack"
                   OnClick="@(() => NavManager.NavigateTo("/dg-grants"))"
                   Class="mr-2">
            Back to DG Applications
        </MudButton>
        <MudButton Variant="Variant.Filled" 
                   Color="Color.Primary" 
                   StartIcon="@Icons.Material.Filled.AddCard" 
                   OnClick="CreateNewWindow">
            Open New DG Funding Window
        </MudButton>
    </ActionZone>
</EntityHeader>

<!-- Filter Bar -->
<FilterBar SearchPlaceholder="Search by Window Title, Scheme Year, Grant Type..."
           @bind-SearchText="_searchString"
           OnSearch="HandleFilterChanged"
           OnClear="HandleFilterCleared">
    <FilterContent>
        <MudSelect T="string" 
                   Label="Status Filter" 
                   @bind-Value="_statusFilter" 
                   @bind-Value:after="HandleFilterChanged"
                   Variant="Variant.Outlined" 
                   Margin="Margin.Dense"
                   Dense="true">
            <MudSelectItem Value="@("All")">All Windows</MudSelectItem>
            <MudSelectItem Value="@("Open")">Open &amp; Active</MudSelectItem>
            <MudSelectItem Value="@("Upcoming")">Upcoming</MudSelectItem>
            <MudSelectItem Value="@("Closed")">Closed / Expired</MudSelectItem>
        </MudSelect>
    </FilterContent>
    <ActiveFilterChips>
        @if (!string.IsNullOrWhiteSpace(_searchString))
        {
            <MudChip T="string" Size="Size.Small" OnClose="@(() => { _searchString = string.Empty; HandleFilterChanged(); })">
                Keyword: @_searchString
            </MudChip>
        }
        @if (_statusFilter != "All")
        {
            <MudChip T="string" Size="Size.Small" Color="Color.Primary" OnClose="@(() => { _statusFilter = "All"; HandleFilterChanged(); })">
                Status: @_statusFilter
            </MudChip>
        }
    </ActiveFilterChips>
</FilterBar>

<!-- Data Grid Shell -->
<DataGridShell TItem="GrantFundingWindow"
               GridKey="FundingWindowsGrid"
               Items="@FilteredWindows"
               IsLoading="@_loading"
               TotalItemsCount="@FilteredWindows.Count"
               EmptyTitle="No Funding Windows Found"
               EmptyMessage="No Discretionary Grant funding windows match your search or filter criteria. Open a new funding window to commence applications."
               EmptyActionLabel="Open Funding Window"
               OnEmptyAction="CreateNewWindow">
    <ChildContent>
        <MudTable Items="@FilteredWindows"
                  Hover="true"
                  Dense="true"
                  Elevation="0"
                  Breakpoint="Breakpoint.Sm"
                  Class="border-default">
            <HeaderContent>
                <MudTh>Window Name</MudTh>
                <MudTh>Fin Year</MudTh>
                <MudTh>Grant Type</MudTh>
                <MudTh>Opening Date</MudTh>
                <MudTh>Closing Date</MudTh>
                <MudTh>Available Budget</MudTh>
                <MudTh>Status</MudTh>
                <MudTh Style="text-align:right">Actions</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Window Name">
                    <a href="/dg-funding-windows/@context.Id" class="d-flex align-center gap-1 fw-bold text-primary text-decoration-none">
                        <MudIcon Icon="@Icons.Material.Filled.EventNote" Size="Size.Small" />
                        <span>@context.WindowName</span>
                    </a>
                    @if (!string.IsNullOrWhiteSpace(context.Description))
                    {
                        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="d-block text-truncate" Style="max-width: 280px;">
                            @context.Description
                        </MudText>
                    }
                </MudTd>
                <MudTd DataLabel="Fin Year">
                    <MudChip T="string" Size="Size.Small" Color="Color.Default" Variant="Variant.Outlined">@context.FinYear</MudChip>
                </MudTd>
                <MudTd DataLabel="Grant Type">
                    <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Filled">
                        @(!string.IsNullOrWhiteSpace(context.GrantTypeCode) ? context.GrantTypeCode : "PIVOTAL")
                    </MudChip>
                </MudTd>
                <MudTd DataLabel="Opening Date">
                    <MudText Typo="Typo.body2">@context.OpeningDate.ToString("yyyy-MM-dd HH:mm")</MudText>
                </MudTd>
                <MudTd DataLabel="Closing Date">
                    <MudText Typo="Typo.body2" Class="@(context.ClosingDate < DateTime.UtcNow ? "text-error fw-bold" : "fw-bold")">
                        @context.ClosingDate.ToString("yyyy-MM-dd HH:mm")
                    </MudText>
                </MudTd>
                <MudTd DataLabel="Available Budget">
                    <MudText Typo="Typo.body2" Class="fw-bold text-success">@context.TotalAvailableBudget.ToString("C")</MudText>
                </MudTd>
                <MudTd DataLabel="Status">
                    @if (!context.IsActive)
                    {
                        <MudChip T="string" Size="Size.Small" Color="Color.Error" Variant="Variant.Filled">Closed</MudChip>
                    }
                    else if (DateTime.UtcNow < context.OpeningDate)
                    {
                        <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Filled">Upcoming</MudChip>
                    }
                    else if (DateTime.UtcNow > context.ClosingDate)
                    {
                        <MudChip T="string" Size="Size.Small" Color="Color.Dark" Variant="Variant.Filled">Expired</MudChip>
                    }
                    else
                    {
                        <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Filled">Open</MudChip>
                    }
                </MudTd>
                <MudTd Style="text-align:right" DataLabel="Actions">
                    <div class="d-flex justify-end gap-1">
                        <MudTooltip Text="View Window Details">
                            <MudIconButton Icon="@Icons.Material.Filled.Visibility" 
                                           Color="Color.Primary" 
                                           Size="Size.Small" 
                                           OnClick="@(() => OpenDetail(context.Id))" 
                                           aria-label="View Window" />
                        </MudTooltip>
                        <MudTooltip Text="Edit Window">
                            <MudIconButton Icon="@Icons.Material.Filled.Edit" 
                                           Color="Color.Secondary" 
                                           Size="Size.Small" 
                                           OnClick="@(() => OpenEdit(context.Id))" 
                                           aria-label="Edit Window" />
                        </MudTooltip>
                        @if (context.IsActive && context.ClosingDate >= DateTime.UtcNow)
                        {
                            <MudTooltip Text="Close Window Early">
                                <MudIconButton Icon="@Icons.Material.Filled.Lock" 
                                                Color="Color.Warning" 
                                                Size="Size.Small" 
                                                OnClick="@(() => CloseWindow(context.Id, context.WindowName))" 
                                                aria-label="Close Window" />
                            </MudTooltip>
                        }
                    </div>
                </MudTd>
            </RowTemplate>
            <PagerContent>
                <MudTablePager PageSizeOptions="new int[] { 5, 10, 20, 50, 100 }" />
            </PagerContent>
        </MudTable>
    </ChildContent>
</DataGridShell>

@code {
    private List<GrantFundingWindow> _windows = new();
    private bool _loading = true;
    private string _searchString = string.Empty;
    private string _statusFilter = "All";

    private List<BreadcrumbItem> _breadcrumbs = new()
    {
        new BreadcrumbItem("Home", href: "/"),
        new BreadcrumbItem("Discretionary Grants (DG)", href: "/dg-grants"),
        new BreadcrumbItem("DG Funding Windows", href: "/dg-funding-windows", disabled: true)
    };

    private List<GrantFundingWindow> FilteredWindows => _windows
        .Where(w => string.IsNullOrWhiteSpace(_searchString) ||
                    w.WindowName.Contains(_searchString, StringComparison.OrdinalIgnoreCase) ||
                    (w.GrantTypeCode != null && w.GrantTypeCode.Contains(_searchString, StringComparison.OrdinalIgnoreCase)) ||
                    w.FinYear.ToString().Contains(_searchString))
        .Where(w => _statusFilter == "All" ||
                    (_statusFilter == "Open" && w.IsActive && w.OpeningDate <= DateTime.UtcNow && w.ClosingDate >= DateTime.UtcNow) ||
                    (_statusFilter == "Upcoming" && w.IsActive && w.OpeningDate > DateTime.UtcNow) ||
                    (_statusFilter == "Closed" && (!w.IsActive || w.ClosingDate < DateTime.UtcNow)))
        .ToList();

    protected override async Task OnInitializedAsync()
    {
        await LoadWindowsAsync();
    }

    private async Task LoadWindowsAsync()
    {
        _loading = true;
        try
        {
            _windows = await GrantService.GetFundingWindowsAsync(activeOnly: false);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error loading funding windows: {ex.Message}", Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private void HandleFilterChanged() => StateHasChanged();
    private void HandleFilterCleared()
    {
        _searchString = string.Empty;
        _statusFilter = "All";
        StateHasChanged();
    }

    private void CreateNewWindow() => NavManager.NavigateTo("/dg-funding-windows/create");
    private void OpenDetail(int id) => NavManager.NavigateTo($"/dg-funding-windows/{id}");
    private void OpenEdit(int id) => NavManager.NavigateTo($"/dg-funding-windows/{id}/edit");

    private async Task CloseWindow(int id, string name)
    {
        bool? confirmed = await DialogService.ShowMessageBoxAsync(
            "Close Funding Window",
            $"Are you sure you want to close the funding window '{name}'? No further applications will be accepted.",
            yesText: "Close Window", cancelText: "Cancel");

        if (confirmed == true)
        {
            var success = await GrantService.CloseFundingWindowAsync(id, "AdminUser");
            if (success)
            {
                Snackbar.Add($"Funding window '{name}' closed successfully.", Severity.Success);
                await LoadWindowsAsync();
            }
            else
            {
                Snackbar.Add("Could not close funding window.", Severity.Error);
            }
        }
    }
}
