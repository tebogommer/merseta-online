@page "/dg-grants/{id:int}"
@page "/dg-grants/{id:int}/edit"
@page "/grants/{id:int}"
@page "/grants/{id:int}/edit"
@using Nsdms.Application.Common.Interfaces
@using Nsdms.Application.Services
@using Nsdms.Domain.Entities
@using Nsdms.Web.Components.Shared
@inject IGrantService GrantService
@inject IOrganisationService OrgService
@inject ILookupService LookupService
@inject NavigationManager NavManager
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@rendermode InteractiveServer

<PageTitle>@(Id == 0 ? "New Discretionary Grant (DG) Application" : $"{_grant.ApplicationNumber} - {_grant.ProjectTitle}") - merSETA NSDMS</PageTitle>

@if (!_isEditMode && Id > 0)
{
    <EntityHeader Title="@_grant.ProjectTitle"
                  ReferenceKey="@_grant.ApplicationNumber"
                  Status="@_grant.StatusCode"
                  Subtitle="@($"Requested: {_grant.RequestedAmount:C} | Approved: {(_grant.ApprovedAmount.HasValue ? _grant.ApprovedAmount.Value.ToString("C") : "Pending")} | Type: {_grant.GrantTypeCode} | {GetClassificationBadgeText()}")"
                  BreadcrumbItems="@_breadcrumbItems">
        <ActionZone>
            <MudButton Variant="Variant.Text"
                       StartIcon="@Icons.Material.Filled.ArrowBack"
                       Color="Color.Default"
                       OnClick="BackToList"
                       aria-label="Back to Discretionary Grants (DG)">
                Back to DG Applications
            </MudButton>
            <MudButton Variant="Variant.Outlined"
                       Color="Color.Error"
                       StartIcon="@Icons.Material.Filled.Delete"
                       OnClick="DeleteGrant"
                       aria-label="Delete Discretionary Grant Application">
                Delete
            </MudButton>
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Edit"
                       OnClick="EnterEditMode"
                       aria-label="Edit Discretionary Grant Application">
                Edit DG Application
            </MudButton>
        </ActionZone>
    </EntityHeader>
}
else
{
    <EntityHeader Title="@(Id == 0 ? "New Discretionary Grant (DG) Application" : $"Edit {_grant.ApplicationNumber}")"
                  ReferenceKey="@_grant.ApplicationNumber"
                  Status="@(Id == 0 ? "Draft" : "Editing")"
                  Subtitle="@(Id == 0 ? "Apply for PIVOTAL & strategic project funding window allocations" : $"Modify project goals and budget allocations for {_grant.ProjectTitle}")"
                  BreadcrumbItems="@_breadcrumbItems">
        <ActionZone>
            <MudButton Variant="Variant.Outlined"
                       Color="Color.Secondary"
                       StartIcon="@Icons.Material.Filled.Cancel"
                       OnClick="ExitEditMode"
                       aria-label="Cancel">
                Cancel
            </MudButton>
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Save"
                       OnClick="SaveGrant"
                       Disabled="_isSaving"
                       aria-label="Save Discretionary Grant Application">
                @(_isSaving ? "Saving..." : "Save DG Application")
            </MudButton>
        </ActionZone>
    </EntityHeader>
}

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="pa-0">
    @if (Id > 0)
    {
        <!-- Visual Workflow Step Tracker -->
        <WorkflowProgressBar ProcessCode="DG" 
                             EntityId="@Id" 
                             EntityTitle="@_grant.ProjectTitle" 
                             EntityRef="@_grant.ApplicationNumber" />

        <!-- Action Bridge for Workflow Transitions -->
        <WorkflowActionBridge ProcessCode="DG" 
                              EntityId="@Id" 
                              EntityTitle="@_grant.ProjectTitle" 
                              EntityRef="@_grant.ApplicationNumber" 
                              OnStatusChanged="OnWorkflowStatusChanged" />
    }

    @if (_loading)
    {
        <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="my-6" />
    }
    else
    {
        <MudTabs Elevation="2" Rounded="true" ApplyEffectsToContainer="true" Color="Color.Surface" @bind-ActivePanelIndex="_activeTabIndex">
            <!-- TAB 1: DG Application Details -->
            <MudTabPanel Text="DG Application Details" Icon="@Icons.Material.Filled.AssignmentTurnedIn">
                <MudForm @ref="_form" @bind-IsValid="_isValid" ReadOnly="@(!_isEditMode)" Class="pa-4">
                    <MudGrid Spacing="3">
                        <MudItem xs="12" lg="8">
                            <MudCard Outlined="true" Class="pa-4 mb-4">
                                <div class="d-flex justify-space-between align-center mb-3">
                                    <MudText Typo="Typo.h6" Class="fw-bold">Discretionary Grant Project Specification</MudText>
                                    <MudChip T="string" Size="Size.Small"
                                             Color="@(_grant.HasPivotalInterventions && _grant.HasNonPivotalInterventions ? Color.Primary : (_grant.HasNonPivotalInterventions ? Color.Warning : Color.Success))"
                                             Variant="Variant.Filled">
                                        @GetClassificationBadgeText()
                                    </MudChip>
                                </div>
                                <MudGrid>
                                    <MudItem xs="12" md="6">
                                        <MudSelect T="int" 
                                                   Label="Applying Organisation / Employer" 
                                                   Required="true" 
                                                   RequiredError="Organisation is mandatory" 
                                                   @bind-Value="_grant.OrganisationId" 
                                                   ToStringFunc="@FormatOrganisationDisplay"
                                                   Variant="Variant.Outlined">
                                            @foreach (var org in _organisations)
                                            {
                                                <MudSelectItem Value="@org.Id">@org.CompanyName (@org.SdlNumber)</MudSelectItem>
                                            }
                                        </MudSelect>
                                        @if (_grant.OrganisationId > 0)
                                        {
                                            <div class="mt-1">
                                                <MudLink Href="@($"/employers/{_grant.OrganisationId}")" Typo="Typo.caption" Color="Color.Primary" Class="fw-semibold">
                                                    <MudIcon Icon="@Icons.Material.Filled.OpenInNew" Size="Size.Small" Class="mr-1" /> Open Employer 360° Hub
                                                </MudLink>
                                            </div>
                                        }
                                    </MudItem>
                                    <MudItem xs="12" md="6">
                                        <MudTextField T="string"
                                                      Label="Application Number"
                                                      Required="true"
                                                      RequiredError="Application Number is mandatory"
                                                      @bind-Value="_grant.ApplicationNumber"
                                                      Variant="Variant.Outlined" />
                                    </MudItem>
                                    <MudItem xs="12">
                                        <MudTextField T="string"
                                                      Label="Project Title / Initiative Name"
                                                      Required="true"
                                                      RequiredError="Project Title is mandatory"
                                                      @bind-Value="_grant.ProjectTitle"
                                                      Variant="Variant.Outlined"
                                                      Placeholder="e.g. Advanced CNC Machining & Robotics Apprenticeship Project" />
                                    </MudItem>
                                    <MudItem xs="12" md="6">
                                        <MudSelect T="string" Label="Discretionary Grant Type" @bind-Value="_grant.GrantTypeCode" Variant="Variant.Outlined">
                                            <MudSelectItem Value="@("HYBRID")">Hybrid (PIVOTAL &amp; Strategic Project)</MudSelectItem>
                                            <MudSelectItem Value="@("PIVOTAL")">PIVOTAL (Structured Qualifications)</MudSelectItem>
                                            <MudSelectItem Value="@("NON_PIVOTAL")">Non-PIVOTAL (Strategic Project)</MudSelectItem>
                                            @foreach (var gt in _grantTypes)
                                            {
                                                if (gt.Code != "HYBRID" && gt.Code != "PIVOTAL" && gt.Code != "NON_PIVOTAL")
                                                {
                                                    <MudSelectItem Value="@gt.Code">@gt.Name (@gt.Code)</MudSelectItem>
                                                }
                                            }
                                        </MudSelect>
                                    </MudItem>
                                    <MudItem xs="12" md="6">
                                        <ReadOnlyField Label="Application Status">
                                            <StatusBadge Status="@_grant.StatusCode" />
                                        </ReadOnlyField>
                                    </MudItem>
                                    <MudItem xs="12" md="6">
                                        <MudNumericField T="decimal"
                                                         Label="Requested Funding Amount (ZAR)"
                                                         Required="true"
                                                         @bind-Value="_grant.RequestedAmount"
                                                         Variant="Variant.Outlined"
                                                         Format="N2"
                                                         Min="0" />
                                    </MudItem>
                                    <MudItem xs="12" md="6">
                                        <MudNumericField T="decimal?"
                                                         Label="Approved Funding Allocation (ZAR)"
                                                         @bind-Value="_grant.ApprovedAmount"
                                                         Variant="Variant.Outlined"
                                                         Format="N2"
                                                         Min="0" />
                                    </MudItem>
                                    <MudItem xs="12" md="6">
                                        <MudDatePicker Label="Application Date" @bind-Date="_appDate" Variant="Variant.Outlined" DateFormat="yyyy-MM-dd" />
                                    </MudItem>
                                    <MudItem xs="12" md="6">
                                        <MudSelect T="int?"
                                                   Label="Strategic Priority / Focus Area Theme"
                                                   @bind-Value="_grant.StrategicPriorityId"
                                                   ToStringFunc="@FormatStrategicPriorityDisplay"
                                                   Variant="Variant.Outlined"
                                                   Clearable="true">
                                            <MudSelectItem Value="@((int?)null)">-- General Discretionary Grant / Strategic Theme Unassigned --</MudSelectItem>
                                            @foreach (var sp in _strategicPriorities)
                                            {
                                                <MudSelectItem Value="@((int?)sp.Id)">@sp.Code - @sp.Name (@sp.NsdpOutcomeCode)</MudSelectItem>
                                            }
                                        </MudSelect>
                                    </MudItem>
                                </MudGrid>
                            </MudCard>

                            <!-- Statutory WSP Compliance Card (SETA Grant Regulation 4(4)) -->
                            <MudCard Outlined="true" Class="pa-4 mb-4">
                                <div class="d-flex justify-space-between align-center mb-3 flex-wrap gap-2">
                                    <div class="d-flex align-center gap-2">
                                        <MudIcon Icon="@Icons.Material.Filled.Gavel" Color="Color.Primary" />
                                        <MudText Typo="Typo.h6" Class="fw-bold">Mandatory Grant (WSP/ATR) Compliance Status</MudText>
                                    </div>
                                    @if (_wspResult != null)
                                    {
                                        <MudChip T="string" Color="@(_wspResult.IsEligible ? (_wspResult.IsExempt ? Color.Info : Color.Success) : Color.Error)" Variant="Variant.Filled" Size="Size.Small">
                                            <MudIcon Icon="@(_wspResult.IsEligible ? Icons.Material.Filled.CheckCircle : Icons.Material.Filled.Warning)" Size="Size.Small" Class="mr-1" />
                                            @(_wspResult.IsExempt ? "Exempt from WSP" : (_wspResult.IsEligible ? "Compliant WSP Approved" : "Non-Compliant: WSP Not Approved"))
                                        </MudChip>
                                    }
                                </div>

                                @if (_wspResult != null)
                                {
                                    <MudAlert Severity="@(_wspResult.IsEligible ? (_wspResult.IsExempt ? Severity.Info : Severity.Success) : Severity.Warning)" Class="mb-3">
                                        <strong>@(_wspResult.IsExempt ? "Exemption Status:" : "Compliance Status:")</strong> @_wspResult.Reason
                                        @if (_wspResult.WspSubmissionId.HasValue)
                                        {
                                            <div class="mt-2">
                                                <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small" StartIcon="@Icons.Material.Filled.OpenInNew" Href="@($"/wsp/{_wspResult.WspSubmissionId.Value}")">
                                                    View Mandatory Grant WSP Submission (#@_wspResult.WspReferenceNumber)
                                                </MudButton>
                                            </div>
                                        }
                                    </MudAlert>
                                }

                                <MudGrid>
                                    <MudItem xs="12" md="6">
                                        <MudSwitch T="bool" @bind-Value="_grant.IsWspExempt" Color="Color.Warning" Label="Manual WSP Exemption (Non-Levy / TVET / NGO / Public Entity)" />
                                    </MudItem>
                                    @if (_grant.IsWspExempt)
                                    {
                                        <MudItem xs="12" md="6">
                                            <MudTextField T="string" Label="Exemption Justification / Legal Rationale" @bind-Value="_grant.WspExemptionReason" Variant="Variant.Outlined" Placeholder="e.g. Public TVET College (Exempt under SDA Section 28)" />
                                        </MudItem>
                                    }
                                    <MudItem xs="12">
                                        <MudButton Variant="Variant.Outlined" Color="Color.Default" Size="Size.Small" StartIcon="@Icons.Material.Filled.Refresh" OnClick="CheckWspCompliance">
                                            Re-evaluate WSP Eligibility
                                        </MudButton>
                                    </MudItem>
                                </MudGrid>
                            </MudCard>
                        </MudItem>

                        <!-- Right Column: Governance -->
                        <MudItem xs="12" lg="4">
                            <MudCard Outlined="true" Class="pa-4 mb-4">
                                <MudText Typo="Typo.h6" Class="fw-bold mb-3">Audit Trail &amp; Governance</MudText>
                                <div class="d-flex flex-column gap-2 text-muted">
                                    <div class="d-flex justify-space-between">
                                        <MudText Typo="Typo.caption">Grant Application ID:</MudText>
                                        <MudText Typo="Typo.caption" Class="fw-bold">@(Id > 0 ? Id.ToString() : "Draft")</MudText>
                                    </div>
                                    <div class="d-flex justify-space-between">
                                        <MudText Typo="Typo.caption">Application Classification:</MudText>
                                        <MudText Typo="Typo.caption" Class="fw-bold">@GetClassificationBadgeText()</MudText>
                                    </div>
                                    <div class="d-flex justify-space-between">
                                        <MudText Typo="Typo.caption">Created At:</MudText>
                                        <MudText Typo="Typo.caption">@(_grant.CreatedAt > DateTime.MinValue ? _grant.CreatedAt.ToString("yyyy-MM-dd HH:mm") : "-")</MudText>
                                    </div>
                                    <div class="d-flex justify-space-between">
                                        <MudText Typo="Typo.caption">Created By:</MudText>
                                        <MudText Typo="Typo.caption">@(!string.IsNullOrWhiteSpace(_grant.CreatedBy) ? _grant.CreatedBy : "-")</MudText>
                                    </div>
                                    <div class="d-flex justify-space-between">
                                        <MudText Typo="Typo.caption">Modified At:</MudText>
                                        <MudText Typo="Typo.caption">@(_grant.ModifiedAt.HasValue ? _grant.ModifiedAt.Value.ToString("yyyy-MM-dd HH:mm") : "-")</MudText>
                                    </div>
                                </div>
                            </MudCard>
                        </MudItem>
                    </MudGrid>
                </MudForm>
            </MudTabPanel>

            <!-- TAB 2: DG Funding Window -->
            <MudTabPanel Text="DG Funding Window" Icon="@Icons.Material.Filled.EventNote">
                <div class="pa-4">
                    <MudCard Outlined="true" Class="pa-4 mb-4">
                        <MudText Typo="Typo.h6" Class="fw-bold mb-3">Associated Discretionary Grant (DG) Funding Window</MudText>
                        <MudGrid>
                            <MudItem xs="12" md="8">
                                <MudSelect T="int?" 
                                           Label="Assigned DG Funding Window" 
                                           @bind-Value="_grant.FundingWindowId" 
                                           ToStringFunc="@FormatFundingWindowDisplay"
                                           Variant="Variant.Outlined" 
                                           Clearable="true">
                                    <MudSelectItem Value="@((int?)null)">-- No DG Window Assigned / Direct Submission --</MudSelectItem>
                                    @foreach (var fw in _fundingWindows)
                                    {
                                        <MudSelectItem Value="@((int?)fw.Id)">@fw.WindowName (FY @fw.FinYear - @fw.TotalAvailableBudget.ToString("C"))</MudSelectItem>
                                    }
                                </MudSelect>
                            </MudItem>
                            <MudItem xs="12" md="4" Class="d-flex align-center">
                                <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.EventNote" Href="/dg-funding-windows">
                                    Manage DG Windows
                                </MudButton>
                            </MudItem>
                        </MudGrid>

                        @if (_grant.FundingWindowId.HasValue)
                        {
                            var selectedWindow = _fundingWindows.FirstOrDefault(w => w.Id == _grant.FundingWindowId.Value);
                            if (selectedWindow != null)
                            {
                                <MudPaper Elevation="0" Class="pa-4 mt-4 mud-background-gray rounded">
                                    <div class="d-flex justify-space-between align-center mb-3">
                                        <MudText Typo="Typo.subtitle2" Class="fw-bold">Window Specification</MudText>
                                        <MudButton Variant="Variant.Text" Color="Color.Primary" Size="Size.Small" StartIcon="@Icons.Material.Filled.OpenInNew" Href="@($"/grants/windows/{selectedWindow.Id}")">
                                            View Window 360° Hub
                                        </MudButton>
                                    </div>
                                    <MudGrid>
                                        <MudItem xs="12" md="4">
                                            <MudText Typo="Typo.caption" Class="text-muted">Window Name:</MudText>
                                            <MudText Typo="Typo.body2" Class="fw-bold">@selectedWindow.WindowName</MudText>
                                        </MudItem>
                                        <MudItem xs="12" md="2">
                                            <MudText Typo="Typo.caption" Class="text-muted">Financial Year:</MudText>
                                            <MudText Typo="Typo.body2">@selectedWindow.FinYear</MudText>
                                        </MudItem>
                                        <MudItem xs="12" md="3">
                                            <MudText Typo="Typo.caption" Class="text-muted">Window Dates:</MudText>
                                            <MudText Typo="Typo.body2">@selectedWindow.OpeningDate.ToString("yyyy-MM-dd") to @selectedWindow.ClosingDate.ToString("yyyy-MM-dd")</MudText>
                                        </MudItem>
                                        <MudItem xs="12" md="3">
                                            <MudText Typo="Typo.caption" Class="text-muted">Total Available Budget Envelope:</MudText>
                                            <MudText Typo="Typo.body2" Class="fw-bold text-success">@selectedWindow.TotalAvailableBudget.ToString("C")</MudText>
                                        </MudItem>
                                    </MudGrid>
                                </MudPaper>
                            }
                        }
                    </MudCard>
                </div>
            </MudTabPanel>

            <!-- TAB 3: PIVOTAL Training Plan -->
            @if (_grant.HasPivotalInterventions || _grant.Interventions.Any(i => i.IsPivotal) || _grant.GrantTypeCode == "PIVOTAL" || _grant.GrantTypeCode == "HYBRID")
            {
                <MudTabPanel Text="PIVOTAL Training Plan" Icon="@Icons.Material.Filled.School">
                    <div class="pa-4">
                        <div class="d-flex flex-wrap justify-space-between align-center mb-4 gap-3">
                            <div>
                                <MudText Typo="Typo.h6">PIVOTAL Structured Training Plan Table</MudText>
                                <MudText Typo="Typo.caption" Color="Color.Secondary">
                                    Accredited qualifications, learnerships, apprenticeships, skills programmes, and planned 18.1/18.2 cohorts
                                </MudText>
                            </div>
                            @if (Id > 0 && _isEditMode)
                            {
                                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="OpenAddPivotalForm">
                                    Add Training Intervention
                                </MudButton>
                            }
                        </div>

                        @if (_showAddPivotalForm && _isEditMode)
                        {
                            <MudCard Outlined="true" Class="pa-4 mb-4 border-primary" Elevation="3">
                                <MudText Typo="Typo.subtitle1" Class="font-weight-bold mb-3">Add PIVOTAL Training Line Item</MudText>
                                <MudGrid Spacing="2">
                                    <MudItem xs="12" md="4">
                                        <MudSelect T="string" Label="Intervention Type" Required="true" @bind-Value="_newPivotal.InterventionTypeCode" Variant="Variant.Outlined">
                                            <MudSelectItem Value="@("APPRENTICESHIP")">Artisan Apprenticeship</MudSelectItem>
                                            <MudSelectItem Value="@("LEARNERSHIP")">Learnership Programme</MudSelectItem>
                                            <MudSelectItem Value="@("BURSARY")">Bursary (Higher Education / TVET)</MudSelectItem>
                                            <MudSelectItem Value="@("SKILLS_PROGRAMME")">Accredited Skills Programme</MudSelectItem>
                                            <MudSelectItem Value="@("INTERNSHIP")">Workplace Graduate Internship</MudSelectItem>
                                        </MudSelect>
                                    </MudItem>
                                    <MudItem xs="12" md="5">
                                        <MudTextField T="string" Label="Qualification / Programme Title" Required="true" @bind-Value="_newPivotal.QualificationTitle" Variant="Variant.Outlined" />
                                    </MudItem>
                                    <MudItem xs="12" md="3">
                                        <MudTextField T="string" Label="SAQA ID" @bind-Value="_newPivotal.SaqaId" Variant="Variant.Outlined" Class="font-mono" />
                                    </MudItem>
                                    <MudItem xs="12" md="3">
                                        <MudSelect T="string" Label="NQF Level" @bind-Value="_newPivotal.NqfLevel" Variant="Variant.Outlined">
                                            <MudSelectItem Value="@("NQF Level 2")">NQF Level 2</MudSelectItem>
                                            <MudSelectItem Value="@("NQF Level 3")">NQF Level 3</MudSelectItem>
                                            <MudSelectItem Value="@("NQF Level 4")">NQF Level 4</MudSelectItem>
                                            <MudSelectItem Value="@("NQF Level 5")">NQF Level 5</MudSelectItem>
                                            <MudSelectItem Value="@("NQF Level 6")">NQF Level 6</MudSelectItem>
                                            <MudSelectItem Value="@("NQF Level 7")">NQF Level 7</MudSelectItem>
                                        </MudSelect>
                                    </MudItem>
                                    <MudItem xs="12" md="3">
                                        <MudTextField T="string" Label="OFO Code" @bind-Value="_newPivotal.OfoCode" Variant="Variant.Outlined" Class="font-mono" />
                                    </MudItem>
                                    <MudItem xs="6" md="2">
                                        <MudNumericField T="int" Label="Employed (18.1)" @bind-Value="_newPivotal.LearnerCountEmployed" Variant="Variant.Outlined" Min="0" />
                                    </MudItem>
                                    <MudItem xs="6" md="2">
                                        <MudNumericField T="int" Label="Unemployed (18.2)" @bind-Value="_newPivotal.LearnerCountUnemployed" Variant="Variant.Outlined" Min="0" />
                                    </MudItem>
                                    <MudItem xs="12" md="2">
                                        <MudNumericField T="decimal" Label="Unit Cost (ZAR)" Required="true" @bind-Value="_newPivotal.UnitCost" Variant="Variant.Outlined" Format="N2" Min="0" />
                                    </MudItem>
                                    <MudItem xs="12" Class="d-flex justify-end gap-2 mt-2">
                                        <MudButton Variant="Variant.Outlined" Color="Color.Secondary" Size="Size.Small" OnClick="() => _showAddPivotalForm = false">Cancel</MudButton>
                                        <MudButton Variant="Variant.Filled" Color="Color.Success" Size="Size.Small" StartIcon="@Icons.Material.Filled.Save" OnClick="SavePivotalLine">Save Training Line</MudButton>
                                    </MudItem>
                                </MudGrid>
                            </MudCard>
                        }

                        <MudTable Items="@(_grant.Interventions.Where(i => i.IsPivotal))" Dense="true" Striped="true" Hover="true" Class="mb-4">
                            <HeaderContent>
                                <MudTh>Intervention Type</MudTh>
                                <MudTh>Qualification Title</MudTh>
                                <MudTh>SAQA / NQF</MudTh>
                                <MudTh>OFO Code</MudTh>
                                <MudTh>18.1</MudTh>
                                <MudTh>18.2</MudTh>
                                <MudTh>Total Headcount</MudTh>
                                <MudTh>Unit Cost</MudTh>
                                <MudTh>Total Funding</MudTh>
                                @if (_isEditMode)
                                {
                                    <MudTh Style="text-align:right">Action</MudTh>
                                }
                            </HeaderContent>
                            <RowTemplate>
                                <MudTd DataLabel="Type">
                                    <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Outlined">@context.InterventionTypeCode</MudChip>
                                </MudTd>
                                <MudTd DataLabel="Qualification"><strong>@context.QualificationTitle</strong></MudTd>
                                <MudTd DataLabel="SAQA/NQF">
                                    <span class="font-mono">@(context.SaqaId ?? "-")</span> / @(context.NqfLevel ?? "-")
                                </MudTd>
                                <MudTd DataLabel="OFO" Class="font-mono">@(context.OfoCode ?? "-")</MudTd>
                                <MudTd DataLabel="18.1">@context.LearnerCountEmployed</MudTd>
                                <MudTd DataLabel="18.2">@context.LearnerCountUnemployed</MudTd>
                                <MudTd DataLabel="Total Headcount"><strong class="text-primary">@context.TotalLearnerCount</strong></MudTd>
                                <MudTd DataLabel="Unit Cost">@context.UnitCost.ToString("C0")</MudTd>
                                <MudTd DataLabel="Total Funding">
                                    <strong class="text-success">@((context.TotalAmount > 0 ? context.TotalAmount : context.UnitCost * context.TotalLearnerCount).ToString("C"))</strong>
                                </MudTd>
                                @if (_isEditMode)
                                {
                                    <MudTd Style="text-align:right" DataLabel="Action">
                                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small" OnClick="@(() => RemoveInterventionLine(context.Id))" />
                                    </MudTd>
                                }
                            </RowTemplate>
                            <NoRecordsContent>
                                <div class="pa-4 text-center">
                                    <MudText Typo="Typo.body2" Color="Color.Secondary">No PIVOTAL training interventions registered.</MudText>
                                </div>
                            </NoRecordsContent>
                        </MudTable>

                        <!-- PIVOTAL Summary Card -->
                        <MudCard Outlined="true" Class="pa-4">
                            <div class="d-flex flex-wrap justify-space-between align-center gap-4">
                                <div>
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">Total Employed (18.1):</MudText>
                                    <MudText Typo="Typo.h6" Class="fw-bold">@(_grant.Interventions.Where(i => i.IsPivotal).Sum(i => i.LearnerCountEmployed))</MudText>
                                </div>
                                <div>
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">Total Unemployed (18.2):</MudText>
                                    <MudText Typo="Typo.h6" Class="fw-bold">@(_grant.Interventions.Where(i => i.IsPivotal).Sum(i => i.LearnerCountUnemployed))</MudText>
                                </div>
                                <div>
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">Total PIVOTAL Headcount:</MudText>
                                    <MudText Typo="Typo.h6" Class="fw-bold text-primary">@(_grant.Interventions.Where(i => i.IsPivotal).Sum(i => i.TotalLearnerCount)) Candidates</MudText>
                                </div>
                                <div>
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">PIVOTAL Training Plan Subtotal:</MudText>
                                    <MudText Typo="Typo.h6" Class="fw-bold text-success">@(_grant.Interventions.Where(i => i.IsPivotal).Sum(i => i.TotalAmount > 0 ? i.TotalAmount : i.UnitCost * i.TotalLearnerCount).ToString("C"))</MudText>
                                </div>
                            </div>
                        </MudCard>
                    </div>
                </MudTabPanel>
            }

            <!-- TAB 4: Strategic Project Motivation -->
            @if (_grant.HasNonPivotalInterventions || _grant.Interventions.Any(i => !i.IsPivotal) || _grant.GrantTypeCode == "NON_PIVOTAL" || _grant.GrantTypeCode == "HYBRID")
            {
                <MudTabPanel Text="Strategic Project Motivation" Icon="@Icons.Material.Filled.Lightbulb">
                    <div class="pa-4">
                        <MudText Typo="Typo.h6" Class="fw-bold mb-1">Non-PIVOTAL Strategic Project Motivation Narrative</MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-4 d-block">
                            Statutory project motivation in terms of merSETA Discretionary Grant Policy (5 core narrative dimensions)
                        </MudText>

                        <MudGrid Spacing="3">
                            <MudItem xs="12">
                                <MudTextField T="string"
                                              Label="1. Project Description (Comprehensive Summary &amp; Background)"
                                              @bind-Value="_grant.ProjectDescription"
                                              ReadOnly="@(!_isEditMode)"
                                              Variant="Variant.Outlined"
                                              Lines="4"
                                              Placeholder="Provide narrative background, contextual industry problem, and proposed initiative..." />
                            </MudItem>
                            <MudItem xs="12">
                                <MudTextField T="string"
                                              Label="2. Purpose (What specific interventions and activities do you want to implement?)"
                                              @bind-Value="_grant.Purpose"
                                              ReadOnly="@(!_isEditMode)"
                                              Variant="Variant.Outlined"
                                              Lines="3"
                                              Placeholder="Define operational purpose and scope..." />
                            </MudItem>
                            <MudItem xs="12">
                                <MudTextField T="string"
                                              Label="3. Outcomes (What specific outputs and measurable impacts will be achieved?)"
                                              @bind-Value="_grant.Outcomes"
                                              ReadOnly="@(!_isEditMode)"
                                              Variant="Variant.Outlined"
                                              Lines="3"
                                              Placeholder="Outline target outputs, qualifications, or infrastructure capability..." />
                            </MudItem>
                            <MudItem xs="12">
                                <MudTextField T="string"
                                              Label="4. Benefits (Who are the target beneficiaries and what is the socio-economic impact?)"
                                              @bind-Value="_grant.Benefits"
                                              ReadOnly="@(!_isEditMode)"
                                              Variant="Variant.Outlined"
                                              Lines="3"
                                              Placeholder="Describe beneficiary cohort profile and industry advantages..." />
                            </MudItem>
                            <MudItem xs="12">
                                <MudTextField T="string"
                                              Label="5. Potential Risks &amp; Mitigation Strategy (Operational, financial, and regulatory risks)"
                                              @bind-Value="_grant.PotentialRisks"
                                              ReadOnly="@(!_isEditMode)"
                                              Variant="Variant.Outlined"
                                              Lines="3"
                                              Placeholder="Itemize key implementation risks and proactive control actions..." />
                            </MudItem>
                            
                            <MudItem xs="12" md="4">
                                <MudNumericField T="int"
                                                 Label="Target Project Beneficiaries"
                                                 @bind-Value="_grant.NumberOfBeneficiaries"
                                                 ReadOnly="@(!_isEditMode)"
                                                 Variant="Variant.Outlined"
                                                 Min="0" />
                            </MudItem>
                            <MudItem xs="12" md="4">
                                <MudNumericField T="decimal"
                                                 Label="Estimated Overall Project Cost (ZAR)"
                                                 @bind-Value="_grant.EstimatedOverallProjectCost"
                                                 ReadOnly="@(!_isEditMode)"
                                                 Variant="Variant.Outlined"
                                                 Format="N2"
                                                 Min="0" />
                            </MudItem>
                            <MudItem xs="12" md="4">
                                <div class="d-flex flex-column pt-2">
                                    <MudSwitch T="bool"
                                               Label="Project Administration Costs Included (7.5%)"
                                               @bind-Value="_grant.RequireProjectAdministrationCosts"
                                               Disabled="@(!_isEditMode)"
                                               Color="Color.Primary" />
                                    @if (_grant.RequireProjectAdministrationCosts)
                                    {
                                        var adminFee = Math.Round(_grant.Interventions.Where(i => !i.IsPivotal).Sum(d => d.TotalAmount > 0 ? d.TotalAmount : d.EstimatedCost) * 0.075m, 2);
                                        <MudText Typo="Typo.caption" Color="Color.Primary" Class="fw-semibold">
                                            Calculated Admin Fee: @adminFee.ToString("C")
                                        </MudText>
                                    }
                                </div>
                            </MudItem>
                            <MudItem xs="12">
                                <MudTextField T="string"
                                              Label="Target Provinces / Implementation Footprint"
                                              @bind-Value="_grant.TargetProvinces"
                                              ReadOnly="@(!_isEditMode)"
                                              Variant="Variant.Outlined"
                                              Placeholder="e.g. Gauteng, KwaZulu-Natal, Eastern Cape" />
                            </MudItem>
                        </MudGrid>
                    </div>
                </MudTabPanel>
            }

            <!-- TAB 5: Deliverables & Implementation Plan -->
            @if (_grant.HasNonPivotalInterventions || _grant.Interventions.Any(i => !i.IsPivotal) || _grant.GrantTypeCode == "NON_PIVOTAL" || _grant.GrantTypeCode == "HYBRID")
            {
                <MudTabPanel Text="Deliverables &amp; Tranches" Icon="@Icons.Material.Filled.PlaylistAddCheck">
                    <div class="pa-4">
                        <div class="d-flex flex-wrap justify-space-between align-center mb-4 gap-3">
                            <div>
                                <MudText Typo="Typo.h6">Project Deliverables &amp; Milestone Tranches</MudText>
                                <MudText Typo="Typo.caption" Color="Color.Secondary">
                                    Tangible milestone outputs, workshop infrastructure, equipment commissioning, and disbursement tranches
                                </MudText>
                            </div>
                            @if (Id > 0 && _isEditMode)
                            {
                                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="OpenAddDeliverableForm">
                                    Add Deliverable Milestone
                                </MudButton>
                            }
                        </div>

                        @if (_showAddDeliverableForm && _isEditMode)
                        {
                            <MudCard Outlined="true" Class="pa-4 mb-4 border-primary" Elevation="3">
                                <MudText Typo="Typo.subtitle1" Class="font-weight-bold mb-3">Add Project Deliverable Milestone</MudText>
                                <MudGrid Spacing="2">
                                    <MudItem xs="12" md="4">
                                        <MudSelect T="string" Label="Intervention Category" Required="true" @bind-Value="_newDeliverable.InterventionTypeCode" Variant="Variant.Outlined">
                                            <MudSelectItem Value="@("INFRA_WORKSHOP")">TVET Workshop Tooling Equipment</MudSelectItem>
                                            <MudSelectItem Value="@("BURSARY_NON_CREDIT")">Special Non-Credit Bursary Support</MudSelectItem>
                                            <MudSelectItem Value="@("CAREER_GUIDANCE")">Career Guidance &amp; Rural Outreach</MudSelectItem>
                                            <MudSelectItem Value="@("RESEARCH_CHAIR")">University Research Chair Support</MudSelectItem>
                                            <MudSelectItem Value="@("SPECIAL_PROJECT")">Strategic Industry Transformation Project</MudSelectItem>
                                        </MudSelect>
                                    </MudItem>
                                    <MudItem xs="12" md="5">
                                        <MudTextField T="string" Label="Deliverable Name / Description" Required="true" @bind-Value="_newDeliverable.DeliverableName" Variant="Variant.Outlined" />
                                    </MudItem>
                                    <MudItem xs="6" md="3">
                                        <MudNumericField T="int?" Label="Target Units / Sites" @bind-Value="_newDeliverable.TargetQuantity" Variant="Variant.Outlined" Min="1" />
                                    </MudItem>
                                    <MudItem xs="6" md="3">
                                        <MudDatePicker Label="Projected Start Date" @bind-Date="_delivStartDate" Variant="Variant.Outlined" DateFormat="yyyy-MM-dd" />
                                    </MudItem>
                                    <MudItem xs="6" md="3">
                                        <MudDatePicker Label="Projected End Date" @bind-Date="_delivEndDate" Variant="Variant.Outlined" DateFormat="yyyy-MM-dd" />
                                    </MudItem>
                                    <MudItem xs="6" md="3">
                                        <MudNumericField T="int?" Label="Milestone Sequence #" @bind-Value="_newDeliverable.MilestoneNumber" Variant="Variant.Outlined" Min="1" Max="10" />
                                    </MudItem>
                                    <MudItem xs="6" md="3">
                                        <MudNumericField T="decimal" Label="Milestone Amount (ZAR)" Required="true" @bind-Value="_newDeliverable.EstimatedCost" Variant="Variant.Outlined" Format="N2" Min="0" />
                                    </MudItem>
                                    <MudItem xs="12">
                                        <MudTextField T="string" Label="Implementation &amp; Compliance Notes" @bind-Value="_newDeliverable.Comments" Variant="Variant.Outlined" />
                                    </MudItem>
                                    <MudItem xs="12" Class="d-flex justify-end gap-2 mt-2">
                                        <MudButton Variant="Variant.Outlined" Color="Color.Secondary" Size="Size.Small" OnClick="() => _showAddDeliverableForm = false">Cancel</MudButton>
                                        <MudButton Variant="Variant.Filled" Color="Color.Success" Size="Size.Small" StartIcon="@Icons.Material.Filled.Save" OnClick="SaveDeliverableLine">Save Milestone</MudButton>
                                    </MudItem>
                                </MudGrid>
                            </MudCard>
                        }

                        <MudTable Items="@(_grant.Interventions.Where(i => !i.IsPivotal))" Dense="true" Striped="true" Hover="true" Class="mb-4">
                            <HeaderContent>
                                <MudTh>#</MudTh>
                                <MudTh>Intervention Category</MudTh>
                                <MudTh>Deliverable Name</MudTh>
                                <MudTh>Units</MudTh>
                                <MudTh>Projected Timeline</MudTh>
                                <MudTh>Milestone Amount</MudTh>
                                <MudTh>Delivery Notes</MudTh>
                                @if (_isEditMode)
                                {
                                    <MudTh Style="text-align:right">Action</MudTh>
                                }
                            </HeaderContent>
                            <RowTemplate>
                                <MudTd DataLabel="#">@(context.MilestoneNumber?.ToString() ?? "-")</MudTd>
                                <MudTd DataLabel="Category">
                                    <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Outlined">@context.InterventionTypeCode</MudChip>
                                </MudTd>
                                <MudTd DataLabel="Deliverable"><strong>@context.DeliverableName</strong></MudTd>
                                <MudTd DataLabel="Units">@(context.TargetQuantity?.ToString() ?? "1")</MudTd>
                                <MudTd DataLabel="Timeline">
                                    @(context.ProjectedStartDate?.ToString("yyyy-MM-dd") ?? "-") to @(context.ProjectedEndDate?.ToString("yyyy-MM-dd") ?? "-")
                                </MudTd>
                                <MudTd DataLabel="Amount">
                                    <strong class="text-success">@((context.TotalAmount > 0 ? context.TotalAmount : context.EstimatedCost).ToString("C"))</strong>
                                </MudTd>
                                <MudTd DataLabel="Notes">@(!string.IsNullOrWhiteSpace(context.Comments) ? context.Comments : "-")</MudTd>
                                @if (_isEditMode)
                                {
                                    <MudTd Style="text-align:right" DataLabel="Action">
                                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small" OnClick="@(() => RemoveInterventionLine(context.Id))" />
                                    </MudTd>
                                }
                            </RowTemplate>
                            <NoRecordsContent>
                                <div class="pa-4 text-center">
                                    <MudText Typo="Typo.body2" Color="Color.Secondary">No project milestone deliverables registered.</MudText>
                                </div>
                            </NoRecordsContent>
                        </MudTable>

                        <!-- Deliverables Summary Card -->
                        <MudCard Outlined="true" Class="pa-4">
                            <div class="d-flex flex-wrap justify-space-between align-center gap-4">
                                <div>
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">Total Milestone Deliverables:</MudText>
                                    <MudText Typo="Typo.h6" Class="fw-bold">@(_grant.Interventions.Count(i => !i.IsPivotal)) Items</MudText>
                                </div>
                                <div>
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">Deliverables Subtotal:</MudText>
                                    <MudText Typo="Typo.h6" Class="fw-bold text-primary">
                                        @(_grant.Interventions.Where(i => !i.IsPivotal).Sum(i => i.TotalAmount > 0 ? i.TotalAmount : i.EstimatedCost).ToString("C"))
                                    </MudText>
                                </div>
                                <div>
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">Project Admin Fee (7.5%):</MudText>
                                    <MudText Typo="Typo.h6" Class="fw-bold text-warning">
                                        @((_grant.RequireProjectAdministrationCosts ? Math.Round(_grant.Interventions.Where(i => !i.IsPivotal).Sum(i => i.TotalAmount > 0 ? i.TotalAmount : i.EstimatedCost) * 0.075m, 2) : 0m).ToString("C"))
                                    </MudText>
                                </div>
                                <div>
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">Total Deliverables &amp; Admin:</MudText>
                                    <MudText Typo="Typo.h6" Class="fw-bold text-success">
                                        @((_grant.Interventions.Where(i => !i.IsPivotal).Sum(i => i.TotalAmount > 0 ? i.TotalAmount : i.EstimatedCost) + (_grant.RequireProjectAdministrationCosts ? Math.Round(_grant.Interventions.Where(i => !i.IsPivotal).Sum(i => i.TotalAmount > 0 ? i.TotalAmount : i.EstimatedCost) * 0.075m, 2) : 0m)).ToString("C"))
                                    </MudText>
                                </div>
                            </div>
                        </MudCard>
                    </div>
                </MudTabPanel>
            }

            <!-- TAB 6: Project Budget -->
            <MudTabPanel Text="Project Budget" Icon="@Icons.Material.Filled.AttachMoney">
                <div class="pa-4">
                    <div class="d-flex flex-wrap justify-space-between align-center mb-4 gap-3">
                        <div>
                            <MudText Typo="Typo.h6">Project Cost Breakdown &amp; Line-Item Budget</MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">Itemized project expenditures, stipends, tuition, equipment, and administrative costs</MudText>
                        </div>
                        @if (Id > 0)
                        {
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="OpenAddBudgetForm" aria-label="Add Budget Line">
                                Add Budget Line
                            </MudButton>
                        }
                        else
                        {
                            <MudAlert Severity="Severity.Info" Dense="true">Save the grant application first to enter budget line items.</MudAlert>
                        }
                    </div>

                    @if (_showAddBudgetForm)
                    {
                        <MudCard Class="pa-4 mb-4 border-primary" Elevation="3">
                            <MudText Typo="Typo.subtitle1" Class="font-weight-bold mb-3">Add Budget Line Item</MudText>
                            <MudGrid>
                                <MudItem xs="12" md="4">
                                    <MudSelect T="string" Label="Expense Category" Required="true" @bind-Value="_newBudget.ExpenseCategory" Variant="Variant.Outlined">
                                        <MudSelectItem Value="@("Learner Allowances / Stipends")">Learner Allowances / Stipends</MudSelectItem>
                                        <MudSelectItem Value="@("Tuition / Institutional Fees")">Tuition / Institutional Fees</MudSelectItem>
                                        <MudSelectItem Value="@("Training Material & Consumables")">Training Material &amp; Consumables</MudSelectItem>
                                        <MudSelectItem Value="@("PPE & Toolkits")">PPE &amp; Toolkits</MudSelectItem>
                                        <MudSelectItem Value="@("Assessor / Moderator Fees")">Assessor / Moderator Fees</MudSelectItem>
                                        <MudSelectItem Value="@("Project Administration")">Project Administration</MudSelectItem>
                                    </MudSelect>
                                </MudItem>
                                <MudItem xs="12" md="8">
                                    <MudTextField T="string" Label="Line Item Description" @bind-Value="_newBudget.Description" Variant="Variant.Outlined" Placeholder="e.g. Monthly stipend for 20 welding apprentices over 12 months" />
                                </MudItem>
                                <MudItem xs="12" md="4">
                                    <MudNumericField T="decimal" Label="Unit Cost (ZAR)" Required="true" @bind-Value="_newBudget.UnitCost" Variant="Variant.Outlined" Format="N2" Min="0" />
                                </MudItem>
                                <MudItem xs="12" md="4">
                                    <MudNumericField T="int" Label="Quantity / Units" Required="true" @bind-Value="_newBudget.Quantity" Variant="Variant.Outlined" Min="1" />
                                </MudItem>
                                <MudItem xs="12" md="4">
                                    <MudTextField T="string" Label="Total Line Cost" ReadOnly="true" Value="@((_newBudget.UnitCost * _newBudget.Quantity).ToString("C"))" Variant="Variant.Outlined" />
                                </MudItem>
                                <MudItem xs="12" Class="d-flex justify-end gap-2">
                                    <MudButton Variant="Variant.Outlined" Color="Color.Secondary" Size="Size.Small" OnClick="CancelAddBudgetForm">Cancel</MudButton>
                                    <MudButton Variant="Variant.Filled" Color="Color.Success" Size="Size.Small" StartIcon="@Icons.Material.Filled.Save" OnClick="SaveBudgetLine">Save Budget Item</MudButton>
                                </MudItem>
                            </MudGrid>
                        </MudCard>
                    }

                    <MudTable Items="_budgets" Hover="true" Dense="true" Striped="true" Class="mb-4">
                        <HeaderContent>
                            <MudTh>Expense Category</MudTh>
                            <MudTh>Description</MudTh>
                            <MudTh>Unit Cost</MudTh>
                            <MudTh>Quantity</MudTh>
                            <MudTh>Total Cost</MudTh>
                            <MudTh Style="text-align:right">Actions</MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd DataLabel="Expense Category">
                                <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Outlined">@context.ExpenseCategory</MudChip>
                            </MudTd>
                            <MudTd DataLabel="Description">@(!string.IsNullOrWhiteSpace(context.Description) ? context.Description : "-")</MudTd>
                            <MudTd DataLabel="Unit Cost">@context.UnitCost.ToString("C")</MudTd>
                            <MudTd DataLabel="Quantity">@context.Quantity</MudTd>
                            <MudTd DataLabel="Total Cost">
                                <MudText Typo="Typo.body2" Class="fw-bold text-success">@context.TotalCost.ToString("C")</MudText>
                            </MudTd>
                            <MudTd Style="text-align:right" DataLabel="Actions">
                                <MudTooltip Text="Remove Budget Item">
                                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small" OnClick="@(() => RemoveBudgetLine(context.Id))" aria-label="Remove Budget Item" />
                                </MudTooltip>
                            </MudTd>
                        </RowTemplate>
                        <NoRecordsContent>
                            <div class="pa-4 text-center">
                                <MudText Typo="Typo.body2" Color="Color.Secondary">No budget line items registered yet.</MudText>
                            </div>
                        </NoRecordsContent>
                    </MudTable>

                    <!-- Budget Reconciliation Summary Card -->
                    <MudCard Outlined="true" Class="pa-4">
                        <div class="d-flex flex-wrap justify-space-between align-center gap-4">
                            <div>
                                <MudText Typo="Typo.subtitle2" Class="text-muted">Total Line-Items Cost:</MudText>
                                <MudText Typo="Typo.h6" Class="fw-bold">@(_budgets.Sum(b => b.TotalCost).ToString("C"))</MudText>
                            </div>
                            <div>
                                <MudText Typo="Typo.subtitle2" Class="text-muted">Total Application Requested Amount:</MudText>
                                <MudText Typo="Typo.h6" Class="fw-bold text-primary">@_grant.RequestedAmount.ToString("C")</MudText>
                            </div>
                            <div>
                                <MudText Typo="Typo.subtitle2" Class="text-muted">Approved Allocation:</MudText>
                                <MudText Typo="Typo.h6" Class="fw-bold text-success">@(_grant.ApprovedAmount.HasValue ? _grant.ApprovedAmount.Value.ToString("C") : "Pending")</MudText>
                            </div>
                        </div>
                    </MudCard>
                </div>
            </MudTabPanel>

            <!-- TAB 7: Contracting MoA & Tranches -->
            <MudTabPanel Text="Contracting MoA" Icon="@Icons.Material.Filled.Handshake" Disabled="Id == 0">
                <div class="pa-4">
                    @if (_linkedMoa != null)
                    {
                        <MudCard Outlined="true" Class="pa-6 border-success mb-4" Style="border: 2px solid var(--mud-palette-success);">
                            <div class="d-flex justify-space-between align-center mb-4 flex-wrap gap-3">
                                <div>
                                    <div class="d-flex align-center gap-2">
                                        <MudIcon Icon="@Icons.Material.Filled.Verified" Color="Color.Success" Size="Size.Medium" />
                                        <MudText Typo="Typo.h6" Class="fw-bold text-success">Active Memorandum of Agreement (MoA)</MudText>
                                    </div>
                                    <MudText Typo="Typo.subtitle1" Class="fw-bold">MoA Contract Ref: @_linkedMoa.MoaNumber</MudText>
                                </div>
                                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.OpenInNew" Href="@($"/finance/grants/{_linkedMoa.Id}")">
                                    Open MoA 360° Hub
                                </MudButton>
                            </div>
                            <MudGrid>
                                <MudItem xs="12" md="3">
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">Total Contract Value</MudText>
                                    <MudText Typo="Typo.body1" Class="fw-bold text-primary">@_linkedMoa.TotalContractValue.ToString("C")</MudText>
                                </MudItem>
                                <MudItem xs="12" md="3">
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">Contract Duration</MudText>
                                    <MudText Typo="Typo.body1">@_linkedMoa.ContractStartDate.ToString("yyyy-MM-dd") to @_linkedMoa.ContractEndDate.ToString("yyyy-MM-dd")</MudText>
                                </MudItem>
                                <MudItem xs="12" md="3">
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">Employer Signoff</MudText>
                                    <MudText Typo="Typo.body1">@(_linkedMoa.SignoffDateEmployer?.ToString("yyyy-MM-dd") ?? "Pending")</MudText>
                                </MudItem>
                                <MudItem xs="12" md="3">
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">MerSETA Signoff</MudText>
                                    <MudText Typo="Typo.body1">@(_linkedMoa.SignoffDateSeta?.ToString("yyyy-MM-dd") ?? "Pending")</MudText>
                                </MudItem>
                            </MudGrid>

                            @if (_linkedMoa.Milestones != null && _linkedMoa.Milestones.Any())
                            {
                                <MudDivider Class="my-4" />
                                <MudText Typo="Typo.subtitle2" Class="fw-bold mb-2">Contract Milestones &amp; Payment Tranches</MudText>
                                <MudTable Items="@_linkedMoa.Milestones" Dense="true" Hover="true" Elevation="0">
                                    <HeaderContent>
                                        <MudTh>#</MudTh>
                                        <MudTh>Milestone Title</MudTh>
                                        <MudTh>Deliverable Requirement</MudTh>
                                        <MudTh>Tranche %</MudTh>
                                        <MudTh>Amount (ZAR)</MudTh>
                                        <MudTh>Status</MudTh>
                                    </HeaderContent>
                                    <RowTemplate>
                                        <MudTd>@context.MilestoneNumber</MudTd>
                                        <MudTd><strong>@context.MilestoneTitle</strong></MudTd>
                                        <MudTd>@context.DeliverableRequirement</MudTd>
                                        <MudTd>@context.TranchePercentage.ToString("F0")%</MudTd>
                                        <MudTd Class="fw-bold text-primary">@context.TrancheAmount.ToString("C")</MudTd>
                                        <MudTd>
                                            <MudChip T="string" Size="Size.Small" Color="Color.Info" Variant="Variant.Outlined">@context.MilestoneStatusCode</MudChip>
                                        </MudTd>
                                    </RowTemplate>
                                </MudTable>
                            }
                        </MudCard>
                    }
                    else
                    {
                        <MudCard Outlined="true" Class="pa-6 text-center">
                            <MudIcon Icon="@Icons.Material.Filled.Handshake" Size="Size.Large" Color="Color.Primary" Class="mb-3" />
                            <MudText Typo="Typo.h6" Class="fw-bold mb-2">No MoA Contract Generated Yet</MudText>
                            <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4">
                                Once the Discretionary Grant is approved, you can generate the bilateral Memorandum of Agreement (MoA) contract with pre-configured milestone payment tranches and deliverable requirements.
                            </MudText>
                            <MudButton Variant="Variant.Filled" 
                                       Color="Color.Primary" 
                                       Size="Size.Large" 
                                       StartIcon="@Icons.Material.Filled.Handshake" 
                                       OnClick="GenerateMoa"
                                       Disabled="_isGeneratingMoa">
                                @(_isGeneratingMoa ? "Generating MoA Agreement..." : "Generate Bilateral MoA Agreement (1-Click)")
                            </MudButton>
                        </MudCard>
                    }
                </div>
            </MudTabPanel>

            <!-- TAB 8: Evidence Vault -->
            @if (Id > 0)
            {
                <MudTabPanel Text="Evidence Vault" Icon="@Icons.Material.Filled.FolderZip">
                    <DocumentVault TargetEntityName="GrantApplication" TargetEntityId="@Id" />
                </MudTabPanel>

                <!-- TAB 9: Workflow History -->
                <MudTabPanel Text="Workflow History" Icon="@Icons.Material.Filled.History">
                    <WorkflowTimeline ProcessCode="DG" EntityId="@Id" />
                </MudTabPanel>
            }
        </MudTabs>
    }
</MudContainer>

@code {
    [Parameter] public int Id { get; set; }

    private GrantApplication _grant = new();
    private GrantMoa? _linkedMoa;
    private WspEligibilityResult? _wspResult;
    private MudForm? _form;
    private bool _isValid;
    private bool _loading = true;
    private bool _isSaving = false;
    private bool _isGeneratingMoa = false;
    private int _activeTabIndex = 0;

    private List<Organisation> _organisations = new();
    private List<LookupItemDto> _grantTypes = new();
    private List<GrantFundingWindow> _fundingWindows = new();
    private List<StrategicPriority> _strategicPriorities = new();
    private List<GrantProjectBudget> _budgets = new();

    private DateTime? _appDate;

    // Budget form
    private bool _showAddBudgetForm = false;
    private GrantProjectBudget _newBudget = new();

    // PIVOTAL intervention inline form
    private bool _showAddPivotalForm = false;
    private GrantApplicationIntervention _newPivotal = new() { IsPivotal = true, UnitCost = 50000m, NqfLevel = "NQF Level 4" };

    // Non-PIVOTAL deliverable inline form
    private bool _showAddDeliverableForm = false;
    private GrantApplicationIntervention _newDeliverable = new() { IsPivotal = false, TargetQuantity = 1, EstimatedCost = 100000m };
    private DateTime? _delivStartDate = DateTime.UtcNow.AddMonths(1);
    private DateTime? _delivEndDate = DateTime.UtcNow.AddMonths(6);

    private List<BreadcrumbItem> _breadcrumbItems = new();
    private bool _isEditMode;

    protected override void OnParametersSet()
    {
        _isEditMode = Id == 0 || NavManager.Uri.EndsWith("/edit", StringComparison.OrdinalIgnoreCase);
    }

    private void EnterEditMode()
    {
        _isEditMode = true;
        NavManager.NavigateTo($"/dg-grants/{Id}/edit");
    }

    private void ExitEditMode()
    {
        if (Id == 0)
        {
            NavManager.NavigateTo("/dg-grants");
        }
        else
        {
            _isEditMode = false;
            NavManager.NavigateTo($"/dg-grants/{Id}");
        }
    }

    protected override async Task OnInitializedAsync()
    {
        _loading = true;
        SetupBreadcrumbs();

        // Sequential lookup loading
        _grantTypes = await LookupService.GetLookupItemsAsync("GrantTypeType");
        _fundingWindows = await GrantService.GetFundingWindowsAsync(activeOnly: false);
        _strategicPriorities = await GrantService.GetStrategicPrioritiesAsync(activeOnly: true);
        _organisations = await OrgService.GetAllAsync();

        if (Id > 0)
        {
            await LoadGrantData();
        }
        else
        {
            _grant = new GrantApplication
            {
                OrganisationId = _organisations.FirstOrDefault()?.Id ?? 0,
                ApplicationNumber = $"DG-{DateTime.UtcNow.Year}-{new Random().Next(10000, 99999)}",
                GrantTypeCode = "HYBRID",
                StatusCode = "DRAFT",
                RequestedAmount = 1500000m,
                ApplicationDate = DateTime.Today,
                HasPivotalInterventions = true,
                HasNonPivotalInterventions = true
            };
            _appDate = DateTime.Today;
            await CheckWspCompliance();
        }

        _loading = false;
    }

    private void SetupBreadcrumbs()
    {
        _breadcrumbItems = new List<BreadcrumbItem>
        {
            new BreadcrumbItem("Home", href: "/"),
            new BreadcrumbItem("Discretionary Grants (DG)", href: "/dg-grants"),
            new BreadcrumbItem(Id == 0 ? "New DG Application" : _grant.ApplicationNumber, href: null, disabled: true)
        };
    }

    private string GetClassificationBadgeText()
    {
        if (_grant.HasPivotalInterventions && _grant.HasNonPivotalInterventions)
            return "Hybrid (PIVOTAL & Strategic Project)";
        if (_grant.HasNonPivotalInterventions)
            return "Strategic Project (Non-PIVOTAL)";
        return "PIVOTAL (Structured Learning)";
    }

    private string FormatOrganisationDisplay(int orgId)
    {
        if (orgId == 0) return "-- Select Applying Organisation / Employer --";
        var org = _organisations?.FirstOrDefault(o => o.Id == orgId) ?? _grant?.Organisation;
        return org != null && !string.IsNullOrWhiteSpace(org.CompanyName) 
            ? $"{org.CompanyName} ({org.SdlNumber})" 
            : "Applying Organisation / Employer";
    }

    private string FormatStrategicPriorityDisplay(int? spId)
    {
        if (!spId.HasValue || spId.Value == 0) 
            return "-- General Discretionary Grant / Strategic Theme Unassigned --";
        var sp = _strategicPriorities?.FirstOrDefault(s => s.Id == spId.Value) ?? _grant?.StrategicPriority;
        return sp != null && !string.IsNullOrWhiteSpace(sp.Name)
            ? $"{sp.Code} - {sp.Name} ({sp.NsdpOutcomeCode})"
            : "Strategic Priority / Focus Area Theme";
    }

    private string FormatFundingWindowDisplay(int? windowId)
    {
        if (!windowId.HasValue || windowId.Value == 0) 
            return "-- No DG Window Assigned / Direct Submission --";
        var fw = _fundingWindows?.FirstOrDefault(w => w.Id == windowId.Value) ?? _grant?.FundingWindow;
        return fw != null && !string.IsNullOrWhiteSpace(fw.WindowName) 
            ? $"{fw.WindowName} (FY {fw.FinYear} - {fw.TotalAvailableBudget:C})" 
            : "Assigned DG Funding Window";
    }

    private async Task LoadGrantData()
    {
        var g = await GrantService.GetByIdAsync(Id);
        if (g != null)
        {
            _grant = g;
            _appDate = _grant.ApplicationDate;
            _budgets = await GrantService.GetProjectBudgetsAsync(Id);
            _linkedMoa = await GrantService.GetGrantMoaByApplicationIdAsync(Id);
            await CheckWspCompliance();
            SetupBreadcrumbs();
        }
        else
        {
            Snackbar.Add($"Discretionary Grant Application #{Id} not found.", Severity.Error);
            NavManager.NavigateTo("/dg-grants");
        }
    }

    private async Task CheckWspCompliance()
    {
        if (_grant.OrganisationId > 0)
        {
            _wspResult = await GrantService.EvaluateWspEligibilityAsync(_grant.OrganisationId, _grant.FinancialYear);
            if (!_grant.IsWspExempt && _wspResult != null)
            {
                _grant.IsWspCompliant = _wspResult.IsEligible;
                _grant.WspSubmissionId = _wspResult.WspSubmissionId;
                if (string.IsNullOrWhiteSpace(_grant.WspExemptionReason))
                {
                    _grant.WspExemptionReason = _wspResult.Reason;
                }
            }
        }
    }

    private void OpenAddPivotalForm()
    {
        _newPivotal = new GrantApplicationIntervention
        {
            GrantApplicationId = Id,
            IsPivotal = true,
            InterventionTypeCode = "APPRENTICESHIP",
            NqfLevel = "NQF Level 4",
            LearnerCountEmployed = 5,
            LearnerCountUnemployed = 10,
            UnitCost = 55000m
        };
        _showAddPivotalForm = true;
    }

    private async Task SavePivotalLine()
    {
        try
        {
            _newPivotal.GrantApplicationId = Id;
            _newPivotal.TotalAmount = _newPivotal.UnitCost * (_newPivotal.LearnerCountEmployed + _newPivotal.LearnerCountUnemployed);
            await GrantService.AddApplicationInterventionAsync(Id, _newPivotal, "CoordinatorUser");
            _showAddPivotalForm = false;
            Snackbar.Add("PIVOTAL training intervention added.", Severity.Success);
            await LoadGrantData();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error adding PIVOTAL line: {ex.Message}", Severity.Error);
        }
    }

    private void OpenAddDeliverableForm()
    {
        _newDeliverable = new GrantApplicationIntervention
        {
            GrantApplicationId = Id,
            IsPivotal = false,
            InterventionTypeCode = "INFRA_WORKSHOP",
            TargetQuantity = 1,
            EstimatedCost = 150000m,
            MilestoneNumber = _grant.Interventions.Count(i => !i.IsPivotal) + 1
        };
        _delivStartDate = DateTime.UtcNow.AddMonths(1);
        _delivEndDate = DateTime.UtcNow.AddMonths(6);
        _showAddDeliverableForm = true;
    }

    private async Task SaveDeliverableLine()
    {
        try
        {
            _newDeliverable.GrantApplicationId = Id;
            _newDeliverable.ProjectedStartDate = _delivStartDate;
            _newDeliverable.ProjectedEndDate = _delivEndDate;
            _newDeliverable.TotalAmount = _newDeliverable.EstimatedCost;
            await GrantService.AddApplicationInterventionAsync(Id, _newDeliverable, "CoordinatorUser");
            _showAddDeliverableForm = false;
            Snackbar.Add("Project deliverable milestone added.", Severity.Success);
            await LoadGrantData();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error adding deliverable: {ex.Message}", Severity.Error);
        }
    }

    private async Task RemoveInterventionLine(int interventionId)
    {
        try
        {
            await GrantService.RemoveApplicationInterventionAsync(interventionId, "CoordinatorUser");
            Snackbar.Add("Intervention line item removed.", Severity.Success);
            await LoadGrantData();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error removing intervention: {ex.Message}", Severity.Error);
        }
    }

    private async Task GenerateMoa()
    {
        if (Id <= 0) return;

        _isGeneratingMoa = true;
        try
        {
            var moa = await GrantService.GenerateGrantMoaFromApplicationAsync(Id, "AdminUser");
            _linkedMoa = moa;
            Snackbar.Add($"Bilateral DG MoA contract '{moa.MoaNumber}' generated with 4 milestone tranches.", Severity.Success);
            await LoadGrantData();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error generating DG MoA contract: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isGeneratingMoa = false;
        }
    }

    private async Task SaveGrant()
    {
        if (_form != null)
        {
            await _form.Validate();
            if (!_isValid) return;
        }

        _isSaving = true;
        try
        {
            if (_appDate.HasValue) _grant.ApplicationDate = _appDate.Value;

            if (Id == 0)
            {
                var created = await GrantService.CreateApplicationAsync(_grant, "CoordinatorUser");
                Snackbar.Add($"Discretionary Grant application '{created.ApplicationNumber}' created successfully.", Severity.Success);
                NavManager.NavigateTo($"/dg-grants/{created.Id}");
            }
            else
            {
                var updated = await GrantService.UpdateApplicationAsync(_grant, "CoordinatorUser");
                Snackbar.Add($"Discretionary Grant application '{updated.ApplicationNumber}' updated successfully.", Severity.Success);
                await LoadGrantData();
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error saving DG application: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isSaving = false;
        }
    }

    private async Task DeleteGrant()
    {
        if (Id <= 0) return;

        var parameters = new DialogParameters<ConfirmDialog>
        {
            { x => x.Title, "Delete Discretionary Grant Application" },
            { x => x.Consequence, "Are you sure you want to delete this Discretionary Grant (DG) application? All associated project budgets and intervention targets will be permanently removed." },
            { x => x.ConfirmLabel, "Delete Application" },
            { x => x.IsDestructive, true }
        };
        var dialog = await DialogService.ShowAsync<ConfirmDialog>("Delete Grant Application", parameters);
        var result = await dialog.Result;
        if (result == null || result.Canceled) return;

        try
        {
            var deleted = await GrantService.DeleteAsync(Id, "AdminUser");
            if (deleted)
            {
                Snackbar.Add("Discretionary Grant application deleted successfully.", Severity.Success);
                NavManager.NavigateTo("/dg-grants");
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error deleting DG application: {ex.Message}", Severity.Error);
        }
    }

    private void OpenAddBudgetForm()
    {
        _newBudget = new GrantProjectBudget
        {
            GrantApplicationId = Id,
            ExpenseCategory = "Learner Allowances / Stipends",
            UnitCost = 5000m,
            Quantity = 12
        };
        _showAddBudgetForm = true;
    }

    private void CancelAddBudgetForm()
    {
        _showAddBudgetForm = false;
    }

    private async Task SaveBudgetLine()
    {
        try
        {
            await GrantService.AddBudgetItemAsync(Id, _newBudget, "CoordinatorUser");
            _showAddBudgetForm = false;
            Snackbar.Add("Budget line item added.", Severity.Success);
            _budgets = await GrantService.GetProjectBudgetsAsync(Id);
            await LoadGrantData();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error adding budget item: {ex.Message}", Severity.Error);
        }
    }

    private async Task RemoveBudgetLine(int budgetId)
    {
        try
        {
            await GrantService.RemoveBudgetItemAsync(budgetId, "CoordinatorUser");
            Snackbar.Add("Budget line item removed.", Severity.Success);
            _budgets = await GrantService.GetProjectBudgetsAsync(Id);
            await LoadGrantData();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error removing budget item: {ex.Message}", Severity.Error);
        }
    }

    private async Task OnWorkflowStatusChanged(string newStatus)
    {
        _grant.StatusCode = newStatus;
        await LoadGrantData();
        StateHasChanged();
    }

    private void BackToList() => NavManager.NavigateTo("/dg-grants");
}
