@page "/dg-grants/apply"
@page "/dg-grants/apply/{FundingWindowId:int}"
@page "/dg-grants/create"
@page "/grants/create"
@using Nsdms.Application.Services
@using Nsdms.Domain.Entities
@using Nsdms.Domain.Lookups
@using Nsdms.Web.Components.Shared
@using Nsdms.Web.Components.Shared.Forms
@using Nsdms.Web.Components.Shared.Wizard
@using MudBlazor
@inject IGrantService GrantService
@inject IOrganisationService OrgService
@inject IWizardDraftService DraftService
@inject NavigationManager NavManager
@inject ISnackbar Snackbar
@rendermode InteractiveServer

<div class="mb-4">
    <div class="d-flex align-center gap-2 mb-2">
        <MudButton Variant="Variant.Text"
                   StartIcon="@Icons.Material.Filled.ArrowBack"
                   Color="Color.Default"
                   OnClick="GoBack">
            Back to Discretionary Grants (DG)
        </MudButton>
        <MudBreadcrumbs Items="_breadcrumbs" Separator=">" Class="pa-0 ma-0" />
    </div>
</div>

@if (_loading)
{
    <div class="d-flex justify-center align-center py-12">
        <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Large" />
    </div>
}
else if (_isSuccess)
{
    <MudCard Elevation="2" Class="pa-6 rounded-lg text-center">
        <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success" Size="Size.Large" Class="mb-3" />
        <h1 class="text-h5 font-weight-bold text-primary mb-2">Discretionary Grant (DG) application submitted</h1>
        <p class="text-body1 text-secondary mb-4">
            Application reference <strong class="font-mono">@_submittedAppNumber</strong> has been lodged and staged for adjudication.
        </p>
        <div class="d-flex justify-center gap-3">
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.ReceiptLong"
                       OnClick="ViewSubmittedGrant">
                View submitted application
            </MudButton>
            <MudButton Variant="Variant.Outlined"
                       Color="Color.Default"
                       OnClick="GoBack">
                Return to DG register
            </MudButton>
        </div>
    </MudCard>
}
else
{
    <WizardShell Title="Discretionary Grant (DG) application"
                 Subtitle="Statutory Discretionary Grant funding application (PIVOTAL structured training &amp; Non-PIVOTAL strategic projects)"
                 ActiveStepIndex="@_activeStep"
                 ActiveStepIndexChanged="OnStepChanged"
                 FinishButtonText="Submit DG application"
                 IsBusy="@_isProcessing"
                 HasDraftToResume="@_hasDraftToResume"
                 DraftStepIndex="@_draftStepIndex"
                 DraftSavedTimeAgo="@_draftSavedTimeAgo"
                 OnResumeDraft="ResumeDraftAsync"
                 OnDiscardDraft="DiscardDraftAsync"
                 OnCancel="GoBack"
                 OnSaveDraft="SaveDraftAsync"
                 OnFinish="SubmitApplicationAsync">

        <!-- STEP 1: Funding Window & Strategy -->
        <WizardStep Label="Funding window"
                    Heading="Select funding window &amp; grant category"
                    Description="Choose the gazetted Discretionary Grant funding allocation window and intervention category"
                    ValidateAsync="ValidateStep1Async">
            <DgGrantApplicationFields Section="Window"
                                      FundingWindows="@_fundingWindows"
                                      FundingWindowId="@_fundingWindowId"
                                      FundingWindowIdChanged="OnFundingWindowChanged"
                                      GrantTypeCode="@_grantTypeCode"
                                      GrantTypeCodeChanged="OnGrantTypeCodeChanged"
                                      ProjectTitle="@_projectTitle"
                                      ProjectTitleChanged="@((val) => { _projectTitle = val; UpdateReviewGroups(); })" />
        </WizardStep>

        <!-- STEP 2: Applying Organisation Profile -->
        <WizardStep Label="Organisation"
                    Heading="Verify employer profile &amp; levy status"
                    Description="Confirm the legal applying entity, SDL registration number, and Mandatory Grant (WSP) compliance status"
                    ValidateAsync="ValidateStep2Async">
            <DgGrantApplicationFields Section="Organisation"
                                      Organisations="@_organisations"
                                      OrganisationId="@_organisationId"
                                      OrganisationIdChanged="OnOrganisationChanged"
                                      SdlNumber="@_sdlNumber"
                                      IsWspCompliant="@_isWspCompliant"
                                      IsWspCompliantChanged="@((val) => { _isWspCompliant = val; UpdateReviewGroups(); })"
                                      IsWspExempt="@_isWspExempt"
                                      IsWspExemptChanged="@((val) => { _isWspExempt = val; UpdateReviewGroups(); })"
                                      WspExemptionReason="@_wspExemptionReason"
                                      WspExemptionReasonChanged="@((val) => { _wspExemptionReason = val; UpdateReviewGroups(); })" />
        </WizardStep>

        <!-- STEP 3: Intervention Scope & Selection -->
        <WizardStep Label="Intervention scope"
                    Heading="Scope PIVOTAL &amp; strategic project interventions"
                    Description="Select which skills development programmes and/or strategic projects this application covers"
                    ValidateAsync="ValidateStep3Async">
            <DgGrantApplicationFields Section="InterventionScope"
                                      FundingWindows="@_fundingWindows"
                                      FundingWindowId="@_fundingWindowId"
                                      CatalogInterventions="@_catalogInterventions"
                                      SelectedInterventionCodes="@_selectedInterventionCodes"
                                      SelectedInterventionCodesChanged="OnSelectedInterventionsChanged" />
        </WizardStep>

        <!-- STEP 4: PIVOTAL Structured Training Plan -->
        <WizardStep Label="PIVOTAL plan"
                    Heading="PIVOTAL structured training plan table"
                    Description="Capture accredited qualification titles, NQF levels, OFO occupations, and 18.1/18.2 cohorts"
                    ValidateAsync="ValidateStep4Async">
            @if (_hasPivotal)
            {
                <DgGrantApplicationFields Section="PivotalTrainingPlan"
                                          PivotalInterventions="@_pivotalInterventions"
                                          PivotalInterventionsChanged="OnPivotalInterventionsChanged"
                                          CatalogInterventions="@_catalogInterventions" />
            }
            else
            {
                <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="my-4">
                    <strong>PIVOTAL training plan not applicable</strong>: Your selected application scope focuses entirely on Non-PIVOTAL strategic projects. You may proceed directly to the project motivation section.
                </MudAlert>
            }
        </WizardStep>

        <!-- STEP 5: Strategic Project Motivation -->
        <WizardStep Label="Motivation"
                    Heading="Strategic project narrative motivation &amp; footprint"
                    Description="Provide comprehensive responses to statutory motivation questions, beneficiary counts, and target provinces"
                    ValidateAsync="ValidateStep5Async">
            @if (_hasNonPivotal)
            {
                <DgGrantApplicationFields Section="ProjectMotivation"
                                          ProjectDescription="@_projectDescription"
                                          ProjectDescriptionChanged="@((val) => { _projectDescription = val; UpdateReviewGroups(); })"
                                          Purpose="@_purpose"
                                          PurposeChanged="@((val) => { _purpose = val; UpdateReviewGroups(); })"
                                          Outcomes="@_outcomes"
                                          OutcomesChanged="@((val) => { _outcomes = val; UpdateReviewGroups(); })"
                                          Benefits="@_benefits"
                                          BenefitsChanged="@((val) => { _benefits = val; UpdateReviewGroups(); })"
                                          PotentialRisks="@_potentialRisks"
                                          PotentialRisksChanged="@((val) => { _potentialRisks = val; UpdateReviewGroups(); })"
                                          EstimatedOverallProjectCost="@_estimatedOverallProjectCost"
                                          EstimatedOverallProjectCostChanged="@((val) => { _estimatedOverallProjectCost = val; UpdateBudgetRollup(); })"
                                          NumberOfBeneficiaries="@_numberOfBeneficiaries"
                                          NumberOfBeneficiariesChanged="@((val) => { _numberOfBeneficiaries = val; UpdateBudgetRollup(); })"
                                          RequireProjectAdministrationCosts="@_requireProjectAdministrationCosts"
                                          RequireProjectAdministrationCostsChanged="OnRequireAdminCostsChanged"
                                          TargetProvinces="@_targetProvinces"
                                          TargetProvincesChanged="@((val) => { _targetProvinces = val; UpdateReviewGroups(); })" />
            }
            else
            {
                <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="my-4">
                    <strong>Narrative project motivation not applicable</strong>: Your selected application scope is PIVOTAL-only. Structured qualification and headcount specifications were completed in the previous step.
                </MudAlert>
            }
        </WizardStep>

        <!-- STEP 6: Implementation Plan & Deliverables -->
        <WizardStep Label="Deliverables"
                    Heading="Implementation plan deliverables &amp; tranches"
                    Description="Itemize project deliverable milestones, target outputs, tranche percentages, and schedules"
                    ValidateAsync="ValidateStep6Async">
            @if (_hasNonPivotal)
            {
                <DgGrantApplicationFields Section="ImplementationPlan"
                                          NonPivotalInterventions="@_nonPivotalInterventions"
                                          NonPivotalInterventionsChanged="OnNonPivotalInterventionsChanged"
                                          CatalogInterventions="@_catalogInterventions" />
            }
            else
            {
                <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="my-4">
                    <strong>Milestone deliverables not applicable</strong>: Deliverables and tranche schedules are managed via statutory tripartite agreements for PIVOTAL programmes.
                </MudAlert>
            }
        </WizardStep>

        <!-- STEP 7: Financial Budget & Targets -->
        <WizardStep Label="Budget &amp; targets"
                    Heading="Consolidated funding envelope &amp; beneficiary targets"
                    Description="Review automated budget rollup across PIVOTAL programmes, strategic project deliverables, and administration fees"
                    ValidateAsync="ValidateStep7Async">
            <DgGrantApplicationFields Section="Budget"
                                      RequestedAmount="@_requestedAmount"
                                      RequestedAmountChanged="@((val) => { _requestedAmount = val; UpdateReviewGroups(); })"
                                      LearnerCount="@_learnerCount"
                                      LearnerCountChanged="@((val) => { _learnerCount = val; UpdateReviewGroups(); })"
                                      ImplementationPlanSummary="@_implementationPlanSummary"
                                      ImplementationPlanSummaryChanged="@((val) => { _implementationPlanSummary = val; UpdateReviewGroups(); })"
                                      PivotalInterventions="@_pivotalInterventions"
                                      NonPivotalInterventions="@_nonPivotalInterventions"
                                      RequireProjectAdministrationCosts="@_requireProjectAdministrationCosts" />
        </WizardStep>

        <!-- STEP 8: Statutory Compliance & Consents -->
        <WizardStep Label="Compliance"
                    Heading="Upload statutory compliance details &amp; legal consent"
                    Description="Provide valid SARS Tax Compliance Status PIN, B-BBEE contributor level, and statutory consents"
                    ValidateAsync="ValidateStep8Async">
            <DgGrantApplicationFields Section="Compliance"
                                      TaxCompliancePin="@_taxCompliancePin"
                                      TaxCompliancePinChanged="@((val) => { _taxCompliancePin = val; UpdateReviewGroups(); })"
                                      BbbeeLevel="@_bbbeeLevel"
                                      BbbeeLevelChanged="@((val) => { _bbbeeLevel = val; UpdateReviewGroups(); })"
                                      ConfirmStatutoryCompliance="@_confirmStatutoryCompliance"
                                      ConfirmStatutoryComplianceChanged="@((val) => { _confirmStatutoryCompliance = val; UpdateReviewGroups(); })"
                                      PopiaConsent="@_popiaConsent"
                                      PopiaConsentChanged="@((val) => { _popiaConsent = val; UpdateReviewGroups(); })" />
        </WizardStep>

        <!-- STEP 9: Review & Statutory Submission -->
        <WizardReviewStep ReviewGroups="@_reviewGroups"
                          OnEditStep="OnEditStepRequested">
            <LifecycleContent>
                <div class="d-flex align-center gap-3">
                    <MudIcon Icon="@Icons.Material.Filled.Security" Color="Color.Primary" Size="Size.Medium" />
                    <div>
                        <span class="d-block text-body2 font-weight-bold text-primary">
                            Statutory non-repudiation &amp; audited change log
                        </span>
                        <span class="d-block text-caption text-secondary">
                            Submitting this application creates an immutable audited change log entry with a digital security seal and freezes the project specification snapshot.
                        </span>
                    </div>
                </div>
            </LifecycleContent>
        </WizardReviewStep>

    </WizardShell>
}

@code {
    [Parameter] public int? FundingWindowId { get; set; }

    private int _activeStep = 0;
    private bool _loading = true;
    private bool _isProcessing = false;
    private bool _isSuccess = false;
    private int _submittedAppId = 0;
    private string _submittedAppNumber = string.Empty;

    private List<GrantFundingWindow> _fundingWindows = new();
    private List<Organisation> _organisations = new();
    private List<InterventionType> _catalogInterventions = new();

    // Step 1: Window
    private int? _fundingWindowId;
    private string _grantTypeCode = "HYBRID";
    private string _projectTitle = string.Empty;

    // Step 2: Organisation
    private int _organisationId;
    private string _sdlNumber = string.Empty;
    private bool _isWspCompliant = true;
    private bool _isWspExempt = false;
    private string? _wspExemptionReason;

    // Step 3: Scope
    private HashSet<string> _selectedInterventionCodes = new();
    private bool _hasPivotal = true;
    private bool _hasNonPivotal = true;

    // Step 4: PIVOTAL Plan
    private List<GrantApplicationIntervention> _pivotalInterventions = new();

    // Step 5: Strategic Project Motivation
    private string? _projectDescription;
    private string? _purpose;
    private string? _outcomes;
    private string? _benefits;
    private string? _potentialRisks;
    private decimal _estimatedOverallProjectCost = 0m;
    private int _numberOfBeneficiaries = 0;
    private bool _requireProjectAdministrationCosts = false;
    private string? _targetProvinces;

    // Step 6: Non-PIVOTAL Deliverables
    private List<GrantApplicationIntervention> _nonPivotalInterventions = new();

    // Step 7: Budget & Targets
    private decimal _requestedAmount = 0m;
    private int _learnerCount = 0;
    private string _implementationPlanSummary = string.Empty;

    // Step 8: Compliance
    private string _taxCompliancePin = string.Empty;
    private string _bbbeeLevel = "Level 2";
    private bool _confirmStatutoryCompliance = false;
    private bool _popiaConsent = false;

    private List<BreadcrumbItem> _breadcrumbs = new()
    {
        new BreadcrumbItem("Home", href: "/"),
        new BreadcrumbItem("Grants, levies & finance", href: "/dg-grants"),
        new BreadcrumbItem("Discretionary Grants (DG)", href: "/dg-grants"),
        new BreadcrumbItem("Apply for DG", href: null, disabled: true)
    };

    private List<WizardReviewGroup> _reviewGroups = new();

    // Draft Persistence Engine
    private bool _hasDraftToResume = false;
    private int _draftStepIndex = 0;
    private string? _draftSavedTimeAgo;
    private string? _activeDraftKey;
    private WizardDraftSession? _loadedDraft;

    private record DgApplicationCompositeDraftModel
    {
        public int? FundingWindowId { get; init; }
        public string GrantTypeCode { get; init; } = "HYBRID";
        public string ProjectTitle { get; init; } = string.Empty;
        public int OrganisationId { get; init; }
        public string SdlNumber { get; init; } = string.Empty;
        public bool IsWspCompliant { get; init; } = true;
        public bool IsWspExempt { get; init; } = false;
        public string? WspExemptionReason { get; init; }

        public List<string> SelectedInterventionCodes { get; init; } = new();
        public bool HasPivotal { get; init; } = true;
        public bool HasNonPivotal { get; init; } = true;

        public List<GrantApplicationIntervention> PivotalInterventions { get; init; } = new();

        public string? ProjectDescription { get; init; }
        public string? Purpose { get; init; }
        public string? Outcomes { get; init; }
        public string? Benefits { get; init; }
        public string? PotentialRisks { get; init; }
        public decimal EstimatedOverallProjectCost { get; init; }
        public int NumberOfBeneficiaries { get; init; }
        public bool RequireProjectAdministrationCosts { get; init; }
        public string? TargetProvinces { get; init; }

        public List<GrantApplicationIntervention> NonPivotalInterventions { get; init; } = new();

        public decimal RequestedAmount { get; init; }
        public int LearnerCount { get; init; }
        public string ImplementationPlanSummary { get; init; } = string.Empty;

        public string TaxCompliancePin { get; init; } = string.Empty;
        public string BbbeeLevel { get; init; } = "Level 2";
        public bool ConfirmStatutoryCompliance { get; init; } = false;
        public bool PopiaConsent { get; init; } = false;
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _fundingWindows = await GrantService.GetFundingWindowsAsync(activeOnly: true);
            _organisations = await OrgService.GetAllAsync();
            _catalogInterventions = await GrantService.GetInterventionCatalogAsync();

            if (FundingWindowId.HasValue && FundingWindowId.Value > 0)
            {
                _fundingWindowId = FundingWindowId.Value;
            }
            else if (_fundingWindows.Any())
            {
                _fundingWindowId = _fundingWindows.First().Id;
            }

            if (_organisations.Any())
            {
                _organisationId = _organisations.First().Id;
                _sdlNumber = _organisations.First().SdlNumber;
            }

            // Apply window defaults
            ApplyWindowDefaults();

            _projectTitle = "Strategic Artisan & Technical Capacity Initiative 2026";
            _projectDescription = "Comprehensive technical skills enhancement project integrating credit-bearing artisan apprenticeships with advanced workshop simulation infrastructure.";
            _purpose = "Address critical scarce skills shortages across engineering, tooling, and precision manufacturing sectors.";
            _outcomes = "Accredited trade test readiness for 25 apprentices and established regional TVET simulation capacity.";
            _benefits = "High-absorption workplace placement, improved productivity, and enhanced artisan throughput.";
            _potentialRisks = "Workplace rotation delays; mitigated through structured MoA host employer placement agreements.";
            _targetProvinces = "Gauteng, KwaZulu-Natal";
            _implementationPlanSummary = "Cohort recruitment in month 1, dual-system theory and simulation months 2-6, workplace apprentice rotations months 7-18.";
            _taxCompliancePin = "9823471029";

            // Default mock interventions for initial state
            SeedDefaultInterventions();

            RefreshInterventionScopes();

            // Check for available in-progress draft
            await CheckForActiveDraftAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error initializing DG application wizard: {ex.Message}", Severity.Error);
        }
        finally
        {
            _loading = false;
            UpdateReviewGroups();
        }
    }

    private void SeedDefaultInterventions()
    {
        if (!_selectedInterventionCodes.Any())
        {
            _selectedInterventionCodes.Add("APPRENTICESHIP");
            _selectedInterventionCodes.Add("INFRA_WORKSHOP");
        }

        if (!_pivotalInterventions.Any())
        {
            _pivotalInterventions.Add(new GrantApplicationIntervention
            {
                IsPivotal = true,
                InterventionTypeCode = "APPRENTICESHIP",
                QualificationTitle = "National Certificate: Mechanical Fitting",
                SaqaId = "63414",
                NqfLevel = "NQF Level 4",
                OfoCode = "653301",
                LearnerCountEmployed = 5,
                LearnerCountUnemployed = 10,
                UnitCost = 55000m,
                TotalAmount = 825000m
            });
        }

        if (!_nonPivotalInterventions.Any())
        {
            _nonPivotalInterventions.Add(new GrantApplicationIntervention
            {
                IsPivotal = false,
                InterventionTypeCode = "INFRA_WORKSHOP",
                DeliverableName = "Advanced CNC Milling Simulation Workstations",
                TargetQuantity = 3,
                EstimatedCost = 350000m,
                TotalAmount = 350000m,
                MilestoneNumber = 1,
                ProjectedStartDate = DateTime.UtcNow.AddMonths(1),
                ProjectedEndDate = DateTime.UtcNow.AddMonths(4),
                Comments = "Procurement, installation, and commissioning of 3 CNC simulation training benches"
            });
            _nonPivotalInterventions.Add(new GrantApplicationIntervention
            {
                IsPivotal = false,
                InterventionTypeCode = "INFRA_WORKSHOP",
                DeliverableName = "Commissioning & Safety Certification",
                TargetQuantity = 1,
                EstimatedCost = 150000m,
                TotalAmount = 150000m,
                MilestoneNumber = 2,
                ProjectedStartDate = DateTime.UtcNow.AddMonths(5),
                ProjectedEndDate = DateTime.UtcNow.AddMonths(8),
                Comments = "Accreditation site verification and health & safety signoff"
            });
        }
    }

    private void ApplyWindowDefaults()
    {
        if (_fundingWindowId.HasValue)
        {
            var win = _fundingWindows.FirstOrDefault(w => w.Id == _fundingWindowId.Value);
            if (win != null)
            {
                if (win.WindowClassification == "NonPivotal")
                {
                    _grantTypeCode = "NON_PIVOTAL";
                }
                else if (win.WindowClassification == "Hybrid")
                {
                    _grantTypeCode = "HYBRID";
                }
                else if (win.WindowClassification == "Pivotal")
                {
                    _grantTypeCode = "PIVOTAL";
                }
            }
        }
    }

    private void OnFundingWindowChanged(int? id)
    {
        _fundingWindowId = id;
        ApplyWindowDefaults();
        RefreshInterventionScopes();
    }

    private void OnGrantTypeCodeChanged(string code)
    {
        _grantTypeCode = code;
        RefreshInterventionScopes();
    }

    private void OnOrganisationChanged(int id)
    {
        _organisationId = id;
        var org = _organisations.FirstOrDefault(o => o.Id == id);
        if (org != null)
        {
            _sdlNumber = org.SdlNumber;
        }
        UpdateReviewGroups();
    }

    private void OnSelectedInterventionsChanged(HashSet<string> codes)
    {
        _selectedInterventionCodes = codes;
        RefreshInterventionScopes();
    }

    private void OnPivotalInterventionsChanged(List<GrantApplicationIntervention> items)
    {
        _pivotalInterventions = items;
        UpdateBudgetRollup();
        UpdateReviewGroups();
    }

    private void OnNonPivotalInterventionsChanged(List<GrantApplicationIntervention> items)
    {
        _nonPivotalInterventions = items;
        UpdateBudgetRollup();
        UpdateReviewGroups();
    }

    private void OnRequireAdminCostsChanged(bool val)
    {
        _requireProjectAdministrationCosts = val;
        UpdateBudgetRollup();
        UpdateReviewGroups();
    }

    private void RefreshInterventionScopes()
    {
        var selectedTypes = _catalogInterventions
            .Where(i => _selectedInterventionCodes.Contains(i.Code))
            .ToList();

        bool hasSelectedPivotal = selectedTypes.Any(i => i.IsPivotal);
        bool hasSelectedNonPivotal = selectedTypes.Any(i => !i.IsPivotal);

        if (_grantTypeCode == "PIVOTAL")
        {
            _hasPivotal = true;
            _hasNonPivotal = hasSelectedNonPivotal;
        }
        else if (_grantTypeCode == "NON_PIVOTAL")
        {
            _hasPivotal = hasSelectedPivotal;
            _hasNonPivotal = true;
        }
        else if (_grantTypeCode == "HYBRID")
        {
            _hasPivotal = true;
            _hasNonPivotal = true;
        }
        else
        {
            _hasPivotal = true;
            _hasNonPivotal = hasSelectedNonPivotal;
        }

        UpdateBudgetRollup();
        UpdateReviewGroups();
    }

    private void UpdateBudgetRollup()
    {
        decimal pivotalSum = _hasPivotal ? _pivotalInterventions.Sum(p => p.TotalAmount > 0 ? p.TotalAmount : p.UnitCost * p.TotalLearnerCount) : 0m;
        decimal nonPivotalSum = _hasNonPivotal ? _nonPivotalInterventions.Sum(d => d.TotalAmount > 0 ? d.TotalAmount : d.EstimatedCost) : 0m;
        decimal adminFee = (_hasNonPivotal && _requireProjectAdministrationCosts) ? Math.Round(nonPivotalSum * 0.075m, 2) : 0m;

        _requestedAmount = pivotalSum + nonPivotalSum + adminFee;

        int totalPivotalLearners = _pivotalInterventions.Sum(p => p.TotalLearnerCount);
        if (_hasPivotal && totalPivotalLearners > 0)
        {
            _learnerCount = totalPivotalLearners;
        }
        else if (_hasNonPivotal && _numberOfBeneficiaries > 0)
        {
            _learnerCount = _numberOfBeneficiaries;
        }
    }

    private void OnStepChanged(int step)
    {
        _activeStep = step;
        UpdateReviewGroups();
    }

    private void OnEditStepRequested(int targetStep)
    {
        _activeStep = targetStep;
    }

    private Task<bool> ValidateStep1Async()
    {
        if (_fundingWindowId == null || _fundingWindowId <= 0)
        {
            Snackbar.Add("Please select an open Discretionary Grant funding window.", Severity.Warning);
            return Task.FromResult(false);
        }

        if (string.IsNullOrWhiteSpace(_projectTitle))
        {
            Snackbar.Add("Please specify a project title.", Severity.Warning);
            return Task.FromResult(false);
        }

        return Task.FromResult(true);
    }

    private Task<bool> ValidateStep2Async()
    {
        if (_organisationId <= 0)
        {
            Snackbar.Add("Please select an applying employer organisation.", Severity.Warning);
            return Task.FromResult(false);
        }

        if (!_isWspCompliant && !_isWspExempt)
        {
            Snackbar.Add("Organisation must be WSP compliant or specify a statutory exemption reason.", Severity.Warning);
            return Task.FromResult(false);
        }

        if (_isWspExempt && string.IsNullOrWhiteSpace(_wspExemptionReason))
        {
            Snackbar.Add("Please provide the statutory reason for WSP submission exemption.", Severity.Warning);
            return Task.FromResult(false);
        }

        return Task.FromResult(true);
    }

    private Task<bool> ValidateStep3Async()
    {
        if (!_selectedInterventionCodes.Any() && !_pivotalInterventions.Any() && !_nonPivotalInterventions.Any())
        {
            Snackbar.Add("Please select at least one intervention from the catalog.", Severity.Warning);
            return Task.FromResult(false);
        }

        return Task.FromResult(true);
    }

    private Task<bool> ValidateStep4Async()
    {
        if (!_hasPivotal)
        {
            return Task.FromResult(true);
        }

        if (!_pivotalInterventions.Any())
        {
            Snackbar.Add("Please add at least one PIVOTAL training plan intervention line item.", Severity.Warning);
            return Task.FromResult(false);
        }

        return Task.FromResult(true);
    }

    private Task<bool> ValidateStep5Async()
    {
        if (!_hasNonPivotal)
        {
            return Task.FromResult(true);
        }

        if (string.IsNullOrWhiteSpace(_projectDescription))
        {
            Snackbar.Add("Please provide a project description for this strategic project.", Severity.Warning);
            return Task.FromResult(false);
        }

        if (string.IsNullOrWhiteSpace(_purpose))
        {
            Snackbar.Add("Please describe the strategic purpose of this initiative.", Severity.Warning);
            return Task.FromResult(false);
        }

        return Task.FromResult(true);
    }

    private Task<bool> ValidateStep6Async()
    {
        if (!_hasNonPivotal)
        {
            return Task.FromResult(true);
        }

        if (!_nonPivotalInterventions.Any())
        {
            Snackbar.Add("Please add at least one deliverable milestone for this project implementation plan.", Severity.Warning);
            return Task.FromResult(false);
        }

        return Task.FromResult(true);
    }

    private Task<bool> ValidateStep7Async()
    {
        if (_requestedAmount <= 0)
        {
            Snackbar.Add("Consolidated requested funding amount must be greater than zero.", Severity.Warning);
            return Task.FromResult(false);
        }

        return Task.FromResult(true);
    }

    private Task<bool> ValidateStep8Async()
    {
        if (string.IsNullOrWhiteSpace(_taxCompliancePin) || _taxCompliancePin.Length < 8)
        {
            Snackbar.Add("Please enter a valid SARS Tax Compliance Status PIN.", Severity.Warning);
            return Task.FromResult(false);
        }

        if (!_confirmStatutoryCompliance)
        {
            Snackbar.Add("You must confirm statutory compliance with the Skills Development Act.", Severity.Warning);
            return Task.FromResult(false);
        }

        if (!_popiaConsent)
        {
            Snackbar.Add("You must consent to POPIA personal information processing.", Severity.Warning);
            return Task.FromResult(false);
        }

        return Task.FromResult(true);
    }

    private void UpdateReviewGroups()
    {
        var window = _fundingWindows.FirstOrDefault(w => w.Id == _fundingWindowId);
        var org = _organisations.FirstOrDefault(o => o.Id == _organisationId);

        var groups = new List<WizardReviewGroup>
        {
            new()
            {
                Title = "Funding window & category",
                Icon = Icons.Material.Filled.EventNote,
                TargetStepIndex = 0,
                Items = new()
                {
                    new("Funding window", window != null ? $"FY{winYear(window)} - {window.WindowName}" : "Not selected"),
                    new("Grant category", _grantTypeCode),
                    new("Project title", _projectTitle)
                }
            },
            new()
            {
                Title = "Employer profile & compliance",
                Icon = Icons.Material.Filled.Business,
                TargetStepIndex = 1,
                Items = new()
                {
                    new("Organisation", org?.CompanyName ?? "Not selected"),
                    new("SDL number", _sdlNumber, isMonospace: true),
                    new("WSP compliance", _isWspCompliant ? "Compliant (Regulation 4(4))" : (_isWspExempt ? $"Exempt ({_wspExemptionReason})" : "Non-compliant"))
                }
            },
            new()
            {
                Title = "Intervention scope",
                Icon = Icons.Material.Filled.Category,
                TargetStepIndex = 2,
                Items = new()
                {
                    new("Selected interventions", $"{_selectedInterventionCodes.Count} catalog types selected"),
                    new("Includes PIVOTAL", _hasPivotal ? "Yes" : "No"),
                    new("Includes Non-PIVOTAL", _hasNonPivotal ? "Yes" : "No")
                }
            }
        };

        if (_hasPivotal)
        {
            int totalEmployed = _pivotalInterventions.Sum(p => p.LearnerCountEmployed);
            int totalUnemployed = _pivotalInterventions.Sum(p => p.LearnerCountUnemployed);
            decimal pivotalCost = _pivotalInterventions.Sum(p => p.TotalAmount > 0 ? p.TotalAmount : p.UnitCost * p.TotalLearnerCount);

            groups.Add(new WizardReviewGroup
            {
                Title = "PIVOTAL training plan",
                Icon = Icons.Material.Filled.School,
                TargetStepIndex = 3,
                Items = new()
                {
                    new("Intervention line items", $"{_pivotalInterventions.Count} qualification lines"),
                    new("Employed learners (18.1)", $"{totalEmployed} candidates"),
                    new("Unemployed learners (18.2)", $"{totalUnemployed} candidates"),
                    new("PIVOTAL funding subtotal", pivotalCost.ToString("C2", System.Globalization.CultureInfo.InvariantCulture))
                }
            });
        }

        if (_hasNonPivotal)
        {
            groups.Add(new WizardReviewGroup
            {
                Title = "Strategic project motivation",
                Icon = Icons.Material.Filled.Lightbulb,
                TargetStepIndex = 4,
                Items = new()
                {
                    new("Target beneficiaries", $"{_numberOfBeneficiaries} participants"),
                    new("Target provinces", !string.IsNullOrWhiteSpace(_targetProvinces) ? _targetProvinces : "All national"),
                    new("Project admin fee (7.5%)", _requireProjectAdministrationCosts ? "Included" : "Excluded"),
                    new("Overall estimated cost", _estimatedOverallProjectCost.ToString("C2", System.Globalization.CultureInfo.InvariantCulture))
                }
            });

            decimal nonPivotalCost = _nonPivotalInterventions.Sum(d => d.TotalAmount > 0 ? d.TotalAmount : d.EstimatedCost);
            groups.Add(new WizardReviewGroup
            {
                Title = "Implementation plan deliverables",
                Icon = Icons.Material.Filled.PlaylistAddCheck,
                TargetStepIndex = 5,
                Items = new()
                {
                    new("Milestone deliverables", $"{_nonPivotalInterventions.Count} deliverables itemized"),
                    new("Deliverables funding subtotal", nonPivotalCost.ToString("C2", System.Globalization.CultureInfo.InvariantCulture))
                }
            });
        }

        groups.Add(new WizardReviewGroup
        {
            Title = "Consolidated budget envelope",
            Icon = Icons.Material.Filled.Payments,
            TargetStepIndex = 6,
            Items = new()
            {
                new("Total requested allocation", _requestedAmount.ToString("C2", System.Globalization.CultureInfo.InvariantCulture)),
                new("Total target beneficiaries", $"{_learnerCount} beneficiaries"),
                new("Implementation plan summary", !string.IsNullOrWhiteSpace(_implementationPlanSummary) ? _implementationPlanSummary : "Provided")
            }
        });

        groups.Add(new WizardReviewGroup
        {
            Title = "Statutory declarations",
            Icon = Icons.Material.Filled.VerifiedUser,
            TargetStepIndex = 7,
            Items = new()
            {
                new("SARS tax PIN", _taxCompliancePin, isMonospace: true),
                new("B-BBEE level", _bbbeeLevel),
                new("Statutory compliance", _confirmStatutoryCompliance ? "Certified compliant" : "Pending"),
                new("POPIA consent", _popiaConsent ? "Granted" : "Pending")
            }
        });

        _reviewGroups = groups;
    }

    private static string winYear(GrantFundingWindow win) => win.FinYear.ToString();

    private async Task CheckForActiveDraftAsync()
    {
        try
        {
            var draft = await DraftService.GetActiveDraftAsync("DgGrantApplicationComposite", "CurrentSdf", _organisationId > 0 ? _organisationId : null);
            if (draft != null && draft.CurrentStepIndex > 0)
            {
                _loadedDraft = draft;
                _activeDraftKey = draft.DraftKey;
                _draftStepIndex = draft.CurrentStepIndex;
                var delta = DateTime.UtcNow - (draft.ModifiedAt ?? draft.CreatedAt);
                _draftSavedTimeAgo = delta.TotalHours >= 1 ? $"{(int)delta.TotalHours}h ago" : $"{(int)delta.TotalMinutes}m ago";
                _hasDraftToResume = true;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Draft check skipped: {ex.Message}");
        }
    }

    private async Task ResumeDraftAsync()
    {
        if (_loadedDraft == null) return;

        var model = DraftService.DeserializeDraftModel<DgApplicationCompositeDraftModel>(_loadedDraft);
        if (model != null)
        {
            _fundingWindowId = model.FundingWindowId;
            _grantTypeCode = model.GrantTypeCode;
            _projectTitle = model.ProjectTitle;
            _organisationId = model.OrganisationId;
            _sdlNumber = model.SdlNumber;
            _isWspCompliant = model.IsWspCompliant;
            _isWspExempt = model.IsWspExempt;
            _wspExemptionReason = model.WspExemptionReason;

            _selectedInterventionCodes = new HashSet<string>(model.SelectedInterventionCodes);
            _hasPivotal = model.HasPivotal;
            _hasNonPivotal = model.HasNonPivotal;

            if (model.PivotalInterventions != null && model.PivotalInterventions.Any())
            {
                _pivotalInterventions = model.PivotalInterventions;
            }

            _projectDescription = model.ProjectDescription;
            _purpose = model.Purpose;
            _outcomes = model.Outcomes;
            _benefits = model.Benefits;
            _potentialRisks = model.PotentialRisks;
            _estimatedOverallProjectCost = model.EstimatedOverallProjectCost;
            _numberOfBeneficiaries = model.NumberOfBeneficiaries;
            _requireProjectAdministrationCosts = model.RequireProjectAdministrationCosts;
            _targetProvinces = model.TargetProvinces;

            if (model.NonPivotalInterventions != null && model.NonPivotalInterventions.Any())
            {
                _nonPivotalInterventions = model.NonPivotalInterventions;
            }

            _requestedAmount = model.RequestedAmount;
            _learnerCount = model.LearnerCount;
            _implementationPlanSummary = model.ImplementationPlanSummary;
            _taxCompliancePin = model.TaxCompliancePin;
            _bbbeeLevel = model.BbbeeLevel;
            _confirmStatutoryCompliance = model.ConfirmStatutoryCompliance;
            _popiaConsent = model.PopiaConsent;

            _activeStep = _loadedDraft.CurrentStepIndex;
            _hasDraftToResume = false;
            RefreshInterventionScopes();
            Snackbar.Add($"Resumed application draft from Step {_activeStep + 1}.", Severity.Info);
        }
    }

    private async Task DiscardDraftAsync()
    {
        if (!string.IsNullOrWhiteSpace(_activeDraftKey))
        {
            await DraftService.DiscardDraftAsync(_activeDraftKey);
            _hasDraftToResume = false;
            _activeDraftKey = null;
            _loadedDraft = null;
            Snackbar.Add("Draft discarded. You are starting a clean application.", Severity.Normal);
        }
    }

    private async Task SaveDraftAsync()
    {
        _isProcessing = true;
        try
        {
            var draftModel = new DgApplicationCompositeDraftModel
            {
                FundingWindowId = _fundingWindowId,
                GrantTypeCode = _grantTypeCode,
                ProjectTitle = _projectTitle,
                OrganisationId = _organisationId,
                SdlNumber = _sdlNumber,
                IsWspCompliant = _isWspCompliant,
                IsWspExempt = _isWspExempt,
                WspExemptionReason = _wspExemptionReason,
                SelectedInterventionCodes = _selectedInterventionCodes.ToList(),
                HasPivotal = _hasPivotal,
                HasNonPivotal = _hasNonPivotal,
                PivotalInterventions = _pivotalInterventions,
                ProjectDescription = _projectDescription,
                Purpose = _purpose,
                Outcomes = _outcomes,
                Benefits = _benefits,
                PotentialRisks = _potentialRisks,
                EstimatedOverallProjectCost = _estimatedOverallProjectCost,
                NumberOfBeneficiaries = _numberOfBeneficiaries,
                RequireProjectAdministrationCosts = _requireProjectAdministrationCosts,
                TargetProvinces = _targetProvinces,
                NonPivotalInterventions = _nonPivotalInterventions,
                RequestedAmount = _requestedAmount,
                LearnerCount = _learnerCount,
                ImplementationPlanSummary = _implementationPlanSummary,
                TaxCompliancePin = _taxCompliancePin,
                BbbeeLevel = _bbbeeLevel,
                ConfirmStatutoryCompliance = _confirmStatutoryCompliance,
                PopiaConsent = _popiaConsent
            };

            var session = await DraftService.SaveDraftAsync(
                "DgGrantApplicationComposite",
                "Discretionary Grant (DG) application",
                "/dg-grants/apply",
                "CurrentSdf",
                _organisationId > 0 ? _organisationId : null,
                _activeStep,
                8,
                draftModel,
                _activeDraftKey
            );

            _activeDraftKey = session.DraftKey;
            _hasDraftToResume = false;
            Snackbar.Add($"Draft saved at Step {_activeStep + 1} ('{session.DraftKey}').", Severity.Info);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Could not save draft: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isProcessing = false;
        }
    }

    private async Task SubmitApplicationAsync()
    {
        _isProcessing = true;
        try
        {
            var app = BuildApplicationEntity("Submitted");
            var result = await GrantService.CreateApplicationAsync(app, "CurrentSdf");
            _submittedAppId = result.Id;
            _submittedAppNumber = result.ApplicationNumber;

            // Clear draft
            if (!string.IsNullOrWhiteSpace(_activeDraftKey))
            {
                await DraftService.MarkAsSubmittedAsync(_activeDraftKey);
            }

            _isSuccess = true;
            Snackbar.Add($"Discretionary Grant (DG) application '{_submittedAppNumber}' submitted successfully!", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Submission failed: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isProcessing = false;
        }
    }

    private GrantApplication BuildApplicationEntity(string status)
    {
        var app = new GrantApplication
        {
            FundingWindowId = _fundingWindowId,
            OrganisationId = _organisationId,
            ProjectTitle = _projectTitle,
            GrantTypeCode = _grantTypeCode,
            RequestedAmount = _requestedAmount,
            ApplicationStatusCode = status,
            IsWspCompliant = _isWspCompliant,
            IsWspExempt = _isWspExempt,
            WspExemptionReason = _wspExemptionReason,
            ApplicationDate = DateTime.UtcNow,

            // Composite fields
            HasPivotalInterventions = _hasPivotal,
            HasNonPivotalInterventions = _hasNonPivotal,
            ProjectDescription = _projectDescription,
            Purpose = _purpose,
            Outcomes = _outcomes,
            Benefits = _benefits,
            PotentialRisks = _potentialRisks,
            EstimatedOverallProjectCost = _estimatedOverallProjectCost,
            NumberOfBeneficiaries = _numberOfBeneficiaries > 0 ? _numberOfBeneficiaries : _learnerCount,
            RequireProjectAdministrationCosts = _requireProjectAdministrationCosts,
            TargetProvinces = _targetProvinces
        };

        var allItems = new List<GrantApplicationIntervention>();
        if (_hasPivotal && _pivotalInterventions.Any())
        {
            allItems.AddRange(_pivotalInterventions);
        }
        if (_hasNonPivotal && _nonPivotalInterventions.Any())
        {
            allItems.AddRange(_nonPivotalInterventions);
        }

        app.Interventions = allItems;
        return app;
    }

