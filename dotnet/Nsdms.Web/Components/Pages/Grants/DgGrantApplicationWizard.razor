@page "/dg-grants/apply"
@page "/dg-grants/apply/{FundingWindowId:int}"
@page "/dg-grants/create"
@page "/grants/create"
@using Nsdms.Application.Services
@using Nsdms.Domain.Entities
@using Nsdms.Web.Components.Shared
@using Nsdms.Web.Components.Shared.Forms
@using Nsdms.Web.Components.Shared.Wizard
@using MudBlazor
@inject IGrantService GrantService
@inject IOrganisationService OrgService
@inject IWizardDraftService DraftService
@inject NavigationManager NavManager
@inject ISnackbar Snackbar
@rendermode InteractiveServer

<div class="mb-4">
    <div class="d-flex align-center gap-2 mb-2">
        <MudButton Variant="Variant.Text"
                   StartIcon="@Icons.Material.Filled.ArrowBack"
                   Color="Color.Default"
                   OnClick="GoBack">
            Back to Discretionary Grants (DG)
        </MudButton>
        <MudBreadcrumbs Items="_breadcrumbs" Separator=">" Class="pa-0 ma-0" />
    </div>
</div>

@if (_loading)
{
    <div class="d-flex justify-center align-center py-12">
        <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Large" />
    </div>
}
else if (_isSuccess)
{
    <MudCard Elevation="2" Class="pa-6 rounded-lg text-center">
        <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success" Size="Size.Large" Class="mb-3" />
        <h1 class="text-h5 font-weight-bold text-primary mb-2">Discretionary Grant (DG) application submitted</h1>
        <p class="text-body1 text-secondary mb-4">
            Application reference <strong class="font-mono">@_submittedAppNumber</strong> has been staged for committee adjudication.
        </p>
        <div class="d-flex justify-center gap-3">
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.ReceiptLong"
                       OnClick="ViewSubmittedGrant">
                View submitted application
            </MudButton>
            <MudButton Variant="Variant.Outlined"
                       Color="Color.Default"
                       OnClick="GoBack">
                Return to DG register
            </MudButton>
        </div>
    </MudCard>
}
else
{
    <WizardShell Title="Discretionary Grant (DG) application"
                 Subtitle="Statutory PIVOTAL strategic skills development funding allocation application"
                 ActiveStepIndex="@_activeStep"
                 ActiveStepIndexChanged="OnStepChanged"
                 FinishButtonText="Submit DG application"
                 IsBusy="@_isProcessing"
                 HasDraftToResume="@_hasDraftToResume"
                 DraftStepIndex="@_draftStepIndex"
                 DraftSavedTimeAgo="@_draftSavedTimeAgo"
                 OnResumeDraft="ResumeDraftAsync"
                 OnDiscardDraft="DiscardDraftAsync"
                 OnCancel="GoBack"
                 OnSaveDraft="SaveDraftAsync"
                 OnFinish="SubmitApplicationAsync">

        <!-- STEP 1: Funding Window & Strategy -->
        <WizardStep Label="Funding window"
                    Heading="Select funding window &amp; grant category"
                    Description="Choose the gazetted Discretionary Grant funding allocation window and intervention type"
                    ValidateAsync="ValidateStep1Async">
            <DgGrantApplicationFields Section="Window"
                                      FundingWindows="@_fundingWindows"
                                      FundingWindowId="@_fundingWindowId"
                                      FundingWindowIdChanged="OnFundingWindowChanged"
                                      GrantTypeCode="@_grantTypeCode"
                                      GrantTypeCodeChanged="@((val) => _grantTypeCode = val)"
                                      ProjectTitle="@_projectTitle"
                                      ProjectTitleChanged="@((val) => _projectTitle = val)" />
        </WizardStep>

        <!-- STEP 2: Applying Organisation Profile -->
        <WizardStep Label="Organisation"
                    Heading="Verify employer profile &amp; levy status"
                    Description="Confirm the legal applying entity, SDL registration number, and WSP compliance status"
                    ValidateAsync="ValidateStep2Async">
            <DgGrantApplicationFields Section="Organisation"
                                      Organisations="@_organisations"
                                      OrganisationId="@_organisationId"
                                      OrganisationIdChanged="OnOrganisationChanged"
                                      SdlNumber="@_sdlNumber"
                                      IsWspCompliant="@_isWspCompliant"
                                      IsWspCompliantChanged="@((val) => _isWspCompliant = val)"
                                      IsWspExempt="@_isWspExempt"
                                      IsWspExemptChanged="@((val) => _isWspExempt = val)"
                                      WspExemptionReason="@_wspExemptionReason"
                                      WspExemptionReasonChanged="@((val) => _wspExemptionReason = val)" />
        </WizardStep>

        <!-- STEP 3: Financial Budget & Learners -->
        <WizardStep Label="Budget &amp; targets"
                    Heading="Define requested budget envelope &amp; beneficiary targets"
                    Description="Specify total funding requested, target learner headcount, and implementation milestones"
                    ValidateAsync="ValidateStep3Async">
            <DgGrantApplicationFields Section="Budget"
                                      RequestedAmount="@_requestedAmount"
                                      RequestedAmountChanged="@((val) => _requestedAmount = val)"
                                      LearnerCount="@_learnerCount"
                                      LearnerCountChanged="@((val) => _learnerCount = val)"
                                      ImplementationPlanSummary="@_implementationPlanSummary"
                                      ImplementationPlanSummaryChanged="@((val) => _implementationPlanSummary = val)" />
        </WizardStep>

        <!-- STEP 4: Statutory Compliance & Consents -->
        <WizardStep Label="Compliance"
                    Heading="Upload statutory compliance details &amp; legal consent"
                    Description="Provide valid SARS Tax Compliance Status PIN, B-BBEE contributor level, and POPIA consent"
                    ValidateAsync="ValidateStep4Async">
            <DgGrantApplicationFields Section="Compliance"
                                      TaxCompliancePin="@_taxCompliancePin"
                                      TaxCompliancePinChanged="@((val) => _taxCompliancePin = val)"
                                      BbbeeLevel="@_bbbeeLevel"
                                      BbbeeLevelChanged="@((val) => _bbbeeLevel = val)"
                                      ConfirmStatutoryCompliance="@_confirmStatutoryCompliance"
                                      ConfirmStatutoryComplianceChanged="@((val) => _confirmStatutoryCompliance = val)"
                                      PopiaConsent="@_popiaConsent"
                                      PopiaConsentChanged="@((val) => _popiaConsent = val)" />
        </WizardStep>

        <!-- STEP 5: Review & Statutory Submission -->
        <WizardReviewStep ReviewGroups="@_reviewGroups"
                          OnEditStep="OnEditStepRequested">
            <LifecycleContent>
                <div class="d-flex align-center gap-3">
                    <MudIcon Icon="@Icons.Material.Filled.Security" Color="Color.Primary" Size="Size.Medium" />
                    <div>
                        <span class="d-block text-body2 font-weight-bold text-primary">
                            Statutory non-repudiation &amp; audit logging
                        </span>
                        <span class="d-block text-caption text-secondary">
                            Submitting this application creates an immutable audited change log entry with a digital security seal.
                        </span>
                    </div>
                </div>
            </LifecycleContent>
        </WizardReviewStep>

    </WizardShell>
}

@code {
    [Parameter] public int? FundingWindowId { get; set; }

    private int _activeStep = 0;
    private bool _loading = true;
    private bool _isProcessing = false;
    private bool _isSuccess = false;
    private int _submittedAppId = 0;
    private string _submittedAppNumber = string.Empty;

    private List<GrantFundingWindow> _fundingWindows = new();
    private List<Organisation> _organisations = new();

    // Step 1
    private int? _fundingWindowId;
    private string _grantTypeCode = "PIVOTAL";
    private string _projectTitle = string.Empty;

    // Step 2
    private int _organisationId;
    private string _sdlNumber = string.Empty;
    private bool _isWspCompliant = true;
    private bool _isWspExempt = false;
    private string? _wspExemptionReason;

    // Step 3
    private decimal _requestedAmount = 350000m;
    private int _learnerCount = 15;
    private string _implementationPlanSummary = string.Empty;

    // Step 4
    private string _taxCompliancePin = string.Empty;
    private string _bbbeeLevel = "Level 2";
    private bool _confirmStatutoryCompliance = false;
    private bool _popiaConsent = false;

    private List<BreadcrumbItem> _breadcrumbs = new()
    {
        new BreadcrumbItem("Home", href: "/"),
        new BreadcrumbItem("Grants, levies & finance", href: "/dg-grants"),
        new BreadcrumbItem("Discretionary Grants (DG)", href: "/dg-grants"),
        new BreadcrumbItem("Apply for DG", href: null, disabled: true)
    };

    private List<WizardReviewGroup> _reviewGroups = new();

    // Draft Persistence & Resume Lifecycle Engine
    private bool _hasDraftToResume = false;
    private int _draftStepIndex = 0;
    private string? _draftSavedTimeAgo;
    private string? _activeDraftKey;
    private WizardDraftSession? _loadedDraft;

    private record DgApplicationDraftModel
    {
        public int? FundingWindowId { get; init; }
        public string GrantTypeCode { get; init; } = "PIVOTAL";
        public string ProjectTitle { get; init; } = string.Empty;
        public int OrganisationId { get; init; }
        public string SdlNumber { get; init; } = string.Empty;
        public bool IsWspCompliant { get; init; } = true;
        public bool IsWspExempt { get; init; } = false;
        public string? WspExemptionReason { get; init; }
        public decimal RequestedAmount { get; init; } = 350000m;
        public int LearnerCount { get; init; } = 15;
        public string ImplementationPlanSummary { get; init; } = string.Empty;
        public string TaxCompliancePin { get; init; } = string.Empty;
        public string BbbeeLevel { get; init; } = "Level 2";
        public bool ConfirmStatutoryCompliance { get; init; } = false;
        public bool PopiaConsent { get; init; } = false;
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _fundingWindows = await GrantService.GetFundingWindowsAsync(activeOnly: true);
            _organisations = await OrgService.GetAllAsync();

            if (FundingWindowId.HasValue && FundingWindowId.Value > 0)
            {
                _fundingWindowId = FundingWindowId.Value;
            }
            else if (_fundingWindows.Any())
            {
                _fundingWindowId = _fundingWindows.First().Id;
            }

            if (_organisations.Any())
            {
                _organisationId = _organisations.First().Id;
                _sdlNumber = _organisations.First().SdlNumber;
            }

            _projectTitle = "Strategic Artisan Development Initiative 2026";
            _implementationPlanSummary = "Cohort recruitment in month 1, accredited theoretical training months 2-4, workplace practical placement months 5-12.";
            _taxCompliancePin = "9823471029";

            // Check for available in-progress draft for the current user
            await CheckForActiveDraftAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error loading funding windows: {ex.Message}", Severity.Error);
        }
        finally
        {
            _loading = false;
            UpdateReviewGroups();
        }
    }

    private void OnFundingWindowChanged(int? id)
    {
        _fundingWindowId = id;
        UpdateReviewGroups();
    }

    private void OnOrganisationChanged(int id)
    {
        _organisationId = id;
        var org = _organisations.FirstOrDefault(o => o.Id == id);
        if (org != null)
        {
            _sdlNumber = org.SdlNumber;
        }
        UpdateReviewGroups();
    }

    private void OnStepChanged(int step)
    {
        _activeStep = step;
        UpdateReviewGroups();
    }

    private void OnEditStepRequested(int targetStep)
    {
        _activeStep = targetStep;
    }

    private Task<bool> ValidateStep1Async()
    {
        if (_fundingWindowId == null || _fundingWindowId <= 0)
        {
            Snackbar.Add("Please select an open Discretionary Grant funding window.", Severity.Warning);
            return Task.FromResult(false);
        }

        if (string.IsNullOrWhiteSpace(_projectTitle))
        {
            Snackbar.Add("Please specify a project title.", Severity.Warning);
            return Task.FromResult(false);
        }

        return Task.FromResult(true);
    }

    private Task<bool> ValidateStep2Async()
    {
        if (_organisationId <= 0)
        {
            Snackbar.Add("Please select an applying employer organisation.", Severity.Warning);
            return Task.FromResult(false);
        }

        if (!_isWspCompliant && !_isWspExempt)
        {
            Snackbar.Add("Organisation must be WSP compliant or specify a statutory exemption reason.", Severity.Warning);
            return Task.FromResult(false);
        }

        if (_isWspExempt && string.IsNullOrWhiteSpace(_wspExemptionReason))
        {
            Snackbar.Add("Please provide the statutory reason for WSP submission exemption.", Severity.Warning);
            return Task.FromResult(false);
        }

        return Task.FromResult(true);
    }

    private Task<bool> ValidateStep3Async()
    {
        if (_requestedAmount <= 0)
        {
            Snackbar.Add("Requested funding amount must be greater than zero.", Severity.Warning);
            return Task.FromResult(false);
        }

        if (_learnerCount <= 0)
        {
            Snackbar.Add("Target learner headcount must be at least 1.", Severity.Warning);
            return Task.FromResult(false);
        }

        if (string.IsNullOrWhiteSpace(_implementationPlanSummary))
        {
            Snackbar.Add("Please provide an implementation plan summary.", Severity.Warning);
            return Task.FromResult(false);
        }

        return Task.FromResult(true);
    }

    private Task<bool> ValidateStep4Async()
    {
        if (string.IsNullOrWhiteSpace(_taxCompliancePin) || _taxCompliancePin.Length < 8)
        {
            Snackbar.Add("Please enter a valid SARS Tax Compliance Status PIN.", Severity.Warning);
            return Task.FromResult(false);
        }

        if (!_confirmStatutoryCompliance)
        {
            Snackbar.Add("You must confirm statutory compliance with the Skills Development Act.", Severity.Warning);
            return Task.FromResult(false);
        }

        if (!_popiaConsent)
        {
            Snackbar.Add("You must consent to POPIA personal information processing.", Severity.Warning);
            return Task.FromResult(false);
        }

        return Task.FromResult(true);
    }

    private void UpdateReviewGroups()
    {
        var window = _fundingWindows.FirstOrDefault(w => w.Id == _fundingWindowId);
        var org = _organisations.FirstOrDefault(o => o.Id == _organisationId);

        _reviewGroups = new List<WizardReviewGroup>
        {
            new()
            {
                Title = "Funding window & grant category",
                Icon = Icons.Material.Filled.EventNote,
                TargetStepIndex = 0,
                Items = new()
                {
                    new("Funding window", window != null ? $"FY{window.FinYear} - {window.WindowName}" : "Not selected"),
                    new("Grant type", _grantTypeCode),
                    new("Project title", _projectTitle)
                }
            },
            new()
            {
                Title = "Employer profile & compliance",
                Icon = Icons.Material.Filled.Business,
                TargetStepIndex = 1,
                Items = new()
                {
                    new("Organisation", org?.CompanyName ?? "Not selected"),
                    new("SDL number", _sdlNumber, isMonospace: true),
                    new("WSP compliance", _isWspCompliant ? "Compliant" : (_isWspExempt ? $"Exempt ({_wspExemptionReason})" : "Non-compliant"))
                }
            },
            new()
            {
                Title = "Budget & implementation targets",
                Icon = Icons.Material.Filled.Payments,
                TargetStepIndex = 2,
                Items = new()
                {
                    new("Requested amount", _requestedAmount.ToString("C2", System.Globalization.CultureInfo.InvariantCulture)),
                    new("Target learners", $"{_learnerCount} beneficiaries"),
                    new("Implementation plan", _implementationPlanSummary)
                }
            },
            new()
            {
                Title = "Statutory declarations",
                Icon = Icons.Material.Filled.VerifiedUser,
                TargetStepIndex = 3,
                Items = new()
                {
                    new("SARS tax PIN", _taxCompliancePin, isMonospace: true),
                    new("B-BBEE level", _bbbeeLevel),
                    new("Statutory consent", _confirmStatutoryCompliance ? "Certified compliant" : "Pending"),
                    new("POPIA consent", _popiaConsent ? "Granted" : "Pending")
                }
            }
        };
    }

    private async Task CheckForActiveDraftAsync()
    {
        try
        {
            var draft = await DraftService.GetActiveDraftAsync("DgGrantApplication", "CurrentSdf", _organisationId > 0 ? _organisationId : null);
            if (draft != null && draft.CurrentStepIndex > 0)
            {
                _loadedDraft = draft;
                _activeDraftKey = draft.DraftKey;
                _draftStepIndex = draft.CurrentStepIndex;
                var delta = DateTime.UtcNow - (draft.ModifiedAt ?? draft.CreatedAt);
                _draftSavedTimeAgo = delta.TotalHours >= 1 ? $"{(int)delta.TotalHours}h ago" : $"{(int)delta.TotalMinutes}m ago";
                _hasDraftToResume = true;
            }
        }
        catch (Exception ex)
        {
            // Non-blocking draft lookup
            Console.WriteLine($"Draft check skipped: {ex.Message}");
        }
    }

    private async Task ResumeDraftAsync()
    {
        if (_loadedDraft == null) return;

        var model = DraftService.DeserializeDraftModel<DgApplicationDraftModel>(_loadedDraft);
        if (model != null)
        {
            _fundingWindowId = model.FundingWindowId;
            _grantTypeCode = model.GrantTypeCode;
            _projectTitle = model.ProjectTitle;
            _organisationId = model.OrganisationId;
            _sdlNumber = model.SdlNumber;
            _isWspCompliant = model.IsWspCompliant;
            _isWspExempt = model.IsWspExempt;
            _wspExemptionReason = model.WspExemptionReason;
            _requestedAmount = model.RequestedAmount;
            _learnerCount = model.LearnerCount;
            _implementationPlanSummary = model.ImplementationPlanSummary;
            _taxCompliancePin = model.TaxCompliancePin;
            _bbbeeLevel = model.BbbeeLevel;
            _confirmStatutoryCompliance = model.ConfirmStatutoryCompliance;
            _popiaConsent = model.PopiaConsent;

            _activeStep = _loadedDraft.CurrentStepIndex;
            _hasDraftToResume = false;
            UpdateReviewGroups();
            Snackbar.Add($"Resumed application draft from Step {_activeStep + 1}.", Severity.Info);
        }
    }

    private async Task DiscardDraftAsync()
    {
        if (!string.IsNullOrWhiteSpace(_activeDraftKey))
        {
            await DraftService.DiscardDraftAsync(_activeDraftKey);
            _hasDraftToResume = false;
            _activeDraftKey = null;
            _loadedDraft = null;
            Snackbar.Add("Draft discarded. You are starting a clean application.", Severity.Normal);
        }
    }

    private async Task SaveDraftAsync()
    {
        _isProcessing = true;
        try
        {
            var draftModel = new DgApplicationDraftModel
            {
                FundingWindowId = _fundingWindowId,
                GrantTypeCode = _grantTypeCode,
                ProjectTitle = _projectTitle,
                OrganisationId = _organisationId,
                SdlNumber = _sdlNumber,
                IsWspCompliant = _isWspCompliant,
                IsWspExempt = _isWspExempt,
                WspExemptionReason = _wspExemptionReason,
                RequestedAmount = _requestedAmount,
                LearnerCount = _learnerCount,
                ImplementationPlanSummary = _implementationPlanSummary,
                TaxCompliancePin = _taxCompliancePin,
                BbbeeLevel = _bbbeeLevel,
                ConfirmStatutoryCompliance = _confirmStatutoryCompliance,
                PopiaConsent = _popiaConsent
            };

            var session = await DraftService.SaveDraftAsync(
                "DgGrantApplication",
                "Discretionary Grant (DG) application",
                "/dg-grants/apply",
                "CurrentSdf",
                _organisationId > 0 ? _organisationId : null,
                _activeStep,
                5,
                draftModel,
                _activeDraftKey
            );

            _activeDraftKey = session.DraftKey;
            _hasDraftToResume = false;
            Snackbar.Add($"Draft saved at Step {_activeStep + 1} ('{session.DraftKey}').", Severity.Info);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Could not save draft: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isProcessing = false;
        }
    }

    private async Task SubmitApplicationAsync()
    {
        _isProcessing = true;
        try
        {
            var app = BuildApplicationEntity("Submitted");
            var result = await GrantService.CreateApplicationAsync(app, "CurrentSdf");
            _submittedAppId = result.Id;
            _submittedAppNumber = result.ApplicationNumber;

            // Clear submitted draft
            if (!string.IsNullOrWhiteSpace(_activeDraftKey))
            {
                await DraftService.MarkAsSubmittedAsync(_activeDraftKey);
            }

            _isSuccess = true;
            Snackbar.Add($"Discretionary Grant (DG) application '{_submittedAppNumber}' submitted successfully!", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Submission failed: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isProcessing = false;
        }
    }

    private GrantApplication BuildApplicationEntity(string status)
    {
        return new GrantApplication
        {
            FundingWindowId = _fundingWindowId,
            OrganisationId = _organisationId,
            ProjectTitle = _projectTitle,
            GrantTypeCode = _grantTypeCode,
            RequestedAmount = _requestedAmount,
            ApplicationStatusCode = status,
            IsWspCompliant = _isWspCompliant,
            IsWspExempt = _isWspExempt,
            WspExemptionReason = _wspExemptionReason,
            ApplicationDate = DateTime.UtcNow
        };
    }

    private void GoBack()
    {
        NavManager.NavigateTo("/dg-grants");
    }

    private void ViewSubmittedGrant()
    {
        NavManager.NavigateTo($"/dg-grants/{_submittedAppId}");
    }
}
