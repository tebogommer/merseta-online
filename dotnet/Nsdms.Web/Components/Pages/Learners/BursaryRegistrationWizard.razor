@page "/learners/register-bursary"
@page "/bursaries/register"
@page "/bursaries"
@page "/learners/bursaries/register"
@using Microsoft.AspNetCore.Authorization
@using Nsdms.Application.Services
@using Nsdms.Application.Common.Utilities
@using Nsdms.Application.Validation
@using Nsdms.Domain.Entities
@using Nsdms.Web.Components.Shared
@using Nsdms.Web.Components.Shared.Wizard
@using MudBlazor
@attribute [Authorize]
@inject ILearnerService LearnerService
@inject IPersonService PersonService
@inject IOrganisationService OrgService
@inject NavigationManager NavManager
@inject ISnackbar Snackbar
@rendermode InteractiveServer

@*
  UI-STANDARD.md Archetype: A4 (Form / Multi-Step Wizard)
  Bursary Registration Application Use Case (Ref: MerSeta\NSDMS\LMS\LR\01)
  Compliant with 16-point UI checklist, WizardShell standard, and dual-path New vs Continuation logic.
*@

<div class="mb-4">
    <div class="d-flex align-center gap-2 mb-2">
        <MudButton Variant="Variant.Text"
                   StartIcon="@Icons.Material.Filled.ArrowBack"
                   Color="Color.Default"
                   OnClick="GoBack">
            Back to learners register
        </MudButton>
        <MudBreadcrumbs Items="_breadcrumbs" Separator=">" Class="pa-0 ma-0" />
    </div>
</div>

@if (_loading)
{
    <div class="d-flex justify-center align-center py-12">
        <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Large" />
    </div>
}
else if (_isSuccess)
{
    <MudCard Elevation="2" Class="pa-6 rounded-lg text-center">
        <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success" Size="Size.Large" Class="mb-3" />
        <h1 class="text-h5 font-weight-bold text-primary mb-2">
            @(_isContinuation ? "Bursary continuation application submitted" : "New bursary application registered")
        </h1>
        <p class="text-body1 text-secondary mb-4">
            Statutory bursary reference <strong class="font-mono">@_registeredContractNo</strong> has been generated and queued for review.
        </p>
        <div class="d-flex justify-center gap-3">
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.AccountCircle"
                       OnClick="ViewRegisteredLearner">
                View learner profile
            </MudButton>
            <MudButton Variant="Variant.Outlined"
                       Color="Color.Default"
                       OnClick="GoBack">
                Return to learners list
            </MudButton>
        </div>
    </MudCard>
}
else
{
    <WizardShell Title="Bursary registration application"
                 Subtitle="Statutory tertiary bursary registration for Higher Education Institutions (HEIs) and TVET Colleges (Use Case MerSeta\NSDMS\LMS\LR\01)"
                 ActiveStepIndex="@_activeStep"
                 ActiveStepIndexChanged="OnStepChanged"
                 FinishButtonText="@(_isContinuation ? "Submit continuation" : "Register bursary")"
                 IsBusy="@_isProcessing"
                 OnCancel="GoBack"
                 OnFinish="SubmitBursaryAsync">

        <!-- STEP 1: Application Type & Learner Profile -->
        <WizardStep Label="Application &amp; Learner"
                    Heading="Application category &amp; learner identification"
                    Description="Select New vs Continuation bursary application and capture learner identity details"
                    ValidateAsync="ValidateStep1Async">
            <MudGrid>
                <MudItem xs="12">
                    <MudText Typo="Typo.subtitle2" Class="mb-1 font-weight-bold">Bursary Application Category</MudText>
                    <MudRadioGroup T="string" Value="@_applicationType" ValueChanged="OnApplicationTypeChanged">
                        <div class="d-flex gap-6">
                            <MudRadio Value="@("New")" Color="Color.Primary">
                                <div>
                                    <strong>New Bursary</strong>
                                    <div class="text-caption text-secondary">Initial bursary award commencing a tertiary qualification</div>
                                </div>
                            </MudRadio>
                            <MudRadio Value="@("Continuation")" Color="Color.Secondary">
                                <div>
                                    <strong>Continuation Bursary</strong>
                                    <div class="text-caption text-secondary">Progression to the next academic year against an existing active bursary</div>
                                </div>
                            </MudRadio>
                        </div>
                    </MudRadioGroup>
                </MudItem>

                @if (_isContinuation)
                {
                    <MudItem xs="12">
                        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="mb-2">
                            <strong>Continuation Precondition:</strong> The learner must have an approved active bursary. Historical qualification and institution records will be locked to prevent unauthorized tampering.
                        </MudAlert>
                    </MudItem>

                    <MudItem xs="12" md="6">
                        <MudSelect T="int"
                                   Label="Select Learner for Continuation *"
                                   Value="@_selectedPersonId"
                                   ValueChanged="OnContinuationLearnerSelectedAsync"
                                   Variant="Variant.Outlined"
                                   Required="true">
                            <MudSelectItem Value="0">-- Select registered learner --</MudSelectItem>
                            @foreach (var p in _availableLearners)
                            {
                                <MudSelectItem Value="@p.Id">@p.FirstName @p.LastName (@(p.RsaIdNumber ?? "Passport: " + p.PassportNumber))</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>

                    @if (_activeBursariesForLearner.Any())
                    {
                        <MudItem xs="12" md="6">
                            <MudSelect T="int"
                                       Label="Select Active Bursary to Continue *"
                                       Value="@_previousEnrolmentId"
                                       ValueChanged="OnActiveBursarySelected"
                                       Variant="Variant.Outlined"
                                       Required="true">
                                <MudSelectItem Value="0">-- Select active contract --</MudSelectItem>
                                @foreach (var b in _activeBursariesForLearner)
                                {
                                    <MudSelectItem Value="@b.Id">@b.LearnerContractNumber - @b.QualificationTitle (Year @(b.YearOfStudy ?? 1), @(b.AcademicYear ?? 2025))</MudSelectItem>
                                }
                            </MudSelect>
                        </MudItem>
                    }
                    else if (_selectedPersonId > 0)
                    {
                        <MudItem xs="12">
                            <MudAlert Severity="Severity.Warning">
                                No active bursary record found for this learner. Continuation applications require an approved prior-year bursary.
                            </MudAlert>
                        </MudItem>
                    }

                    @if (_selectedPriorBursary != null)
                    {
                        <MudItem xs="12">
                            <MudCard Outlined="true" Class="pa-4 rounded-lg bg-surface">
                                <div class="d-flex align-center justify-space-between mb-2">
                                    <MudText Typo="Typo.subtitle1" Color="Color.Primary" Class="font-weight-bold">
                                        <MudIcon Icon="@Icons.Material.Filled.Lock" Size="Size.Small" Class="mr-1" /> Prior Academic Year Record (Locked)
                                    </MudText>
                                    <MudChip T="string" Color="Color.Success" Size="Size.Small">Active Contract: @_selectedPriorBursary.LearnerContractNumber</MudChip>
                                </div>
                                <MudGrid>
                                    <MudItem xs="12" sm="4">
                                        <MudText Typo="Typo.caption" Color="Color.Secondary">Qualification Scope</MudText>
                                        <MudText Typo="Typo.body2" Class="font-weight-medium">@_selectedPriorBursary.QualificationTitle</MudText>
                                    </MudItem>
                                    <MudItem xs="12" sm="4">
                                        <MudText Typo="Typo.caption" Color="Color.Secondary">Institution</MudText>
                                        <MudText Typo="Typo.body2" Class="font-weight-medium">@(_selectedPriorBursary.InstitutionName ?? "Public University / TVET")</MudText>
                                    </MudItem>
                                    <MudItem xs="12" sm="4">
                                        <MudText Typo="Typo.caption" Color="Color.Secondary">Last Year of Study</MudText>
                                        <MudText Typo="Typo.body2" Class="font-weight-medium">Year @(_selectedPriorBursary.YearOfStudy ?? 1) (@(_selectedPriorBursary.AcademicYear ?? 2025))</MudText>
                                    </MudItem>
                                </MudGrid>
                            </MudCard>
                        </MudItem>
                    }
                }
                else
                {
                    <!-- NEW BURSARY: Learner Demographics -->
                    <MudItem xs="12" md="6">
                        <MudTextField @bind-Value="_rsaIdNumber"
                                      Label="RSA National ID Number *"
                                      Variant="Variant.Outlined"
                                      MaxLength="13"
                                      Placeholder="13-digit national ID"
                                      OnBlur="OnRsaIdChanged"
                                      HelperText="Birth date, gender &amp; citizenship calculated automatically"
                                      Required="true" />
                    </MudItem>

                    <MudItem xs="12" md="6">
                        <MudSelect T="string"
                                   Label="Employment Status *"
                                   @bind-Value="_employmentStatus"
                                   Variant="Variant.Outlined"
                                   Required="true">
                            <MudSelectItem Value="@("Unemployed")">Unemployed (18.2 Learner - No Employer details required)</MudSelectItem>
                            <MudSelectItem Value="@("Employed")">Employed (18.1 Learner - Sponsoring Employer mandatory)</MudSelectItem>
                        </MudSelect>
                    </MudItem>

                    <MudItem xs="12" md="6">
                        <MudTextField @bind-Value="_firstName"
                                      Label="First Name *"
                                      Variant="Variant.Outlined"
                                      Required="true" />
                    </MudItem>

                    <MudItem xs="12" md="6">
                        <MudTextField @bind-Value="_lastName"
                                      Label="Last Name / Surname *"
                                      Variant="Variant.Outlined"
                                      Required="true" />
                    </MudItem>

                    <MudItem xs="12" md="4">
                        <MudTextField @bind-Value="_dateOfBirthDisplay"
                                      Label="Date of Birth"
                                      Variant="Variant.Outlined"
                                      ReadOnly="true" />
                    </MudItem>

                    <MudItem xs="12" md="4">
                        <MudTextField @bind-Value="_gender"
                                      Label="Gender"
                                      Variant="Variant.Outlined"
                                      ReadOnly="true" />
                    </MudItem>

                    <MudItem xs="12" md="4">
                        <MudSelect T="string"
                                   Label="Equity / Population Group *"
                                   @bind-Value="_equityGroup"
                                   Variant="Variant.Outlined"
                                   Required="true">
                            <MudSelectItem Value="@("African")">African</MudSelectItem>
                            <MudSelectItem Value="@("Coloured")">Coloured</MudSelectItem>
                            <MudSelectItem Value="@("Indian")">Indian</MudSelectItem>
                            <MudSelectItem Value="@("White")">White</MudSelectItem>
                        </MudSelect>
                    </MudItem>

                    @if (_isMinor)
                    {
                        <MudItem xs="12">
                            <MudAlert Severity="Severity.Warning" Class="my-2">
                                <strong>Minor Co-Signatory Requirement:</strong> Learner is under 18 years of age. A parent or legal guardian is legally required to co-sign this bursary agreement.
                            </MudAlert>
                        </MudItem>

                        <MudItem xs="12" md="4">
                            <MudTextField @bind-Value="_guardianFullName"
                                          Label="Parent / Guardian Full Name *"
                                          Variant="Variant.Outlined"
                                          Required="true" />
                        </MudItem>
                        <MudItem xs="12" md="4">
                            <MudTextField @bind-Value="_guardianIdNumber"
                                          Label="Guardian RSA ID / Passport *"
                                          Variant="Variant.Outlined"
                                          Required="true" />
                        </MudItem>
                        <MudItem xs="12" md="4">
                            <MudTextField @bind-Value="_guardianContactNumber"
                                          Label="Guardian Telephone / Mobile *"
                                          Variant="Variant.Outlined"
                                          Required="true" />
                        </MudItem>
                    }
                }
            </MudGrid>
        </WizardStep>

        <!-- STEP 2: Educational Institution & Academic Scope -->
        <WizardStep Label="Institution &amp; Study Scope"
                    Heading="Educational institution &amp; qualification details"
                    Description="Capture tertiary institution, qualification degree/diploma, and academic progression year"
                    ValidateAsync="ValidateStep2Async">
            <MudGrid>
                <MudItem xs="12" md="4">
                    <MudSelect T="string"
                               Label="Educational Institution Type *"
                               @bind-Value="_institutionType"
                               Variant="Variant.Outlined"
                               Required="true">
                        <MudSelectItem Value="@("PublicUniversity")">Public University (HEI)</MudSelectItem>
                        <MudSelectItem Value="@("TvetCollege")">TVET College</MudSelectItem>
                        <MudSelectItem Value="@("PrivateHEI")">Private Higher Education Institution</MudSelectItem>
                    </MudSelect>
                </MudItem>

                <MudItem xs="12" md="8">
                    <MudTextField @bind-Value="_institutionName"
                                  Label="Institution Name *"
                                  Variant="Variant.Outlined"
                                  Placeholder="e.g. University of Johannesburg, Tshwane South TVET College"
                                  Required="true" />
                </MudItem>

                <MudItem xs="12" md="8">
                    <MudTextField @bind-Value="_qualificationTitle"
                                  Label="Degree / Diploma / Qualification Title *"
                                  Variant="Variant.Outlined"
                                  Placeholder="e.g. BSc Mechanical Engineering, Diploma in Mechatronics"
                                  ReadOnly="_isContinuation"
                                  Required="true" />
                </MudItem>

                <MudItem xs="12" md="4">
                    <MudNumericField T="int?"
                                     @bind-Value="_saqaQualificationId"
                                     Label="SAQA Qualification ID (Optional)"
                                     Variant="Variant.Outlined"
                                     Min="1000"
                                     Max="999999" />
                </MudItem>

                <MudItem xs="12" md="4">
                    <MudSelect T="int?"
                               Label="Academic Year of Study *"
                               @bind-Value="_yearOfStudy"
                               Variant="Variant.Outlined"
                               Required="true">
                        <MudSelectItem T="int?" Value="@(1)">1st Year of Study</MudSelectItem>
                        <MudSelectItem T="int?" Value="@(2)">2nd Year of Study</MudSelectItem>
                        <MudSelectItem T="int?" Value="@(3)">3rd Year of Study</MudSelectItem>
                        <MudSelectItem T="int?" Value="@(4)">4th Year of Study</MudSelectItem>
                        <MudSelectItem T="int?" Value="@(5)">Honours Year</MudSelectItem>
                        <MudSelectItem T="int?" Value="@(6)">Masters Year</MudSelectItem>
                        <MudSelectItem T="int?" Value="@(7)">Doctoral Year</MudSelectItem>
                    </MudSelect>
                </MudItem>

                <MudItem xs="12" md="4">
                    <MudNumericField T="int?"
                                     @bind-Value="_academicYear"
                                     Label="Funding Academic Year *"
                                     Variant="Variant.Outlined"
                                     Min="2024"
                                     Max="2030"
                                     Required="true" />
                </MudItem>

                <MudItem xs="12" md="4">
                    <MudDatePicker @bind-Date="_commencementDate"
                                   Label="Commencement Date *"
                                   Variant="Variant.Outlined"
                                   Required="true" />
                </MudItem>
            </MudGrid>
        </WizardStep>

        <!-- STEP 3: Employer & Funding Source (Conditional Gating) -->
        <WizardStep Label="Employer &amp; Funding"
                    Heading="Funding source &amp; sponsoring employer"
                    Description="Select from the 7 statutory funding categories and conditionally assign employer details"
                    ValidateAsync="ValidateStep3Async">
            <MudGrid>
                @if (_employmentStatus == "Unemployed")
                {
                    <MudItem xs="12">
                        <MudAlert Severity="Severity.Normal" Variant="Variant.Filled" Class="mb-3" Icon="@Icons.Material.Filled.VerifiedUser">
                            <strong>Statutory Employer Waiver Applied:</strong> In accordance with Section 5 (Business Rules) of the signed Bursary Specification, host employer details (Levy number, organisation name, contact person, physical &amp; postal addresses) are <strong>waived for unemployed bursars</strong>.
                        </MudAlert>
                    </MudItem>
                }
                else
                {
                    <MudItem xs="12">
                        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="mb-2">
                            <strong>Employed Bursar:</strong> Employer details are mandatory for employed applicants (Section 5 Item 13).
                        </MudAlert>
                    </MudItem>

                    <MudItem xs="12" md="6">
                        <MudSelect T="int?"
                                   Label="Sponsoring Employer Organisation *"
                                   @bind-Value="_selectedOrganisationId"
                                   Variant="Variant.Outlined"
                                   Required="true">
                            <MudSelectItem T="int?" Value="@((int?)null)">-- Select Employer --</MudSelectItem>
                            @foreach (var org in _employers)
                            {
                                <MudSelectItem T="int?" Value="@org.Id">@org.CompanyName (@org.SdlNumber)</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>

                    <MudItem xs="12" md="6">
                        <MudTextField @bind-Value="_employerContactPerson"
                                      Label="Employer Contact Person *"
                                      Variant="Variant.Outlined"
                                      Required="true" />
                    </MudItem>
                }

                <MudItem xs="12">
                    <MudText Typo="Typo.subtitle2" Class="mb-1 font-weight-bold">Statutory Bursary Funding Category *</MudText>
                    <MudSelect T="string"
                               Label="Select Statutory Funding Vehicle *"
                               @bind-Value="_bursaryFundingType"
                               Variant="Variant.Outlined"
                               Required="true">
                        <MudSelectItem Value="@("01")">01 - merSETA funded (Direct discretionary bursary allocation)</MudSelectItem>
                        <MudSelectItem Value="@("02")">02 - Non-merSETA funded (External donor / partner sponsored)</MudSelectItem>
                        <MudSelectItem Value="@("03")">03 - Employer funded (Host employer corporate sponsored)</MudSelectItem>
                        <MudSelectItem Value="@("04")">04 - Learner funded (Self-funded bursary / private study)</MudSelectItem>
                        <MudSelectItem Value="@("05")">05 - Other SETA funded (Inter-SETA strategic bursary)</MudSelectItem>
                        <MudSelectItem Value="@("06")">06 - NSF funded (National Skills Fund statutory allocation)</MudSelectItem>
                        <MudSelectItem Value="@("07")">07 - Industry funded (Industrial association / chamber bursary)</MudSelectItem>
                    </MudSelect>
                </MudItem>
            </MudGrid>
        </WizardStep>

        <!-- STEP 4: Statutory Document Vault Matrix (Section 9.1.2) -->
        <WizardStep Label="Document Vault"
                    Heading="Evidentiary documentation checklist"
                    Description="Upload mandatory statutory documents determined dynamically by application and employment status"
                    ValidateAsync="ValidateStep4Async">
            <MudGrid>
                <MudItem xs="12">
                    <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="mb-2">
                        <strong>Document Matrix (Section 9.1.2):</strong> All mandatory documents must be confirmed attached before submission sign-off.
                    </MudAlert>
                </MudItem>

                @foreach (var doc in _requiredDocuments)
                {
                    <MudItem xs="12">
                        <MudCard Outlined="true" Class="pa-3 mb-2">
                            <div class="d-flex align-center justify-space-between">
                                <div>
                                    <MudText Typo="Typo.subtitle2" Color="Color.Primary">
                                        <MudIcon Icon="@Icons.Material.Filled.AttachFile" Size="Size.Small" Class="mr-1" />
                                        @doc.DocumentName
                                    </MudText>
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">
                                        Reference Code: <strong class="font-mono">@doc.DocumentCode</strong> | Status: @(doc.IsMandatory ? "Mandatory" : "Optional")
                                    </MudText>
                                </div>
                                <MudCheckBox T="bool"
                                             Value="@_attachedDocumentCodes.Contains(doc.DocumentCode)"
                                             ValueChanged="@((val) => OnDocumentToggle(doc.DocumentCode, val))"
                                             Color="Color.Success"
                                             Label="Confirmed Attached" />
                            </div>
                        </MudCard>
                    </MudItem>
                }
            </MudGrid>
        </WizardStep>

        <!-- STEP 5: Review & Statutory Sign-off -->
        <WizardReviewStep ReviewGroups="@_reviewGroups"
                          OnEditStep="OnEditStepRequested">
            <LifecycleContent>
                <div class="d-flex align-center gap-3">
                    <MudIcon Icon="@Icons.Material.Filled.Verified" Color="Color.Primary" Size="Size.Medium" />
                    <div>
                        <MudText Typo="Typo.subtitle2" Class="font-weight-bold">Statutory Bursary Attestation &amp; Sign-off</MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">
                            Submission adheres to the 30-working-day statutory limit from learner signature date.
                        </MudText>
                    </div>
                </div>

                <div class="d-flex flex-column gap-3 mt-4">
                    <MudDatePicker @bind-Date="_learnerSignatureDate"
                                   Label="Learner Agreement Execution Date *"
                                   Variant="Variant.Outlined"
                                   DateFormat="yyyy-MM-dd"
                                   Required="true" />

                    @{
                        var workingDays = LearnerEnrolmentDomainValidator.CalculateWorkingDays(_learnerSignatureDate ?? DateTime.UtcNow, DateTime.UtcNow);
                    }
                    <div class="d-flex align-center gap-2">
                        <MudText Typo="Typo.body2">Submission Window Elapsed:</MudText>
                        @if (workingDays <= 30)
                        {
                            <MudChip T="string" Color="Color.Success" Size="Size.Small">@workingDays / 30 Working Days (Compliant)</MudChip>
                        }
                        else
                        {
                            <MudChip T="string" Color="Color.Error" Size="Size.Small">@workingDays Working Days (Exceeded - Condonation Required)</MudChip>
                        }
                    </div>

                    <MudCheckBox T="bool"
                                 @bind-Value="_declarationConfirmed"
                                 Color="Color.Primary"
                                 Label="I hereby declare that the information provided is accurate and all mandatory evidentiary documents have been verified against merSETA statutory bursary criteria." />
                </div>
            </LifecycleContent>
        </WizardReviewStep>
    </WizardShell>
}

@code {
    private bool _loading = true;
    private bool _isProcessing = false;
    private bool _isSuccess = false;
    private string _registeredContractNo = string.Empty;
    private int _createdLearnerId = 0;
    private int _activeStep = 0;

    // Form model fields
    private string _applicationType = "New";
    private bool _isContinuation => _applicationType == "Continuation";
    private string _employmentStatus = "Unemployed";
    private int _selectedPersonId = 0;
    private int _previousEnrolmentId = 0;
    private int _previousCompanyLearnerId => _previousEnrolmentId;
    private CompanyLearner? _selectedPriorBursary = null;

    // Learner Demographics
    private string _rsaIdNumber = string.Empty;
    private string _firstName = string.Empty;
    private string _lastName = string.Empty;
    private string _equityGroup = "African";
    private string _gender = "Unknown";
    private string _dateOfBirthDisplay = string.Empty;
    private DateTime? _dateOfBirth = null;
    private bool _isMinor = false;
    private string _guardianFullName = string.Empty;
    private string _guardianIdNumber = string.Empty;
    private string _guardianContactNumber = string.Empty;

    // Institution & Scope
    private string _institutionType = "PublicUniversity";
    private string _institutionName = string.Empty;
    private string _qualificationTitle = string.Empty;
    private int? _saqaQualificationId = null;
    private int? _yearOfStudy = 1;
    private int? _academicYear = DateTime.UtcNow.Year;
    private DateTime? _commencementDate = DateTime.UtcNow;

    // Employer & Funding
    private int? _selectedOrganisationId = null;
    private string _employerContactPerson = string.Empty;
    private string _bursaryFundingType = "01";

    // Documents & Attestation
    private HashSet<string> _attachedDocumentCodes = new();
    private List<BursaryDocumentRequirement> _requiredDocuments = new();
    private DateTime? _learnerSignatureDate = DateTime.UtcNow;
    private bool _declarationConfirmed = false;

    // Data Lookups
    private List<Person> _availableLearners = new();
    private List<CompanyLearner> _activeBursariesForLearner = new();
    private List<Organisation> _employers = new();
    private List<BreadcrumbItem> _breadcrumbs = new();
    private List<WizardReviewGroup> _reviewGroups = new();

    protected override async Task OnInitializedAsync()
    {
        _breadcrumbs = new List<BreadcrumbItem>
        {
            new("Home", "/"),
            new("Learners", "/learners"),
            new("Bursary Application", "/learners/register-bursary", disabled: true)
        };

        await LoadDataAsync();
        UpdateDocumentChecklist();
        UpdateReviewGroups();
        _loading = false;
    }

    private async Task LoadDataAsync()
    {
        _employers = await OrgService.GetAllAsync();
        _availableLearners = await PersonService.GetAllAsync();
    }

    private void OnApplicationTypeChanged(string val)
    {
        _applicationType = val;
        if (_applicationType == "New")
        {
            _previousEnrolmentId = 0;
            _selectedPriorBursary = null;
            _activeBursariesForLearner.Clear();
        }
        UpdateDocumentChecklist();
        UpdateReviewGroups();
    }

    private async Task OnContinuationLearnerSelectedAsync(int personId)
    {
        _selectedPersonId = personId;
        _activeBursariesForLearner.Clear();
        _selectedPriorBursary = null;
        _previousEnrolmentId = 0;

        if (_selectedPersonId > 0)
        {
            var p = _availableLearners.FirstOrDefault(x => x.Id == _selectedPersonId);
            if (p != null)
            {
                _firstName = p.FirstName;
                _lastName = p.LastName;
                _rsaIdNumber = p.RsaIdNumber ?? string.Empty;
            }

            _activeBursariesForLearner = await LearnerService.GetActiveBursariesForPersonAsync(_selectedPersonId);
            if (_activeBursariesForLearner.Count == 1)
            {
                OnActiveBursarySelected(_activeBursariesForLearner[0].Id);
            }
        }
        UpdateReviewGroups();
    }

    private void OnActiveBursarySelected(int bursaryId)
    {
        _previousEnrolmentId = bursaryId;
        _selectedPriorBursary = _activeBursariesForLearner.FirstOrDefault(b => b.Id == bursaryId);
        if (_selectedPriorBursary != null)
        {
            _qualificationTitle = _selectedPriorBursary.QualificationTitle ?? string.Empty;
            _institutionName = _selectedPriorBursary.InstitutionName ?? string.Empty;
            _institutionType = _selectedPriorBursary.InstitutionTypeCode ?? "PublicUniversity";
            _yearOfStudy = (_selectedPriorBursary.YearOfStudy ?? 1) + 1;
            _academicYear = (_selectedPriorBursary.AcademicYear ?? DateTime.UtcNow.Year) + 1;
            _bursaryFundingType = _selectedPriorBursary.BursaryFundingTypeCode ?? "01";
            _employmentStatus = _selectedPriorBursary.EmploymentStatusCode ?? "Unemployed";
            _selectedOrganisationId = _selectedPriorBursary.OrganisationId;
        }
        UpdateDocumentChecklist();
        UpdateReviewGroups();
    }

    private void OnRsaIdChanged()
    {
        if (!string.IsNullOrWhiteSpace(_rsaIdNumber))
        {
            var result = RsaIdValidator.Parse(_rsaIdNumber);
            if (result.IsValid && result.DateOfBirth.HasValue)
            {
                _dateOfBirth = result.DateOfBirth;
                _dateOfBirthDisplay = result.DateOfBirth.Value.ToString("yyyy-MM-dd");
                _gender = result.Gender ?? "Unknown";

                var age = (DateTime.UtcNow - result.DateOfBirth.Value).TotalDays / 365.25;
                _isMinor = age < 18.0;
            }
        }
        UpdateReviewGroups();
    }

    private void UpdateDocumentChecklist()
    {
        _requiredDocuments = LearnerEnrolmentDomainValidator.GetRequiredBursaryDocuments(_applicationType, _employmentStatus);
    }

    private void OnDocumentToggle(string code, bool attached)
    {
        if (attached)
        {
            _attachedDocumentCodes.Add(code);
        }
        else
        {
            _attachedDocumentCodes.Remove(code);
        }
        UpdateReviewGroups();
    }

    private Task<bool> ValidateStep1Async()
    {
        if (_isContinuation)
        {
            if (_selectedPersonId <= 0)
            {
                Snackbar.Add("Please select a registered learner for continuation.", Severity.Warning);
                return Task.FromResult(false);
            }
            if (_previousEnrolmentId <= 0)
            {
                Snackbar.Add("Please select an active bursary to continue.", Severity.Warning);
                return Task.FromResult(false);
            }
            return Task.FromResult(true);
        }

        if (string.IsNullOrWhiteSpace(_rsaIdNumber) || _rsaIdNumber.Length < 13)
        {
            Snackbar.Add("A valid 13-digit RSA National ID is required.", Severity.Warning);
            return Task.FromResult(false);
        }
        if (string.IsNullOrWhiteSpace(_firstName) || string.IsNullOrWhiteSpace(_lastName))
        {
            Snackbar.Add("Learner first name and last name are required.", Severity.Warning);
            return Task.FromResult(false);
        }
        if (_isMinor && (string.IsNullOrWhiteSpace(_guardianFullName) || string.IsNullOrWhiteSpace(_guardianContactNumber)))
        {
            Snackbar.Add("Parent/Guardian details are required for minor learners under 18.", Severity.Warning);
            return Task.FromResult(false);
        }

        return Task.FromResult(true);
    }

    private Task<bool> ValidateStep2Async()
    {
        if (string.IsNullOrWhiteSpace(_institutionName))
        {
            Snackbar.Add("Educational institution name is required.", Severity.Warning);
            return Task.FromResult(false);
        }
        if (string.IsNullOrWhiteSpace(_qualificationTitle))
        {
            Snackbar.Add("Qualification / Degree title is required.", Severity.Warning);
            return Task.FromResult(false);
        }
        if (!_yearOfStudy.HasValue || _yearOfStudy.Value <= 0)
        {
            Snackbar.Add("Please select a valid academic year of study.", Severity.Warning);
            return Task.FromResult(false);
        }
        return Task.FromResult(true);
    }

    private Task<bool> ValidateStep3Async()
    {
        if (_employmentStatus == "Employed" && (!_selectedOrganisationId.HasValue || _selectedOrganisationId.Value <= 0))
        {
            Snackbar.Add("Host employer organisation is required for employed bursars.", Severity.Warning);
            return Task.FromResult(false);
        }
        if (string.IsNullOrWhiteSpace(_bursaryFundingType))
        {
            Snackbar.Add("Please select a statutory bursary funding category.", Severity.Warning);
            return Task.FromResult(false);
        }
        return Task.FromResult(true);
    }

    private Task<bool> ValidateStep4Async()
    {
        var mandatoryMissing = _requiredDocuments.Where(d => d.IsMandatory && !_attachedDocumentCodes.Contains(d.DocumentCode)).ToList();
        if (mandatoryMissing.Any())
        {
            Snackbar.Add($"Missing required documents: {string.Join(", ", mandatoryMissing.Select(m => m.DocumentName))}", Severity.Warning);
            return Task.FromResult(false);
        }
        return Task.FromResult(true);
    }

    private async Task SubmitBursaryAsync()
    {
        if (!_declarationConfirmed)
        {
            Snackbar.Add("Please confirm the statutory declaration before submitting.", Severity.Warning);
            return;
        }

        if (!_learnerSignatureDate.HasValue)
        {
            Snackbar.Add("Please capture the agreement execution signature date.", Severity.Warning);
            return;
        }

        _isProcessing = true;
        try
        {
            int personId = _selectedPersonId;
            if (personId <= 0)
            {
                var person = new Person
                {
                    FirstName = _firstName,
                    LastName = _lastName,
                    RsaIdNumber = _rsaIdNumber,
                    DateOfBirth = _dateOfBirth,
                    Gender = _gender,
                    EquityCode = _equityGroup
                };

                if (_isMinor)
                {
                    person.Guardians.Add(new PersonGuardian
                    {
                        GuardianFullName = _guardianFullName,
                        GuardianIdNumber = _guardianIdNumber,
                        ContactNumber = _guardianContactNumber,
                        RelationshipTypeId = "Parent / Legal Guardian",
                        IsActive = true
                    });
                }

                var createdPerson = await PersonService.CreateAsync(person);
                personId = createdPerson.Id;
            }

            var enrolment = new LearnerEnrolment
            {
                PersonId = personId,
                OrganisationId = _selectedOrganisationId,
                LearningProgrammeTypeCode = "05",
                BursaryApplicationTypeCode = _applicationType,
                IsContinuation = _isContinuation,
                PreviousEnrolmentId = _previousEnrolmentId > 0 ? _previousEnrolmentId : null,
                QualificationTitle = _qualificationTitle,
                SaqaQualificationId = _saqaQualificationId,
                InstitutionName = _institutionName,
                InstitutionTypeCode = _institutionType,
                AcademicYear = _academicYear,
                YearOfStudy = _yearOfStudy,
                BursaryFundingTypeCode = _bursaryFundingType,
                EmploymentStatusCode = _employmentStatus,
                EconomicStatusId = _employmentStatus == "Employed" ? "01" : "02",
                CommencementDate = _commencementDate,
                LearnerSignatureDate = _learnerSignatureDate,
                SubmissionDate = DateTime.UtcNow,
                EnrolmentStatusCode = "Registered",
                EnrolmentStatusId = "01",
                IsActive = true
            };

            var registered = await LearnerService.RegisterBursaryApplicationAsync(enrolment);
            _registeredContractNo = registered.LearnerContractNumber ?? ("BUR-" + registered.Id);
            _createdLearnerId = registered.Id;
            _isSuccess = true;

            Snackbar.Add($"Bursary application {_registeredContractNo} successfully registered!", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Registration error: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isProcessing = false;
        }
    }

    private void UpdateReviewGroups()
    {
        _reviewGroups = new List<WizardReviewGroup>
        {
            new()
            {
                Title = "Application & Learner",
                Icon = Icons.Material.Filled.Person,
                TargetStepIndex = 0,
                Items = new()
                {
                    new("Application Category", _applicationType),
                    new("Learner Name", $"{_firstName} {_lastName}".Trim()),
                    new("National ID", _rsaIdNumber),
                    new("Employment Standing", _employmentStatus)
                }
            },
            new()
            {
                Title = "Institution & Scope",
                Icon = Icons.Material.Filled.School,
                TargetStepIndex = 1,
                Items = new()
                {
                    new("Institution Name", _institutionName),
                    new("Institution Type", _institutionType),
                    new("Qualification Title", _qualificationTitle),
                    new("Year of Study", $"Year {_yearOfStudy} ({_academicYear})")
                }
            },
            new()
            {
                Title = "Employer & Funding",
                Icon = Icons.Material.Filled.Apartment,
                TargetStepIndex = 2,
                Items = new()
                {
                    new("Employer Requirement", _employmentStatus == "Unemployed" ? "Waived (Unemployed)" : (_selectedOrganisationId.HasValue ? $"Organisation #{_selectedOrganisationId}" : "Pending")),
                    new("Funding Category", _bursaryFundingType)
                }
            },
            new()
            {
                Title = "Evidentiary Documents",
                Icon = Icons.Material.Filled.Attachment,
                TargetStepIndex = 3,
                Items = new()
                {
                    new("Attached Documents", $"{_attachedDocumentCodes.Count} of {_requiredDocuments.Count} verified")
                }
            }
        };
    }

    private void OnStepChanged(int step) => _activeStep = step;
    private void OnEditStepRequested(int step) => _activeStep = step;
    private void GoBack() => NavManager.NavigateTo("/learners");
    private void ViewRegisteredLearner() => NavManager.NavigateTo($"/learners/{_createdLearnerId}");
}
