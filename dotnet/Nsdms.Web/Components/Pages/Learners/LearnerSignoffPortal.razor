@page "/signoff/learner"
@page "/signoff/learner/{Token}"
@using Nsdms.Application.Common
@using Nsdms.Application.Common.Interfaces
@using Nsdms.Application.Services
@using Nsdms.Domain.Entities
@using Nsdms.Web.Components.Shared
@using MudBlazor
@inject ILearnerService LearnerService
@inject ILearnerLifecycleService LifecycleService
@inject IAuditService AuditService
@inject NavigationManager NavManager
@inject ISnackbar Snackbar
@rendermode InteractiveServer

@*
  UI-STANDARD.md Archetype: A4 / Self-Service Landing (Learner & Employer OTP Agreement Execution Portal)
  Clauses: 4.2, 4.3, 6.1, 7.2, 8.1, 8.3, 11.1–11.9, 15.2.5
*@

<PageTitle>Learner Tripartite Agreement Digital Sign-Off - NSDMS</PageTitle>

<EntityHeader Title="Paperless Tripartite Agreement Digital Execution Portal"
              Subtitle="Secure OTP-authenticated digital signature execution for learners, host employers, and accredited providers"
              ReferenceKey="A4-SIGNOFF"
              Status="OTP Gateway Active"
              BreadcrumbItems="@_breadcrumbs">
    <ActionZone>
        <MudButton Variant="Variant.Outlined"
                   Color="Color.Secondary"
                   StartIcon="@Icons.Material.Filled.ArrowBack"
                   OnClick="@(() => NavManager.NavigateTo("/learners"))"
                   aria-label="Back to Learners Hub">
            Back to Learners
        </MudButton>
        @if (_isOtpVerified && !_isExecuted)
        {
            <MudButton Variant="Variant.Filled"
                       Color="Color.Success"
                       StartIcon="@Icons.Material.Filled.Draw"
                       OnClick="ExecuteDigitalSignoff"
                       Disabled="_isExecuting"
                       aria-label="Execute Digital Signature">
                @(_isExecuting ? "Executing Signature..." : "Sign & Execute Agreement")
            </MudButton>
        }
    </ActionZone>
</EntityHeader>

<MudContainer MaxWidth="MaxWidth.Medium" Class="pa-0 mt-4">
    @if (_isExecuted)
    {
        <MudCard Elevation="3" Class="rounded-lg mb-6 border-success">
            <MudCardContent Class="text-center pa-8">
                <MudAvatar Color="Color.Success" Variant="Variant.Filled" Size="Size.Large" Class="mx-auto mb-4" Style="height: 72px; width: 72px;">
                    <MudIcon Icon="@Icons.Material.Filled.Verified" Size="Size.Large" />
                </MudAvatar>
                <MudText Typo="Typo.h5" Class="fw-bold text-success mb-2">Tripartite Learnership Agreement Executed</MudText>
                <MudText Typo="Typo.body1" Class="mb-4">
                    The contract for <strong>@_learnerName</strong> has been formally signed and legally sealed under Digital Security Seal:
                </MudText>
                <MudPaper Outlined="true" Class="pa-3 mb-4 mx-auto font-monospace text-center" Style="max-width: 500px; background-color: var(--mud-palette-background-grey);">
                    <MudText Typo="Typo.caption" Class="fw-bold">@_securitySeal</MudText>
                </MudPaper>
                <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-6">
                    Executed on @DateTime.UtcNow.ToString("dd MMMM yyyy HH:mm") UTC by authorised signatory OTP: <strong>@_verifiedOtp</strong>
                </MudText>
                <div class="d-flex justify-center gap-3">
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.PictureAsPdf" OnClick="DownloadSignedPdf">
                        Download Executed Contract (PDF)
                    </MudButton>
                    <MudButton Variant="Variant.Outlined" Color="Color.Secondary" OnClick="@(() => NavManager.NavigateTo("/learners"))">
                        Return to Learners Registry
                    </MudButton>
                </div>
            </MudCardContent>
        </MudCard>
    }
    else if (!_isOtpVerified)
    {
        <!-- Step 1: OTP Authentication Card -->
        <MudCard Elevation="2" Class="rounded-lg mb-6">
            <MudCardHeader Class="pb-2">
                <CardHeaderAvatar>
                    <MudAvatar Color="Color.Primary" Variant="Variant.Filled">
                        <MudIcon Icon="@Icons.Material.Filled.VpnKey" />
                    </MudAvatar>
                </CardHeaderAvatar>
                <CardHeaderContent>
                    <MudText Typo="Typo.h6">Digital Token Authentication</MudText>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Enter your Learner Contract Reference or the 6-digit One-Time PIN (OTP) sent to your registered mobile number or email.</MudText>
                </CardHeaderContent>
            </MudCardHeader>
            <MudCardContent>
                <MudGrid Spacing="3">
                    <MudItem xs="12" sm="6">
                        <MudTextField T="string"
                                      Label="Learner Contract Reference / RSA ID"
                                      @bind-Value="_contractRef"
                                      Variant="Variant.Outlined"
                                      Placeholder="e.g. LRN-2026-0042 or 9405125088081"
                                      Required="true" />
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudTextField T="string"
                                      Label="6-Digit OTP Token"
                                      @bind-Value="_enteredOtp"
                                      Variant="Variant.Outlined"
                                      Placeholder="e.g. 784219"
                                      MaxLength="6"
                                      Required="true" />
                    </MudItem>
                    <MudItem xs="12">
                        <MudAlert Severity="Severity.Info" Dense="true" Class="mb-2">
                            A verification token was automatically generated for this registration session. (Demo OTP: <strong>784219</strong>).
                        </MudAlert>
                    </MudItem>
                </MudGrid>
            </MudCardContent>
            <MudCardActions Class="pa-4 d-flex justify-end gap-2 bg-surface">
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.LockOpen"
                           OnClick="VerifyOtp">
                    Verify &amp; Access Contract
                </MudButton>
            </MudCardActions>
        </MudCard>
    }
    else
    {
        <!-- Step 2: Contract Review & Electronic Execution -->
        <MudCard Elevation="2" Class="rounded-lg mb-6">
            <MudCardHeader Class="pb-2">
                <CardHeaderAvatar>
                    <MudAvatar Color="Color.Success" Variant="Variant.Filled">
                        <MudIcon Icon="@Icons.Material.Filled.Article" />
                    </MudAvatar>
                </CardHeaderAvatar>
                <CardHeaderContent>
                    <MudText Typo="Typo.h6">Tripartite Agreement Contract Summary</MudText>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Please inspect all statutory terms, stipend allowances, and workplace parameters before signing.</MudText>
                </CardHeaderContent>
            </MudCardHeader>
            <MudCardContent>
                <MudGrid Spacing="3">
                    <MudItem xs="12" sm="6">
                        <MudPaper Outlined="true" Class="pa-3">
                            <MudText Typo="Typo.caption" Color="Color.Secondary">Learner Candidate</MudText>
                            <div class="fw-bold">@_learnerName</div>
                            <div class="text-muted small">RSA ID: @_learnerIdNumber</div>
                        </MudPaper>
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudPaper Outlined="true" Class="pa-3">
                            <MudText Typo="Typo.caption" Color="Color.Secondary">Host Employer / Workplace</MudText>
                            <div class="fw-bold">@_employerName</div>
                            <div class="text-muted small">SDL Number: @_employerSdl</div>
                        </MudPaper>
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudPaper Outlined="true" Class="pa-3">
                            <MudText Typo="Typo.caption" Color="Color.Secondary">Occupational Qualification</MudText>
                            <div class="fw-bold">@_qualificationTitle</div>
                            <div class="text-muted small">NQF Level 4 | 140 Credits</div>
                        </MudPaper>
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudPaper Outlined="true" Class="pa-3">
                            <MudText Typo="Typo.caption" Color="Color.Secondary">Monthly Statutory Stipend</MudText>
                            <div class="fw-bold text-success">R 5,500.00 / month</div>
                            <div class="text-muted small">Paid by Host Employer / DG Tranche</div>
                        </MudPaper>
                    </MudItem>
                    <MudItem xs="12">
                        <MudPaper Outlined="true" Class="pa-4 bg-surface mt-2">
                            <MudText Typo="Typo.subtitle2" Class="fw-bold mb-2">Legal Undertaking &amp; Code of Conduct</MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="d-block mb-3">
                                In terms of Section 17 of the Skills Development Act 97 of 1998, the Employer agrees to provide practical workplace training and the Learner agrees to attend off-the-job theoretical tuition and keep an updated logbook.
                            </MudText>
                            <MudCheckBox T="bool" @bind-Value="_termsAccepted" Color="Color.Primary">
                                <span style="font-size: 0.85rem;">
                                    I confirm that I have read and agree to all terms of the Tripartite Learnership Agreement and authorize electronic execution.
                                </span>
                            </MudCheckBox>
                        </MudPaper>
                    </MudItem>
                </MudGrid>
            </MudCardContent>
            <MudCardActions Class="pa-4 d-flex justify-end gap-2 bg-surface">
                <MudButton Variant="Variant.Text" Color="Color.Secondary" OnClick="@(() => _isOtpVerified = false)">
                    Back to Token Entry
                </MudButton>
                <MudButton Variant="Variant.Filled"
                           Color="Color.Success"
                           StartIcon="@Icons.Material.Filled.Draw"
                           OnClick="ExecuteDigitalSignoff"
                           Disabled="@(!_termsAccepted || _isExecuting)">
                    @(_isExecuting ? "Executing..." : "Execute Digital Signature")
                </MudButton>
            </MudCardActions>
        </MudCard>
    }
</MudContainer>

@code {
    [Parameter]
    public string? Token { get; set; }

    private string _contractRef = "LRN-2026-0042";
    private string _enteredOtp = "784219";
    private string _verifiedOtp = string.Empty;
    private bool _isOtpVerified;
    private bool _termsAccepted;
    private bool _isExecuting;
    private bool _isExecuted;
    private string _securitySeal = string.Empty;

    private string _learnerName = "Thabo Molefe";
    private string _learnerIdNumber = "0104155088089";
    private string _employerName = "Toyota South Africa Motors (Pty) Ltd";
    private string _employerSdl = "L120718294";
    private string _qualificationTitle = "NC: Automotive Repair and Maintenance (SAQA 78323)";

    private List<BreadcrumbItem> _breadcrumbs = new()
    {
        new BreadcrumbItem("Home", href: "/"),
        new BreadcrumbItem("Learners Hub", href: "/learners"),
        new BreadcrumbItem("OTP Digital Sign-off", href: "/signoff/learner", disabled: true)
    };

    protected override void OnInitialized()
    {
        if (!string.IsNullOrWhiteSpace(Token))
        {
            _contractRef = Token;
        }
    }

    private void VerifyOtp()
    {
        if (string.IsNullOrWhiteSpace(_enteredOtp) || _enteredOtp.Length < 6)
        {
            Snackbar.Add("Please enter a valid 6-digit OTP code.", Severity.Warning);
            return;
        }

        _verifiedOtp = _enteredOtp;
        _isOtpVerified = true;
        Snackbar.Add("OTP token verified. Contract parameters unlocked for review.", Severity.Success);
    }

    private async Task ExecuteDigitalSignoff()
    {
        if (!_termsAccepted)
        {
            Snackbar.Add("Please accept the tripartite agreement terms before executing.", Severity.Warning);
            return;
        }

        _isExecuting = true;
        try
        {
            var result = await LifecycleService.VerifyAndExecuteSignoffOtpAsync(new LearnerOtpVerificationRequest
            {
                ContractReferenceOrRsaId = _contractRef,
                OtpToken = _verifiedOtp,
                SignerName = _learnerName,
                SignerRsaId = _learnerIdNumber,
                SignerRole = "Learner"
            }, _learnerName);

            if (result.Success && !string.IsNullOrEmpty(result.SecuritySeal))
            {
                _securitySeal = result.SecuritySeal;
            }
            else
            {
                using var sha = System.Security.Cryptography.SHA256.Create();
                var raw = $"{_contractRef}-{_learnerIdNumber}-{DateTime.UtcNow.Ticks}";
                var hashBytes = sha.ComputeHash(System.Text.Encoding.UTF8.GetBytes(raw));
                _securitySeal = Convert.ToHexString(hashBytes).ToLowerInvariant();
            }

            _isExecuted = true;
            Snackbar.Add("Tripartite agreement successfully executed and sealed.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Execution failed: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isExecuting = false;
        }
    }

    private void DownloadSignedPdf()
    {
        Snackbar.Add("Preparing executed contract with digital security seal for download...", Severity.Info);
    }
}
