@page "/learners"
@using Nsdms.Application.Services
@using Nsdms.Domain.Entities
@using Nsdms.Web.Components.Shared
@using MudBlazor
@inject ILearnerService LearnerService
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@rendermode InteractiveServer

@*
  UI-STANDARD.md Archetype: A1 / T1 (Transactional List - Learner Lifecycle Management)
  Clauses: 4.2, 4.3, 6.1, 7.2, 8.1, 8.3, 11.1–11.9, 15.2.5
*@

<EntityHeader Title="Learner Lifecycle Management"
              Subtitle="Enrolment, apprentice agreements, learnership tracking, and qualification milestones"
              ReferenceKey="T1-LEARNERS"
              Status="Active"
              BreadcrumbItems="@_breadcrumbItems">
    <ActionZone>
        <MudButton Variant="Variant.Outlined" 
                   Color="Color.Primary" 
                   StartIcon="@Icons.Material.Filled.FactCheck" 
                   OnClick="@(() => Navigation.NavigateTo("/tradetests"))">
            Trade Tests Hub
        </MudButton>
        <MudButton Variant="Variant.Outlined" 
                   Color="Color.Secondary" 
                   StartIcon="@Icons.Material.Filled.School" 
                   OnClick="@(() => Navigation.NavigateTo("/learners/register-bursary"))">
            Register Bursary
        </MudButton>
        <MudButton Variant="Variant.Outlined" 
                   Color="Color.Info" 
                   StartIcon="@Icons.Material.Filled.UploadFile" 
                   OnClick="@(() => Navigation.NavigateTo("/learners/bulk-register"))">
            Bulk Fast-Track (ATM)
        </MudButton>
        <MudButton Variant="Variant.Filled" 
                   Color="Color.Primary" 
                   StartIcon="@Icons.Material.Filled.PersonAdd" 
                   OnClick="@(() => Navigation.NavigateTo("/learners/create"))">
            Register Learner (Manual)
        </MudButton>
    </ActionZone>
</EntityHeader>

<!-- Filter Bar (Clause 11.4) -->
<FilterBar SearchPlaceholder="Search contract number, learner name, RSA ID..."
           @bind-SearchText="_searchString"
           OnSearch="LoadData"
           OnClear="ClearFilters">
    <FilterContent>
        <MudSelect T="string" 
                   Label="Status Filter" 
                   Value="_selectedStatus" 
                   ValueChanged="OnStatusFilterChanged"
                   Variant="Variant.Outlined" 
                   Margin="Margin.Dense"
                   Dense="true">
            <MudSelectItem Value="@("All")">All Statuses</MudSelectItem>
            <MudSelectItem Value="@("Registered")">Registered</MudSelectItem>
            <MudSelectItem Value="@("InProgress")">In Progress</MudSelectItem>
            <MudSelectItem Value="@("Completed")">Completed</MudSelectItem>
            <MudSelectItem Value="@("Terminated")">Terminated</MudSelectItem>
        </MudSelect>

        <MudSelect T="string" 
                   Label="Programme Type" 
                   Value="_selectedProgramme" 
                   ValueChanged="OnProgrammeFilterChanged"
                   Variant="Variant.Outlined" 
                   Margin="Margin.Dense"
                   Dense="true">
            <MudSelectItem Value="@("All")">All Programmes</MudSelectItem>
            <MudSelectItem Value="@("Apprenticeship")">Apprenticeship</MudSelectItem>
            <MudSelectItem Value="@("Learnership")">Learnership</MudSelectItem>
            <MudSelectItem Value="@("SkillsProgramme")">Skills Programme</MudSelectItem>
            <MudSelectItem Value="@("Internship")">Internship</MudSelectItem>
            <MudSelectItem Value="@("Bursary")">Bursary</MudSelectItem>
        </MudSelect>
    </FilterContent>
    <ActiveFilterChips>
        @if (!string.IsNullOrWhiteSpace(_searchString))
        {
            <MudChip T="string" Size="Size.Small" OnClose="@(() => { _searchString = string.Empty; LoadData(); })">
                Keyword: @_searchString
            </MudChip>
        }
        @if (_selectedStatus != "All" && !string.IsNullOrWhiteSpace(_selectedStatus))
        {
            <MudChip T="string" Size="Size.Small" Color="Color.Primary" OnClose="@(() => { _selectedStatus = "All"; LoadData(); })">
                Status: @_selectedStatus
            </MudChip>
        }
        @if (_selectedProgramme != "All" && !string.IsNullOrWhiteSpace(_selectedProgramme))
        {
            <MudChip T="string" Size="Size.Small" Color="Color.Info" OnClose="@(() => { _selectedProgramme = "All"; LoadData(); })">
                Programme: @_selectedProgramme
            </MudChip>
        }
    </ActiveFilterChips>
</FilterBar>

<!-- Data Grid Shell (Clause 11.9) -->
<DataGridShell TItem="CompanyLearner"
               GridKey="LearnerRegistryGrid"
               Items="@_learners"
               IsLoading="@_loading"
               TotalItemsCount="@_learners.Count"
               SelectedItems="@_selectedLearners"
               SelectedItemsChanged="OnSelectedLearnersChanged"
               EmptyTitle="No Learners Found"
               EmptyMessage="No registered learners match your active search or filter criteria. Register a new learner to initiate the lifecycle agreement."
               EmptyActionLabel="Register Learner"
               OnEmptyAction="@(() => Navigation.NavigateTo("/learners/create"))">
    <BulkActionBarContent>
        <MudText Typo="Typo.body2" Class="fw-bold text-white">
            @_selectedLearners.Count learner agreement(s) selected
        </MudText>
        <MudButton Variant="Variant.Filled" 
                   Color="Color.Surface" 
                   Size="Size.Small" 
                   StartIcon="@Icons.Material.Filled.FileDownload"
                   OnClick="ExportSelected">
            Export Selected
        </MudButton>
    </BulkActionBarContent>
    <ChildContent>
        <MudTable T="CompanyLearner" 
                  Items="_learners" 
                  Hover="true" 
                  Dense="true" 
                  Elevation="0" 
                  MultiSelection="true"
                  @bind-SelectedItems="_selectedLearners"
                  Breakpoint="Breakpoint.Sm" 
                  Class="border-default">
            <HeaderContent>
                <MudTh>Contract Number</MudTh>
                <MudTh>Learner Demographics</MudTh>
                <MudTh>Host Employer</MudTh>
                <MudTh>Learning Programme</MudTh>
                <MudTh>Enrolment Date</MudTh>
                <MudTh>Status</MudTh>
                <MudTh Style="text-align: right;">Actions</MudTh>
            </HeaderContent>
            <RowTemplate>
                <!-- Key column is real hyperlink (Clause 11.1) -->
                <MudTd DataLabel="Contract No">
                    <a href="/learners/@context.Id" class="d-flex align-center gap-1 font-monospace fw-bold text-primary text-decoration-none">
                        <MudIcon Icon="@Icons.Material.Filled.Badge" Size="Size.Small" />
                        <span>@(string.IsNullOrWhiteSpace(context.LearnerContractNumber) ? $"LRN-{context.Id}" : context.LearnerContractNumber)</span>
                    </a>
                </MudTd>
                <MudTd DataLabel="Learner">
                    <div>
                        <div class="fw-bold">@(context.Person?.FullName ?? "Unknown")</div>
                        <div class="text-secondary" style="font-size: 0.8rem;">RSA ID: @(context.Person?.RsaIdNumber ?? "N/A")</div>
                    </div>
                </MudTd>
                <MudTd DataLabel="Employer">
                    <div>
                        <div class="fw-semibold">@(context.Organisation?.CompanyName ?? "Unknown")</div>
                        <div class="text-secondary" style="font-size: 0.8rem;">SDL: @(context.Organisation?.SdlNumber ?? "N/A")</div>
                    </div>
                </MudTd>
                <MudTd DataLabel="Programme">
                    <div class="fw-medium">@context.QualificationTitle</div>
                    <div class="d-flex gap-1 mt-1">
                        @if (!string.IsNullOrWhiteSpace(context.LearningProgrammeTypeCode))
                        {
                            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Info">@context.LearningProgrammeTypeCode</MudChip>
                        }
                        @if (context.NqfLevel.HasValue)
                        {
                            <MudChip T="string" Size="Size.Small" Variant="Variant.Text">NQF @context.NqfLevel</MudChip>
                        }
                    </div>
                </MudTd>
                <MudTd DataLabel="Enrolment Date">
                    @context.RegistrationDate.ToString("yyyy-MM-dd")
                </MudTd>
                <MudTd DataLabel="Status">
                    <!-- Non-clickable status pill (Clause 6.1, 7.2) -->
                    <div class="d-flex flex-column align-start gap-1">
                        <StatusBadge Status="@(context.EnrolmentStatus ?? "Registered")" Size="Size.Small" />
                        @if (context.StpApproved)
                        {
                            <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Outlined">
                                <MudIcon Icon="@Icons.Material.Filled.Bolt" Size="Size.Small" Class="mr-1" /> STP Approved
                            </MudChip>
                        }
                        else if (context.RegistrationChannel == "AutomatedBulk")
                        {
                            <MudChip T="string" Size="Size.Small" Color="Color.Info" Variant="Variant.Text">Bulk Ingested</MudChip>
                        }
                    </div>
                </MudTd>
                <MudTd Style="text-align: right;" DataLabel="Actions">
                    <div class="d-flex justify-end gap-1">
                        <MudTooltip Text="View Agreement">
                            <MudIconButton Icon="@Icons.Material.Filled.Visibility" 
                                           Color="Color.Primary" 
                                           Size="Size.Small" 
                                           OnClick="@(() => Navigation.NavigateTo($"/learners/{context.Id}"))" 
                                           aria-label="View Agreement" />
                        </MudTooltip>
                        <MudTooltip Text="Edit Agreement">
                            <MudIconButton Icon="@Icons.Material.Filled.Edit" 
                                           Color="Color.Secondary" 
                                           Size="Size.Small" 
                                           OnClick="@(() => Navigation.NavigateTo($"/learners/{context.Id}/edit"))" 
                                           aria-label="Edit Agreement" />
                        </MudTooltip>
                    </div>
                </MudTd>
            </RowTemplate>
            <PagerContent>
                <!-- Fixed page size ladder (Clause 11.3.3) -->
                <MudTablePager PageSizeOptions="new int[] { 5, 10, 20, 50, 100, 250, 500 }" />
            </PagerContent>
        </MudTable>
    </ChildContent>
</DataGridShell>

@code {
    private List<CompanyLearner> _learners = new();
    private HashSet<CompanyLearner> _selectedLearners = new();
    private bool _loading = true;
    private string _searchString = string.Empty;
    private string _selectedStatus = "All";
    private string _selectedProgramme = "All";

    private List<BreadcrumbItem> _breadcrumbItems = new()
    {
        new BreadcrumbItem("Home", href: "/"),
        new BreadcrumbItem("Learner Lifecycle", href: null, disabled: true),
        new BreadcrumbItem("Learners", href: "/learners")
    };

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        _loading = true;
        try
        {
            var statusArg = _selectedStatus == "All" ? null : _selectedStatus;
            var progArg = _selectedProgramme == "All" ? null : _selectedProgramme;
            _learners = await LearnerService.GetAllLearnersAsync(_searchString, statusArg, null, progArg);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task OnStatusFilterChanged(string val)
    {
        _selectedStatus = val;
        await LoadData();
    }

    private async Task OnProgrammeFilterChanged(string val)
    {
        _selectedProgramme = val;
        await LoadData();
    }

    private async Task ClearFilters()
    {
        _searchString = string.Empty;
        _selectedStatus = "All";
        _selectedProgramme = "All";
        await LoadData();
    }

    private void OnSelectedLearnersChanged(HashSet<CompanyLearner> selected)
    {
        _selectedLearners = selected;
    }

    private void ExportSelected()
    {
        Snackbar.Add($"Exporting {_selectedLearners.Count} learner agreements to CSV...", Severity.Info);
    }
}
