@page "/learners/{Id:int}"
@page "/learners/{Id:int}/edit"
@using Nsdms.Application.Common.Models
@using Nsdms.Application.Common.Utilities
@using Nsdms.Application.Services
@using Nsdms.Domain.Entities
@using Nsdms.Web.Components.Shared
@rendermode InteractiveServer
@inject ILearnerService LearnerService
@inject ILearnerLifecycleService LifecycleService
@inject IPersonService PersonService
@inject IOrganisationService OrganisationService
@inject ITrainingProviderService ProviderService
@inject LookupService LookupService
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject Nsdms.Application.Common.Interfaces.IPdfDocumentService PdfService
@inject IJSRuntime JsRuntime

<PageTitle>@(IsNew ? "New Learner Registration" : $"Learner {_learner.LearnerContractNumber}") - NSDMS</PageTitle>

@if (!_isEditMode && !IsNew)
{
    <EntityHeader Title="@(_person?.FullName ?? "Learner Profile")"
                  ReferenceKey="@(_learner.LearnerContractNumber ?? "LRN-" + Id)"
                  Status="@(_learner.EnrolmentStatusCode ?? "Registered")"
                  Subtitle="@($"ID: {_person?.RsaIdNumber ?? "N/A"} | Qualification: {_learner.QualificationTitle ?? "Skills Programme"} | Reference: {_learner.LearnerContractNumber ?? "LRN-" + Id}")"
                  BreadcrumbItems="@_breadcrumbItems">
        <ActionZone>
            <MudButton Variant="Variant.Text"
                       StartIcon="@Icons.Material.Filled.ArrowBack"
                       Color="Color.Default"
                       OnClick="@(() => Navigation.NavigateTo("/learners"))"
                       aria-label="Back to Learners List">
                Back to Learners
            </MudButton>
            <MudMenu Label="Learner Lifecycle"
                     StartIcon="@Icons.Material.Filled.Bolt"
                     EndIcon="@Icons.Material.Filled.KeyboardArrowDown"
                     Color="Color.Default"
                     Variant="Variant.Outlined"
                     Dense="true"
                     aria-label="Learner Lifecycle Actions">
                <MudMenuItem Icon="@Icons.Material.Filled.Draw" OnClick="@(() => Navigation.NavigateTo($"/signoff/learner/{_learner.LearnerContractNumber ?? "LRN-" + Id}"))">
                    OTP Digital Sign-off
                </MudMenuItem>
                <MudMenuItem Icon="@Icons.Material.Filled.FactCheck" OnClick="@(() => Navigation.NavigateTo($"/tradetests/create?learnerId={Id}"))">
                    Apply for Trade Test (26D)
                </MudMenuItem>
                <MudMenuItem Icon="@Icons.Material.Filled.SwapHoriz" OnClick="@(() => OpenLifecycleDialog("Transfer"))">
                    Transfer Provider / Employer
                </MudMenuItem>
                <MudMenuItem Icon="@Icons.Material.Filled.Update" OnClick="@(() => OpenLifecycleDialog("LostTime"))">
                    Record Lost Time / Extension
                </MudMenuItem>
                <MudMenuItem Icon="@Icons.Material.Filled.CancelPresentation" OnClick="@(() => OpenLifecycleDialog("Termination"))">
                    Request Agreement Termination
                </MudMenuItem>
                <MudMenuItem Icon="@Icons.Material.Filled.EditNote" OnClick="@(() => OpenLifecycleDialog("ChangeRequest"))">
                    Submit Contract Amendment
                </MudMenuItem>
                <MudDivider Class="my-1" />
                <MudMenuItem Icon="@Icons.Material.Filled.PictureAsPdf" OnClick="DownloadAgreementPdf">
                    Download Tripartite Agreement (PDF)
                </MudMenuItem>
                <MudMenuItem Icon="@Icons.Material.Filled.Delete" IconColor="Color.Error" OnClick="DeleteAsync">
                    Delete Learner Agreement
                </MudMenuItem>
            </MudMenu>
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Edit"
                       OnClick="EnterEditMode"
                       aria-label="Edit Learner Record">
                Edit Learner
            </MudButton>
        </ActionZone>
    </EntityHeader>
}
else
{
    <EntityHeader Title="@(IsNew ? "Register New Learner / Apprentice (SETMIS Files 500-506)" : $"Edit {_person?.FullName ?? "Learner"}")"
                  ReferenceKey="@(_learner.LearnerContractNumber ?? "LRN-" + Id)"
                  Status="@(IsNew ? "Draft" : "Editing")"
                  Subtitle="@(IsNew ? "Enrol candidate into registered learnership, apprenticeship, or skills programme" : "Modify learner registration parameters and workplace assignment")"
                  BreadcrumbItems="@_breadcrumbItems">
        <ActionZone>
            <MudButton Variant="Variant.Outlined" Color="Color.Secondary" StartIcon="@Icons.Material.Filled.Cancel" OnClick="ExitEditMode" aria-label="Cancel and Return">
                Cancel
            </MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Save" OnClick="SaveAsync" Disabled="_saving" aria-label="Save Learner Record">
                @(_saving ? "Saving..." : "Save Learner")
            </MudButton>
        </ActionZone>
    </EntityHeader>
}

@if (!IsNew)
{
    <!-- Visual Workflow Step Tracker -->
    <WorkflowProgressBar ProcessCode="LRN" 
                         EntityId="@Id" 
                         EntityTitle="@($"{_learner.QualificationTitle} ({_learner.LearnerContractNumber})")" 
                         EntityRef="@_learner.LearnerContractNumber" />

    <!-- Workflow Action Bridge -->
    <WorkflowActionBridge ProcessCode="LRN" 
                          EntityId="@Id" 
                          EntityTitle="@($"{_learner.QualificationTitle} ({_learner.LearnerContractNumber})")" 
                          EntityRef="@_learner.LearnerContractNumber" 
                          OnStatusChanged="OnWorkflowStatusChanged" />
}

@if (_loading)
{
    <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="my-6" />
}
else
{
    <MudForm ReadOnly="@(!_isEditMode)">
    <MudTabs Elevation="2" Rounded="true" ApplyEffectsToContainer="true" Color="Color.Surface" @bind-ActivePanelIndex="_activeTabIndex">
        
        <!-- TAB 1: DEMOGRAPHICS & PROFILE -->
        <MudTabPanel Text="Demographics & Profile" Icon="@Icons.Material.Filled.Person">
            <MudGrid Spacing="3">
                <!-- Identity & Personal Information -->
                <MudItem xs="12" lg="8">
                    <MudCard Elevation="2" Class="mb-4">
                        <MudCardHeader>
                            <CardHeaderAvatar>
                                <MudAvatar Color="Color.Primary" Variant="Variant.Filled">
                                    <MudIcon Icon="@Icons.Material.Filled.Badge" />
                                </MudAvatar>
                            </CardHeaderAvatar>
                            <CardHeaderContent>
                                <MudText Typo="Typo.h6">Learner Identification & Demographics</MudText>
                                <MudText Typo="Typo.caption" Color="Color.Secondary">National identity verification and statutory equity classification</MudText>
                            </CardHeaderContent>
                        </MudCardHeader>
                        <MudCardContent>
                            <MudGrid>
                                <MudItem xs="12" md="6">
                                    <MudSelect T="int" Value="_learner.PersonId" ValueChanged="OnPersonChanged" Label="Link Person from Registry" Variant="Variant.Outlined" Required="true">
                                        <MudSelectItem Value="0">-- Select Existing Person --</MudSelectItem>
                                        @foreach (var p in _people)
                                        {
                                            <MudSelectItem Value="@p.Id">@p.FullName (@(!string.IsNullOrWhiteSpace(p.RsaIdNumber) ? p.RsaIdNumber : p.PassportNumber))</MudSelectItem>
                                        }
                                    </MudSelect>
                                </MudItem>
                                <MudItem xs="12" md="6">
                                    <MudTextField @bind-Value="_person.RsaIdNumber" Label="13-Digit RSA ID Number" Variant="Variant.Outlined"
                                                  Placeholder="e.g. 9501015009087" OnBlur="OnRsaIdChanged" HelperText="Auto-extracts DOB, Gender, and SA Citizenship" />
                                </MudItem>

                                <MudItem xs="12" md="2">
                                    <MudSelect T="string" Label="Title" @bind-Value="_person.Title" Variant="Variant.Outlined">
                                        <MudSelectItem Value="@("Mr")">Mr</MudSelectItem>
                                        <MudSelectItem Value="@("Ms")">Ms</MudSelectItem>
                                        <MudSelectItem Value="@("Mrs")">Mrs</MudSelectItem>
                                        <MudSelectItem Value="@("Dr")">Dr</MudSelectItem>
                                    </MudSelect>
                                </MudItem>
                                <MudItem xs="12" md="5">
                                    <MudTextField @bind-Value="_person.FirstName" Label="First / Given Name" Variant="Variant.Outlined" Required="true" />
                                </MudItem>
                                <MudItem xs="12" md="5">
                                    <MudTextField @bind-Value="_person.LastName" Label="Last / Surname" Variant="Variant.Outlined" Required="true" />
                                </MudItem>

                                <MudItem xs="12" md="4">
                                    <MudDatePicker @bind-Date="_person.DateOfBirth" Label="Date of Birth" Variant="Variant.Outlined" />
                                </MudItem>
                                <MudItem xs="12" md="4">
                                    <MudTextField @bind-Value="_person.Gender" Label="Gender" Variant="Variant.Outlined" ReadOnly="true" />
                                </MudItem>
                                <MudItem xs="12" md="4">
                                    <MudSelect T="string" Label="Equity Classification" @bind-Value="_person.EquityCode" Variant="Variant.Outlined">
                                        @foreach (var eq in _equityTypes)
                                        {
                                            <MudSelectItem Value="@eq.Code">@eq.Name</MudSelectItem>
                                        }
                                    </MudSelect>
                                </MudItem>

                                <MudItem xs="12" md="6">
                                    <MudTextField @bind-Value="_person.Email" Label="Email Address" Variant="Variant.Outlined" Placeholder="learner@example.com" />
                                </MudItem>
                                <MudItem xs="12" md="6">
                                    <MudTextField @bind-Value="_person.CellNumber" Label="Mobile / Cell Phone" Variant="Variant.Outlined" Placeholder="082 123 4567" />
                                </MudItem>
                            </MudGrid>
                        </MudCardContent>
                    </MudCard>

                    <!-- Residential Location -->
                    <MudCard Elevation="2">
                        <MudCardHeader>
                            <CardHeaderAvatar>
                                <MudAvatar Color="Color.Success" Variant="Variant.Filled">
                                    <MudIcon Icon="@Icons.Material.Filled.Home" />
                                </MudAvatar>
                            </CardHeaderAvatar>
                            <CardHeaderContent>
                                <MudText Typo="Typo.h6">Residential Address & Province</MudText>
                            </CardHeaderContent>
                        </MudCardHeader>
                        <MudCardContent>
                            <MudGrid>
                                <MudItem xs="12" md="6">
                                    <MudTextField @bind-Value="_person.PhysicalAddress" Label="Residential Address Line 1" Variant="Variant.Outlined" Lines="2" />
                                </MudItem>
                                <MudItem xs="12" md="6">
                                    <MudTextField @bind-Value="_person.PostalAddress" Label="Postal Address" Variant="Variant.Outlined" Lines="2" />
                                </MudItem>
                                <MudItem xs="12" md="4">
                                    <MudSelect T="string" Label="Province" @bind-Value="_person.ProvinceCode" Variant="Variant.Outlined">
                                        @foreach (var pr in _provinces)
                                        {
                                            <MudSelectItem Value="@pr.Code">@pr.Name</MudSelectItem>
                                        }
                                    </MudSelect>
                                </MudItem>
                                <MudItem xs="12" md="4">
                                    <MudSelect T="string" Label="Urban / Rural" @bind-Value="_learner.UrbanRuralId" Variant="Variant.Outlined">
                                        <MudSelectItem Value="@("01")">01 - Urban</MudSelectItem>
                                        <MudSelectItem Value="@("02")">02 - Rural</MudSelectItem>
                                        <MudSelectItem Value="@("98")">98 - Unknown</MudSelectItem>
                                    </MudSelect>
                                </MudItem>
                                <MudItem xs="12" md="4">
                                    <MudSelect T="string" Label="Economic Status" @bind-Value="_learner.EconomicStatusId" Variant="Variant.Outlined">
                                        <MudSelectItem Value="@("01")">01 - Employed (18.1)</MudSelectItem>
                                        <MudSelectItem Value="@("02")">02 - Unemployed (18.2)</MudSelectItem>
                                        <MudSelectItem Value="@("03")">03 - Student</MudSelectItem>
                                    </MudSelect>
                                </MudItem>
                            </MudGrid>
                        </MudCardContent>
                    </MudCard>
                </MudItem>

                <!-- Current Active Agreement Summary Sidebar -->
                <MudItem xs="12" lg="4">
                    <MudCard Elevation="2" Class="mb-4">
                        <MudCardHeader>
                            <CardHeaderContent>
                                <MudText Typo="Typo.h6">Active Programme Summary</MudText>
                            </CardHeaderContent>
                        </MudCardHeader>
                        <MudCardContent>
                            <div class="d-flex flex-column gap-3">
                                <MudTextField @bind-Value="_learner.LearnerContractNumber" Label="Agreement / Contract No" Variant="Variant.Outlined" ReadOnly="!IsNew" />
                                <MudSelect T="string" Label="Learning Programme Type" @bind-Value="_learner.LearningProgrammeTypeCode" Variant="Variant.Outlined">
                                    <MudSelectItem Value="@("01")">01 - Apprenticeship</MudSelectItem>
                                    <MudSelectItem Value="@("02")">02 - Learnership</MudSelectItem>
                                    <MudSelectItem Value="@("03")">03 - Skills Programme</MudSelectItem>
                                    <MudSelectItem Value="@("04")">04 - Internship</MudSelectItem>
                                    <MudSelectItem Value="@("05")">05 - Bursary</MudSelectItem>
                                    <MudSelectItem Value="@("06")">06 - Candidacy</MudSelectItem>
                                    <MudSelectItem Value="@("07")">07 - ARPL</MudSelectItem>
                                </MudSelect>
                                <MudTextField @bind-Value="_learner.QualificationTitle" Label="Qualification / Course Title" Variant="Variant.Outlined" Required="true" />
                                <MudNumericField @bind-Value="_learner.NqfLevel" Label="NQF Level" Variant="Variant.Outlined" Min="1" Max="10" />
                                <MudTextField @bind-Value="_learner.OfoCode" Label="OFO Occupational Code" Variant="Variant.Outlined" Placeholder="e.g. 651202" />
                                <MudSelect T="string" Label="Enrolment Status" @bind-Value="_learner.EnrolmentStatusId" Variant="Variant.Outlined">
                                    <MudSelectItem Value="@("01")">01 - Enrolled / Active</MudSelectItem>
                                    <MudSelectItem Value="@("02")">02 - Achieved</MudSelectItem>
                                    <MudSelectItem Value="@("03")">03 - Certificated</MudSelectItem>
                                    <MudSelectItem Value="@("04")">04 - Terminated</MudSelectItem>
                                    <MudSelectItem Value="@("05")">05 - Transferred</MudSelectItem>
                                </MudSelect>
                                <MudSwitch T="bool" @bind-Value="_learner.IsActive" Color="Color.Primary" Label="Enrolment is Active" />
                            </div>
                        </MudCardContent>
                    </MudCard>
                </MudItem>
            </MudGrid>
        </MudTabPanel>

        <!-- TAB 2: ENROLMENTS & PROGRAMMES -->
        <MudTabPanel Text="Enrolments & Programmes" Icon="@Icons.Material.Filled.School">
            <div class="d-flex flex-wrap justify-space-between align-center mb-4 gap-3">
                <div>
                    <MudText Typo="Typo.h6">All Registered Learning Programmes & Agreements (SETMIS 500/501)</MudText>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Complete historical and concurrent training contracts for this learner</MudText>
                </div>
                <MudChip T="string" Color="Color.Primary" Size="Size.Small" Variant="Variant.Filled">
                    @_enrolments.Count Total Contracts
                </MudChip>
            </div>

            @if (_loadingEnrolments)
            {
                <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="my-4" />
            }
            else
            {
                <MudTable Items="_enrolments" Hover="true" Dense="true" Striped="true" Elevation="1">
                    <HeaderContent>
                        <MudTh>Contract No</MudTh>
                        <MudTh>Programme Type</MudTh>
                        <MudTh>Qualification Title</MudTh>
                        <MudTh>NQF Level</MudTh>
                        <MudTh>Sponsoring Employer</MudTh>
                        <MudTh>Training Provider</MudTh>
                        <MudTh>Registered Date</MudTh>
                        <MudTh>Status</MudTh>
                        <MudTh Style="text-align:right">Action</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="Contract No"><strong>@context.LearnerContractNumber</strong></MudTd>
                        <MudTd DataLabel="Programme Type">
                            <MudChip T="string" Color="Color.Info" Size="Size.Small" Variant="Variant.Outlined">
                                @context.LearningProgrammeTypeName
                            </MudChip>
                        </MudTd>
                        <MudTd DataLabel="Qualification">@context.QualificationTitle</MudTd>
                        <MudTd DataLabel="NQF Level">@(context.NqfLevel.HasValue ? $"Level {context.NqfLevel}" : "-")</MudTd>
                        <MudTd DataLabel="Employer">@(context.EmployerName ?? "Unlinked")</MudTd>
                        <MudTd DataLabel="Provider">@(context.TrainingProviderName ?? "Unlinked")</MudTd>
                        <MudTd DataLabel="Registered">@context.RegistrationDate.ToString("yyyy-MM-dd")</MudTd>
                        <MudTd DataLabel="Status">
                            <MudChip T="string" Color="@GetStatusColor(context.EnrolmentStatusName)" Size="Size.Small">
                                @context.EnrolmentStatusName
                            </MudChip>
                        </MudTd>
                        <MudTd Style="text-align:right" DataLabel="Action">
                            <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary" Href="@($"/learners/{context.CompanyLearnerId}")">
                                Open
                            </MudButton>
                        </MudTd>
                    </RowTemplate>
                    <NoRecordsContent>
                        <div class="pa-4 text-center">
                            <MudText Typo="Typo.body2" Color="Color.Secondary">No learning agreements recorded for this person.</MudText>
                        </div>
                    </NoRecordsContent>
                </MudTable>
            }
        </MudTabPanel>

        <!-- TAB 3: EMPLOYERS & HOST WORKPLACES -->
        <MudTabPanel Text="Employers & Workplaces" Icon="@Icons.Material.Filled.Business">
            <div class="d-flex flex-wrap justify-space-between align-center mb-4 gap-3">
                <div>
                    <MudText Typo="Typo.h6">Host Employers & Sponsoring Workplaces</MudText>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Participating companies providing practical workplace placement and logbook supervision</MudText>
                </div>
            </div>

            @if (_loadingEmployers)
            {
                <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="my-4" />
            }
            else
            {
                <MudTable Items="_employers" Hover="true" Dense="true" Striped="true" Elevation="1">
                    <HeaderContent>
                        <MudTh>Employer Name</MudTh>
                        <MudTh>SARS SDL Number</MudTh>
                        <MudTh>Operating Facility / Site</MudTh>
                        <MudTh>Designated Contact Person</MudTh>
                        <MudTh>Contact Email / Tel</MudTh>
                        <MudTh>Relationship Role</MudTh>
                        <MudTh Style="text-align:right">Action</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="Employer Name">
                            <div class="d-flex align-center gap-2">
                                <MudIcon Icon="@Icons.Material.Filled.Apartment" Color="Color.Primary" Size="Size.Small" />
                                <MudLink Href="@($"/employers/{context.EmployerId}")" Typo="Typo.body2" Class="fw-bold">
                                    @context.CompanyName
                                </MudLink>
                            </div>
                        </MudTd>
                        <MudTd DataLabel="SDL Number">@context.SdlNumber</MudTd>
                        <MudTd DataLabel="Site">@context.SiteName</MudTd>
                        <MudTd DataLabel="Contact Person">@(context.ContactPersonName ?? "-")</MudTd>
                        <MudTd DataLabel="Contact Info">@(context.ContactEmail ?? context.ContactPhone ?? "-")</MudTd>
                        <MudTd DataLabel="Role"><MudChip T="string" Color="Color.Info" Size="Size.Small">@context.RelationshipRole</MudChip></MudTd>
                        <MudTd Style="text-align:right" DataLabel="Action">
                            <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Business" Href="@($"/employers/{context.EmployerId}")">
                                View Org
                            </MudButton>
                        </MudTd>
                    </RowTemplate>
                    <NoRecordsContent>
                        <div class="pa-4 text-center">
                            <MudText Typo="Typo.body2" Color="Color.Secondary">No linked employers found for this learner.</MudText>
                        </div>
                    </NoRecordsContent>
                </MudTable>
            }
        </MudTabPanel>

        <!-- TAB 4: TRAINING PROVIDERS (SDP) -->
        <MudTabPanel Text="Training Providers (SDP)" Icon="@Icons.Material.Filled.AccountBalance">
            <div class="d-flex flex-wrap justify-space-between align-center mb-4 gap-3">
                <div>
                    <MudText Typo="Typo.h6">Accredited Skills Development Providers (SDP)</MudText>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Accredited TVETs, private colleges, and assessment centres providing institutional training</MudText>
                </div>
            </div>

            @if (_loadingProviders)
            {
                <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="my-4" />
            }
            else
            {
                <MudTable Items="_providers" Hover="true" Dense="true" Striped="true" Elevation="1">
                    <HeaderContent>
                        <MudTh>Provider Name</MudTh>
                        <MudTh>Accreditation No</MudTh>
                        <MudTh>Primary Contact</MudTh>
                        <MudTh>Contact Email / Tel</MudTh>
                        <MudTh>Assessor Registration</MudTh>
                        <MudTh>Delivery Mode</MudTh>
                        <MudTh Style="text-align:right">Action</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="Provider Name">
                            <div class="d-flex align-center gap-2">
                                <MudIcon Icon="@Icons.Material.Filled.School" Color="Color.Primary" Size="Size.Small" />
                                <MudLink Href="@($"/training-providers/{context.ProviderId}")" Typo="Typo.body2" Class="fw-bold">
                                    @context.ProviderName
                                </MudLink>
                            </div>
                        </MudTd>
                        <MudTd DataLabel="Accreditation No">@context.AccreditationNumber</MudTd>
                        <MudTd DataLabel="Contact">@(context.PrimaryContactName ?? "-")</MudTd>
                        <MudTd DataLabel="Contact Details">@(context.EmailAddress ?? context.PhoneNumber ?? "-")</MudTd>
                        <MudTd DataLabel="Assessor"><MudChip T="string" Color="Color.Info" Size="Size.Small">@context.AssessorName</MudChip></MudTd>
                        <MudTd DataLabel="Mode">@context.DeliveryMode</MudTd>
                        <MudTd Style="text-align:right" DataLabel="Action">
                            <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.School" Href="@($"/training-providers/{context.ProviderId}")">
                                View SDP
                            </MudButton>
                        </MudTd>
                    </RowTemplate>
                    <NoRecordsContent>
                        <div class="pa-4 text-center">
                            <MudText Typo="Typo.body2" Color="Color.Secondary">No linked training providers found for this learner.</MudText>
                        </div>
                    </NoRecordsContent>
                </MudTable>
            }
        </MudTabPanel>

        <!-- TAB 5: ASSESSMENTS & UNIT STANDARDS (SETMIS 502/503) -->
        <MudTabPanel Text="Assessments & Standards" Icon="@Icons.Material.Filled.MenuBook">
            <div class="d-flex flex-wrap justify-space-between align-center mb-4 gap-3">
                <div>
                    <MudText Typo="Typo.h6">Unit Standard Assessments & Statement of Results (SETMIS 502/503)</MudText>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Formative, summative, and RPL unit standard achievement records</MudText>
                </div>
            </div>

            @if (_loadingAssessments)
            {
                <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="my-4" />
            }
            else
            {
                <MudTable Items="_assessments" Hover="true" Dense="true" Striped="true" Elevation="1">
                    <HeaderContent>
                        <MudTh>Unit Standard Code</MudTh>
                        <MudTh>Title / Description</MudTh>
                        <MudTh>Assessment Date</MudTh>
                        <MudTh>Assessor Name</MudTh>
                        <MudTh>Assessor Reg No</MudTh>
                        <MudTh>Outcome</MudTh>
                        <MudTh>Statement of Results</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="Code"><strong>@context.UnitStandardCode</strong></MudTd>
                        <MudTd DataLabel="Title">@context.UnitStandardTitle</MudTd>
                        <MudTd DataLabel="Date">@context.AssessmentDate.ToString("yyyy-MM-dd")</MudTd>
                        <MudTd DataLabel="Assessor">@(context.AssessorName ?? "-")</MudTd>
                        <MudTd DataLabel="Assessor Reg No">@(context.AssessorRegNo ?? "-")</MudTd>
                        <MudTd DataLabel="Outcome">
                            <MudChip T="string" Color="@(context.ResultStatusCode == "Competent" ? Color.Success : Color.Warning)" Size="Size.Small">
                                @context.ResultStatusCode
                            </MudChip>
                        </MudTd>
                        <MudTd DataLabel="SoR Number">@(!string.IsNullOrWhiteSpace(context.StatementOfResultsNumber) ? context.StatementOfResultsNumber : "-")</MudTd>
                    </RowTemplate>
                    <NoRecordsContent>
                        <div class="pa-4 text-center">
                            <MudText Typo="Typo.body2" Color="Color.Secondary">No unit standard assessments recorded yet.</MudText>
                        </div>
                    </NoRecordsContent>
                </MudTable>
            }
        </MudTabPanel>

        <!-- TAB 6: TRADE TESTS & ARPL (SETMIS 505) -->
        <MudTabPanel Text="Trade Tests & Progression" Icon="@Icons.Material.Filled.FactCheck" Disabled="IsNew">
            <div class="d-flex justify-space-between align-center mb-4">
                <div>
                    <MudText Typo="Typo.h6" Class="fw-bold">Trade Test History & Certification (SETMIS File 505)</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">Summative artisan trade test assessments, TTC attempts, and NAMB/QCTO certificates</MudText>
                </div>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Schedule" OnClick="OpenScheduleTradeTestDialog" aria-label="Schedule New Trade Test">
                    Schedule Trade Test
                </MudButton>
            </div>

            <MudTable Items="_tradeTests" Hover="true" Striped="true" Elevation="1" Class="rounded-lg">
                <HeaderContent>
                    <MudTh>Trade Title</MudTh>
                    <MudTh>TTC Code</MudTh>
                    <MudTh>Attempt</MudTh>
                    <MudTh>Assessment Date</MudTh>
                    <MudTh>Assessor</MudTh>
                    <MudTh>Result</MudTh>
                    <MudTh>Certificate No</MudTh>
                    <MudTh Style="text-align: right;">Action</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Trade Title">
                        <div class="fw-bold">@context.TradeTitle</div>
                        <div class="caption text-muted">Trade Code: @(!string.IsNullOrWhiteSpace(context.TradeCode) ? context.TradeCode : context.QualificationId)</div>
                    </MudTd>
                    <MudTd DataLabel="TTC Code">@(!string.IsNullOrWhiteSpace(context.TradeTestCentreCode) ? context.TradeTestCentreCode : context.TestCenterName)</MudTd>
                    <MudTd DataLabel="Attempt">#@context.AttemptNumber</MudTd>
                    <MudTd DataLabel="Date">@context.TradeTestDate.ToString("yyyy-MM-dd")</MudTd>
                    <MudTd DataLabel="Assessor">@(context.AssessorPerson?.FullName ?? context.AssessorRegistrationNumber ?? "Assigned on day")</MudTd>
                    <MudTd DataLabel="Result">
                        @if (context.ResultStatusCode == "Competent" || context.TradeTestResultId == "01")
                        {
                            <MudChip T="string" Color="Color.Success" Size="Size.Small" Variant="Variant.Filled" Icon="@Icons.Material.Filled.Verified">01 - Competent</MudChip>
                        }
                        else if (context.ResultStatusCode == "NotYetCompetent" || context.TradeTestResultId == "02")
                        {
                            <MudChip T="string" Color="Color.Error" Size="Size.Small" Variant="Variant.Filled">02 - Not Yet Competent</MudChip>
                        }
                        else
                        {
                            <MudChip T="string" Color="Color.Warning" Size="Size.Small" Variant="Variant.Filled">@context.ResultStatusCode</MudChip>
                        }
                    </MudTd>
                    <MudTd DataLabel="Certificate">
                        @if (!string.IsNullOrWhiteSpace(context.SerialCertificateNumber))
                        {
                            <span class="font-monospace fw-bold text-success">@context.SerialCertificateNumber</span>
                        }
                        else
                        {
                            <span class="text-muted">—</span>
                        }
                    </MudTd>
                    <MudTd DataLabel="Action" Style="text-align: right;">
                        <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Primary" Size="Size.Small" Title="Record Result"
                                       OnClick="@(() => OpenRecordResultDialog(context))" aria-label="Record Trade Test Result" />
                    </MudTd>
                </RowTemplate>
                <NoRecordsContent>
                    <div class="pa-4 text-center">
                        <MudText Typo="Typo.body2" Color="Color.Secondary">No trade test evaluations on record.</MudText>
                    </div>
                </NoRecordsContent>
            </MudTable>
        </MudTabPanel>

        <!-- TAB 7: STIPENDS & GRANT FUNDING -->
        <MudTabPanel Text="Stipends & Funding" Icon="@Icons.Material.Filled.Payments">
            <div class="d-flex flex-wrap justify-space-between align-center mb-4 gap-3">
                <div>
                    <MudText Typo="Typo.h6">Discretionary Grant Funding & Stipend Allocations</MudText>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Stipend disbursement schedules and cumulative grant spend</MudText>
                </div>
            </div>

            @if (_loadingStipends)
            {
                <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="my-4" />
            }
            else
            {
                <MudTable Items="_stipends" Hover="true" Dense="true" Striped="true" Elevation="1">
                    <HeaderContent>
                        <MudTh>Agreement ID</MudTh>
                        <MudTh>Funding Vehicle</MudTh>
                        <MudTh>MoA Reference</MudTh>
                        <MudTh>Grant Project</MudTh>
                        <MudTh>Monthly Stipend Rate</MudTh>
                        <MudTh>Cumulative Spend</MudTh>
                        <MudTh>Status</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="Agreement ID"><strong>LRN-@context.CompanyLearnerId</strong></MudTd>
                        <MudTd DataLabel="Funding Vehicle">
                            <MudChip T="string" Color="Color.Info" Size="Size.Small" Variant="Variant.Outlined">
                                @context.FundingTypeCode
                            </MudChip>
                        </MudTd>
                        <MudTd DataLabel="MoA Ref">@(context.MoaNumber ?? "-")</MudTd>
                        <MudTd DataLabel="Project">@(context.GrantProjectTitle ?? "-")</MudTd>
                        <MudTd DataLabel="Monthly Rate">@(context.ApprovedStipendRate.HasValue ? context.ApprovedStipendRate.Value.ToString("C") : "-")</MudTd>
                        <MudTd DataLabel="Cumulative Spend">@context.CumulativeSpend.ToString("C")</MudTd>
                        <MudTd DataLabel="Status">
                            <MudChip T="string" Color="Color.Success" Size="Size.Small">@context.Status</MudChip>
                        </MudTd>
                    </RowTemplate>
                    <NoRecordsContent>
                        <div class="pa-4 text-center">
                            <MudText Typo="Typo.body2" Color="Color.Secondary">No stipend or grant funding records found.</MudText>
                        </div>
                    </NoRecordsContent>
                </MudTable>
            }
        </MudTabPanel>

        <!-- TAB 8: LIFECYCLE & AMENDMENTS -->
        @if (!IsNew)
        {
            <MudTabPanel Text="Lifecycle &amp; Amendments" Icon="@Icons.Material.Filled.SwapHoriz">
                <MudCard Elevation="2" Class="mb-4">
                    <MudCardHeader>
                        <CardHeaderContent>
                            <MudText Typo="Typo.h6">Statutory Lifecycle History</MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">Inter-employer transfers, lost-time extensions, cancellations, and change requests</MudText>
                        </CardHeaderContent>
                    </MudCardHeader>
                    <MudCardContent>
                        <MudTabs Elevation="1" Rounded="true" ApplyEffectsToContainer="true" Color="Color.Surface">
                            <MudTabPanel Text="Transfers" Icon="@Icons.Material.Filled.SwapHoriz" BadgeData="@_transfers.Count">
                                <MudTable Items="@_transfers" Dense="true" Hover="true" Breakpoint="Breakpoint.Sm" Elevation="0">
                                    <HeaderContent>
                                        <MudTh>Transfer Date</MudTh>
                                        <MudTh>From Employer</MudTh>
                                        <MudTh>To Employer</MudTh>
                                        <MudTh>Reason</MudTh>
                                        <MudTh>Status</MudTh>
                                    </HeaderContent>
                                    <RowTemplate>
                                        <MudTd DataLabel="Transfer Date">@context.TransferDate.ToString("yyyy-MM-dd")</MudTd>
                                        <MudTd DataLabel="From Employer">@(context.FromOrganisation?.CompanyName ?? "N/A")</MudTd>
                                        <MudTd DataLabel="To Employer">@(context.ToOrganisation?.CompanyName ?? "N/A")</MudTd>
                                        <MudTd DataLabel="Reason">@context.TransferReasonCode</MudTd>
                                        <MudTd DataLabel="Status"><MudChip T="string" Size="Size.Small" Color="@(context.TransferStatusCode == "Approved" ? Color.Success : Color.Warning)">@context.TransferStatusCode</MudChip></MudTd>
                                    </RowTemplate>
                                    <NoRecordsContent>
                                        <MudText Typo="Typo.body2" Class="pa-3 text-center">No transfers recorded for this learner agreement.</MudText>
                                    </NoRecordsContent>
                                </MudTable>
                            </MudTabPanel>
                            
                            <MudTabPanel Text="Lost Time &amp; Extensions" Icon="@Icons.Material.Filled.Update" BadgeData="@_lostTimes.Count">
                                <MudTable Items="@_lostTimes" Dense="true" Hover="true" Breakpoint="Breakpoint.Sm" Elevation="0">
                                    <HeaderContent>
                                        <MudTh>Period</MudTh>
                                        <MudTh>Days Lost</MudTh>
                                        <MudTh>Revised End Date</MudTh>
                                        <MudTh>Reason</MudTh>
                                        <MudTh>Status</MudTh>
                                    </HeaderContent>
                                    <RowTemplate>
                                        <MudTd DataLabel="Period">@context.StartDate.ToString("yyyy-MM-dd") to @context.EndDate.ToString("yyyy-MM-dd")</MudTd>
                                        <MudTd DataLabel="Days Lost">@context.DaysLost</MudTd>
                                        <MudTd DataLabel="Revised End Date">@context.RevisedContractEndDate.ToString("yyyy-MM-dd")</MudTd>
                                        <MudTd DataLabel="Reason">@context.LostTimeReasonCode</MudTd>
                                        <MudTd DataLabel="Status"><MudChip T="string" Size="Size.Small" Color="@(context.LostTimeStatusCode == "Approved" ? Color.Success : Color.Warning)">@context.LostTimeStatusCode</MudChip></MudTd>
                                    </RowTemplate>
                                    <NoRecordsContent>
                                        <MudText Typo="Typo.body2" Class="pa-3 text-center">No lost time logged for this learner.</MudText>
                                    </NoRecordsContent>
                                </MudTable>
                            </MudTabPanel>

                            <MudTabPanel Text="Terminations" Icon="@Icons.Material.Filled.Cancel" BadgeData="@_terminations.Count">
                                <MudTable Items="@_terminations" Dense="true" Hover="true" Breakpoint="Breakpoint.Sm" Elevation="0">
                                    <HeaderContent>
                                        <MudTh>Effective Date</MudTh>
                                        <MudTh>Reason</MudTh>
                                        <MudTh>Dispute Logged</MudTh>
                                        <MudTh>Union Rep</MudTh>
                                        <MudTh>Status</MudTh>
                                    </HeaderContent>
                                    <RowTemplate>
                                        <MudTd DataLabel="Effective Date">@context.EffectiveDate.ToString("yyyy-MM-dd")</MudTd>
                                        <MudTd DataLabel="Reason">@context.TerminationReasonCode</MudTd>
                                        <MudTd DataLabel="Dispute Logged">
                                            @if (context.DisputeLogged)
                                            {
                                                <MudChip T="string" Size="Size.Small" Color="Color.Error">CCMA/Dispute</MudChip>
                                            }
                                            else
                                            {
                                                <span>None</span>
                                            }
                                        </MudTd>
                                        <MudTd DataLabel="Union Rep">@(context.UnionRepresentativeName ?? "None")</MudTd>
                                        <MudTd DataLabel="Status"><MudChip T="string" Size="Size.Small" Color="Color.Error">@context.TerminationStatusCode</MudChip></MudTd>
                                    </RowTemplate>
                                    <NoRecordsContent>
                                        <MudText Typo="Typo.body2" Class="pa-3 text-center">No termination requests logged.</MudText>
                                    </NoRecordsContent>
                                </MudTable>
                            </MudTabPanel>

                            <MudTabPanel Text="Contract Change Requests" Icon="@Icons.Material.Filled.EditNote" BadgeData="@_changeRequests.Count">
                                <MudTable Items="@_changeRequests" Dense="true" Hover="true" Breakpoint="Breakpoint.Sm" Elevation="0">
                                    <HeaderContent>
                                        <MudTh>Requested Date</MudTh>
                                        <MudTh>Change Type</MudTh>
                                        <MudTh>Justification</MudTh>
                                        <MudTh>Status</MudTh>
                                    </HeaderContent>
                                    <RowTemplate>
                                        <MudTd DataLabel="Requested Date">@context.CreatedAt.ToString("yyyy-MM-dd")</MudTd>
                                        <MudTd DataLabel="Change Type">@context.ChangeTypeCode</MudTd>
                                        <MudTd DataLabel="Justification">@context.JustificationReason</MudTd>
                                        <MudTd DataLabel="Status"><MudChip T="string" Size="Size.Small" Color="@(context.ChangeStatusCode == "Approved" ? Color.Success : Color.Info)">@context.ChangeStatusCode</MudChip></MudTd>
                                    </RowTemplate>
                                    <NoRecordsContent>
                                        <MudText Typo="Typo.body2" Class="pa-3 text-center">No contract change requests logged.</MudText>
                                    </NoRecordsContent>
                                </MudTable>
                            </MudTabPanel>
                        </MudTabs>
                    </MudCardContent>
                </MudCard>
            </MudTabPanel>

            <!-- TAB 9: EVIDENCE VAULT & WORKFLOW -->
            <MudTabPanel Text="Evidence Vault" Icon="@Icons.Material.Filled.FolderZip">
                <DocumentVault TargetEntityName="CompanyLearner" TargetEntityId="@Id" />
            </MudTabPanel>

            <MudTabPanel Text="Workflow History" Icon="@Icons.Material.Filled.History">
                <WorkflowTimeline ProcessCode="LRN" EntityId="@Id" />
            </MudTabPanel>
        }
    </MudTabs>
    </MudForm>
}

<!-- SCHEDULE TRADE TEST DIALOG -->
