                    <MudSelectItem Value="@("02")">02 - Practical Re-assessment Required</MudSelectItem>
                    <MudSelectItem Value="@("03")">03 - Theoretical Re-assessment Required</MudSelectItem>
                </MudSelect>
            </MudItem>
