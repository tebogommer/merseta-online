        <MudText Typo="Typo.h6">Schedule Trade Test (SETMIS File 505)</MudText>
    </TitleContent>
    <DialogContent>
        <MudGrid>
            <MudItem xs="12">
                <MudTextField @bind-Value="_newTradeTest.TradeTitle" Label="Trade Title" Variant="Variant.Outlined" Required="true" Placeholder="e.g. Automotive Motor Mechanic, Boilermaker" />
            </MudItem>
            <MudItem xs="12" md="6">
                <MudTextField @bind-Value="_newTradeTest.TradeCode" Label="OFO / SAQA Trade Code" Variant="Variant.Outlined" Placeholder="e.g. 651202" />
            </MudItem>
            <MudItem xs="12" md="6">
                <MudTextField @bind-Value="_newTradeTest.TradeTestCentreCode" Label="TTC Provider NLRD Code" Variant="Variant.Outlined" Placeholder="e.g. TTC-001" />
            </MudItem>
            <MudItem xs="12" md="8">
                <MudTextField @bind-Value="_newTradeTest.TestCenterName" Label="Accredited Trade Test Center Name" Variant="Variant.Outlined" Required="true" />
            </MudItem>
            <MudItem xs="12" md="4">
                <MudNumericField @bind-Value="_newTradeTest.AttemptNumber" Label="Attempt Number" Variant="Variant.Outlined" Min="1" />
            </MudItem>
            <MudItem xs="12" md="6">
                <MudDatePicker @bind-Date="_tradeTestDate" Label="Trade Test Date" Variant="Variant.Outlined" />
            </MudItem>
            <MudItem xs="12" md="6">
                <MudTextField @bind-Value="_newTradeTest.AssessorRegistrationNumber" Label="Assessor Registration No" Variant="Variant.Outlined" Placeholder="e.g. 17/ASS/999" />
