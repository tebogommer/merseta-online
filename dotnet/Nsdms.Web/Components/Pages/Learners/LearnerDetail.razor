            <MudItem xs="12" md="6">
                <MudTextField @bind-Value="_selectedModeratorRegNumber" Label="Moderator / NAMB Verifier Reg No" Variant="Variant.Outlined" Placeholder="e.g. 17/MOD/1234" />
            </MudItem>
            <MudItem xs="12" md="6">
                <MudSelect T="string" @bind-Value="_selectedResultReasonId" Label="Result Reason Code" Variant="Variant.Outlined">
