        <MudButton Color="Color.Success" Variant="Variant.Filled" OnClick="SaveTestResult">Save Outcome</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [Parameter] public int Id { get; set; }

    private bool IsNew => Id == 0;
    private bool _isEditMode;
    private bool _loading = true;
    private bool _saving = false;
    private int _activeTabIndex = 0;

    protected override void OnParametersSet()
    {
        _isEditMode = Id == 0 || Navigation.Uri.EndsWith("/edit", StringComparison.OrdinalIgnoreCase);
    }

    private void EnterEditMode()
    {
        _isEditMode = true;
        Navigation.NavigateTo($"/learners/{Id}/edit");
    }

    private void ExitEditMode()
    {
        if (Id == 0)
        {
            Navigation.NavigateTo("/learners");
        }
        else
        {
            _isEditMode = false;
            Navigation.NavigateTo($"/learners/{Id}");
        }
    }

    private CompanyLearner _learner = new();
    private Person _person = new();
    private List<Person> _people = new();
    private List<LookupItemDto> _provinces = new();
    private List<LookupItemDto> _equityTypes = new();

    // 360-Degree Relational Tab Collections
    private List<LearnerEnrolmentDto> _enrolments = new();
    private List<LearnerEmployerLinkDto> _employers = new();
    private List<LearnerSdpLinkDto> _providers = new();
    private List<LearnerAssessmentDto> _assessments = new();
    private List<LearnerTradeTest> _tradeTests = new();
    private List<LearnerStipendDto> _stipends = new();

    // Lifecycle History Collections
    private List<CompanyLearnerTransfer> _transfers = new();
    private List<CompanyLearnerLostTime> _lostTimes = new();
    private List<CompanyLearnerTermination> _terminations = new();
    private List<CompanyLearnerChangeRequest> _changeRequests = new();

    private bool _loadingEnrolments = false;
    private bool _loadingEmployers = false;
    private bool _loadingProviders = false;
    private bool _loadingAssessments = false;
    private bool _loadingStipends = false;

    // Trade Test Modal States
    private bool _scheduleTestOpen = false;
    private bool _recordResultOpen = false;
    private LearnerTradeTest _newTradeTest = new();
    private LearnerTradeTest? _selectedTradeTest;
    private DateTime? _tradeTestDate = DateTime.Today;
    private string _selectedResultStatus = "01";
    private string _customCertificateNumber = string.Empty;
    private string _selectedModeratorRegNumber = string.Empty;
    private string _selectedResultReasonId = "01";
    private string _testRemarks = string.Empty;

    private List<BreadcrumbItem> _breadcrumbItems = new();

    protected override async Task OnInitializedAsync()
    {
        _loading = true;
        SetupBreadcrumbs();

        _people = await PersonService.GetAllAsync();
        _provinces = await LookupService.GetLookupItemsAsync("ProvinceType");
        _equityTypes = await LookupService.GetLookupItemsAsync("EquityType");

        if (!IsNew)
        {
            await LoadLearnerData();
        }
        else
        {
            _learner = new CompanyLearner
            {
                LearningProgrammeTypeCode = "02",
                EnrolmentStatusId = "01",
                EnrolmentStatusCode = "Registered",
                RegistrationDate = DateTime.UtcNow,
                IsActive = true
            };
            _person = new Person();
        }

        _loading = false;
    }

    private void SetupBreadcrumbs()
    {
        _breadcrumbItems = new List<BreadcrumbItem>
        {
            new BreadcrumbItem("Home", href: "/"),
            new BreadcrumbItem("Learners", href: "/learners"),
            new BreadcrumbItem(IsNew ? "Register" : $"Learner #{Id}", href: null, disabled: true)
        };
    }

    private async Task LoadLearnerData()
    {
        var l = await LearnerService.GetLearnerByIdAsync(Id);
        if (l != null)
        {
            _learner = l;
            _person = l.Person ?? await PersonService.GetByIdAsync(l.PersonId) ?? new Person();
            _tradeTests = await LearnerService.GetTradeTestsForLearnerAsync(Id);
            await LoadLifecycleHistory();

            if (_learner.PersonId > 0)
            {
                _loadingEnrolments = true;
                _loadingEmployers = true;
                _loadingProviders = true;
                _loadingAssessments = true;
                _loadingStipends = true;

                _enrolments = await LearnerService.GetLearnerEnrolmentsAsync(_learner.PersonId);
                _loadingEnrolments = false;

                _employers = await LearnerService.GetLearnerEmployersAsync(_learner.PersonId);
                _loadingEmployers = false;

                _providers = await LearnerService.GetLearnerProvidersAsync(_learner.PersonId);
                _loadingProviders = false;

                _assessments = await LearnerService.GetLearnerAssessmentsAsync(_learner.PersonId);
                _loadingAssessments = false;

                _stipends = await LearnerService.GetLearnerStipendsAsync(_learner.PersonId);
                _loadingStipends = false;
            }
        }
        else
        {
            Snackbar.Add($"Learner #{Id} not found.", Severity.Error);
            Navigation.NavigateTo("/learners");
        }
    }

    private async Task OnPersonChanged(int personId)
    {
        _learner.PersonId = personId;
        if (personId > 0)
        {
            var p = await PersonService.GetByIdAsync(personId);
            if (p != null)
            {
                _person = p;
                _enrolments = await LearnerService.GetLearnerEnrolmentsAsync(personId);
                _employers = await LearnerService.GetLearnerEmployersAsync(personId);
                _providers = await LearnerService.GetLearnerProvidersAsync(personId);
            }
        }
    }

    private void OnRsaIdChanged()
    {
        if (!string.IsNullOrWhiteSpace(_person.RsaIdNumber))
        {
            var parseResult = RsaIdValidator.Parse(_person.RsaIdNumber);
            if (parseResult.IsValid)
            {
                _person.DateOfBirth = parseResult.DateOfBirth;
                _person.Gender = parseResult.Gender;
                _person.IsSouthAfricanCitizen = parseResult.IsSouthAfricanCitizen;
                Snackbar.Add("RSA ID validated: Demographics extracted automatically.", Severity.Info);
            }
        }
    }

    private async Task SaveAsync()
    {
        if (_learner.PersonId <= 0 && string.IsNullOrWhiteSpace(_person.FirstName))
        {
            Snackbar.Add("A valid Person must be selected or registered.", Severity.Warning);
            return;
        }

        if (string.IsNullOrWhiteSpace(_learner.QualificationTitle))
        {
            Snackbar.Add("Qualification / Course Title is mandatory.", Severity.Warning);
            return;
        }

        _saving = true;
        try
        {
            if (_person.Id > 0)
            {
                await PersonService.UpdateAsync(_person, "Admin");
            }
            else
            {
                var newP = await PersonService.CreateAsync(_person, "Admin");
                _learner.PersonId = newP.Id;
            }

            var saved = await LearnerService.SaveLearnerAsync(_learner, "Admin");
            Snackbar.Add($"Learner '{_person.FullName}' saved successfully with audit log.", Severity.Success);

            if (IsNew)
            {
                Navigation.NavigateTo($"/learners/{saved.Id}");
            }
            else
            {
                await LoadLearnerData();
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error saving learner: {ex.Message}", Severity.Error);
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task DeleteAsync()
    {
        if (Id <= 0) return;

        var parameters = new DialogParameters<ConfirmDialog>
        {
            { x => x.Title, "Delete Learner Agreement" },
            { x => x.Consequence, $"Are you sure you want to delete the learner agreement for '{_person?.FullName}' ({_learner.LearnerContractNumber})? This will permanently remove all associated SETMIS enrollment records." },
            { x => x.ConfirmLabel, "Delete Agreement" },
            { x => x.IsDestructive, true }
        };
        var dialog = await DialogService.ShowAsync<ConfirmDialog>("Delete Learner Agreement", parameters);
        var result = await dialog.Result;
        if (result == null || result.Canceled) return;

        try
        {
            var deleted = await LearnerService.DeleteLearnerAsync(Id, "Admin");
            if (deleted)
            {
                Snackbar.Add("Learner agreement deleted successfully with audit confirmation.", Severity.Success);
                Navigation.NavigateTo("/learners");
            }
            else
            {
                Snackbar.Add("Could not delete learner agreement.", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error deleting record: {ex.Message}", Severity.Error);
        }
    }

    private Task OnWorkflowStatusChanged(string newStatus)
    {
        _learner.StatusCode = newStatus;
        return LoadLearnerData();
    }

    private async Task LoadLifecycleHistory()
    {
        if (Id <= 0) return;
        try
        {
            _transfers = await LifecycleService.GetTransfersForLearnerAsync(Id);
            _lostTimes = await LifecycleService.GetLostTimesForLearnerAsync(Id);
            _terminations = await LifecycleService.GetTerminationsForLearnerAsync(Id);
            _changeRequests = await LifecycleService.GetChangeRequestsForLearnerAsync(Id);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading lifecycle history: {ex.Message}");
        }
    }

    private async Task OpenLifecycleDialog(string actionType)
    {
        var parameters = new DialogParameters<LearnerLifecycleActionDialog>
        {
            { x => x.CompanyLearnerId, Id },
            { x => x.ActionType, actionType }
        };
        var options = new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true };
        var dialog = await DialogService.ShowAsync<LearnerLifecycleActionDialog>("Learner Amendment", parameters, options);
        var result = await dialog.Result;
        if (result != null && !result.Canceled)
        {
            await LoadLearnerData();
            await LoadLifecycleHistory();
        }
    }

    // Trade Test Handlers
    private void OpenScheduleTradeTestDialog()
    {
        _newTradeTest = new LearnerTradeTest
        {
            CompanyLearnerId = Id,
            TradeTitle = _learner.QualificationTitle ?? "Automotive Trade",
            AttemptNumber = (_tradeTests.Count + 1),
            TradeTestDate = DateTime.Today.AddDays(14),
            ResultStatusCode = "Scheduled"
        };
        _tradeTestDate = DateTime.Today.AddDays(14);
        _scheduleTestOpen = true;
    }

    private async Task SaveScheduledTest()
    {
        if (string.IsNullOrWhiteSpace(_newTradeTest.TradeTitle) || string.IsNullOrWhiteSpace(_newTradeTest.TestCenterName))
        {
            Snackbar.Add("Trade Title and Accredited Test Center Name are mandatory.", Severity.Warning);
            return;
        }

        _newTradeTest.TradeTestDate = _tradeTestDate ?? DateTime.Today;
        _newTradeTest.CompanyLearnerId = Id;

        try
        {
            await LearnerService.ScheduleTradeTestAsync(_newTradeTest, "Admin");
            Snackbar.Add("Trade test scheduled successfully with audit log.", Severity.Success);
            _scheduleTestOpen = false;
            _tradeTests = await LearnerService.GetTradeTestsForLearnerAsync(Id);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error scheduling trade test: {ex.Message}", Severity.Error);
        }
    }

    private void OpenRecordResultDialog(LearnerTradeTest test)
    {
        _selectedTradeTest = test;
        _selectedResultStatus = test.TradeTestResultId ?? "01";
        _customCertificateNumber = test.SerialCertificateNumber ?? string.Empty;
        _testRemarks = string.Empty;
        _recordResultOpen = true;
    }

    private async Task SaveTestResult()
    {
        if (_selectedTradeTest == null) return;

        try
        {
            await LearnerService.RecordTradeTestResultAsync(
                _selectedTradeTest.Id,
                _selectedResultStatus,
                string.IsNullOrWhiteSpace(_customCertificateNumber) ? null : _customCertificateNumber,
                _testRemarks,
                "Admin"
            );

            Snackbar.Add("Trade test outcome and certificate recorded successfully with audit trail.", Severity.Success);
            _recordResultOpen = false;
            await LoadLearnerData();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error recording outcome: {ex.Message}", Severity.Error);
        }
    }

    private async Task DownloadAgreementPdf()
    {
        try
        {
            var bytes = await PdfService.GenerateTripartiteAgreementPdfAsync(_learner);
            var base64 = Convert.ToBase64String(bytes);
            var filename = $"Tripartite_Agreement_{_learner.LearnerContractNumber ?? "LRN-" + Id}.pdf";
            await JsRuntime.InvokeVoidAsync("downloadFileFromBytes", filename, "application/pdf", base64);
            Snackbar.Add("Tripartite Learnership Agreement generated successfully.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error generating agreement: {ex.Message}", Severity.Error);
        }
    }

    private static Color GetStatusColor(string? status) => status switch
    {
        "Completed" or "Achieved" or "Certificated" => Color.Success,
        "InProgress" or "Enrolled" or "Registered" => Color.Info,
        "Transferred" => Color.Warning,
        "Terminated" => Color.Error,
        _ => Color.Default
    };
}
