@page "/artisans/namb-queue"
@using Nsdms.Application.Services
@using Nsdms.Domain.Entities
@inject INambBatchService NambService
@inject ISnackbar Snackbar
@inject IJSRuntime JsRuntime
@inject NavigationManager Navigation
@rendermode InteractiveServer

<MudPaper Elevation="1" Class="sticky-top pa-4 mb-4 rounded-lg d-flex flex-wrap justify-space-between align-center gap-3" Style="top: var(--mud-appbar-height, 64px); z-index: 10;">
    <div class="d-flex align-center gap-3">
        <MudButton Variant="Variant.Text"
                   StartIcon="@Icons.Material.Filled.ArrowBack"
                   Color="Color.Default"
                   OnClick="@(() => Navigation.NavigateTo("/tradetests"))">
            Back to Trade Tests
        </MudButton>
        <MudDivider Vertical="true" FlexItem="true" Class="mx-1 my-2" />
        <div>
            <MudBreadcrumbs Items="_breadcrumbs" Separator=">" Class="pa-0 ma-0" />
            <MudText Typo="Typo.h6" Class="font-weight-bold">
                National Artisan Moderation Body (NAMB) Staging & Serial Allocation Hub
            </MudText>
        </div>
    </div>
    <div class="d-flex align-center gap-2">
        <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Refresh" OnClick="LoadData">
            Refresh Data
        </MudButton>
    </div>
</MudPaper>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="pa-0">
    @if (_loading)
    {
        <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="my-6" />
    }
    else
    {
        <MudTabs Elevation="2" Rounded="true" ApplyEffectsToContainer="true" Color="Color.Surface">
            <!-- TAB 1: Pending Candidates Staging -->
            <MudTabPanel Text="Awaiting NAMB Moderation Queue" Icon="@Icons.Material.Filled.Queue">
                <MudCard Elevation="2" Class="pa-4 mb-4">
                    <div class="d-flex justify-space-between align-center mb-4">
                        <div>
                            <MudText Typo="Typo.h6">Competent Artisan Candidates Awaiting Batch Submission</MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">
                                Candidates who successfully concluded practical assessment (>= 70% threshold) and are ready for official NAMB serial recommendation.
                            </MudText>
                        </div>
                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Success"
                                   StartIcon="@Icons.Material.Filled.Send"
                                   OnClick="StageSelectedCandidates"
                                   Disabled="@(!_selectedCandidates.Any() || _isProcessing)">
                            Stage Selected (@_selectedCandidates.Count) for NAMB Batch
                        </MudButton>
                    </div>

                    <MudTable Items="_pendingCandidates" MultiSelection="true" @bind-SelectedItems="_selectedCandidates" Dense="true" Hover="true" Elevation="1">
                        <HeaderContent>
                            <MudTh>App Ref</MudTh>
                            <MudTh>National ID</MudTh>
                            <MudTh>Candidate Name</MudTh>
                            <MudTh>Designated Trade</MudTh>
                            <MudTh>OFO Code</MudTh>
                            <MudTh>Test Centre</MudTh>
                            <MudTh>Assessment Date</MudTh>
                            <MudTh>Outcome</MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd><span class="font-mono font-weight-bold">@context.ApplicationNumber</span></MudTd>
                            <MudTd><span class="font-mono">@context.NationalIdNumber</span></MudTd>
                            <MudTd class="font-weight-medium">@context.CandidateName</MudTd>
                            <MudTd>@context.TradeTitle</MudTd>
                            <MudTd>@context.TradeOfoCode</MudTd>
                            <MudTd>@context.AssessmentCenterName</MudTd>
                            <MudTd>@(context.AssessmentDate?.ToString("yyyy-MM-dd") ?? "-")</MudTd>
                            <MudTd>
                                <MudChip T="string" Color="Color.Success" Size="Size.Small" Variant="Variant.Filled">
                                    @context.CompetencyOutcome
                                </MudChip>
                            </MudTd>
                        </RowTemplate>
                        <NoRecordsContent>
                            <MudText Color="Color.Secondary" Class="pa-4 text-center">No competent artisan candidates currently awaiting NAMB submission.</MudText>
                        </NoRecordsContent>
                    </MudTable>
                </MudCard>
            </MudTabPanel>

            <!-- TAB 2: NAMB Submission Batches -->
            <MudTabPanel Text="NAMB Batches & Serial Decisions" Icon="@Icons.Material.Filled.FactCheck">
                <MudCard Elevation="2" Class="pa-4 mb-4">
                    <MudText Typo="Typo.h6" Class="mb-2">Historical NAMB Moderation Batches</MudText>
                    <MudTable Items="_batches" Dense="true" Hover="true" Elevation="1">
                        <HeaderContent>
                            <MudTh>Batch Reference</MudTh>
                            <MudTh>Description</MudTh>
                            <MudTh>Submission Date</MudTh>
                            <MudTh>Status</MudTh>
                            <MudTh>Candidates</MudTh>
                            <MudTh>Approved / Queried</MudTh>
                            <MudTh>Security Seal</MudTh>
                            <MudTh Style="text-align:right">Actions</MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd><span class="font-mono font-weight-bold">@context.BatchReferenceNumber</span></MudTd>
                            <MudTd>@context.BatchDescription</MudTd>
                            <MudTd>@context.SubmissionDate.ToString("yyyy-MM-dd")</MudTd>
                            <MudTd>
                                <MudChip T="string" Color="@GetBatchStatusColor(context.Status)" Size="Size.Small" Variant="Variant.Filled">
                                    @context.Status
                                </MudChip>
                            </MudTd>
                            <MudTd>@context.TotalCandidates</MudTd>
                            <MudTd>
                                <span class="text-success font-weight-bold">@context.ApprovedCandidates</span> /
                                <span class="text-error font-weight-bold">@context.RejectedCandidates</span>
                            </MudTd>
                            <MudTd>
                                <code class="font-mono" style="font-size:0.75rem">@(context.DigitalSecuritySeal?.Substring(0, Math.Min(12, context.DigitalSecuritySeal.Length)) + "...")</code>
                            </MudTd>
                            <MudTd Style="text-align:right">
                                <MudButton Variant="Variant.Outlined"
                                           Size="Size.Small"
                                           Color="Color.Info"
                                           StartIcon="@Icons.Material.Filled.Download"
                                           OnClick="@(() => ExportBatchTsv(context.Id, context.BatchReferenceNumber))"
                                           Class="mr-1">
                                    TSV
                                </MudButton>
                                @if (context.Status == "SubmittedToNamb")
                                {
                                    <MudButton Variant="Variant.Filled"
                                               Size="Size.Small"
                                               Color="Color.Success"
                                               StartIcon="@Icons.Material.Filled.CheckCircle"
                                               OnClick="@(() => OpenDecisionModal(context))">
                                        Record Serials
                                    </MudButton>
                                }
                            </MudTd>
                        </RowTemplate>
                        <NoRecordsContent>
                            <MudText Color="Color.Secondary" Class="pa-4 text-center">No NAMB batches recorded.</MudText>
                        </NoRecordsContent>
                    </MudTable>
                </MudCard>
            </MudTabPanel>
        </MudTabs>
    }
</MudContainer>

<!-- Adjudication Dialog -->
<MudDialog @bind-IsVisible="_showDecisionDialog" Options="_dialogOptions">
    <TitleContent>
        <MudText Typo="Typo.h6">Record NAMB Serial Allocations: @_activeBatch?.BatchReferenceNumber</MudText>
    </TitleContent>
    <DialogContent>
        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4">
            Enter the statutory NAMB Serial Number issued by the National Artisan Moderation Body for each approved candidate.
        </MudText>
        <MudTextField T="string" Label="NAMB Moderation Notes" Variant="Variant.Outlined" Lines="2" @bind-Value="_moderatorNotes" Class="mb-4" />
        <MudTextField T="string" Label="Batch Decision Status" Variant="Variant.Outlined" @bind-Value="_decisionCode" Class="mb-4" HelperText="Approved, PartiallyApproved, Rejected" />

        <MudTable Items="@(_activeBatch?.Applications ?? new List<LearnerTradeTestApplication>())" Dense="true" Elevation="1">
            <HeaderContent>
                <MudTh>Candidate</MudTh>
                <MudTh>Trade</MudTh>
                <MudTh>NAMB Serial Number</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd>@context.Person?.FullName</MudTd>
                <MudTd>@context.TradeTitle</MudTd>
                <MudTd>
                    <MudTextField T="string"
                                  Placeholder="e.g. NAMB-2026-ART-00123"
                                  Value="@GetAllocatedSerial(context.Id)"
                                  ValueChanged="@((string val) => SetAllocatedSerial(context.Id, val))"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense" />
                </MudTd>
            </RowTemplate>
        </MudTable>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Outlined" Color="Color.Secondary" OnClick="@(() => _showDecisionDialog = false)">Cancel</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Success" OnClick="SaveDecision" Disabled="_isProcessing">
            @(_isProcessing ? "Processing..." : "Commit Serials & Certify")
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    private bool _loading = true;
    private bool _isProcessing = false;
    private List<NambBatchCandidateDto> _pendingCandidates = new();
    private HashSet<NambBatchCandidateDto> _selectedCandidates = new();
    private List<NambSubmissionBatch> _batches = new();

    private List<BreadcrumbItem> _breadcrumbs = new();

    // Dialog state
    private bool _showDecisionDialog = false;
    private NambSubmissionBatch? _activeBatch;
    private string _decisionCode = "Approved";
    private string _moderatorNotes = "Moderated and approved by National Artisan Moderation Body.";
    private Dictionary<int, string> _serialsInput = new();
    private DialogOptions _dialogOptions = new() { MaxWidth = MaxWidth.Medium, FullWidth = true };

    protected override async Task OnInitializedAsync()
    {
        _breadcrumbs = new List<BreadcrumbItem>
        {
            new("Overview", "/"),
            new("Trade Tests", "/tradetests"),
            new("NAMB Staging Hub", null, disabled: true)
        };
        await LoadData();
    }

    private async Task LoadData()
    {
        _loading = true;
        try
        {
            _pendingCandidates = await NambService.GetPendingCandidatesForBatchAsync();
            _batches = await NambService.GetAllBatchesAsync();
            _selectedCandidates.Clear();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error loading NAMB queue: {ex.Message}", Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task StageSelectedCandidates()
    {
        if (!_selectedCandidates.Any()) return;
        _isProcessing = true;
        try
        {
            var ids = _selectedCandidates.Select(c => c.TradeTestApplicationId).ToList();
            var batch = await NambService.CreateNambBatchAsync(ids, $"Statutory NAMB Intake - {DateTime.UtcNow:MMMM yyyy}");
            Snackbar.Add($"Created batch {batch.BatchReferenceNumber} with {batch.TotalCandidates} artisan candidates.", Severity.Success);
            await LoadData();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error staging batch: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isProcessing = false;
        }
    }

    private async Task ExportBatchTsv(int batchId, string batchRef)
    {
        try
        {
            var tsv = await NambService.GenerateNambExportTsvAsync(batchId);
            var base64 = Convert.ToBase64String(System.Text.Encoding.UTF8.GetBytes(tsv));
            await JsRuntime.InvokeVoidAsync("downloadFileFromBytes", $"{batchRef}_Export.tsv", "text/tab-separated-values", base64);
            Snackbar.Add("NAMB Batch TSV exported successfully.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error exporting TSV: {ex.Message}", Severity.Error);
        }
    }

    private async Task OpenDecisionModal(NambSubmissionBatch batch)
    {
        _activeBatch = await NambService.GetBatchByIdAsync(batch.Id);
        _serialsInput.Clear();
        if (_activeBatch?.Applications != null)
        {
            int counter = 100;
            foreach (var app in _activeBatch.Applications)
            {
                _serialsInput[app.Id] = $"NAMB-{DateTime.UtcNow.Year}-ART-{(counter++):D5}";
            }
        }
        _showDecisionDialog = true;
    }

    private string GetAllocatedSerial(int id) => _serialsInput.TryGetValue(id, out var val) ? val : "";
    private void SetAllocatedSerial(int id, string val) => _serialsInput[id] = val;

    private async Task SaveDecision()
    {
        if (_activeBatch == null) return;
        _isProcessing = true;
        try
        {
            await NambService.ProcessNambDecisionAsync(_activeBatch.Id, _decisionCode, _moderatorNotes, _serialsInput);
            Snackbar.Add($"Processed decision for batch {_activeBatch.BatchReferenceNumber}. Certificates generated.", Severity.Success);
            _showDecisionDialog = false;
            await LoadData();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error saving NAMB decision: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isProcessing = false;
        }
    }

    private Color GetBatchStatusColor(string status) => status switch
    {
        "Approved" => Color.Success,
        "SubmittedToNamb" => Color.Warning,
        "PartiallyApproved" => Color.Info,
        "Rejected" => Color.Error,
        _ => Color.Default
    };
}
