@page "/audit-logs"
@page "/admin/audit-logs"
@page "/admin/audit-compliance"
@attribute [Authorize]
@using Microsoft.EntityFrameworkCore
@using Nsdms.Application.Common
@using Nsdms.Application.Models
@using Nsdms.Application.Common.ExternalToolHooks
@using Nsdms.Application.Services
@using Nsdms.Domain.Entities
@using Nsdms.Web.Components.Shared
@using System.Security.Claims
@inject IAuditService AuditService
@inject IIsoDpsaAuditComplianceService ComplianceService
@inject IReportExportService ReportExportService
@inject ISnackbar Snackbar
@inject IJSRuntime JSRuntime
@inject AuthenticationStateProvider AuthStateProvider
@inject ISiemForwarderHook SiemHook
@inject IMfaProviderHook MfaHook
@inject ISecretsVaultHook VaultHook
@inject IVulnerabilityScanHook VulnHook
@inject IBackupVerificationHook BackupHook
@inject IItsmChangeTicketHook ItsmHook

<PageTitle>Audited Change Logs &amp; Quality Compliance - MerSETA NSDMS</PageTitle>

<EntityHeader Title="Audited Change Logs &amp; Quality Compliance"
              Subtitle="ISO 9001:2015 Clause 7.5, DPSA Directive, &amp; AGSA ITGC verified audit logging with period-filtered exports"
              ReferenceKey="T3-AUDIT-LOGS"
              BreadcrumbItems="@_breadcrumbs">
    <ActionZone>
        @if (_activeTab == 0)
        {
            <MudButton Variant="Variant.Outlined" 
                       Color="Color.Primary" 
                       StartIcon="@Icons.Material.Filled.Refresh" 
                       OnClick="LoadAuditLogsAsync"
                       Disabled="@_isLoading">
                Refresh Logs
            </MudButton>
            <MudButton Variant="Variant.Filled" 
                       Color="Color.Secondary" 
                       StartIcon="@Icons.Material.Filled.FileDownload" 
                       OnClick="ExportPeriodCsvAsync"
                       Disabled="@(_isLoading || _isExporting || _isExportingPdf)">
                @(_isExporting ? "Exporting Dossier..." : "Export Period Dossier (CSV)")
            </MudButton>
            <MudButton Variant="Variant.Filled" 
                       Color="Color.Primary" 
                       StartIcon="@Icons.Material.Filled.PictureAsPdf" 
                       OnClick="ExportItgcPdfAsync"
                       Disabled="@(_isLoading || _isExporting || _isExportingPdf)">
                @(_isExportingPdf ? "Generating PDF..." : "Export ITGC Dossier (PDF)")
            </MudButton>
        }
        else if (_activeTab == 1)
        {
            <MudButton Variant="Variant.Filled" 
                       Color="Color.Primary" 
                       StartIcon="@Icons.Material.Filled.FactCheck" 
                       OnClick="RunComplianceAuditAsync"
                       Disabled="@_isEvaluatingCompliance">
                @(_isEvaluatingCompliance ? "Evaluating Standards..." : "Run Compliance Audit")
            </MudButton>
        }
        else
        {
            <MudButton Variant="Variant.Outlined" 
                       Color="Color.Primary" 
                       StartIcon="@Icons.Material.Filled.Refresh" 
                       OnClick="RefreshHookStatusesAsync">
                Refresh Hook Telemetry
            </MudButton>
        }
    </ActionZone>
</EntityHeader>

<MudTabs @bind-ActivePanelIndex="_activeTab" Elevation="1" Rounded="true" Color="Color.Primary" ApplyEffectsToContainer="true" Class="mt-3">
    <!-- Tab 1: Operational Audit Trail (Period Filtered) -->
    <MudTabPanel Text="Audited Change Logs" Icon="@Icons.Material.Filled.History">
        <!-- Filter & Search Toolbar with Period Filtering -->
        <MudPaper Elevation="0" Class="pa-4 mb-4 rounded-lg border-subtle">
            <MudGrid Spacing="2" Class="align-center">
                <MudItem xs="12" md="3">
                    <MudTextField @bind-Value="_searchQuery"
                                  Placeholder="Search Entity, Action, Actor, or Record..."
                                  Adornment="Adornment.Start"
                                  AdornmentIcon="@Icons.Material.Filled.Search"
                                  Immediate="true"
                                  DebounceInterval="300"
                                  OnDebounceIntervalElapsed="ApplyFiltersAsync"
                                  Clearable="true"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense" />
                </MudItem>
                <MudItem xs="12" sm="6" md="2">
                    <MudSelect T="string" Value="_periodPreset" Label="Period Preset" Variant="Variant.Outlined" Margin="Margin.Dense" ValueChanged="OnPeriodPresetChanged">
                        <MudSelectItem Value="@("All")">All Time</MudSelectItem>
                        <MudSelectItem Value="@("Today")">Today</MudSelectItem>
                        <MudSelectItem Value="@("Last7Days")">Last 7 Days</MudSelectItem>
                        <MudSelectItem Value="@("Last30Days")">Last 30 Days</MudSelectItem>
                        <MudSelectItem Value="@("CurrentQuarter")">Current Quarter</MudSelectItem>
                        <MudSelectItem Value="@("CurrentFiscalYear")">Current FY (2025/26)</MudSelectItem>
                        <MudSelectItem Value="@("Custom")">Custom Date Range</MudSelectItem>
                    </MudSelect>
                </MudItem>
                <MudItem xs="6" sm="3" md="2">
                    <MudDatePicker Date="_fromDate" Label="From Date" Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true" DateChanged="OnFromDateChanged" />
                </MudItem>
                <MudItem xs="6" sm="3" md="2">
                    <MudDatePicker Date="_toDate" Label="To Date" Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true" DateChanged="OnToDateChanged" />
                </MudItem>
                <MudItem xs="6" sm="6" md="1">
                    <MudSelect T="string" @bind-Value="_selectedEntity" Label="Entity" Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true" SelectedValuesChanged="ApplyFiltersAsync">
                        <MudSelectItem Value="@("")">All</MudSelectItem>
                        @foreach (var entity in _distinctEntities)
                        {
                            <MudSelectItem Value="@entity">@entity</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="6" sm="6" md="1">
                    <MudSelect T="string" @bind-Value="_selectedAction" Label="Action" Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true" SelectedValuesChanged="ApplyFiltersAsync">
                        <MudSelectItem Value="@("")">All</MudSelectItem>
                        @foreach (var action in _distinctActions)
                        {
                            <MudSelectItem Value="@action">@action</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" md="1" Class="d-flex justify-end">
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" OnClick="LoadAuditLogsAsync" StartIcon="@Icons.Material.Filled.FilterAlt">
                        Filter
                    </MudButton>
                </MudItem>
            </MudGrid>

            <!-- Integrity Hash & Period Stats Sub-Bar -->
            <div class="d-flex justify-space-between align-center mt-3 pt-2 border-top flex-wrap gap-2">
                <div class="d-flex align-center gap-2 flex-wrap">
                    <MudChip T="string" Color="Color.Info" Variant="Variant.Outlined" Size="Size.Small" Icon="@Icons.Material.Filled.Storage">
                        Records: @_totalRecordsInPeriod
                    </MudChip>
                    @if (!string.IsNullOrWhiteSpace(_reportIntegrityHash))
                    {
                        <MudTooltip Text="SHA-256 cryptographic seal of all records matching current period filter">
                            <MudChip T="string" Color="Color.Success" Variant="Variant.Outlined" Size="Size.Small" Icon="@Icons.Material.Filled.VerifiedUser">
                                Batch Seal: @(_reportIntegrityHash.Length >= 16 ? _reportIntegrityHash[..16] + "..." : _reportIntegrityHash)
                            </MudChip>
                        </MudTooltip>
                    }
                    @if (_fromDate.HasValue || _toDate.HasValue)
                    {
                        <MudChip T="string" Color="Color.Primary" Variant="Variant.Text" Size="Size.Small">
                            Period: @(_fromDate?.ToString("yyyy-MM-dd") ?? "Start") to @(_toDate?.ToString("yyyy-MM-dd") ?? "End")
                        </MudChip>
                    }
                </div>
                <div>
                    <MudButton Variant="Variant.Text" Color="Color.Secondary" Size="Size.Small" StartIcon="@Icons.Material.Filled.ClearAll" OnClick="ResetFilters">
                        Reset Filters
                    </MudButton>
                </div>
            </div>
        </MudPaper>

        <!-- Audit Logs DataTable -->
        <MudPaper Elevation="1" Class="rounded-lg overflow-hidden">
            <MudTable Items="@_filteredLogs" Hover="true" Striped="true" Dense="true" Loading="@_isLoading" LoadingProgressColor="Color.Primary" RowsPerPage="25">
                <HeaderContent>
                    <MudTh>Timestamp (UTC)</MudTh>
                    <MudTh>Entity</MudTh>
                    <MudTh>Record Reference</MudTh>
                    <MudTh>Action</MudTh>
                    <MudTh>Actor</MudTh>
                    <MudTh>Digital Security Seal</MudTh>
                    <MudTh Style="text-align: right;">Actions</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Timestamp">
                        <MudText Typo="Typo.body2" Class="font-mono">
                            @context.Timestamp.ToString("yyyy-MM-dd HH:mm:ss")
                        </MudText>
                    </MudTd>
                    <MudTd DataLabel="Entity">
                        <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Outlined">
                            @context.EntityName
                        </MudChip>
                    </MudTd>
                    <MudTd DataLabel="Record Reference">
                        <MudText Typo="Typo.body2" Class="font-mono fw-bold">
                            @FormatRecordReference(context.EntityName, context.RecordId)
                        </MudText>
                    </MudTd>
                    <MudTd DataLabel="Action">
                        <MudChip T="string" Size="Size.Small" Color="@GetActionColor(context.ActionName)" Variant="Variant.Filled">
                            @context.ActionName
                        </MudChip>
                    </MudTd>
                    <MudTd DataLabel="Actor">
                        <div class="d-flex align-center gap-1">
                            <MudIcon Icon="@Icons.Material.Filled.Person" Size="Size.Small" Color="Color.Secondary" />
                            <MudText Typo="Typo.body2">@context.Actor</MudText>
                        </div>
                    </MudTd>
                    <MudTd DataLabel="Digital Security Seal">
                        @if (HasDigitalSecuritySeal(context))
                        {
                            <MudTooltip Text="Cryptographic SHA-256 seal verified against tampering">
                                <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Outlined" Icon="@Icons.Material.Filled.VerifiedUser">
                                    Verified Seal
                                </MudChip>
                            </MudTooltip>
                        }
                        else
                        {
                            <MudText Typo="Typo.caption" Color="Color.Secondary">Standard Log</MudText>
                        }
                    </MudTd>
                    <MudTd DataLabel="Actions" Style="text-align: right;">
                        <MudIconButton Icon="@Icons.Material.Filled.Visibility" 
                                       Size="Size.Small" 
                                       Color="Color.Primary" 
                                       Title="Inspect Log Metadata" 
                                       OnClick="@(() => OpenDetailDialog(context))" />
                    </MudTd>
                </RowTemplate>
                <PagerContent>
                    <MudTablePager PageSizeOptions="new int[] { 10, 25, 50, 100 }" />
                </PagerContent>
                <NoRecordsContent>
                    <EmptyState Icon="@Icons.Material.Filled.SearchOff"
                                Message="No Audit Logs Found"
                                Description="No security or mutation audit trail entries match your period or search criteria. Try adjusting your date range or filters."
                                ActionLabel="Reset Filters"
                                OnAction="ResetFilters" />
                </NoRecordsContent>
            </MudTable>
        </MudPaper>
    </MudTabPanel>

    <!-- Tab 2: ISO 9001 & DPSA Directive Compliance Engine -->
    <MudTabPanel Text="ISO 9001 &amp; DPSA Compliance Engine" Icon="@Icons.Material.Filled.Verified">
        @if (_complianceReport == null && !_isEvaluatingCompliance)
        {
            <MudPaper Elevation="0" Class="pa-8 text-center rounded-lg border-subtle my-4">
                <MudIcon Icon="@Icons.Material.Filled.Shield" Color="Color.Primary" Size="Size.Large" Class="mb-3" />
                <MudText Typo="Typo.h6" Class="fw-bold">Statutory &amp; Quality Standards Compliance Verification</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4" Style="max-width: 600px; margin: 0 auto;">
                    Evaluate the NSDMS database against ISO 9001:2015 Clause 7.5 (Documented Information), DPSA Information Security Directive &amp; CGICTPF, POPIA Act 4 of 2013 sensitive PII redaction, and atomic double-write integrity (zero partial commits).
                </MudText>
                <MudButton Variant="Variant.Filled" 
                           Color="Color.Primary" 
                           StartIcon="@Icons.Material.Filled.PlayArrow" 
                           OnClick="RunComplianceAuditAsync"
                           Size="Size.Large">
                    Execute Full Statutory Compliance Audit
                </MudButton>
            </MudPaper>
        }
        else if (_isEvaluatingCompliance)
        {
            <MudPaper Elevation="0" Class="pa-8 text-center rounded-lg border-subtle my-4">
                <MudProgressCircular Color="Color.Primary" Size="Size.Large" Indeterminate="true" Class="mb-3" />
                <MudText Typo="Typo.h6" Class="fw-bold">Evaluating Audit Trail Against ISO 9001 &amp; DPSA Standards...</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">
                    Sampling database tables, verifying atomic transactions, scanning for unmasked RSA IDs, and checking dual authorisation rules.
                </MudText>
            </MudPaper>
        }
        else if (_complianceReport != null)
        {
            <!-- Executive Summary Scorecard -->
            <MudPaper Elevation="1" Class="pa-4 mb-4 rounded-lg border-subtle mt-4">
                <MudGrid Spacing="3" Class="align-center">
                    <MudItem xs="12" md="3" Class="text-center">
                        <MudText Typo="Typo.caption" Color="Color.Secondary">Overall Compliance Rating</MudText>
                        <MudText Typo="Typo.h3" Color="@GetScoreColor(_complianceReport.ComplianceScorePercentage)" Class="fw-bold">
                            @_complianceReport.ComplianceScorePercentage.ToString("F1")%
                        </MudText>
                        <MudChip T="string" 
                                 Color="@GetScoreColor(_complianceReport.ComplianceScorePercentage)" 
                                 Variant="Variant.Filled" 
                                 Size="Size.Small" 
                                 Class="mt-1">
                            @_complianceReport.AssessmentStatus
                        </MudChip>
                    </MudItem>
                    <MudItem xs="12" sm="4" md="3">
                        <MudText Typo="Typo.caption" Color="Color.Secondary">Audited Log Records</MudText>
                        <MudText Typo="Typo.h5" Class="fw-bold">@_complianceReport.TotalAuditLogsExamined</MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">Across @_complianceReport.TotalEntitiesExamined Entity Types</MudText>
                    </MudItem>
                    <MudItem xs="12" sm="4" md="3">
                        <MudText Typo="Typo.caption" Color="Color.Secondary">Atomic Commits Integrity</MudText>
                        <MudText Typo="Typo.h5" Color="Color.Success" Class="fw-bold">
                            @_complianceReport.VerifiedAtomicCommitCount Verified
                        </MudText>
                        <MudText Typo="Typo.caption" Color="@(_complianceReport.PartialCommitViolationCount == 0 ? Color.Success : Color.Error)">
                            @_complianceReport.PartialCommitViolationCount Partial Commit Violations
                        </MudText>
                    </MudItem>
                    <MudItem xs="12" sm="4" md="3" Class="text-md-end">
                        <MudButton Variant="Variant.Outlined" 
                                   Color="Color.Primary" 
                                   StartIcon="@Icons.Material.Filled.Refresh" 
                                   OnClick="RunComplianceAuditAsync"
                                   Size="Size.Small"
                                   Class="mb-2">
                            Re-run Audit
                        </MudButton>
                        <MudText Typo="Typo.caption" Class="d-block text-truncate font-mono" Style="max-width: 250px;">
                            Seal: @_complianceReport.DigitalSecuritySeal.Substring(0, Math.Min(16, _complianceReport.DigitalSecuritySeal.Length))...
                        </MudText>
                    </MudItem>
                </MudGrid>
            </MudPaper>

            <!-- 4 Statutory Dimension Cards -->
            <MudGrid Spacing="3" Class="mb-4">
                <MudItem xs="12" sm="6" md="3">
                    <MudCard Elevation="1" Class="h-100 rounded-lg">
                        <MudCardContent>
                            <div class="d-flex justify-space-between align-center mb-2">
                                <MudText Typo="Typo.subtitle2" Class="fw-bold">Zero Partial Commits</MudText>
                                <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success" />
                            </div>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">
                                Mandatory double-write coordination. Domain changes and audit entries commit atomically inside EF Core execution strategy transactions.
                            </MudText>
                        </MudCardContent>
                    </MudCard>
                </MudItem>
                <MudItem xs="12" sm="6" md="3">
                    <MudCard Elevation="1" Class="h-100 rounded-lg">
                        <MudCardContent>
                            <div class="d-flex justify-space-between align-center mb-2">
                                <MudText Typo="Typo.subtitle2" Class="fw-bold">ISO 9001 Clause 7.5</MudText>
                                <MudIcon Icon="@Icons.Material.Filled.VerifiedUser" Color="Color.Primary" />
                            </div>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">
                                Control of documented information: unique identification, structured before/after state diffs, and cryptographic tamper-detection seals.
                            </MudText>
                        </MudCardContent>
                    </MudCard>
                </MudItem>
                <MudItem xs="12" sm="6" md="3">
                    <MudCard Elevation="1" Class="h-100 rounded-lg">
                        <MudCardContent>
                            <div class="d-flex justify-space-between align-center mb-2">
                                <MudText Typo="Typo.subtitle2" Class="fw-bold">DPSA Directive &amp; CGICTPF</MudText>
                                <MudIcon Icon="@Icons.Material.Filled.Security" Color="Color.Info" />
                            </div>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">
                                Public sector ICT governance: 100% actor accountability, zero anonymous transactions, and chronological UTC timestamp precision.
                            </MudText>
                        </MudCardContent>
                    </MudCard>
                </MudItem>
                <MudItem xs="12" sm="6" md="3">
                    <MudCard Elevation="1" Class="h-100 rounded-lg">
                        <MudCardContent>
                            <div class="d-flex justify-space-between align-center mb-2">
                                <MudText Typo="Typo.subtitle2" Class="fw-bold">POPIA &amp; Dual Auth</MudText>
                                <MudIcon Icon="@Icons.Material.Filled.Lock" Color="Color.Warning" />
                            </div>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">
                                Redaction of 13-digit RSA National ID numbers and bank account credentials; strict Dual Authorisation Control and segregation of duties enforcement.
                            </MudText>
                        </MudCardContent>
                    </MudCard>
                </MudItem>
            </MudGrid>

            <!-- Detailed Statutory Findings Table -->
            <MudPaper Elevation="1" Class="rounded-lg overflow-hidden">
                <div class="pa-4 border-bottom d-flex justify-space-between align-center">
                    <div>
                        <MudText Typo="Typo.subtitle1" Class="fw-bold">Statutory &amp; Quality Audit Findings</MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">
                            Detailed rule evaluations across ISO 9001:2015, DPSA Directive, POPIA Act 4 of 2013, and PFMA regulations
                        </MudText>
                    </div>
                    <MudChip T="string" Color="Color.Primary" Variant="Variant.Outlined" Size="Size.Small">
                        @_complianceReport.Findings.Count Rules Evaluated
                    </MudChip>
                </div>
                <MudTable Items="@_complianceReport.Findings" Hover="true" Dense="true" Elevation="0">
                    <HeaderContent>
                        <MudTh>Rule ID</MudTh>
                        <MudTh>Standard</MudTh>
                        <MudTh>Severity</MudTh>
                        <MudTh>Evaluation Check</MudTh>
                        <MudTh>Status</MudTh>
                        <MudTh>Evidentiary Details</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="Rule ID">
                            <MudText Typo="Typo.body2" Class="font-mono fw-bold">@context.RuleId</MudText>
                        </MudTd>
                        <MudTd DataLabel="Standard">
                            <MudText Typo="Typo.caption" Class="fw-bold">@context.Standard</MudText>
                        </MudTd>
                        <MudTd DataLabel="Severity">
                            <MudChip T="string" Size="Size.Small" Color="@GetSeverityColor(context.Severity)" Variant="Variant.Outlined">
                                @context.Severity
                            </MudChip>
                        </MudTd>
                        <MudTd DataLabel="Evaluation Check">
                            <MudText Typo="Typo.body2">@context.Description</MudText>
                        </MudTd>
                        <MudTd DataLabel="Status">
                            <MudChip T="string" 
                                     Size="Size.Small" 
                                     Color="@(context.IsPassed ? Color.Success : Color.Error)" 
                                     Variant="Variant.Filled"
                                     Icon="@(context.IsPassed ? Icons.Material.Filled.Check : Icons.Material.Filled.Close)">
                                @(context.IsPassed ? "PASS" : "FAIL")
                            </MudChip>
                        </MudTd>
                        <MudTd DataLabel="Evidentiary Details">
                            <MudText Typo="Typo.caption" Color="Color.Secondary">
                                @context.Details
                            </MudText>
                        </MudTd>
                    </RowTemplate>
                </MudTable>
            </MudPaper>
        }
    </MudTabPanel>

    <!-- Tab 3: External Security Hooks Status (AGSA & ITGC Readiness) -->
    <MudTabPanel Text="External Tool Hooks (ITGC Readiness)" Icon="@Icons.Material.Filled.SettingsInputComponent">
        <MudPaper Elevation="0" Class="pa-4 mb-4 rounded-lg border-subtle">
            <MudText Typo="Typo.subtitle1" Class="fw-bold mb-1">External Tool Integrations &amp; Hook Points</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-3">
                In compliance with AGSA ITGC and ISO 27001 guidelines, the application exposes standard interfaces and configuration placeholders for enterprise external tools. These controls remain in Standby/Ready status until connected to enterprise external services.
            </MudText>

            <MudGrid Spacing="3">
                <!-- Hook 1: SIEM Forwarder -->
                <MudItem xs="12" md="4">
                    <MudCard Elevation="1" Class="h-100 rounded-lg">
                        <MudCardContent>
                            <div class="d-flex justify-space-between align-center mb-2">
                                <MudText Typo="Typo.subtitle2" Class="fw-bold">SIEM / Log Aggregation</MudText>
                                <MudChip T="string" Size="Size.Small" Color="@(_siemStatus.IsConfigured ? Color.Success : Color.Info)" Variant="Variant.Filled">
                                    @(_siemStatus.IsConfigured ? "Connected" : "Hook Ready")
                                </MudChip>
                            </div>
                            <MudText Typo="Typo.caption" Class="d-block fw-bold mb-1">Provider: @_siemStatus.Provider</MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">
                                @_siemStatus.StatusMessage
                            </MudText>
                        </MudCardContent>
                    </MudCard>
                </MudItem>

                <!-- Hook 2: MFA Provider -->
                <MudItem xs="12" md="4">
                    <MudCard Elevation="1" Class="h-100 rounded-lg">
                        <MudCardContent>
                            <div class="d-flex justify-space-between align-center mb-2">
                                <MudText Typo="Typo.subtitle2" Class="fw-bold">MFA / IdP Federation</MudText>
                                <MudChip T="string" Size="Size.Small" Color="@(_mfaStatus.IsConfigured ? Color.Success : Color.Info)" Variant="Variant.Filled">
                                    @(_mfaStatus.IsConfigured ? "Active" : "Hook Ready")
                                </MudChip>
                            </div>
                            <MudText Typo="Typo.caption" Class="d-block fw-bold mb-1">Provider: @_mfaStatus.Provider</MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">
                                @_mfaStatus.StatusMessage
                            </MudText>
                        </MudCardContent>
                    </MudCard>
                </MudItem>

                <!-- Hook 3: Secrets Vault -->
                <MudItem xs="12" md="4">
                    <MudCard Elevation="1" Class="h-100 rounded-lg">
                        <MudCardContent>
                            <div class="d-flex justify-space-between align-center mb-2">
                                <MudText Typo="Typo.subtitle2" Class="fw-bold">Secrets &amp; Key Vault</MudText>
                                <MudChip T="string" Size="Size.Small" Color="@(_vaultStatus.IsConfigured ? Color.Success : Color.Info)" Variant="Variant.Filled">
                                    @(_vaultStatus.IsConfigured ? "Vault Connected" : "Hook Ready")
                                </MudChip>
                            </div>
                            <MudText Typo="Typo.caption" Class="d-block fw-bold mb-1">Provider: @_vaultStatus.Provider</MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">
                                @_vaultStatus.StatusMessage
                            </MudText>
                        </MudCardContent>
                    </MudCard>
                </MudItem>

                <!-- Hook 4: Vulnerability Scanner -->
                <MudItem xs="12" md="4">
                    <MudCard Elevation="1" Class="h-100 rounded-lg">
                        <MudCardContent>
                            <div class="d-flex justify-space-between align-center mb-2">
                                <MudText Typo="Typo.subtitle2" Class="fw-bold">Vulnerability Scanner</MudText>
                                <MudChip T="string" Size="Size.Small" Color="@(_vulnStatus.IsConfigured ? Color.Success : Color.Info)" Variant="Variant.Filled">
                                    @(_vulnStatus.IsConfigured ? "Active Control" : "Hook Ready")
                                </MudChip>
                            </div>
                            <MudText Typo="Typo.caption" Class="d-block fw-bold mb-1">Provider: @_vulnStatus.Provider</MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">
                                @_vulnStatus.StatusMessage
                            </MudText>
                        </MudCardContent>
                    </MudCard>
                </MudItem>

                <!-- Hook 5: Backup & DR Verification -->
                <MudItem xs="12" md="4">
                    <MudCard Elevation="1" Class="h-100 rounded-lg">
                        <MudCardContent>
                            <div class="d-flex justify-space-between align-center mb-2">
                                <MudText Typo="Typo.subtitle2" Class="fw-bold">Backup &amp; DR Verification</MudText>
                                <MudChip T="string" Size="Size.Small" Color="@(_backupStatus.IsConfigured ? Color.Success : Color.Info)" Variant="Variant.Filled">
                                    @(_backupStatus.IsConfigured ? "Active Monitoring" : "Hook Ready")
                                </MudChip>
                            </div>
                            <MudText Typo="Typo.caption" Class="d-block fw-bold mb-1">Provider: @_backupStatus.Provider</MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">
                                @_backupStatus.StatusMessage
                            </MudText>
                        </MudCardContent>
                    </MudCard>
                </MudItem>

                <!-- Hook 6: ITSM Change Ticket -->
                <MudItem xs="12" md="4">
                    <MudCard Elevation="1" Class="h-100 rounded-lg">
                        <MudCardContent>
                            <div class="d-flex justify-space-between align-center mb-2">
                                <MudText Typo="Typo.subtitle2" Class="fw-bold">ITSM CAB Change Control</MudText>
                                <MudChip T="string" Size="Size.Small" Color="@(_itsmStatus.IsConfigured ? Color.Success : Color.Info)" Variant="Variant.Filled">
                                    @(_itsmStatus.IsConfigured ? "CAB Enforced" : "Hook Ready")
                                </MudChip>
                            </div>
                            <MudText Typo="Typo.caption" Class="d-block fw-bold mb-1">Provider: @_itsmStatus.Provider</MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">
                                @_itsmStatus.StatusMessage
                            </MudText>
                        </MudCardContent>
                    </MudCard>
                </MudItem>
            </MudGrid>
        </MudPaper>
    </MudTabPanel>
</MudTabs>

<!-- Detail Inspection Dialog -->
@if (_selectedLog != null)
{
    <MudDialog @bind-Visible="_showDetailDialog" Options="_dialogOptions">
        <TitleContent>
            <div class="d-flex align-center gap-2">
                <MudIcon Icon="@Icons.Material.Filled.Fingerprint" Color="Color.Primary" />
                <MudText Typo="Typo.h6">Audit Record Inspection: @FormatRecordReference(_selectedLog.EntityName, _selectedLog.RecordId)</MudText>
            </div>
        </TitleContent>
        <DialogContent>
            <MudGrid Spacing="2" Class="mb-3">
                <MudItem xs="12" sm="6">
                    <ReadOnlyField Label="Entity Name" Value="@_selectedLog.EntityName" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <ReadOnlyField Label="Record ID" Value="@_selectedLog.RecordId.ToString()" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <ReadOnlyField Label="Action Name" Value="@_selectedLog.ActionName" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <ReadOnlyField Label="Actor Attribution" Value="@_selectedLog.Actor" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <ReadOnlyField Label="Timestamp (UTC)" Value="@_selectedLog.Timestamp.ToString("yyyy-MM-dd HH:mm:ss.fff")" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <ReadOnlyField Label="Digital Security Seal Status" Value="@(_isSealVerified ? "Cryptographically Verified" : "Standard Log")" />
                </MudItem>
            </MudGrid>

            <MudText Typo="Typo.subtitle2" Class="fw-bold mb-1">State Snapshot &amp; Metadata (JSON)</MudText>
            <MudPaper Elevation="0" Class="pa-3 rounded-lg border-subtle" Style="background-color: var(--mud-palette-background-grey); max-height: 300px; overflow-y: auto;">
                <pre class="font-mono text-break" style="font-size: 0.8rem; margin: 0; white-space: pre-wrap;">@FormatJson(_selectedLog.MetadataJson)</pre>
            </MudPaper>
        </DialogContent>
        <DialogActions>
            <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="@(() => _showDetailDialog = false)">
                Close
            </MudButton>
        </DialogActions>
    </MudDialog>
}

@code {
    private readonly List<BreadcrumbItem> _breadcrumbs = new()
    {
        new BreadcrumbItem("Dashboard", "/"),
        new BreadcrumbItem("System Administration", "/admin"),
        new BreadcrumbItem("Audited Change Logs", null, disabled: true)
    };

    private int _activeTab = 0;
    private List<AuditLog> _logs = new();
    private List<AuditLog> _filteredLogs = new();
    private List<string> _distinctEntities = new();
    private List<string> _distinctActions = new();
    private string _searchQuery = string.Empty;
    private string? _selectedEntity;
    private string? _selectedAction;
    private bool _isLoading = true;
    private bool _isExporting = false;
    private bool _isExportingPdf = false;

    // Period Filter State
    private string _periodPreset = "All";
    private DateTime? _fromDate;
    private DateTime? _toDate;
    private int _totalRecordsInPeriod = 0;
    private string _reportIntegrityHash = string.Empty;

    // Compliance Evaluation
    private AuditComplianceReport? _complianceReport;
    private bool _isEvaluatingCompliance = false;

    // External Hooks Status
    private ExternalToolStatus _siemStatus = new();
    private ExternalToolStatus _mfaStatus = new();
    private ExternalToolStatus _vaultStatus = new();
    private ExternalToolStatus _vulnStatus = new();
    private ExternalToolStatus _backupStatus = new();
    private ExternalToolStatus _itsmStatus = new();

    // Detail Dialog
    private bool _showDetailDialog = false;
    private AuditLog? _selectedLog;
    private bool _isSealVerified = false;
    private readonly DialogOptions _dialogOptions = new() { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseButton = true };

    protected override async Task OnInitializedAsync()
    {
        await RefreshHookStatusesAsync();
        await LoadAuditLogsAsync();
    }

    private async Task RefreshHookStatusesAsync()
    {
        _siemStatus = await SiemHook.GetStatusAsync();
        _mfaStatus = await MfaHook.GetStatusAsync();
        _vaultStatus = await VaultHook.GetStatusAsync();
        _vulnStatus = await VulnHook.GetStatusAsync();
        _backupStatus = await BackupHook.GetStatusAsync();
        _itsmStatus = await ItsmHook.GetStatusAsync();
    }

    private async Task LoadAuditLogsAsync()
    {
        _isLoading = true;
        try
        {
            var req = new AuditPeriodFilterRequest
            {
                FromDateUtc = _fromDate.HasValue ? DateTime.SpecifyKind(_fromDate.Value, DateTimeKind.Utc) : null,
                ToDateUtc = _toDate.HasValue ? DateTime.SpecifyKind(_toDate.Value.Date.AddDays(1).AddTicks(-1), DateTimeKind.Utc) : null,
                EntityName = string.IsNullOrWhiteSpace(_selectedEntity) ? null : _selectedEntity,
                ActionName = string.IsNullOrWhiteSpace(_selectedAction) ? null : _selectedAction,
                SearchTerm = string.IsNullOrWhiteSpace(_searchQuery) ? null : _searchQuery,
                PageNumber = 1,
                PageSize = 250
            };

            var result = await AuditService.GetAuditReportByPeriodAsync(req);
            _logs = result.Logs;
            _totalRecordsInPeriod = result.TotalCount;
            _reportIntegrityHash = result.ReportIntegrityHash;

            _distinctEntities = _logs.Select(l => l.EntityName).Where(e => !string.IsNullOrEmpty(e)).Distinct().OrderBy(e => e).ToList();
            _distinctActions = _logs.Select(l => l.ActionName).Where(a => !string.IsNullOrEmpty(a)).Distinct().OrderBy(a => a).ToList();

            _filteredLogs = _logs;
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error loading period audit trail: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task ExportPeriodCsvAsync()
    {
        _isExporting = true;
        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var username = authState.User.Identity?.Name ?? "ADMIN_AUDITOR";

            var req = new AuditPeriodFilterRequest
            {
                FromDateUtc = _fromDate.HasValue ? DateTime.SpecifyKind(_fromDate.Value, DateTimeKind.Utc) : null,
                ToDateUtc = _toDate.HasValue ? DateTime.SpecifyKind(_toDate.Value.Date.AddDays(1).AddTicks(-1), DateTimeKind.Utc) : null,
                EntityName = string.IsNullOrWhiteSpace(_selectedEntity) ? null : _selectedEntity,
                ActionName = string.IsNullOrWhiteSpace(_selectedAction) ? null : _selectedAction,
                SearchTerm = string.IsNullOrWhiteSpace(_searchQuery) ? null : _searchQuery,
                PageNumber = 1,
                PageSize = 1000
            };

            var csvBytes = await AuditService.ExportAuditReportCsvAsync(req, username);
            var base64 = Convert.ToBase64String(csvBytes);
            var fileName = $"merSETA_Audit_Dossier_{DateTime.UtcNow:yyyyMMdd_HHmmss}.csv";

            await JSRuntime.InvokeVoidAsync("downloadFileFromBase64", fileName, "text/csv", base64);
            Snackbar.Add($"Audit dossier successfully exported ({csvBytes.Length:N0} bytes) with cryptographic security seal.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Failed to export audit dossier: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isExporting = false;
        }
    }

    private async Task ExportItgcPdfAsync()
    {
        _isExportingPdf = true;
        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var username = authState.User.Identity?.Name ?? "ADMIN_AUDITOR";

            var req = new AuditPeriodFilterRequest
            {
                FromDateUtc = _fromDate.HasValue ? DateTime.SpecifyKind(_fromDate.Value, DateTimeKind.Utc) : null,
                ToDateUtc = _toDate.HasValue ? DateTime.SpecifyKind(_toDate.Value.Date.AddDays(1).AddTicks(-1), DateTimeKind.Utc) : null,
                EntityName = string.IsNullOrWhiteSpace(_selectedEntity) ? null : _selectedEntity,
                ActionName = string.IsNullOrWhiteSpace(_selectedAction) ? null : _selectedAction,
                SearchTerm = string.IsNullOrWhiteSpace(_searchQuery) ? null : _searchQuery,
                PageNumber = 1,
                PageSize = 1000
            };

            var pdfBytes = await ReportExportService.GenerateItgcAuditDossierPdfAsync(req, username);
            var base64 = Convert.ToBase64String(pdfBytes);
            var fileName = $"merSETA_ITGC_Audit_Dossier_{DateTime.UtcNow:yyyyMMdd_HHmmss}.pdf";

            await JSRuntime.InvokeVoidAsync("downloadFileFromBase64", fileName, "application/pdf", base64);
            Snackbar.Add($"Statutory ITGC audit dossier successfully generated ({pdfBytes.Length:N0} bytes) with cryptographic security seal and QR verification.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Failed to generate ITGC audit dossier: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isExportingPdf = false;
        }
    }

    private async Task OnPeriodPresetChanged(string? preset)
    {
        _periodPreset = preset ?? "All";
        var now = DateTime.UtcNow;

        switch (_periodPreset)
        {
            case "Today":
                _fromDate = now.Date;
                _toDate = now.Date;
                break;
            case "Last7Days":
                _fromDate = now.Date.AddDays(-7);
                _toDate = now.Date;
                break;
            case "Last30Days":
                _fromDate = now.Date.AddDays(-30);
                _toDate = now.Date;
                break;
            case "CurrentQuarter":
                // merSETA Fiscal Quarters: Q1: Apr-Jun, Q2: Jul-Sep, Q3: Oct-Dec, Q4: Jan-Mar
                var m = now.Month;
                int qStartMonth = m switch { >= 4 and <= 6 => 4, >= 7 and <= 9 => 7, >= 10 and <= 12 => 10, _ => 1 };
                var qYear = now.Year;
                _fromDate = new DateTime(qYear, qStartMonth, 1);
                _toDate = _fromDate.Value.AddMonths(3).AddDays(-1);
                break;
            case "CurrentFiscalYear":
                var fyStartYear = now.Month >= 4 ? now.Year : now.Year - 1;
                _fromDate = new DateTime(fyStartYear, 4, 1);
                _toDate = new DateTime(fyStartYear + 1, 3, 31);
                break;
            case "All":
            default:
                _fromDate = null;
                _toDate = null;
                break;
        }

        await LoadAuditLogsAsync();
    }

    private async Task OnFromDateChanged(DateTime? date)
    {
        _fromDate = date;
        _periodPreset = "Custom";
        await LoadAuditLogsAsync();
    }

    private async Task OnToDateChanged(DateTime? date)
    {
        _toDate = date;
        _periodPreset = "Custom";
        await LoadAuditLogsAsync();
    }

    private async Task ApplyFiltersAsync()
    {
        await LoadAuditLogsAsync();
    }

    private async Task RunComplianceAuditAsync()
    {
        _isEvaluatingCompliance = true;
        try
        {
            _complianceReport = await ComplianceService.RunFullComplianceAuditAsync();
            Snackbar.Add($"Compliance audit complete: {_complianceReport.AssessmentStatus} ({_complianceReport.ComplianceScorePercentage:F1}%)", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Failed to run compliance evaluation: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isEvaluatingCompliance = false;
        }
    }

    private void OpenDetailDialog(AuditLog log)
    {
        _selectedLog = log;
        _isSealVerified = ComplianceService.VerifyAuditRecordSecuritySeal(log);
        _showDetailDialog = true;
    }

    private static bool HasDigitalSecuritySeal(AuditLog log)
    {
        return !string.IsNullOrWhiteSpace(log.MetadataJson) && log.MetadataJson.Contains("digitalSecuritySeal");
    }

    private static string FormatJson(string? rawJson)
    {
        if (string.IsNullOrWhiteSpace(rawJson)) return "No differential state metadata recorded.";
        try
        {
            using var doc = System.Text.Json.JsonDocument.Parse(rawJson);
            return System.Text.Json.JsonSerializer.Serialize(doc.RootElement, new System.Text.Json.JsonSerializerOptions { WriteIndented = true });
        }
        catch
        {
            return rawJson;
        }
    }

    private Color GetActionColor(string action)
    {
        return action?.ToLowerInvariant() switch
        {
            "create" or "created" or "inserted" => Color.Success,
            "update" or "updated" or "modified" or "statuschanged" => Color.Info,
            "delete" or "deleted" or "removed" => Color.Error,
            "disbursed" or "approved" => Color.Primary,
            "rejected" or "cancelled" => Color.Warning,
            "export_audit_report" => Color.Secondary,
            _ => Color.Secondary
        };
    }

    private static Color GetScoreColor(double score)
    {
        return score switch
        {
            >= 95.0 => Color.Success,
            >= 80.0 => Color.Info,
            >= 60.0 => Color.Warning,
            _ => Color.Error
        };
    }

    private static Color GetSeverityColor(string severity)
    {
        return severity?.ToUpperInvariant() switch
        {
            "CRITICAL" => Color.Error,
            "HIGH" => Color.Warning,
            "MEDIUM" => Color.Info,
            _ => Color.Default
        };
    }

    private async Task ResetFilters()
    {
        _searchQuery = string.Empty;
        _selectedEntity = null;
        _selectedAction = null;
        _periodPreset = "All";
        _fromDate = null;
        _toDate = null;
        await LoadAuditLogsAsync();
    }

    private static string FormatRecordReference(string? entityName, long recordId)
    {
        var prefix = entityName?.ToUpperInvariant() switch
        {
            "ORGANISATION" or "EMPLOYER" => "ORG",
            "GRANTMOA" => "MOA",
            "GRANTAPPLICATION" => "DG",
            "PERSON" or "USER" => "USR",
            "LEARNER" => "LRN",
            "TRAININGPROVIDER" or "SDP" => "SDP",
            "WSPSUBMISSION" => "WSP",
            "WORKPLACEAPPROVAL" => "WPA",
            _ => (entityName != null && entityName.Length >= 3 ? entityName[..3].ToUpperInvariant() : "REC")
        };
        return $"{prefix}-{recordId:D5}";
    }
}
