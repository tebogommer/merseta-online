    private async Task DeactivateFiscalYearAsync()
    {
        var parameters = new DialogParameters<ConfirmDialog>
        {
            { x => x.Title, "Deactivate Financial Year" },
            { x => x.Consequence, $"Are you sure you want to deactivate Financial Year '{_yearModel.FinYearCode}'? It will be marked Inactive and locked against new grant allocations and submissions." },
            { x => x.ConfirmLabel, "Deactivate" },
            { x => x.RequiresReason, false },
            { x => x.IsDestructive, true }
        };

        var dialog = await DialogService.ShowAsync<ConfirmDialog>("Deactivate Financial Year", parameters);
        var result = await dialog.Result;

        if (result != null && !result.Canceled)
        {
            try
            {
                var (userId, _) = await GetCurrentUserAsync();
                var updated = await FiscalService.DeactivateFiscalYearAsync(_yearModel.Id, userId);
                _yearModel = updated;
                Snackbar.Add($"Financial Year '{updated.FinYearCode}' has been deactivated.", Severity.Info);
                await LoadDataAsync();
            }
            catch (Exception ex)
            {
                Snackbar.Add($"Error deactivating financial year: {ex.Message}", Severity.Error);
            }
