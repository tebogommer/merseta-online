    private async Task ConfirmDeleteAsync()
    {
        if (_yearModel.StatusCode == FinancialYearStatus.Active || _yearModel.StatusCode == FinancialYearStatus.UnderReview)
        {
            Snackbar.Add($"Cannot delete financial year in '{_yearModel.StatusCode}' status.", Severity.Warning);
            return;
        }

        var parameters = new DialogParameters<ConfirmDialog>
        {
            { x => x.Title, "Confirm Deletion" },
            { x => x.Consequence, $"Are you sure you want to permanently delete Financial Year '{_yearModel.FinYearCode}'? This action cannot be undone." },
            { x => x.ConfirmLabel, "Delete" },
            { x => x.IsDestructive, true }
        };

        var dialog = await DialogService.ShowAsync<ConfirmDialog>("Confirm Deletion", parameters);
        var result = await dialog.Result;

        if (result != null && !result.Canceled)
        {
            try
            {
                var (userId, _) = await GetCurrentUserAsync();
                await FiscalService.DeleteFinancialYearAsync(_yearModel.Id, userId);
                Snackbar.Add($"Financial Year '{_yearModel.FinYearCode}' deleted successfully.", Severity.Success);
                Navigation.NavigateTo("/admin/financial-years");
            }
            catch (Exception ex)
            {
                Snackbar.Add($"Error deleting financial year: {ex.Message}", Severity.Error);
            }
        }
    }

    private void HandleBackNavigation()
    {
        Navigation.NavigateTo("/admin/financial-years");
    }

    private static string? FormatAuditDetails(string? json)
    {
        if (string.IsNullOrWhiteSpace(json)) return null;
        try
        {
            using var doc = JsonDocument.Parse(json);
            var root = doc.RootElement;
            if (root.TryGetProperty("after", out var after) && after.ValueKind == JsonValueKind.Object)
            {
                var parts = new List<string>();
                foreach (var prop in after.EnumerateObject())
                {
                    if (prop.Value.ValueKind != JsonValueKind.Null)
                    {
                        parts.Add($"{prop.Name}: {prop.Value}");
                    }
                }
                if (parts.Any()) return string.Join(" | ", parts);
            }
            else if (root.TryGetProperty("description", out var desc))
            {
                return desc.GetString();
            }
            return json;
        }
        catch
        {
            return json;
        }
    }

    private string GetStepBorderClass(int stepNumber)
    {
        var currentStep = GetCurrentStepNumber();
        if (currentStep == stepNumber) return "mud-border-primary border-2";
        if (currentStep > stepNumber) return "mud-border-success";
        return "mud-border-default";
    }

    private Color GetStepAvatarColor(int stepNumber)
    {
        var currentStep = GetCurrentStepNumber();
        if (currentStep == stepNumber) return Color.Primary;
        if (currentStep > stepNumber) return Color.Success;
        return Color.Default;
    }

    private int GetCurrentStepNumber() => _yearModel.StatusCode switch
    {
        FinancialYearStatus.Draft => 1,
        FinancialYearStatus.AmendmentDraft => 1,
        FinancialYearStatus.UnderReview => 2,
        FinancialYearStatus.Active => 3,
        FinancialYearStatus.Inactive => 4,
        _ => 1
    };

    private static Color GetQuarterColor(int quarterNumber) => quarterNumber switch
    {
        1 => Color.Primary,
        2 => Color.Secondary,
        3 => Color.Tertiary,
        4 => Color.Info,
        _ => Color.Default
    };

    private static Color GetStatusColor(string status) => status?.Trim() switch
    {
        FinancialYearStatus.Active => Color.Success,
        FinancialYearStatus.UnderReview => Color.Warning,
        FinancialYearStatus.Draft => Color.Default,
        FinancialYearStatus.AmendmentDraft => Color.Info,
        FinancialYearStatus.Inactive => Color.Secondary,
        _ => Color.Default
    };

    private record FlatMonthRow
    {
        public string QuarterCode { get; set; } = string.Empty;
        public int QuarterNumber { get; set; }
        public int MonthNumber { get; set; }
        public string MonthName { get; set; } = string.Empty;
        public int CalendarYear { get; set; }
        public DateTime StartDate { get; set; }
        public DateTime EndDate { get; set; }
        public int CalendarDaysCount { get; set; }
        public int WorkingDaysCount { get; set; }
        public int PublicHolidaysCount { get; set; }
        public List<string> ObservedHolidays { get; set; } = new();
    }

    private record AuditLogEntryDto
    {
        public string ActionName { get; set; } = string.Empty;
        public string Actor { get; set; } = string.Empty;
        public DateTime Timestamp { get; set; }
        public string? Details { get; set; }
    }
}
