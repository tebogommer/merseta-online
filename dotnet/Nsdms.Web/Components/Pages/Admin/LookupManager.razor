@page "/admin/lookups/{TableName}"
@using Nsdms.Application.Services
@using Nsdms.Web.Components.Shared
@using MudBlazor
@inject ILookupService LookupService
@inject NavigationManager NavManager
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@rendermode InteractiveServer

@*
  UI-STANDARD.md Archetype: T3 (Reference Data Maintenance View/Edit)
  Clauses: 4.3, 5.1, 5.2.3, 6.2, 8.3, 10, 11.9
  Rules:
  - Reference data is deactivated, never deleted once referenced (Clause 6.2).
  - Open in View mode, explicit Edit action.
  - Page size ladder: 5, 10, 20, 50, 100, 250, 500.
*@

<EntityHeader Title="@($"lookup.{TableName}")"
              Subtitle="@($"Statutory reference table codes and descriptions for {TableName}")"
              ReferenceKey="@TableName"
              Status="Active"
              BreadcrumbItems="@_breadcrumbs">
    <ActionZone>
        @if (_pageMode == FormShell.PageMode.View)
        {
            <MudButton Variant="Variant.Filled" 
                       Color="Color.Primary" 
                       StartIcon="@Icons.Material.Filled.Add" 
                       OnClick="OpenCreateMode">
                Add Reference Code
            </MudButton>
        }
    </ActionZone>
</EntityHeader>

<FormShell Mode="@_pageMode" 
           IsDirty="@_isDirty" 
           IsSaving="@_isSaving" 
           OnSave="SaveItemAsync" 
           OnCancel="CancelEdit">
    @if (_pageMode != FormShell.PageMode.View && _editingItem != null)
    {
        <MudCard Outlined="true" Class="pa-4 mb-4 border-default">
            <MudText Typo="Typo.subtitle1" Class="fw-bold mb-3">
                @(_pageMode == FormShell.PageMode.Create ? $"Capture New {TableName} Code" : $"Edit Reference Code: {_editingItem.Code}")
            </MudText>
            <MudGrid>
                <MudItem xs="12" md="3">
                    <FieldGroup Label="Code Identifier" 
                                Required="true" 
                                HelperText="Unique uppercase primary key (varchar 50)">
                        <MudTextField T="string" 
                                      Required="true" 
                                      Disabled="@(_pageMode == FormShell.PageMode.Edit)" 
                                      @bind-Value="_editingItem.Code" 
                                      @bind-Value:after="MarkDirty"
                                      MaxLength="50" 
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense" />
                    </FieldGroup>
                </MudItem>
                <MudItem xs="12" md="4">
                    <FieldGroup Label="Display Name" 
                                Required="true" 
                                HelperText="Official title or label">
                        <MudTextField T="string" 
                                      Required="true" 
                                      @bind-Value="_editingItem.Name" 
                                      @bind-Value:after="MarkDirty"
                                      MaxLength="250" 
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense" />
                    </FieldGroup>
                </MudItem>
                <MudItem xs="12" md="5">
                    <FieldGroup Label="Description" 
                                HelperText="Optional operational explanation">
                        <MudTextField T="string" 
                                      @bind-Value="_editingItem.Description" 
                                      @bind-Value:after="MarkDirty"
                                      MaxLength="500" 
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense" />
                    </FieldGroup>
                </MudItem>
                <MudItem xs="12">
                    <MudSwitch T="bool" 
                               @bind-Value="_editingItem.Active" 
                               @bind-Value:after="MarkDirty"
                               Color="Color.Success" 
                               Label="Active Status (Deactivating prevents future selection while preserving legacy audit integrity)" />
                </MudItem>
            </MudGrid>
        </MudCard>
    }

    <!-- Table of Reference Data (Baseline 11.9) -->
    <MudPaper Class="pa-4 border-default" Elevation="1">
        <div class="d-flex justify-space-between align-center mb-3">
            <MudTextField @bind-Value="_searchString" 
                          Placeholder="Filter reference codes and names..." 
                          Adornment="Adornment.Start" 
                          AdornmentIcon="@Icons.Material.Filled.Search" 
                          Immediate="true" 
                          OnKeyUp="HandleSearchAsync" 
                          Clearable="true" 
                          OnClearButtonClick="HandleSearchAsync"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense" />
            <MudChip T="string" Color="Color.Primary" Size="Size.Small" Variant="Variant.Outlined">
                @_totalCount total records
            </MudChip>
        </div>

        @if (_loading)
        {
            <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="my-7" />
        }
        else if (!_items.Any())
        {
            <EmptyState Title="No Codes Found"
                        Message="No reference codes match your search query."
                        ActionLabel="Clear Search"
                        OnAction="ClearSearchAsync" />
        }
        else
        {
            <MudTable Items="@_items" Hover="true" Dense="true" T="LookupItemDto" Elevation="0" Class="border-default">
                <HeaderContent>
                    <MudTh>Code (PK)</MudTh>
                    <MudTh>Display Name</MudTh>
                    <MudTh>Description</MudTh>
                    <MudTh>Status</MudTh>
                    <MudTh Style="text-align:right">Actions</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Code">
                        <MudChip T="string" Size="Size.Small" Color="Color.Dark" Variant="Variant.Outlined" Class="font-monospace fw-bold">
                            @context.Code
                        </MudChip>
                    </MudTd>
                    <MudTd DataLabel="Name">
                        <MudText Typo="Typo.body2" Class="fw-bold">@context.Name</MudText>
                    </MudTd>
                    <MudTd DataLabel="Description">
                        <MudText Typo="Typo.body2" Color="Color.Secondary">@(string.IsNullOrWhiteSpace(context.Description) ? "—" : context.Description)</MudText>
                    </MudTd>
                    <MudTd DataLabel="Status">
                        <StatusBadge Status="@(context.Active ? "Active" : "Inactive")" Size="Size.Small" />
                    </MudTd>
                    <MudTd Style="text-align:right">
                        <div class="d-flex justify-end gap-1">
                            <MudIconButton Icon="@Icons.Material.Filled.Edit" 
                                           Color="Color.Primary" 
                                           Size="Size.Small" 
                                           OnClick="@(() => OpenEditMode(context))" 
                                           aria-label="Edit Item" />
                            <MudIconButton Icon="@(context.Active ? Icons.Material.Filled.ToggleOn : Icons.Material.Filled.ToggleOff)" 
                                           Color="@(context.Active ? Color.Success : Color.Secondary)" 
                                           Size="Size.Small" 
                                           OnClick="@(() => ToggleActiveStatusAsync(context))" 
                                           aria-label="@(context.Active ? "Deactivate Code" : "Activate Code")" />
                        </div>
                    </MudTd>
                </RowTemplate>
                <PagerContent>
                    <MudTablePager PageSizeOptions="new int[] { 5, 10, 20, 50, 100, 250, 500 }" />
                </PagerContent>
            </MudTable>
        }
    </MudPaper>
</FormShell>

@code {
    [Parameter] 
    public string TableName { get; set; } = string.Empty;

    private List<LookupItemDto> _items = new();
    private string _searchString = string.Empty;
    private int _totalCount = 0;
    private bool _loading = true;
    private bool _isDirty = false;
    private bool _isSaving = false;
    private FormShell.PageMode _pageMode = FormShell.PageMode.View;
    private LookupItemDto? _editingItem;

    private List<BreadcrumbItem> _breadcrumbs = new();

    protected override async Task OnParametersSetAsync()
    {
        _breadcrumbs = new()
        {
            new BreadcrumbItem("Home", href: "/"),
            new BreadcrumbItem("Lookup Hub", href: "/admin/lookups"),
            new BreadcrumbItem(TableName, href: null, disabled: true)
        };

        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        _loading = true;
        try
        {
            _totalCount = await LookupService.GetLookupItemsCountAsync(TableName, _searchString);
            _items = await LookupService.GetLookupItemsAsync(TableName, _searchString, 0, 500);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error loading reference data: {ex.Message}", Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task HandleSearchAsync()
    {
        await LoadDataAsync();
    }

    private async Task ClearSearchAsync()
    {
        _searchString = string.Empty;
        await LoadDataAsync();
    }

    private void MarkDirty()
    {
        _isDirty = true;
    }

    private void OpenCreateMode()
    {
        _editingItem = new LookupItemDto { Active = true };
        _pageMode = FormShell.PageMode.Create;
        _isDirty = false;
    }

    private void OpenEditMode(LookupItemDto item)
    {
        _editingItem = new LookupItemDto
        {
            Code = item.Code,
            Name = item.Name,
            Description = item.Description,
            Active = item.Active
        };
        _pageMode = FormShell.PageMode.Edit;
        _isDirty = false;
    }

    private void CancelEdit()
    {
        _editingItem = null;
        _pageMode = FormShell.PageMode.View;
        _isDirty = false;
    }

    private async Task SaveItemAsync()
    {
        if (_editingItem == null) return;

        if (string.IsNullOrWhiteSpace(_editingItem.Code) || string.IsNullOrWhiteSpace(_editingItem.Name))
        {
            Snackbar.Add("Code and Name are mandatory.", Severity.Warning);
            return;
        }

        _isSaving = true;
        try
        {
            await LookupService.SaveLookupItemAsync(TableName, _editingItem, "Admin");
            Snackbar.Add($"Reference code {_editingItem.Code} saved successfully.", Severity.Success);
            _editingItem = null;
            _pageMode = FormShell.PageMode.View;
            _isDirty = false;
            await LoadDataAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error saving code: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isSaving = false;
        }
    }

    private async Task ToggleActiveStatusAsync(LookupItemDto item)
    {
        var actionVerb = item.Active ? "Deactivate" : "Activate";
        bool? confirmed = await DialogService.ShowMessageBoxAsync(
            $"{actionVerb} Reference Code: {item.Code}?",
            item.Active 
                ? $"Deactivating code '{item.Code} ({item.Name})' will prevent users from selecting it in future records. Existing historical records referencing this code will remain intact."
                : $"Reactivating code '{item.Code} ({item.Name})' will make it available for selection across all modules.",
            yesText: $"{actionVerb} Code",
            cancelText: "Cancel"
        );

        if (confirmed == true)
        {
            item.Active = !item.Active;
            try
            {
                await LookupService.SaveLookupItemAsync(TableName, item, "Admin");
                Snackbar.Add($"Reference code {item.Code} status updated to {(item.Active ? "Active" : "Inactive")}.", Severity.Success);
                await LoadDataAsync();
            }
            catch (Exception ex)
            {
                Snackbar.Add($"Error updating status: {ex.Message}", Severity.Error);
            }
        }
    }
}
