@page "/admin/broadcasts/{Id:int}"
@attribute [Authorize(Roles = "SuperAdmin,Admin,Executive,CLO")]
@namespace Nsdms.Web.Components.Pages.Admin
@using Microsoft.AspNetCore.Authorization
@using MudBlazor
@using Nsdms.Application.Common.Interfaces
@using Nsdms.Domain.Entities
@using Nsdms.Web.Components.Shared
@inject IEmailOutboxService OutboxService
@inject NavigationManager Nav
@inject ISnackbar Snackbar
@inject IJSRuntime JS

<main id="main-content" style="max-width: 1600px; margin: 0 auto;">
    @if (_loading)
    {
        <div class="d-flex justify-center align-center py-12">
            <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Large" />
        </div>
    }
    else if (_broadcast == null)
    {
        <EmptyState Title="Broadcast Campaign Not Found"
                    Description="The requested broadcast record could not be found."
                    ActionLabel="Back to Broadcasts"
                    ActionHref="/admin/broadcasts"
                    Icon="@Icons.Material.Filled.SearchOff" />
    }
    else
    {
        <!-- Page Header (Archetype A3 Detail) -->
        <EntityHeader Title="@_broadcast.Subject"
                      Subtitle="@($"Targeted Audience: {_broadcast.TargetFilterDisplay} • Dispatched by {_broadcast.CreatedBy}")"
                      Status="@_broadcast.Status"
                      Reference="@($"BCAST-{_broadcast.Id:D5}")"
                      BreadcrumbItems="@_breadcrumbs">
            <Actions>
                <MudButton Variant="Variant.Outlined"
                           Color="Color.Default"
                           StartIcon="@Icons.Material.Filled.Refresh"
                           OnClick="LoadBroadcastDetailsAsync"
                           Size="Size.Medium">
                    Refresh Status
                </MudButton>
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.ArrowBack"
                           Href="/admin/broadcasts"
                           Size="Size.Medium">
                    Back to List
                </MudButton>
            </Actions>
        </EntityHeader>

        <!-- KPI Delivery Status Cards -->
        <MudGrid Class="mb-4">
            <MudItem xs="12" sm="6" md="2">
                <StatCard Title="Total Recipients" Value="@_broadcast.RecipientCount.ToString()" Icon="@Icons.Material.Filled.People" Color="Color.Primary" />
            </MudItem>
            <MudItem xs="12" sm="6" md="2">
                <StatCard Title="Emails Sent" Value="@_broadcast.SentEmailsCount.ToString()" Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success" />
            </MudItem>
            <MudItem xs="12" sm="6" md="2">
                <StatCard Title="In Queue / Pending" Value="@_broadcast.PendingEmailsCount.ToString()" Icon="@Icons.Material.Filled.HourglassTop" Color="Color.Info" />
            </MudItem>
            <MudItem xs="12" sm="6" md="2">
                <StatCard Title="Throttled (Rate Limit)" Value="@_broadcast.ThrottledEmailsCount.ToString()" Icon="@Icons.Material.Filled.Speed" Color="Color.Warning" />
            </MudItem>
            <MudItem xs="12" sm="6" md="2">
                <StatCard Title="Failed Deliveries" Value="@_broadcast.FailedEmailsCount.ToString()" Icon="@Icons.Material.Filled.Error" Color="Color.Error" />
            </MudItem>
            <MudItem xs="12" sm="6" md="2">
                <StatCard Title="Has Attachment" Value="@(_broadcast.HasAttachment ? "Yes (PDF)" : "None")" Icon="@Icons.Material.Filled.AttachFile" Color="Color.Secondary" />
            </MudItem>
        </MudGrid>

        <!-- Detail Tabs -->
        <MudTabs Rounded="true" ApplyEffectsToContainer="true" Color="Color.Primary" Elevation="1" Class="mt-2">
            <!-- Tab 1: Circular Content & Attachment -->
            <MudTabPanel Text="Circular Content &amp; Attachment" Icon="@Icons.Material.Filled.Article">
                <MudPaper Class="pa-6" Elevation="0">
                    <div class="d-flex flex-wrap justify-space-between align-center pb-4 mb-4 border-b gap-2">
                        <div>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">DISPATCH TIMESTAMP</MudText>
                            <MudText Typo="Typo.body2" Class="fw-bold font-mono">
                                @_broadcast.CreatedAt.ToLocalTime().ToString("dddd, dd MMMM yyyy 'at' HH:mm:ss")
                            </MudText>
                        </div>
                        <div>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">DELIVERY CHANNEL</MudText>
                            <MudText Typo="Typo.body2" Class="fw-bold">In-App SignalR Pop-up + Throttled Office 365 Email</MudText>
                        </div>
                        <div>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">AUDITED INITIATOR</MudText>
                            <MudText Typo="Typo.body2" Class="font-mono">@_broadcast.CreatedBy</MudText>
                        </div>
                    </div>

                    <!-- Rendered HTML Content -->
                    <div class="pa-4 border rounded" style="background: var(--mud-palette-surface); line-height: 1.8; font-size: 0.95rem;">
                        @((MarkupString)_broadcast.BodyHtml)
                    </div>

                    <!-- Attachment Download Card -->
                    @if (_broadcast.HasAttachment && !string.IsNullOrWhiteSpace(_broadcast.AttachmentFileName))
                    {
                        <MudPaper Class="pa-4 mt-6 border rounded" Style="background-color: var(--mud-palette-background-grey);" Elevation="0">
                            <div class="d-flex flex-column flex-sm-row justify-space-between align-start align-sm-center gap-3">
                                <div class="d-flex align-center gap-3">
                                    <MudAvatar Color="Color.Error" Variant="Variant.Filled" Size="Size.Medium">
                                        <MudIcon Icon="@Icons.Material.Filled.PictureAsPdf" />
                                    </MudAvatar>
                                    <div>
                                        <MudText Typo="Typo.subtitle2" Class="fw-bold">
                                            @_broadcast.AttachmentFileName
                                        </MudText>
                                        <MudText Typo="Typo.caption" Color="Color.Secondary">
                                            Official Attached Document • @FormatFileSize(_broadcast.AttachmentSizeBytes ?? 0)
                                        </MudText>
                                    </div>
                                </div>
                                <MudButton Variant="Variant.Filled"
                                           Color="Color.Primary"
                                           StartIcon="@Icons.Material.Filled.Download"
                                           OnClick="DownloadAttachmentAsync"
                                           Disabled="@_downloading"
                                           Size="Size.Medium">
                                    @if (_downloading)
                                    {
                                        <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                                        <span>Downloading...</span>
                                    }
                                    else
                                    {
                                        <span>Download Attachment</span>
                                    }
                                </MudButton>
                            </div>
                        </MudPaper>
                    }
                </MudPaper>
            </MudTabPanel>

            <!-- Tab 2: Outbound Email Delivery Queue -->
            <MudTabPanel Text="Outbound Email Queue (Per-Recipient)" Icon="@Icons.Material.Filled.Email">
                <MudPaper Class="pa-4" Elevation="0">
                    <MudTable Items="@_broadcast.OutboxItems"
                              Hover="true"
                              Dense="true"
                              Elevation="0"
                              Class="border rounded">
                        <HeaderContent>
                            <MudTh>Recipient Email</MudTh>
                            <MudTh>Name / Username</MudTh>
                            <MudTh>Delivery Status</MudTh>
                            <MudTh>Attempts</MudTh>
                            <MudTh>Sent / Dispatched At</MudTh>
                            <MudTh>Error Diagnostics</MudTh>
                            <MudTh Style="text-align: right;">Action</MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd Class="font-mono">@context.RecipientEmail</MudTd>
                            <MudTd>@(context.RecipientName ?? context.RecipientUsername ?? "-")</MudTd>
                            <MudTd>
                                <StatusBadge Status="@context.Status" Size="Size.Small" />
                            </MudTd>
                            <MudTd>
                                <span class="font-mono">@context.AttemptCount</span>
                            </MudTd>
                            <MudTd>
                                <span class="font-mono text-secondary" style="font-size: 0.8125rem;">
                                    @(context.SentAt?.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss") ?? "-")
                                </span>
                            </MudTd>
                            <MudTd>
                                @if (!string.IsNullOrWhiteSpace(context.LastError))
                                {
                                    <MudText Typo="Typo.caption" Color="Color.Error" Class="text-truncate" Style="max-width: 250px;">
                                        @context.LastError
                                    </MudText>
                                }
                                else
                                {
                                    <span class="text-secondary">-</span>
                                }
                            </MudTd>
                            <MudTd Style="text-align: right;">
                                @if (context.Status == "Failed" || context.Status == "Throttled")
                                {
                                    <MudButton Variant="Variant.Outlined"
                                               Color="Color.Primary"
                                               Size="Size.Small"
                                               StartIcon="@Icons.Material.Filled.Replay"
                                               OnClick="@(() => RetryItemAsync(context.Id))">
                                        Retry
                                    </MudButton>
                                }
                                else
                                {
                                    <span class="text-secondary">-</span>
                                }
                            </MudTd>
                        </RowTemplate>
                    </MudTable>
                </MudPaper>
            </MudTabPanel>
        </MudTabs>
    }
</main>

@code {
    [Parameter] public int Id { get; set; }

    private bool _loading = true;
    private bool _downloading = false;
    private BroadcastMessageDetailDto? _broadcast;

    private List<BreadcrumbItem> _breadcrumbs = new();

    protected override async Task OnInitializedAsync()
    {
        _breadcrumbs = new List<BreadcrumbItem>
        {
            new BreadcrumbItem("Home", href: "/"),
            new BreadcrumbItem("Broadcasts", href: "/admin/broadcasts"),
            new BreadcrumbItem($"Broadcast #{Id}", href: null, disabled: true)
        };

        await LoadBroadcastDetailsAsync();
    }

    private async Task LoadBroadcastDetailsAsync()
    {
        _loading = true;
        try
        {
            _broadcast = await OutboxService.GetBroadcastByIdAsync(Id);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error loading broadcast details: {ex.Message}", Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task DownloadAttachmentAsync()
    {
        if (_broadcast?.AttachmentStoragePath == null) return;

        _downloading = true;
        try
        {
            var bytes = await OutboxService.GetAttachmentBytesAsync(_broadcast.AttachmentStoragePath);
            if (bytes == null || bytes.Length == 0)
            {
                Snackbar.Add("Attachment file is not accessible on storage disk.", Severity.Warning);
                return;
            }

            var base64 = Convert.ToBase64String(bytes);
            var mime = _broadcast.AttachmentContentType ?? "application/octet-stream";
            var filename = _broadcast.AttachmentFileName ?? "Document.pdf";

            await JS.InvokeVoidAsync("eval", $@"
                (function() {{
                    var a = document.createElement('a');
                    a.href = 'data:{mime};base64,{base64}';
                    a.download = '{filename}';
                    document.body.appendChild(a);
                    a.click();
                    document.body.removeChild(a);
                }})();
            ");

            Snackbar.Add($"Downloaded {filename}", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Download failed: {ex.Message}", Severity.Error);
        }
        finally
        {
            _downloading = false;
        }
    }

    private async Task RetryItemAsync(long outboxItemId)
    {
        try
        {
            await OutboxService.RetryOutboxItemAsync(outboxItemId, "ADMIN");
            Snackbar.Add("Item reset to Pending for next throttled dispatch cycle.", Severity.Success);
            await LoadBroadcastDetailsAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Retry failed: {ex.Message}", Severity.Error);
        }
    }

    private static string FormatFileSize(long bytes)
    {
        if (bytes <= 0) return "0 B";
        if (bytes < 1024) return $"{bytes} B";
        if (bytes < 1024 * 1024) return $"{bytes / 1024.0:F1} KB";
        return $"{bytes / (1024.0 * 1024.0):F2} MB";
    }
}
