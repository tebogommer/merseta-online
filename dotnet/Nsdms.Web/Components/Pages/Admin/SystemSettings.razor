@page "/admin/settings"
@using Nsdms.Application.Common.Interfaces
@using Nsdms.Domain.Entities
@using Nsdms.Web.Components.Shared
@using MudBlazor
@inject IFeatureFlagService FeatureFlags
@inject ISystemConfigurationService ConfigService
@inject IErpIntegrationService ErpService
@inject IPdfDocumentService PdfService
@inject ISnackbar Snackbar
@inject IDialogService DialogService

@*
  UI-STANDARD.md Archetype: T3 (System Settings & Feature Flags Configuration)
  Clauses: 4.2, 4.3, 5.1, 8.3, 10, 11.9
*@

<PageTitle>System Settings &amp; Feature Flags | MerSETA NSDMS</PageTitle>

<EntityHeader Title="System Configuration &amp; Feature Flags"
              Subtitle="Cascading enterprise configuration engine with dynamic database overrides and double-write audit logging."
              ReferenceKey="SYS-CONFIG"
              Status="Active"
              BreadcrumbItems="@_breadcrumbs">
    <ActionZone>
        <MudButton Variant="Variant.Outlined" 
                   Color="Color.Primary" 
                   StartIcon="@Icons.Material.Filled.Refresh" 
                   OnClick="LoadDataAsync">
            Refresh
        </MudButton>
        <MudButton Variant="Variant.Filled" 
                   Color="Color.Primary" 
                   StartIcon="@Icons.Material.Filled.Add" 
                   OnClick="OpenNewConfigDrawer">
            Add Parameter
        </MudButton>
    </ActionZone>
</EntityHeader>

@if (_isLoading)
{
    <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="mb-4" />
}

<!-- Tabs -->
<MudTabs Elevation="2" Rounded="true" ApplyEffectsToContainer="true" Color="Color.Primary" Class="mb-4">
    <!-- Tab 1: Feature Flags -->
    <MudTabPanel Text="Feature Flags &amp; Integrations" Icon="@Icons.Material.Filled.ToggleOn">
        <div class="pa-4">
            <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="mb-4">
                <strong>Zero-Risk Invariant:</strong> Third-party integrations (Dynamics GP, Sage ERP, Live DHET SFTP, Live SARS FTP, SMS OTP) are <strong>OFF by default</strong>. Workflows automatically execute in mock simulation mode when disabled.
            </MudAlert>

            <MudGrid>
                @foreach (var flag in _featureFlags)
                {
                    <MudItem xs="12" md="6">
                        <MudCard Outlined="true" Class="pa-3 h-100 border-default">
                            <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                                <div>
                                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                        <MudText Typo="Typo.subtitle1" Class="fw-bold">@flag.FeatureName</MudText>
                                        <MudChip T="string" Size="Size.Small" Color="@(flag.Category == "Integrations" ? Color.Warning : Color.Info)" Variant="Variant.Outlined">
                                            @flag.Category
                                        </MudChip>
                                    </MudStack>
                                    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="d-block mt-1">@flag.Description</MudText>
                                    <MudText Typo="Typo.caption" Class="font-monospace text-secondary">Key: @flag.FeatureKey</MudText>
                                </div>
                                <MudSwitch T="bool" 
                                           Value="@flag.IsEnabled" 
                                           ValueChanged="@((bool val) => ToggleFeatureAsync(flag, val))" 
                                           Color="Color.Success" 
                                           Label="@(flag.IsEnabled ? "Enabled" : "Disabled")"
                                           aria-label="@($"Toggle {flag.FeatureName}")" />
                            </MudStack>
                        </MudCard>
                    </MudItem>
                }
            </MudGrid>
        </div>
    </MudTabPanel>

    <!-- Tab 2: System Configurations -->
    <MudTabPanel Text="System Configurations" Icon="@Icons.Material.Filled.Settings">
        <div class="pa-4">
            <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-3" Spacing="2">
                <MudChipSet T="string" @bind-SelectedValue="_selectedCategory" SelectionMode="SelectionMode.SingleSelection">
                    <MudChip T="string" Value="@("All")" Color="Color.Primary" Variant="@(_selectedCategory == "All" ? Variant.Filled : Variant.Outlined)">All</MudChip>
                    <MudChip T="string" Value="@("Finance")" Color="Color.Success" Variant="@(_selectedCategory == "Finance" ? Variant.Filled : Variant.Outlined)">Finance</MudChip>
                    <MudChip T="string" Value="@("Governance")" Color="Color.Info" Variant="@(_selectedCategory == "Governance" ? Variant.Filled : Variant.Outlined)">Governance</MudChip>
                    <MudChip T="string" Value="@("Compliance")" Color="Color.Warning" Variant="@(_selectedCategory == "Compliance" ? Variant.Filled : Variant.Outlined)">Compliance</MudChip>
                    <MudChip T="string" Value="@("Storage")" Color="Color.Dark" Variant="@(_selectedCategory == "Storage" ? Variant.Filled : Variant.Outlined)">Storage</MudChip>
                    <MudChip T="string" Value="@("Integrations")" Color="Color.Secondary" Variant="@(_selectedCategory == "Integrations" ? Variant.Filled : Variant.Outlined)">Integrations</MudChip>
                    <MudChip T="string" Value="@("General")" Color="Color.Default" Variant="@(_selectedCategory == "General" ? Variant.Filled : Variant.Outlined)">General</MudChip>
                </MudChipSet>
            </MudStack>

            <MudTable Items="_configs" Hover="true" Dense="true" Elevation="0" Outlined="true" Filter="FilterConfigs" Class="border-default">
                <ToolBarContent>
                    <MudText Typo="Typo.h6" Class="fw-bold">Configuration Parameters</MudText>
                    <MudSpacer />
                    <MudTextField @bind-Value="_searchConfig" 
                                  Placeholder="Search setting key or value..." 
                                  Adornment="Adornment.Start" 
                                  AdornmentIcon="@Icons.Material.Filled.Search" 
                                  IconSize="Size.Medium" 
                                  Class="mt-0" 
                                  Immediate="true"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense" />
                </ToolBarContent>
                <HeaderContent>
                    <MudTh>Key</MudTh>
                    <MudTh>Category</MudTh>
                    <MudTh>Value</MudTh>
                    <MudTh>Type</MudTh>
                    <MudTh>Description</MudTh>
                    <MudTh Style="text-align: right;">Actions</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Key" Class="font-monospace fw-semibold">@context.ConfigKey</MudTd>
                    <MudTd DataLabel="Category">
                        <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Text">@context.Category</MudChip>
                    </MudTd>
                    <MudTd DataLabel="Value">
                        <MudText Typo="Typo.body2" Class="font-monospace">@context.ConfigValue</MudText>
                    </MudTd>
                    <MudTd DataLabel="Type">@context.DataType</MudTd>
                    <MudTd DataLabel="Description">@context.Description</MudTd>
                    <MudTd DataLabel="Actions" Style="text-align: right;">
                        <MudIconButton Icon="@Icons.Material.Filled.Edit" 
                                       Color="Color.Primary" 
                                       Size="Size.Small" 
                                       OnClick="@(() => OpenEditConfigDrawer(context))" 
                                       aria-label="Edit Parameter" />
                        <MudIconButton Icon="@Icons.Material.Filled.Delete" 
                                       Color="Color.Error" 
                                       Size="Size.Small" 
                                       OnClick="@(() => DeleteConfigAsync(context.ConfigKey))" 
                                       aria-label="Deactivate Parameter" />
                    </MudTd>
                </RowTemplate>
                <PagerContent>
                    <MudTablePager PageSizeOptions="new int[] { 5, 10, 20, 50, 100, 250, 500 }" />
                </PagerContent>
            </MudTable>
        </div>
    </MudTabPanel>

    <!-- Tab 3: Integration Diagnostics -->
    <MudTabPanel Text="Integration Diagnostics" Icon="@Icons.Material.Filled.Speed">
        <div class="pa-4">
            <MudGrid>
                <MudItem xs="12" md="6">
                    <MudCard Outlined="true" Class="pa-4 border-default">
                        <MudText Typo="Typo.h6" Class="fw-bold mb-2">ERP Ledger Integration Status</MudText>
                        <MudText Typo="Typo.body2" Class="mb-3">
                            Active Provider: <strong>@ErpService.GetActiveProviderName()</strong>
                        </MudText>
                        <MudButton Variant="Variant.Filled" Color="Color.Secondary" StartIcon="@Icons.Material.Filled.Payment" OnClick="TestErpDisbursementAsync">
                            Run Test ERP Disbursement
                        </MudButton>
                        @if (_erpTestResult != null)
                        {
                            <MudAlert Severity="@(_erpTestResult.IsSimulated ? Severity.Info : Severity.Success)" Class="mt-3" Dense="true">
                                <strong>Status:</strong> @_erpTestResult.StatusMessage<br />
                                <strong>Batch:</strong> @_erpTestResult.BatchNumber | <strong>Trx:</strong> @_erpTestResult.TransactionReference
                            </MudAlert>
                        }
                    </MudCard>
                </MudItem>

                <MudItem xs="12" md="6">
                    <MudCard Outlined="true" Class="pa-4 border-default">
                        <MudText Typo="Typo.h6" Class="fw-bold mb-2">PDF Document Generation Diagnostics</MudText>
                        <MudText Typo="Typo.body2" Class="mb-3">
                            Engine: <strong>QuestPDF 2026.8.0</strong> • Vector rendering with merSETA headers.
                        </MudText>
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.PictureAsPdf" OnClick="TestPdfGenerationAsync">
                            Generate Sample Trade Test PDF
                        </MudButton>
                        @if (_pdfGeneratedBytes > 0)
                        {
                            <MudAlert Severity="Severity.Success" Class="mt-3" Dense="true">
                                Successfully generated PDF document byte stream (<strong>@(_pdfGeneratedBytes / 1024) KB</strong>).
                            </MudAlert>
                        }
                    </MudCard>
                </MudItem>
            </MudGrid>
        </div>
    </MudTabPanel>
</MudTabs>

<!-- Configuration Edit/Create Drawer -->
<MudDrawer @bind-Open="_drawerOpen" Anchor="Anchor.End" Elevation="4" Variant="DrawerVariant.Temporary" Width="480px" Class="pa-4">
    <MudDrawerHeader>
        <MudText Typo="Typo.h6" Class="fw-bold">@(_isNewConfig ? "Add New Parameter" : "Edit Parameter")</MudText>
    </MudDrawerHeader>
    <MudStack Spacing="3">
        <FieldGroup Label="Configuration Key" Required="true" HelperText="Hierarchical key, e.g. Finance:Tranche1Percentage">
            <MudTextField @bind-Value="_editModel.ConfigKey" Variant="Variant.Outlined" Disabled="@(!_isNewConfig)" Required="true" Margin="Margin.Dense" />
        </FieldGroup>
        
        <FieldGroup Label="Category">
            <MudSelect @bind-Value="_editModel.ConfigCategory" Variant="Variant.Outlined" Margin="Margin.Dense">
                <MudSelectItem Value="@("Finance")">Finance</MudSelectItem>
                <MudSelectItem Value="@("Governance")">Governance</MudSelectItem>
                <MudSelectItem Value="@("Compliance")">Compliance</MudSelectItem>
                <MudSelectItem Value="@("Storage")">Storage</MudSelectItem>
                <MudSelectItem Value="@("Integrations")">Integrations</MudSelectItem>
                <MudSelectItem Value="@("General")">General</MudSelectItem>
            </MudSelect>
        </FieldGroup>

        <FieldGroup Label="Data Type">
            <MudSelect @bind-Value="_editModel.DataType" Variant="Variant.Outlined" Margin="Margin.Dense">
                <MudSelectItem Value="@("String")">String</MudSelectItem>
                <MudSelectItem Value="@("Integer")">Integer</MudSelectItem>
                <MudSelectItem Value="@("Decimal")">Decimal</MudSelectItem>
                <MudSelectItem Value="@("Boolean")">Boolean</MudSelectItem>
                <MudSelectItem Value="@("Json")">Json</MudSelectItem>
            </MudSelect>
        </FieldGroup>

        <FieldGroup Label="Configuration Value" Required="true">
            <MudTextField @bind-Value="_editModel.ConfigValue" Variant="Variant.Outlined" Lines="@(_editModel.DataType == "Json" ? 4 : 1)" Required="true" Margin="Margin.Dense" />
        </FieldGroup>

        <FieldGroup Label="Description / Operational Rationale">
            <MudTextField @bind-Value="_editModel.Description" Variant="Variant.Outlined" Lines="2" Margin="Margin.Dense" />
        </FieldGroup>

        <MudStack Row="true" Spacing="2" Class="mt-4">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Save" OnClick="SaveConfigAsync">
                Save Parameter
            </MudButton>
            <MudButton Variant="Variant.Outlined" Color="Color.Secondary" OnClick="@(() => _drawerOpen = false)">
                Cancel
            </MudButton>
        </MudStack>
    </MudStack>
</MudDrawer>

@code {
    private List<SystemFeatureFlag> _featureFlags = new();
    private List<SystemConfig> _configs = new();
    private bool _isLoading = true;
    private string _selectedCategory = "All";
    private string _searchConfig = string.Empty;
    private bool _drawerOpen = false;
    private bool _isNewConfig = false;
    private SystemConfig _editModel = new();
    private ErpDisbursementResult? _erpTestResult;
    private int _pdfGeneratedBytes = 0;

    private List<BreadcrumbItem> _breadcrumbs = new()
    {
        new BreadcrumbItem("Home", href: "/"),
        new BreadcrumbItem("System Governance", href: null, disabled: true),
        new BreadcrumbItem("Settings", href: "/admin/settings")
    };

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        _isLoading = true;
        try
        {
            _featureFlags = await FeatureFlags.GetAllFeatureFlagsAsync();
            _configs = await ConfigService.GetAllConfigsAsync();
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task ToggleFeatureAsync(SystemFeatureFlag flag, bool newValue)
    {
        try
        {
            await FeatureFlags.SetFeatureFlagAsync(flag.FeatureKey, newValue, flag.FeatureName, flag.Category ?? "Integrations", flag.Description, "Admin");
            flag.IsEnabled = newValue;
            Snackbar.Add($"Feature '{flag.FeatureName}' {(newValue ? "Enabled" : "Disabled")}.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error toggling feature: {ex.Message}", Severity.Error);
        }
    }

    private bool FilterConfigs(SystemConfig config)
    {
        if (_selectedCategory != "All" && !config.Category.Equals(_selectedCategory, StringComparison.OrdinalIgnoreCase))
            return false;

        if (string.IsNullOrWhiteSpace(_searchConfig))
            return true;

        return config.ConfigKey.Contains(_searchConfig, StringComparison.OrdinalIgnoreCase) ||
               (config.ConfigValue?.Contains(_searchConfig, StringComparison.OrdinalIgnoreCase) ?? false) ||
               (config.Description?.Contains(_searchConfig, StringComparison.OrdinalIgnoreCase) ?? false);
    }

    private void OpenNewConfigDrawer()
    {
        _isNewConfig = true;
        _editModel = new SystemConfig { ConfigCategory = "General", DataType = "String" };
        _drawerOpen = true;
    }

    private void OpenEditConfigDrawer(SystemConfig config)
    {
        _isNewConfig = false;
        _editModel = new SystemConfig
        {
            Id = config.Id,
            ConfigKey = config.ConfigKey,
            ConfigCategory = config.ConfigCategory,
            DataType = config.DataType,
            ConfigValue = config.ConfigValue,
            Description = config.Description
        };
        _drawerOpen = true;
    }

    private async Task SaveConfigAsync()
    {
        if (string.IsNullOrWhiteSpace(_editModel.ConfigKey) || string.IsNullOrWhiteSpace(_editModel.ConfigValue))
        {
            Snackbar.Add("Key and Value are required.", Severity.Warning);
            return;
        }

        try
        {
            await ConfigService.SetConfigAsync(_editModel.ConfigKey, _editModel.ConfigValue, _editModel.ConfigCategory ?? "General", _editModel.Description, _editModel.DataType ?? "String", "Admin");
            Snackbar.Add($"Configuration '{_editModel.ConfigKey}' saved successfully.", Severity.Success);
            _drawerOpen = false;
            await LoadDataAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error saving configuration: {ex.Message}", Severity.Error);
        }
    }

    private async Task DeleteConfigAsync(string key)
    {
        bool? confirm = await DialogService.ShowMessageBoxAsync(
            "Deactivate Parameter?",
            $"Deactivating parameter '{key}' will revert runtime lookups to application defaults.",
            yesText: "Deactivate",
            cancelText: "Cancel");

        if (confirm == true)
        {
            try
            {
                await ConfigService.DeleteConfigAsync(key, "Admin");
                Snackbar.Add($"Configuration '{key}' deactivated.", Severity.Info);
                await LoadDataAsync();
            }
            catch (Exception ex)
            {
                Snackbar.Add($"Error: {ex.Message}", Severity.Error);
            }
        }
    }

    private async Task TestErpDisbursementAsync()
    {
        try
        {
            _erpTestResult = await ErpService.DisbursePaymentAsync(
                "VENDOR-TEST-001",
                150000m,
                "Tranche 1 Diagnostic Verification",
                "Admin");

            Snackbar.Add($"ERP test disbursement completed via {ErpService.GetActiveProviderName()}.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"ERP test failed: {ex.Message}", Severity.Error);
        }
    }

    private async Task TestPdfGenerationAsync()
    {
        try
        {
            var testApp = new LearnerTradeTestApplication
            {
                CompanyLearner = new CompanyLearner
                {
                    Person = new Person { FirstName = "Sipho", LastName = "Dlamini", RsaIdNumber = "9801015009087" },
                    LearnerContractNumber = "L-2026-001"
                },
                TradeTitle = "Diesel Mechanic (653306)",
                AssessmentCenterName = "Indlela Assessment Centre",
                AssessmentDate = DateTime.UtcNow,
                SerialCertificateNumber = "TTC-2026-991"
            };

            var pdfBytes = await PdfService.GenerateArtisanTradeCertificatePdfAsync(testApp);

            _pdfGeneratedBytes = pdfBytes.Length;
            Snackbar.Add($"PDF generated successfully ({_pdfGeneratedBytes / 1024} KB).", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"PDF generation failed: {ex.Message}", Severity.Error);
        }
    }
}
