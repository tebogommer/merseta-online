@page "/admin/workflows/{Id:int}"
@using Nsdms.Application.Services
@using Nsdms.Domain.Entities
@using Nsdms.Web.Components.Shared
@using MudBlazor
@inject IWorkflowEngineService WorkflowService
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@rendermode InteractiveServer

<PageTitle>@(_definition?.Name ?? "Approval Process Lifecycle Studio") | merSETA NSDMS</PageTitle>

@*
  UI-STANDARD.md Archetype: A4 (Master-Detail Record View & Configuration Studio)
  Clauses: 4.4, 5.1–5.4, 6.1, 7.2, 8.1, 11.1–11.9
*@

@if (_loading)
{
    <div class="pa-8">
        <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="mb-3" />
        <div class="d-flex flex-column gap-2">
            <MudSkeleton Height="48px" />
            <MudSkeleton Height="200px" />
        </div>
    </div>
}
else if (_definition == null)
{
    <div class="pa-6">
        <MudAlert Severity="Severity.Error" Variant="Variant.Filled">Approval process lifecycle was not found.</MudAlert>
        <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.ArrowBack" Class="mt-4" OnClick="BackToList">
            Return to Process Lifecycles
        </MudButton>
    </div>
}
else
{
    <!-- Sticky Top Action Bar -->
    <div class="sticky-top-header mb-4 pa-4 rounded-lg mud-elevation-2 d-flex align-center justify-space-between flex-wrap gap-4"
         style="position: sticky; top: var(--mud-appbar-height, 64px) !important; z-index: 10; background-color: var(--mud-palette-surface); border: 1px solid var(--mud-palette-lines-default);">
        
        <div class="d-flex align-center gap-3">
            <MudIconButton Icon="@Icons.Material.Filled.ArrowBack" OnClick="BackToList" Title="Back to Process Lifecycles" Color="Color.Default" />
            <div>
                <div class="d-flex align-center gap-2">
                    <MudText Typo="Typo.h6" Class="font-weight-bold">@_definition.Name</MudText>
                    <MudChip T="string" Color="@(_definition.IsActive ? Color.Success : Color.Default)" Size="Size.Small" Variant="Variant.Filled">
                        @(_definition.IsActive ? "Active" : "Inactive")
                    </MudChip>
                    <MudChip T="string" Color="Color.Primary" Size="Size.Small" Variant="Variant.Outlined">
                        <code>@_definition.Code</code>
                    </MudChip>
                </div>
                <MudText Typo="Typo.caption" Color="Color.Secondary">
                    Target Entity: <strong>@_definition.TargetEntityName</strong> | States: <strong>@_definition.States.Count</strong> | Transitions: <strong>@_definition.Transitions.Count</strong> | Active Instances: <strong>@_instances.Count(i => !i.IsCompleted)</strong>
                </MudText>
            </div>
        </div>

        <div class="d-flex align-center gap-2">
            <MudButton Variant="Variant.Outlined"
                       Color="Color.Secondary"
                       StartIcon="@Icons.Material.Filled.Cancel"
                       OnClick="CancelEdit">
                Cancel
            </MudButton>

            <MudButton Variant="Variant.Outlined"
                       Color="Color.Default"
                       StartIcon="@Icons.Material.Filled.ContentCopy"
                       OnClick="OpenCloneDialog">
                Clone
            </MudButton>

            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Save"
                       OnClick="SaveBlueprintAsync"
                       Disabled="_saving">
                @if (_saving)
                {
                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                    <span>Saving...</span>
                }
                else
                {
                    <span>Save Process</span>
                }
            </MudButton>

            <MudIconButton Icon="@(_definition.IsActive ? Icons.Material.Filled.ToggleOn : Icons.Material.Filled.ToggleOff)"
                           Color="@(_definition.IsActive ? Color.Success : Color.Default)"
                           Title="@(_definition.IsActive ? "Deactivate Process" : "Activate Process")"
                           OnClick="ToggleActiveAsync" />
        </div>
    </div>

    <!-- Master-Detail Tabs -->
    <MudTabs Elevation="1" Rounded="true" ApplyEffectsToContainer="true" PanelClass="pa-6" Color="Color.Primary" ActivePanelIndexChanged="OnTabChanged">
        
        <!-- Tab 1: General & Engine Configuration -->
        <MudTabPanel Text="Process Details" Icon="@Icons.Material.Filled.Tune">
            <MudCard Elevation="0">
                <MudCardContent>
                    <MudGrid>
                        <MudItem xs="12" md="6">
                            <MudTextField @bind-Value="_definition.Code"
                                          Label="Process Code"
                                          Required="true"
                                          Variant="Variant.Outlined"
                                          ReadOnly="true"
                                          HelperText="Immutable system code referenced by domain services"
                                          Class="mb-4" />

                            <MudTextField @bind-Value="_definition.Name"
                                          Label="Process Display Name"
                                          Required="true"
                                          Variant="Variant.Outlined"
                                          Class="mb-4" />

                            <MudSelect T="string"
                                       Label="Target Domain Entity"
                                       @bind-Value="_definition.TargetEntityName"
                                       Required="true"
                                       Variant="Variant.Outlined"
                                       Class="mb-4">
                                <MudSelectItem Value="@("Organisation")">Employers &amp; Organisations</MudSelectItem>
                                <MudSelectItem Value="@("WspSubmission")">Workplace Skills Plans (WSP)</MudSelectItem>
                                <MudSelectItem Value="@("GrantApplication")">Discretionary Grant Applications</MudSelectItem>
                                <MudSelectItem Value="@("GrantMoa")">Grant MoA Agreements</MudSelectItem>
                                <MudSelectItem Value="@("TrainingProvider")">Training Providers &amp; Skills Centres</MudSelectItem>
                                <MudSelectItem Value="@("WorkplaceApproval")">Workplace Approvals &amp; Sites</MudSelectItem>
                                <MudSelectItem Value="@("CompanyLearner")">Learner Registrations</MudSelectItem>
                                <MudSelectItem Value="@("LearnerTradeTest")">Artisan Trade Tests</MudSelectItem>
                                <MudSelectItem Value="@("InterSetaTransfer")">Inter-SETA Transfers</MudSelectItem>
                            </MudSelect>
                        </MudItem>

                        <MudItem xs="12" md="6">
                            <MudTextField @bind-Value="_definition.KeyFieldName"
                                          Label="Record Identifier Field"
                                          Variant="Variant.Outlined"
                                          Class="mb-4" />

                            <div class="pa-4 rounded-lg border mb-4" style="background-color: var(--mud-palette-background-grey); border: 1px solid var(--mud-palette-lines-default);">
                                <MudText Typo="Typo.subtitle2" Class="font-weight-bold mb-2">Process Governance &amp; Status</MudText>
                                <MudSwitch @bind-Value="_definition.IsActive"
                                           Label="Process Active for New Records"
                                           Color="Color.Success"
                                           Class="mb-2" />
                                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="d-block">
                                    When inactive, existing instances can still be completed, but new lifecycles cannot be initiated with this process definition.
                                </MudText>
                            </div>

                            <div class="pa-4 rounded-lg border" style="background-color: var(--mud-palette-surface); border: 1px solid var(--mud-palette-lines-default);">
                                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="d-block font-monospace">
                                    Created: @_definition.CreatedAt.ToString("yyyy-MM-dd HH:mm UTC") by @_definition.CreatedBy
                                </MudText>
                                @if (_definition.ModifiedAt.HasValue)
                                {
                                    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="d-block font-monospace mt-1">
                                        Last Modified: @_definition.ModifiedAt.Value.ToString("yyyy-MM-dd HH:mm UTC") by @_definition.ModifiedBy
                                    </MudText>
                                }
                            </div>
                        </MudItem>
                    </MudGrid>
                </MudCardContent>
            </MudCard>
        </MudTabPanel>

        <!-- Tab 2: Lifecycle States (ChildGrid) -->
        <MudTabPanel Text="Lifecycle States" Icon="@Icons.Material.Filled.LinearScale">
            <div class="d-flex align-center justify-space-between flex-wrap gap-2 mb-4">
                <div>
                    <MudText Typo="Typo.h6">Sequential Lifecycle Stages &amp; Requirements</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">
                        Configure ordered approval stages, initial draft entry points, completed / finalised stages, and authorized actor roles.
                    </MudText>
                </div>
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Add"
                           OnClick="OpenAddStateDialog">
                    Add State
                </MudButton>
            </div>

            @if (!_definition.States.Any())
            {
                <MudAlert Severity="Severity.Warning" Class="rounded-lg">
                    This process lifecycle has no configured stages. Click <strong>Add State</strong> to create your first lifecycle stage.
                </MudAlert>
            }
            else
            {
                <MudTable Items="@_definition.States.OrderBy(s => s.StepOrder)"
                          Hover="true"
                          Dense="true"
                          Elevation="0"
                          Class="rounded-lg border-default"
                          Style="border: 1px solid var(--mud-palette-lines-default);"
                          T="WorkflowState">
                    <HeaderContent>
                        <MudTh>Step</MudTh>
                        <MudTh>State Code</MudTh>
                        <MudTh>Display Name</MudTh>
                        <MudTh>Authorized Role</MudTh>
                        <MudTh>Initial Stage</MudTh>
                        <MudTh>Terminal Stage</MudTh>
                        <MudTh Style="text-align: right;">Actions</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="Step">
                            <MudAvatar Color="Color.Default" Variant="Variant.Filled" Size="Size.Small">
                                @context.StepOrder
                            </MudAvatar>
                        </MudTd>
                        <MudTd DataLabel="State Code">
                            <code>@context.StateCode</code>
                        </MudTd>
                        <MudTd DataLabel="Display Name">
                            <strong>@context.StateName</strong>
                        </MudTd>
                        <MudTd DataLabel="Authorized Role">
                            @if (!string.IsNullOrEmpty(context.AllowedGroupRole))
                            {
                                <MudChip T="string" Color="Color.Dark" Size="Size.Small" Variant="Variant.Outlined">
                                    @context.AllowedGroupRole
                                </MudChip>
                            }
                            else
                            {
                                <span class="text-secondary font-italic">Unrestricted</span>
                            }
                        </MudTd>
                        <MudTd DataLabel="Initial Stage">
                            @if (context.IsInitial)
                            {
                                <MudChip T="string" Color="Color.Primary" Size="Size.Small" Variant="Variant.Filled" Icon="@Icons.Material.Filled.PlayArrow">
                                    Entry Point
                                </MudChip>
                            }
                            else
                            {
                                <span class="text-secondary">-</span>
                            }
                        </MudTd>
                        <MudTd DataLabel="Terminal Stage">
                            @if (context.IsTerminal)
                            {
                                <MudChip T="string" Color="Color.Success" Size="Size.Small" Variant="Variant.Filled" Icon="@Icons.Material.Filled.Check">
                                    Terminal
                                </MudChip>
                            }
                            else
                            {
                                <span class="text-secondary">-</span>
                            }
                        </MudTd>
                        <MudTd Style="text-align: right;" DataLabel="Actions">
                            <div class="d-flex justify-end gap-1">
                                <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                               Color="Color.Primary"
                                               Size="Size.Small"
                                               Title="Edit State"
                                               OnClick="@(() => OpenEditStateDialog(context))" />
                                <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                               Color="Color.Error"
                                               Size="Size.Small"
                                               Title="Delete State"
                                               OnClick="@(() => DeleteStateAsync(context))" />
                            </div>
                        </MudTd>
                    </RowTemplate>
                </MudTable>
            }
        </MudTabPanel>

        <!-- Tab 3: Transition Rules Matrix (ChildGrid) -->
        <MudTabPanel Text="Transition Matrix" Icon="@Icons.Material.Filled.Hub">
            <div class="d-flex align-center justify-space-between flex-wrap gap-2 mb-4">
                <div>
                    <MudText Typo="Typo.h6">Authorized State Transitions &amp; Action Triggers</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">
                        Define allowable paths between stages, action button styling, role authorisation rules, and entity status code synchronizations.
                    </MudText>
                </div>
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Add"
                           OnClick="OpenAddTransitionDialog"
                           Disabled="@(_definition.States.Count < 2)">
                    Add Transition
                </MudButton>
            </div>

            @if (!_definition.Transitions.Any())
            {
                <MudAlert Severity="Severity.Info" Class="rounded-lg">
                    No state transitions are configured. Click <strong>Add Transition</strong> to link originating states to destination states.
                </MudAlert>
            }
            else
            {
                <MudTable Items="@_definition.Transitions"
                          Hover="true"
                          Dense="true"
                          Elevation="0"
                          Class="rounded-lg border-default"
                          Style="border: 1px solid var(--mud-palette-lines-default);"
                          T="WorkflowTransition">
                    <HeaderContent>
                        <MudTh>Originating State (From)</MudTh>
                        <MudTh>Action Button Trigger</MudTh>
                        <MudTh>Destination State (To)</MudTh>
                        <MudTh>Authorisation Rule</MudTh>
                        <MudTh>Audit Remarks</MudTh>
                        <MudTh>Pushed Entity Status</MudTh>
                        <MudTh Style="text-align: right;">Actions</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="From">
                            <strong>@(context.FromState?.StateName ?? _definition.States.FirstOrDefault(s => s.Id == context.FromStateId)?.StateName ?? $"#{context.FromStateId}")</strong>
                        </MudTd>
                        <MudTd DataLabel="Action Trigger">
                            <div class="d-flex align-center gap-2">
                                <span class="rounded-circle d-inline-block" style="width: 10px; height: 10px; background-color: @(context.ButtonColor ?? "#1e40af");"></span>
                                <span>@context.ActionName</span>
                            </div>
                        </MudTd>
                        <MudTd DataLabel="To">
                            <span class="text-primary font-weight-bold">
                                @(context.ToState?.StateName ?? _definition.States.FirstOrDefault(s => s.Id == context.ToStateId)?.StateName ?? $"#{context.ToStateId}")
                            </span>
                        </MudTd>
                        <MudTd DataLabel="Permission">
                            @if (!string.IsNullOrEmpty(context.RequiredPermission))
                            {
                                <code>@context.RequiredPermission</code>
                            }
                            else
                            {
                                <span class="text-secondary font-italic">Open</span>
                            }
                        </MudTd>
                        <MudTd DataLabel="Audit Remarks">
                            @if (context.RequiresComments)
                            {
                                <MudChip T="string" Color="Color.Warning" Size="Size.Small" Variant="Variant.Filled">Mandatory</MudChip>
                            }
                            else
                            {
                                <span class="text-secondary">Optional</span>
                            }
                        </MudTd>
                        <MudTd DataLabel="Entity Status">
                            @if (!string.IsNullOrEmpty(context.NewEntityStatusCode))
                            {
                                <code>@context.NewEntityStatusCode</code>
                            }
                            else
                            {
                                <span class="text-secondary">-</span>
                            }
                        </MudTd>
                        <MudTd Style="text-align: right;" DataLabel="Actions">
                            <div class="d-flex justify-end gap-1">
                                <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                               Color="Color.Primary"
                                               Size="Size.Small"
                                               Title="Edit Transition"
                                               OnClick="@(() => OpenEditTransitionDialog(context))" />
                                <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                               Color="Color.Error"
                                               Size="Size.Small"
                                               Title="Delete Transition"
                                               OnClick="@(() => DeleteTransitionAsync(context))" />
                            </div>
                        </MudTd>
                    </RowTemplate>
                </MudTable>
            }
        </MudTabPanel>

        <!-- Tab 4: Process Lifecycle Visual Graph -->
        <MudTabPanel Text="Visual Flowchart" Icon="@Icons.Material.Filled.AccountTree">
            <WorkflowGraphViewer States="@_definition.States.ToList()"
                                 Transitions="@_definition.Transitions.ToList()"
                                 OnStateSelected="HandleGraphStateSelected" />
        </MudTabPanel>

        <!-- Tab 5: Mandatory Document Requirements -->
        <MudTabPanel Text="Mandatory Document Rules" Icon="@Icons.Material.Filled.FactCheck">
            <div class="d-flex align-center justify-space-between flex-wrap gap-2 mb-4">
                <div>
                    <MudText Typo="Typo.h6">Mandatory Document Evidence Requirements</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">
                        Enforce required document uploads (e.g. Certified ID, Proof of Banking, Tool Lists) before workflow advancement.
                    </MudText>
                </div>
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Add"
                           OnClick="OpenAddRequirementDialog"
                           Disabled="@(!_definition.States.Any())">
                    Add Document Rule
                </MudButton>
            </div>

            @if (!_requirementRules.Any())
            {
                <MudAlert Severity="Severity.Info" Class="rounded-lg">
                    No document requirements are configured for process <code>@_definition.Code</code>. Advancing across stages will not require mandatory document verification.
                </MudAlert>
            }
            else
            {
                <MudTable Items="@_requirementRules"
                          Hover="true"
                          Dense="true"
                          Elevation="0"
                          Class="rounded-lg border-default"
                          Style="border: 1px solid var(--mud-palette-lines-default);"
                          T="DocumentRequirementRule">
                    <HeaderContent>
                        <MudTh>Required at State</MudTh>
                        <MudTh>Document Code</MudTh>
                        <MudTh>Document Title</MudTh>
                        <MudTh>Mandatory</MudTh>
                        <MudTh>Guidelines</MudTh>
                        <MudTh Style="text-align: right;">Actions</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="Required at State">
                            @{
                                var reqState = _definition.States.FirstOrDefault(s => s.Id == context.RequiredAtStateId);
                            }
                            <strong>@(reqState?.StateName ?? $"State #{context.RequiredAtStateId}")</strong>
                        </MudTd>
                        <MudTd DataLabel="Document Code">
                            <code>@context.DocumentTypeCode</code>
                        </MudTd>
                        <MudTd DataLabel="Document Title">
                            <strong>@context.DocumentTypeName</strong>
                        </MudTd>
                        <MudTd DataLabel="Mandatory">
                            @if (context.IsMandatory)
                            {
                                <MudChip T="string" Color="Color.Error" Size="Size.Small" Variant="Variant.Filled">Strictly Mandatory</MudChip>
                            }
                            else
                            {
                                <MudChip T="string" Color="Color.Default" Size="Size.Small" Variant="Variant.Outlined">Optional Evidence</MudChip>
                            }
                        </MudTd>
                        <MudTd DataLabel="Guidelines">
                            <MudText Typo="Typo.caption" Color="Color.Secondary">
                                @(string.IsNullOrWhiteSpace(context.Description) ? "Standard statutory document." : context.Description)
                            </MudText>
                        </MudTd>
                        <MudTd Style="text-align: right;" DataLabel="Actions">
                            <div class="d-flex justify-end gap-1">
                                <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                               Color="Color.Primary"
                                               Size="Size.Small"
                                               Title="Edit Rule"
                                               OnClick="@(() => OpenEditRequirementDialog(context))" />
                                <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                               Color="Color.Error"
                                               Size="Size.Small"
                                               Title="Delete Rule"
                                               OnClick="@(() => DeleteRequirementAsync(context))" />
                            </div>
                        </MudTd>
                    </RowTemplate>
                </MudTable>
            }
        </MudTabPanel>

        <!-- Tab 6: Live Execution Instances & Health Monitor -->
        <MudTabPanel Text="Live Execution Instances" Icon="@Icons.Material.Filled.PlayCircleFilled">
            <div class="d-flex align-center justify-space-between flex-wrap gap-2 mb-4">
                <div>
                    <MudText Typo="Typo.h6">Active &amp; Historic Machine Instances</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">
                        Records currently progressing through this state machine engine.
                    </MudText>
                </div>
                <MudChip T="string" Color="Color.Info" Variant="Variant.Filled">
                    @_instances.Count(i => !i.IsCompleted) Active / @_instances.Count Total
                </MudChip>
            </div>

            @if (!_instances.Any())
            {
                <MudAlert Severity="Severity.Info" Class="rounded-lg">
                    No entity records are currently executing this approval process lifecycle.
                </MudAlert>
            }
            else
            {
                <MudTable Items="@_instances"
                          Hover="true"
                          Dense="true"
                          Elevation="0"
                          Class="rounded-lg border-default"
                          Style="border: 1px solid var(--mud-palette-lines-default);"
                          T="WorkflowInstance">
                    <HeaderContent>
                        <MudTh>Instance ID</MudTh>
                        <MudTh>Entity Reference</MudTh>
                        <MudTh>Entity Title</MudTh>
                        <MudTh>Current Stage</MudTh>
                        <MudTh>Initiator</MudTh>
                        <MudTh>Initiated Date</MudTh>
                        <MudTh>Status</MudTh>
                        <MudTh Style="text-align: right;">Action</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="Instance ID">
                            <span class="font-monospace fw-bold text-primary">#@context.Id</span>
                        </MudTd>
                        <MudTd DataLabel="Reference">
                            <code>@context.EntityReferenceNumber</code>
                        </MudTd>
                        <MudTd DataLabel="Title">
                            <strong>@context.EntityTitle</strong>
                        </MudTd>
                        <MudTd DataLabel="Current Stage">
                            <MudChip T="string" Color="Color.Primary" Size="Size.Small" Variant="Variant.Outlined">
                                @(context.CurrentWorkflowState?.StateName ?? "Draft")
                            </MudChip>
                        </MudTd>
                        <MudTd DataLabel="Initiator">
                            <MudText Typo="Typo.body2">@context.InitiatorName</MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">@context.InitiatorUserId</MudText>
                        </MudTd>
                        <MudTd DataLabel="Initiated">
                            @context.InitiatedDate.ToString("yyyy-MM-dd HH:mm")
                        </MudTd>
                        <MudTd DataLabel="Status">
                            @if (context.IsCompleted)
                            {
                                <MudChip T="string" Color="Color.Success" Size="Size.Small" Variant="Variant.Filled">Completed</MudChip>
                            }
                            else
                            {
                                <MudChip T="string" Color="Color.Warning" Size="Size.Small" Variant="Variant.Filled">In Progress</MudChip>
                            }
                        </MudTd>
                        <MudTd Style="text-align: right;" DataLabel="Action">
                            <MudButton Variant="Variant.Outlined"
                                       Color="Color.Primary"
                                       Size="Size.Small"
                                       StartIcon="@Icons.Material.Filled.ArrowForward"
                                       OnClick="@(() => NavigateToTargetEntity(context))">
                                Open Entity
                            </MudButton>
                        </MudTd>
                    </RowTemplate>
                </MudTable>
            }
        </MudTabPanel>
    </MudTabs>
}

@code {
    [Parameter] public int Id { get; set; }

    private WorkflowDefinition? _definition;
    private List<WorkflowInstance> _instances = new();
    private List<DocumentRequirementRule> _requirementRules = new();
    private bool _loading = true;
    private bool _saving = false;

    protected override async Task OnParametersSetAsync()
    {
        await LoadBlueprintAsync();
    }

    private async Task LoadBlueprintAsync()
    {
        _loading = true;
        try
        {
            _definition = await WorkflowService.GetDefinitionByIdAsync(Id);
            if (_definition != null)
            {
                _instances = await WorkflowService.GetInstancesByDefinitionIdAsync(Id);
                _requirementRules = await WorkflowService.GetDocumentRequirementsAsync(_definition.Code);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error loading process lifecycle: {ex.Message}", Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private void BackToList() => Navigation.NavigateTo("/admin/workflows");

    private void CancelEdit() => Navigation.NavigateTo("/admin/workflows");

    private void OnTabChanged(int index) => StateHasChanged();

    private void HandleGraphStateSelected(int stateId)
    {
        var state = _definition?.States.FirstOrDefault(s => s.Id == stateId);
        if (state != null)
        {
            Snackbar.Add($"Selected state: {state.StateName} ({state.StateCode})", Severity.Info);
        }
    }

    private async Task SaveBlueprintAsync()
    {
        if (_definition == null) return;

        _saving = true;
        try
        {
            _definition.Name = _definition.Name.Trim();
            _definition = await WorkflowService.SaveDefinitionAsync(_definition, "admin@merseta.org.za", "System Administrator");
            Snackbar.Add($"Approval process lifecycle '{_definition.Code}' saved successfully.", Severity.Success);
            await LoadBlueprintAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error saving process lifecycle: {ex.Message}", Severity.Error);
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task ToggleActiveAsync()
    {
        if (_definition == null) return;

        try
        {
            _definition.IsActive = !_definition.IsActive;
            await WorkflowService.SaveDefinitionAsync(_definition, "admin@merseta.org.za", "System Administrator");
            Snackbar.Add($"Process lifecycle is now {(_definition.IsActive ? "Active" : "Inactive")}.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
    }

    private async Task OpenCloneDialog()
    {
        if (_definition == null) return;

        var parameters = new DialogParameters { ["SourceDefinition"] = _definition };
        var options = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseButton = true };
        var dialog = await DialogService.ShowAsync<WorkflowCloneDialog>("Clone Approval Process Lifecycle", parameters, options);
        var result = await dialog.Result;

        if (result != null && !result.Canceled && result.Data is WorkflowDefinition clonedDef)
        {
            Navigation.NavigateTo($"/admin/workflows/{clonedDef.Id}");
        }
    }

    // State Actions
    private async Task OpenAddStateDialog()
    {
        if (_definition == null) return;

        var nextOrder = (_definition.States.MaxBy(s => s.StepOrder)?.StepOrder ?? 0) + 1;
        var newState = new WorkflowState
        {
            WorkflowDefinitionId = _definition.Id,
            StepOrder = nextOrder,
            StateCode = $"STEP_{nextOrder}",
            StateName = $"Stage {nextOrder}"
        };

        var parameters = new DialogParameters { ["State"] = newState };
        var options = new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseButton = true };
        var dialog = await DialogService.ShowAsync<WorkflowStateDialog>("Add Lifecycle State", parameters, options);
        var result = await dialog.Result;

        if (result != null && !result.Canceled)
        {
            await LoadBlueprintAsync();
        }
    }

