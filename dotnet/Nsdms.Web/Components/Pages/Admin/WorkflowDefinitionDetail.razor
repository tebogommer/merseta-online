    private async Task DeleteStateAsync(WorkflowState state)
    {
        var confirmed = await DialogService.ShowMessageBoxAsync(
            "Confirm State Deletion",
            $"Are you sure you want to delete state '{state.StateName}'? Any transitions connected to this state will also be removed.",
            yesText: "Delete State",
            cancelText: "Cancel");

        if (confirmed == true)
        {
            var success = await WorkflowService.DeleteStateAsync(state.Id, "admin@merseta.org.za", "System Administrator");
            if (success)
            {
                Snackbar.Add($"State '{state.StateName}' deleted.", Severity.Success);
                await LoadBlueprintAsync();
            }
            else
            {
                Snackbar.Add("Cannot delete state: It is currently referenced by active workflow instances.", Severity.Warning);
            }
        }
    }

    // Transition Actions
    private async Task OpenAddTransitionDialog()
    {
        if (_definition == null || _definition.States.Count < 2) return;

        var orderedStates = _definition.States.OrderBy(s => s.StepOrder).ToList();
        var newTrans = new WorkflowTransition
        {
            WorkflowDefinitionId = _definition.Id,
            FromStateId = orderedStates.First().Id,
            ToStateId = orderedStates.Skip(1).First().Id,
            ActionName = "Advance Next",
            ButtonColor = "#1e40af",
            ButtonIcon = "Send"
        };

        var parameters = new DialogParameters
        {
            ["Transition"] = newTrans,
            ["AvailableStates"] = _definition.States.ToList()
        };
        var options = new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseButton = true };
        var dialog = await DialogService.ShowAsync<WorkflowTransitionDialog>("Add Workflow Action / Step", parameters, options);
        var result = await dialog.Result;

        if (result != null && !result.Canceled)
        {
            await LoadBlueprintAsync();
        }
    }

