    private void NavigateToTargetEntity(WorkflowInstance instance)
    {
        var url = _definition?.TargetEntityName switch
        {
            "Organisation" => $"/employers/{instance.EntityId}",
            "WspSubmission" => $"/wsp/{instance.EntityId}",
            "GrantApplication" => $"/grants/{instance.EntityId}",
            "TrainingProvider" => $"/sdp/{instance.EntityId}",
            "WorkplaceApproval" => $"/workplace-approvals/{instance.EntityId}",
            "CompanyLearner" => $"/learners/{instance.EntityId}",
            "GrantMoa" => $"/finance/grants/{instance.EntityId}",
            _ => "/"
        };
        Navigation.NavigateTo(url);
    }
