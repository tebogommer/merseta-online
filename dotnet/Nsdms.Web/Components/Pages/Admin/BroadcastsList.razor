@page "/admin/broadcasts"
@attribute [Authorize(Roles = "SuperAdmin,Admin,Executive,CLO")]
@namespace Nsdms.Web.Components.Pages.Admin
@using Microsoft.AspNetCore.Authorization
@using MudBlazor
@using Nsdms.Application.Common.Interfaces
@using Nsdms.Application.Common.Models
@using Nsdms.Domain.Entities
@using Nsdms.Web.Components.Shared
@inject IEmailOutboxService OutboxService
@inject NavigationManager Nav
@inject ISnackbar Snackbar

<main id="main-content" style="max-width: 1600px; margin: 0 auto;">
    <!-- Page Header (Archetype A1 List) -->
    <EntityHeader Title="Broadcast Communications &amp; Circulars"
                  Subtitle="Manage stakeholder communications, executive notices, and Office 365 dispatch campaigns."
                  BreadcrumbItems="@_breadcrumbs">
        <Actions>
            <MudButton Variant="Variant.Outlined"
                       Color="Color.Default"
                       StartIcon="@Icons.Material.Filled.Email"
                       Href="/admin/email-outbox"
                       Size="Size.Medium">
                Email Outbox Queue
            </MudButton>
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Add"
                       Href="/admin/broadcasts/new"
                       Size="Size.Medium">
                Compose New Broadcast
            </MudButton>
        </Actions>
    </EntityHeader>

    <!-- Filter & Search Toolbar -->
    <MudPaper Class="pa-4 mb-4" Elevation="0" Outlined="true">
        <div class="d-flex flex-column flex-md-row justify-space-between align-start align-md-center gap-3">
            <div class="d-flex flex-wrap align-center gap-2">
                <MudChipSet T="string" SelectedValue="_statusFilter" SelectedValueChanged="OnStatusFilterChanged" CheckMark="true">
                    <MudChip T="string" Value="@("All")" Color="Color.Default">All Broadcasts</MudChip>
                    <MudChip T="string" Value="@("Dispatched")" Color="Color.Success">Dispatched</MudChip>
                    <MudChip T="string" Value="@("Draft")" Color="Color.Warning">Drafts</MudChip>
                </MudChipSet>
            </div>

            <div style="min-width: 260px; max-width: 380px; width: 100%;">
                <MudTextField @bind-Value="_searchQuery"
                              Placeholder="Search by subject or target audience..."
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              Clearable="true"
                              DebounceInterval="300"
                              OnDebounceIntervalElapsed="OnSearchChanged"
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Search" />
            </div>
        </div>
    </MudPaper>

    <!-- DataGridShell for 13-point data table baseline -->
    <DataGridShell TItem="BroadcastMessageDto"
                   Items="@_pagedResult.Items"
                   IsLoading="@_loading"
                   TotalItemsCount="@_pagedResult.TotalCount"
                   EmptyMessage="No broadcast campaigns found matching the search criteria.">
        <ChildContent>
            <MudTable Items="@_pagedResult.Items"
                      Hover="true"
                      Dense="false"
                      Elevation="0"
                      Class="border rounded">
                <HeaderContent>
                    <MudTh>Reference</MudTh>
                    <MudTh>Subject / Notice Title</MudTh>
                    <MudTh>Target Audience</MudTh>
                    <MudTh>Recipients</MudTh>
                    <MudTh>Attachment</MudTh>
                    <MudTh>Dispatched Date</MudTh>
                    <MudTh>Status</MudTh>
                    <MudTh Style="text-align: right;">Actions</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd>
                        <MudLink Href="@($"/admin/broadcasts/{context.Id}")" Class="font-mono fw-bold">
                            @($"BCAST-{context.Id:D5}")
                        </MudLink>
                    </MudTd>
                    <MudTd>
                        <MudLink Href="@($"/admin/broadcasts/{context.Id}")" Class="fw-bold text-decoration-none">
                            @context.Subject
                        </MudLink>
                    </MudTd>
                    <MudTd>
                        <MudText Typo="Typo.body2">
                            @context.TargetFilterDisplay
                        </MudText>
                    </MudTd>
                    <MudTd>
                        <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Outlined">
                            @context.RecipientCount
                        </MudChip>
                    </MudTd>
                    <MudTd>
                        @if (context.HasAttachment)
                        {
                            <MudChip T="string" Size="Size.Small" Color="Color.Info" Variant="Variant.Filled" Icon="@Icons.Material.Filled.AttachFile">
                                @(context.AttachmentFileName ?? "PDF Attached")
                            </MudChip>
                        }
                        else
                        {
                            <span class="text-secondary">-</span>
                        }
                    </MudTd>
                    <MudTd>
                        <span class="font-mono text-secondary" style="font-size: 0.8125rem;">
                            @(context.DispatchedAt?.ToLocalTime().ToString("yyyy-MM-dd HH:mm") ?? context.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm"))
                        </span>
                    </MudTd>
                    <MudTd>
                        <StatusBadge Status="@context.Status" Size="Size.Small" />
                    </MudTd>
                    <MudTd Style="text-align: right;">
                        <MudButton Variant="Variant.Outlined"
                                   Color="Color.Primary"
                                   Size="Size.Small"
                                   EndIcon="@Icons.Material.Filled.ArrowForward"
                                   Href="@($"/admin/broadcasts/{context.Id}")">
                            View Details
                        </MudButton>
                    </MudTd>
                </RowTemplate>
            </MudTable>
        </ChildContent>
    </DataGridShell>
</main>

@code {
    private bool _loading = true;
    private string _statusFilter = "All";
    private string _searchQuery = string.Empty;
    private int _pageIndex = 0;
    private int _pageSize = 20;

    private PagedResult<BroadcastMessageDto> _pagedResult = new(new List<BroadcastMessageDto>(), 0, 0, 20);

    private readonly List<BreadcrumbItem> _breadcrumbs = new()
    {
        new BreadcrumbItem("Home", href: "/"),
        new BreadcrumbItem("Enterprise Admin", href: "/admin/broadcasts"),
        new BreadcrumbItem("Broadcasts", href: null, disabled: true)
    };

    protected override async Task OnInitializedAsync()
    {
        await LoadBroadcastsAsync();
    }

    private async Task LoadBroadcastsAsync()
    {
        _loading = true;
        try
        {
            var query = new PaginationQuery(_pageIndex, _pageSize);
            _pagedResult = await OutboxService.GetBroadcastsPagedAsync(query, _statusFilter, _searchQuery);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error loading broadcast history: {ex.Message}", Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task OnStatusFilterChanged(string newStatus)
    {
        _statusFilter = newStatus;
        _pageIndex = 0;
        await LoadBroadcastsAsync();
    }

    private async Task OnSearchChanged(string newSearch)
    {
        _searchQuery = newSearch;
        _pageIndex = 0;
        await LoadBroadcastsAsync();
    }
}
