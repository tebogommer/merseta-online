@page "/wizards"
@page "/admin/wizards"
@using Nsdms.Application.Services
@using Nsdms.Web.Components.Shared
@using Nsdms.Web.Components.Shared.Wizard
@using MudBlazor
@inject NavigationManager NavManager
@inject IWizardDraftService DraftService
@rendermode InteractiveServer

<PageTitle>Strategic Wizard Candidate Matrix - merSETA NSDMS</PageTitle>

<EntityHeader Title="Strategic Wizard Candidate Matrix"
              Subtitle="Enterprise Multi-Step Wizard Architecture (DESIGN.md §10) tracking statutory high-cognitive-load flows"
              ReferenceKey="A5-WIZARD-MATRIX"
              BreadcrumbItems="@_breadcrumbs">
    <ActionZone>
        <MudBadge Content="@_activeDrafts.Count" Color="Color.Warning" Overlap="true" Visible="@(_activeDrafts.Count > 0)" Class="mr-2">
            <MudButton Variant="Variant.Outlined"
                       Color="Color.Default"
                       StartIcon="@Icons.Material.Filled.HistoryEdu"
                       OnClick="@(() => _isDraftsDrawerOpen = true)">
                In-progress drafts
            </MudButton>
        </MudBadge>
        <MudButton Variant="Variant.Outlined"
                   Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.School"
                   OnClick="@(() => NavManager.NavigateTo("/etqa/assessors/1/re-register"))"
                   Class="mr-2">
            Assessor Renewal
        </MudButton>
        <MudButton Variant="Variant.Outlined"
                   Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Build"
                   OnClick="@(() => NavManager.NavigateTo("/workplace-approvals/apply"))"
                   Class="mr-2">
            Workplace Approval
        </MudButton>
        <MudButton Variant="Variant.Outlined"
                   Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Badge"
                   OnClick="@(() => NavManager.NavigateTo("/learners/register-agreement"))"
                   Class="mr-2">
            Learner Agreement
        </MudButton>
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.AddCard"
                   OnClick="@(() => NavManager.NavigateTo("/dg-grants/apply"))">
            Discretionary Grant (DG)
        </MudButton>
    </ActionZone>
</EntityHeader>

<!-- Metrics Overview Row -->
<MudGrid Spacing="3" Class="mb-4">
    <MudItem xs="12" sm="6" md="3">
        <MudCard Elevation="1" Class="pa-4 rounded-lg h-100 border" Style="border-color: var(--border);">
            <div class="d-flex align-center justify-space-between mb-2">
                <MudText Typo="Typo.caption" Color="Color.Secondary">Total Candidate Flows</MudText>
                <MudIcon Icon="@Icons.Material.Filled.AccountTree" Color="Color.Primary" Size="Size.Small" />
            </div>
            <MudText Typo="Typo.h4" Class="font-weight-bold text-primary">@_candidates.Count</MudText>
            <MudText Typo="Typo.caption" Color="Color.Secondary">Across 7 statutory domain pillars</MudText>
        </MudCard>
    </MudItem>
    <MudItem xs="12" sm="6" md="3">
        <MudCard Elevation="1" Class="pa-4 rounded-lg h-100 border" Style="border-color: var(--border);">
            <div class="d-flex align-center justify-space-between mb-2">
                <MudText Typo="Typo.caption" Color="Color.Secondary">Active Wizards</MudText>
                <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success" Size="Size.Small" />
            </div>
            <MudText Typo="Typo.h4" Class="font-weight-bold text-success">@_candidates.Count(c => c.IsActive)</MudText>
            <MudText Typo="Typo.caption" Color="Color.Secondary">Built with WizardShell &amp; active in production</MudText>
        </MudCard>
    </MudItem>
    <MudItem xs="12" sm="6" md="3">
        <MudCard Elevation="1" Class="pa-4 rounded-lg h-100 border" Style="border-color: var(--border);">
            <div class="d-flex align-center justify-space-between mb-2">
                <MudText Typo="Typo.caption" Color="Color.Secondary">Build Guard [NSDMS0001]</MudText>
                <MudIcon Icon="@Icons.Material.Filled.Shield" Color="Color.Info" Size="Size.Small" />
            </div>
            <MudText Typo="Typo.h4" Class="font-weight-bold text-info">100%</MudText>
            <MudText Typo="Typo.caption" Color="Color.Secondary">Zero raw stepper tags outside shared library</MudText>
        </MudCard>
    </MudItem>
    <MudItem xs="12" sm="6" md="3">
        <MudCard Elevation="1" Class="pa-4 rounded-lg h-100 border" Style="border-color: var(--border);">
            <div class="d-flex align-center justify-space-between mb-2">
                <MudText Typo="Typo.caption" Color="Color.Secondary">Average Step Count</MudText>
                <MudIcon Icon="@Icons.Material.Filled.LinearScale" Color="Color.Warning" Size="Size.Small" />
            </div>
            <MudText Typo="Typo.h4" Class="font-weight-bold text-warning">@(_candidates.Any() ? _candidates.Average(c => c.StepCount).ToString("F1") : "0.0")</MudText>
            <MudText Typo="Typo.caption" Color="Color.Secondary">Canonical chunking (&lt;= 7 inputs / step)</MudText>
        </MudCard>
    </MudItem>
</MudGrid>

<!-- Active In-Progress Drafts Resumption Banner -->
@if (_activeDrafts.Any())
{
    <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Class="mb-4 rounded-lg border-2" Icon="@Icons.Material.Filled.HistoryEdu">
        <div class="d-flex align-center justify-space-between w-100 flex-wrap gap-2">
            <div>
                <MudText Typo="Typo.subtitle2" Class="font-weight-bold text-primary">
                    @_activeDrafts.Count active in-progress wizard draft@(_activeDrafts.Count == 1 ? "" : "s") detected
                </MudText>
                <MudText Typo="Typo.caption" Color="Color.Secondary">
                    You have saved uncommitted statutory application sessions. You can resume any session right where you left off.
                </MudText>
            </div>
            <MudButton Variant="Variant.Filled"
                       Color="Color.Warning"
                       Size="Size.Small"
                       StartIcon="@Icons.Material.Filled.PlayArrow"
                       OnClick="@(() => _isDraftsDrawerOpen = true)">
                Open drafts drawer
            </MudButton>
        </div>
    </MudAlert>
}

<!-- Candidate Matrix Table -->
<MudCard Elevation="1" Class="rounded-lg mb-6 border" Style="border-color: var(--border);">
    <MudCardHeader Class="pb-2">
        <CardHeaderContent>
            <MudText Typo="Typo.h6" Class="font-weight-bold text-primary">Approved Strategic Candidate Registry</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">
                Statutory candidate actions prioritized for multi-step progressive disclosure, draft persistence, and read-only pre-commit review.
            </MudText>
        </CardHeaderContent>
    </MudCardHeader>
    <MudCardContent Class="pa-0">
        <MudTable Items="@_candidates" Hover="true" Breakpoint="Breakpoint.Sm" Elevation="0">
            <HeaderContent>
                <MudTh>Candidate Flow</MudTh>
                <MudTh>Route</MudTh>
                <MudTh>Persona</MudTh>
                <MudTh>Steps</MudTh>
                <MudTh>Statutory Driver</MudTh>
                <MudTh>Status</MudTh>
                <MudTh Style="text-align: right;">Action</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Candidate Flow">
                    <div class="d-flex align-center gap-2">
                        <MudAvatar Color="@context.AvatarColor" Size="Size.Small" Variant="Variant.Filled">
                            <MudIcon Icon="@context.Icon" Size="Size.Small" />
                        </MudAvatar>
                        <div>
                            <span class="d-block font-weight-bold text-primary">@context.Title</span>
                            <span class="d-block text-caption text-secondary">@context.Description</span>
                        </div>
                    </div>
                </MudTd>
                <MudTd DataLabel="Route">
                    <span class="font-mono text-body2">@context.Route</span>
                </MudTd>
                <MudTd DataLabel="Persona">
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Default">
                        @context.Persona
                    </MudChip>
                </MudTd>
                <MudTd DataLabel="Steps">
                    <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Filled">
                        @($"{context.StepCount} Steps")
                    </MudChip>
                </MudTd>
                <MudTd DataLabel="Statutory Driver">
                    <span class="text-body2">@context.StatutoryDriver</span>
                </MudTd>
                <MudTd DataLabel="Status">
                    @if (context.IsActive)
                    {
                        <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.CheckCircle">
                            Active
                        </MudChip>
                    }
                    else
                    {
                        <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Pending">
                            Staged
                        </MudChip>
                    }
                </MudTd>
                <MudTd DataLabel="Action" Style="text-align: right;">
                    @if (context.IsActive)
                    {
                        <MudButton Variant="Variant.Filled"
                                   Size="Size.Small"
                                   Color="Color.Primary"
                                   StartIcon="@Icons.Material.Filled.PlayArrow"
                                   OnClick="@(() => NavManager.NavigateTo(context.Route))">
                            Launch
                        </MudButton>
                    }
                    else
                    {
                        <MudButton Variant="Variant.Outlined"
                                   Size="Size.Small"
                                   Color="Color.Default"
                                   Disabled="true">
                            In Design
                        </MudButton>
                    }
                </MudTd>
            </RowTemplate>
        </MudTable>
    </MudCardContent>
</MudCard>

<!-- Architecture Rules Card -->
<MudCard Elevation="1" Class="pa-4 rounded-lg border" Style="border-color: var(--border);">
    <MudText Typo="Typo.subtitle1" Class="font-weight-bold text-primary mb-2">
        The 15 Enterprise Wizard Principles (DESIGN.md §10)
    </MudText>
    <MudGrid Spacing="2">
        <MudItem xs="12" md="4">
            <MudPaper Outlined="true" Class="pa-3 rounded-lg h-100">
                <MudText Typo="Typo.subtitle2" Class="font-weight-bold text-primary mb-1">1. Structure &amp; Chunking</MudText>
                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="d-block mb-1">• One decision per step with dependency ordering.</MudText>
                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="d-block mb-1">• Max 7 inputs per step under semantic headings.</MudText>
                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="d-block">• Stepper labels &lt;= 3 words with state clarity.</MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" md="4">
            <MudPaper Outlined="true" Class="pa-3 rounded-lg h-100">
                <MudText Typo="Typo.subtitle2" Class="font-weight-bold text-primary mb-1">2. Control &amp; Validation</MudText>
                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="d-block mb-1">• Inline per-step validation gating the Next button.</MudText>
                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="d-block mb-1">• "Save draft" enabled from Step 2 onward.</MudText>
                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="d-block">• Single clear primary action and cancel button.</MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" md="4">
            <MudPaper Outlined="true" Class="pa-3 rounded-lg h-100">
                <MudText Typo="Typo.subtitle2" Class="font-weight-bold text-primary mb-1">3. Pre-Commit Review</MudText>
                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="d-block mb-1">• Read-only grouped review step with per-step jump links.</MudText>
                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="d-block mb-1">• Shared field definitions between wizard and edit views.</MudText>
                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="d-block">• Build guard [NSDMS0001] enforces WizardShell.</MudText>
            </MudPaper>
        </MudItem>
    </MudGrid>
</MudCard>

<!-- In-Progress Drafts Drawer Component -->
<WizardDraftsDrawer @bind-IsOpen="_isDraftsDrawerOpen" CurrentUserId="CurrentSdf" OnDraftsChanged="LoadActiveDraftsAsync" />

@code {
    private bool _isDraftsDrawerOpen = false;
    private List<WizardDraftSummaryDto> _activeDrafts = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadActiveDraftsAsync();
    }

    private async Task LoadActiveDraftsAsync()
    {
        try
        {
            _activeDrafts = await DraftService.GetActiveDraftsForUserAsync("CurrentSdf");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading wizard drafts: {ex.Message}");
        }
    }

    private List<BreadcrumbItem> _breadcrumbs = new()
