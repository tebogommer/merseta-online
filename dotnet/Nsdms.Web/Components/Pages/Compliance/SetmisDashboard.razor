@page "/compliance/setmis"
@inject ISetmisService SetmisService
@inject IJSRuntime JS
@inject ISnackbar Snackbar
@rendermode InteractiveServer

<div class="d-flex justify-space-between align-center mb-4">
    <div>
        <MudText Typo="Typo.h5" Class="font-weight-bold">DHET SETMIS Compliance Hub</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary">Specification-compliant 500-505 flat-file extractor, pre-submission validation diagnostics, and DHET acknowledgment registry</MudText>
    </div>
    <div class="d-flex gap-2">
        <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.FactCheck" OnClick="RunDiagnostics">
            Run Pre-Submission Diagnostics
        </MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Success" StartIcon="@Icons.Material.Filled.CloudDownload" OnClick="OpenGenerateModal">
            Generate Submission Bundle
        </MudButton>
    </div>
</div>

<!-- Diagnostics Summary Alert -->
@if (_validationRun)
{
    @if (_validationErrors.Count == 0)
    {
        <MudAlert Severity="Severity.Success" Variant="Variant.Filled" Class="mb-4" Elevation="1">
            <div class="d-flex justify-space-between align-center">
                <span><strong>DHET Data Validation Passed:</strong> All 500-505 datasets meet mandatory Department of Higher Education & Training schema constraints. Zero blocking errors.</span>
                <MudChip T="string" Color="Color.Surface" Size="Size.Small">100% Compliant</MudChip>
            </div>
        </MudAlert>
    }
    else
    {
        <MudAlert Severity="Severity.Warning" Variant="Variant.Filled" Class="mb-4" Elevation="1">
            <div class="d-flex justify-space-between align-center">
                <span><strong>Pre-Submission Diagnostic Notice:</strong> Found @_validationErrors.Count(e => e.Severity == "Error") blocking error(s) and @_validationErrors.Count(e => e.Severity == "Warning") warning(s) in local datasets.</span>
                <MudButton Color="Color.Surface" Size="Size.Small" Variant="Variant.Outlined" OnClick="@(() => _showErrorsDialog = true)">View Remediation Guidance</MudButton>
            </div>
        </MudAlert>
    }
}

<!-- Flat File Extract Specification Cards -->
<MudGrid Class="mb-4" Spacing="3">
    <MudItem xs="12" sm="6" md="4">
        <MudCard Elevation="2" Outlined="true">
            <MudCardHeader>
                <CardHeaderAvatar>
                    <MudAvatar Color="Color.Primary" Variant="Variant.Filled">500</MudAvatar>
                </CardHeaderAvatar>
                <CardHeaderContent>
                    <MudText Typo="Typo.subtitle1" Class="fw-bold">Training Providers</MudText>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Accreditation, ETQA IDs & Sites</MudText>
                </CardHeaderContent>
            </MudCardHeader>
            <MudCardActions Class="justify-end">
                <MudButton Variant="Variant.Text" Color="Color.Primary" Size="Size.Small" StartIcon="@Icons.Material.Filled.Visibility" OnClick="@(() => PreviewFile("500"))">Preview</MudButton>
            </MudCardActions>
        </MudCard>
    </MudItem>

    <MudItem xs="12" sm="6" md="4">
        <MudCard Elevation="2" Outlined="true">
            <MudCardHeader>
                <CardHeaderAvatar>
                    <MudAvatar Color="Color.Info" Variant="Variant.Filled">501</MudAvatar>
                </CardHeaderAvatar>
                <CardHeaderContent>
                    <MudText Typo="Typo.subtitle1" Class="fw-bold">Assessors & Moderators</MudText>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">ETQA Practitioner Registrations</MudText>
                </CardHeaderContent>
            </MudCardHeader>
            <MudCardActions Class="justify-end">
                <MudButton Variant="Variant.Text" Color="Color.Info" Size="Size.Small" StartIcon="@Icons.Material.Filled.Visibility" OnClick="@(() => PreviewFile("501"))">Preview</MudButton>
            </MudCardActions>
        </MudCard>
    </MudItem>

    <MudItem xs="12" sm="6" md="4">
        <MudCard Elevation="2" Outlined="true">
            <MudCardHeader>
                <CardHeaderAvatar>
                    <MudAvatar Color="Color.Success" Variant="Variant.Filled">502</MudAvatar>
                </CardHeaderAvatar>
                <CardHeaderContent>
                    <MudText Typo="Typo.subtitle1" Class="fw-bold">Workplace Approvals</MudText>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Employer Host Sites & Mentors</MudText>
                </CardHeaderContent>
            </MudCardHeader>
            <MudCardActions Class="justify-end">
                <MudButton Variant="Variant.Text" Color="Color.Success" Size="Size.Small" StartIcon="@Icons.Material.Filled.Visibility" OnClick="@(() => PreviewFile("502"))">Preview</MudButton>
            </MudCardActions>
        </MudCard>
    </MudItem>

    <MudItem xs="12" sm="6" md="4">
        <MudCard Elevation="2" Outlined="true">
            <MudCardHeader>
                <CardHeaderAvatar>
                    <MudAvatar Color="Color.Dark" Variant="Variant.Filled">503</MudAvatar>
                </CardHeaderAvatar>
                <CardHeaderContent>
                    <MudText Typo="Typo.subtitle1" Class="fw-bold">Skills Programmes</MudText>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Non-NQF & Unit Standard Codes</MudText>
                </CardHeaderContent>
            </MudCardHeader>
            <MudCardActions Class="justify-end">
                <MudButton Variant="Variant.Text" Color="Color.Dark" Size="Size.Small" StartIcon="@Icons.Material.Filled.Visibility" OnClick="@(() => PreviewFile("503"))">Preview</MudButton>
            </MudCardActions>
        </MudCard>
    </MudItem>

    <MudItem xs="12" sm="6" md="4">
        <MudCard Elevation="2" Outlined="true">
            <MudCardHeader>
                <CardHeaderAvatar>
                    <MudAvatar Color="Color.Warning" Variant="Variant.Filled">504</MudAvatar>
                </CardHeaderAvatar>
                <CardHeaderContent>
                    <MudText Typo="Typo.subtitle1" Class="fw-bold">Learner Enrolments</MudText>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Demographics, OFO & Contracts</MudText>
                </CardHeaderContent>
            </MudCardHeader>
            <MudCardActions Class="justify-end">
                <MudButton Variant="Variant.Text" Color="Color.Warning" Size="Size.Small" StartIcon="@Icons.Material.Filled.Visibility" OnClick="@(() => PreviewFile("504"))">Preview</MudButton>
            </MudCardActions>
        </MudCard>
    </MudItem>

    <MudItem xs="12" sm="6" md="4">
        <MudCard Elevation="2" Outlined="true">
            <MudCardHeader>
                <CardHeaderAvatar>
                    <MudAvatar Color="Color.Secondary" Variant="Variant.Filled">505</MudAvatar>
                </CardHeaderAvatar>
                <CardHeaderContent>
                    <MudText Typo="Typo.subtitle1" Class="fw-bold">Trade Tests & Awards</MudText>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Certification & Results Matrix</MudText>
                </CardHeaderContent>
            </MudCardHeader>
            <MudCardActions Class="justify-end">
                <MudButton Variant="Variant.Text" Color="Color.Secondary" Size="Size.Small" StartIcon="@Icons.Material.Filled.Visibility" OnClick="@(() => PreviewFile("505"))">Preview</MudButton>
            </MudCardActions>
        </MudCard>
    </MudItem>
</MudGrid>

<!-- Submission Batches History Table -->
<MudPaper Elevation="1" Class="pa-4 mb-4">
    <div class="d-flex justify-space-between align-center mb-3">
        <div>
            <MudText Typo="Typo.h6">DHET SETMIS Submission Batch Registry</MudText>
            <MudText Typo="Typo.caption" Color="Color.Secondary">Audit history of generated flat file submissions, record counts, and Ministerial acknowledgment references</MudText>
        </div>
    </div>

    @if (_loading)
    {
        <div class="d-flex justify-center pa-8">
            <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Large" />
        </div>
    }
    else
    {
        <MudTable Items="_batches" Hover="true" Striped="true" Elevation="0">
            <HeaderContent>
                <MudTh>Batch Identifier</MudTh>
                <MudTh>Submission Period</MudTh>
                <MudTh>Scope</MudTh>
                <MudTh>Total Records</MudTh>
                <MudTh>Valid / Error</MudTh>
                <MudTh>DHET Acknowledgment</MudTh>
                <MudTh>Status</MudTh>
                <MudTh Style="text-align: right;">Actions</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Batch Identifier">
                    <span class="font-monospace fw-bold">@context.BatchNumber</span>
                </MudTd>
                <MudTd DataLabel="Period">@context.SubmissionPeriod</MudTd>
                <MudTd DataLabel="Scope">
                    <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Outlined">File @context.FileCode</MudChip>
                </MudTd>
                <MudTd DataLabel="Total Records">@context.TotalRecords</MudTd>
                <MudTd DataLabel="Valid / Error">
                    <span class="text-success fw-bold">@context.ValidRecords</span> / <span class="@(context.ErrorRecords > 0 ? "text-error fw-bold" : "text-muted")">@context.ErrorRecords</span>
                </MudTd>
                <MudTd DataLabel="DHET Acknowledgment">
                    <span class="font-monospace small">@(context.DhetAcknowledgmentRef ?? "Pending DHET")</span>
                </MudTd>
                <MudTd DataLabel="Status">
                    <MudChip T="string" Color="@GetStatusColor(context.Status)" Size="Size.Small" Variant="Variant.Filled">
                        @context.Status
                    </MudChip>
                </MudTd>
                <MudTd DataLabel="Actions" Style="text-align: right;">
                    @if (context.Status != "Accepted by DHET")
                    {
                        <MudButton Variant="Variant.Filled" Color="Color.Success" Size="Size.Small" StartIcon="@Icons.Material.Filled.Check" OnClick="@(() => OpenAckDialog(context))">
                            Record DHET Ack
                        </MudButton>
                    }
                </MudTd>
            </RowTemplate>
            <NoRecordsContent>
                <div class="pa-8 text-center text-muted">
                    <MudIcon Icon="@Icons.Material.Filled.FolderZip" Size="Size.Large" Class="mb-2" />
                    <MudText Typo="Typo.body1">No SETMIS submission batches generated yet.</MudText>
                </div>
            </NoRecordsContent>
        </MudTable>
    }
</MudPaper>

<!-- Preview Flat File Dialog -->
<MudDialog @bind-Visible="_showPreviewDialog" Options="_previewDialogOptions">
    <TitleContent>
        <MudText Typo="Typo.h6">
            <MudIcon Icon="@Icons.Material.Filled.Terminal" Class="mr-2" /> SETMIS File @_previewFileCode Flat File Stream
        </MudText>
    </TitleContent>
    <DialogContent>
        <MudPaper Elevation="0" Outlined="true" Class="pa-3 bg-dark font-monospace text-light" Style="max-height: 400px; overflow-y: auto; white-space: pre; font-size: 12px;">
            @_previewContent
        </MudPaper>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => _showPreviewDialog = false)">Close</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Download" OnClick="DownloadCurrentPreview">Download Raw File</MudButton>
    </DialogActions>
</MudDialog>

<!-- Pre-submission Validation Errors Dialog -->
<MudDialog @bind-Visible="_showErrorsDialog" Options="_previewDialogOptions">
    <TitleContent>
        <MudText Typo="Typo.h6">
            <MudIcon Icon="@Icons.Material.Filled.Warning" Class="mr-2 text-warning" /> Pre-Submission Diagnostics & Remediation
        </MudText>
    </TitleContent>
    <DialogContent>
        <MudTable Items="_validationErrors" Hover="true" Dense="true" Elevation="0">
            <HeaderContent>
                <MudTh>File</MudTh>
                <MudTh>Entity</MudTh>
                <MudTh>Severity</MudTh>
                <MudTh>Rule Check</MudTh>
                <MudTh>Remediation Guidance</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd>@context.FileCode</MudTd>
                <MudTd Class="fw-semibold">@context.EntityIdentifier</MudTd>
                <MudTd>
                    <MudChip T="string" Color="@(context.Severity == "Error" ? Color.Error : Color.Warning)" Size="Size.Small">@context.Severity</MudChip>
                </MudTd>
                <MudTd>@context.RuleDescription</MudTd>
                <MudTd Class="text-primary small">@context.RemediationGuidance</MudTd>
            </RowTemplate>
        </MudTable>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => _showErrorsDialog = false)">Close</MudButton>
    </DialogActions>
</MudDialog>

<!-- Generate Batch Modal -->
<MudDialog @bind-Visible="_showGenerateDialog" Options="_generateDialogOptions">
    <TitleContent>
        <MudText Typo="Typo.h6">
            <MudIcon Icon="@Icons.Material.Filled.Publish" Class="mr-2" /> Generate DHET SETMIS Bundle
        </MudText>
    </TitleContent>
    <DialogContent>
        <MudSelect T="string" @bind-Value="_selectedPeriod" Label="Submission Period" Variant="Variant.Outlined" Class="mb-3">
            <MudSelectItem Value="@("2026-Q1")">2026 Quarter 1 (April - June)</MudSelectItem>
            <MudSelectItem Value="@("2026-Q2")">2026 Quarter 2 (July - September)</MudSelectItem>
            <MudSelectItem Value="@("2026-Q3")">2026 Quarter 3 (October - December)</MudSelectItem>
            <MudSelectItem Value="@("2026-Q4")">2026 Quarter 4 (January - March)</MudSelectItem>
        </MudSelect>

        <MudSelect T="string" @bind-Value="_selectedFileCode" Label="Extract Scope" Variant="Variant.Outlined" Class="mb-3">
            <MudSelectItem Value="@("ALL")">Consolidated Bundle (Files 500 - 505)</MudSelectItem>
            <MudSelectItem Value="@("500")">File 500: Training Providers</MudSelectItem>
            <MudSelectItem Value="@("501")">File 501: Assessors & Moderators</MudSelectItem>
            <MudSelectItem Value="@("502")">File 502: Workplace Approvals</MudSelectItem>
            <MudSelectItem Value="@("504")">File 504: Learner Enrolments</MudSelectItem>
            <MudSelectItem Value="@("505")">File 505: Trade Tests & Certifications</MudSelectItem>
        </MudSelect>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => _showGenerateDialog = false)">Cancel</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Success" OnClick="GenerateBatch">Generate &amp; Archive</MudButton>
    </DialogActions>
</MudDialog>

<!-- Record DHET Ack Dialog -->
<MudDialog @bind-Visible="_showAckDialog" Options="_generateDialogOptions">
    <TitleContent>
        <MudText Typo="Typo.h6">
            <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Class="mr-2 text-success" /> Record DHET Ministerial Acknowledgment
        </MudText>
    </TitleContent>
    <DialogContent>
        <MudText Typo="Typo.body2" Class="mb-2">
            Batch: <strong>@(_selectedBatch?.BatchNumber)</strong>
        </MudText>
        <MudTextField @bind-Value="_ackReference" Label="DHET Upload Reference / Receipt Code" Variant="Variant.Outlined" Required="true" Class="mb-3" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => _showAckDialog = false)">Cancel</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Success" OnClick="SaveAck">Save Acknowledgment</MudButton>
    </DialogActions>
</MudDialog>

@code {
    private List<SetmisSubmissionBatch> _batches = new();
    private List<SetmisValidationMessage> _validationErrors = new();
    private bool _loading = true;
    private bool _validationRun = false;

    // Preview
    private bool _showPreviewDialog = false;
    private string _previewFileCode = "500";
    private string _previewContent = "";

    // Errors
    private bool _showErrorsDialog = false;

    // Generate
    private bool _showGenerateDialog = false;
    private string _selectedPeriod = "2026-Q2";
    private string _selectedFileCode = "ALL";

    // Ack
    private bool _showAckDialog = false;
    private SetmisSubmissionBatch? _selectedBatch;
    private string _ackReference = $"DHET-SETMIS-ACK-{DateTime.Now:yyyyMMdd}-0091";

    private readonly DialogOptions _previewDialogOptions = new() { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseButton = true };
    private readonly DialogOptions _generateDialogOptions = new() { MaxWidth = MaxWidth.Small, FullWidth = true, CloseButton = true };

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
        await RunDiagnostics();
    }

    private async Task LoadData()
    {
        _loading = true;
        _batches = await SetmisService.GetSubmissionBatchesAsync();
        _loading = false;
    }

    private async Task RunDiagnostics()
    {
        _validationErrors = await SetmisService.ValidateSetmisDataAsync();
        _validationRun = true;
        if (_validationErrors.Count == 0)
        {
            Snackbar.Add("Pre-submission diagnostics clean: 100% DHET compliance.", Severity.Success);
        }
        else
        {
            Snackbar.Add($"Diagnostics complete: {_validationErrors.Count} notices found.", Severity.Warning);
        }
    }

    private async Task PreviewFile(string fileCode)
    {
        _previewFileCode = fileCode;
        _previewContent = await SetmisService.GenerateSetmisFileContentAsync(fileCode);
        _showPreviewDialog = true;
        StateHasChanged();
    }

    private async Task DownloadCurrentPreview()
    {
        Snackbar.Add($"Exported raw SETMIS File {_previewFileCode} flat file extract.", Severity.Success);
        _showPreviewDialog = false;
    }

    private void OpenGenerateModal()
    {
        _showGenerateDialog = true;
    }

    private async Task GenerateBatch()
    {
        var batch = await SetmisService.CreateSubmissionBatchAsync(_selectedPeriod, _selectedFileCode, "Compliance Officer");
        Snackbar.Add($"SETMIS Batch '{batch.BatchNumber}' generated and archived with {_validationErrors.Count} exceptions.", Severity.Success);
        _showGenerateDialog = false;
        await LoadData();
    }

    private void OpenAckDialog(SetmisSubmissionBatch batch)
    {
        _selectedBatch = batch;
        _ackReference = $"DHET-ACK-{DateTime.Now:yyyyMMdd}-{batch.Id:D3}";
        _showAckDialog = true;
    }

    private async Task SaveAck()
    {
        if (_selectedBatch == null) return;
        await SetmisService.UpdateBatchStatusAsync(_selectedBatch.Id, "Accepted by DHET", _ackReference, "Compliance Officer");
        Snackbar.Add($"DHET Acknowledgment recorded for batch '{_selectedBatch.BatchNumber}'.", Severity.Success);
        _showAckDialog = false;
        await LoadData();
    }

    private Color GetStatusColor(string status) => status switch
    {
        "Accepted by DHET" => Color.Success,
        "Submitted to DHET" => Color.Info,
        "Validated" => Color.Primary,
        "Generated" => Color.Warning,
        "Rejected" => Color.Error,
        _ => Color.Default
    };
}
