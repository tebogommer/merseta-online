@page "/compliance/statutory"
@page "/statutory/extracts"
@page "/admin/submissions"
@using Microsoft.AspNetCore.Components.Authorization
@using Nsdms.Application.Common
@using Nsdms.Application.Services
@using Nsdms.Application.Validation
@using Nsdms.Domain.Entities
@inject ISetmisExtractService SetmisExtractService
@inject INlrdExtractService NlrdExtractService
@inject IStatutorySchedulerService SchedulerService
@inject IStatutoryValidationService ValidationService
@inject ISnackbar Snackbar
@inject NavigationManager Navigation
@rendermode InteractiveServer

@*
  UI-STANDARD.md Archetype: A2 (Statutory Work Queue & Submission Hub)
  Clauses: 4.2, 4.3, 4.4, 5.1, 7.4.2, 8.3, 9.2, 10, 11.9
*@

<PageTitle>Statutory Reporting & Extraction Hub | merSETA NSDMS</PageTitle>

<main id="main-content" style="max-width: 1600px; margin: 0 auto;">
    <!-- Shared Entity Header -->
    <EntityHeader Title="Statutory Reporting & Extraction Hub"
                  Subtitle="Official DHET SETMIS (Files 100 to 506) and SAQA NLRD Edu.Dex (Files 21 to 30) statutory flat-file engines, batch packages, automated schedulers, and pre-submission audits."
                  ReferenceKey="STATUTORY-HUB"
                  Status="Active"
                  BreadcrumbItems="@_breadcrumbs">
        <ActionZone>
            <MudButton Variant="Variant.Outlined"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Refresh"
                       OnClick="RefreshAllAsync"
                       Disabled="@(_isLoading || _isExtracting)">
                @(_isLoading ? "Auditing database..." : "Refresh data")
            </MudButton>
        </ActionZone>
    </EntityHeader>

    <!-- Main Navigation Tabs -->
    <MudTabs Elevation="2" Rounded="true" ApplyEffectsToContainer="true" PanelClass="pa-6" Color="Color.Surface" @bind-ActivePanelIndex="_activeTabIndex" Class="mt-4">
        
        <!-- ================================================================= -->
        <!-- Tab 1: DHET SETMIS Flat-File Extractions (Files 100 - 506)        -->
        <!-- ================================================================= -->
        <MudTabPanel Text="DHET SETMIS (Files 100 - 506)" Icon="@Icons.Material.Filled.AccountBalance">
            <!-- Action / Summary Banner -->
            <MudPaper Class="pa-4 mb-6 rounded-lg bg-surface border-solid mud-border-primary" Elevation="1">
                <div class="d-flex flex-wrap justify-space-between align-center gap-4">
                    <div>
                        <MudText Typo="Typo.h6" Class="font-weight-bold">DHET SETMIS Standard Flat-File Extracts</MudText>
                        <MudText Typo="Typo.body2" Color="Color.Secondary">
                            Fixed-width positional text files formatted according to the Department of Higher Education and Training specifications.
                        </MudText>
                    </div>
                    <div class="d-flex align-center gap-3">
                        <MudSelect T="int" Label="Scheme year" @bind-Value="_selectedFinancialYear" Dense="true" Margin="Margin.Dense" Style="width: 140px;">
                            <MudSelectItem Value="2026">2026</MudSelectItem>
                            <MudSelectItem Value="2025">2025</MudSelectItem>
                            <MudSelectItem Value="2024">2024</MudSelectItem>
                        </MudSelect>
                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Primary"
                                   StartIcon="@Icons.Material.Filled.Archive"
                                   OnClick="GenerateAndDownloadSetmisBatchAsync"
                                   Disabled="@_isExtracting">
                            @(_isExtracting ? "Generating package..." : "Download complete SETMIS package (.zip)")
                        </MudButton>
                    </div>
                </div>
            </MudPaper>

            <!-- SETMIS Files DataGrid -->
            <MudTable Items="@_setmisFiles" Dense="true" Hover="true" Striped="true" Bordered="true" Elevation="1" Class="rounded-lg">
                <ToolBarContent>
                    <MudText Typo="Typo.subtitle1" Class="font-weight-bold">Mandatory DHET Submission Files (11 Files)</MudText>
                    <MudSpacer />
                    <MudText Typo="Typo.caption" Color="Color.Secondary">
                        Total estimated records: <strong>@_setmisFiles.Sum(f => f.EstimatedRecordCount).ToString("N0")</strong>
                    </MudText>
                </ToolBarContent>
                <HeaderContent>
                    <MudTh>File code</MudTh>
                    <MudTh>File title & description</MudTh>
                    <MudTh>Record width</MudTh>
                    <MudTh>Estimated records</MudTh>
                    <MudTh>Statutory filename pattern</MudTh>
                    <MudTh Class="text-right">Actions</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="File code">
                        <MudChip T="string" Color="Color.Primary" Size="Size.Small" Variant="Variant.Filled" Class="font-mono">
                            File @context.FileCode
                        </MudChip>
                    </MudTd>
                    <MudTd DataLabel="Title & Description">
                        <MudText Typo="Typo.body2" Class="font-weight-bold">@context.FileTitle</MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">@context.Description</MudText>
                    </MudTd>
                    <MudTd DataLabel="Record width">
                        <span class="font-mono">@context.RecordLength chars</span>
                    </MudTd>
                    <MudTd DataLabel="Estimated records">
                        <strong>@context.EstimatedRecordCount.ToString("N0")</strong>
                    </MudTd>
                    <MudTd DataLabel="Filename pattern">
                        <code class="font-mono text-secondary" style="font-size: 0.8rem;">@context.ExpectedFileNamePattern</code>
                    </MudTd>
                    <MudTd DataLabel="Actions" Class="text-right">
                        <MudButton Variant="Variant.Outlined"
                                   Color="Color.Primary"
                                   Size="Size.Small"
                                   StartIcon="@Icons.Material.Filled.Download"
                                   OnClick="@(() => DownloadSingleSetmisFile(context.FileCode))">
                            Download .dat
                        </MudButton>
                    </MudTd>
                </RowTemplate>
            </MudTable>
        </MudTabPanel>

        <!-- ================================================================= -->
        <!-- Tab 2: SAQA NLRD Edu.Dex Extractions (Files 21 - 30)              -->
        <!-- ================================================================= -->
        <MudTabPanel Text="SAQA NLRD (Files 21 - 30 / Edu.Dex)" Icon="@Icons.Material.Filled.School">
            <!-- Action / Summary Banner -->
            <MudPaper Class="pa-4 mb-6 rounded-lg bg-surface border-solid mud-border-secondary" Elevation="1">
                <div class="d-flex flex-wrap justify-space-between align-center gap-4">
                    <div>
                        <div class="d-flex align-center gap-2">
                            <MudText Typo="Typo.h6" Class="font-weight-bold">SAQA NLRD Edu.Dex Load Specification Extracts</MudText>
                            <MudChip T="string" Color="Color.Secondary" Size="Size.Small" Variant="Variant.Outlined">Supplier ID: 599</MudChip>
                        </div>
                        <MudText Typo="Typo.body2" Color="Color.Secondary">
                            Prepend standard SAQA 1-line header (HEADER + 599 + description + record count + padding) for seamless Edu.Dex compliance.
                        </MudText>
                    </div>
                    <div class="d-flex align-center gap-3">
                        <MudSelect T="int" Label="Scheme year" @bind-Value="_selectedFinancialYear" Dense="true" Margin="Margin.Dense" Style="width: 140px;">
                            <MudSelectItem Value="2026">2026</MudSelectItem>
                            <MudSelectItem Value="2025">2025</MudSelectItem>
                            <MudSelectItem Value="2024">2024</MudSelectItem>
                        </MudSelect>
                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Secondary"
                                   StartIcon="@Icons.Material.Filled.Archive"
                                   OnClick="GenerateAndDownloadNlrdBatchAsync"
                                   Disabled="@_isExtracting">
                            @(_isExtracting ? "Generating package..." : "Download complete NLRD package (.zip)")
                        </MudButton>
                    </div>
                </div>
            </MudPaper>

            <!-- NLRD Files DataGrid -->
            <MudTable Items="@_nlrdFiles" Dense="true" Hover="true" Striped="true" Bordered="true" Elevation="1" Class="rounded-lg">
                <ToolBarContent>
                    <MudText Typo="Typo.subtitle1" Class="font-weight-bold">SAQA Edu.Dex Submission Files (8 Files)</MudText>
                    <MudSpacer />
                    <MudText Typo="Typo.caption" Color="Color.Secondary">
                        Total estimated records: <strong>@_nlrdFiles.Sum(f => f.EstimatedRecordCount).ToString("N0")</strong>
                    </MudText>
                </ToolBarContent>
                <HeaderContent>
                    <MudTh>File number</MudTh>
                    <MudTh>File title & description</MudTh>
                    <MudTh>Record width</MudTh>
                    <MudTh>Estimated records</MudTh>
                    <MudTh>Statutory filename pattern</MudTh>
                    <MudTh Class="text-right">Actions</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="File number">
                        <MudChip T="string" Color="Color.Secondary" Size="Size.Small" Variant="Variant.Filled" Class="font-mono">
                            File @context.FileCode
                        </MudChip>
                    </MudTd>
                    <MudTd DataLabel="Title & Description">
                        <MudText Typo="Typo.body2" Class="font-weight-bold">@context.FileTitle</MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">@context.Description</MudText>
                    </MudTd>
                    <MudTd DataLabel="Record width">
                        <span class="font-mono">@context.RecordLength chars</span>
                    </MudTd>
                    <MudTd DataLabel="Estimated records">
                        <strong>@context.EstimatedRecordCount.ToString("N0")</strong>
                    </MudTd>
                    <MudTd DataLabel="Filename pattern">
                        <code class="font-mono text-secondary" style="font-size: 0.8rem;">@context.ExpectedFileNamePattern</code>
                    </MudTd>
                    <MudTd DataLabel="Actions" Class="text-right">
                        <MudButton Variant="Variant.Outlined"
                                   Color="Color.Secondary"
                                   Size="Size.Small"
                                   StartIcon="@Icons.Material.Filled.Download"
                                   OnClick="@(() => DownloadSingleNlrdFile(context.FileCode))">
                            Download .dat
                        </MudButton>
                    </MudTd>
                </RowTemplate>
            </MudTable>
        </MudTabPanel>

        <!-- ================================================================= -->
        <!-- Tab 3: Statutory Submission Batches & Audit Trail                 -->
        <!-- ================================================================= -->
        <MudTabPanel Text="Submission Batch History" Icon="@Icons.Material.Filled.History">
            <MudTable Items="@_submissionBatches" Dense="true" Hover="true" Striped="true" Bordered="true" Elevation="1" Class="rounded-lg">
                <ToolBarContent>
                    <MudText Typo="Typo.subtitle1" Class="font-weight-bold">Extracted Statutory Submission Batches</MudText>
                    <MudSpacer />
                    <MudTextField @bind-Value="_batchSearch"
                                  Placeholder="Search batch number or standard..."
                                  Adornment="Adornment.Start"
                                  AdornmentIcon="@Icons.Material.Filled.Search"
                                  IconSize="Size.Small"
                                  Dense="true"
                                  Class="mt-0"
                                  Clearable="true" />
                </ToolBarContent>
                <HeaderContent>
                    <MudTh>Batch number</MudTh>
                    <MudTh>Standard</MudTh>
                    <MudTh>Scheme year</MudTh>
                    <MudTh>Total records</MudTh>
                    <MudTh>Status</MudTh>
                    <MudTh>Digital security seal</MudTh>
                    <MudTh>Extraction timestamp</MudTh>
                    <MudTh Class="text-right">Archive package</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Batch number">
                        <span class="font-mono font-weight-bold">@context.BatchNumber</span>
                    </MudTd>
                    <MudTd DataLabel="Standard">
                        <MudChip T="string" Color="@(context.BatchType == "SETMIS" ? Color.Primary : Color.Secondary)" Size="Size.Small" Variant="Variant.Outlined">
                            @context.BatchType
                        </MudChip>
                    </MudTd>
                    <MudTd DataLabel="Scheme year">@context.SubmissionYear</MudTd>
                    <MudTd DataLabel="Total records"><strong>@context.TotalRecords.ToString("N0")</strong></MudTd>
                    <MudTd DataLabel="Status">
                        <MudChip T="string" Color="Color.Success" Size="Size.Small" Variant="Variant.Filled">
                            @context.StatusCode
                        </MudChip>
                    </MudTd>
                    <MudTd DataLabel="Digital security seal">
                        <MudTooltip Text="@context.DigitalSecuritySeal" Placement="Placement.Top">
                            <span class="font-mono text-secondary" style="font-size: 0.75rem;">
                                @(context.DigitalSecuritySeal?.Length > 16 ? $"{context.DigitalSecuritySeal[..16]}..." : context.DigitalSecuritySeal)
                            </span>
                        </MudTooltip>
                    </MudTd>
                    <MudTd DataLabel="Timestamp">
                        @context.ExtractionDate.ToString("yyyy-MM-dd HH:mm")
                    </MudTd>
                    <MudTd DataLabel="Archive package" Class="text-right">
                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Primary"
                                   Size="Size.Small"
                                   StartIcon="@Icons.Material.Filled.FolderZip"
                                   OnClick="@(() => DownloadBatchArchive(context.Id))">
                            Download .zip
                        </MudButton>
                    </MudTd>
                </RowTemplate>
                <NoRecordsContent>
                    <div class="pa-6 text-center">
                        <MudText Typo="Typo.body2" Color="Color.Secondary">No statutory submission batches generated yet. Click "Download complete package" to create an audited batch.</MudText>
                    </div>
                </NoRecordsContent>
            </MudTable>
        </MudTabPanel>

        <!-- ================================================================= -->
        <!-- Tab 4: Automated Statutory Schedulers                             -->
        <!-- ================================================================= -->
        <MudTabPanel Text="Automated Schedulers" Icon="@Icons.Material.Filled.Schedule">
            <MudPaper Class="pa-4 mb-6 rounded-lg bg-surface border-solid mud-border-info" Elevation="1">
                <div class="d-flex align-center gap-3">
                    <MudIcon Icon="@Icons.Material.Filled.AutoMode" Color="Color.Info" Size="Size.Large" />
                    <div>
                        <MudText Typo="Typo.h6" Class="font-weight-bold">Automated Statutory Background Tasks</MudText>
                        <MudText Typo="Typo.body2" Color="Color.Secondary">
                            Scheduled reconciliation, cut-off deadline monitoring, and monthly delta extract preparation running automatically via ASP.NET Core Hosted Services.
                        </MudText>
                    </div>
                </div>
            </MudPaper>

            <MudGrid>
                @foreach (var job in _scheduledJobs)
                {
                    <MudItem xs="12" md="4">
                        <MudCard Elevation="2" Class="rounded-lg d-flex flex-column" Style="height: 100%;">
                            <MudCardHeader>
                                <CardHeaderContent>
                                    <div class="d-flex justify-space-between align-center mb-1">
                                        <MudChip T="string" Color="@(job.IsEnabled ? Color.Success : Color.Default)" Size="Size.Small" Variant="Variant.Filled">
                                            @(job.IsEnabled ? "Active schedule" : "Disabled")
                                        </MudChip>
                                        <MudChip T="string" Color="Color.Info" Size="Size.Small" Variant="Variant.Outlined" Class="font-mono">
                                            @job.JobKey
                                        </MudChip>
                                    </div>
                                    <MudText Typo="Typo.subtitle1" Class="font-weight-bold">@job.JobName</MudText>
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">@job.ScheduleDescription</MudText>
                                </CardHeaderContent>
                            </MudCardHeader>
                            <MudCardContent Class="flex-grow-1">
                                <MudText Typo="Typo.body2" Class="mb-4">@job.Description</MudText>

                                <MudDivider Class="my-2" />

                                <div class="mb-2">
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">Last run status:</MudText>
                                    <div>
                                        <MudChip T="string" Color="@(job.LastStatus == "Success" ? Color.Success : Color.Warning)" Size="Size.Small" Variant="Variant.Text">
                                            @job.LastStatus
                                        </MudChip>
                                        <span class="text-secondary" style="font-size: 0.75rem;">
                                            @(job.LastRunTime?.ToString("yyyy-MM-dd HH:mm") ?? "Never")
                                        </span>
                                    </div>
                                </div>

                                <div class="mb-2">
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">Next scheduled run:</MudText>
                                    <MudText Typo="Typo.body2" Class="font-mono font-weight-bold">
                                        @(job.NextRunTime?.ToString("yyyy-MM-dd HH:mm") ?? "Scheduled") SAST
                                    </MudText>
                                </div>

                                @if (!string.IsNullOrWhiteSpace(job.LastExecutionSummary))
                                {
                                    <div class="pa-2 rounded bg-surface border-solid mud-border-lines-default mt-2">
                                        <MudText Typo="Typo.caption" Color="Color.Secondary">Execution report:</MudText>
                                        <MudText Typo="Typo.caption" Class="d-block text-truncate">@job.LastExecutionSummary</MudText>
                                    </div>
                                }
                            </MudCardContent>
                            <MudCardActions Class="pa-4 pt-0">
                                <MudButton Variant="Variant.Filled"
                                           Color="Color.Primary"
                                           FullWidth="true"
                                           StartIcon="@Icons.Material.Filled.PlayArrow"
                                           OnClick="@(() => TriggerJobImmediateAsync(job.JobKey))"
                                           Disabled="@_isTriggeringJob">
                                    @(_isTriggeringJob ? "Executing job..." : "Trigger immediate run")
                                </MudButton>
                            </MudCardActions>
                        </MudCard>
                    </MudItem>
                }
            </MudGrid>
        </MudTabPanel>

        <!-- ================================================================= -->
        <!-- Tab 5: Pre-Submission Compliance Audit                            -->
        <!-- ================================================================= -->
        <MudTabPanel Text="Pre-Submission Audit Log" Icon="@Icons.Material.Filled.FactCheck">
            @if (_setmisReport != null && _nlrdReport != null)
            {
                <MudGrid Class="mb-6">
                    <MudItem xs="12" sm="6" md="3">
                        <MudPaper Class="pa-4 text-center rounded-lg border-solid mud-border-primary" Elevation="0">
                            <MudText Typo="Typo.caption" Color="Color.Secondary">Total Records Evaluated</MudText>
                            <MudText Typo="Typo.h4" Class="font-weight-bold mt-1">@((_setmisReport.TotalRecordsAudited + _nlrdReport.TotalRecordsAudited).ToString("N0"))</MudText>
                            <MudText Typo="Typo.caption" Color="Color.Primary">Across 19 Statutory Specifications</MudText>
                        </MudPaper>
                    </MudItem>
                    <MudItem xs="12" sm="6" md="3">
                        <MudPaper Class="pa-4 text-center rounded-lg border-solid mud-border-success" Elevation="0">
                            <MudText Typo="Typo.caption" Color="Color.Secondary">Compliant Records</MudText>
                            <MudText Typo="Typo.h4" Color="Color.Success" Class="font-weight-bold mt-1">@((_setmisReport.CompliantRecordsCount + _nlrdReport.CompliantRecordsCount).ToString("N0"))</MudText>
                            <MudText Typo="Typo.caption" Color="Color.Success">Ready for submission</MudText>
                        </MudPaper>
                    </MudItem>
                    <MudItem xs="12" sm="6" md="3">
                        <MudPaper Class="pa-4 text-center rounded-lg border-solid mud-border-error" Elevation="0">
                            <MudText Typo="Typo.caption" Color="Color.Secondary">Blocking Issues</MudText>
                            <MudText Typo="Typo.h4" Color="Color.Error" Class="font-weight-bold mt-1">@((_setmisReport.FatalErrorsCount + _nlrdReport.FatalErrorsCount).ToString("N0"))</MudText>
                            <MudText Typo="Typo.caption" Color="Color.Error">Quarantine count</MudText>
                        </MudPaper>
                    </MudItem>
                    <MudItem xs="12" sm="6" md="3">
                        <MudPaper Class="pa-4 text-center rounded-lg border-solid mud-border-warning" Elevation="0">
                            <MudText Typo="Typo.caption" Color="Color.Secondary">Average Compliance Score</MudText>
                            <MudText Typo="Typo.h4" Color="Color.Success" Class="font-weight-bold mt-1">
                                @(((_setmisReport.CompliancePercentage + _nlrdReport.CompliancePercentage) / 2m).ToString("F1"))%
                            </MudText>
                            <MudText Typo="Typo.caption" Color="Color.Success">Statutory audit health</MudText>
                        </MudPaper>
                    </MudItem>
                </MudGrid>

                <MudTable Items="@_allValidationErrors" Dense="true" Hover="true" Striped="true" Bordered="true" Filter="new Func<StatutoryValidationError, bool>(FilterErrorItem)">
                    <ToolBarContent>
                        <MudText Typo="Typo.h6">Validation Quarantine Issues</MudText>
                        <MudSpacer />
                        <MudTextField @bind-Value="_auditSearch"
                                      Placeholder="Search rule code, field, or entity..."
                                      Adornment="Adornment.Start"
                                      AdornmentIcon="@Icons.Material.Filled.Search"
                                      IconSize="Size.Medium"
                                      Class="mt-0"
                                      Clearable="true" />
                    </ToolBarContent>
                    <HeaderContent>
                        <MudTh>Severity</MudTh>
                        <MudTh>File & rule</MudTh>
                        <MudTh>Affected entity</MudTh>
                        <MudTh>Field name</MudTh>
                        <MudTh>Error message</MudTh>
                        <MudTh>Remediation action</MudTh>
                        <MudTh>Action</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="Severity">
                            <MudChip T="string" Color="@(context.Severity == StatutoryValidationSeverity.Fatal ? Color.Error : Color.Warning)"
                                     Size="Size.Small"
                                     Variant="Variant.Filled">
                                @context.Severity
                            </MudChip>
                        </MudTd>
                        <MudTd DataLabel="File & rule">
                            <div><strong>@context.FileIdentifier</strong></div>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">@context.RuleCode</MudText>
                        </MudTd>
                        <MudTd DataLabel="Affected entity">
                            <div><strong>@context.EntityName</strong></div>
                            <MudText Typo="Typo.caption">@context.RecordDescriptor</MudText>
                        </MudTd>
                        <MudTd DataLabel="Field name">
                            <code>@context.FieldName</code>
                        </MudTd>
                        <MudTd DataLabel="Error message">
                            <MudText Typo="Typo.body2" Color="Color.Error">@context.Message</MudText>
                        </MudTd>
                        <MudTd DataLabel="Remediation">
                            <MudText Typo="Typo.caption">@context.Remediation</MudText>
                        </MudTd>
                        <MudTd DataLabel="Action">
                            <MudIconButton Icon="@Icons.Material.Filled.OpenInNew"
                                           Color="Color.Primary"
                                           Size="Size.Small"
                                           Title="Drill-down to record"
                                           OnClick="@(() => NavigateToEntity(context.EntityName, context.RecordId))" />
                        </MudTd>
                    </RowTemplate>
                    <NoRecordsContent>
                        <div class="pa-6 text-center">
                            <MudText Typo="Typo.body2" Color="Color.Success">🎉 No validation issues detected! Database is 100% compliant with statutory specifications.</MudText>
                        </div>
                    </NoRecordsContent>
                    <PagerContent>
                        <MudTablePager PageSizeOptions="new int[] { 10, 25, 50, 100 }" />
                    </PagerContent>
                </MudTable>
            }
        </MudTabPanel>

    </MudTabs>
</main>

@code {
    private bool _isLoading = false;
    private bool _isExtracting = false;
    private bool _isTriggeringJob = false;
    private int _activeTabIndex = 0;
    private int _selectedFinancialYear = 2026;
    private string _batchSearch = string.Empty;
    private string _auditSearch = string.Empty;

    private List<StatutoryBatchFileSummary> _setmisFiles = new();
    private List<StatutoryBatchFileSummary> _nlrdFiles = new();
    private List<StatutorySubmissionBatch> _submissionBatches = new();
    private List<StatutoryJobStatusDto> _scheduledJobs = new();

    private StatutoryValidationReport? _setmisReport;
    private StatutoryValidationReport? _nlrdReport;
    private List<StatutoryValidationError> _allValidationErrors = new();

    private readonly List<BreadcrumbItem> _breadcrumbs = new()
    {
        new("Home", href: "/", icon: Icons.Material.Filled.Home),
        new("Legal, compliance & BI", href: "/compliance/statutory", icon: Icons.Material.Filled.Gavel),
        new("Statutory reporting & extraction hub", href: null, disabled: true)
    };

    protected override async Task OnInitializedAsync()
    {
        await RefreshAllAsync();
    }

    private async Task RefreshAllAsync()
    {
        try
        {
            _isLoading = true;
            _setmisFiles = await SetmisExtractService.GetSetmisFileDescriptorsAsync();
            _nlrdFiles = await NlrdExtractService.GetNlrdFileDescriptorsAsync();
            _submissionBatches = await SetmisExtractService.GetSetmisBatchesAsync();
            var nlrdBatches = await NlrdExtractService.GetNlrdBatchesAsync();
            _submissionBatches.AddRange(nlrdBatches);
            _submissionBatches = _submissionBatches.OrderByDescending(b => b.ExtractionDate).ToList();

            _scheduledJobs = await SchedulerService.GetJobStatusesAsync();

            _setmisReport = await ValidationService.ValidateSetmisSubmissionBatchAsync();
            _nlrdReport = await ValidationService.ValidateNlrdSubmissionBatchAsync();

            _allValidationErrors = new List<StatutoryValidationError>();
            if (_setmisReport?.Errors != null) _allValidationErrors.AddRange(_setmisReport.Errors);
            if (_nlrdReport?.Errors != null) _allValidationErrors.AddRange(_nlrdReport.Errors);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error loading statutory data: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isLoading = false;
        }
