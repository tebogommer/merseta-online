    private async Task TriggerJobImmediateAsync(string jobKey)
    {
        try
        {
            _isTriggeringJob = true;
            Snackbar.Add($"Triggering immediate execution of scheduled job {jobKey}...", Severity.Info);
            var result = await SchedulerService.TriggerJobAsync(jobKey, "User_Admin");
            if (result.Success)
            {
                Snackbar.Add($"Scheduled job completed: {result.Summary}", Severity.Success);
            }
            else
            {
                Snackbar.Add($"Job execution failed: {result.ErrorMessage}", Severity.Error);
            }
            _scheduledJobs = await SchedulerService.GetJobStatusesAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Failed to execute scheduled job: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isTriggeringJob = false;
        }
    }

    private bool FilterErrorItem(StatutoryValidationError item)
    {
        if (string.IsNullOrWhiteSpace(_auditSearch)) return true;
        if (item.RuleCode.Contains(_auditSearch, StringComparison.OrdinalIgnoreCase)) return true;
        if (item.FieldName.Contains(_auditSearch, StringComparison.OrdinalIgnoreCase)) return true;
        if (item.EntityName.Contains(_auditSearch, StringComparison.OrdinalIgnoreCase)) return true;
        if (item.Message.Contains(_auditSearch, StringComparison.OrdinalIgnoreCase)) return true;
        if (item.FileIdentifier.Contains(_auditSearch, StringComparison.OrdinalIgnoreCase)) return true;
        return false;
    }

    private void NavigateToEntity(string entityName, int recordId)
    {
        switch (entityName.ToLowerInvariant())
        {
            case "person":
                Navigation.NavigateTo($"/people/{recordId}");
                break;
            case "organisation":
                Navigation.NavigateTo($"/employers/{recordId}");
                break;
            case "companylearner":
                Navigation.NavigateTo($"/learners/{recordId}");
                break;
            case "trainingprovider":
                Navigation.NavigateTo($"/providers/{recordId}");
                break;
            default:
                Snackbar.Add($"Direct link not available for {entityName} #{recordId}", Severity.Info);
                break;
        }
    }
