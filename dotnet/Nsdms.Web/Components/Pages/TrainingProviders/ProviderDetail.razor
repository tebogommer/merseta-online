@page "/sdp/{id:int}"
@page "/sdp/{id:int}/edit"
@page "/sdp/create"
@using Nsdms.Application.Common.Models
@using Nsdms.Application.Services
@using Nsdms.Domain.Entities
@using Nsdms.Web.Components.Shared
@inject ITrainingProviderService ProviderService
@inject ISdpCampusService CampusService
@inject IOrganisationService OrgService
@inject IPersonService PersonService
@inject IBrandAssetService BrandAssetService
@inject LookupService LookupService
@inject NavigationManager NavManager
@inject ISnackbar Snackbar
@rendermode InteractiveServer

<PageTitle>@(Id == 0 ? "New SDP Accreditation Registration" : $"SDP {_provider.AccreditationNumber}") - NSDMS</PageTitle>

<!-- Sticky Top Bar with Breadcrumbs and Action Buttons -->
<MudPaper Elevation="1" Class="sticky-top pa-4 mb-4 rounded-lg d-flex flex-wrap justify-space-between align-center gap-3" Style="top: var(--mud-appbar-height, 64px); z-index: 10;">
    <div class="d-flex align-center gap-3">
        <MudButton Variant="Variant.Text"
                   StartIcon="@Icons.Material.Filled.ArrowBack"
                   Color="Color.Default"
                   OnClick="BackToList"
                   aria-label="Back to SDP Registry">
            Back to SDP Registry
        </MudButton>
        <MudDivider Vertical="true" FlexItem="true" Class="mx-1 my-2" />
        @if (!string.IsNullOrEmpty(_logoDataUri))
        {
            <img src="@_logoDataUri" alt="SDP Logo" style="height: 38px; width: 38px; object-fit: cover; border-radius: 4px; border: 1px solid var(--mud-palette-lines-default);" />
        }
        else
        {
            <MudAvatar Color="Color.Primary" Variant="Variant.Filled" Size="Size.Small">
                <MudIcon Icon="@Icons.Material.Filled.School" Size="Size.Small" />
            </MudAvatar>
        }
        <div>
            <MudBreadcrumbs Items="_breadcrumbItems" Separator=">" Class="pa-0 ma-0" />
            <MudText Typo="Typo.h6" Class="font-weight-bold">
                @(Id == 0 ? "New SDP Accreditation Registration" : $"{_provider.AccreditationNumber} - {_provider.Organisation?.CompanyName ?? "Provider Detail"}")
            </MudText>
        </div>
    </div>
    <div class="d-flex align-center gap-2">
        @if (Id > 0)
        {
            <MudChip T="string" Color="@GetStatusColor(_provider.ProviderStatusCode)" Variant="Variant.Filled">
                @(_provider.ProviderStatusCode ?? "Accredited")
            </MudChip>

            <MudMenu Label="Provider Services"
                     StartIcon="@Icons.Material.Filled.Bolt"
                     EndIcon="@Icons.Material.Filled.KeyboardArrowDown"
                     Color="Color.Default"
                     Variant="Variant.Outlined"
                     Dense="true"
                     aria-label="Provider Services Menu">
                <MudMenuItem Icon="@Icons.Material.Filled.WorkspacePremium" Href="@($"/etqa/scope-extensions?providerId={Id}")">
                    Apply for Scope Extension
                </MudMenuItem>
                <MudMenuItem Icon="@Icons.Material.Filled.MenuBook" Href="@($"/curriculum/courseware?providerId={Id}")">
                    Request Courseware Package
                </MudMenuItem>
                <MudDivider Class="my-1" />
                <MudMenuItem Icon="@Icons.Material.Filled.Delete" IconColor="Color.Error" OnClick="DeleteProvider">
                    Delete Provider
                </MudMenuItem>
            </MudMenu>

            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Autorenew"
                       OnClick="RenewProviderAccreditation"
                       aria-label="Renew Provider Accreditation">
                Renew Accreditation
            </MudButton>
        }
        <MudButton Variant="Variant.Outlined"
                   Color="Color.Secondary"
                   StartIcon="@Icons.Material.Filled.Cancel"
                   OnClick="BackToList"
                   aria-label="Cancel and Return">
            Cancel
        </MudButton>
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Save"
                   OnClick="SaveProvider"
                   Disabled="_isSaving"
                   aria-label="Save Provider Record">
            @(_isSaving ? "Saving..." : "Save Provider")
        </MudButton>
    </div>
</MudPaper>

<div>
    @if (Id > 0)
    {
        <!-- Visual Workflow Step Tracker -->
        <WorkflowProgressBar ProcessCode="PROVIDER" 
                             EntityId="@Id" 
                             EntityTitle="@($"{_provider.AccreditationNumber} - {_provider.Organisation?.CompanyName ?? "Provider"}")" 
                             EntityRef="@_provider.AccreditationNumber" />

        <!-- Action Bridge for Workflow Transitions -->
        <WorkflowActionBridge ProcessCode="PROVIDER" 
                              EntityId="@Id" 
                              EntityTitle="@($"{_provider.AccreditationNumber} - {_provider.Organisation?.CompanyName ?? "Provider"}")" 
                              EntityRef="@_provider.AccreditationNumber" 
                              OnStatusChanged="OnWorkflowStatusChanged" />
    }

    @if (_loading)
    {
        <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="my-6" />
    }
    else
    {
        <MudTabs Elevation="2" Rounded="true" ApplyEffectsToContainer="true" Color="Color.Surface" @bind-ActivePanelIndex="_activeTabIndex">
            
            <!-- TAB 1: General Info & Accreditation -->
            <MudTabPanel Text="Provider Profile" Icon="@Icons.Material.Filled.School">
                <MudForm @ref="_form" @bind-IsValid="_isValid">
                    <MudGrid Spacing="3">
                        <!-- Core Accreditation Details -->
                        <MudItem xs="12" lg="8">
                            <MudCard Elevation="2" Class="mb-4">
                                <MudCardHeader>
                                    <CardHeaderAvatar>
                                        <MudAvatar Color="Color.Primary" Variant="Variant.Filled">
                                            <MudIcon Icon="@Icons.Material.Filled.WorkspacePremium" />
                                        </MudAvatar>
                                    </CardHeaderAvatar>
                                    <CardHeaderContent>
                                        <MudText Typo="Typo.h6">Accreditation &amp; Provider Details</MudText>
                                        <MudText Typo="Typo.caption" Color="Color.Secondary">Official SETA accreditation credentials, capacity, and legal host organisation</MudText>
                                    </CardHeaderContent>
                                </MudCardHeader>
                                <MudCardContent>
                                    <MudGrid>
                                        <MudItem xs="12" md="6">
                                            <MudSelect T="int" Label="Host Organisation / Legal Entity" Required="true" RequiredError="Organisation is mandatory" @bind-Value="_provider.OrganisationId" Variant="Variant.Outlined">
                                                @foreach (var org in _organisations)
                                                {
                                                    <MudSelectItem Value="@org.Id">@org.CompanyName (@org.SdlNumber)</MudSelectItem>
                                                }
                                            </MudSelect>
                                        </MudItem>
                                        <MudItem xs="12" md="6">
                                            <MudTextField T="string"
                                                          Label="Accreditation Number"
                                                          Required="true"
                                                          RequiredError="Accreditation Number is mandatory"
                                                          @bind-Value="_provider.AccreditationNumber"
                                                          Variant="Variant.Outlined"
                                                          Placeholder="e.g. SDP-2026-0812" />
                                        </MudItem>
                                        <MudItem xs="12" md="6">
                                            <MudSelect T="string" Label="Provider Type" @bind-Value="_provider.ProviderTypeCode" Variant="Variant.Outlined">
                                                @foreach (var pt in _providerTypes)
                                                {
                                                    <MudSelectItem Value="@pt.Code">@pt.Name (@pt.Code)</MudSelectItem>
                                                }
                                            </MudSelect>
                                        </MudItem>
                                        <MudItem xs="12" md="6">
                                            <MudSelect T="string" Label="Provider Status" @bind-Value="_provider.ProviderStatusCode" Variant="Variant.Outlined">
                                                @foreach (var ps in _providerStatusTypes)
                                                {
                                                    <MudSelectItem Value="@ps.Code">@ps.Name</MudSelectItem>
                                                }
                                            </MudSelect>
                                        </MudItem>
                                        <MudItem xs="12" md="6">
                                            <MudTextField T="string"
                                                          Label="ETQA Decision Number"
                                                          @bind-Value="_provider.EtqaDecisionNumber"
                                                          Variant="Variant.Outlined"
                                                          Placeholder="e.g. ETQA-DEC-48201" />
                                        </MudItem>
                                        <MudItem xs="12" md="6">
                                            <MudTextField T="string"
                                                          Label="SARS Tax Number"
                                                          @bind-Value="_provider.SarsNumber"
                                                          Variant="Variant.Outlined"
                                                          Placeholder="e.g. 9482019382" />
                                        </MudItem>
                                        <MudItem xs="12" md="6">
                                            <MudDatePicker Label="Accreditation Start Date"
                                                           @bind-Date="_provider.AccreditationStartDate"
                                                           Variant="Variant.Outlined" />
                                        </MudItem>
                                        <MudItem xs="12" md="6">
                                            <MudDatePicker Label="Accreditation End Date"
                                                           @bind-Date="_provider.AccreditationEndDate"
                                                           Variant="Variant.Outlined" />
                                        </MudItem>
                                        <MudItem xs="12" md="6">
                                            <MudNumericField T="int?"
                                                             Label="Max Learner Capacity"
                                                             @bind-Value="_provider.MaxLearnerCapacity"
                                                             Variant="Variant.Outlined"
                                                             Min="0" />
                                        </MudItem>
                                        <MudItem xs="12" md="6">
                                            <MudSelect T="int?" Label="Primary Contact Person" @bind-Value="_provider.PrimaryContactPersonId" Variant="Variant.Outlined" Clearable="true">
                                                @foreach (var p in _people)
                                                {
                                                    <MudSelectItem Value="@((int?)p.Id)">@p.FullName (@p.Email)</MudSelectItem>
                                                }
                                            </MudSelect>
                                        </MudItem>
                                        <MudItem xs="12" md="6">
                                            <MudTextField T="string"
                                                          Label="Website URL"
                                                          @bind-Value="_provider.WebsiteUrl"
                                                          Variant="Variant.Outlined"
                                                          Placeholder="https://www.provider.edu.za" />
                                        </MudItem>
                                        <MudItem xs="12" md="6">
                                            <MudTextField T="string"
                                                          Label="Fax Number"
                                                          @bind-Value="_provider.FaxNumber"
                                                          Variant="Variant.Outlined"
                                                          Placeholder="e.g. +27 11 555 0199" />
                                        </MudItem>
                                        <MudItem xs="12">
                                            <MudSwitch T="bool"
                                                       Label="Active Provider for Learner Enrolments"
                                                       @bind-Value="_provider.IsActive"
                                                       Color="Color.Primary" />
                                        </MudItem>
                                    </MudGrid>
                                </MudCardContent>
                            </MudCard>
                        </MudItem>

                        <!-- Right Column: Institutional Branding & Summary -->
                        <MudItem xs="12" lg="4">
                            <MudCard Elevation="2" Class="mb-4">
                                <MudCardHeader>
                                    <CardHeaderAvatar>
                                        <MudAvatar Color="Color.Secondary" Variant="Variant.Filled">
                                            <MudIcon Icon="@Icons.Material.Filled.Palette" />
                                        </MudAvatar>
                                    </CardHeaderAvatar>
                                    <CardHeaderContent>
                                        <MudText Typo="Typo.h6">Institutional Branding</MudText>
                                        <MudText Typo="Typo.caption" Color="Color.Secondary">Provider logo and UI theming</MudText>
                                    </CardHeaderContent>
                                </MudCardHeader>
                                <MudCardContent>
                                    <div class="d-flex flex-column align-center gap-3">
                                        @if (!string.IsNullOrEmpty(_logoDataUri))
                                        {
                                            <img src="@_logoDataUri" alt="Provider Logo" style="max-height: 120px; max-width: 100%; object-fit: contain; border-radius: 8px; border: 1px solid var(--mud-palette-lines-default);" />
                                        }
                                        else
                                        {
                                            <div class="d-flex flex-column align-center justify-center pa-6 rounded-lg bg-surface" style="border: 2px dashed var(--mud-palette-lines-default); width: 100%;">
                                                <MudIcon Icon="@Icons.Material.Filled.Image" Size="Size.Large" Color="Color.Default" />
                                                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-2">No custom logo uploaded</MudText>
                                            </div>
                                        }

                                        <MudFileUpload T="IBrowserFile" Accept=".png,.jpg,.jpeg,.svg,.webp" OnFilesChanged="UploadLogo" Class="mt-2">
                                            <ActivatorContent>
                                                <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.CloudUpload" Size="Size.Small">
                                                    Upload Brand Logo
                                                </MudButton>
                                            </ActivatorContent>
                                        </MudFileUpload>

                                        <MudColorPicker Label="Primary Brand Color"
                                                        @bind-Text="_provider.BrandColorHex"
                                                        Placeholder="#003366"
                                                        Variant="Variant.Outlined"
                                                        Class="mt-2 w-100" />
                                    </div>
                                </MudCardContent>
                            </MudCard>
                        </MudItem>
                    </MudGrid>
                </MudForm>
            </MudTabPanel>

            <!-- TAB 2: Accredited Qualifications -->
            <MudTabPanel Text="Qualifications Scope" Icon="@Icons.Material.Filled.CardMembership" Disabled="Id == 0">
                <div class="d-flex flex-wrap justify-space-between align-center mb-4 gap-3">
                    <div>
                        <MudText Typo="Typo.h6">Accredited SAQA Qualifications (SETMIS File 500)</MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">Registered full occupational qualifications and learning programmes in scope</MudText>
                    </div>
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.Add"
                               OnClick="OpenAddQualificationDialog"
                               aria-label="Add Accredited Qualification">
                        Add Qualification
                    </MudButton>
                </div>

                <MudTable Items="_qualifications" Hover="true" Dense="true" Striped="true" Elevation="1">
                    <HeaderContent>
                        <MudTh>SAQA ID</MudTh>
                        <MudTh>Qualification Title</MudTh>
                        <MudTh>NQF Level</MudTh>
                        <MudTh>Status</MudTh>
                        <MudTh>Expiry Date</MudTh>
                        <MudTh Style="text-align:right">Action</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="SAQA ID"><strong>@context.SaqaQualificationId</strong></MudTd>
                        <MudTd DataLabel="Qualification Title">@context.QualificationTitle</MudTd>
                        <MudTd DataLabel="NQF Level">@(context.NqfLevel.HasValue ? $"Level {context.NqfLevel}" : "-")</MudTd>
                        <MudTd DataLabel="Status">
                            <MudChip T="string" Color="Color.Success" Size="Size.Small">
                                @(context.AccreditationStatusCode ?? "Active")
                            </MudChip>
                        </MudTd>
                        <MudTd DataLabel="Expiry Date">@(context.ExpiryDate?.ToString("yyyy-MM-dd") ?? "-")</MudTd>
                        <MudTd Style="text-align:right" DataLabel="Action">
                            <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                           Color="Color.Error"
                                           Size="Size.Small"
                                           OnClick="@(() => RemoveQualification(context.Id))"
                                           aria-label="Remove Qualification Scope" />
                        </MudTd>
                    </RowTemplate>
                    <NoRecordsContent>
                        <div class="pa-4 text-center">
                            <MudText Typo="Typo.body2" Color="Color.Secondary">No accredited qualifications in scope yet.</MudText>
                        </div>
                    </NoRecordsContent>
                </MudTable>
            </MudTabPanel>

            <!-- TAB 3: Unit Standards Scope -->
            <MudTabPanel Text="Unit Standards Scope" Icon="@Icons.Material.Filled.FactCheck" Disabled="Id == 0">
                <div class="d-flex flex-wrap justify-space-between align-center mb-4 gap-3">
                    <div>
                        <MudText Typo="Typo.h6">Accredited Unit Standards (SETMIS File 501/502)</MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">Registered individual unit standards, part-qualifications, and skills programmes</MudText>
                    </div>
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.Add"
                               OnClick="OpenAddUnitStandardDialog"
                               aria-label="Add Accredited Unit Standard">
                        Add Unit Standard
                    </MudButton>
                </div>

                <MudTable Items="_unitStandards" Hover="true" Dense="true" Striped="true" Elevation="1">
                    <HeaderContent>
                        <MudTh>US Code / ID</MudTh>
                        <MudTh>Unit Standard Title</MudTh>
                        <MudTh>NQF Level</MudTh>
                        <MudTh>Credits</MudTh>
                        <MudTh Style="text-align:right">Action</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="US Code"><strong>@context.UnitStandardId</strong></MudTd>
                        <MudTd DataLabel="Title">@context.UnitStandardTitle</MudTd>
                        <MudTd DataLabel="NQF Level">@(context.NqfLevel.HasValue ? $"Level {context.NqfLevel}" : "-")</MudTd>
                        <MudTd DataLabel="Credits">@context.Credits</MudTd>
                        <MudTd Style="text-align:right" DataLabel="Action">
                            <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                           Color="Color.Error"
                                           Size="Size.Small"
                                           OnClick="@(() => RemoveUnitStandard(context.Id))"
                                           aria-label="Remove Unit Standard Scope" />
                        </MudTd>
                    </RowTemplate>
                    <NoRecordsContent>
                        <div class="pa-4 text-center">
                            <MudText Typo="Typo.body2" Color="Color.Secondary">No unit standards in scope yet.</MudText>
                        </div>
                    </NoRecordsContent>
                </MudTable>
            </MudTabPanel>

            <!-- TAB 4: Enrolled Learners & Cohorts -->
            <MudTabPanel Text="Enrolled Learners" Icon="@Icons.Material.Filled.People" Disabled="Id == 0">
                <div class="d-flex flex-wrap justify-space-between align-center mb-4 gap-3">
                    <div>
                        <MudText Typo="Typo.h6">Enrolled Learners &amp; Cohorts (SETMIS 500/501)</MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">Learners actively receiving institutional training under this provider</MudText>
                    </div>
                    <MudChip T="string" Color="Color.Primary" Size="Size.Small" Variant="Variant.Filled">
                        @_enrolledLearners.Count Active Learners
                    </MudChip>
                </div>

                @if (_loadingLearners)
                {
                    <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="my-4" />
                }
                else
                {
                    <MudTable Items="_enrolledLearners" Hover="true" Dense="true" Striped="true" Elevation="1">
                        <HeaderContent>
                            <MudTh>Contract No</MudTh>
                            <MudTh>Learner Name</MudTh>
                            <MudTh>RSA ID / Passport</MudTh>
                            <MudTh>Qualification / Trade</MudTh>
                            <MudTh>Programme Type</MudTh>
                            <MudTh>Sponsoring Employer</MudTh>
                            <MudTh>Registered Date</MudTh>
                            <MudTh>Status</MudTh>
                            <MudTh Style="text-align:right">Action</MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd DataLabel="Contract No"><strong>@context.LearnerContractNumber</strong></MudTd>
                            <MudTd DataLabel="Learner Name">@context.LearnerFullName</MudTd>
                            <MudTd DataLabel="RSA ID">@(!string.IsNullOrWhiteSpace(context.RsaIdNumber) ? context.RsaIdNumber : "-")</MudTd>
                            <MudTd DataLabel="Qualification">@context.QualificationTitle</MudTd>
                            <MudTd DataLabel="Programme Type">
                                <MudChip T="string" Color="Color.Info" Size="Size.Small" Variant="Variant.Outlined">
                                    @context.LearningProgrammeTypeName
                                </MudChip>
                            </MudTd>
                            <MudTd DataLabel="Employer">@(context.SponsoringEmployerName ?? "Unlinked")</MudTd>
                            <MudTd DataLabel="Registered">@context.RegistrationDate.ToString("yyyy-MM-dd")</MudTd>
                            <MudTd DataLabel="Status">
                                <MudChip T="string" Color="@GetStatusColor(context.Status)" Size="Size.Small">
                                    @context.Status
                                </MudChip>
                            </MudTd>
                            <MudTd Style="text-align:right" DataLabel="Action">
                                <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary" Href="@($"/learners/{context.CompanyLearnerId}")">
                                    Open
                                </MudButton>
                            </MudTd>
                        </RowTemplate>
                        <NoRecordsContent>
                            <div class="pa-4 text-center">
                                <MudText Typo="Typo.body2" Color="Color.Secondary">No enrolled learners found under this provider.</MudText>
                            </div>
                        </NoRecordsContent>
                    </MudTable>
                }
            </MudTabPanel>

            <!-- TAB 5: Delivery Campuses & Physical Sites -->
            <MudTabPanel Text="Delivery Campuses &amp; Sites" Icon="@Icons.Material.Filled.LocationOn" Disabled="Id == 0">
                <div class="d-flex flex-wrap justify-space-between align-center mb-4 gap-3">
                    <div>
                        <MudText Typo="Typo.h6">Accredited Delivery Campuses &amp; Physical Sites</MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">Approved satellite facilities and training delivery centres belonging to this provider</MudText>
                    </div>
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               Size="Size.Small"
                               StartIcon="@Icons.Material.Filled.AddLocation"
                               OnClick="OpenAddCampusDialog">
                        Add Campus Site
                    </MudButton>
                </div>

                @if (_loadingCampuses)
                {
                    <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="my-4" />
                }
                else
                {
                    <MudTable Items="_campuses" Hover="true" Dense="true" Striped="true" Elevation="1">
                        <HeaderContent>
                            <MudTh>Campus Name</MudTh>
                            <MudTh>Code</MudTh>
                            <MudTh>Location (City / Province)</MudTh>
                            <MudTh>Contact Person</MudTh>
                            <MudTh>Type</MudTh>
                            <MudTh>Status</MudTh>
                            <MudTh Style="text-align:right">Actions</MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd DataLabel="Name"><strong>@context.CampusName</strong></MudTd>
                            <MudTd DataLabel="Code"><span class="font-mono">@context.CampusCode</span></MudTd>
                            <MudTd DataLabel="Location">@context.City, @context.ProvinceCode</MudTd>
                            <MudTd DataLabel="Contact">@context.ContactPersonName (@context.ContactPhone)</MudTd>
                            <MudTd DataLabel="Type">
                                @if (context.IsPrimarySite)
                                {
                                    <MudChip T="string" Color="Color.Primary" Size="Size.Small" Variant="Variant.Filled">Main Campus</MudChip>
                                }
                                else
                                {
                                    <MudChip T="string" Color="Color.Default" Size="Size.Small" Variant="Variant.Outlined">Satellite</MudChip>
                                }
                            </MudTd>
                            <MudTd DataLabel="Status">
                                <MudChip T="string" Color="@(context.Status == "Active" ? Color.Success : Color.Warning)" Size="Size.Small" Variant="Variant.Filled">
                                    @context.Status
                                </MudChip>
                            </MudTd>
                            <MudTd Style="text-align:right" DataLabel="Actions">
                                <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small" OnClick="@(() => DeleteCampus(context.Id))" aria-label="Delete Campus" />
                            </MudTd>
                        </RowTemplate>
                        <NoRecordsContent>
                            <div class="pa-4 text-center">
                                <MudText Typo="Typo.body2" Color="Color.Secondary">No physical delivery campuses configured for this provider.</MudText>
                            </div>
                        </NoRecordsContent>
                    </MudTable>
                }
            </MudTabPanel>

            <!-- TAB 6: Registered Assessors & Moderators -->
            <MudTabPanel Text="Assessors &amp; Moderators" Icon="@Icons.Material.Filled.Badge" Disabled="Id == 0">
                <div class="d-flex flex-wrap justify-space-between align-center mb-4 gap-3">
                    <div>
                        <MudText Typo="Typo.h6">Registered Assessors &amp; Moderators</MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">Accredited practitioners linked to this SDP and its delivery campuses</MudText>
                    </div>
                </div>

                @if (_loadingAssessors)
                {
                    <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="my-4" />
                }
                else
                {
                    <MudTable Items="_assessors" Hover="true" Dense="true" Striped="true" Elevation="1">
                        <HeaderContent>
                            <MudTh>Practitioner Name</MudTh>
                            <MudTh>ETQA Reg Number</MudTh>
                            <MudTh>Type</MudTh>
                            <MudTh>Qualification Scope</MudTh>
                            <MudTh>Expiry Date</MudTh>
                            <MudTh>Status</MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd DataLabel="Name"><strong>@context.FullName</strong></MudTd>
                            <MudTd DataLabel="Reg Number">@context.RegistrationNumber</MudTd>
                            <MudTd DataLabel="Type">
                                <MudChip T="string" Color="Color.Info" Size="Size.Small">@context.PractitionerType</MudChip>
                            </MudTd>
                            <MudTd DataLabel="Scope">@(!string.IsNullOrWhiteSpace(context.ScopeQualifications) ? context.ScopeQualifications : "Full merSETA Scope")</MudTd>
                            <MudTd DataLabel="Expiry">@(context.ExpiryDate?.ToString("yyyy-MM-dd") ?? "-")</MudTd>
                            <MudTd DataLabel="Status">
                                <MudChip T="string" Color="Color.Success" Size="Size.Small">@context.Status</MudChip>
                            </MudTd>
                        </RowTemplate>
                        <NoRecordsContent>
                            <div class="pa-4 text-center">
                                <MudText Typo="Typo.body2" Color="Color.Secondary">No registered assessors or moderators on record.</MudText>
                            </div>
                        </NoRecordsContent>
                    </MudTable>
                }
            </MudTabPanel>

            <!-- TAB 6: Participating Host Employers -->
            <MudTabPanel Text="Host Workplaces" Icon="@Icons.Material.Filled.Apartment" Disabled="Id == 0">
                <div class="d-flex flex-wrap justify-space-between align-center mb-4 gap-3">
                    <div>
                        <MudText Typo="Typo.h6">Partnering Host Employers &amp; Workplaces</MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">Companies partnering with this SDP for structured workplace logbook experience</MudText>
                    </div>
                </div>

                @if (_loadingEmployers)
                {
                    <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="my-4" />
                }
                else
                {
                    <MudTable Items="_employers" Hover="true" Dense="true" Striped="true" Elevation="1">
                        <HeaderContent>
                            <MudTh>Employer Name</MudTh>
                            <MudTh>SARS SDL Number</MudTh>
                            <MudTh>Facility Site</MudTh>
                            <MudTh>Placed Learners</MudTh>
                            <MudTh>Contact Person</MudTh>
                            <MudTh>Contact Details</MudTh>
                            <MudTh Style="text-align:right">Action</MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd DataLabel="Employer Name">
                                <div class="d-flex align-center gap-2">
                                    <MudIcon Icon="@Icons.Material.Filled.Apartment" Color="Color.Primary" Size="Size.Small" />
                                    <MudLink Href="@($"/employers/{context.EmployerId}")" Typo="Typo.body2" Class="fw-bold">
                                        @context.CompanyName
                                    </MudLink>
                                </div>
                            </MudTd>
                            <MudTd DataLabel="SDL Number">@context.SdlNumber</MudTd>
                            <MudTd DataLabel="Site">@context.SiteName</MudTd>
                            <MudTd DataLabel="Placed Learners">
                                <MudChip T="string" Color="Color.Primary" Size="Size.Small">
                                    @context.PlacedLearnersCount Placed
                                </MudChip>
                            </MudTd>
                            <MudTd DataLabel="Contact">@(context.ContactPersonName ?? "-")</MudTd>
                            <MudTd DataLabel="Details">@(context.ContactEmail ?? context.ContactPhone ?? "-")</MudTd>
                            <MudTd Style="text-align:right" DataLabel="Action">
                                <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Business" Href="@($"/employers/{context.EmployerId}")">
                                    View Org
                                </MudButton>
                            </MudTd>
                        </RowTemplate>
                        <NoRecordsContent>
                            <div class="pa-4 text-center">
                                <MudText Typo="Typo.body2" Color="Color.Secondary">No partnering employers found.</MudText>
                            </div>
                        </NoRecordsContent>
                    </MudTable>
                }
            </MudTabPanel>

            <!-- TAB 7: ETQA Audits & Quality Visits -->
            <MudTabPanel Text="Quality Audits &amp; Visits" Icon="@Icons.Material.Filled.EventAvailable" Disabled="Id == 0">
                <div class="d-flex flex-wrap justify-space-between align-center mb-4 gap-3">
                    <div>
                        <MudText Typo="Typo.h6">ETQA Accreditation &amp; Moderation Audits</MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">Quality assurance monitoring audits and verification visits</MudText>
                    </div>
                </div>

                @if (_loadingAudits)
                {
                    <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="my-4" />
                }
                else
                {
                    <MudTable Items="_audits" Hover="true" Dense="true" Striped="true" Elevation="1">
                        <HeaderContent>
                            <MudTh>Visit Reference</MudTh>
                            <MudTh>Audit Type</MudTh>
                            <MudTh>Visit Date</MudTh>
                            <MudTh>Lead Auditor</MudTh>
                            <MudTh>Status</MudTh>
                            <MudTh>Objectives / Scope</MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd DataLabel="Reference"><strong>@context.VisitNumber</strong></MudTd>
                            <MudTd DataLabel="Audit Type">
                                <MudChip T="string" Color="Color.Info" Size="Size.Small" Variant="Variant.Outlined">
                                    @context.AuditType
                                </MudChip>
                            </MudTd>
                            <MudTd DataLabel="Date">@context.VisitDate.ToString("yyyy-MM-dd")</MudTd>
                            <MudTd DataLabel="Auditor">@context.AuditorName</MudTd>
                            <MudTd DataLabel="Status">
                                <MudChip T="string" Color="Color.Success" Size="Size.Small">
                                    @context.ComplianceStatus
                                </MudChip>
                            </MudTd>
                            <MudTd DataLabel="Objectives">@(!string.IsNullOrWhiteSpace(context.Remarks) ? context.Remarks : "-")</MudTd>
                        </RowTemplate>
                        <NoRecordsContent>
                            <div class="pa-4 text-center">
                                <MudText Typo="Typo.body2" Color="Color.Secondary">No audit or monitoring visits recorded for this provider.</MudText>
                            </div>
                        </NoRecordsContent>
                    </MudTable>
                }
            </MudTabPanel>

            <!-- TAB 8: Evidence Vault & Workflow History -->
            @if (Id > 0)
            {
                <MudTabPanel Text="Evidence Vault" Icon="@Icons.Material.Filled.FolderZip">
                    <DocumentVault TargetEntityName="TrainingProvider" TargetEntityId="@Id" />
                </MudTabPanel>

                <MudTabPanel Text="Workflow History" Icon="@Icons.Material.Filled.History">
                    <WorkflowTimeline ProcessCode="PROVIDER" EntityId="@Id" />
                </MudTabPanel>
            }
        </MudTabs>
    }
</div>

<!-- ADD QUALIFICATION DIALOG -->
<MudDialog @bind-Visible="_addQualificationOpen">
    <TitleContent>
        <MudText Typo="Typo.h6">Add Accredited Qualification (SETMIS File 500)</MudText>
    </TitleContent>
    <DialogContent>
        <MudGrid>
            <MudItem xs="12" md="4">
                <MudNumericField @bind-Value="_newQualification.SaqaQualificationId" Label="SAQA Qualification ID" Variant="Variant.Outlined" Required="true" Min="1" />
            </MudItem>
            <MudItem xs="12" md="8">
                <MudTextField @bind-Value="_newQualification.QualificationTitle" Label="Qualification Title" Variant="Variant.Outlined" Required="true" Placeholder="e.g. National Certificate: Autotronics" />
            </MudItem>
            <MudItem xs="12" md="4">
                <MudNumericField @bind-Value="_newQualification.NqfLevel" Label="NQF Level" Variant="Variant.Outlined" Min="1" Max="10" />
            </MudItem>
            <MudItem xs="12" md="4">
                <MudSelect T="string" @bind-Value="_newQualification.AccreditationStatusCode" Label="Status" Variant="Variant.Outlined">
                    <MudSelectItem Value="@("Active")">Active</MudSelectItem>
                    <MudSelectItem Value="@("Provisional")">Provisional</MudSelectItem>
                    <MudSelectItem Value="@("Expired")">Expired</MudSelectItem>
                </MudSelect>
            </MudItem>
            <MudItem xs="12" md="4">
                <MudDatePicker @bind-Date="_newQualification.ExpiryDate" Label="Scope Expiry Date" Variant="Variant.Outlined" />
            </MudItem>
        </MudGrid>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => _addQualificationOpen = false)">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SaveQualification">Save Scope</MudButton>
    </DialogActions>
</MudDialog>

<!-- ADD UNIT STANDARD DIALOG -->
<MudDialog @bind-Visible="_addUnitStandardOpen">
    <TitleContent>
        <MudText Typo="Typo.h6">Add Accredited Unit Standard (SETMIS File 501)</MudText>
    </TitleContent>
    <DialogContent>
        <MudGrid>
            <MudItem xs="12" md="4">
                <MudNumericField @bind-Value="_newUnitStandard.UnitStandardId" Label="SAQA Unit Standard ID" Variant="Variant.Outlined" Required="true" Min="1" />
            </MudItem>
            <MudItem xs="12" md="8">
                <MudTextField @bind-Value="_newUnitStandard.UnitStandardTitle" Label="Unit Standard Title" Variant="Variant.Outlined" Required="true" Placeholder="e.g. Conduct diagnostic tests on diesel engines" />
            </MudItem>
            <MudItem xs="12" md="6">
                <MudNumericField @bind-Value="_newUnitStandard.NqfLevel" Label="NQF Level" Variant="Variant.Outlined" Min="1" Max="10" />
            </MudItem>
            <MudItem xs="12" md="6">
                <MudNumericField @bind-Value="_newUnitStandard.Credits" Label="Credits" Variant="Variant.Outlined" Min="1" />
            </MudItem>
        </MudGrid>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => _addUnitStandardOpen = false)">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SaveUnitStandard">Save Unit Standard</MudButton>
    </DialogActions>
</MudDialog>

<!-- Add Campus Dialog -->
<MudDialog @bind-IsVisible="_addCampusOpen" Options="_dialogOptions">
    <TitleContent>
        <MudText Typo="Typo.h6">Add Delivery Campus / Physical Site</MudText>
    </TitleContent>
    <DialogContent>
        <MudGrid>
            <MudItem xs="12" md="8">
                <MudTextField @bind-Value="_newCampus.CampusName" Label="Campus Name" Variant="Variant.Outlined" Required="true" />
            </MudItem>
            <MudItem xs="12" md="4">
                <MudTextField @bind-Value="_newCampus.CampusCode" Label="Campus Code" Variant="Variant.Outlined" Placeholder="Auto-generated if blank" />
            </MudItem>
            <MudItem xs="12" md="6">
                <MudTextField @bind-Value="_newCampus.PhysicalAddressLine1" Label="Physical Address" Variant="Variant.Outlined" />
            </MudItem>
            <MudItem xs="12" md="3">
                <MudTextField @bind-Value="_newCampus.City" Label="City / Town" Variant="Variant.Outlined" />
            </MudItem>
            <MudItem xs="12" md="3">
                <MudTextField @bind-Value="_newCampus.ProvinceCode" Label="Province Code" Variant="Variant.Outlined" Placeholder="e.g. GP, KZN, WC" />
            </MudItem>
            <MudItem xs="12" md="6">
                <MudTextField @bind-Value="_newCampus.ContactPersonName" Label="Site Contact Person" Variant="Variant.Outlined" />
            </MudItem>
            <MudItem xs="12" md="6">
                <MudTextField @bind-Value="_newCampus.ContactPhone" Label="Site Telephone" Variant="Variant.Outlined" />
            </MudItem>
            <MudItem xs="12">
                <MudCheckBox @bind-Value="_newCampus.IsPrimarySite" Label="Set as Primary / Main Campus" Color="Color.Primary" />
            </MudItem>
        </MudGrid>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => _addCampusOpen = false)">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SaveCampus">Save Delivery Campus</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [Parameter] public int Id { get; set; }

    private TrainingProvider _provider = new();
    private List<TrainingProviderQualification> _qualifications = new();
    private List<TrainingProviderUnitStandard> _unitStandards = new();
    private List<TrainingProviderCampus> _campuses = new();
    private List<Organisation> _organisations = new();
    private List<Person> _people = new();
    private List<LookupItemDto> _providerTypes = new();
    private List<LookupItemDto> _providerStatusTypes = new();

    // 360-Degree Relational Tab Collections
    private List<ProviderLearnerDto> _enrolledLearners = new();
    private List<ProviderAssessorModeratorDto> _assessors = new();
    private List<ProviderEmployerDto> _employers = new();
    private List<ProviderAuditVisitDto> _audits = new();

    private bool _loadingCampuses = false;
    private bool _loadingLearners = false;
    private bool _loadingAssessors = false;
    private bool _loadingEmployers = false;
    private bool _loadingAudits = false;

    // In-tab Modals
    private bool _addCampusOpen = false;
    private TrainingProviderCampus _newCampus = new();
    private DialogOptions _dialogOptions = new() { MaxWidth = MaxWidth.Medium, FullWidth = true };
    private bool _addQualificationOpen = false;
    private TrainingProviderQualification _newQualification = new();

    private bool _addUnitStandardOpen = false;
    private TrainingProviderUnitStandard _newUnitStandard = new();

    private bool _loading = true;
    private bool _isSaving = false;
    private bool _isValid = false;
    private MudForm? _form;
    private string? _logoDataUri;
    private int _activeTabIndex = 0;

    private List<BreadcrumbItem> _breadcrumbItems = new();

    protected override async Task OnInitializedAsync()
    {
        _loading = true;
        SetupBreadcrumbs();

        _organisations = await OrgService.GetAllAsync();
        _people = await PersonService.GetAllAsync();
        _providerTypes = await LookupService.GetLookupItemsAsync("ProviderType");
        _providerStatusTypes = await LookupService.GetLookupItemsAsync("ProviderStatusType");

        if (Id > 0)
        {
            await LoadProviderData();
        }
        else
        {
            _provider = new TrainingProvider
            {
                ProviderTypeCode = "02",
                ProviderStatusCode = "01",
                AccreditationStartDate = DateTime.Today,
                AccreditationEndDate = DateTime.Today.AddYears(5),
                IsActive = true
            };
        }

        _loading = false;
    }

    private void SetupBreadcrumbs()
    {
        _breadcrumbItems = new List<BreadcrumbItem>
        {
            new BreadcrumbItem("Home", href: "/"),
            new BreadcrumbItem("SDP Registry", href: "/sdp"),
            new BreadcrumbItem(Id == 0 ? "New SDP" : $"SDP #{Id}", href: null, disabled: true)
        };
    }

    private async Task LoadProviderData()
    {
        var p = await ProviderService.GetByIdAsync(Id);
        if (p != null)
        {
            _provider = p;
            _qualifications = await ProviderService.GetQualificationsAsync(Id);
            _unitStandards = await ProviderService.GetUnitStandardsAsync(Id);

            _logoDataUri = await BrandAssetService.GetLogoDataUriAsync(Id, "TrainingProvider");

            // Load 360-Degree Relational Collections
            _loadingCampuses = true;
            _loadingLearners = true;
            _loadingAssessors = true;
            _loadingEmployers = true;
            _loadingAudits = true;

            _campuses = await CampusService.GetCampusesByProviderAsync(Id);
            _loadingCampuses = false;

            _enrolledLearners = await ProviderService.GetEnrolledLearnersAsync(Id);
            _loadingLearners = false;

            _assessors = await ProviderService.GetAssessorsAndModeratorsAsync(Id);
            _loadingAssessors = false;

            _employers = await ProviderService.GetParticipatingEmployersAsync(Id);
            _loadingEmployers = false;

            _audits = await ProviderService.GetAuditVisitsAsync(Id);
            _loadingAudits = false;
        }
        else
        {
            Snackbar.Add($"SDP #{Id} not found.", Severity.Error);
            NavManager.NavigateTo("/sdp");
        }
    }

    private async Task SaveProvider()
    {
        if (_form != null)
        {
            await _form.Validate();
            if (!_isValid) return;
        }

        _isSaving = true;
        try
        {
            var saved = await ProviderService.SaveAsync(_provider, "Admin");
            Snackbar.Add($"SDP '{saved.AccreditationNumber}' saved successfully with audit log.", Severity.Success);

            if (Id == 0)
            {
                NavManager.NavigateTo($"/sdp/{saved.Id}");
            }
            else
            {
                await LoadProviderData();
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error saving provider: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isSaving = false;
        }
    }

    private async Task DeleteProvider()
    {
        if (Id <= 0) return;

        try
        {
            var deleted = await ProviderService.DeleteAsync(Id, "Admin");
            if (deleted)
            {
                Snackbar.Add("SDP accreditation deleted successfully with audit confirmation.", Severity.Success);
                NavManager.NavigateTo("/sdp");
            }
            else
            {
                Snackbar.Add("Could not delete provider.", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error deleting provider: {ex.Message}", Severity.Error);
        }
    }

    private async Task RenewProviderAccreditation()
    {
        try
        {
            _provider.AccreditationEndDate = DateTime.Today.AddYears(5);
            _provider.ProviderStatusCode = "Accredited";
            _provider.IsActive = true;
            await ProviderService.SaveAsync(_provider, "Admin");
            Snackbar.Add($"SDP '{_provider.AccreditationNumber}' accreditation successfully renewed for 5 years until {_provider.AccreditationEndDate:yyyy-MM-dd}.", Severity.Success);
            await LoadProviderData();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error renewing provider accreditation: {ex.Message}", Severity.Error);
        }
    }

    private async Task UploadLogo(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file != null)
        {
            try
            {
                using var stream = file.OpenReadStream(maxAllowedSize: 5 * 1024 * 1024);
                using var ms = new MemoryStream();
                await stream.CopyToAsync(ms);
                var bytes = ms.ToArray();
                var base64 = Convert.ToBase64String(bytes);

                if (Id > 0)
                {
                    await BrandAssetService.SetProviderBrandAsync(Id, base64, "Admin");
                }
                _logoDataUri = $"data:{file.ContentType};base64,{base64}";

                Snackbar.Add("SDP logo uploaded successfully.", Severity.Success);
            }
            catch (Exception ex)
            {
                Snackbar.Add($"Error uploading logo: {ex.Message}", Severity.Error);
            }
        }
    }

    private void OpenAddQualificationDialog()
    {
        _newQualification = new TrainingProviderQualification
        {
            TrainingProviderId = Id,
            AccreditationStatusCode = "Active",
            ExpiryDate = DateTime.Today.AddYears(3)
        };
        _addQualificationOpen = true;
    }

    private async Task SaveQualification()
    {
        if (_newQualification.SaqaQualificationId <= 0 || string.IsNullOrWhiteSpace(_newQualification.QualificationTitle))
        {
            Snackbar.Add("SAQA ID and Qualification Title are mandatory.", Severity.Warning);
            return;
        }

        try
        {
            _newQualification.TrainingProviderId = Id;
            await ProviderService.AddQualificationAsync(Id, _newQualification, "Admin");
            Snackbar.Add($"Qualification '{_newQualification.QualificationTitle}' added to scope.", Severity.Success);
            _addQualificationOpen = false;
            _qualifications = await ProviderService.GetQualificationsAsync(Id);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error adding qualification: {ex.Message}", Severity.Error);
        }
    }

    private async Task RemoveQualification(int qualId)
    {
        try
        {
            var ok = await ProviderService.RemoveQualificationAsync(qualId, "Admin");
            if (ok)
            {
                Snackbar.Add("Qualification removed from accreditation scope.", Severity.Success);
                _qualifications = await ProviderService.GetQualificationsAsync(Id);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error removing qualification: {ex.Message}", Severity.Error);
        }
    }

    private void OpenAddUnitStandardDialog()
    {
        _newUnitStandard = new TrainingProviderUnitStandard
        {
            TrainingProviderId = Id,
            NqfLevel = 4,
            Credits = 10
        };
        _addUnitStandardOpen = true;
    }

    private async Task SaveUnitStandard()
    {
        if (_newUnitStandard.UnitStandardId <= 0 || string.IsNullOrWhiteSpace(_newUnitStandard.UnitStandardTitle))
        {
            Snackbar.Add("Unit Standard ID and Title are mandatory.", Severity.Warning);
            return;
        }

        try
        {
            _newUnitStandard.TrainingProviderId = Id;
            await ProviderService.AddUnitStandardAsync(Id, _newUnitStandard, "Admin");
            Snackbar.Add($"Unit standard '{_newUnitStandard.UnitStandardTitle}' added to scope.", Severity.Success);
            _addUnitStandardOpen = false;
            _unitStandards = await ProviderService.GetUnitStandardsAsync(Id);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error adding unit standard: {ex.Message}", Severity.Error);
        }
    }

    private async Task RemoveUnitStandard(int usId)
    {
        try
        {
            var ok = await ProviderService.RemoveUnitStandardAsync(usId, "Admin");
            if (ok)
            {
                Snackbar.Add("Unit standard removed from accreditation scope.", Severity.Success);
                _unitStandards = await ProviderService.GetUnitStandardsAsync(Id);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error removing unit standard: {ex.Message}", Severity.Error);
        }
    }

    private void OpenAddCampusDialog()
    {
        _newCampus = new TrainingProviderCampus
        {
            TrainingProviderId = Id,
            Status = "Active"
        };
        _addCampusOpen = true;
    }

    private async Task SaveCampus()
    {
        if (string.IsNullOrWhiteSpace(_newCampus.CampusName))
        {
            Snackbar.Add("Campus Name is required.", Severity.Warning);
            return;
        }

        try
        {
            _newCampus.TrainingProviderId = Id;
            await CampusService.AddCampusAsync(_newCampus, "Admin");
            Snackbar.Add($"Delivery campus '{_newCampus.CampusName}' added successfully.", Severity.Success);
            _addCampusOpen = false;
            _campuses = await CampusService.GetCampusesByProviderAsync(Id);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error adding campus: {ex.Message}", Severity.Error);
        }
    }

    private async Task DeleteCampus(int campusId)
    {
        try
        {
            var ok = await CampusService.DeleteCampusAsync(campusId, "Admin");
            if (ok)
            {
                Snackbar.Add("Delivery campus deleted successfully.", Severity.Success);
                _campuses = await CampusService.GetCampusesByProviderAsync(Id);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error deleting campus: {ex.Message}", Severity.Error);
        }
    }

    private void BackToList() => NavManager.NavigateTo("/sdp");

    private Task OnWorkflowStatusChanged(string newStatus)
    {
        _provider.ProviderStatusCode = newStatus;
        return LoadProviderData();
    }

    private static Color GetStatusColor(string? status) => status switch
    {
        "01" or "Accredited" or "Active" or "Completed" => Color.Success,
        "02" or "Provisional" or "InProgress" => Color.Info,
        "03" or "Suspended" or "Expired" => Color.Warning,
        "De-accredited" or "Terminated" => Color.Error,
        _ => Color.Default
    };
}
