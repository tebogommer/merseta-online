@page "/governance/declarations"
@namespace Nsdms.Web.Components.Pages.Governance
@using Microsoft.AspNetCore.Authorization
@using MudBlazor
@using Nsdms.Domain.Entities
@using Nsdms.Application.Common.Interfaces
@attribute [Authorize(Roles = "SuperAdmin,Admin,Executive,Compliance,InternalAudit,RiskManager,ReviewCommittee")]
@inject IConflictManagementService ConflictService
@inject NavigationManager Nav
@inject ISnackbar Snackbar

<main id="main-content" style="max-width: 1600px; margin: 0 auto; width: 100%;">
    <EntityHeader Title="Declarations of Interest (e-DOI) Register"
                  Subtitle="Statutory register of annual and transactional conflict disclosures under PFMA Section 50/51 and King IV"
                  BreadcrumbItems="_breadcrumbs">
        <Actions>
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.PostAdd"
                       Href="/governance/declarations/submit">
                File new declaration
            </MudButton>
        </Actions>
    </EntityHeader>

    <DataGridShell TItem="InterestDeclaration"
                   Items="_declarations"
                   IsLoading="_isLoading"
                   SearchPlaceholder="Search by declarant name, period year, or seal..."
                   QuickFilter="FilterDeclaration">
        <ChildContent>
            <MudTable Items="_declarations" Hover="true" Dense="true" Elevation="0" Breakpoint="Breakpoint.Sm" Class="border-default">
                <HeaderContent>
                    <MudTh>Reference</MudTh>
                    <MudTh>Declaring Individual</MudTh>
                    <MudTh>Compliance Year</MudTh>
                    <MudTh>Declaration Type</MudTh>
                    <MudTh>Conflicts Declared</MudTh>
                    <MudTh>Digital Security Seal</MudTh>
                    <MudTh>Status</MudTh>
                    <MudTh Style="text-align:right">Action</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Reference">
                        <MudLink Href="@($"/governance/declarations/{context.Id}")" Underline="Underline.Hover">
                            <span class="font-mono font-weight-bold" style="color: var(--mud-palette-primary);">
                                DOI-@context.Id.ToString("D5")
                            </span>
                        </MudLink>
                    </MudTd>
                    <MudTd DataLabel="Declaring Individual">
                        <div>
                            <div class="font-weight-bold">@(context.Person?.FullName ?? "N/A")</div>
                            <div class="font-mono text-secondary" style="font-size: 0.75rem;">
                                @(context.Person?.RsaIdNumber ?? context.Person?.PassportNumber ?? "")
                            </div>
                        </div>
                    </MudTd>
                    <MudTd DataLabel="Compliance Year">
                        <span class="font-mono font-weight-bold">@context.DeclarationPeriodYear</span>
                    </MudTd>
                    <MudTd DataLabel="Declaration Type">
                        <span style="font-size: 0.8125rem;">@FormatDeclarationType(context.DeclarationTypeCode)</span>
                    </MudTd>
                    <MudTd DataLabel="Conflicts Declared">
                        @if (context.HasConflictsToDeclare)
                        {
                            <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Filled">
                                Yes (@context.Items.Count items)
                            </MudChip>
                        }
                        else
                        {
                            <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Outlined">
                                Nil / No conflicts
                            </MudChip>
                        }
                    </MudTd>
                    <MudTd DataLabel="Digital Security Seal">
                        <span class="font-mono text-secondary" style="font-size: 0.75rem;">
                            @(context.DigitalSignatureSeal ?? "—")
                        </span>
                    </MudTd>
                    <MudTd DataLabel="Status">
                        <StatusBadge Status="@context.StatusCode" Size="Size.Small" />
                    </MudTd>
                    <MudTd Style="text-align:right" DataLabel="Action">
                        <MudButton Variant="Variant.Text"
                                   Color="Color.Primary"
                                   Size="Size.Small"
                                   StartIcon="@Icons.Material.Filled.Visibility"
                                   Href="@($"/governance/declarations/{context.Id}")">
                            View
                        </MudButton>
                    </MudTd>
                </RowTemplate>
                <PagerContent>
                    <MudTablePager PageSizeOptions="new int[] { 5, 10, 20, 50, 100, 250, 500 }" />
                </PagerContent>
            </MudTable>
        </ChildContent>
    </DataGridShell>
</main>

@code {
    private bool _isLoading = true;
    private List<InterestDeclaration> _declarations = new();

    private readonly List<BreadcrumbItem> _breadcrumbs = new()
    {
        new BreadcrumbItem("Home", href: "/"),
        new BreadcrumbItem("Governance", href: "/governance/dashboard"),
        new BreadcrumbItem("Declarations of interest", href: null, disabled: true)
    };

    protected override async Task OnInitializedAsync()
    {
        await LoadDeclarationsAsync();
    }

    private async Task LoadDeclarationsAsync()
    {
        _isLoading = true;
        try
        {
            _declarations = await ConflictService.GetDeclarationsAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error loading declarations: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isLoading = false;
        }
    }

    private bool FilterDeclaration(InterestDeclaration item, string search)
    {
        if (string.IsNullOrWhiteSpace(search)) return true;
        return (item.Person?.FirstName?.Contains(search, StringComparison.OrdinalIgnoreCase) ?? false) ||
               (item.Person?.LastName?.Contains(search, StringComparison.OrdinalIgnoreCase) ?? false) ||
               (item.DigitalSignatureSeal?.Contains(search, StringComparison.OrdinalIgnoreCase) ?? false) ||
               (item.DeclarationTypeCode?.Contains(search, StringComparison.OrdinalIgnoreCase) ?? false);
    }

    private string FormatDeclarationType(string code) => code switch
    {
        "ANNUAL_COMPLIANCE" => "Annual Fiduciary Compliance",
        "MEETING_RECUSAL" => "Committee Meeting Recusal",
        "TENDER_EVALUATION" => "Procurement / Tender Evaluation",
        "GRANT_ADJUDICATION" => "Grant Adjudication Attestation",
        _ => code
    };
}
