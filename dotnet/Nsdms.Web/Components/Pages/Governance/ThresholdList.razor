@page "/governance/thresholds"
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Web
@using MudBlazor
@using Nsdms.Application.Services
@using Nsdms.Domain.Entities
@inject IWorkflowGovernanceService GovernanceService
@inject ISnackbar Snackbar
@inject NavigationManager Navigation
@inject IDialogService DialogService

<PageTitle>Financial Delegation Matrix (DoA) | MerSETA NSDMS</PageTitle>

<!-- Sticky Top Bar -->
<MudCard Class="mb-4 sticky-top border-b" Elevation="2" Style="top: var(--mud-appbar-height, 64px); z-index: 100; background: var(--mud-palette-surface);">
    <MudCardContent Class="py-3 px-4 d-flex justify-space-between align-center">
        <div class="d-flex align-center gap-2">
            <MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Filled.ArrowBack" Color="Color.Default" OnClick='() => Navigation.NavigateTo("/finance/grants")'>Back to Finance</MudButton>
            <MudBreadcrumbs Items="_breadcrumbItems" Class="pa-0 ma-0" />
        </div>
        <div class="d-flex align-center gap-2">
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Add"
                       OnClick="OpenCreateThresholdDialog">
                Add Approval Tier
            </MudButton>
        </div>
    </MudCardContent>
</MudCard>

<!-- Main Card -->
<MudCard Elevation="3" Class="rounded-lg">
    <MudCardHeader Class="pb-2">
        <CardHeaderAvatar>
            <MudAvatar Color="Color.Tertiary" Variant="Variant.Filled">
                <MudIcon Icon="@Icons.Material.Filled.AccountBalance" />
            </MudAvatar>
        </CardHeaderAvatar>
        <CardHeaderContent>
            <MudText Typo="Typo.h6">Financial Delegation of Authority Matrix (DoA)</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">
                Statutory approval limits, financial caps, and board escalation thresholds (PFMA Section 54 Governance)
            </MudText>
        </CardHeaderContent>
        <CardHeaderActions>
            <MudChip T="string" Color="Color.Success" Variant="Variant.Outlined" Size="Size.Small" Icon="@Icons.Material.Filled.Verified">
                Dynamic Policy Enforced
            </MudChip>
        </CardHeaderActions>
    </MudCardHeader>

    <MudCardContent>
        <MudTable Items="@_thresholds"
                  Hover="true"
                  Striped="true"
                  Loading="@_loading"
                  Elevation="0"
                  T="FinancialApprovalThreshold">
            <HeaderContent>
                <MudTh>Threshold Ref</MudTh>
                <MudTh>Role</MudTh>
                <MudTh>Module</MudTh>
                <MudTh>Approval Tier / Level</MudTh>
                <MudTh Style="text-align: right;">Max Approval Limit (ZAR)</MudTh>
                <MudTh>Board Escalation</MudTh>
                <MudTh>Description / Scope</MudTh>
                <MudTh>Status</MudTh>
                <MudTh Style="text-align: right;">Actions</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Threshold Ref">
                    <MudText Typo="Typo.body2" Class="fw-bold font-monospace">TH-@context.Id.ToString("D4")</MudText>
                </MudTd>
                <MudTd DataLabel="Role">
                    <MudChip T="string" Color="Color.Primary" Variant="Variant.Filled" Size="Size.Small">
                        @context.RoleName
                    </MudChip>
                </MudTd>
                <MudTd DataLabel="Module">
                    <MudText Typo="Typo.body2" Class="fw-bold">@context.ModuleCode</MudText>
                </MudTd>
                <MudTd DataLabel="Tier">
                    <MudText Typo="Typo.body2">@context.ApprovalLevelName</MudText>
                </MudTd>
                <MudTd DataLabel="Max Limit" Style="text-align: right;">
                    <MudText Typo="Typo.body2" Class="fw-bold" Color="Color.Success">
                        R @context.MaxApprovalAmount.ToString("N2")
                    </MudText>
                </MudTd>
                <MudTd DataLabel="Board Escalation">
                    @if (context.RequiresBoardApproval)
                    {
                        <MudChip T="string" Color="Color.Error" Size="Size.Small" Icon="@Icons.Material.Filled.Gavel">
                            Board Ratification Required
                        </MudChip>
                    }
                    else
                    {
                        <MudChip T="string" Color="Color.Default" Size="Size.Small">
                            Executive Authority
                        </MudChip>
                    }
                </MudTd>
                <MudTd DataLabel="Description">
                    <MudText Typo="Typo.caption">@context.Description</MudText>
                </MudTd>
                <MudTd DataLabel="Status">
                    @if (context.IsActive)
                    {
                        <MudChip T="string" Color="Color.Success" Size="Size.Small">Active</MudChip>
                    }
                    else
                    {
                        <MudChip T="string" Color="Color.Default" Size="Size.Small">Disabled</MudChip>
                    }
                </MudTd>
                <MudTd DataLabel="Actions" Style="text-align: right;">
                    <MudTooltip Text="Edit Approval Tier">
                        <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                       Size="Size.Medium"
                                       Color="Color.Primary"
                                       aria-label="@($"Edit Approval Tier for {context.RoleName}")"
                                       Title="Edit Approval Tier"
                                       OnClick="() => OpenEditThresholdDialog(context)" />
                    </MudTooltip>
                </MudTd>
            </RowTemplate>
            <NoRecordsContent>
                <EmptyStateCard Icon="@Icons.Material.Outlined.AccountBalance"
                                Title="No Financial Thresholds Found"
                                Description="No financial approval limits are currently defined. Add statutory limits and approval tiers to enforce PFMA Section 54 compliance."
                                ActionText="Add Approval Tier"
                                OnActionClick="OpenCreateThresholdDialog" />
            </NoRecordsContent>
        </MudTable>
    </MudCardContent>
</MudCard>

<!-- Edit / Create Dialog -->
<MudDialog @bind-Visible="_dialogVisible" Options="_dialogOptions">
    <TitleContent>
        <MudText Typo="Typo.h6">@(_editingThreshold.Id == 0 ? "Add Financial Approval Tier" : "Edit Financial Approval Tier")</MudText>
    </TitleContent>
    <DialogContent>
        <MudGrid Spacing="2">
            <MudItem xs="12" md="6">
                <MudTextField @bind-Value="_editingThreshold.RoleName" Label="Target Role Name *" Required="true" />
            </MudItem>
            <MudItem xs="12" md="6">
                <MudTextField @bind-Value="_editingThreshold.ModuleCode" Label="Workflow Module *" Required="true" />
            </MudItem>
            <MudItem xs="12" md="6">
                <MudTextField @bind-Value="_editingThreshold.ApprovalLevelName" Label="Approval Tier Name *" Required="true" />
            </MudItem>
            <MudItem xs="12" md="6">
                <MudNumericField @bind-Value="_editingThreshold.MaxApprovalAmount" Label="Max Approval Amount (ZAR) *" Format="N2" Required="true" />
            </MudItem>
            <MudItem xs="12">
                <MudCheckBox T="bool" @bind-Value="_editingThreshold.RequiresBoardApproval" Label="Requires Board Ratification (> R5,000,000 threshold)" Color="Color.Error" />
            </MudItem>
            <MudItem xs="12">
                <MudTextField @bind-Value="_editingThreshold.Description" Label="Statutory Description" Lines="2" />
            </MudItem>
            <MudItem xs="12">
                <MudSwitch @bind-Value="_editingThreshold.IsActive" Label="Active Policy Tier" Color="Color.Success" />
            </MudItem>
        </MudGrid>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="() => _dialogVisible = false">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SaveThresholdAsync">Save Threshold</MudButton>
    </DialogActions>
</MudDialog>

@code {
    private bool _loading = true;
    private List<FinancialApprovalThreshold> _thresholds = new();
    private bool _dialogVisible = false;
    private FinancialApprovalThreshold _editingThreshold = new();

    private DialogOptions _dialogOptions = new() { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseButton = true };

    private List<BreadcrumbItem> _breadcrumbItems = new()
    {
        new BreadcrumbItem("Home", href: "/"),
        new BreadcrumbItem("Governance", href: "#"),
        new BreadcrumbItem("Financial DoA", href: null, disabled: true)
    };

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        _loading = true;
        try
        {
            _thresholds = await GovernanceService.GetAllFinancialThresholdsAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error loading financial thresholds: {ex.Message}", Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private void OpenCreateThresholdDialog()
    {
        _editingThreshold = new FinancialApprovalThreshold
        {
            RoleName = "Manager",
            ModuleCode = "Grants",
            ApprovalLevelName = "Level 2 - Senior Manager",
            MaxApprovalAmount = 1000000m,
            IsActive = true
        };
        _dialogVisible = true;
    }

    private void OpenEditThresholdDialog(FinancialApprovalThreshold item)
    {
        _editingThreshold = new FinancialApprovalThreshold
        {
            Id = item.Id,
            RoleName = item.RoleName,
            ModuleCode = item.ModuleCode,
            ApprovalLevelName = item.ApprovalLevelName,
            MaxApprovalAmount = item.MaxApprovalAmount,
            RequiresBoardApproval = item.RequiresBoardApproval,
            Description = item.Description,
            IsActive = item.IsActive
        };
        _dialogVisible = true;
    }

    private async Task SaveThresholdAsync()
    {
        if (string.IsNullOrWhiteSpace(_editingThreshold.RoleName) || string.IsNullOrWhiteSpace(_editingThreshold.ModuleCode))
        {
            Snackbar.Add("Role and Module are required.", Severity.Warning);
            return;
        }

        try
        {
            await GovernanceService.SaveFinancialThresholdAsync(_editingThreshold, "Governance Officer");
            _dialogVisible = false;
            Snackbar.Add("Financial threshold policy saved successfully.", Severity.Success);
            await LoadDataAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error saving threshold: {ex.Message}", Severity.Error);
        }
    }
}
