@page "/organisations/{Id:int}/governance"
@page "/employers/{Id:int}/governance"
@namespace Nsdms.Web.Components.Pages.Governance
@using Microsoft.AspNetCore.Authorization
@using MudBlazor
@using Nsdms.Domain.Entities
@using Nsdms.Application.Common.Interfaces
@attribute [Authorize(Roles = "SuperAdmin,Admin,Executive,Compliance,InternalAudit,RiskManager,ReviewCommittee")]
@inject IConflictManagementService ConflictService
@inject IOrganisationService OrganisationService
@inject IDialogService DialogService
@inject NavigationManager Nav
@inject ISnackbar Snackbar

<main id="main-content" style="max-width: 1600px; margin: 0 auto; width: 100%;">
    @if (_isLoading)
    {
        <div class="pa-8 text-center">
            <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Large" />
            <MudText Typo="Typo.body2" Class="mt-2 text-secondary">Loading organisation governance register...</MudText>
        </div>
    }
    else if (_organisation == null)
    {
        <EmptyState Title="Organisation not found"
                    Description="The requested organisation record could not be found."
                    Icon="@Icons.Material.Filled.Business" />
    }
    else
    {
        <EntityHeader Title="@($"{_organisation.CompanyName} — Governance &amp; Conflict Management")"
                      Reference="@_organisation.SdlNumber"
                      Subtitle="Legal Directors, Beneficial Shareholders, and PFMA Section 50/51 Compliance"
                      BreadcrumbItems="_breadcrumbs">
            <Actions>
                <MudButton Variant="Variant.Outlined"
                           Color="Color.Default"
                           StartIcon="@Icons.Material.Filled.ArrowBack"
                           Href="@($"/employers/{Id}")">
                    Back to organisation
                </MudButton>
                <MudButton Variant="Variant.Outlined"
                           Color="Color.Secondary"
                           StartIcon="@Icons.Material.Filled.FindReplace"
                           OnClick="RunConflictEvaluationAsync">
                    Run conflict scan
                </MudButton>
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.PersonAdd"
                           OnClick="OpenAddMemberDialogAsync">
                    Capture director / shareholder
                </MudButton>
            </Actions>
        </EntityHeader>

        <!-- Compliance Banner -->
        @if (_compliance != null && !_compliance.IsCompliant)
        {
            <MudAlert Severity="Severity.Warning" Variant="Variant.Filled" Class="mb-4">
                <strong>Governance Disclosure Incomplete:</strong>
                <ul class="mt-1 pl-4">
                    @foreach (var v in _compliance.Violations)
                    {
                        <li>@v</li>
                    }
                </ul>
            </MudAlert>
        }
        else
        {
            <MudAlert Severity="Severity.Success" Variant="Variant.Outlined" Class="mb-4">
                <strong>Governance Compliant:</strong> Organisation satisfies director requirements and beneficial shareholding disclosure thresholds (>= @_compliance?.MinimumThresholdPercentEnforced.ToString("F1")%).
            </MudAlert>
        }

        <MudTabs Elevation="0" Rounded="true" ApplyEffectsToContainer="true" PanelClass="pa-4 border rounded-b-lg" Color="Color.Surface">
            <!-- Tab 1: Directors & Shareholders -->
            <MudTabPanel Text="Directors &amp; beneficial shareholders" Icon="@Icons.Material.Filled.PeopleAlt" BadgeData="@_members.Count" BadgeColor="Color.Primary">
                <div class="d-flex justify-space-between align-center mb-4">
                    <div>
                        <MudText Typo="Typo.h6">Corporate Governance Register</MudText>
                        <MudText Typo="Typo.caption" Class="text-secondary">
                            Total Declared Equity: @_members.Sum(m => m.ShareholdingPercentage).ToString("F2")% across @_members.Count(m => m.ShareholdingPercentage > 0) shareholders.
                        </MudText>
                    </div>
                </div>

                @if (_members.Count == 0)
                {
                    <EmptyState Title="No governance members captured"
                                Description="Please capture legal directors and beneficial shareholders holding >= 5% equity."
                                Icon="@Icons.Material.Filled.PersonOff" />
                }
                else
                {
                    <MudTable Items="_members" Dense="true" Hover="true" Elevation="0">
                        <HeaderContent>
                            <MudTh>Full name</MudTh>
                            <MudTh>RSA ID / Passport</MudTh>
                            <MudTh>Governance role</MudTh>
                            <MudTh>Equity share (%)</MudTh>
                            <MudTh>Voting rights</MudTh>
                            <MudTh>CIPC verified</MudTh>
                            <MudTh>Appointment date</MudTh>
                            <MudTh>Standing</MudTh>
                            <MudTh Style="text-align: right;">Actions</MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd DataLabel="Full name">
                                <strong>@(context.Person?.FullName ?? "N/A")</strong>
                            </MudTd>
                            <MudTd DataLabel="RSA ID / Passport">
                                <span class="font-mono">@(context.Person?.RsaIdNumber ?? context.Person?.PassportNumber ?? "—")</span>
                            </MudTd>
                            <MudTd DataLabel="Governance role">
                                <MudChip T="string" Size="Size.Small" Color="Color.Default" Variant="Variant.Outlined">
                                    @context.GovernanceRoleCode
                                </MudChip>
                            </MudTd>
                            <MudTd DataLabel="Equity share (%)">
                                <span class="font-mono font-weight-bold">@context.ShareholdingPercentage.ToString("F2")%</span>
                            </MudTd>
                            <MudTd DataLabel="Voting rights">
                                @(context.HasVotingRights ? "Yes" : "No")
                            </MudTd>
                            <MudTd DataLabel="CIPC verified">
                                @if (context.CipcRegistered)
                                {
                                    <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Filled">Verified</MudChip>
                                }
                                else
                                {
                                    <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Outlined">Unverified</MudChip>
                                }
                            </MudTd>
                            <MudTd DataLabel="Appointment date">
                                <span class="font-mono" style="font-size: 0.8125rem;">
                                    @(context.AppointmentDate.HasValue ? context.AppointmentDate.Value.ToString("yyyy-MM-dd") : "—")
                                </span>
                            </MudTd>
                            <MudTd DataLabel="Standing">
                                <StatusBadge Status="@(context.IsActive ? "ACTIVE" : "INACTIVE")" Size="Size.Small" />
                            </MudTd>
                            <MudTd DataLabel="Actions" Style="text-align: right;">
                                <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                               Size="Size.Small"
                                               Color="Color.Primary"
                                               OnClick="@(() => OpenEditMemberDialogAsync(context))"
                                               aria-label="Edit member" />
                                <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                               Size="Size.Small"
                                               Color="Color.Error"
                                               OnClick="@(() => DeleteMemberAsync(context))"
                                               aria-label="Delete member" />
                            </MudTd>
                        </RowTemplate>
                    </MudTable>
                }
            </MudTabPanel>

            <!-- Tab 2: Active Conflicts -->
            <MudTabPanel Text="Conflict flags" Icon="@Icons.Material.Filled.Flag" BadgeData="@_flags.Count" BadgeColor="Color.Error">
                <div class="mb-4">
                    <MudText Typo="Typo.h6">Active Conflict of Interest Flags</MudText>
                </div>

                @if (_flags.Count == 0)
                {
                    <EmptyState Title="Zero active conflicts"
                                Description="No conflict of interest flags are currently active against this organisation."
                                Icon="@Icons.Material.Filled.CheckCircle" />
                }
                else
                {
                    <MudTable Items="_flags" Dense="true" Hover="true" Elevation="0">
                        <HeaderContent>
                            <MudTh>Reference</MudTh>
                            <MudTh>Severity</MudTh>
                            <MudTh>Category</MudTh>
                            <MudTh>Title</MudTh>
                            <MudTh>Implicated person</MudTh>
                            <MudTh>Status</MudTh>
                            <MudTh Style="text-align: right;">Action</MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd DataLabel="Reference">
                                <span class="font-mono font-weight-bold">FLG-@context.Id.ToString("D5")</span>
                            </MudTd>
                            <MudTd DataLabel="Severity">
                                <MudChip T="string" Size="Size.Small" Color="@GetSeverityColor(context.SeverityCode)" Variant="Variant.Filled">
                                    @context.SeverityCode
                                </MudChip>
                            </MudTd>
                            <MudTd DataLabel="Category">@context.ConflictCategoryCode</MudTd>
                            <MudTd DataLabel="Title">@context.Title</MudTd>
                            <MudTd DataLabel="Implicated person">@(context.Person?.FullName ?? "N/A")</MudTd>
                            <MudTd DataLabel="Status">
                                <StatusBadge Status="@context.ResolutionStatusCode" Size="Size.Small" />
                            </MudTd>
                            <MudTd DataLabel="Action" Style="text-align: right;">
                                <MudButton Variant="Variant.Text"
                                           Color="Color.Primary"
                                           Size="Size.Small"
                                           StartIcon="@Icons.Material.Filled.OpenInNew"
                                           Href="@($"/admin/governance/conflicts/{context.Id}")">
                                    Investigate
                                </MudButton>
                            </MudTd>
                        </RowTemplate>
                    </MudTable>
                }
            </MudTabPanel>
        </MudTabs>
    }
</main>

@code {
    [Parameter] public int Id { get; set; }
    private bool _isLoading = true;
    private Organisation? _organisation;
    private List<OrganisationGovernanceMember> _members = new();
    private List<ConflictFlag> _flags = new();
    private GovernanceValidationResult? _compliance;

    private List<BreadcrumbItem> _breadcrumbs = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        _isLoading = true;
        try
        {
            _organisation = await OrganisationService.GetByIdAsync(Id);
            if (_organisation != null)
            {
                _members = await ConflictService.GetGovernanceMembersAsync(Id);
                _flags = await ConflictService.GetConflictFlagsAsync(organisationId: Id);
                _compliance = await ConflictService.ValidateOrganisationGovernanceComplianceAsync(Id);

                _breadcrumbs = new()
                {
                    new BreadcrumbItem("Home", href: "/"),
                    new BreadcrumbItem("Organisations", href: "/employers"),
                    new BreadcrumbItem(_organisation.CompanyName, href: $"/employers/{Id}"),
                    new BreadcrumbItem("Governance & Conflicts", href: null, disabled: true)
                };
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error loading governance details: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task RunConflictEvaluationAsync()
    {
        try
        {
            var newFlags = await ConflictService.EvaluateOrganisationConflictsAsync(Id, "GovernanceOfficer");
            Snackbar.Add($"Conflict scan completed. {newFlags.Count} new flag(s) identified.", Severity.Info);
            await LoadDataAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error running conflict evaluation: {ex.Message}", Severity.Error);
        }
    }

    private async Task OpenAddMemberDialogAsync()
    {
        var parameters = new DialogParameters<AddGovernanceMemberDialog>
        {
            { x => x.Member, new OrganisationGovernanceMember { OrganisationId = Id } },
            { x => x.CurrentUsername, "GovernanceOfficer" }
        };

        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Medium, FullWidth = true };
        var dialog = await DialogService.ShowAsync<AddGovernanceMemberDialog>("Capture Director / Shareholder", parameters, options);
        var result = await dialog.Result;

        if (result != null && !result.Canceled)
        {
            await LoadDataAsync();
        }
    }

    private async Task OpenEditMemberDialogAsync(OrganisationGovernanceMember member)
    {
        var parameters = new DialogParameters<AddGovernanceMemberDialog>
        {
            { x => x.Member, member },
            { x => x.CurrentUsername, "GovernanceOfficer" }
        };

        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Medium, FullWidth = true };
        var dialog = await DialogService.ShowAsync<AddGovernanceMemberDialog>("Edit Director / Shareholder", parameters, options);
        var result = await dialog.Result;

        if (result != null && !result.Canceled)
        {
            await LoadDataAsync();
        }
    }

    private async Task DeleteMemberAsync(OrganisationGovernanceMember member)
    {
        var confirm = await DialogService.ShowMessageBoxAsync(
            "Confirm Removal",
            $"Are you sure you want to remove {member.Person?.FullName} ({member.GovernanceRoleCode}) from this organisation?",
            yesText: "Remove", cancelText: "Cancel");

        if (confirm == true)
        {
            await ConflictService.DeleteGovernanceMemberAsync(member.Id, "GovernanceOfficer");
            Snackbar.Add("Governance member removed.", Severity.Info);
            await LoadDataAsync();
        }
    }

    private Color GetSeverityColor(string code) => code switch
    {
        "RED_CRITICAL" => Color.Error,
        "AMBER_ELEVATED" => Color.Warning,
        _ => Color.Info
    };
}
