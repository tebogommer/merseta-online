@page "/governance/dashboard"
@namespace Nsdms.Web.Components.Pages.Governance
@using Microsoft.AspNetCore.Authorization
@using MudBlazor
@using Nsdms.Domain.Entities
@using Nsdms.Application.Common.Interfaces
@attribute [Authorize(Roles = "SuperAdmin,Admin,Executive,Compliance,InternalAudit,RiskManager,ReviewCommittee")]
@inject IConflictManagementService ConflictService
@inject NavigationManager Nav
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<main id="main-content" style="max-width: 1600px; margin: 0 auto; width: 100%;">
    <EntityHeader Title="Interest &amp; Conflict Governance Dashboard"
                  Subtitle="PFMA Section 50/51 Fiduciary Compliance, Insider Recusal &amp; Anti-Syndication Monitoring"
                  BreadcrumbItems="_breadcrumbs">
        <Actions>
            <MudButton Variant="Variant.Outlined"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Refresh"
                       OnClick="RefreshDashboardAsync">
                Refresh metrics
            </MudButton>
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.FactCheck"
                       Href="/admin/governance/conflicts">
                View conflict work queue
            </MudButton>
        </Actions>
    </EntityHeader>

    @if (_isLoading)
    {
        <div class="pa-8 text-center">
            <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Large" />
            <MudText Typo="Typo.body2" Class="mt-2 text-secondary">Computing conflict graph and exposure metrics...</MudText>
        </div>
    }
    else if (_metrics != null)
    {
        <!-- 4 Executive KPI Cards -->
        <MudGrid Class="mb-6">
            <StatCard Title="Critical insider conflicts"
                      Value="@_metrics.RedCriticalCount.ToString()"
                      Icon="@Icons.Material.Filled.Warning"
                      Context="Staff/Board direct beneficial interest"
                      Class="border-error" />

            <StatCard Title="Multi-entity grant syndicates"
                      Value="@_metrics.MultiEntitySyndicateCount.ToString()"
                      Icon="@Icons.Material.Filled.Hub"
                      Context="Individuals linked to >=2 grant applicants"
                      Class="border-warning" />

            <StatCard Title="Total active flags"
                      Value="@_metrics.TotalActiveFlags.ToString()"
                      Icon="@Icons.Material.Filled.Flag"
                      Context="@($"{_metrics.ClearedFlagsCount} conflicts cleared/justified")" />

            <StatCard Title="Outstanding annual declarations"
                      Value="@_metrics.OutstandingDeclarationsCount.ToString()"
                      Icon="@Icons.Material.Filled.AssignmentLate"
                      Context="King IV &amp; PFMA compliance filings" />
        </MudGrid>

        <!-- Executive Navigation Tabs -->
        <MudTabs Elevation="0" Rounded="true" ApplyEffectsToContainer="true" PanelClass="pa-4 border rounded-b-lg" Color="Color.Surface">
            <!-- Tab 1: Active Conflicts & Flags -->
            <MudTabPanel Text="Active conflicts &amp; flags" Icon="@Icons.Material.Filled.WarningAmber" BadgeData="@_metrics.TotalActiveFlags" BadgeColor="Color.Error">
                <div class="d-flex justify-space-between align-center mb-4 flex-wrap gap-2">
                    <MudText Typo="Typo.h6">Active conflict incidents</MudText>
                    <div class="d-flex gap-2">
                        <MudChip T="string" Color="Color.Error" Variant="Variant.Outlined" Size="Size.Small">
                            @_metrics.RedCriticalCount Critical
                        </MudChip>
                        <MudChip T="string" Color="Color.Warning" Variant="Variant.Outlined" Size="Size.Small">
                            @_metrics.AmberElevatedCount Elevated
                        </MudChip>
                        <MudChip T="string" Color="Color.Info" Variant="Variant.Outlined" Size="Size.Small">
                            @_metrics.YellowAdvisoryCount Advisory
                        </MudChip>
                    </div>
                </div>

                @if (_metrics.RecentFlags.Count == 0)
                {
                    <EmptyState Title="No active conflicts detected"
                                Description="All corporate governance members, shareholders, and institutional insiders currently comply with PFMA guidelines."
                                Icon="@Icons.Material.Filled.CheckCircle" />
                }
                else
                {
                    <MudTable Items="_metrics.RecentFlags" Hover="true" Dense="true" Elevation="0">
                        <HeaderContent>
                            <MudTh>Reference</MudTh>
                            <MudTh>Severity</MudTh>
                            <MudTh>Category</MudTh>
                            <MudTh>Incident title</MudTh>
                            <MudTh>Implicated person</MudTh>
                            <MudTh>Organisation</MudTh>
                            <MudTh>Status</MudTh>
                            <MudTh Style="text-align: right;">Action</MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd DataLabel="Reference">
                                <span class="font-mono font-weight-bold">FLG-@context.Id.ToString("D5")</span>
                            </MudTd>
                            <MudTd DataLabel="Severity">
                                <MudChip T="string" Size="Size.Small" Color="@GetSeverityColor(context.SeverityCode)" Variant="Variant.Filled">
                                    @FormatSeverity(context.SeverityCode)
                                </MudChip>
                            </MudTd>
                            <MudTd DataLabel="Category">
                                <span style="font-size: 0.8125rem;">@FormatCategory(context.ConflictCategoryCode)</span>
                            </MudTd>
                            <MudTd DataLabel="Incident title">
                                <span class="font-weight-medium">@context.Title</span>
                            </MudTd>
                            <MudTd DataLabel="Implicated person">
                                @(context.Person?.FullName ?? "N/A")
                            </MudTd>
                            <MudTd DataLabel="Organisation">
                                @(context.TargetOrganisation?.CompanyName ?? "N/A")
                            </MudTd>
                            <MudTd DataLabel="Status">
                                <StatusBadge Status="@context.ResolutionStatusCode" Size="Size.Small" />
                            </MudTd>
                            <MudTd DataLabel="Action" Style="text-align: right;">
                                <MudButton Variant="Variant.Text"
                                           Color="Color.Primary"
                                           Size="Size.Small"
                                           StartIcon="@Icons.Material.Filled.OpenInNew"
                                           Href="@($"/admin/governance/conflicts/{context.Id}")">
                                    View detail
                                </MudButton>
                            </MudTd>
                        </RowTemplate>
                    </MudTable>
                }
            </MudTabPanel>

            <!-- Tab 2: Cross-Entity Director Network (Syndicate Detection) -->
            <MudTabPanel Text="Cross-entity director network (Syndicate analysis)" Icon="@Icons.Material.Filled.Hub" BadgeData="@_metrics.MultiEntitySyndicateCount" BadgeColor="Color.Warning">
                <div class="mb-4">
                    <MudText Typo="Typo.h6">Multi-organisation directorships &amp; grant access</MudText>
                    <MudText Typo="Typo.body2" Class="text-secondary">
                        Natural persons holding directorships, partnerships, or equity shares across two or more distinct entities applying for merSETA Discretionary Grants.
                    </MudText>
                </div>

                @if (_metrics.TopSharedDirectors.Count == 0)
                {
                    <EmptyState Title="Zero multi-entity syndicates detected"
                                Description="No common directors or shareholders currently hold overlapping grant requests across multiple organisations."
                                Icon="@Icons.Material.Filled.CheckCircle" />
                }
                else
                {
                    <MudTable Items="_metrics.TopSharedDirectors" Hover="true" Dense="true" Elevation="0">
                        <HeaderContent>
                            <MudTh>Director / Shareholder</MudTh>
                            <MudTh>Identity (RSA ID)</MudTh>
                            <MudTh>Linked organisations</MudTh>
                            <MudTh>Active grant applications</MudTh>
                            <MudTh>Total requested allocation</MudTh>
                            <MudTh>Associated corporate entities</MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd DataLabel="Director / Shareholder">
                                <div class="font-weight-bold">@context.FullName</div>
                            </MudTd>
                            <MudTd DataLabel="Identity (RSA ID)">
                                <span class="font-mono">@context.RsaIdNumber</span>
                            </MudTd>
                            <MudTd DataLabel="Linked organisations">
                                <MudChip T="string" Color="Color.Warning" Size="Size.Small" Variant="Variant.Filled">
                                    @context.LinkedOrganisationCount Entities
                                </MudChip>
                            </MudTd>
                            <MudTd DataLabel="Active grant applications">
                                @context.ActiveGrantApplicationCount Applications
                            </MudTd>
                            <MudTd DataLabel="Total requested allocation">
                                <span class="font-mono font-weight-bold">@context.TotalRequestedGrantAmount.ToString("C0", new System.Globalization.CultureInfo("en-ZA"))</span>
                            </MudTd>
                            <MudTd DataLabel="Associated corporate entities">
                                <div class="d-flex flex-wrap gap-1">
                                    @foreach (var org in context.OrganisationNames)
                                    {
                                        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Default">
                                            @org
                                        </MudChip>
                                    }
                                </div>
                            </MudTd>
                        </RowTemplate>
                    </MudTable>
                }
            </MudTabPanel>

            <!-- Tab 3: Chamber Exposure -->
            <MudTabPanel Text="Chamber exposure" Icon="@Icons.Material.Filled.PieChart">
                <div class="mb-4">
                    <MudText Typo="Typo.h6">Conflict distribution across merSETA industrial chambers</MudText>
                    <MudText Typo="Typo.body2" Class="text-secondary">
                        Monitors concentration of governance flags across Automotive, Metal, Motor, Plastics, New Tyre, and Non-Levy sectors.
                    </MudText>
                </div>

                <MudGrid>
                    @foreach (var ch in _metrics.ChamberDistribution)
                    {
                        <MudItem xs="12" sm="6" md="4">
                            <MudCard Outlined="true" Class="pa-4">
                                <div class="d-flex justify-space-between align-center">
                                    <div>
                                        <MudText Typo="Typo.subtitle1" Class="font-weight-bold">@ch.ChamberName</MudText>
                                        <MudText Typo="Typo.caption" Class="text-secondary">Chamber Code: @ch.ChamberCode</MudText>
                                    </div>
                                    <MudChip T="string" Color="Color.Primary" Variant="Variant.Filled" Size="Size.Medium">
                                        @ch.ConflictCount Active
                                    </MudChip>
                                </div>
                            </MudCard>
                        </MudItem>
                    }
                </MudGrid>
            </MudTabPanel>

            <!-- Tab 4: Statutory Configuration & Clearance Governance -->
            <MudTabPanel Text="Statutory policy &amp; clearance authority" Icon="@Icons.Material.Filled.SettingsSuggest">
                <div class="mb-4">
                    <MudText Typo="Typo.h6">Configurable governance policies &amp; clearance thresholds</MudText>
                    <MudText Typo="Typo.body2" Class="text-secondary">
                        Under South African statutory governance, clearance authority and disclosure thresholds are centrally governed via system configurations.
                    </MudText>
                </div>

                <MudGrid>
                    <MudItem xs="12" md="6">
                        <MudCard Outlined="true" Class="pa-4">
                            <MudText Typo="Typo.subtitle1" Class="font-weight-bold mb-2">
                                <MudIcon Icon="@Icons.Material.Filled.Security" Size="Size.Small" Class="mr-1" />
                                Configured clearance authority roles
                            </MudText>
                            <MudText Typo="Typo.body2" Class="mb-3 text-secondary">
                                Only personnel assigned one of the following roles are authorized to clear flagged conflicts with mandatory audited justification:
                            </MudText>
                            <div class="d-flex flex-wrap gap-2">
                                @foreach (var role in _metrics.ConfiguredClearanceRoles)
                                {
                                    <MudChip T="string" Color="Color.Success" Variant="Variant.Filled">
                                        @role
                                    </MudChip>
                                }
                            </div>
                        </MudCard>
                    </MudItem>

                    <MudItem xs="12" md="6">
                        <MudCard Outlined="true" Class="pa-4">
                            <MudText Typo="Typo.subtitle1" Class="font-weight-bold mb-2">
                                <MudIcon Icon="@Icons.Material.Filled.Percent" Size="Size.Small" Class="mr-1" />
                                Shareholding disclosure enforcement threshold
                            </MudText>
                            <MudText Typo="Typo.body2" Class="mb-3 text-secondary">
                                Mandatory beneficial equity disclosure is strictly enforced for grant allocations and training provider accreditation:
                            </MudText>
                            <div class="d-flex align-center gap-3">
                                <span class="font-mono text-xl font-weight-bold text-primary" style="font-size: 1.5rem;">
                                    @_metrics.ConfiguredShareholdingThresholdPercent.ToString("F1")%
                                </span>
                                <MudText Typo="Typo.body2">
                                    Any shareholder with equity >= @_metrics.ConfiguredShareholdingThresholdPercent.ToString("F1")% must be declared and verified.
                                </MudText>
                            </div>
                        </MudCard>
                    </MudItem>
                </MudGrid>
            </MudTabPanel>
        </MudTabs>
    }
</main>

@code {
    private bool _isLoading = true;
    private ConflictDashboardMetricsDto? _metrics;

    private readonly List<BreadcrumbItem> _breadcrumbs = new()
    {
        new BreadcrumbItem("Home", href: "/"),
        new BreadcrumbItem("Governance", href: "/governance/dashboard"),
        new BreadcrumbItem("Conflict dashboard", href: null, disabled: true)
    };

    protected override async Task OnInitializedAsync()
    {
        await LoadDashboardAsync();
    }

    private async Task LoadDashboardAsync()
    {
        _isLoading = true;
        try
        {
            _metrics = await ConflictService.GetDashboardMetricsAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error loading governance dashboard: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task RefreshDashboardAsync()
    {
        await LoadDashboardAsync();
        Snackbar.Add("Governance metrics refreshed.", Severity.Info);
    }

    private Color GetSeverityColor(string severity) => severity switch
    {
        "RED_CRITICAL" => Color.Error,
        "AMBER_ELEVATED" => Color.Warning,
        _ => Color.Info
    };

    private string FormatSeverity(string severity) => severity switch
    {
        "RED_CRITICAL" => "Red (Critical)",
        "AMBER_ELEVATED" => "Amber (Elevated)",
        "YELLOW_ADVISORY" => "Yellow (Advisory)",
        _ => severity
    };

    private string FormatCategory(string cat) => cat switch
    {
        "INSIDER_AFFILIATION" => "Insider Affiliation (PFMA)",
        "MULTI_ORGANISATION_GRANT_SYNDICATE" => "Multi-Organisation Grant Syndicate",
        "ACCREDITATION_GOVERNANCE_BREACH" => "Accreditation Governance Breach",
        "COMMITTEE_RECUSAL_REQUIRED" => "Committee Recusal Required",
        "OVERDUE_DECLARATION" => "Overdue Annual Declaration",
        _ => cat
    };
}
