@page "/admin/governance/conflicts/{Id:int}"
@namespace Nsdms.Web.Components.Pages.Governance
@using Microsoft.AspNetCore.Authorization
@using MudBlazor
@using Nsdms.Domain.Entities
@using Nsdms.Application.Common.Interfaces
@attribute [Authorize(Roles = "SuperAdmin,Admin,Executive,Compliance,InternalAudit,RiskManager,ReviewCommittee")]
@inject IConflictManagementService ConflictService
@inject IDialogService DialogService
@inject NavigationManager Nav
@inject ISnackbar Snackbar

<main id="main-content" style="max-width: 1600px; margin: 0 auto; width: 100%;">
    @if (_isLoading)
    {
        <div class="pa-8 text-center">
            <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Large" />
            <MudText Typo="Typo.body2" Class="mt-2 text-secondary">Loading conflict investigation dossier...</MudText>
        </div>
    }
    else if (_flag == null)
    {
        <EmptyState Title="Conflict flag not found"
                    Description="The requested conflict investigation record could not be found or has been purged."
                    Icon="@Icons.Material.Filled.SearchOff" />
    }
    else
    {
        <EntityHeader Title="@($"Conflict Incident: FLG-{_flag.Id:D5}")"
                      Reference="@($"FLG-{_flag.Id:D5}")"
                      Status="@_flag.ResolutionStatusCode"
                      Subtitle="@_flag.Title"
                      BreadcrumbItems="_breadcrumbs">
            <Actions>
                <MudButton Variant="Variant.Outlined"
                           Color="Color.Default"
                           StartIcon="@Icons.Material.Filled.ArrowBack"
                           Href="/admin/governance/conflicts">
                    Back to work queue
                </MudButton>
                @if (_flag.ResolutionStatusCode == "OPEN" || _flag.ResolutionStatusCode == "UNDER_INVESTIGATION")
                {
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.Gavel"
                               OnClick="OpenAdjudicationDialogAsync">
                        Adjudicate / Clear conflict
                    </MudButton>
                }
            </Actions>
        </EntityHeader>

        <!-- Incident Severity Banner -->
        <MudAlert Severity="@GetAlertSeverity(_flag.SeverityCode)" Variant="Variant.Filled" Class="mb-6">
            <div class="d-flex justify-space-between align-center">
                <div>
                    <strong>@FormatSeverity(_flag.SeverityCode) — @FormatCategory(_flag.ConflictCategoryCode)</strong>
                    <div class="mt-1">@_flag.Description</div>
                </div>
                <StatusBadge Status="@_flag.ResolutionStatusCode" Size="Size.Medium" />
            </div>
        </MudAlert>

        <!-- Master-Detail Tabs -->
        <MudTabs Elevation="0" Rounded="true" ApplyEffectsToContainer="true" PanelClass="pa-4 border rounded-b-lg" Color="Color.Surface">
            <!-- Tab 1: Forensic Findings & Adjudication Dossier -->
            <MudTabPanel Text="Incident findings &amp; adjudication" Icon="@Icons.Material.Filled.Description">
                <MudGrid>
                    <MudItem xs="12" md="6">
                        <MudCard Outlined="true" Class="pa-4 mb-4">
                            <MudText Typo="Typo.subtitle1" Class="font-weight-bold mb-3">Incident parameters</MudText>
                            <ReadOnlyField Label="Incident reference" Value="@($"FLG-{_flag.Id:D5}")" IsMonospace="true" />
                            <ReadOnlyField Label="Conflict category" Value="@FormatCategory(_flag.ConflictCategoryCode)" />
                            <ReadOnlyField Label="Severity rating" Value="@FormatSeverity(_flag.SeverityCode)" />
                            <ReadOnlyField Label="Detected timestamp" Value="@_flag.DetectedAt.ToString("yyyy-MM-dd HH:mm:ss UTC")" IsMonospace="true" />
                            <ReadOnlyField Label="Investigation status" Value="@_flag.ResolutionStatusCode" />
                        </MudCard>
                    </MudItem>

                    <MudItem xs="12" md="6">
                        <MudCard Outlined="true" Class="pa-4 mb-4">
                            <MudText Typo="Typo.subtitle1" Class="font-weight-bold mb-3">Adjudication &amp; Clearance verdict</MudText>
                            <ReadOnlyField Label="Current clearance standing" Value="@_flag.ResolutionStatusCode" />
                            <ReadOnlyField Label="Authorized clearance role" Value="@(_flag.ClearanceAuthorityRole ?? "Pending Adjudication")" />
                            <ReadOnlyField Label="Adjudicated by officer" Value="@(_flag.ClearedByUserId ?? "—")" />
                            <ReadOnlyField Label="Adjudication date" Value="@(_flag.ClearedAt.HasValue ? _flag.ClearedAt.Value.ToString("yyyy-MM-dd HH:mm") : "—")" />
                            <ReadOnlyField Label="Statutory resolution notes" Value="@(_flag.ResolutionNotes ?? "No formal clearance notes recorded yet.")" />
                        </MudCard>
                    </MudItem>

                    <MudItem xs="12">
                        <MudCard Outlined="true" Class="pa-4">
                            <MudText Typo="Typo.subtitle1" Class="font-weight-bold mb-2">Statutory regulatory reference</MudText>
                            <MudText Typo="Typo.body2" Class="text-secondary">
                                Evaluated in terms of Section 50(1) and Section 51(1) of the Public Finance Management Act (PFMA Act 1 of 1999), 
                                the SETA Standard Constitution (Regulation R.1399), King IV Principles on Ethical Leadership, and merSETA Discretionary Grant Guidelines.
                            </MudText>
                        </MudCard>
                    </MudItem>
                </MudGrid>
            </MudTabPanel>

            <!-- Tab 2: Implicated Parties & Network Graph -->
            <MudTabPanel Text="Implicated parties &amp; network graph" Icon="@Icons.Material.Filled.Hub">
                <MudGrid>
                    <MudItem xs="12" md="6">
                        <MudCard Outlined="true" Class="pa-4">
                            <MudText Typo="Typo.subtitle1" Class="font-weight-bold mb-3">Implicated natural person</MudText>
                            <ReadOnlyField Label="Full name" Value="@(_flag.Person?.FullName ?? "N/A")" />
                            <ReadOnlyField Label="South African National ID" Value="@(_flag.Person?.RsaIdNumber ?? "—")" IsMonospace="true" />
                            <ReadOnlyField Label="Foreign passport" Value="@(_flag.Person?.PassportNumber ?? "—")" IsMonospace="true" />
                            <ReadOnlyField Label="Primary email" Value="@(_flag.Person?.Email ?? "—")" />
                            <ReadOnlyField Label="Primary contact phone" Value="@(_flag.Person?.PhoneNumber ?? "—")" />
                        </MudCard>
                    </MudItem>

                    <MudItem xs="12" md="6">
                        <MudCard Outlined="true" Class="pa-4">
                            <MudText Typo="Typo.subtitle1" Class="font-weight-bold mb-3">Implicated organisation</MudText>
                            <ReadOnlyField Label="Company legal name" Value="@(_flag.TargetOrganisation?.CompanyName ?? "N/A")" />
                            <ReadOnlyField Label="SARS SDL levy number" Value="@(_flag.TargetOrganisation?.SdlNumber ?? "—")" IsMonospace="true" />
                            <ReadOnlyField Label="CIPC registration number" Value="@(_flag.TargetOrganisation?.RegistrationNumber ?? "—")" IsMonospace="true" />
                            <ReadOnlyField Label="Industrial chamber" Value="@(_flag.TargetOrganisation?.ChamberCode ?? "—")" />
                            <ReadOnlyField Label="Organisation status" Value="@(_flag.TargetOrganisation?.OrganisationStatusCode ?? "ACTIVE")" />
                        </MudCard>
                    </MudItem>
                </MudGrid>
            </MudTabPanel>

            <!-- Tab 3: Investigation Timeline & Audited Change Log -->
            <MudTabPanel Text="Audited change log" Icon="@Icons.Material.Filled.History">
                <div class="pa-2">
                    <MudText Typo="Typo.subtitle1" Class="font-weight-bold mb-2">Immutable governance trail</MudText>
                    <MudText Typo="Typo.body2" Class="text-secondary mb-4">
                        All detections, manual overrides, and clearance actions perform an audited change log entry with before and after state snapshots.
                    </MudText>
                    <MudTimeline TimelinePosition="TimelinePosition.Start">
                        <MudTimelineItem Color="Color.Error" Size="Size.Small">
                            <ItemContent>
                                <MudText Typo="Typo.body2" Class="font-weight-bold">Conflict incident detected by rules engine</MudText>
                                <MudText Typo="Typo.caption" Class="text-secondary">@_flag.DetectedAt.ToString("yyyy-MM-dd HH:mm:ss") by SYSTEM</MudText>
                                <MudText Typo="Typo.body2" Class="mt-1">@_flag.Title</MudText>
                            </ItemContent>
                        </MudTimelineItem>

                        @if (_flag.ClearedAt.HasValue)
                        {
                            <MudTimelineItem Color="Color.Success" Size="Size.Small">
                                <ItemContent>
                                    <MudText Typo="Typo.body2" Class="font-weight-bold">Adjudication recorded: @_flag.ResolutionStatusCode</MudText>
                                    <MudText Typo="Typo.caption" Class="text-secondary">@_flag.ClearedAt.Value.ToString("yyyy-MM-dd HH:mm:ss") by @_flag.ClearedByUserId (@_flag.ClearanceAuthorityRole)</MudText>
                                    <MudText Typo="Typo.body2" Class="mt-1">@_flag.ResolutionNotes</MudText>
                                </ItemContent>
                            </MudTimelineItem>
                        }
                    </MudTimeline>
                </div>
            </MudTabPanel>
        </MudTabs>
    }
</main>

@code {
    [Parameter] public int Id { get; set; }
    private bool _isLoading = true;
    private ConflictFlag? _flag;

    private List<BreadcrumbItem> _breadcrumbs = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadDetailAsync();
    }

    private async Task LoadDetailAsync()
    {
        _isLoading = true;
        try
        {
            _flag = await ConflictService.GetConflictFlagByIdAsync(Id);
            _breadcrumbs = new()
            {
                new BreadcrumbItem("Home", href: "/"),
                new BreadcrumbItem("Governance", href: "/governance/dashboard"),
                new BreadcrumbItem("Conflict work queue", href: "/admin/governance/conflicts"),
                new BreadcrumbItem($"FLG-{Id:D5}", href: null, disabled: true)
            };
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error loading conflict detail: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task OpenAdjudicationDialogAsync()
    {
        if (_flag == null) return;

        var parameters = new DialogParameters<ConflictResolutionDialog>
        {
            { x => x.Flag, _flag },
            { x => x.CurrentUsername, "RiskAndComplianceManager" }
        };

        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Medium, FullWidth = true };
        var dialog = await DialogService.ShowAsync<ConflictResolutionDialog>("Adjudicate Conflict", parameters, options);
        var result = await dialog.Result;

        if (result != null && !result.Canceled)
        {
            await LoadDetailAsync();
        }
    }

    private Severity GetAlertSeverity(string code) => code switch
    {
        "RED_CRITICAL" => Severity.Error,
        "AMBER_ELEVATED" => Severity.Warning,
        _ => Severity.Info
    };

    private string FormatSeverity(string severity) => severity switch
    {
        "RED_CRITICAL" => "Red (Critical)",
        "AMBER_ELEVATED" => "Amber (Elevated)",
        "YELLOW_ADVISORY" => "Yellow (Advisory)",
        _ => severity
    };

    private string FormatCategory(string cat) => cat switch
    {
        "INSIDER_AFFILIATION" => "Insider Affiliation (PFMA)",
        "MULTI_ORGANISATION_GRANT_SYNDICATE" => "Multi-Organisation Grant Syndicate",
        "ACCREDITATION_GOVERNANCE_BREACH" => "Accreditation Governance Breach",
        "COMMITTEE_RECUSAL_REQUIRED" => "Committee Recusal Required",
        "OVERDUE_DECLARATION" => "Overdue Annual Declaration",
        _ => cat
    };
}
