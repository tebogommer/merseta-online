@page "/curriculum"
@using Nsdms.Application.Common.Interfaces
@using Nsdms.Domain.Entities
@inject IQcdAndCurriculumService QcdService
@inject NavigationManager Nav
@inject ISnackbar Snackbar

<PageTitle>Qualifications Curriculum Development | merSETA NSDMS</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="my-4">
    <!-- Top Bar -->
    <MudCard Elevation="2" Class="mb-4">
        <MudCardContent Class="d-flex align-center justify-space-between py-3">
            <div>
                <MudBreadcrumbs Items="_breadcrumbs" Class="pa-0 mb-1" />
                <MudText Typo="Typo.h5" Class="fw-bold">Qualifications Curriculum Development (QCD) &amp; QDF</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">
                    QCTO occupational qualification scoping, Development Quality Partner (DQP) steering, stakeholder working groups, and SAQA registration.
                </MudText>
            </div>
            <MudStack Row="true" Spacing="2">
                <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Refresh" OnClick="LoadDataAsync">
                    Refresh
                </MudButton>
            </MudStack>
        </MudCardContent>
    </MudCard>

    @if (_isLoading)
    {
        <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="mb-4" />
    }

    <!-- Grid -->
    <MudCard Elevation="2">
        <MudCardContent>
            <MudTable Items="_applications" Hover="true" Dense="true" Elevation="0" Filter="FilterApplications">
                <ToolBarContent>
                    <MudText Typo="Typo.h6">Curriculum Applications (@_applications.Count)</MudText>
                    <MudSpacer />
                    <MudTextField @bind-Value="_searchString" Placeholder="Search by application #, qualification, OFO..." Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Medium" Class="mt-0" Immediate="true" />
                </ToolBarContent>
                <HeaderContent>
                    <MudTh>App #</MudTh>
                    <MudTh>Qualification Title</MudTh>
                    <MudTh>OFO Code</MudTh>
                    <MudTh>NQF Level</MudTh>
                    <MudTh>Credits</MudTh>
                    <MudTh>Type</MudTh>
                    <MudTh>Status</MudTh>
                    <MudTh Style="text-align: right;">Action</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="App #" Class="font-monospace fw-bold">@context.ApplicationNumber</MudTd>
                    <MudTd DataLabel="Qualification Title">@context.QualificationTitle</MudTd>
                    <MudTd DataLabel="OFO Code" Class="font-monospace">@context.OfoCode</MudTd>
                    <MudTd DataLabel="NQF Level">Level @context.NqfLevel</MudTd>
                    <MudTd DataLabel="Credits">@context.TotalCreditsRequired</MudTd>
                    <MudTd DataLabel="Type">
                        <MudChip T="string" Size="Size.Small" Color="Color.Info" Variant="Variant.Outlined">
                            @context.DevelopmentTypeCode
                        </MudChip>
                    </MudTd>
                    <MudTd DataLabel="Status">
                        <MudChip T="string" Size="Size.Small" Color="@GetStatusColor(context.StatusCode)" Variant="Variant.Filled">
                            @context.StatusCode
                        </MudChip>
                    </MudTd>
                    <MudTd DataLabel="Action" Style="text-align: right;">
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" StartIcon="@Icons.Material.Filled.MenuBook" OnClick="@(() => Nav.NavigateTo($"/curriculum/{context.Id}"))">
                            Open Scoping View
                        </MudButton>
                    </MudTd>
                </RowTemplate>
                <PagerContent>
                    <MudTablePager />
                </PagerContent>
            </MudTable>
        </MudCardContent>
    </MudCard>
</MudContainer>

@code {
    private List<BreadcrumbItem> _breadcrumbs = new()
    {
        new BreadcrumbItem("Home", href: "/"),
        new BreadcrumbItem("Core Registries", href: "/sdp"),
        new BreadcrumbItem("Curriculum Development", href: null, disabled: true)
    };

    private List<QualificationsCurriculumDevelopment> _applications = new();
    private bool _isLoading = true;
    private string _searchString = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        _isLoading = true;
        try
        {
            _applications = await QcdService.GetQcdApplicationsAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Failed to load curriculum applications: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isLoading = false;
        }
    }

    private bool FilterApplications(QualificationsCurriculumDevelopment qcd)
    {
        if (string.IsNullOrWhiteSpace(_searchString)) return true;
        return qcd.ApplicationNumber.Contains(_searchString, StringComparison.OrdinalIgnoreCase) ||
               qcd.QualificationTitle.Contains(_searchString, StringComparison.OrdinalIgnoreCase) ||
               (qcd.OfoCode != null && qcd.OfoCode.Contains(_searchString, StringComparison.OrdinalIgnoreCase));
    }

    private Color GetStatusColor(string status) => status switch
    {
        "ApprovedBySaqa" => Color.Success,
        "SubmittedToQcto" => Color.Info,
        "PublicCommentOpen" => Color.Warning,
        "WorkingGroupConvened" => Color.Primary,
        "Rejected" => Color.Error,
        _ => Color.Default
    };
}
