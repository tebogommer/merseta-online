@inherits LayoutComponentBase

<MudThemeProvider />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="1" Color="Color.Primary" role="banner">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start" OnClick="@((e) => DrawerToggle())" aria-label="Toggle navigation menu" />
        <MudText Typo="Typo.h6" Class="ml-3">NSDMS Enterprise Portal (.NET 10)</MudText>
        <MudSpacer />
        <MudChip T="string" Color="Color.Dark" Variant="Variant.Filled" Size="Size.Small">SETA Admin</MudChip>
    </MudAppBar>
    <MudDrawer @bind-Open="_drawerOpen" Elevation="2" ClipMode="DrawerClipMode.Always" role="navigation" aria-label="Main Navigation">
        <NavMenu />
    </MudDrawer>
    <MudMainContent Class="pa-4" role="main">
        <main id="main-content" role="main">
            @Body
        </main>
    </MudMainContent>
</MudLayout>

@code {
    private bool _drawerOpen = true;

    private void DrawerToggle()
    {
        _drawerOpen = !_drawerOpen;
    }
}
