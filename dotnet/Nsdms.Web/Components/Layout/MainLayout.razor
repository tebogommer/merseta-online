@inherits LayoutComponentBase
@implements IDisposable
@using Nsdms.Application.Common
@using Nsdms.Application.Common.Interfaces
@using Nsdms.Application.Services
@using Nsdms.Domain.Entities
@using Nsdms.Web.Components.Shared
@using Nsdms.Web.Components.Shared.Wizard
@using Nsdms.Web.Services
@using Nsdms.Web.Themes
@inject IRealtimeNotificationService NotificationService
@inject INotificationService PersistentNotificationService
@inject INavigationMenuService NavService
@inject AuthenticationStateProvider AuthStateProvider
@inject ITenantProvider TenantProvider
@inject ISnackbar Snackbar
@inject IJSRuntime JS
@inject NavigationManager Nav
@inject IWizardDraftService DraftService

<MudThemeProvider @ref="_mudThemeProvider" Theme="_customTheme" @bind-IsDarkMode="_isDarkMode" />
<MudPopoverProvider />
<MudDialogProvider FullWidth="true" MaxWidth="MaxWidth.Medium" CloseButton="true" />
<MudSnackbarProvider />

<div class="nsdms-app-shell">
    <!-- Accessible Skip-to-Content Link (WCAG 2.2 AA) -->
    <a href="#main-content"
       class="sr-only focus:not-sr-only nsdms-skip-link"
       style="position: absolute; left: 16px; top: -100px; background: var(--brand-navy-surface); color: var(--text-primary); font-weight: 600; padding: 10px 18px; z-index: 9999; border-radius: 6px; border: 2px solid var(--brand-gold); transition: top 0.2s;"
       onfocus="this.style.top='16px'"
       onblur="this.style.top='-100px'">
        Skip to main content
    </a>

    <MudLayout>
        <!-- Modernized 60px Enterprise Top Bar -->
        <MudAppBar Elevation="0" Dense="true" Fixed="true" role="banner" Class="app-header-modern px-4" Style="border-bottom: 1px solid var(--border); height: 60px;">
            <MudIconButton Icon="@Icons.Material.Filled.Menu" 
                           Color="Color.Default" 
                           Edge="Edge.Start" 
                           OnClick="@((e) => DrawerToggle())" 
                           aria-label="Toggle navigation menu" />

            <!-- merSETA Brand & System Identity matching exact screenshot -->
            <div class="d-flex align-center ml-2">
                <span class="nsdms-brand-title">merSETA</span>
                <span class="nsdms-brand-divider">|</span>
                <span class="nsdms-brand-subtitle d-none d-sm-inline">@GetCurrentModuleSubtitle()</span>
            </div>

            <MudSpacer />

            <!-- Global Universal OmniSearch & Command Palette Launcher (Ctrl + K) -->
            <div class="d-none d-md-flex align-center px-3 py-1 rounded mr-3" style="background: var(--surface-subtle); border: 1px solid var(--border); cursor: pointer;" @onclick="OpenCommandPalette" title="Search Everything &amp; Jump (Ctrl + K)">
                <MudIcon Icon="@Icons.Material.Filled.Search" Size="Size.Small" Style="opacity: 0.75; font-size: 1rem;" Class="mr-2 text-secondary" />
                <span class="text-secondary" style="font-size: 0.78rem;">Search &amp; jump...</span>
                <span class="kbd-shortcut ml-3">Ctrl + K</span>
            </div>

            <!-- In-Progress Statutory Wizard Drafts Launcher with Badge (Option A) -->
            <MudBadge Content="@_activeDraftsCount" Color="Color.Warning" Overlap="true" Visible="@(_activeDraftsCount > 0)" Class="mr-2">
                <MudTooltip Text="@(_activeDraftsCount > 0 ? $"{_activeDraftsCount} in-progress draft{(_activeDraftsCount == 1 ? "" : "s")}" : "In-progress application drafts")">
                    <MudIconButton Icon="@Icons.Material.Filled.HistoryEdu"
                                   Color="Color.Default"
                                   Size="Size.Medium"
                                   OnClick="@(() => _isDraftsDrawerOpen = true)"
                                   aria-label="In-progress application drafts"
                                   Title="In-progress application drafts" />
                </MudTooltip>
            </MudBadge>

            <!-- Real-time Notifications Bell with Badge -->
            <MudBadge Content="@_unreadCount" Color="Color.Error" Overlap="true" Visible="@(_unreadCount > 0)" Class="mr-2">
                <MudMenu Icon="@Icons.Material.Filled.Notifications" Color="Color.Default" AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight" Dense="true" AriaLabel="Live Notifications Menu" Title="Live Notifications Menu">
                    <div class="pa-3" style="min-width: 320px; max-width: 400px; background: var(--surface);">
                        <div class="d-flex justify-space-between align-center mb-2">
                            <div>
                                <MudText Typo="Typo.subtitle2" Class="fw-bold" Color="Color.Primary">Operational Notifications</MudText>
                                <MudText Typo="Typo.caption" Color="Color.Secondary">Live Notifications</MudText>
                            </div>
                            <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Primary" OnClick="@MarkAllNotificationsReadAsync" Disabled="@(_unreadCount == 0)">
                                Mark all read
                            </MudButton>
                        </div>
                        <MudDivider Class="my-2" />
                        @if (!_userNotifications.Any())
                        {
                            <div class="pa-4 text-center">
                                <MudIcon Icon="@Icons.Material.Outlined.NotificationsNone" Color="Color.Secondary" Size="Size.Large" Class="mb-1" />
                                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="d-block">No notifications at this time.</MudText>
                            </div>
                        }
                        else
                        {
                            <MudList T="SystemNotificationDto" Dense="true">
                                @foreach (var n in _userNotifications.Take(6))
                                {
                                    <MudListItem T="SystemNotificationDto" OnClick="@(() => HandleNotificationClickAsync(n))" Class="@(n.IsRead ? "opacity-75" : "bg-light rounded mb-1")">
                                        <div class="d-flex align-start gap-2">
                                            <MudIcon Icon="@GetNotificationIcon(n.NotificationType, n.Severity)" Color="@GetNotificationColor(n.Severity)" Size="Size.Small" Class="mt-1" />
                                            <div style="flex: 1;">
                                                <div class="d-flex justify-space-between">
                                                    <MudText Typo="Typo.caption" Class="fw-bold">@n.Title</MudText>
                                                    <MudText Typo="Typo.caption" Style="font-size: 0.65rem;" Color="Color.Secondary">@n.CreatedAt.ToString("HH:mm")</MudText>
                                                </div>
                                                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="d-block text-truncate" Style="max-width: 250px;">@n.Message</MudText>
                                            </div>
                                        </div>
                                    </MudListItem>
                                }
                            </MudList>
                        }
                    </div>
                </MudMenu>
            </MudBadge>
            
            <!-- Keyboard Shortcuts Helper Menu -->
            <MudMenu Icon="@Icons.Material.Filled.Keyboard" Color="Color.Default" AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight" Dense="true" AriaLabel="Keyboard Shortcuts Guide" Title="Keyboard Shortcuts Guide" Class="mr-2">
                <div class="pa-4" style="min-width: 280px; background: var(--surface);">
                    <div class="d-flex align-center gap-2 mb-2">
                        <MudIcon Icon="@Icons.Material.Filled.Keyboard" Color="Color.Primary" />
                        <MudText Typo="Typo.subtitle2" Class="fw-bold">Power-User Keybindings</MudText>
                    </div>
                    <MudDivider Class="mb-3" />
                    <div class="d-flex flex-column gap-2">
                        <div class="d-flex justify-space-between align-center">
                            <MudText Typo="Typo.caption">Command Palette &amp; Jump</MudText>
                            <span class="kbd-shortcut">Ctrl + K</span>
                        </div>
                        <div class="d-flex justify-space-between align-center">
                            <MudText Typo="Typo.caption">Quick Save Record</MudText>
                            <span class="kbd-shortcut">Ctrl + S</span>
                        </div>
                        <div class="d-flex justify-space-between align-center">
                            <MudText Typo="Typo.caption">Focus Table Search</MudText>
                            <span class="kbd-shortcut">/</span>
                        </div>
                        <div class="d-flex justify-space-between align-center">
                            <MudText Typo="Typo.caption">Cancel / Go Back</MudText>
                            <span class="kbd-shortcut">Esc</span>
                        </div>
                        <div class="d-flex justify-space-between align-center">
                            <MudText Typo="Typo.caption">Skip Navigation</MudText>
                            <span class="kbd-shortcut">Tab</span>
                        </div>
                    </div>
                </div>
            </MudMenu>

            <!-- Theme Toggle -->
            <MudTooltip Text="@(_isDarkMode ? "Switch to light mode" : "Switch to dark mode")">
                <MudIconButton Icon="@(_isDarkMode ? Icons.Material.Filled.LightMode : Icons.Material.Filled.DarkMode)"
                               Color="Color.Default"
                               Size="Size.Medium"
                               OnClick="@ToggleTheme"
                               Class="mr-1"
                               aria-label="Toggle color theme" />
            </MudTooltip>

            <!-- Dedicated Top-Bar Organisation Context Switcher (Option C) -->
            <OrganisationContextSwitcher @ref="_orgSwitcherRef"
                                         CurrentUserEmail="@_currentUserEmail"
                                         CurrentPersonName="@_currentUserDisplayName"
                                         IsAdminUser="@_isCurrentUserAdmin"
                                         OnOrganisationChanged="@HandleOrganisationChanged" />

            <!-- Dedicated Top-Bar Persona Switcher Pill with Person Name (Option B Enhanced) -->
            <PersonaSwitcher ActivePersona="@_activePersona" 
                             OnPersonaChanged="@HandlePersonaChanged" 
                             OnPersonaSelected="@HandlePersonaSelected" />

            <!-- User Profile Avatar Pill & Menu matching active person identity -->
            <MudMenu AnchorOrigin="Origin.BottomRight" 
                     TransformOrigin="Origin.TopRight" 
                     Dense="true" 
                     AriaLabel="User profile and account session menu" 
                     Title="User profile and account session">
                <ActivatorContent Context="avatarCtx">
                    <MudButton Variant="Variant.Text" 
                               OnClick="@avatarCtx.ToggleAsync"
                               Class="nsdms-user-pill-btn" 
                               Style="text-transform: none !important; min-width: 0 !important; padding: 2px 8px !important;"
                               aria-label="@($"User profile: {_currentUserDisplayName} ({_currentUserRoleBadge})")" 
                               title="@($"User profile: {_currentUserDisplayName} ({_currentUserRoleBadge})")">
                        <div class="nsdms-user-avatar">
                            @_currentUserInitials
                        </div>
                        <div class="d-none d-md-flex flex-column text-left">
                            <span class="nsdms-user-name">@_currentUserDisplayName</span>
                            <span class="nsdms-user-role-badge">@_currentUserRoleBadge</span>
                        </div>
                        <MudIcon Icon="@Icons.Material.Filled.KeyboardArrowDown" Size="Size.Small" Style="color: var(--mud-palette-text-secondary); font-size: 1rem;" />
                    </MudButton>
                </ActivatorContent>
                <ChildContent>
                    <div class="pa-3" style="min-width: 300px;">
                        <div class="d-flex align-center gap-3 mb-2">
                            <div class="nsdms-user-avatar" style="width: 38px; height: 38px; font-size: 0.9rem;">
                                @_currentUserInitials
                            </div>
                            <div>
                                <MudText Typo="Typo.subtitle2" Class="fw-bold" Style="color: var(--mud-palette-text-primary);">@_currentUserDisplayName</MudText>
                                <span class="nsdms-user-role-badge">@_currentUserRoleBadge</span>
                            </div>
                        </div>
                        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="d-block mb-1">
                            Signed in as <strong>@_currentUserEmail</strong>
                        </MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary" Style="font-size: 0.68rem;" Class="d-block mb-2">
                            @_currentUserSubtitle
                        </MudText>
                        <MudDivider Class="my-2" />
                        <MudMenuItem Icon="@Icons.Material.Filled.Dashboard" Href="/">Executive dashboard</MudMenuItem>
                        <MudMenuItem Icon="@Icons.Material.Filled.Inbox" Href="/tasks">Universal task inbox</MudMenuItem>
                        <MudMenuItem Icon="@Icons.Material.Filled.Handyman" Href="/workplace-approvals">Workplace approvals</MudMenuItem>
                        <MudMenuItem Icon="@Icons.Material.Filled.Business" Href="/employers">Organisations &amp; employers</MudMenuItem>
                        <MudMenuItem Icon="@Icons.Material.Filled.Security" Href="/admin/audit-logs">Audit trail &amp; change logs</MudMenuItem>
                        <MudMenuItem Icon="@Icons.Material.Filled.MenuBook" Href="/developer/schema">Data dictionary &amp; schema</MudMenuItem>
                        <MudDivider Class="my-2" />
                        <MudMenuItem Icon="@Icons.Material.Filled.Logout" IconColor="Color.Error" OnClick="@HandleSignOut">
                            Log out (Reset to Admin)
                        </MudMenuItem>
                    </div>
                </ChildContent>
            </MudMenu>
        </MudAppBar>

        <!-- Left Navigation Drawer -->
        <MudDrawer @bind-Open="_drawerOpen" 
                   Elevation="0" 
                   ClipMode="DrawerClipMode.Always" 
                   Width="280px"
                   role="navigation" 
                   aria-label="Main Navigation" 
                   Style="border-right: 1px solid var(--border);">
            <NavMenu @ref="_navMenuRef" 
                     ActivePersona="@_activePersona" 
                     CurrentUsername="@_currentUsername" 
                     CurrentRoles="@_currentUserRoles" />
        </MudDrawer>

        <!-- Main Content Area with Strict Screen Boundary Constraint per MudBlazor Invariant -->
        <MudMainContent Style="min-height: calc(100vh - 60px); min-width: 0; box-sizing: border-box;">
            <div class="pa-4 pa-md-6" style="box-sizing: border-box; width: 100%;">
                <main id="main-content" class="nsdms-page-container" tabindex="-1" style="outline: none; max-width: 1600px; width: 100%; min-width: 0; margin: 0 auto; box-sizing: border-box;">
                    @Body
                </main>
            </div>
        </MudMainContent>
    </MudLayout>

    <!-- Global Universal Command Palette -->
    <AdminCommandPalette @ref="_commandPaletteRef" 
                         CurrentUsername="@_currentUsername" 
                         CurrentRoles="@_currentUserRoles" />

    <!-- Central In-Progress Wizard Drafts Drawer (Option A) -->
    <WizardDraftsDrawer @bind-IsOpen="_isDraftsDrawerOpen" 
                        CurrentUserId="@_currentUsername" 
                        OnDraftsChanged="RefreshDraftsCountAsync" />
</div>

@code {
    private MudThemeProvider _mudThemeProvider = default!;
    private NavMenu? _navMenuRef;
    private AdminCommandPalette? _commandPaletteRef;
    private bool _drawerOpen = true;
    private bool _isDraftsDrawerOpen = false;
    private int _activeDraftsCount = 0;
    private bool _isDarkMode = false;
    private string _activePersona = "All Roles (Unified)";
    private MudTheme _customTheme = NsdmsTheme.CreateTheme();
    private List<SystemNotificationDto> _userNotifications = new();
    private int _unreadCount = 0;
    private string _currentUsername = "System Administrator";
    private string _currentUserDisplayName = "System Administrator";
    private string _currentUserEmail = "sysadmin@merseta.org.za";
    private string _currentUserInitials = "SA";
    private string _currentUserRoleBadge = "SUPERADMIN";
    private string _currentUserSubtitle = "Enterprise Super Administrator • ICT & Executive Directorate";
    private List<string> _currentUserRoles = new() { "SuperAdmin", "Admin", "FinanceManager", "CLO" };
    private OrganisationContextSwitcher? _orgSwitcherRef;
    private bool _isCurrentUserAdmin => _currentUserRoles.Any(r => r is "SuperAdmin" or "Admin" or "Executive" or "CLO" or "Finance" or "Legal" or "Compliance");

    public void OpenCommandPalette()
    {
        _commandPaletteRef?.Open();
    }

    private Task HandleOrganisationChanged(AffiliatedOrganisationDto? org)
    {
        InvokeAsync(StateHasChanged);
        return Task.CompletedTask;
    }

    private async Task HandlePersonaChanged(string newPersona)
    {
        var profile = NavService.GetPersonaProfile(newPersona);
        if (profile != null)
        {
            await HandlePersonaSelected(profile);
            return;
        }

        _activePersona = newPersona;
        if (_navMenuRef != null)
        {
            await _navMenuRef.SetActivePersonaAsync(newPersona);
        }
        StateHasChanged();
    }

    private async Task HandlePersonaSelected(PersonaProfileDto profile)
    {
        _activePersona = profile.PersonaTitle;
        _currentUsername = profile.PersonName;
        _currentUserDisplayName = profile.PersonName;
        _currentUserEmail = profile.Email;
        _currentUserInitials = profile.Initials;
        _currentUserRoleBadge = profile.RoleBadge;
        _currentUserSubtitle = $"{profile.StatutoryRole} • {profile.OrganisationName}";
        _currentUserRoles = profile.Roles;

        if (AuthStateProvider is NsdmsAuthenticationStateProvider authProvider)
        {
            authProvider.SetUser(profile.Email, profile.PersonName, profile.Roles);
        }

        if (_navMenuRef != null)
        {
            await _navMenuRef.SetActivePersonaAsync(profile.PersonaTitle);
        }

        var isInternalAdmin = profile.Roles.Any(r => r is "SuperAdmin" or "Admin" or "Executive" or "CLO" or "Finance" or "Legal" or "Compliance");
        if (_orgSwitcherRef != null)
        {
            await _orgSwitcherRef.ReloadAffiliationsAsync(profile.Email, profile.PersonName, isInternalAdmin);
        }

        try
        {
            await JS.InvokeVoidAsync("localStorage.setItem", "nsdms_active_persona", profile.PersonaTitle);
        }
        catch { }

        await RefreshNotificationsAsync();
        await RefreshDraftsCountAsync();
        StateHasChanged();
    }

    protected override async Task OnInitializedAsync()
    {
        NotificationService.TaskAssignedReceived += HandleTaskAssigned;
        NotificationService.WorkflowTransitionReceived += HandleWorkflowTransition;
        NotificationService.UserNotificationReceived += HandleUserNotification;
        NotificationService.SlaWarningReceived += HandleSlaWarning;
        TenantProvider.OnTenantChanged += HandleTenantContextChanged;

        await RefreshNotificationsAsync();
        await RefreshDraftsCountAsync();
    }

    private async Task RefreshDraftsCountAsync()
    {
        try
        {
            var drafts = await DraftService.GetActiveDraftsForUserAsync(_currentUsername);
            _activeDraftsCount = drafts.Count;
            StateHasChanged();
        }
        catch
        {
            // Non-blocking draft count lookup
        }
    }

    private void HandleTenantContextChanged() => InvokeAsync(StateHasChanged);

    private async Task RefreshNotificationsAsync()
    {
        try
        {
            _userNotifications = await PersistentNotificationService.GetUserNotificationsAsync(_currentUsername, _currentUserRoles, false, 15);
            _unreadCount = await PersistentNotificationService.GetUnreadCountAsync(_currentUsername, _currentUserRoles);
            if (_navMenuRef != null)
            {
                await _navMenuRef.RefreshBadgesAsync();
            }
            StateHasChanged();
        }
        catch
        {
            // Graceful fallback during prerendering
        }
    }

    private void HandleUserNotification(SystemNotificationDto notification)
    {
        InvokeAsync(async () =>
        {
            _userNotifications.Insert(0, notification);
            _unreadCount++;
            var severity = notification.Severity.Equals("Error", StringComparison.OrdinalIgnoreCase) ? Severity.Error
                : notification.Severity.Equals("Warning", StringComparison.OrdinalIgnoreCase) ? Severity.Warning
                : notification.Severity.Equals("Success", StringComparison.OrdinalIgnoreCase) ? Severity.Success
                : Severity.Info;

            Snackbar.Add($"🔔 {notification.Title}: {notification.Message}", severity);
            if (_navMenuRef != null)
            {
                await _navMenuRef.RefreshBadgesAsync();
            }
            StateHasChanged();
        });
    }

    private void HandleTaskAssigned(string taskId, string taskTitle, string assignedRole, string priority)
    {
        InvokeAsync(async () =>
        {
            Snackbar.Add($"🔔 New Task Assigned: '{taskTitle}' to {assignedRole}", Severity.Info);
            await RefreshNotificationsAsync();
        });
    }

    private void HandleWorkflowTransition(string entityType, int entityId, string fromState, string toState, string actor)
    {
        InvokeAsync(async () =>
        {
            Snackbar.Add($"📋 Status Update: {entityType} #{entityId} is now '{toState}'", Severity.Success);
            await RefreshNotificationsAsync();
        });
    }

    private void HandleSlaWarning(string taskTitle, int hoursRemaining)
    {
        InvokeAsync(async () =>
        {
            if (hoursRemaining <= 0)
            {
                Snackbar.Add($"🚨 Statutory SLA Breach: Task '{taskTitle}' has expired!", Severity.Error);
            }
            else
            {
                Snackbar.Add($"⚠️ SLA Warning: Task '{taskTitle}' has {hoursRemaining}h remaining before statutory breach!", Severity.Warning);
            }
            await RefreshNotificationsAsync();
        });
    }

    private async Task HandleNotificationClickAsync(SystemNotificationDto notification)
    {
        if (!notification.IsRead)
        {
            await PersistentNotificationService.MarkAsReadAsync(notification.Id, _currentUsername);
            notification.IsRead = true;
            _unreadCount = Math.Max(0, _unreadCount - 1);
        }

        if (!string.IsNullOrWhiteSpace(notification.ActionUrl))
        {
            Nav.NavigateTo(notification.ActionUrl);
        }
    }

    private async Task MarkAllNotificationsReadAsync()
    {
        await PersistentNotificationService.MarkAllAsReadAsync(_currentUsername, _currentUserRoles);
        foreach (var n in _userNotifications) n.IsRead = true;
        _unreadCount = 0;
        StateHasChanged();
        Snackbar.Add("All notifications marked as read.", Severity.Success);
    }

    private string GetNotificationIcon(string type, string severity)
    {
        if (type.Equals("WorkflowTask", StringComparison.OrdinalIgnoreCase)) return Icons.Material.Filled.Assignment;
        if (type.Equals("SignoffRequired", StringComparison.OrdinalIgnoreCase)) return Icons.Material.Filled.Draw;
        if (type.Equals("Delegation", StringComparison.OrdinalIgnoreCase)) return Icons.Material.Filled.SupervisorAccount;
        if (severity.Equals("Warning", StringComparison.OrdinalIgnoreCase)) return Icons.Material.Filled.Warning;
        if (severity.Equals("Error", StringComparison.OrdinalIgnoreCase)) return Icons.Material.Filled.Error;
        return Icons.Material.Filled.Notifications;
    }

    private Color GetNotificationColor(string severity)
    {
        if (severity.Equals("Warning", StringComparison.OrdinalIgnoreCase)) return Color.Warning;
        if (severity.Equals("Error", StringComparison.OrdinalIgnoreCase)) return Color.Error;
        if (severity.Equals("Success", StringComparison.OrdinalIgnoreCase)) return Color.Success;
        return Color.Primary;
    }

    public void Dispose()
    {
        NotificationService.TaskAssignedReceived -= HandleTaskAssigned;
        NotificationService.WorkflowTransitionReceived -= HandleWorkflowTransition;
        NotificationService.UserNotificationReceived -= HandleUserNotification;
        NotificationService.SlaWarningReceived -= HandleSlaWarning;
        TenantProvider.OnTenantChanged -= HandleTenantContextChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                _isDarkMode = await JS.InvokeAsync<bool>("nsdmsTheme.isDark");
                await ApplyThemeDomState(_isDarkMode);

                var savedPersona = await JS.InvokeAsync<string?>("localStorage.getItem", "nsdms_active_persona");
                if (!string.IsNullOrWhiteSpace(savedPersona) && !savedPersona.Equals("All Roles (Unified)", StringComparison.OrdinalIgnoreCase))
                {
                    var p = NavService.GetPersonaProfile(savedPersona);
                    if (p != null)
                    {
                        await HandlePersonaSelected(p);
                    }
                }

                StateHasChanged();
            }
            catch
            {
                // Graceful fallback during prerendering
            }
        }
    }

    private void DrawerToggle() => _drawerOpen = !_drawerOpen;

    private async Task ToggleTheme()
    {
        _isDarkMode = !_isDarkMode;
        try
        {
            await JS.InvokeVoidAsync("localStorage.setItem", "nsdms_dark_mode", _isDarkMode ? "true" : "false");
            await JS.InvokeVoidAsync("localStorage.setItem", "app_theme", _isDarkMode ? "dark" : "light");
            await ApplyThemeDomState(_isDarkMode);
        }
        catch
        {
            // Graceful fallback
        }
    }

    private async Task ApplyThemeDomState(bool isDark)
    {
        var theme = isDark ? "dark" : "light";
        await JS.InvokeVoidAsync("nsdmsTheme.setTheme", theme);
    }

    private string GetCurrentModuleSubtitle()
    {
        var uri = Nav.Uri.ToLowerInvariant();
        if (uri.Contains("/task") || uri.Contains("/workflow"))
            return "Workflow Orchestration & Task Inbox";
        if (uri.Contains("/moa") || uri.Contains("/legal") || uri.Contains("/verify") || uri.Contains("/document"))
            return "Legal, MoA & Statutory Document Templates";
        if (uri.Contains("/wsp") || uri.Contains("/training-committee"))
            return "Mandatory Grants (MG) & WSP Governance";
        if (uri.Contains("/grant") || uri.Contains("/dg-") || uri.Contains("/funding-window"))
            return "Discretionary Grants (DG) & Financial Operations";
        if (uri.Contains("/finance") || uri.Contains("/levy") || uri.Contains("/inter-seta"))
            return "Finance, Levies & Disbursements";
        if (uri.Contains("/tradetest") || uri.Contains("/learner") || uri.Contains("/assessment"))
            return "Learner Management & Artisan Development";
        if (uri.Contains("/provider") || uri.Contains("/sdp") || uri.Contains("/curriculum"))
            return "Skills Development Providers & Curriculum";
        if (uri.Contains("/monitoring") || uri.Contains("/site-visit") || uri.Contains("/etqa") || uri.Contains("/non-seta"))
            return "Quality Assurance & ETQA Governance";
        if (uri.Contains("/employer") || uri.Contains("/organisation") || uri.Contains("/workplace"))
            return "Organisation & Workplace Registry";
        if (uri.Contains("/people"))
            return "People & Demographics (SETMIS)";
        if (uri.Contains("/report") || uri.Contains("/bi") || uri.Contains("/compliance"))
            return "Skills Planning, BI & Statutory Submissions";
        if (uri.Contains("/admin") || uri.Contains("/developer") || uri.Contains("/system"))
            return "Enterprise Administration & Control Hub";

        return "merSETA National Skills Development Management System";
    }

    private async Task HandleSignOut()
    {
        try
        {
            await JS.InvokeVoidAsync("localStorage.removeItem", "nsdms_active_persona");
        }
        catch { }

        TenantProvider.ResetToGlobalAdmin();
        if (_orgSwitcherRef != null)
        {
            await _orgSwitcherRef.ReloadAffiliationsAsync("sysadmin@merseta.org.za", "System Administrator", isAdmin: true);
        }

        var adminProfile = NavService.GetPersonaProfile("UnifiedAdmin");
        if (adminProfile != null)
        {
            await HandlePersonaSelected(adminProfile);
        }
        else
        {
            _activePersona = "All Roles (Unified)";
            _currentUserDisplayName = "System Administrator";
            _currentUserEmail = "sysadmin@merseta.org.za";
            _currentUserInitials = "SA";
            _currentUserRoleBadge = "SUPERADMIN";
            _currentUserRoles = new() { "SuperAdmin", "Admin" };
            if (AuthStateProvider is NsdmsAuthenticationStateProvider authProvider)
            {
                authProvider.SetUser("sysadmin@merseta.org.za", "System Administrator", _currentUserRoles);
            }
        }
        Snackbar.Add("Active session reset to System Administrator.", Severity.Info);
        Nav.NavigateTo("/");
    }
}

