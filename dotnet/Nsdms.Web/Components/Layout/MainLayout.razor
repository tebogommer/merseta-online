@inherits LayoutComponentBase
@implements IDisposable
@using Nsdms.Application.Services
@using Nsdms.Web.Themes
@inject IRealtimeNotificationService NotificationService
@inject ISnackbar Snackbar
@inject IJSRuntime JS

<MudThemeProvider Theme="_customTheme" @bind-IsDarkMode="_isDarkMode" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<a href="#main-content" class="skip-link">Skip to Main Content</a>

<MudLayout>
    <MudAppBar Elevation="1" Color="Color.Primary" role="banner">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start" OnClick="@((e) => DrawerToggle())" aria-label="Toggle navigation menu" />
        <MudText Typo="Typo.h6" Class="ml-3 font-weight-bold">MerSETA NSDMS Enterprise Portal</MudText>
        <MudSpacer />

        <!-- Real-time Notifications Bell -->
        <MudMenu Icon="@Icons.Material.Filled.Notifications" Color="Color.Inherit" AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight" Dense="true" Class="mr-2" AriaLabel="Live Notifications Menu" Title="Live Notifications Menu">
            <div class="pa-3" style="min-width: 300px; max-width: 360px;">
                <div class="d-flex justify-space-between align-center mb-2">
                    <MudText Typo="Typo.subtitle2" Class="fw-bold" Color="Color.Primary">Live Activity Matrix</MudText>
                    <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Filled">SignalR Active</MudChip>
                </div>
                @if (!_notifications.Any())
                {
                    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="font-italic">No new real-time alerts.</MudText>
                }
                else
                {
                    <MudList T="string" Dense="true">
                        @foreach (var n in _notifications.Take(5))
                        {
                            <MudListItem T="string" Icon="@Icons.Material.Filled.Bolt" IconColor="Color.Warning">
                                <MudText Typo="Typo.caption" Class="fw-bold d-block">@n.Title</MudText>
                                <MudText Typo="Typo.caption" Color="Color.Secondary">@n.Time.ToString("HH:mm:ss") - @n.Detail</MudText>
                            </MudListItem>
                        }
                    </MudList>
                }
            </div>
        </MudMenu>
        
        <MudTooltip Text="@(_isDarkMode ? "Switch to Light Mode" : "Switch to Dark Mode")">
            <MudIconButton Icon="@(_isDarkMode ? Icons.Material.Filled.LightMode : Icons.Material.Filled.DarkMode)"
                           Color="Color.Inherit"
                           OnClick="@ToggleTheme"
                           Class="mr-2"
                           aria-label="Toggle dark mode" />
        </MudTooltip>

        <MudChip T="string" Color="Color.Dark" Variant="Variant.Filled" Size="Size.Small">
            @(_isDarkMode ? "🌙 Dark Mode" : "☀️ Light Mode")
        </MudChip>
    </MudAppBar>
    <MudDrawer @bind-Open="_drawerOpen" Elevation="2" ClipMode="DrawerClipMode.Always" role="navigation" aria-label="Main Navigation">
        <NavMenu />
    </MudDrawer>
    <MudMainContent role="main">
        <div class="pa-4 pa-md-6 pt-6">
            <main id="main-content" role="main">
                @Body
            </main>
        </div>
    </MudMainContent>
</MudLayout>

@code {
    private bool _drawerOpen = true;
    private bool _isDarkMode = false;
    private MudTheme _customTheme = NsdmsTheme.CreateTheme();
    private List<(string Title, string Detail, DateTime Time)> _notifications = new();

    protected override void OnInitialized()
    {
        NotificationService.TaskAssignedReceived += HandleTaskAssigned;
        NotificationService.WorkflowTransitionReceived += HandleWorkflowTransition;
    }

    private void HandleTaskAssigned(string taskId, string taskTitle, string assignedRole, string priority)
    {
        InvokeAsync(() =>
        {
            _notifications.Insert(0, ($"Task: {taskTitle}", $"Assigned to {assignedRole} [{priority}]", DateTime.UtcNow));
            Snackbar.Add($"⚡ Live SignalR Event: Task '{taskTitle}' assigned to {assignedRole}", Severity.Info);
            StateHasChanged();
        });
    }

    private void HandleWorkflowTransition(string entityType, int entityId, string fromState, string toState, string actor)
    {
        InvokeAsync(() =>
        {
            _notifications.Insert(0, ($"Workflow Transition: {entityType} #{entityId}", $"Moved to {toState} by {actor}", DateTime.UtcNow));
            Snackbar.Add($"⚡ Workflow Transition: {entityType} #{entityId} is now '{toState}'", Severity.Success);
            StateHasChanged();
        });
    }

    public void Dispose()
    {
        NotificationService.TaskAssignedReceived -= HandleTaskAssigned;
        NotificationService.WorkflowTransitionReceived -= HandleWorkflowTransition;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                var savedMode = await JS.InvokeAsync<string?>("localStorage.getItem", "nsdms_dark_mode");
                if (savedMode == "true")
                {
                    _isDarkMode = true;
                    StateHasChanged();
                }
            }
            catch
            {
                // Graceful fallback during prerendering
            }
        }
    }

    private void DrawerToggle()
    {
        _drawerOpen = !_drawerOpen;
    }

    private async Task ToggleTheme()
    {
        _isDarkMode = !_isDarkMode;
        try
        {
            await JS.InvokeVoidAsync("localStorage.setItem", "nsdms_dark_mode", _isDarkMode ? "true" : "false");
        }
        catch
        {
            // Graceful fallback
        }
    }
}
