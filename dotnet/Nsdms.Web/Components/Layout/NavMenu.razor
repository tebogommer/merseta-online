@namespace Nsdms.Web.Components.Layout
@using MudBlazor
@using Nsdms.Application.Common.Interfaces
@using Nsdms.Application.Services
@inject INavigationMenuService NavService
@inject ICaslAbilityService CaslService
@inject ISnackbar Snackbar
@inject NavigationManager Nav

<NavPanel Collapsed="@Collapsed" CurrentPath="@Nav.Uri">
    <div class="nsdms-menu-container pa-1">
        @if (_isLoading)
        {
            <div class="pa-4 text-center">
                <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Small" />
                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="d-block mt-2">Loading workspaces...</MudText>
            </div>
        }
        else
        {
            <!-- In-Sidebar Fast Search Bar (Option A) -->
            @if (!Collapsed)
            {
                <div class="nsdms-menu-search-wrapper px-2 pt-1 pb-2">
                    <MudTextField T="string"
                                  Value="@_searchTerm"
                                  ValueChanged="@OnSearchChanged"
                                  Placeholder="Filter navigation..."
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  Adornment="Adornment.Start"
                                  AdornmentIcon="@Icons.Material.Filled.Search"
                                  AdornmentColor="Color.Default"
                                  Clearable="true"
                                  OnClearButtonClick="@ClearSearch"
                                  Immediate="true"
                                  Class="nsdms-menu-search-input" />
                </div>
            }

            <MudNavMenu Class="mud-width-full" Dense="true" Rounded="true">
                <!-- 1. Pinned Shortcuts Section ("Pinned shortcuts") -->
                @if (string.IsNullOrWhiteSpace(_searchTerm) && _navTree?.PinnedItems != null && _navTree.PinnedItems.Any())
                {
                    <div class="nsdms-nav-group-header px-2 pt-2 pb-1 d-flex align-center justify-space-between">
                        <div class="d-flex align-center gap-1">
                            <MudIcon Icon="@Icons.Material.Filled.Star" Size="Size.Small" Style="color: var(--mud-palette-warning); font-size: 0.9rem;" />
                            <MudText Typo="Typo.caption" Class="font-weight-bold" Style="color: var(--mud-palette-text-secondary); letter-spacing: 0.02em; font-size: 0.72rem;">
                                Pinned shortcuts
                            </MudText>
                        </div>
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Filled" Color="Color.Default" Class="px-1 py-0" Style="font-size: 0.6rem; height: 16px;">
                            @_navTree.PinnedItems.Count
                        </MudChip>
                    </div>

                    @foreach (var item in _navTree.PinnedItems)
                    {
                        <div class="position-relative nsdms-nav-item-wrapper d-flex align-center">
                            <MudTooltip Text="@($"{item.Title} — {item.Description}")" Placement="Placement.Right" Delay="350">
                                <MudNavLink href="@item.Href" 
                                            Match="@(item.ExactMatch ? NavLinkMatch.All : NavLinkMatch.Prefix)" 
                                            Icon="@GetIcon(item.Icon)" 
                                            IconColor="Color.Primary"
                                            Class="nsdms-nav-link flex-grow-1 pr-7">
                                    <div class="d-flex align-center justify-space-between mud-width-full overflow-hidden" style="min-width: 0;">
                                        <span class="text-truncate" style="font-size: 0.8125rem; min-width: 0;">@item.Title</span>
                                        @if (item.BadgeCount > 0)
                                        {
                                            <MudChip T="string" 
                                                     Size="Size.Small" 
                                                     Variant="Variant.Filled" 
                                                     Color="@GetBadgeColor(item.BadgeColor)" 
                                                     Class="ml-1 px-1 py-0 font-weight-bold nsdms-badge-pill flex-shrink-0" 
                                                     Style="font-size: 0.65rem; height: 18px; pointer-events: none;">
                                                @item.BadgeCount
                                            </MudChip>
                                        }
                                    </div>
                                </MudNavLink>
                            </MudTooltip>
                            <MudIconButton Icon="@Icons.Material.Filled.Star" 
                                           Size="Size.Small" 
                                           OnClick="@(() => TogglePinAsync(item))"
                                           Title="Unpin from shortcuts" 
                                           aria-label="@($"Unpin {item.Title} from shortcuts")"
                                           Class="nsdms-pin-btn" 
                                           Style="position: absolute; right: 4px; top: 50%; transform: translateY(-50%); color: var(--mud-palette-warning); padding: 2px;" />
                        </div>
                    }

                    <MudDivider Class="my-2 mx-1" Style="opacity: 0.4;" />
                }

                <!-- 2. Dynamic 7 Statutory Domain Pillars (Collapsible Accordion Groups) -->
                @if (_navTree?.Groups != null)
                {
                    var visibleGroups = GetVisibleGroups().ToList();
                    @if (!visibleGroups.Any() && !string.IsNullOrWhiteSpace(_searchTerm))
                    {
                        <div class="nsdms-search-empty-state">
                            <MudIcon Icon="@Icons.Material.Outlined.SearchOff" Size="Size.Medium" Style="opacity: 0.5;" Class="mb-1" />
                            <MudText Typo="Typo.caption" Class="d-block text-secondary">
                                No menu items matching "<strong>@_searchTerm</strong>"
                            </MudText>
                            <MudButton Variant="Variant.Text" Size="Size.Small" Color="Color.Primary" OnClick="@ClearSearch" Class="mt-1 font-weight-bold">
                                Clear search
                            </MudButton>
                        </div>
                    }
                    else
                    {
                        @foreach (var group in visibleGroups)
                        {
                            var filteredItems = GetFilteredGroupItems(group).ToList();
                            if (filteredItems.Any())
                            {
                                <MudNavGroup Title="@group.GroupName" 
                                             Icon="@GetIcon(group.Icon)" 
                                             Expanded="@IsGroupExpanded(group.GroupName)" 
                                             ExpandedChanged="@((isExp) => SetGroupExpanded(group.GroupName, isExp))"
                                             Class="nsdms-nav-group mb-1">
                                    @foreach (var item in filteredItems)
                                    {
                                        <div class="position-relative nsdms-nav-item-wrapper d-flex align-center">
                                            <MudTooltip Text="@($"{item.Title} — {item.Description}")" Placement="Placement.Right" Delay="350">
                                                <MudNavLink href="@item.Href" 
                                                            Match="@(item.ExactMatch ? NavLinkMatch.All : NavLinkMatch.Prefix)" 
                                                            Icon="@GetIcon(item.Icon)" 
                                                            Class="sidebar-nav-item flex-grow-1 pr-7">
                                                    <div class="d-flex align-center justify-space-between mud-width-full overflow-hidden" style="min-width: 0;">
                                                        <span class="text-truncate" style="font-size: 0.8125rem; min-width: 0;">@item.Title</span>
                                                        @if (item.BadgeCount > 0)
                                                        {
                                                            <MudChip T="string" 
                                                                     Size="Size.Small" 
                                                                     Variant="Variant.Filled" 
                                                                     Color="@GetBadgeColor(item.BadgeColor)" 
                                                                     Class="ml-1 px-1 py-0 font-weight-bold nsdms-badge-pill flex-shrink-0" 
                                                                     Style="font-size: 0.65rem; height: 18px; pointer-events: none;">
                                                                @item.BadgeCount
                                                            </MudChip>
                                                        }
                                                    </div>
                                                </MudNavLink>
                                            </MudTooltip>
                                            <MudIconButton Icon="@(item.IsPinned ? Icons.Material.Filled.Star : Icons.Material.Outlined.StarOutline)" 
                                                           Size="Size.Small" 
                                                           OnClick="@(() => TogglePinAsync(item))"
                                                           Title="@(item.IsPinned ? "Unpin from shortcuts" : "Pin to quick shortcuts")" 
                                                           aria-label="@(item.IsPinned ? $"Unpin {item.Title} from shortcuts" : $"Pin {item.Title} to shortcuts")"
                                                           Class="nsdms-pin-btn" 
                                                           Style="@($"position: absolute; right: 4px; top: 50%; transform: translateY(-50%); color: {(item.IsPinned ? "var(--mud-palette-warning)" : "var(--mud-palette-text-secondary)")}; opacity: {(item.IsPinned ? "1" : "0.35")}; padding: 2px;")" />
                                        </div>
                                    }
                                </MudNavGroup>
                            }
                        }
                    }
                }
            </MudNavMenu>
        }
    </div>
</NavPanel>

@code {
    [Parameter]
    public bool Collapsed { get; set; } = false;

    [Parameter]
    public string ActivePersona { get; set; } = "All Roles (Unified)";

    [Parameter]
    public string CurrentUsername { get; set; } = string.Empty;

    [Parameter]
    public List<string> CurrentRoles { get; set; } = new();

    private NavigationTreeResultDto? _navTree;
    private bool _isLoading = true;
    private string _searchTerm = string.Empty;
    private Dictionary<string, bool> _groupExpandedStates = new(StringComparer.OrdinalIgnoreCase);
    private string _lastLoadedUsername = string.Empty;
    private string _lastLoadedPersona = string.Empty;
    private int _lastLoadedRolesHash = 0;

    protected override async Task OnInitializedAsync()
    {
        await LoadNavigationAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        var rolesHash = CurrentRoles?.Aggregate(0, (acc, r) => HashCode.Combine(acc, r)) ?? 0;
        if (CurrentUsername != _lastLoadedUsername || ActivePersona != _lastLoadedPersona || rolesHash != _lastLoadedRolesHash)
        {
            _lastLoadedUsername = CurrentUsername;
            _lastLoadedPersona = ActivePersona;
            _lastLoadedRolesHash = rolesHash;
            await LoadNavigationAsync();
        }
    }

    public async Task SetActivePersonaAsync(string persona)
    {
        ActivePersona = persona;
        await LoadNavigationAsync();
    }

    public async Task RefreshBadgesAsync()
    {
        await LoadNavigationAsync(silent: true);
    }

    private async Task LoadNavigationAsync(bool silent = false)
    {
        if (!silent)
        {
            _isLoading = true;
        }
        try
        {
            var userContext = !string.IsNullOrWhiteSpace(CurrentUsername)
                ? await CaslService.GetUserContextByUsernameAsync(CurrentUsername)
                : new CaslUserContext();
            var roles = userContext.Roles.Any() ? userContext.Roles : CurrentRoles;
            var perms = userContext.Permissions;

            _navTree = await NavService.GetUserNavigationTreeAsync(CurrentUsername, roles, perms, ActivePersona);

            // Initialize expanded states from server tree
            if (_navTree?.Groups != null)
            {
                foreach (var g in _navTree.Groups)
                {
                    if (!_groupExpandedStates.ContainsKey(g.GroupName))
                    {
                        _groupExpandedStates[g.GroupName] = g.IsExpanded;
                    }
                }
            }
        }
        catch
        {
            // Graceful fallback during prerendering
        }
        finally
        {
            _isLoading = false;
            StateHasChanged();
        }
    }

    private void OnSearchChanged(string search)
    {
        _searchTerm = search;
        if (!string.IsNullOrWhiteSpace(_searchTerm) && _navTree?.Groups != null)
        {
            foreach (var group in _navTree.Groups)
            {
                if (GroupHasMatch(group, _searchTerm))
                {
                    _groupExpandedStates[group.GroupName] = true;
                }
            }
        }
        StateHasChanged();
    }

    private void ClearSearch()
    {
        _searchTerm = string.Empty;
        StateHasChanged();
    }

    private bool ItemMatchesSearch(NavItemDto item, string query)
    {
        if (string.IsNullOrWhiteSpace(query)) return true;
        return (item.Title?.Contains(query, StringComparison.OrdinalIgnoreCase) ?? false) ||
               (item.Description?.Contains(query, StringComparison.OrdinalIgnoreCase) ?? false) ||
               (item.Category?.Contains(query, StringComparison.OrdinalIgnoreCase) ?? false) ||
               (item.Keywords?.Any(k => k.Contains(query, StringComparison.OrdinalIgnoreCase)) ?? false);
    }

    private bool GroupHasMatch(NavGroupDto group, string query)
    {
        if (string.IsNullOrWhiteSpace(query)) return true;
        if (group.GroupName.Contains(query, StringComparison.OrdinalIgnoreCase)) return true;
        return group.Items.Any(i => ItemMatchesSearch(i, query));
    }

    private IEnumerable<NavGroupDto> GetVisibleGroups()
    {
        if (_navTree?.Groups == null) return Enumerable.Empty<NavGroupDto>();
        if (string.IsNullOrWhiteSpace(_searchTerm)) return _navTree.Groups;
        return _navTree.Groups.Where(g => GroupHasMatch(g, _searchTerm));
    }

    private IEnumerable<NavItemDto> GetFilteredGroupItems(NavGroupDto group)
    {
        if (string.IsNullOrWhiteSpace(_searchTerm))
            return group.Items;
        return group.Items.Where(i => ItemMatchesSearch(i, _searchTerm) || group.GroupName.Contains(_searchTerm, StringComparison.OrdinalIgnoreCase));
    }

    private bool IsGroupExpanded(string groupName)
    {
        if (!string.IsNullOrWhiteSpace(_searchTerm))
            return true; // Always expand matching groups when filtering
        return _groupExpandedStates.TryGetValue(groupName, out var isExp) ? isExp : true;
    }

    private void SetGroupExpanded(string groupName, bool isExpanded)
    {
        _groupExpandedStates[groupName] = isExpanded;
        if (string.IsNullOrWhiteSpace(_searchTerm))
        {
            // Persist preference asynchronously in background without blocking UI
            _ = SaveGroupExpandedPreferenceAsync(groupName, isExpanded);
        }
    }

    private async Task SaveGroupExpandedPreferenceAsync(string groupName, bool isExpanded)
    {
        try
        {
            var prefs = await NavService.GetUserPreferencesAsync(CurrentUsername);
            if (isExpanded)
            {
                prefs.CollapsedGroupIds.RemoveAll(g => g.Equals(groupName, StringComparison.OrdinalIgnoreCase));
            }
            else if (!prefs.CollapsedGroupIds.Contains(groupName, StringComparer.OrdinalIgnoreCase))
            {
                prefs.CollapsedGroupIds.Add(groupName);
            }
            await NavService.SaveUserPreferencesAsync(prefs);
        }
        catch
        {
            // Graceful fallback
        }
    }

    private async Task TogglePinAsync(NavItemDto item)
    {
        bool newPinned = !item.IsPinned;
        item.IsPinned = newPinned;

        // Perform backend pin toggle
        await NavService.TogglePinItemAsync(CurrentUsername, item.Id);

        if (_navTree != null)
        {
            var allItems = _navTree.Groups.SelectMany(g => g.Items).ToList();
            var targetItem = allItems.FirstOrDefault(i => i.Id.Equals(item.Id, StringComparison.OrdinalIgnoreCase));
            if (targetItem != null)
            {
                targetItem.IsPinned = newPinned;
            }

            if (newPinned)
            {
                if (!_navTree.PinnedItems.Any(p => p.Id.Equals(item.Id, StringComparison.OrdinalIgnoreCase)))
                {
                    _navTree.PinnedItems.Add(item);
                }
                Snackbar.Add($"⭐ Pinned '{item.Title}' to Quick Access", Severity.Success);
            }
            else
            {
                _navTree.PinnedItems.RemoveAll(p => p.Id.Equals(item.Id, StringComparison.OrdinalIgnoreCase));
                Snackbar.Add($"Removed '{item.Title}' from Quick Access", Severity.Info);
            }
        }

        StateHasChanged();
    }

    private Color GetBadgeColor(string badgeColor)
    {
        return badgeColor switch
        {
            "Error" => Color.Error,
            "Warning" => Color.Warning,
            "Info" => Color.Info,
            "Success" => Color.Success,
            _ => Color.Primary
        };
    }

    private string GetIcon(string iconName)
    {
        return iconName switch
        {
            "Dashboard" => Icons.Material.Filled.Dashboard,
            "Speed" => Icons.Material.Filled.Speed,
            "Inbox" => Icons.Material.Filled.Inbox,
            "AccountTree" => Icons.Material.Filled.AccountTree,
            "People" => Icons.Material.Filled.People,
            "Business" => Icons.Material.Filled.Business,
            "Badge" => Icons.Material.Filled.Badge,
            "PhoneAndroid" => Icons.Material.Filled.PhoneAndroid,
            "Smartphone" => Icons.Material.Filled.Smartphone,
            "Phone" => Icons.Material.Filled.Phone,
            "SimCard" => Icons.Material.Filled.SimCard,
            "Memory" => Icons.Material.Filled.Memory,
            "AccountCircle" => Icons.Material.Filled.AccountCircle,
            "FileUpload" => Icons.Material.Filled.FileUpload,
            "MarkEmailUnread" => Icons.Material.Filled.MarkEmailUnread,
            "School" => Icons.Material.Filled.School,
            "MenuBook" => Icons.Material.Filled.MenuBook,
            "Assignment" => Icons.Material.Filled.Assignment,
            "Groups" => Icons.Material.Filled.Groups,
            "AccountBalanceWallet" => Icons.Material.Filled.AccountBalanceWallet,
            "AssignmentTurnedIn" => Icons.Material.Filled.AssignmentTurnedIn,
            "Difference" => Icons.Material.Filled.Difference,
            "Description" => Icons.Material.Filled.Description,
            "AccountBalance" => Icons.Material.Filled.AccountBalance,
            "Payments" => Icons.Material.Filled.Payments,
            "Calculate" => Icons.Material.Filled.Calculate,
            "ReceiptLong" => Icons.Material.Filled.ReceiptLong,
            "SwapHoriz" => Icons.Material.Filled.SwapHoriz,
            "FactCheck" => Icons.Material.Filled.FactCheck,
            "VerifiedUser" => Icons.Material.Filled.VerifiedUser,
            "DomainVerification" => Icons.Material.Filled.DomainVerification,
            "Handyman" => Icons.Material.Filled.Handyman,
            "Engineering" => Icons.Material.Filled.Engineering,
            "Insights" => Icons.Material.Filled.Insights,
            "Gavel" => Icons.Material.Filled.Gavel,
            "LibraryBooks" => Icons.Material.Filled.LibraryBooks,
            "Security" => Icons.Material.Filled.Security,
            "AdminPanelSettings" => Icons.Material.Filled.AdminPanelSettings,
            "Settings" => Icons.Material.Filled.Settings,
            "Tune" => Icons.Material.Filled.Tune,
            "MeetingRoom" => Icons.Material.Filled.MeetingRoom,
            "History" => Icons.Material.Filled.History,
            "Verified" => Icons.Material.Filled.Verified,
            "FolderShared" => Icons.Material.Filled.FolderShared,
            "Layers" => Icons.Material.Filled.Layers,
            "EventNote" => Icons.Material.Filled.EventNote,
            "QueryStats" => Icons.Material.Filled.QueryStats,
            "Star" => Icons.Material.Filled.Star,
            "StarBorder" => Icons.Material.Filled.StarBorder,
            _ => Icons.Material.Filled.Folder
        };
    }
}
