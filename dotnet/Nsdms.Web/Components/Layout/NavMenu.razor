@namespace Nsdms.Web.Components.Layout
@using MudBlazor
@using Nsdms.Application.Common.Interfaces
@using Nsdms.Application.Services
@inject INavigationMenuService NavService
@inject ICaslAbilityService CaslService
@inject ISnackbar Snackbar
@inject NavigationManager Nav

<NavPanel Collapsed="@Collapsed" CurrentPath="@Nav.Uri">
    <div class="nsdms-menu-container pa-1">
        @if (_isLoading)
        {
            <div class="pa-4 text-center">
                <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Small" />
                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="d-block mt-2">Loading workspaces...</MudText>
            </div>
        }
        else
        {
            <MudNavMenu Class="mud-width-full" Dense="true" Rounded="true">
                <!-- 1. Pinned Shortcuts Section ("My Quick Access") -->
                @if (_navTree?.PinnedItems != null && _navTree.PinnedItems.Any())
                {
                    <div class="nsdms-nav-group-header px-3 pt-2 pb-1 d-flex align-center justify-space-between">
                        <div class="d-flex align-center gap-1">
                            <MudIcon Icon="@Icons.Material.Filled.Star" Size="Size.Small" Style="color: #f59e0b; font-size: 1rem;" />
                            <MudText Typo="Typo.caption" Class="font-weight-bold" Style="color: var(--mud-palette-text-secondary); letter-spacing: 0.05em; font-size: 0.68rem;">
                                PINNED SHORTCUTS
                            </MudText>
                        </div>
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Filled" Color="Color.Default" Class="px-1 py-0" Style="font-size: 0.6rem; height: 16px;">
                            @_navTree.PinnedItems.Count
                        </MudChip>
                    </div>

                    @foreach (var item in _navTree.PinnedItems)
                    {
                        <div class="position-relative nsdms-nav-item-wrapper">
                            <MudNavLink href="@item.Href" 
                                        Match="@(item.ExactMatch ? NavLinkMatch.All : NavLinkMatch.Prefix)" 
                                        Icon="@GetIcon(item.Icon)" 
                                        IconColor="Color.Primary"
                                        Class="nsdms-nav-link pr-8">
                                <div class="d-flex align-center justify-space-between mud-width-full">
                                    <span class="text-truncate">@item.Title</span>
                                    @if (item.BadgeCount > 0)
                                    {
                                        <MudChip T="string" 
                                                 Size="Size.Small" 
                                                 Variant="Variant.Filled" 
                                                 Color="@GetBadgeColor(item.BadgeColor)" 
                                                 Class="ml-2 px-1 py-0 font-weight-bold" 
                                                 Style="font-size: 0.65rem; height: 18px;">
                                            @item.BadgeCount
                                        </MudChip>
                                    }
                                </div>
                            </MudNavLink>
                            <MudIconButton Icon="@Icons.Material.Filled.Star" 
                                           Size="Size.Small" 
                                           OnClick="@(() => TogglePinAsync(item))"
                                           Title="Unpin from shortcuts" 
                                           Class="nsdms-pin-btn" 
                                           Style="position: absolute; right: 4px; top: 50%; transform: translateY(-50%); color: #f59e0b; padding: 2px;" />
                        </div>
                    }

                    <MudDivider Class="my-2 mx-2" Style="opacity: 0.5;" />
                }

                <!-- 2. Dynamic Role-Filtered Functional Groups -->
                @if (_navTree?.Groups != null)
                {
                    @foreach (var group in _navTree.Groups)
                    {
                        <MudNavGroup Title="@group.GroupName" 
                                     Icon="@GetIcon(group.Icon)" 
                                     Expanded="@group.IsExpanded" 
                                     Class="nsdms-nav-group font-weight-bold" 
                                     Style="font-size: 0.72rem; letter-spacing: 0.03em;">
                            @foreach (var item in group.Items)
                            {
                                <div class="position-relative nsdms-nav-item-wrapper">
                                    <MudNavLink href="@item.Href" 
                                                Match="@(item.ExactMatch ? NavLinkMatch.All : NavLinkMatch.Prefix)" 
                                                Icon="@GetIcon(item.Icon)" 
                                                Class="nsdms-nav-link pr-8">
                                        <div class="d-flex align-center justify-space-between mud-width-full">
                                            <span class="text-truncate" style="font-size: 0.8125rem;">@item.Title</span>
                                            @if (item.BadgeCount > 0)
                                            {
                                                <MudChip T="string" 
                                                         Size="Size.Small" 
                                                         Variant="Variant.Filled" 
                                                         Color="@GetBadgeColor(item.BadgeColor)" 
                                                         Class="ml-2 px-1 py-0 font-weight-bold" 
                                                         Style="font-size: 0.65rem; height: 18px;">
                                                    @item.BadgeCount
                                                </MudChip>
                                            }
                                        </div>
                                    </MudNavLink>
                                    <MudIconButton Icon="@(item.IsPinned ? Icons.Material.Filled.Star : Icons.Material.Outlined.StarOutline)" 
                                                   Size="Size.Small" 
                                                   OnClick="@(() => TogglePinAsync(item))"
                                                   Title="@(item.IsPinned ? "Unpin from shortcuts" : "Pin to quick shortcuts")" 
                                                   Class="nsdms-pin-btn" 
                                                   Style="@($"position: absolute; right: 4px; top: 50%; transform: translateY(-50%); color: {(item.IsPinned ? "#f59e0b" : "var(--mud-palette-text-secondary)")}; opacity: {(item.IsPinned ? "1" : "0.5")}; padding: 2px;")" />
                                </div>
                            }
                        </MudNavGroup>
                    }
                }
            </MudNavMenu>
        }
    </div>
</NavPanel>

@code {
    [Parameter]
    public bool Collapsed { get; set; } = false;

    [Parameter]
    public string ActivePersona { get; set; } = "All Roles (Unified)";

    [Parameter]
    public string CurrentUsername { get; set; } = "Admin";

    [Parameter]
    public List<string> CurrentRoles { get; set; } = new() { "SuperAdmin", "Admin", "FinanceManager", "CLO" };

    private NavigationTreeResultDto? _navTree;
    private bool _isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        await LoadNavigationAsync();
    }

    public async Task SetActivePersonaAsync(string persona)
    {
        ActivePersona = persona;
        await LoadNavigationAsync();
    }

    public async Task RefreshBadgesAsync()
    {
        await LoadNavigationAsync();
    }

    private async Task LoadNavigationAsync()
    {
        _isLoading = true;
        try
        {
            var userContext = await CaslService.GetUserContextByUsernameAsync(CurrentUsername);
            var roles = userContext.Roles.Any() ? userContext.Roles : CurrentRoles;
            var perms = userContext.Permissions;

            _navTree = await NavService.GetUserNavigationTreeAsync(CurrentUsername, roles, perms, ActivePersona);
        }
        catch
        {
            // Graceful fallback during prerendering
        }
        finally
        {
            _isLoading = false;
            StateHasChanged();
        }
    }

    private async Task TogglePinAsync(NavItemDto item)
    {
        bool newPinned = !item.IsPinned;
        await NavService.TogglePinItemAsync(CurrentUsername, item.Id);
        item.IsPinned = newPinned;

        if (newPinned)
        {
            Snackbar.Add($"⭐ Pinned '{item.Title}' to Quick Access", Severity.Success);
        }
        else
        {
            Snackbar.Add($"Removed '{item.Title}' from Quick Access", Severity.Info);
        }

        await LoadNavigationAsync();
    }

    private Color GetBadgeColor(string badgeColor)
    {
        return badgeColor switch
        {
            "Error" => Color.Error,
            "Warning" => Color.Warning,
            "Info" => Color.Info,
            "Success" => Color.Success,
            _ => Color.Primary
        };
    }

    private string GetIcon(string iconName)
    {
        return iconName switch
        {
            "Dashboard" => Icons.Material.Filled.Dashboard,
            "Inbox" => Icons.Material.Filled.Inbox,
            "AccountTree" => Icons.Material.Filled.AccountTree,
            "People" => Icons.Material.Filled.People,
            "Business" => Icons.Material.Filled.Business,
            "Badge" => Icons.Material.Filled.Badge,
            "School" => Icons.Material.Filled.School,
            "MenuBook" => Icons.Material.Filled.MenuBook,
            "Assignment" => Icons.Material.Filled.Assignment,
            "Groups" => Icons.Material.Filled.Groups,
            "AccountBalanceWallet" => Icons.Material.Filled.AccountBalanceWallet,
            "AssignmentTurnedIn" => Icons.Material.Filled.AssignmentTurnedIn,
            "Difference" => Icons.Material.Filled.Difference,
            "Description" => Icons.Material.Filled.Description,
            "AccountBalance" => Icons.Material.Filled.AccountBalance,
            "Payments" => Icons.Material.Filled.Payments,
            "Calculate" => Icons.Material.Filled.Calculate,
            "ReceiptLong" => Icons.Material.Filled.ReceiptLong,
            "SwapHoriz" => Icons.Material.Filled.SwapHoriz,
            "FactCheck" => Icons.Material.Filled.FactCheck,
            "VerifiedUser" => Icons.Material.Filled.VerifiedUser,
            "DomainVerification" => Icons.Material.Filled.DomainVerification,
            "Handyman" => Icons.Material.Filled.Handyman,
            "Insights" => Icons.Material.Filled.Insights,
            "Gavel" => Icons.Material.Filled.Gavel,
            "LibraryBooks" => Icons.Material.Filled.LibraryBooks,
            "Security" => Icons.Material.Filled.Security,
            "AdminPanelSettings" => Icons.Material.Filled.AdminPanelSettings,
            "Settings" => Icons.Material.Filled.Settings,
            "Tune" => Icons.Material.Filled.Tune,
            "MeetingRoom" => Icons.Material.Filled.MeetingRoom,
            "History" => Icons.Material.Filled.History,
            "Verified" => Icons.Material.Filled.Verified,
            "FolderShared" => Icons.Material.Filled.FolderShared,
            "Layers" => Icons.Material.Filled.Layers,
            "Star" => Icons.Material.Filled.Star,
            "StarBorder" => Icons.Material.Filled.StarBorder,
            _ => Icons.Material.Filled.Folder
        };
    }
}
