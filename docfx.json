{
  "$schema": "https://raw.githubusercontent.com/dotnet/docfx/main/schemas/docfx.json",
  "metadata": [
    {
      "src": [
        {
          "src": "dotnet",
          "files": [
            "Nsdms.Domain/Nsdms.Domain.csproj",
            "Nsdms.Application/Nsdms.Application.csproj",
            "Nsdms.Infrastructure/Nsdms.Infrastructure.csproj",
            "Nsdms.Web/Nsdms.Web.csproj"
          ]
        }
      ],
      "dest": "api",
      "includePrivateMembers": false,
      "disableGitFeatures": false,
      "disableDefaultFilter": false
    }
  ],
  "build": {
    "content": [
      {
        "files": [
          "api/**.yml",
          "api/index.md"
        ]
      },
      {
        "files": [
          "docs/**.md",
          "docs/**/toc.yml",
          "toc.yml",
          "*.md"
        ]
      }
    ],
    "resource": [
      {
        "files": [
          "images/**"
        ]
      }
    ],
    "output": "_site",
    "globalMetadata": {
      "_appName": "MerSETA NSDMS Modernization Documentation",
      "_appTitle": "MerSETA NSDMS .NET 10 Enterprise Architecture",
      "_enableSearch": true,
      "pdf": false
    },
    "template": [
      "default",
      "modern"
    ],
    "postProcessors": []
  }
}
